    !count
    !names_malformed
    !names_missing
    !extras_malformed
    !extras_missing
    !extras_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !mesh_index
    !len
    !bytes
    return names_pos

L_BAD_COUNT:
    !count_bad
    !count
    !names_malformed
    !names_missing
    !names_pos
