    jmp L_HEAD

L_MISSING:
    !closed_root
    !obj_prev
    !is_obj_close
    !is_obj_open
    !arr_depth2
    !obj_depth2
    !is_quote
    !b
    !p
    !done
    !idx
    !after_root
    !is_object
    !root_byte
    !root_ptr
    !has_first
    !first
    !key_len
    !key
    !len
    !bytes
    return -1

L_MALFORMED_STRING_NP:
    !bad_np
    !skipped_np
    !is_colon
    !colon_byte
    !colon_ptr
    !colon_in_bounds
    !colon_pos
    !key_end
    !matched
    !root_key_candidate
    !no_array
    !at_root_object
    !arr_depth
    !obj_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !after_root
    !is_object
    !root_byte
    !root_ptr
    !has_first
    !first
    !key_len
