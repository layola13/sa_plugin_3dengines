@sa3d_gltf_json_accessor_parse(bytes: ptr, len: i64, index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_accessor_table_clear(&out)
    buffer_view_slot = stack_alloc 8
    has_buffer_view_slot = stack_alloc 4
    byte_offset_slot = stack_alloc 8
    count_slot = stack_alloc 8
    component_type_slot = stack_alloc 4
    dimension_slot = stack_alloc 4
    normalized_slot = stack_alloc 4
    format_slot = stack_alloc 4
    type_ptr_slot = stack_alloc 8
    type_len_slot = stack_alloc 8
    object_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_ACCESSORS, 9, index)
    missing_obj = eq object_pos, -1
    br missing_obj -> L_MISSING_OBJECT, L_MALFORMED_OBJ_CHECK

L_MALFORMED_OBJ_CHECK:
    malformed_obj = eq object_pos, -2
    br malformed_obj -> L_MALFORMED_OBJECT, L_BUFFER_VIEW

L_BUFFER_VIEW:
    bv_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BUFFER_VIEW, 10)
    bv_missing = eq bv_pos, -1
    br bv_missing -> L_BUFFER_VIEW_DEFAULT, L_BUFFER_VIEW_MALFORMED_CHECK

L_BUFFER_VIEW_MALFORMED_CHECK:
    bv_malformed = eq bv_pos, -2
    br bv_malformed -> L_MALFORMED_BUFFER_VIEW, L_PARSE_BUFFER_VIEW

L_PARSE_BUFFER_VIEW:
    bv_value = call @sa3d_gltf_json_parse_positive_i64(bytes, len, bv_pos)
    bv_bad = slt bv_value, 0
    br bv_bad -> L_MALFORMED_BUFFER_VIEW_VALUE, L_STORE_BUFFER_VIEW

L_STORE_BUFFER_VIEW:
    store buffer_view_slot+0, bv_value as i64
    store has_buffer_view_slot+0, 1 as i32
    !bv_bad
    !bv_value
    !bv_malformed
    !bv_missing
    !bv_pos
    jmp L_BYTE_OFFSET

L_BUFFER_VIEW_DEFAULT:
    store buffer_view_slot+0, 0 as i64
    store has_buffer_view_slot+0, 0 as i32
    !bv_missing
    !bv_pos
    jmp L_BYTE_OFFSET

L_BYTE_OFFSET:
    byte_offset = call @sa3d_gltf_json_object_i64_or_default(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_OFFSET, 10, 0)
    byte_offset_bad = slt byte_offset, 0
    br byte_offset_bad -> L_MALFORMED_BYTE_OFFSET, L_STORE_BYTE_OFFSET

L_STORE_BYTE_OFFSET:
    store byte_offset_slot+0, byte_offset as i64
    !byte_offset_bad
    !byte_offset
    jmp L_COUNT_POS

L_COUNT_POS:
    count_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_COUNT, 5)
    count_missing = eq count_pos, -1
    br count_missing -> L_MISSING_COUNT, L_COUNT_MALFORMED_CHECK

L_COUNT_MALFORMED_CHECK:
    count_malformed = eq count_pos, -2
    br count_malformed -> L_MALFORMED_COUNT, L_PARSE_COUNT

L_PARSE_COUNT:
    count_value = call @sa3d_gltf_json_parse_positive_i64(bytes, len, count_pos)
    count_bad = slt count_value, 0
    br count_bad -> L_MALFORMED_COUNT_VALUE, L_STORE_COUNT

L_STORE_COUNT:
    store count_slot+0, count_value as i64
    !count_bad
    !count_value
    !count_malformed
    !count_missing
    !count_pos
    jmp L_COMPONENT_POS

L_COMPONENT_POS:
    comp_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_COMPONENT_TYPE, 13)
    comp_missing = eq comp_pos, -1
    br comp_missing -> L_MISSING_COMPONENT, L_COMPONENT_MALFORMED_CHECK

L_COMPONENT_MALFORMED_CHECK:
    comp_malformed = eq comp_pos, -2
    br comp_malformed -> L_MALFORMED_COMPONENT, L_PARSE_COMPONENT

L_PARSE_COMPONENT:
    comp_value64 = call @sa3d_gltf_json_parse_positive_i64(bytes, len, comp_pos)
    comp_bad = slt comp_value64, 0
    br comp_bad -> L_MALFORMED_COMPONENT_VALUE, L_STORE_COMPONENT

L_STORE_COMPONENT:
    comp_value = trunc comp_value64 as i32
    store component_type_slot+0, comp_value as i32
    !comp_value
    !comp_bad
    !comp_value64
    !comp_malformed
    !comp_missing
    !comp_pos
    jmp L_TYPE

L_TYPE:
    type_status = call @sa3d_gltf_json_object_string_span(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_TYPE, 4, &type_ptr_slot, &type_len_slot)
    type_missing = eq type_status, 0
    br type_missing -> L_MISSING_TYPE, L_TYPE_MALFORMED_CHECK

L_TYPE_MALFORMED_CHECK:
    type_bad = slt type_status, 0
    br type_bad -> L_MALFORMED_TYPE, L_DIMENSION

L_DIMENSION:
    type_ptr = load type_ptr_slot+0 as ptr
    type_len = load type_len_slot+0 as i64
    dimension = call @sa3d_gltf_json_dimension_from_string(type_ptr, type_len)
    dimension_bad = eq dimension, SA3D_GLTF_DIM_UNSUPPORTED
    br dimension_bad -> L_UNSUPPORTED_DIMENSION, L_STORE_DIMENSION

L_STORE_DIMENSION:
    store dimension_slot+0, dimension as i32
    !dimension_bad
    !dimension
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    jmp L_NORMALIZED

L_NORMALIZED:
    normalized = call @sa3d_gltf_json_object_bool_or_default(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_NORMALIZED, 10, 0)
    normalized_bad = slt normalized, 0
    br normalized_bad -> L_MALFORMED_NORMALIZED, L_STORE_NORMALIZED

L_STORE_NORMALIZED:
    store normalized_slot+0, normalized as i32
    !normalized_bad
    !normalized
    jmp L_FORMAT

L_FORMAT:
    component_type = load component_type_slot+0 as i32
    dimension2 = load dimension_slot+0 as i32
    accessor_format = call @sa3d_gltf_accessor_format_from_component_dimension(component_type, dimension2)
    format_bad = eq accessor_format, 0
    br format_bad -> L_UNSUPPORTED_FORMAT, L_STORE_SUCCESS

L_STORE_SUCCESS:
    buffer_view = load buffer_view_slot+0 as i64
    has_buffer_view = load has_buffer_view_slot+0 as i32
    byte_offset_final = load byte_offset_slot+0 as i64
    count_final = load count_slot+0 as i64
    normalized_final = load normalized_slot+0 as i32
    store format_slot+0, accessor_format as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_buffer_view, buffer_view as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view, has_buffer_view as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_byte_offset, byte_offset_final as i64
    store out+SA3D_GLTF_ACCESSOR_TABLE_count, count_final as i64
    store out+SA3D_GLTF_ACCESSOR_TABLE_component_type, component_type as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_dimension, dimension2 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_normalized, normalized_final as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_accessor_format, accessor_format as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !normalized_final
    !count_final
    !byte_offset_final
    !has_buffer_view
    !buffer_view
    !format_bad
    !accessor_format
    !dimension2
    !component_type
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING_OBJECT:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_OBJECT:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_BUFFER_VIEW:
L_MALFORMED_BUFFER_VIEW_VALUE:
L_MALFORMED_BYTE_OFFSET:
L_MALFORMED_COUNT:
L_MALFORMED_COUNT_VALUE:
L_MALFORMED_COMPONENT:
L_MALFORMED_COMPONENT_VALUE:
L_MALFORMED_TYPE:
L_MALFORMED_NORMALIZED:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_COUNT:
L_MISSING_COMPONENT:
L_MISSING_TYPE:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_UNSUPPORTED_DIMENSION:
L_UNSUPPORTED_FORMAT:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT as i32
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

@sa3d_gltf_json_accessor_has_sparse(bytes: ptr, len: i64, accessor_index: i64) -> i32:
L_ENTRY:
    object_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_ACCESSORS, 9, accessor_index)
    missing = eq object_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq object_pos, -2
    br malformed -> L_BAD_OBJECT, L_SPARSE

L_SPARSE:
    sparse_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_SPARSE, 6)
    sparse_missing = eq sparse_pos, -1
    br sparse_missing -> L_FALSE, L_SPARSE_MALFORMED_CHECK

L_SPARSE_MALFORMED_CHECK:
    sparse_malformed = eq sparse_pos, -2
    br sparse_malformed -> L_BAD_SPARSE, L_TRUE

L_TRUE:
    !sparse_malformed
    !sparse_missing
    !sparse_pos
    !malformed
    !missing
    !object_pos
    !accessor_index
    !len
    !bytes
    return 1

L_FALSE:
    !sparse_missing
    !sparse_pos
    !malformed
    !missing
    !object_pos
    !accessor_index
    !len
    !bytes
    return 0

L_BAD_SPARSE:
    !sparse_malformed
    !sparse_missing
    !sparse_pos
    !malformed
    !missing
    !object_pos
    !accessor_index
    !len
    !bytes
    return -1

L_BAD_OBJECT:
    !malformed
    !missing
    !object_pos
    !accessor_index
    !len
    !bytes
    return -1

L_MISSING:
    !missing
    !object_pos
    !accessor_index
    !len
    !bytes
    return -1

@sa3d_gltf_accessor_sparse_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_count, 0 as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_buffer_view, 0 as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_byte_offset, 0 as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_component_type, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_values_buffer_view, 0 as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_values_byte_offset, 0 as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_sparse_index_component_supported(component_type: i32) -> i32:
L_ENTRY:
    u8 = eq component_type, SA3D_GLTF_COMPONENT_U8
    u16 = eq component_type, SA3D_GLTF_COMPONENT_U16
    u32 = eq component_type, SA3D_GLTF_COMPONENT_U32
    a = or u8, u16
    ok = or a, u32
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !a
    !u32
    !u16
    !u8
    !component_type
    return 1

L_FALSE:
    !ok
    !a
    !u32
    !u16
    !u8
    !component_type
    return 0

@sa3d_gltf_sparse_index_component_byte_size(component_type: i32) -> i64:
L_ENTRY:
    u8 = eq component_type, SA3D_GLTF_COMPONENT_U8
    br u8 -> L_U8, L_U16_CHECK

L_U8:
    !u8
    !component_type
    return 1

L_U16_CHECK:
    u16 = eq component_type, SA3D_GLTF_COMPONENT_U16
    br u16 -> L_U16, L_U32_CHECK

L_U16:
    !u16
    !u8
    !component_type
    return 2

L_U32_CHECK:
    u32 = eq component_type, SA3D_GLTF_COMPONENT_U32
    br u32 -> L_U32, L_UNSUPPORTED

L_U32:
    !u32
    !u16
    !u8
    !component_type
    return 4

L_UNSUPPORTED:
    !u32
    !u16
    !u8
    !component_type
    return 0

@sa3d_gltf_json_accessor_sparse_parse(bytes: ptr, len: i64, accessor_index: i64, &out: ptr) -> i32:
L_ENTRY:
    count_slot = stack_alloc 8
    indices_bv_slot = stack_alloc 8
    indices_comp_slot = stack_alloc 8
    values_bv_slot = stack_alloc 8
    call @sa3d_gltf_accessor_sparse_table_clear(&out)
    object_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_ACCESSORS, 9, accessor_index)
    missing_object = eq object_pos, -1
    br missing_object -> L_MISSING_OBJECT, L_OBJECT_MALFORMED_CHECK

L_OBJECT_MALFORMED_CHECK:
    object_malformed = eq object_pos, -2
    br object_malformed -> L_MALFORMED_OBJECT, L_SPARSE_POS

L_SPARSE_POS:
    sparse_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_SPARSE, 6)
    sparse_missing = eq sparse_pos, -1
    br sparse_missing -> L_MISSING_SPARSE, L_SPARSE_MALFORMED_CHECK

L_SPARSE_MALFORMED_CHECK:
    sparse_malformed = eq sparse_pos, -2
    br sparse_malformed -> L_MALFORMED_SPARSE, L_COUNT

L_COUNT:
    count_status = call @sa3d_gltf_json_object_i64_value(bytes, len, sparse_pos, &SA3D_GLTF_JSON_KEY_COUNT, 5, &count_slot)
    count_ok = eq count_status, 1
    br count_ok -> L_INDICES_POS, L_BAD_COUNT_CHECK

L_BAD_COUNT_CHECK:
    count_bad = slt count_status, 0
    br count_bad -> L_MALFORMED_COUNT, L_MISSING_COUNT

L_INDICES_POS:
    indices_pos = call @sa3d_gltf_json_object_field_value(bytes, len, sparse_pos, &SA3D_GLTF_JSON_KEY_INDICES, 7)
    indices_missing = eq indices_pos, -1
    br indices_missing -> L_MISSING_INDICES, L_INDICES_MALFORMED_CHECK

L_INDICES_MALFORMED_CHECK:
    indices_malformed = eq indices_pos, -2
    br indices_malformed -> L_MALFORMED_INDICES, L_INDICES_BV

L_INDICES_BV:
    indices_bv_status = call @sa3d_gltf_json_object_i64_value(bytes, len, indices_pos, &SA3D_GLTF_JSON_KEY_BUFFER_VIEW, 10, &indices_bv_slot)
    indices_bv_ok = eq indices_bv_status, 1
    br indices_bv_ok -> L_INDICES_COMPONENT, L_BAD_INDICES_BV_CHECK

L_BAD_INDICES_BV_CHECK:
    indices_bv_bad = slt indices_bv_status, 0
    br indices_bv_bad -> L_MALFORMED_INDICES_BV, L_MISSING_INDICES_BV

L_INDICES_COMPONENT:
    indices_comp_status = call @sa3d_gltf_json_object_i64_value(bytes, len, indices_pos, &SA3D_GLTF_JSON_KEY_COMPONENT_TYPE, 13, &indices_comp_slot)
    indices_comp_ok = eq indices_comp_status, 1
    br indices_comp_ok -> L_INDICES_OFFSET, L_BAD_INDICES_COMP_CHECK

L_BAD_INDICES_COMP_CHECK:
    indices_comp_bad = slt indices_comp_status, 0
    br indices_comp_bad -> L_MALFORMED_INDICES_COMP, L_MISSING_INDICES_COMP

L_INDICES_OFFSET:
    indices_offset = call @sa3d_gltf_json_object_i64_or_default(bytes, len, indices_pos, &SA3D_GLTF_JSON_KEY_BYTE_OFFSET, 10, 0)
    indices_offset_bad = slt indices_offset, 0
    br indices_offset_bad -> L_MALFORMED_INDICES_OFFSET, L_VALUES_POS

L_VALUES_POS:
    values_pos = call @sa3d_gltf_json_object_field_value(bytes, len, sparse_pos, &SA3D_GLTF_JSON_KEY_VALUES, 6)
    values_missing = eq values_pos, -1
    br values_missing -> L_MISSING_VALUES, L_VALUES_MALFORMED_CHECK

L_VALUES_MALFORMED_CHECK:
    values_malformed = eq values_pos, -2
    br values_malformed -> L_MALFORMED_VALUES, L_VALUES_BV

L_VALUES_BV:
    values_bv_status = call @sa3d_gltf_json_object_i64_value(bytes, len, values_pos, &SA3D_GLTF_JSON_KEY_BUFFER_VIEW, 10, &values_bv_slot)
    values_bv_ok = eq values_bv_status, 1
    br values_bv_ok -> L_VALUES_OFFSET, L_BAD_VALUES_BV_CHECK

L_BAD_VALUES_BV_CHECK:
    values_bv_bad = slt values_bv_status, 0
    br values_bv_bad -> L_MALFORMED_VALUES_BV, L_MISSING_VALUES_BV

L_VALUES_OFFSET:
    values_offset = call @sa3d_gltf_json_object_i64_or_default(bytes, len, values_pos, &SA3D_GLTF_JSON_KEY_BYTE_OFFSET, 10, 0)
    values_offset_bad = slt values_offset, 0
    br values_offset_bad -> L_MALFORMED_VALUES_OFFSET, L_COMPONENT_SUPPORTED

L_COMPONENT_SUPPORTED:
    indices_component_raw = load indices_comp_slot+0 as i64
    indices_component = trunc indices_component_raw as i32
    supported = call @sa3d_gltf_sparse_index_component_supported(indices_component)
    supported_bool = ne supported, 0
    br supported_bool -> L_STORE, L_UNSUPPORTED_COMPONENT

L_STORE:
    count_value = load count_slot+0 as i64
    indices_bv = load indices_bv_slot+0 as i64
    values_bv = load values_bv_slot+0 as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_count, count_value as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_buffer_view, indices_bv as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_byte_offset, indices_offset as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_component_type, indices_component as i32
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_values_buffer_view, values_bv as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_values_byte_offset, values_offset as i64
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !values_bv
    !indices_bv
    !count_value
    !supported_bool
    !supported
    !indices_component
    !indices_component_raw
    !values_offset_bad
    !values_offset
    !values_bv_ok
    !values_bv_status
    !values_malformed
    !values_missing
    !values_pos
    !indices_offset_bad
    !indices_offset
    !indices_comp_ok
    !indices_comp_status
    !indices_bv_ok
    !indices_bv_status
    !indices_malformed
    !indices_missing
    !indices_pos
    !count_ok
    !count_status
    !sparse_malformed
    !sparse_missing
    !sparse_pos
    !object_malformed
    !missing_object
    !object_pos
    !out
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_UNSUPPORTED_COMPONENT:
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT as i32
    !supported_bool
    !supported
    !indices_component
    !indices_component_raw
    !values_offset_bad
    !values_offset
    !values_bv_ok
    !values_bv_status
    !values_malformed
    !values_missing
    !values_pos
    !indices_offset_bad
    !indices_offset
    !indices_comp_ok
    !indices_comp_status
    !indices_bv_ok
    !indices_bv_status
    !indices_malformed
    !indices_missing
    !indices_pos
    !count_ok
    !count_status
    !sparse_malformed
    !sparse_missing
    !sparse_pos
    !object_malformed
    !missing_object
    !object_pos
    !out
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_MISSING_OBJECT:
L_MISSING_SPARSE:
L_MISSING_COUNT:
L_MISSING_INDICES:
L_MISSING_INDICES_BV:
L_MISSING_INDICES_COMP:
L_MISSING_VALUES:
L_MISSING_VALUES_BV:
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_OBJECT:
L_MALFORMED_SPARSE:
L_MALFORMED_COUNT:
L_MALFORMED_INDICES:
L_MALFORMED_INDICES_BV:
L_MALFORMED_INDICES_COMP:
L_MALFORMED_INDICES_OFFSET:
L_MALFORMED_VALUES:
L_MALFORMED_VALUES_BV:
L_MALFORMED_VALUES_OFFSET:
    store out+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !out
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_primitive_attr_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_position, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_normal, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_tangent, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_color0, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord0, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord1, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_joints0, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_weights0, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_position, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_normal, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_tangent, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_color0, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord0, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord1, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_joints0, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_weights0, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_count, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_primitive_attr_table_read_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &table: ptr, value_offset: i64, has_offset: i64, &count_slot: ptr) -> i32:
L_ENTRY:
    value_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, key, key_len, &value_slot)
    found = eq status, 1
    br found -> L_FOUND, L_MISSING_CHECK

L_MISSING_CHECK:
    missing = eq status, 0
    br missing -> L_MISSING, L_BAD

L_FOUND:
    value = load value_slot+0 as i64
    value_ptr = ptr_add table, value_offset
    has_ptr = ptr_add table, has_offset
    old_count = load count_slot+0 as i64
    next_count = add old_count, 1
    store value_ptr+0, value as i64
    store has_ptr+0, 1 as i32
    store count_slot+0, next_count as i64
    !next_count
    !old_count
    !has_ptr
    !value_ptr
    !value
    !found
    !status
    !count_slot
    !has_offset
    !value_offset
    !table
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 1

L_MISSING:
    !missing
    !found
    !status
    !count_slot
    !has_offset
    !value_offset
    !table
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 0

L_BAD:
    !missing
    !found
    !status
    !count_slot
    !has_offset
    !value_offset
    !table
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_primitive_attr_table_parse(bytes: ptr, len: i64, primitive_object_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_json_primitive_attr_table_clear(&out)
    attr_pos = call @sa3d_gltf_json_object_field_value(bytes, len, primitive_object_pos, &SA3D_GLTF_JSON_KEY_ATTRIBUTES, 10)
    missing_attr = eq attr_pos, -1
    br missing_attr -> L_MISSING_ATTR, L_MALFORMED_ATTR_CHECK

L_MALFORMED_ATTR_CHECK:
    malformed_attr = eq attr_pos, -2
    br malformed_attr -> L_MALFORMED_ATTR, L_PARSE_FIELDS

L_PARSE_FIELDS:
    count_slot = stack_alloc 8
    store count_slot+0, 0 as i64
    s0 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_POSITION, 8, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_position, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_position, &count_slot)
    s1 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_NORMAL, 6, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_normal, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_normal, &count_slot)
    s2 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_TANGENT, 7, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_tangent, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_tangent, &count_slot)
    s3 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_COLOR_0, 7, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_color0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_color0, &count_slot)
    s4 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_TEXCOORD_0, 10, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord0, &count_slot)
    s5 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_TEXCOORD_1, 10, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord1, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord1, &count_slot)
    s6 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_JOINTS_0, 8, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_joints0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_joints0, &count_slot)
    s7 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_WEIGHTS_0, 9, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_weights0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_weights0, &count_slot)
    b0 = slt s0, 0
    b1 = slt s1, 0
    b2 = slt s2, 0
    b3 = slt s3, 0
    b4 = slt s4, 0
    b5 = slt s5, 0
    b6 = slt s6, 0
    b7 = slt s7, 0
    a0 = or b0, b1
    a1 = or b2, b3
    a2 = or b4, b5
    a3 = or b6, b7
    a4 = or a0, a1
    a5 = or a2, a3
    any_bad = or a4, a5
    br any_bad -> L_BAD_FIELDS, L_OK_FIELDS

L_OK_FIELDS:
    count = load count_slot+0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_count, count as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !count
    !any_bad
    !a5
    !a4
    !a3
    !a2
    !a1
    !a0
    !b7
    !b6
    !b5
    !b4
    !b3
    !b2
    !b1
    !b0
    !s7
    !s6
    !s5
    !s4
    !s3
    !s2
    !s1
    !s0
    !malformed_attr
    !missing_attr
    !attr_pos
    !out
    !primitive_object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_FIELDS:
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !any_bad
    !a5
    !a4
    !a3
    !a2
    !a1
    !a0
    !b7
    !b6
    !b5
    !b4
    !b3
    !b2
    !b1
    !b0
    !s7
    !s6
    !s5
    !s4
    !s3
    !s2
    !s1
    !s0
    !malformed_attr
    !missing_attr
    !attr_pos
    !out
    !primitive_object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_ATTR:
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_attr
    !attr_pos
    !out
    !primitive_object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_ATTR:
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_attr
    !missing_attr
    !attr_pos
    !out
    !primitive_object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_primitive_table_clear(&out: ptr) -> void:
L_ENTRY:
    attrs = ptr_add out, SA3D_GLTF_PRIMITIVE_TABLE_attributes
    store out+SA3D_GLTF_PRIMITIVE_TABLE_mode, SA3D_GLTF_MODE_TRIANGLES as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_has_indices, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_indices, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_has_material, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_material, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_target_count, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_targets_array_pos, -1 as i64
    call @sa3d_gltf_json_primitive_attr_table_clear(&attrs)
    !attrs
    !out
    return

@sa3d_gltf_json_primitive_store_targets(bytes: ptr, len: i64, primitive_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    targets_pos = call @sa3d_gltf_json_object_field_value(bytes, len, primitive_pos, &SA3D_GLTF_JSON_KEY_TARGETS, 7)
    missing = eq targets_pos, -1
    br missing -> L_OK_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq targets_pos, -2
    br malformed -> L_BAD, L_COUNT

L_COUNT:
    count = call @sa3d_gltf_json_count_array_items(bytes, len, targets_pos)
    count_bad = slt count, 0
    br count_bad -> L_BAD_COUNT, L_STORE

L_STORE:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_target_count, count as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_targets_array_pos, targets_pos as i64
    !count_bad
    !count
    !malformed
    !missing
    !targets_pos
    !out
    !primitive_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_target_count, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_targets_array_pos, -1 as i64
    !missing
    !targets_pos
    !out
    !primitive_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_COUNT:
    !count_bad
    !count
    !malformed
    !missing
    !targets_pos
    !out
    !primitive_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD:
    !malformed
    !missing
    !targets_pos
    !out
    !primitive_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_morph_target_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_has_position, 0 as i32
