    !is_tex
    !is_rgba
    !is_any
    !supported
    !supported_raw
    !normalized
    !accessor_format
    !conversion
    return 16

L_UNKNOWN:
    !is_joint_weight
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !supported
    !supported_raw
    !normalized
    !accessor_format
