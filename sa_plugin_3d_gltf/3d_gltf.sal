L_STORE:
    vptr = ptr_add bytes, value_pos
    vlen = sub end, value_pos
    store out_ptr+0, vptr as ptr
    store out_len+0, vlen as i64
    !vlen
    !vptr
    !bad_end
    !end
    !malformed
    !missing
    !value_pos
    !out_len
    !out_ptr
    !key_len
    !key
    !object_pos
