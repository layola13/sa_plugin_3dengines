    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_UNSUPPORTED:
    !supported
    !output_element_size
    !out_len
    !cap
    !dst
    !convert_coordinates
    !normalized
    !accessor_format
    !conversion
    !accessor_count
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !ok0
    !dst_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !supported
    !output_element_size
    !out_len
    !cap
    !dst
    !convert_coordinates
    !normalized
    !accessor_format
    !conversion
    !accessor_count
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !ok0
    !dst_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !supported
    !output_element_size
