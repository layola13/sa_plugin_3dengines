    !i
    !value_stride
    !value_base
    !index_stride
    !index_base
    !layouts_ok
    !value_ok
    !index_ok
    !value_status
    !index_status
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !a1
    !a0
    !element_positive
    !output_nonnegative
    !count_nonnegative
    !output_count
    !output_element_size
    !dst
    !value_layout
    !index_layout
    !index_component_type
    !convert_coordinates
    !normalized
    !accessor_format
    !conversion
    !sparse_count
    !buffer
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_INDEX_RANGE:
