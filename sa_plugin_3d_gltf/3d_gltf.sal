    return 0

@sa3d_gltf_accessor_layout_validate(buffer_len: i64, view_offset: i64, view_len: i64, view_stride: i64, accessor_offset: i64, accessor_count: i64, accessor_format: i32, &layout: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_accessor_layout_clear(&layout)
    element_size = call @sa3d_gltf_accessor_format_byte_size(accessor_format)
    supported = sgt element_size, 0
    br supported -> L_NONNEGATIVE, L_UNSUPPORTED_FORMAT

L_NONNEGATIVE:
    b0 = sge buffer_len, 0
    b1 = sge view_offset, 0
    b2 = sge view_len, 0
    b3 = sge view_stride, 0
    b4 = sge accessor_offset, 0
    b5 = sge accessor_count, 0
    a0 = and b0, b1
    a1 = and b2, b3
    a2 = and b4, b5
    a3 = and a0, a1
    nonnegative = and a3, a2
    br nonnegative -> L_STRIDE_SELECT, L_MALFORMED_NONNEG

L_STRIDE_SELECT:
    has_stride = sgt view_stride, 0
    br has_stride -> L_STRIDE_GIVEN, L_STRIDE_TIGHT

L_STRIDE_GIVEN:
    stride_given_ok = sge view_stride, element_size
    br stride_given_ok -> L_SPAN_GIVEN, L_MALFORMED_STRIDE

L_SPAN_GIVEN:
    empty_given = eq accessor_count, 0
    br empty_given -> L_SPAN_ZERO_GIVEN, L_SPAN_COUNT_GIVEN

L_SPAN_ZERO_GIVEN:
    required_given_zero = 0
    stride_given_final = add view_stride, 0
    jmp L_BOUNDS_GIVEN

L_SPAN_COUNT_GIVEN:
    count_minus_given = sub accessor_count, 1
    stepped_given = mul count_minus_given, view_stride
    required_given = add stepped_given, element_size
    stride_given_final2 = add view_stride, 0
    jmp L_BOUNDS_GIVEN_COUNT

L_BOUNDS_GIVEN:
    view_end_given_zero = add view_offset, view_len
    accessor_end_given_zero = add accessor_offset, required_given_zero
    byte_offset_given_zero = add view_offset, accessor_offset
    byte_end_given_zero = add byte_offset_given_zero, required_given_zero
    accessor_in_view_given_zero = sle accessor_end_given_zero, view_len
    view_in_buffer_given_zero = sle view_end_given_zero, buffer_len
    bytes_in_buffer_given_zero = sle byte_end_given_zero, buffer_len
    bounds_a_given_zero = and accessor_in_view_given_zero, view_in_buffer_given_zero
    bounds_ok_given_zero = and bounds_a_given_zero, bytes_in_buffer_given_zero
    br bounds_ok_given_zero -> L_OK_GIVEN_ZERO, L_MALFORMED_GIVEN_ZERO

L_BOUNDS_GIVEN_COUNT:
    view_end_given = add view_offset, view_len
    accessor_end_given = add accessor_offset, required_given
    byte_offset_given = add view_offset, accessor_offset
    byte_end_given = add byte_offset_given, required_given
    accessor_in_view_given = sle accessor_end_given, view_len
    view_in_buffer_given = sle view_end_given, buffer_len
    bytes_in_buffer_given = sle byte_end_given, buffer_len
    bounds_a_given = and accessor_in_view_given, view_in_buffer_given
    bounds_ok_given = and bounds_a_given, bytes_in_buffer_given
    br bounds_ok_given -> L_OK_GIVEN, L_MALFORMED_GIVEN

L_OK_GIVEN_ZERO:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset, byte_offset_given_zero as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_len, required_given_zero as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride, stride_given_final as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size, element_size as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK

L_OK_GIVEN:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset, byte_offset_given as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_len, required_given as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride, stride_given_final2 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size, element_size as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK

L_STRIDE_TIGHT:
    empty_tight = eq accessor_count, 0
    br empty_tight -> L_SPAN_ZERO_TIGHT, L_SPAN_COUNT_TIGHT

L_SPAN_ZERO_TIGHT:
    required_tight_zero = 0
    stride_tight_zero = add element_size, 0
    jmp L_BOUNDS_TIGHT_ZERO

L_SPAN_COUNT_TIGHT:
    required_tight = mul accessor_count, element_size
    stride_tight = add element_size, 0
    jmp L_BOUNDS_TIGHT

L_BOUNDS_TIGHT_ZERO:
    view_end_tight_zero = add view_offset, view_len
    accessor_end_tight_zero = add accessor_offset, required_tight_zero
    byte_offset_tight_zero = add view_offset, accessor_offset
    byte_end_tight_zero = add byte_offset_tight_zero, required_tight_zero
    accessor_in_view_tight_zero = sle accessor_end_tight_zero, view_len
    view_in_buffer_tight_zero = sle view_end_tight_zero, buffer_len
    bytes_in_buffer_tight_zero = sle byte_end_tight_zero, buffer_len
    bounds_a_tight_zero = and accessor_in_view_tight_zero, view_in_buffer_tight_zero
    bounds_ok_tight_zero = and bounds_a_tight_zero, bytes_in_buffer_tight_zero
    br bounds_ok_tight_zero -> L_OK_TIGHT_ZERO, L_MALFORMED_TIGHT_ZERO

L_BOUNDS_TIGHT:
    view_end_tight = add view_offset, view_len
    accessor_end_tight = add accessor_offset, required_tight
    byte_offset_tight = add view_offset, accessor_offset
    byte_end_tight = add byte_offset_tight, required_tight
    accessor_in_view_tight = sle accessor_end_tight, view_len
    view_in_buffer_tight = sle view_end_tight, buffer_len
    bytes_in_buffer_tight = sle byte_end_tight, buffer_len
    bounds_a_tight = and accessor_in_view_tight, view_in_buffer_tight
    bounds_ok_tight = and bounds_a_tight, bytes_in_buffer_tight
    br bounds_ok_tight -> L_OK_TIGHT, L_MALFORMED_TIGHT

L_OK_TIGHT_ZERO:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset, byte_offset_tight_zero as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_len, required_tight_zero as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride, stride_tight_zero as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size, element_size as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK

L_OK_TIGHT:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset, byte_offset_tight as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_len, required_tight as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride, stride_tight as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size, element_size as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK

L_UNSUPPORTED_FORMAT:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_UNSUPPORTED_FORMAT as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_NONNEG:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA

L_MALFORMED_STRIDE:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA

L_MALFORMED_GIVEN_ZERO:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA

L_MALFORMED_GIVEN:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA

L_MALFORMED_TIGHT_ZERO:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA

L_MALFORMED_TIGHT:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA

@sa3d_gltf_index_scan_result_clear(&result: ptr) -> void:
L_ENTRY:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_count, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_max_index, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_offset, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_len, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_stride, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_index_size, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA as i32
    !result
    return

@sa3d_gltf_index_format_byte_size(index_format: i32) -> i64:
L_ENTRY:
    is_u8 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U8
    br is_u8 -> L_U8, L_U16_CHECK

L_U8:
    !is_u8
    !index_format
    return 1

L_U16_CHECK:
    is_u16 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U16
    br is_u16 -> L_U16, L_U32_CHECK

L_U16:
    !is_u16
    !is_u8
    !index_format
    return 2

L_U32_CHECK:
    is_u32 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_u32 -> L_U32, L_UNSUPPORTED

L_U32:
    !is_u32
    !is_u16
    !is_u8
    !index_format
    return 4

L_UNSUPPORTED:
    !is_u32
    !is_u16
    !is_u8
    !index_format
    return 0

@sa3d_gltf_index_read_value(buffer: ptr, offset: i64, index_format: i32) -> i64:
L_ENTRY:
    is_u8 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U8
    br is_u8 -> L_U8, L_U16_CHECK

L_U8:
    p = ptr_add buffer, offset
    b = load p+0 as u8
    out = zext b as i64
    !p
    !is_u8
    !index_format
    !offset
    !buffer
    return out

L_U16_CHECK:
    is_u16 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U16
    br is_u16 -> L_U16, L_U32_CHECK

L_U16:
    out16 = call @sa3d_gltf_read_u16_le(buffer, offset)
    !is_u16
    !is_u8
    !index_format
    !offset
    !buffer
    return out16

L_U32_CHECK:
    is_u32 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_u32 -> L_U32, L_UNSUPPORTED

L_U32:
    out32 = call @sa3d_gltf_read_u32_le(buffer, offset)
    !is_u32
    !is_u16
    !is_u8
    !index_format
    !offset
    !buffer
    return out32

L_UNSUPPORTED:
    !is_u32
    !is_u16
    !is_u8
    !index_format
    !offset
    !buffer
    return -1

@sa3d_gltf_index_accessor_scan(buffer: ptr, buffer_len: i64, view_offset: i64, view_len: i64, view_stride: i64, accessor_offset: i64, accessor_count: i64, index_format: i32, &result: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_index_scan_result_clear(&result)
    index_size = call @sa3d_gltf_index_format_byte_size(index_format)
    supported = sgt index_size, 0
    br supported -> L_PTR_CHECK, L_UNSUPPORTED_FORMAT

L_PTR_CHECK:
    has_buffer = ne buffer, 0
    br has_buffer -> L_NONNEGATIVE, L_MALFORMED_PTR

L_NONNEGATIVE:
    b0 = sge buffer_len, 0
    b1 = sge view_offset, 0
    b2 = sge view_len, 0
    b3 = sge view_stride, 0
    b4 = sge accessor_offset, 0
    b5 = sge accessor_count, 0
    a0 = and b0, b1
    a1 = and b2, b3
    a2 = and b4, b5
    a3 = and a0, a1
    nonnegative = and a3, a2
    br nonnegative -> L_STRIDE_SELECT, L_MALFORMED_NONNEG

L_STRIDE_SELECT:
    has_stride = sgt view_stride, 0
    br has_stride -> L_STRIDE_GIVEN, L_STRIDE_TIGHT

L_STRIDE_GIVEN:
    stride_ok = sge view_stride, index_size
    br stride_ok -> L_SPAN_GIVEN, L_MALFORMED_STRIDE

L_STRIDE_TIGHT:
    stride_tight = add index_size, 0
    jmp L_SPAN_TIGHT

L_SPAN_GIVEN:
    stride_given = add view_stride, 0
    jmp L_SPAN_WITH_STRIDE

L_SPAN_TIGHT:
    stride_final_tight = add stride_tight, 0
    jmp L_SPAN_WITH_STRIDE_TIGHT

L_SPAN_WITH_STRIDE:
    empty_given = eq accessor_count, 0
    br empty_given -> L_EMPTY_GIVEN, L_COUNT_GIVEN

L_EMPTY_GIVEN:
    required_given_zero = 0
    stride_final_given_zero = add stride_given, 0
    jmp L_BOUNDS_GIVEN_ZERO

L_COUNT_GIVEN:
    count_minus_given = sub accessor_count, 1
    stepped_given = mul count_minus_given, stride_given
    required_given = add stepped_given, index_size
    stride_final_given = add stride_given, 0
    jmp L_BOUNDS_GIVEN

L_SPAN_WITH_STRIDE_TIGHT:
    empty_tight = eq accessor_count, 0
    br empty_tight -> L_EMPTY_TIGHT, L_COUNT_TIGHT

L_EMPTY_TIGHT:
    required_tight_zero = 0
    stride_final_tight_zero = add stride_final_tight, 0
    jmp L_BOUNDS_TIGHT_ZERO

L_COUNT_TIGHT:
    count_minus_tight = sub accessor_count, 1
    stepped_tight = mul count_minus_tight, stride_final_tight
    required_tight = add stepped_tight, index_size
    jmp L_BOUNDS_TIGHT

L_BOUNDS_GIVEN_ZERO:
    view_end_gz = add view_offset, view_len
    accessor_end_gz = add accessor_offset, required_given_zero
    byte_offset_gz = add view_offset, accessor_offset
    byte_end_gz = add byte_offset_gz, required_given_zero
    in_view_gz = sle accessor_end_gz, view_len
    view_in_buffer_gz = sle view_end_gz, buffer_len
    bytes_in_buffer_gz = sle byte_end_gz, buffer_len
    ba_gz = and in_view_gz, view_in_buffer_gz
    bounds_gz = and ba_gz, bytes_in_buffer_gz
    br bounds_gz -> L_OK_EMPTY_GIVEN, L_MALFORMED_BOUNDS_GZ

L_BOUNDS_GIVEN:
    view_end_g = add view_offset, view_len
    accessor_end_g = add accessor_offset, required_given
    byte_offset_g = add view_offset, accessor_offset
    byte_end_g = add byte_offset_g, required_given
    in_view_g = sle accessor_end_g, view_len
    view_in_buffer_g = sle view_end_g, buffer_len
    bytes_in_buffer_g = sle byte_end_g, buffer_len
    ba_g = and in_view_g, view_in_buffer_g
    bounds_g = and ba_g, bytes_in_buffer_g
    br bounds_g -> L_SCAN_INIT_GIVEN, L_MALFORMED_BOUNDS_G

L_BOUNDS_TIGHT_ZERO:
    view_end_tz = add view_offset, view_len
    accessor_end_tz = add accessor_offset, required_tight_zero
    byte_offset_tz = add view_offset, accessor_offset
    byte_end_tz = add byte_offset_tz, required_tight_zero
    in_view_tz = sle accessor_end_tz, view_len
    view_in_buffer_tz = sle view_end_tz, buffer_len
    bytes_in_buffer_tz = sle byte_end_tz, buffer_len
    ba_tz = and in_view_tz, view_in_buffer_tz
    bounds_tz = and ba_tz, bytes_in_buffer_tz
    br bounds_tz -> L_OK_EMPTY_TIGHT, L_MALFORMED_BOUNDS_TZ

L_BOUNDS_TIGHT:
    view_end_t = add view_offset, view_len
    accessor_end_t = add accessor_offset, required_tight
    byte_offset_t = add view_offset, accessor_offset
    byte_end_t = add byte_offset_t, required_tight
    in_view_t = sle accessor_end_t, view_len
    view_in_buffer_t = sle view_end_t, buffer_len
    bytes_in_buffer_t = sle byte_end_t, buffer_len
    ba_t = and in_view_t, view_in_buffer_t
    bounds_t = and ba_t, bytes_in_buffer_t
    br bounds_t -> L_SCAN_INIT_TIGHT, L_MALFORMED_BOUNDS_T

L_SCAN_INIT_GIVEN:
    idx_slot_g = stack_alloc 8
    max_slot_g = stack_alloc 8
    store idx_slot_g+0, 0 as i64
    store max_slot_g+0, 0 as i64
    jmp L_SCAN_HEAD_GIVEN

L_SCAN_HEAD_GIVEN:
    idx_g = load idx_slot_g+0 as i64
    done_g = sge idx_g, accessor_count
    br done_g -> L_OK_GIVEN, L_SCAN_BODY_GIVEN

L_SCAN_BODY_GIVEN:
    step_g = mul idx_g, stride_final_given
    pos_rel_g = add accessor_offset, step_g
    pos_abs_g = add view_offset, pos_rel_g
    value_g = call @sa3d_gltf_index_read_value(buffer, pos_abs_g, index_format)
    cur_max_g = load max_slot_g+0 as i64
    bigger_g = sgt value_g, cur_max_g
    br bigger_g -> L_SCAN_STORE_MAX_GIVEN, L_SCAN_NEXT_GIVEN

L_SCAN_STORE_MAX_GIVEN:
    store max_slot_g+0, value_g as i64
    jmp L_SCAN_NEXT_GIVEN

L_SCAN_NEXT_GIVEN:
    next_idx_g = add idx_g, 1
    store idx_slot_g+0, next_idx_g as i64
    !next_idx_g
    !bigger_g
    !cur_max_g
    !value_g
    !pos_abs_g
    !pos_rel_g
    !step_g
    !done_g
    !idx_g
    jmp L_SCAN_HEAD_GIVEN

L_OK_GIVEN:
    max_g = load max_slot_g+0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_count, accessor_count as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_max_index, max_g as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_offset, byte_offset_g as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_len, required_given as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_stride, stride_final_given as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_index_size, index_size as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_OK

L_SCAN_INIT_TIGHT:
    idx_slot_t = stack_alloc 8
    max_slot_t = stack_alloc 8
    store idx_slot_t+0, 0 as i64
    store max_slot_t+0, 0 as i64
    jmp L_SCAN_HEAD_TIGHT

L_SCAN_HEAD_TIGHT:
    idx_t = load idx_slot_t+0 as i64
    done_t = sge idx_t, accessor_count
    br done_t -> L_OK_TIGHT, L_SCAN_BODY_TIGHT

L_SCAN_BODY_TIGHT:
    step_t = mul idx_t, stride_final_tight
    pos_rel_t = add accessor_offset, step_t
    pos_abs_t = add view_offset, pos_rel_t
    value_t = call @sa3d_gltf_index_read_value(buffer, pos_abs_t, index_format)
    cur_max_t = load max_slot_t+0 as i64
    bigger_t = sgt value_t, cur_max_t
    br bigger_t -> L_SCAN_STORE_MAX_TIGHT, L_SCAN_NEXT_TIGHT

L_SCAN_STORE_MAX_TIGHT:
    store max_slot_t+0, value_t as i64
    jmp L_SCAN_NEXT_TIGHT

L_SCAN_NEXT_TIGHT:
    next_idx_t = add idx_t, 1
    store idx_slot_t+0, next_idx_t as i64
    !next_idx_t
    !bigger_t
    !cur_max_t
    !value_t
    !pos_abs_t
    !pos_rel_t
    !step_t
    !done_t
    !idx_t
    jmp L_SCAN_HEAD_TIGHT

L_OK_TIGHT:
    max_t = load max_slot_t+0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_count, accessor_count as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_max_index, max_t as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_offset, byte_offset_t as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_len, required_tight as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_stride, stride_final_tight as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_index_size, index_size as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_OK

L_OK_EMPTY_GIVEN:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_count, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_max_index, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_offset, byte_offset_gz as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_len, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_stride, stride_final_given_zero as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_index_size, index_size as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_OK

L_OK_EMPTY_TIGHT:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_count, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_max_index, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_offset, byte_offset_tz as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_len, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_stride, stride_final_tight_zero as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_index_size, index_size as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_OK

L_UNSUPPORTED_FORMAT:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_UNSUPPORTED_FORMAT as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_PTR:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

L_MALFORMED_NONNEG:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

L_MALFORMED_STRIDE:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

L_MALFORMED_BOUNDS_GZ:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

L_MALFORMED_BOUNDS_G:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

L_MALFORMED_BOUNDS_TZ:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

L_MALFORMED_BOUNDS_T:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA as i32
    !result
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

@sa3d_gltf_index_materialize_output_format(index_format: i32) -> i32:
L_ENTRY:
    is_u32 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_u32 -> L_U32, L_U16_CHECK

L_U32:
    !is_u32
    !index_format
    return SA3D_GLTF_INDEX_FORMAT_U32

L_U16_CHECK:
    is_u16 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U16
    is_u8 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U8
    small = or is_u16, is_u8
    br small -> L_U16, L_UNSUPPORTED

L_U16:
    !small
    !is_u8
    !is_u16
    !is_u32
    !index_format
    return SA3D_GLTF_INDEX_FORMAT_U16

L_UNSUPPORTED:
    !small
    !is_u8
    !is_u16
    !is_u32
    !index_format
    return 0

@sa3d_gltf_index_materialize_output_stride(index_format: i32) -> i64:
L_ENTRY:
    out_format = call @sa3d_gltf_index_materialize_output_format(index_format)
    is_u16 = eq out_format, SA3D_GLTF_INDEX_FORMAT_U16
    br is_u16 -> L_U16, L_U32_CHECK

L_U16:
    !is_u16
    !out_format
    !index_format
    return 2

L_U32_CHECK:
    is_u32 = eq out_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_u32 -> L_U32, L_UNSUPPORTED

L_U32:
    !is_u32
    !is_u16
    !out_format
    !index_format
    return 4

L_UNSUPPORTED:
    !is_u32
    !is_u16
    !out_format
    !index_format
    return 0

@sa3d_gltf_index_accessor_materialize(buffer: ptr, buffer_len: i64, view_offset: i64, view_len: i64, view_stride: i64, accessor_offset: i64, accessor_count: i64, index_format: i32, dst: ptr, cap: i64, &out_len: ptr, &out_index_format: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    store out_index_format+0, 0 as i32
    scan = stack_alloc SA3D_GLTF_INDEX_SCAN_RESULT_SIZE
    scan_status = call @sa3d_gltf_index_accessor_scan(buffer, buffer_len, view_offset, view_len, view_stride, accessor_offset, accessor_count, index_format, &scan)
    scan_ok = eq scan_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK
    br scan_ok -> L_OUTPUT_FORMAT, L_SCAN_ERROR

L_OUTPUT_FORMAT:
    output_format = call @sa3d_gltf_index_materialize_output_format(index_format)
    output_stride = call @sa3d_gltf_index_materialize_output_stride(index_format)
    output_ok = ne output_stride, 0
    br output_ok -> L_PTR_CHECK, L_UNSUPPORTED

L_PTR_CHECK:
    cap_nonnegative = sge cap, 0
    dst_present = ne dst, 0
    ptr_ok = and cap_nonnegative, dst_present
    br ptr_ok -> L_CAP_CHECK, L_MALFORMED_PTR

L_CAP_CHECK:
    count = load scan+SA3D_GLTF_INDEX_SCAN_RESULT_count as i64
    required = mul count, output_stride
    cap_ok = sge cap, required
    br cap_ok -> L_LOOP_SELECT, L_OUTPUT_SMALL

L_LOOP_SELECT:
    store out_index_format+0, output_format as i32
    byte_offset = load scan+SA3D_GLTF_INDEX_SCAN_RESULT_byte_offset as i64
    stride = load scan+SA3D_GLTF_INDEX_SCAN_RESULT_stride as i64
    is_output_u32 = eq output_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_output_u32 -> L_U32_LOOP_INIT, L_U16_LOOP_INIT

L_U16_LOOP_INIT:
    idx16_slot = stack_alloc 8
    store idx16_slot+0, 0 as i64
    jmp L_U16_LOOP_HEAD

L_U16_LOOP_HEAD:
    idx16 = load idx16_slot+0 as i64
    done16 = sge idx16, count
    br done16 -> L_DONE_U16, L_U16_LOOP_BODY

L_U16_LOOP_BODY:
    src16_step = mul idx16, stride
    src16_pos = add byte_offset, src16_step
    dst16_step = mul idx16, 2
    dst16_ptr = ptr_add dst, dst16_step
    value16 = call @sa3d_gltf_index_read_value(buffer, src16_pos, index_format)
    store dst16_ptr+0, value16 as u16
    next16 = add idx16, 1
    store idx16_slot+0, next16 as i64
    !next16
    !value16
    !dst16_ptr
    !dst16_step
    !src16_pos
    !src16_step
    !done16
    !idx16
    jmp L_U16_LOOP_HEAD

L_DONE_U16:
    store out_len+0, required as i64
    !done16
    !idx16
    !is_output_u32
    !stride
    !byte_offset
    !cap_ok
    !required
    !count
    !ptr_ok
    !dst_present
    !cap_nonnegative
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK

L_U32_LOOP_INIT:
    idx32_slot = stack_alloc 8
    store idx32_slot+0, 0 as i64
    jmp L_U32_LOOP_HEAD

L_U32_LOOP_HEAD:
    idx32 = load idx32_slot+0 as i64
    done32 = sge idx32, count
    br done32 -> L_DONE_U32, L_U32_LOOP_BODY

L_U32_LOOP_BODY:
    src32_step = mul idx32, stride
    src32_pos = add byte_offset, src32_step
    dst32_step = mul idx32, 4
    dst32_ptr = ptr_add dst, dst32_step
    value32 = call @sa3d_gltf_index_read_value(buffer, src32_pos, index_format)
    store dst32_ptr+0, value32 as u32
    next32 = add idx32, 1
    store idx32_slot+0, next32 as i64
    !next32
    !value32
    !dst32_ptr
    !dst32_step
    !src32_pos
    !src32_step
    !done32
    !idx32
    jmp L_U32_LOOP_HEAD

L_DONE_U32:
    store out_len+0, required as i64
    !done32
    !idx32
    !is_output_u32
    !stride
    !byte_offset
    !cap_ok
    !required
    !count
    !ptr_ok
    !dst_present
    !cap_nonnegative
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK

L_SCAN_ERROR:
    unsupported_scan = eq scan_status, SA3D_GLTF_INDEX_SCAN_STATUS_UNSUPPORTED_FORMAT
    br unsupported_scan -> L_SCAN_UNSUPPORTED, L_SCAN_MALFORMED

L_SCAN_UNSUPPORTED:
    !unsupported_scan
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_SCAN_MALFORMED:
    !unsupported_scan
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_MALFORMED_DATA

L_UNSUPPORTED:
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_PTR:
    !ptr_ok
    !dst_present
    !cap_nonnegative
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_MALFORMED_DATA

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !count
    !ptr_ok
    !dst_present
    !cap_nonnegative
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OUTPUT_TOO_SMALL

@sa3d_gltf_index_store_output_value(dst: ptr, dst_pos: i64, output_format: i32, value: i64) -> void:
L_ENTRY:
    is_u32 = eq output_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_u32 -> L_U32, L_U16

L_U32:
    out32 = ptr_add dst, dst_pos
    store out32+0, value as u32
    !out32
    !is_u32
    !value
    !output_format
    !dst_pos
    !dst
    return

L_U16:
    out16 = ptr_add dst, dst_pos
    store out16+0, value as u16
    !is_u32
    !value
    !output_format
    !dst_pos
    !dst
    return

@sa3d_gltf_index_base_value(buffer: ptr, idx: i64, has_base: i32, index_format: i32, &layout: ptr) -> i64:
L_ENTRY:
    has_base_bool = ne has_base, 0
    br has_base_bool -> L_READ, L_ZERO

L_READ:
    byte_offset = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset as i64
    stride = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride as i64
    step = mul idx, stride
    pos = add byte_offset, step
    value = call @sa3d_gltf_index_read_value(buffer, pos, index_format)
    !pos
    !step
    !stride
    !byte_offset
    !has_base_bool
    !layout
    !index_format
    !has_base
    !idx
    !buffer
    return value

L_ZERO:
    !has_base_bool
    !layout
    !index_format
    !has_base
    !idx
    !buffer
    return 0

@sa3d_gltf_index_sparse_lookup(buffer: ptr, target_index: i64, sparse_count: i64, index_component_type: i32, value_index_format: i32, &index_layout: ptr, &value_layout: ptr, &found: ptr) -> i64:
L_ENTRY:
    store found+0, 0 as i32
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    i = load idx_slot+0 as i64
    done = sge i, sparse_count
    br done -> L_NOT_FOUND, L_BODY

L_BODY:
    index_base = load index_layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset as i64
    index_stride = load index_layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride as i64
    index_step = mul i, index_stride
    index_pos = add index_base, index_step
    sparse_index = call @sa3d_gltf_sparse_read_index(buffer, index_pos, index_component_type)
    is_target = eq sparse_index, target_index
    br is_target -> L_FOUND, L_NEXT

L_FOUND:
    value_base = load value_layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset as i64
    value_stride = load value_layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride as i64
    value_step = mul i, value_stride
    value_pos = add value_base, value_step
    value = call @sa3d_gltf_index_read_value(buffer, value_pos, value_index_format)
    store found+0, 1 as i32
    !value_pos
    !value_step
    !value_stride
    !value_base
    !is_target
    !sparse_index
    !index_pos
    !index_step
    !index_stride
    !index_base
    !done
    !i
    !found
    !value_layout
    !index_layout
    !value_index_format
    !index_component_type
    !sparse_count
    !target_index
    !buffer
    return value

L_NEXT:
    next_i = add i, 1
    store idx_slot+0, next_i as i64
    !next_i
    !is_target
    !sparse_index
    !index_pos
    !index_step
    !index_stride
    !index_base
    !done
    !i
    jmp L_HEAD

L_NOT_FOUND:
    !done
    !i
    !found
    !value_layout
    !index_layout
    !value_index_format
    !index_component_type
    !sparse_count
    !target_index
    !buffer
    return 0

@sa3d_gltf_index_final_scan_loop(buffer: ptr, accessor_count: i64, has_base: i32, index_format: i32, sparse_count: i64, index_component_type: i32, &base_layout: ptr, &index_layout: ptr, &value_layout: ptr, &result: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_index_scan_result_clear(&result)
    count_nonnegative = sge accessor_count, 0
    sparse_nonnegative = sge sparse_count, 0
    counts_ok = and count_nonnegative, sparse_nonnegative
    br counts_ok -> L_FORMAT, L_MALFORMED

L_FORMAT:
    index_size = call @sa3d_gltf_index_format_byte_size(index_format)
    supported = sgt index_size, 0
    br supported -> L_EMPTY_CHECK, L_UNSUPPORTED

L_EMPTY_CHECK:
    empty = eq accessor_count, 0
    br empty -> L_DONE_EMPTY, L_LOOP_INIT

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    max_slot = stack_alloc 8
    found_slot = stack_alloc 4
    store idx_slot+0, 0 as i64
    store max_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, accessor_count
    br done -> L_DONE, L_BODY

L_BODY:
    base_value = call @sa3d_gltf_index_base_value(buffer, idx, has_base, index_format, &base_layout)
    has_sparse = sgt sparse_count, 0
    br has_sparse -> L_LOOKUP, L_VALUE_READY_BASE

L_LOOKUP:
    sparse_value = call @sa3d_gltf_index_sparse_lookup(buffer, idx, sparse_count, index_component_type, index_format, &index_layout, &value_layout, &found_slot)
    found_value = load found_slot+0 as i32
    found_bool = ne found_value, 0
    br found_bool -> L_VALUE_READY_SPARSE, L_VALUE_READY_NO_PATCH

L_VALUE_READY_SPARSE:
    current = add sparse_value, 0
    !found_bool
    !found_value
    !sparse_value
    jmp L_UPDATE_MAX

L_VALUE_READY_NO_PATCH:
    current_no_patch = add base_value, 0
    !found_bool
    !found_value
    !sparse_value
    jmp L_UPDATE_MAX_NO_PATCH

L_VALUE_READY_BASE:
    current_base = add base_value, 0
    jmp L_UPDATE_MAX_BASE

L_UPDATE_MAX:
    cur_max = load max_slot+0 as i64
    bigger = sgt current, cur_max
    br bigger -> L_STORE_MAX, L_NEXT

L_STORE_MAX:
    store max_slot+0, current as i64
    jmp L_NEXT

L_NEXT:
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !bigger
    !cur_max
    !current
    !has_sparse
    !base_value
    !done
    !idx
    jmp L_HEAD

L_UPDATE_MAX_NO_PATCH:
    cur_max_np = load max_slot+0 as i64
    bigger_np = sgt current_no_patch, cur_max_np
    br bigger_np -> L_STORE_MAX_NP, L_NEXT_NP

L_STORE_MAX_NP:
    store max_slot+0, current_no_patch as i64
    jmp L_NEXT_NP

L_NEXT_NP:
    next_idx_np = add idx, 1
    store idx_slot+0, next_idx_np as i64
    !next_idx_np
    !bigger_np
    !cur_max_np
    !current_no_patch
    !has_sparse
    !base_value
    !done
    !idx
    jmp L_HEAD

L_UPDATE_MAX_BASE:
    cur_max_b = load max_slot+0 as i64
    bigger_b = sgt current_base, cur_max_b
    br bigger_b -> L_STORE_MAX_B, L_NEXT_B

L_STORE_MAX_B:
    store max_slot+0, current_base as i64
    jmp L_NEXT_B

L_NEXT_B:
    next_idx_b = add idx, 1
    store idx_slot+0, next_idx_b as i64
    !next_idx_b
    !bigger_b
    !cur_max_b
    !current_base
    !has_sparse
    !base_value
    !done
    !idx
    jmp L_HEAD

L_DONE:
    max_value = load max_slot+0 as i64
    byte_len = mul accessor_count, index_size
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_count, accessor_count as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_max_index, max_value as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_offset, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_len, byte_len as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_stride, index_size as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_index_size, index_size as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK as i32
    !byte_len
    !max_value
    !done
    !idx
    !empty
    !supported
    !index_size
    !counts_ok
    !sparse_nonnegative
    !count_nonnegative
    !result
    !value_layout
    !index_layout
    !base_layout
    !index_component_type
    !sparse_count
    !index_format
    !has_base
    !accessor_count
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_OK

L_DONE_EMPTY:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_count, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_max_index, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_offset, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_byte_len, 0 as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_stride, index_size as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_index_size, index_size as i64
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK as i32
    !empty
    !supported
    !index_size
    !counts_ok
    !sparse_nonnegative
    !count_nonnegative
    !result
    !value_layout
    !index_layout
    !base_layout
    !index_component_type
    !sparse_count
    !index_format
    !has_base
    !accessor_count
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_OK

L_UNSUPPORTED:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_UNSUPPORTED_FORMAT as i32
    !supported
    !index_size
    !counts_ok
    !sparse_nonnegative
    !count_nonnegative
    !result
    !value_layout
    !index_layout
    !base_layout
    !index_component_type
    !sparse_count
    !index_format
    !has_base
    !accessor_count
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    store result+SA3D_GLTF_INDEX_SCAN_RESULT_status, SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA as i32
    !counts_ok
    !sparse_nonnegative
    !count_nonnegative
    !result
    !value_layout
    !index_layout
    !base_layout
    !index_component_type
    !sparse_count
    !index_format
    !has_base
    !accessor_count
    !buffer
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

@sa3d_gltf_index_final_materialize_loop(buffer: ptr, accessor_count: i64, has_base: i32, index_format: i32, sparse_count: i64, index_component_type: i32, &base_layout: ptr, &index_layout: ptr, &value_layout: ptr, dst: ptr, cap: i64, &out_len: ptr, &out_index_format: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    store out_index_format+0, 0 as i32
    output_format = call @sa3d_gltf_index_materialize_output_format(index_format)
    output_stride = call @sa3d_gltf_index_materialize_output_stride(index_format)
    output_ok = ne output_stride, 0
    br output_ok -> L_PTR, L_UNSUPPORTED

L_PTR:
    count_nonnegative = sge accessor_count, 0
    sparse_nonnegative = sge sparse_count, 0
    cap_nonnegative = sge cap, 0
    dst_present = ne dst, 0
    a0 = and count_nonnegative, sparse_nonnegative
    a1 = and cap_nonnegative, dst_present
    ok0 = and a0, a1
    br ok0 -> L_CAP, L_MALFORMED

L_CAP:
    required = mul accessor_count, output_stride
    cap_ok = sge cap, required
    br cap_ok -> L_LOOP_INIT, L_OUTPUT_SMALL

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    found_slot = stack_alloc 4
    store out_index_format+0, output_format as i32
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, accessor_count
    br done -> L_DONE, L_BODY

L_BODY:
    base_value = call @sa3d_gltf_index_base_value(buffer, idx, has_base, index_format, &base_layout)
    has_sparse = sgt sparse_count, 0
    br has_sparse -> L_LOOKUP, L_STORE_BASE

L_LOOKUP:
    sparse_value = call @sa3d_gltf_index_sparse_lookup(buffer, idx, sparse_count, index_component_type, index_format, &index_layout, &value_layout, &found_slot)
    found_value = load found_slot+0 as i32
    found_bool = ne found_value, 0
    br found_bool -> L_STORE_SPARSE, L_STORE_NO_PATCH

L_STORE_SPARSE:
    dst_step = mul idx, output_stride
    call @sa3d_gltf_index_store_output_value(dst, dst_step, output_format, sparse_value)
    !dst_step
    !found_bool
    !found_value
    !sparse_value
    jmp L_NEXT

L_STORE_NO_PATCH:
    dst_step_np = mul idx, output_stride
    call @sa3d_gltf_index_store_output_value(dst, dst_step_np, output_format, base_value)
    !dst_step_np
    !found_bool
    !found_value
    !sparse_value
    jmp L_NEXT

L_STORE_BASE:
    dst_step_b = mul idx, output_stride
    call @sa3d_gltf_index_store_output_value(dst, dst_step_b, output_format, base_value)
    !dst_step_b
    jmp L_NEXT

L_NEXT:
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !has_sparse
    !base_value
    !done
    !idx
    jmp L_HEAD

L_DONE:
    store out_len+0, required as i64
    !done
    !idx
    !cap_ok
    !required
    !ok0
    !a1
    !a0
    !dst_present
    !cap_nonnegative
    !sparse_nonnegative
    !count_nonnegative
    !output_ok
    !output_stride
    !output_format
    !out_index_format
    !out_len
    !cap
    !dst
    !value_layout
    !index_layout
    !base_layout
    !index_component_type
    !sparse_count
    !index_format
    !has_base
    !accessor_count
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK

L_UNSUPPORTED:
    !output_ok
    !output_stride
    !output_format
    !out_index_format
    !out_len
    !cap
    !dst
    !value_layout
    !index_layout
    !base_layout
    !index_component_type
    !sparse_count
    !index_format
    !has_base
    !accessor_count
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !ok0
    !a1
    !a0
    !dst_present
    !cap_nonnegative
    !sparse_nonnegative
    !count_nonnegative
    !output_ok
    !output_stride
    !output_format
    !out_index_format
    !out_len
    !cap
    !dst
    !value_layout
    !index_layout
    !base_layout
    !index_component_type
    !sparse_count
    !index_format
    !has_base
    !accessor_count
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_MALFORMED_DATA

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !ok0
    !a1
    !a0
    !dst_present
    !cap_nonnegative
    !sparse_nonnegative
    !count_nonnegative
    !output_ok
    !output_stride
    !output_format
    !out_index_format
    !out_len
    !cap
    !dst
    !value_layout
    !index_layout
    !base_layout
    !index_component_type
    !sparse_count
    !index_format
    !has_base
    !accessor_count
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OUTPUT_TOO_SMALL

@sa3d_gltf_json_resolve_status_to_index_scan_status(resolve_status: i32) -> i32:
L_ENTRY:
    is_ok = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br is_ok -> L_OK, L_UNSUPPORTED_CHECK

L_OK:
    !is_ok
    !resolve_status
    return SA3D_GLTF_INDEX_SCAN_STATUS_OK

L_UNSUPPORTED_CHECK:
    is_unsupported = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_UNSUPPORTED_FORMAT
    br is_unsupported -> L_UNSUPPORTED, L_MALFORMED

L_UNSUPPORTED:
    !is_unsupported
    !is_ok
    !resolve_status
    return SA3D_GLTF_INDEX_SCAN_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !is_unsupported
    !is_ok
    !resolve_status
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

@sa3d_gltf_json_resolve_status_to_index_materialize_status(resolve_status: i32) -> i32:
L_ENTRY:
    is_ok = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br is_ok -> L_OK, L_UNSUPPORTED_CHECK

L_OK:
    !is_ok
    !resolve_status
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK

L_UNSUPPORTED_CHECK:
    is_unsupported = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_UNSUPPORTED_FORMAT
    br is_unsupported -> L_UNSUPPORTED, L_MALFORMED

L_UNSUPPORTED:
    !is_unsupported
    !is_ok
    !resolve_status
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !is_unsupported
    !is_ok
    !resolve_status
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_MALFORMED_DATA

@sa3d_gltf_json_table_status_to_index_scan_status(table_status: i32) -> i32:
L_ENTRY:
    unsupported = eq table_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br unsupported -> L_UNSUPPORTED, L_MALFORMED

L_UNSUPPORTED:
    !unsupported
    !table_status
    return SA3D_GLTF_INDEX_SCAN_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !unsupported
    !table_status
    return SA3D_GLTF_INDEX_SCAN_STATUS_MALFORMED_DATA

@sa3d_gltf_json_table_status_to_index_materialize_status(table_status: i32) -> i32:
L_ENTRY:
    unsupported = eq table_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br unsupported -> L_UNSUPPORTED, L_MALFORMED

L_UNSUPPORTED:
    !unsupported
    !table_status
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !unsupported
    !table_status
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_MALFORMED_DATA

@sa3d_gltf_json_index_accessor_scan(bytes: ptr, len: i64, accessor_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, &result: ptr) -> i32:
L_ENTRY:
    accessor = stack_alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    base_view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    base_layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    sparse = stack_alloc SA3D_GLTF_ACCESSOR_SPARSE_TABLE_SIZE
    index_view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    value_view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    index_layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    value_layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    call @sa3d_gltf_index_scan_result_clear(&result)
    accessor_status = call @sa3d_gltf_json_accessor_parse(bytes, len, accessor_index, &accessor)
    accessor_ok = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_ok -> L_FORMAT, L_ACCESSOR_ERROR

L_FORMAT:
    component_type = load accessor+SA3D_GLTF_ACCESSOR_TABLE_component_type as i32
    index_format = call @sa3d_gltf_index_format_from_component_type(component_type)
    index_supported = ne index_format, 0
    br index_supported -> L_COUNT, L_UNSUPPORTED_FORMAT

L_COUNT:
    accessor_count = load accessor+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    has_bv = load accessor+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view as i32
    has_bv_bool = ne has_bv, 0
    br has_bv_bool -> L_BASE_RESOLVE, L_SPARSE_CHECK_NO_BASE

L_BASE_RESOLVE:
    bv_i32 = load accessor+SA3D_GLTF_ACCESSOR_TABLE_buffer_view as i32
    bv_index = zext bv_i32 as i64
    accessor_offset = load accessor+SA3D_GLTF_ACCESSOR_TABLE_byte_offset as i64
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    base_resolve = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, bv_index, buffer_index, buffer_len, accessor_offset, accessor_count, accessor_format, &base_view, &base_layout)
    base_ok = eq base_resolve, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br base_ok -> L_SPARSE_CHECK_BASE, L_BASE_RESOLVE_ERROR

L_SPARSE_CHECK_BASE:
    sparse_present_base_raw = call @sa3d_gltf_json_accessor_has_sparse(bytes, len, accessor_index)
    sparse_bad_base = slt sparse_present_base_raw, 0
    br sparse_bad_base -> L_MALFORMED_SPARSE_BASE_CHECK, L_SPARSE_PRESENT_BASE_CHECK

L_SPARSE_PRESENT_BASE_CHECK:
    sparse_present_base = sgt sparse_present_base_raw, 0
    br sparse_present_base -> L_SPARSE_PARSE_BASE, L_SCAN_BASE_NO_SPARSE

L_SCAN_BASE_NO_SPARSE:
    scan_status_base = call @sa3d_gltf_index_final_scan_loop(buffer, accessor_count, 1, index_format, 0, 0, &base_layout, &index_layout, &value_layout, &result)
    !scan_status_base
    !sparse_present_base
    !sparse_present_base_raw
    !base_ok
    !base_resolve
    !accessor_format
