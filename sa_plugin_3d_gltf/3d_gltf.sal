@sa3d_gltf_asset_desc_init(&desc: ptr) -> void:
L_ENTRY:
    store desc+SA3D_GLTF_ASSET_DESC_source_ptr, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_source_len, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_ptr, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_len, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_format, SA3D_GLTF_FORMAT_JSON as i32
    store desc+SA3D_GLTF_ASSET_DESC_flags, 0 as i32
    !desc
    return

@sa3d_gltf_asset_desc_get_format(&desc: ptr) -> i32:
L_ENTRY:
    fmt = load desc+SA3D_GLTF_ASSET_DESC_format as i32
    !desc
    return fmt

@sa3d_gltf_asset_desc_set_format(&desc: ptr, format: i32) -> void:
L_ENTRY:
    store desc+SA3D_GLTF_ASSET_DESC_format, format as i32
    !format
    !desc
    return

@sa3d_gltf_ptr_len_pair_is_valid(ptr: ptr, len: i64) -> i32:
L_ENTRY:
    nonnegative = sge len, 0
    zero = eq len, 0
    has_ptr = ne ptr, 0
    ptr_ok = or zero, has_ptr
    ok = and nonnegative, ptr_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !ptr_ok
    !has_ptr
    !zero
    !nonnegative
    !len
    !ptr
    return 1

L_FALSE:
    !ok
    !ptr_ok
    !has_ptr
    !zero
    !nonnegative
    !len
    !ptr
    return 0

@sa3d_gltf_asset_desc_set_base_uri(&desc: ptr, base_uri: ptr, len: i64) -> void:
L_ENTRY:
    negative = slt len, 0
    br negative -> L_ZERO, L_SET

L_ZERO:
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_ptr, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_len, 0 as i64
    !negative
    !len
    !base_uri
    !desc
    return

L_SET:
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_ptr, base_uri as ptr
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_len, len as i64
    !negative
    !len
    !base_uri
    !desc
    return

@sa3d_gltf_format_is_valid(format: i32) -> i32:
L_ENTRY:
    is_json = eq format, SA3D_GLTF_FORMAT_JSON
    is_glb = eq format, SA3D_GLTF_FORMAT_GLB
    ok = or is_json, is_glb
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !is_glb
    !is_json
    !format
    return 1

L_FALSE:
    !ok
    !is_glb
    !is_json
    !format
    return 0

@sa3d_gltf_load_flags_are_valid(flags: i32) -> i32:
L_ENTRY:
    extra = and flags, -32
    ok = eq extra, 0
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !extra
    !flags
    return 1

L_FALSE:
    !ok
    !extra
    !flags
    return 0

@sa3d_gltf_byte_is_ws(byte: u8) -> i32:
L_ENTRY:
    space = eq byte, 32
    tab = eq byte, 9
    lf = eq byte, 10
    cr = eq byte, 13
    a = or space, tab
    b = or lf, cr
    ok = or a, b
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !b
    !a
    !cr
    !lf
    !tab
    !space
    !byte
    return 1

L_FALSE:
    !ok
    !b
    !a
    !cr
    !lf
    !tab
    !space
    !byte
    return 0

@sa3d_gltf_find_first_non_ws(bytes: ptr, len: i64) -> i64:
L_ENTRY:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_CHECK

L_CHECK:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_NONE, L_LOAD

L_LOAD:
    cur_ptr = ptr_add bytes, idx
    byte = load cur_ptr+0 as u8
    is_ws = call @sa3d_gltf_byte_is_ws(byte)
    br is_ws -> L_NEXT, L_FOUND

L_NEXT:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !is_ws
    !byte
    !cur_ptr
    !idx
    !done
    jmp L_CHECK

L_FOUND:
    !is_ws
    !byte
    !cur_ptr
    !done
    !len
    !bytes
    return idx

L_NONE:
    !done
    !idx
    !len
    !bytes
    return -1

@sa3d_gltf_find_last_non_ws(bytes: ptr, len: i64) -> i64:
L_ENTRY:
    idx_slot = stack_alloc 8
    last = sub len, 1
    store idx_slot+0, last as i64
    jmp L_CHECK

L_CHECK:
    idx = load idx_slot+0 as i64
    done = slt idx, 0
    br done -> L_NONE, L_LOAD

L_LOAD:
    cur_ptr = ptr_add bytes, idx
    byte = load cur_ptr+0 as u8
    is_ws = call @sa3d_gltf_byte_is_ws(byte)
    br is_ws -> L_PREV, L_FOUND

L_PREV:
    prev = sub idx, 1
    store idx_slot+0, prev as i64
    !prev
    !is_ws
    !byte
    !cur_ptr
    !idx
    !done
    jmp L_CHECK

L_FOUND:
    !is_ws
    !byte
    !cur_ptr
    !done
    !len
    !bytes
    return idx

L_NONE:
    !done
    !idx
    !len
    !bytes
    return -1

@sa3d_gltf_read_u32_le(bytes: ptr, offset: i64) -> i64:
L_ENTRY:
    base = ptr_add bytes, offset
    b0 = load base+0 as u8
    b1 = load base+1 as u8
    b2 = load base+2 as u8
    b3 = load base+3 as u8
    v0 = zext b0 as i64
    v1z = zext b1 as i64
    v2z = zext b2 as i64
    v3z = zext b3 as i64
    v1 = shl v1z, 8
    v2 = shl v2z, 16
    v3 = shl v3z, 24
    s0 = add v0, v1
    s1 = add v2, v3
    value = add s0, s1
    !base
    !offset
    !bytes
    return value

@sa3d_gltf_read_u16_le(bytes: ptr, offset: i64) -> i64:
L_ENTRY:
    base = ptr_add bytes, offset
    b0 = load base+0 as u8
    b1 = load base+1 as u8
    v0 = zext b0 as i64
    v1z = zext b1 as i64
    v1 = shl v1z, 8
    value = add v0, v1
    !base
    !offset
    !bytes
    return value

@sa3d_gltf_glb_view_init(&view: ptr) -> void:
L_ENTRY:
    store view+SA3D_GLTF_GLB_VIEW_json_ptr, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_json_len, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_bin_ptr, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_bin_len, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_declared_len, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_chunk_count, 0 as i32
    store view+SA3D_GLTF_GLB_VIEW_has_bin, 0 as i32
    store view+SA3D_GLTF_GLB_VIEW_status, SA3D_GLTF_GLB_STATUS_MISSING_JSON as i32
    !view
    return

@sa3d_gltf_glb_view_set_status(&view: ptr, status: i32) -> i32:
L_ENTRY:
    store view+SA3D_GLTF_GLB_VIEW_status, status as i32
    !view
    return status

@sa3d_gltf_glb_parse_bytes(bytes: ptr, len: i64, &view: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_glb_view_init(&view)
    has_bytes = ne bytes, 0
    len_min = sge len, 20
    len_align_bits = and len, 3
    len_aligned = eq len_align_bits, 0
    head_a = and has_bytes, len_min
    head_ok = and head_a, len_aligned
    br head_ok -> L_HEADER_FIELDS, L_BAD_HEADER_INIT

L_HEADER_FIELDS:
    magic = call @sa3d_gltf_read_u32_le(bytes, 0)
    version = call @sa3d_gltf_read_u32_le(bytes, 4)
    declared_len = call @sa3d_gltf_read_u32_le(bytes, 8)
    store view+SA3D_GLTF_GLB_VIEW_declared_len, declared_len as i64
    magic_ok = eq magic, SA3D_GLTF_GLB_MAGIC
    version_ok = eq version, 2
    hv = and magic_ok, version_ok
    declared_ok = eq declared_len, len
    br hv -> L_DECLARED_CHECK, L_BAD_HEADER_FIELDS

L_DECLARED_CHECK:
    br declared_ok -> L_LOOP_INIT, L_BAD_DECLARED_LENGTH

L_LOOP_INIT:
    offset_slot = stack_alloc 8
    store offset_slot+0, 12 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    offset = load offset_slot+0 as i64
    done = eq offset, len
    br done -> L_DONE, L_CHUNK_HEADER_CHECK

L_CHUNK_HEADER_CHECK:
    remaining = sub len, offset
    header_ok = sge remaining, 8
    br header_ok -> L_READ_CHUNK, L_CHUNK_OVERFLOW_HEADER

L_READ_CHUNK:
    chunk_len = call @sa3d_gltf_read_u32_le(bytes, offset)
    type_offset = add offset, 4
    chunk_type = call @sa3d_gltf_read_u32_le(bytes, type_offset)
    align_bits = and chunk_len, 3
    align_ok = eq align_bits, 0
    data_start = add offset, 8
    data_end = add data_start, chunk_len
    within = sle data_end, len
    br align_ok -> L_CHUNK_BOUNDS, L_CHUNK_ALIGNMENT

L_CHUNK_BOUNDS:
    br within -> L_CHUNK_KIND, L_CHUNK_OVERFLOW_BOUNDS

L_CHUNK_KIND:
    first = eq offset, 12
    br first -> L_FIRST_CHUNK, L_NON_FIRST_CHUNK

L_FIRST_CHUNK:
    is_json = eq chunk_type, SA3D_GLTF_GLB_CHUNK_TYPE_JSON
    json_nonempty = sgt chunk_len, 0
    json_ok = and is_json, json_nonempty
    br json_ok -> L_STORE_JSON, L_BAD_FIRST_CHUNK

L_STORE_JSON:
    json_ptr = ptr_add bytes, data_start
    store view+SA3D_GLTF_GLB_VIEW_json_ptr, json_ptr as ptr
    store view+SA3D_GLTF_GLB_VIEW_json_len, chunk_len as i64
    store view+SA3D_GLTF_GLB_VIEW_chunk_count, 1 as i32
    store offset_slot+0, data_end as i64
    !json_ptr
    !json_ok
    !json_nonempty
    !is_json
    !first
    !within
    !data_end
    !data_start
    !align_ok
    !align_bits
    !chunk_type
    !type_offset
    !chunk_len
    !header_ok
    !remaining
    !done
    !offset
    jmp L_LOOP_HEAD

L_NON_FIRST_CHUNK:
    is_bin = eq chunk_type, SA3D_GLTF_GLB_CHUNK_TYPE_BIN
    br is_bin -> L_BIN_CHUNK, L_SKIP_CHUNK

L_BIN_CHUNK:
    has_bin = load view+SA3D_GLTF_GLB_VIEW_has_bin as i32
    no_bin = eq has_bin, 0
    br no_bin -> L_STORE_BIN, L_DUPLICATE_BIN

L_STORE_BIN:
    bin_ptr = ptr_add bytes, data_start
    old_count = load view+SA3D_GLTF_GLB_VIEW_chunk_count as i32
    next_count = add old_count, 1
    store view+SA3D_GLTF_GLB_VIEW_bin_ptr, bin_ptr as ptr
    store view+SA3D_GLTF_GLB_VIEW_bin_len, chunk_len as i64
    store view+SA3D_GLTF_GLB_VIEW_has_bin, 1 as i32
    store view+SA3D_GLTF_GLB_VIEW_chunk_count, next_count as i32
    store offset_slot+0, data_end as i64
    !bin_ptr
    !next_count
    !old_count
    !no_bin
    !has_bin
    !is_bin
    !first
    !within
    !data_end
    !data_start
    !align_ok
    !align_bits
    !chunk_type
    !type_offset
    !chunk_len
    !header_ok
    !remaining
    !done
    !offset
    jmp L_LOOP_HEAD

L_SKIP_CHUNK:
    old_count_skip = load view+SA3D_GLTF_GLB_VIEW_chunk_count as i32
    next_count_skip = add old_count_skip, 1
    store view+SA3D_GLTF_GLB_VIEW_chunk_count, next_count_skip as i32
    store offset_slot+0, data_end as i64
    !next_count_skip
    !old_count_skip
    !is_bin
    !first
    !within
    !data_end
    !data_start
    !align_ok
    !align_bits
    !chunk_type
    !type_offset
    !chunk_len
    !header_ok
    !remaining
    !done
    !offset
    jmp L_LOOP_HEAD

L_DONE:
    json_len = load view+SA3D_GLTF_GLB_VIEW_json_len as i64
    has_json = sgt json_len, 0
    br has_json -> L_OK, L_MISSING_JSON

L_OK:
    status_ok = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_OK)
    !has_json
    !json_len
    !done
    !offset
    !view
    !len
    !bytes
    return status_ok

L_BAD_HEADER_INIT:
    status_header = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_BAD_HEADER)
    !view
    !len
    !bytes
