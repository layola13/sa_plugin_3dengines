L_INDEX_RESOLVE_ERROR:
    index_mapped = call @sa3d_gltf_json_resolve_status_to_attr_status(index_resolve)
    !index_resolve_ok
    !index_resolve
    !index_offset
    !index_bv
    !index_format_ok
    !index_format
    !index_component
