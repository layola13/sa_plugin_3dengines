@sa3d_gltf_json_material_has_unlit_extension(bytes: ptr, len: i64, material_pos: i64) -> i32:
L_ENTRY:
    extensions_pos = call @sa3d_gltf_json_object_field_value(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_EXTENSIONS, 10)
    missing = eq extensions_pos, -1
    br missing -> L_FALSE, L_BAD_EXTENSIONS_CHECK

L_BAD_EXTENSIONS_CHECK:
    malformed = eq extensions_pos, -2
    br malformed -> L_BAD, L_UNLIT

L_UNLIT:
    unlit_pos = call @sa3d_gltf_json_object_field_value(bytes, len, extensions_pos, &SA3D_GLTF_JSON_KEY_KHR_MATERIALS_UNLIT, 19)
    unlit_missing = eq unlit_pos, -1
    br unlit_missing -> L_FALSE_UNLIT, L_BAD_UNLIT_CHECK

L_BAD_UNLIT_CHECK:
    unlit_malformed = eq unlit_pos, -2
    br unlit_malformed -> L_BAD_UNLIT, L_TRUE

L_TRUE:
    !unlit_malformed
    !unlit_missing
    !unlit_pos
    !malformed
    !missing
    !extensions_pos
    !material_pos
    !len
    !bytes
    return 1

L_FALSE_UNLIT:
    !unlit_missing
    !unlit_pos
    !malformed
    !missing
    !extensions_pos
    !material_pos
    !len
    !bytes
    return 0

L_FALSE:
    !missing
    !extensions_pos
    !material_pos
    !len
    !bytes
    return 0

L_BAD_UNLIT:
    !unlit_malformed
    !unlit_missing
    !unlit_pos
    !malformed
    !missing
    !extensions_pos
    !material_pos
    !len
    !bytes
    return -1

L_BAD:
    !malformed
    !missing
    !extensions_pos
    !material_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_is_value_delimiter_byte(b: u8) -> i32:
L_ENTRY:
    comma = eq b, 44
    obj = eq b, 125
    arr = eq b, 93
    space = eq b, 32
    tab = eq b, 9
    lf = eq b, 10
    cr = eq b, 13
    a0 = or comma, obj
    a1 = or arr, space
    a2 = or tab, lf
    a3 = or a0, a1
    a4 = or a2, cr
    ok = or a3, a4
    !a4
    !a3
    !a2
    !a1
    !a0
    !cr
    !lf
    !tab
    !space
    !arr
    !obj
    !comma
    !b
    return ok

@sa3d_gltf_json_parse_positive_f32_bits(bytes: ptr, len: i64, value_pos: i64, &out_bits: ptr) -> i32:
L_ENTRY:
    store out_bits+0, 0 as i32
    pos = call @sa3d_gltf_json_skip_ws_from(bytes, len, value_pos)
    in_bounds = slt pos, len
    br in_bounds -> L_INIT, L_BAD_BOUNDS

L_INIT:
    idx_slot = stack_alloc 8
    int_slot = stack_alloc 8
    frac_slot = stack_alloc 8
    denom_slot = stack_alloc 8
    int_digits_slot = stack_alloc 8
    frac_digits_slot = stack_alloc 8
    has_dot_slot = stack_alloc 4
    tmp_slot = stack_alloc 4
    store idx_slot+0, pos as i64
    store int_slot+0, 0 as i64
    store frac_slot+0, 0 as i64
    store denom_slot+0, 1 as i64
    store int_digits_slot+0, 0 as i64
    store frac_digits_slot+0, 0 as i64
    store has_dot_slot+0, 0 as i32
    jmp L_INT_HEAD

L_INT_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_VALIDATE_INT_EOF, L_INT_LOAD

L_VALIDATE_INT_EOF:
    !done
    !idx
    jmp L_VALIDATE

L_INT_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    ge = sge b, 48
    le = sle b, 57
    digit = and ge, le
    br digit -> L_INT_DIGIT, L_INT_NON_DIGIT

L_INT_DIGIT:
    current = load int_slot+0 as i64
    digits = load int_digits_slot+0 as i64
    b_i64 = zext b as i64
    raw = sub b_i64, 48
    times10 = mul current, 10
    next_value = add times10, raw
    next_digits = add digits, 1
    next_idx = add idx, 1
    store int_slot+0, next_value as i64
    store int_digits_slot+0, next_digits as i64
    store idx_slot+0, next_idx as i64
    !next_idx
    !next_digits
    !next_value
    !times10
    !raw
    !b_i64
    !digits
    !current
    !digit
    !le
    !ge
    !b
    !p
    !done
    !idx
    jmp L_INT_HEAD

L_INT_NON_DIGIT:
    is_dot = eq b, 46
    br is_dot -> L_DOT, L_DELIM_CHECK

L_DOT:
    next_dot_idx = add idx, 1
    store has_dot_slot+0, 1 as i32
    store idx_slot+0, next_dot_idx as i64
    !next_dot_idx
    !is_dot
    !digit
    !le
    !ge
    !b
    !p
    !done
    !idx
    jmp L_FRAC_HEAD

L_DELIM_CHECK:
    delim = call @sa3d_gltf_json_is_value_delimiter_byte(b)
    br delim -> L_VALIDATE_FROM_DELIM, L_BAD_CHAR

L_VALIDATE_FROM_DELIM:
    !delim
    !is_dot
    !digit
    !le
    !ge
    !b
    !p
    !done
    !idx
    jmp L_VALIDATE

L_FRAC_HEAD:
    fidx = load idx_slot+0 as i64
    fdone = sge fidx, len
    br fdone -> L_VALIDATE_FRAC_EOF, L_FRAC_LOAD

L_FRAC_LOAD:
    fp = ptr_add bytes, fidx
    fb = load fp+0 as u8
    fge = sge fb, 48
    fle = sle fb, 57
    fdigit = and fge, fle
    br fdigit -> L_FRAC_DIGIT, L_FRAC_DELIM_CHECK

L_FRAC_DIGIT:
    frac_current = load frac_slot+0 as i64
    frac_digits = load frac_digits_slot+0 as i64
    denom_current = load denom_slot+0 as i64
    fb_i64 = zext fb as i64
    fraw = sub fb_i64, 48
    frac_times10 = mul frac_current, 10
    frac_next = add frac_times10, fraw
    denom_next = mul denom_current, 10
    frac_digits_next = add frac_digits, 1
    fnext_idx = add fidx, 1
    store frac_slot+0, frac_next as i64
    store denom_slot+0, denom_next as i64
    store frac_digits_slot+0, frac_digits_next as i64
    store idx_slot+0, fnext_idx as i64
    !fnext_idx
    !frac_digits_next
    !denom_next
    !frac_next
    !frac_times10
    !fraw
    !fb_i64
    !denom_current
    !frac_digits
    !frac_current
    !fdigit
    !fle
    !fge
    !fb
    !fp
    !fdone
    !fidx
    jmp L_FRAC_HEAD

L_FRAC_DELIM_CHECK:
    fdelim = call @sa3d_gltf_json_is_value_delimiter_byte(fb)
    br fdelim -> L_VALIDATE_FROM_FRAC_DELIM, L_BAD_FRAC_CHAR

L_VALIDATE_FROM_FRAC_DELIM:
    !fdelim
    !fdigit
    !fle
    !fge
    !fb
    !fp
    !fdone
    !fidx
    jmp L_VALIDATE

L_VALIDATE_FRAC_EOF:
    !fdone
    !fidx
    jmp L_VALIDATE

L_VALIDATE:
    int_digits = load int_digits_slot+0 as i64
    has_int = sgt int_digits, 0
    br has_int -> L_VALIDATE_DOT, L_BAD_NO_INT

L_VALIDATE_DOT:
    has_dot = load has_dot_slot+0 as i32
    dot_bool = ne has_dot, 0
    br dot_bool -> L_VALIDATE_FRAC_COUNT, L_COMPUTE_NO_DOT

L_COMPUTE_NO_DOT:
    !dot_bool
    !has_dot
    jmp L_COMPUTE_COMMON

L_VALIDATE_FRAC_COUNT:
    frac_digits_count = load frac_digits_slot+0 as i64
    has_frac = sgt frac_digits_count, 0
    br has_frac -> L_COMPUTE_AFTER_FRAC, L_BAD_NO_FRAC

L_COMPUTE_AFTER_FRAC:
    !has_frac
    !frac_digits_count
    !dot_bool
    !has_dot
    jmp L_COMPUTE_COMMON

L_COMPUTE_COMMON:
    int_value = load int_slot+0 as i64
    frac_digits2 = load frac_digits_slot+0 as i64
    has_frac2 = sgt frac_digits2, 0
    br has_frac2 -> L_COMPUTE_FRAC, L_COMPUTE_INT

L_COMPUTE_FRAC:
    frac_value = load frac_slot+0 as i64
    denom_value = load denom_slot+0 as i64
    int_f64 = uitofp int_value as f64
    frac_f64_0 = uitofp frac_value as f64
    denom_f64 = uitofp denom_value as f64
    frac_f64 = fdiv frac_f64_0, denom_f64
    value_f64 = fadd int_f64, frac_f64
    value_f = value_f64 as f32
    store tmp_slot+0, value_f as f32
    bits = load tmp_slot+0 as i32
    store out_bits+0, bits as i32
    !bits
    !value_f
    !frac_f64
    !denom_f64
    !frac_f64_0
    !int_f64
    !denom_value
    !frac_value
    !has_frac2
    !frac_digits2
    !int_value
    !has_int
    !int_digits
    !in_bounds
    !pos
    !value_pos
    !out_bits
    !len
    !bytes
    return 1

L_COMPUTE_INT:
    int_f2 = uitofp int_value as f32
    store tmp_slot+0, int_f2 as f32
    bits2 = load tmp_slot+0 as i32
    store out_bits+0, bits2 as i32
    !bits2
    !int_f2
    !has_frac2
    !frac_digits2
    !int_value
    !has_int
    !int_digits
    !in_bounds
    !pos
    !value_pos
    !out_bits
    !len
    !bytes
    return 1

L_BAD_NO_FRAC:
    !has_frac
    !frac_digits_count
    !dot_bool
    !has_dot
    !has_int
    !int_digits
    !in_bounds
    !pos
