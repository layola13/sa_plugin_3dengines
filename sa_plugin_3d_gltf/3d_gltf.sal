    !len
    !bytes
    return -1

@sa3d_gltf_json_object_bool_or_default(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, default_value: i32) -> i32:
L_ENTRY:
    value_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, key, key_len)
    missing = eq value_pos, -1
    br missing -> L_DEFAULT, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq value_pos, -2
    br malformed -> L_BAD, L_CHECK_TRUE

L_CHECK_TRUE:
    true_ptr = ptr_add bytes, value_pos
    true_ok = call @sa3d_gltf_bytes_eq(true_ptr, &SA3D_GLTF_JSON_TEXT_TRUE, 4)
    br true_ok -> L_TRUE, L_CHECK_FALSE

L_TRUE:
    !true_ok
    !true_ptr
    !malformed
    !missing
    !value_pos
    !default_value
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 1

L_CHECK_FALSE:
    false_ptr = ptr_add bytes, value_pos
    false_ok = call @sa3d_gltf_bytes_eq(false_ptr, &SA3D_GLTF_JSON_TEXT_FALSE, 5)
    br false_ok -> L_FALSE, L_BAD_FALSE

L_FALSE:
    !false_ok
    !false_ptr
    !true_ok
    !true_ptr
    !malformed
    !missing
    !value_pos
    !default_value
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 0

L_DEFAULT:
    !missing
    !value_pos
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return default_value

L_BAD_FALSE:
    !false_ok
    !false_ptr
    !true_ok
    !true_ptr
    !malformed
    !missing
    !value_pos
    !default_value
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

L_BAD:
    !malformed
    !missing
    !value_pos
    !default_value
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_object_string_span(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out_ptr: ptr, &out_len: ptr) -> i32:
L_ENTRY:
    store out_ptr+0, 0 as i64
    store out_len+0, 0 as i64
    value_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, key, key_len)
    missing = eq value_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq value_pos, -2
    br malformed -> L_BAD, L_BOUNDS

L_BOUNDS:
    in_bounds = slt value_pos, len
    br in_bounds -> L_LOAD, L_BAD_BOUNDS

L_LOAD:
    p = ptr_add bytes, value_pos
    b = load p+0 as u8
    is_quote = eq b, 34
    br is_quote -> L_SKIP, L_BAD_NOT_STRING

L_SKIP:
    after = call @sa3d_gltf_json_skip_string(bytes, len, value_pos)
    bad_after = slt after, 0
    br bad_after -> L_BAD_SKIP, L_STORE

L_STORE:
    start = add value_pos, 1
    end = sub after, 1
    slen = sub end, start
    sptr = ptr_add bytes, start
    store out_ptr+0, sptr as ptr
    store out_len+0, slen as i64
    !sptr
    !slen
    !end
    !start
    !bad_after
    !after
    !is_quote
    !b
    !p
    !in_bounds
    !malformed
    !missing
    !value_pos
    !out_len
    !out_ptr
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 1

L_MISSING:
    !missing
    !value_pos
    !out_len
    !out_ptr
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 0

L_BAD_SKIP:
    !bad_after
    !after
    !is_quote
    !b
    !p
    !in_bounds
    !malformed
    !missing
    !value_pos
    !out_len
    !out_ptr
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

L_BAD_NOT_STRING:
    !is_quote
    !b
    !p
    !in_bounds
    !malformed
    !missing
    !value_pos
    !out_len
    !out_ptr
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

L_BAD_BOUNDS:
    !in_bounds
    !malformed
    !missing
    !value_pos
    !out_len
    !out_ptr
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

L_BAD:
    !malformed
    !missing
    !value_pos
    !out_len
    !out_ptr
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_skip_scalar_value(bytes: ptr, len: i64, value_pos: i64) -> i64:
L_ENTRY:
    idx_slot = stack_alloc 8
    start = call @sa3d_gltf_json_skip_ws_from(bytes, len, value_pos)
    store idx_slot+0, start as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_RETURN_EOF, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    comma = eq b, 44
    arr_close = eq b, 93
    obj_close = eq b, 125
    space = eq b, 32
    tab = eq b, 9
    lf = eq b, 10
    cr = eq b, 13
    c0 = or comma, arr_close
    c1 = or obj_close, space
    c2 = or tab, lf
    c3 = or c0, c1
    c4 = or c2, cr
    delim = or c3, c4
    br delim -> L_RETURN, L_NEXT

L_NEXT:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !delim
    !c4
    !c3
    !c2
    !c1
    !c0
    !cr
    !lf
    !tab
    !space
    !obj_close
    !arr_close
    !comma
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_RETURN:
    !delim
    !c4
    !c3
    !c2
    !c1
    !c0
    !cr
    !lf
    !tab
    !space
    !obj_close
    !arr_close
    !comma
    !b
    !p
    !done
    !start
    !value_pos
    !len
    !bytes
    return idx

L_RETURN_EOF:
    !done
    !idx
    !start
    !value_pos
    !bytes
    return len

@sa3d_gltf_json_skip_struct_value(bytes: ptr, len: i64, value_pos: i64) -> i64:
L_ENTRY:
    idx_slot = stack_alloc 8
    arr_depth_slot = stack_alloc 8
    obj_depth_slot = stack_alloc 8
    store idx_slot+0, value_pos as i64
    store arr_depth_slot+0, 0 as i64
    store obj_depth_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_BAD_EOF, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    is_quote = eq b, 34
    br is_quote -> L_STRING, L_STRUCTURAL

L_STRING:
    skipped = call @sa3d_gltf_json_skip_string(bytes, len, idx)
    bad_string = slt skipped, 0
    br bad_string -> L_BAD_STRING, L_STORE_STRING

L_STORE_STRING:
    store idx_slot+0, skipped as i64
    !bad_string
    !skipped
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_STRUCTURAL:
    arr_depth = load arr_depth_slot+0 as i64
    obj_depth = load obj_depth_slot+0 as i64
    is_arr_open = eq b, 91
    br is_arr_open -> L_ARR_OPEN, L_ARR_CLOSE_CHECK

L_ARR_OPEN:
    arr_next = add arr_depth, 1
    next_ao = add idx, 1
    store arr_depth_slot+0, arr_next as i64
    store idx_slot+0, next_ao as i64
    !next_ao
    !arr_next
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_ARR_CLOSE_CHECK:
    is_arr_close = eq b, 93
    br is_arr_close -> L_ARR_CLOSE, L_OBJ_OPEN_CHECK

L_ARR_CLOSE:
    arr_prev = sub arr_depth, 1
    next_ac = add idx, 1
    obj_zero = eq obj_depth, 0
    arr_zero = eq arr_prev, 0
    finished = and obj_zero, arr_zero
    br finished -> L_RETURN_CLOSE_ARRAY, L_STORE_ARR_CLOSE

L_STORE_ARR_CLOSE:
    store arr_depth_slot+0, arr_prev as i64
    store idx_slot+0, next_ac as i64
    !finished
    !arr_zero
    !obj_zero
    !next_ac
    !arr_prev
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_RETURN_CLOSE_ARRAY:
    !finished
    !arr_zero
    !obj_zero
    !arr_prev
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !value_pos
    !len
    !bytes
    return next_ac

L_OBJ_OPEN_CHECK:
    is_obj_open = eq b, 123
    br is_obj_open -> L_OBJ_OPEN, L_OBJ_CLOSE_CHECK

L_OBJ_OPEN:
    obj_next = add obj_depth, 1
    next_oo = add idx, 1
    store obj_depth_slot+0, obj_next as i64
    store idx_slot+0, next_oo as i64
    !next_oo
    !obj_next
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OBJ_CLOSE_CHECK:
    is_obj_close = eq b, 125
    br is_obj_close -> L_OBJ_CLOSE, L_OTHER

L_OBJ_CLOSE:
    obj_prev = sub obj_depth, 1
    next_oc = add idx, 1
    arr_zero2 = eq arr_depth, 0
    obj_zero2 = eq obj_prev, 0
    finished2 = and arr_zero2, obj_zero2
    br finished2 -> L_RETURN_CLOSE_OBJECT, L_STORE_OBJ_CLOSE

L_STORE_OBJ_CLOSE:
    store obj_depth_slot+0, obj_prev as i64
    store idx_slot+0, next_oc as i64
    !finished2
    !obj_zero2
    !arr_zero2
    !next_oc
    !obj_prev
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_RETURN_CLOSE_OBJECT:
    !finished2
    !obj_zero2
    !arr_zero2
    !obj_prev
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !value_pos
    !len
    !bytes
    return next_oc

L_OTHER:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_BAD_STRING:
    !bad_string
    !skipped
    !is_quote
    !b
    !p
    !done
    !idx
    !value_pos
    !len
    !bytes
    return -1

L_BAD_EOF:
    !done
    !idx
    !value_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_skip_value(bytes: ptr, len: i64, value_pos: i64) -> i64:
L_ENTRY:
    start = call @sa3d_gltf_json_skip_ws_from(bytes, len, value_pos)
    in_bounds = slt start, len
    br in_bounds -> L_LOAD, L_BAD_BOUNDS

L_LOAD:
    p = ptr_add bytes, start
    b = load p+0 as u8
    is_quote = eq b, 34
    br is_quote -> L_STRING, L_ARRAY_CHECK

L_STRING:
    end_string = call @sa3d_gltf_json_skip_string(bytes, len, start)
    !is_quote
    !b
    !p
    !in_bounds
    !start
    !value_pos
    !len
    !bytes
    return end_string

L_ARRAY_CHECK:
    is_array = eq b, 91
    br is_array -> L_STRUCT_ARRAY, L_OBJECT_CHECK

L_OBJECT_CHECK:
    is_object = eq b, 123
    br is_object -> L_STRUCT_OBJECT, L_SCALAR

L_STRUCT_ARRAY:
    end_struct_array = call @sa3d_gltf_json_skip_struct_value(bytes, len, start)
    !is_array
    !is_quote
    !b
    !p
    !in_bounds
    !start
    !value_pos
    !len
    !bytes
    return end_struct_array

L_STRUCT_OBJECT:
    end_struct_object = call @sa3d_gltf_json_skip_struct_value(bytes, len, start)
    !is_object
    !is_array
    !is_quote
    !b
    !p
    !in_bounds
    !start
    !value_pos
    !len
    !bytes
    return end_struct_object

L_SCALAR:
    end_scalar = call @sa3d_gltf_json_skip_scalar_value(bytes, len, start)
    !is_object
    !is_array
    !is_quote
    !b
    !p
    !in_bounds
    !start
    !value_pos
    !len
    !bytes
    return end_scalar

L_BAD_BOUNDS:
    !in_bounds
    !start
    !value_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_object_value_span(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out_ptr: ptr, &out_len: ptr) -> i32:
