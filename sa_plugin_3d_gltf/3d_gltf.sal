@sa3d_gltf_json_parse_f32_array3_bits(bytes: ptr, len: i64, value_pos: i64, &out0: ptr, &out1: ptr, &out2: ptr) -> i32:
L_ENTRY:
    start = call @sa3d_gltf_json_skip_ws_from(bytes, len, value_pos)
    in_bounds = slt start, len
    br in_bounds -> L_LOAD_OPEN, L_BAD_BOUNDS

L_LOAD_OPEN:
    open_ptr = ptr_add bytes, start
    open_byte = load open_ptr+0 as u8
    is_open = eq open_byte, 91
    br is_open -> L_PARSE0, L_BAD_OPEN

L_PARSE0:
    pos0_raw = add start, 1
    pos0 = call @sa3d_gltf_json_skip_ws_from(bytes, len, pos0_raw)
    st0 = call @sa3d_gltf_json_parse_positive_f32_bits(bytes, len, pos0, &out0)
    ok0 = ne st0, 0
    br ok0 -> L_COMMA0, L_BAD0

L_COMMA0:
    after0 = call @sa3d_gltf_json_expect_byte_after_number(bytes, len, pos0, 44)
    after0_ok = sge after0, 0
    br after0_ok -> L_PARSE1, L_BAD_COMMA0

L_PARSE1:
    pos1 = call @sa3d_gltf_json_skip_ws_from(bytes, len, after0)
    st1 = call @sa3d_gltf_json_parse_positive_f32_bits(bytes, len, pos1, &out1)
    ok1 = ne st1, 0
    br ok1 -> L_COMMA1, L_BAD1

L_COMMA1:
