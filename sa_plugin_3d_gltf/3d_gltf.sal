L_UNSUPPORTED_INDEX:
    !index_format_ok
    !index_format
    !index_component
    !empty
    !sparse_count
    !sparse_ok
    !sparse_status
    !output_element_size
    !dst
    !output_count
    !convert_coordinates
    !normalized
    !accessor_format
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_OK_EMPTY:
    !empty
    !sparse_count
    !sparse_ok
    !sparse_status
    !output_element_size
    !dst
    !output_count
    !convert_coordinates
    !normalized
    !accessor_format
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_UNSUPPORTED:
    !sparse_unsupported
    !sparse_ok
    !sparse_status
    !output_element_size
    !dst
    !output_count
    !convert_coordinates
    !normalized
    !accessor_format
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_PARSE:
    !sparse_unsupported
    !sparse_ok
    !sparse_status
    !output_element_size
    !dst
    !output_count
    !convert_coordinates
    !normalized
    !accessor_format
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

@sa3d_gltf_json_vertex_attribute_materialize(bytes: ptr, len: i64, accessor_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, conversion: i32, convert_coordinates: i32, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    accessor = stack_alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    store out_len+0, 0 as i64
    accessor_status = call @sa3d_gltf_json_accessor_parse(bytes, len, accessor_index, &accessor)
    accessor_ok = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_ok -> L_FORMAT, L_ACCESSOR_UNSUPPORTED_CHECK

L_ACCESSOR_UNSUPPORTED_CHECK:
    accessor_unsupported = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br accessor_unsupported -> L_UNSUPPORTED_ACCESSOR, L_MALFORMED_ACCESSOR

L_FORMAT:
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    normalized = load accessor+SA3D_GLTF_ACCESSOR_TABLE_normalized as i32
    output_element_size = call @sa3d_gltf_attribute_materialize_output_byte_size(conversion, accessor_format, normalized)
    supported = ne output_element_size, 0
    br supported -> L_SPARSE_CHECK, L_UNSUPPORTED_FORMAT

L_SPARSE_CHECK:
    sparse = call @sa3d_gltf_json_accessor_has_sparse(bytes, len, accessor_index)
    sparse_bad = slt sparse, 0
    br sparse_bad -> L_MALFORMED_SPARSE, L_COUNT

L_COUNT:
    accessor_count = load accessor+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    has_bv = load accessor+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view as i32
    has_bv_bool = ne has_bv, 0
    br has_bv_bool -> L_RESOLVE_BASE, L_ZERO_BASE

L_RESOLVE_BASE:
    bv_i32 = load accessor+SA3D_GLTF_ACCESSOR_TABLE_buffer_view as i32
    bv_index = zext bv_i32 as i64
    accessor_offset = load accessor+SA3D_GLTF_ACCESSOR_TABLE_byte_offset as i64
    resolve_status = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, bv_index, buffer_index, buffer_len, accessor_offset, accessor_count, accessor_format, &view, &layout)
    resolve_ok = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br resolve_ok -> L_MATERIALIZE_BASE, L_RESOLVE_ERROR

L_MATERIALIZE_BASE:
    status = call @sa3d_gltf_vertex_attribute_materialize(buffer, accessor_count, conversion, accessor_format, normalized, convert_coordinates, &layout, dst, cap, &out_len)
    status_ok = eq status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    br status_ok -> L_BASE_OK, L_RETURN_STATUS

L_BASE_OK:
    !status_ok
    !status
    !resolve_ok
    !resolve_status
    !accessor_offset
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    jmp L_APPLY_CHECK

L_ZERO_BASE:
    zero_status = call @sa3d_gltf_vertex_attribute_zero_materialize(accessor_count, conversion, accessor_format, normalized, convert_coordinates, dst, cap, &out_len)
    zero_ok = eq zero_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    br zero_ok -> L_ZERO_OK, L_RETURN_ZERO_STATUS

L_ZERO_OK:
    !zero_ok
    !zero_status
    !has_bv_bool
    !has_bv
    jmp L_APPLY_CHECK

L_APPLY_CHECK:
    sparse_present = sgt sparse, 0
    br sparse_present -> L_APPLY, L_OK

L_APPLY:
    patch_status = call @sa3d_gltf_json_vertex_attribute_apply_sparse(bytes, len, accessor_index, buffer_index, buffer, buffer_len, conversion, accessor_format, normalized, convert_coordinates, accessor_count, dst, output_element_size)
    patch_ok = eq patch_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    br patch_ok -> L_PATCH_OK, L_RETURN_PATCH_STATUS

L_PATCH_OK:
    !patch_ok
    !patch_status
    jmp L_OK

L_OK:
    !sparse_present
    !accessor_count
    !sparse_bad
    !sparse
    !supported
    !output_element_size
    !normalized
    !accessor_format
    !accessor_ok
    !accessor_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_RETURN_STATUS:
    !status_ok
    !resolve_ok
    !resolve_status
    !accessor_offset
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_count
    !sparse_bad
    !sparse
    !supported
    !output_element_size
    !normalized
    !accessor_format
    !accessor_ok
    !accessor_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return status

L_RETURN_ZERO_STATUS:
    !zero_ok
    !has_bv_bool
    !has_bv
    !accessor_count
    !sparse_bad
    !sparse
    !supported
    !output_element_size
    !normalized
    !accessor_format
    !accessor_ok
    !accessor_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return zero_status

L_RETURN_PATCH_STATUS:
    !patch_ok
    !sparse_present
    !accessor_count
    !sparse_bad
    !sparse
    !supported
    !output_element_size
    !normalized
    !accessor_format
    !accessor_ok
    !accessor_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return patch_status

L_RESOLVE_ERROR:
    mapped = call @sa3d_gltf_json_resolve_status_to_attr_status(resolve_status)
    !resolve_ok
    !resolve_status
    !accessor_offset
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_count
    !sparse_bad
    !sparse
    !supported
    !output_element_size
    !normalized
    !accessor_format
    !accessor_ok
    !accessor_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return mapped

L_MALFORMED_SPARSE:
    !sparse_bad
    !sparse
    !supported
    !output_element_size
    !normalized
    !accessor_format
    !accessor_ok
    !accessor_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

L_UNSUPPORTED_FORMAT:
    !supported
    !output_element_size
    !normalized
    !accessor_format
    !accessor_ok
    !accessor_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_UNSUPPORTED_ACCESSOR:
    !accessor_unsupported
    !accessor_ok
    !accessor_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_ACCESSOR:
    !accessor_unsupported
    !accessor_ok
    !accessor_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !conversion
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

@sa3d_gltf_store_snorm8_f32_component(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64) -> void:
L_ENTRY:
    out = ptr_add dst, dst_pos
    raw = call @sa3d_gltf_read_i8_as_i32(buffer, src_pos)
    f = sitofp raw
    n = fdiv f, 127.0
    below = fcmp_lt n, -1.0
    br below -> L_MIN, L_STORE

L_MIN:
    store out+0, -1.0 as f32
    !below
    !n
    !f
    !raw
    !out
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_STORE:
    store out+0, n as f32
    !below
    !n
    !f
    !raw
    !out
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_store_snorm16_f32_component(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64) -> void:
L_ENTRY:
    out = ptr_add dst, dst_pos
    raw = call @sa3d_gltf_read_i16_le_as_i32(buffer, src_pos)
    f = sitofp raw
    n = fdiv f, 32767.0
    below = fcmp_lt n, -1.0
    br below -> L_MIN, L_STORE

L_MIN:
    store out+0, -1.0 as f32
    !below
    !n
    !f
    !raw
    !out
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_STORE:
    store out+0, n as f32
    !below
    !n
    !f
    !raw
    !out
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_animation_output_component_count(path: i32, accessor_format: i32) -> i64:
L_ENTRY:
    translation = eq path, SA3D_GLTF_ANIMATION_PATH_TRANSLATION
    scale = eq path, SA3D_GLTF_ANIMATION_PATH_SCALE
    vec3_path = or translation, scale
    br vec3_path -> L_VEC3, L_ROTATION_CHECK

L_VEC3:
    f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    br f32x3 -> L_THREE, L_UNSUPPORTED_VEC3

L_THREE:
    !f32x3
    !vec3_path
    !scale
    !translation
    !accessor_format
    !path
    return 3

L_UNSUPPORTED_VEC3:
    !f32x3
    !vec3_path
    !scale
    !translation
    !accessor_format
    !path
    return 0

L_ROTATION_CHECK:
    rotation = eq path, SA3D_GLTF_ANIMATION_PATH_ROTATION
    br rotation -> L_ROTATION, L_WEIGHTS_CHECK

L_ROTATION:
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    s8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X4
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    s16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    a0 = or f32x4, s8x4
    a1 = or u8x4, s16x4
    a2 = or a0, a1
    ok = or a2, u16x4
    br ok -> L_FOUR, L_UNSUPPORTED_ROTATION

L_FOUR:
    !ok
    !a2
    !a1
    !a0
    !u16x4
    !s16x4
    !u8x4
    !s8x4
    !f32x4
    !rotation
    !vec3_path
    !scale
    !translation
    !accessor_format
    !path
    return 4

L_UNSUPPORTED_ROTATION:
    !ok
    !a2
    !a1
    !a0
    !u16x4
    !s16x4
    !u8x4
    !s8x4
    !f32x4
    !rotation
    !vec3_path
    !scale
    !translation
    !accessor_format
    !path
    return 0

L_WEIGHTS_CHECK:
    weights = eq path, SA3D_GLTF_ANIMATION_PATH_WEIGHTS
    br weights -> L_WEIGHTS, L_UNSUPPORTED_PATH

L_WEIGHTS:
    f32 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_SCALAR
    s8 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8_SCALAR
    u8 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8_SCALAR
    s16 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16_SCALAR
    u16 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16_SCALAR
    w0 = or f32, s8
    w1 = or u8, s16
    w2 = or w0, w1
    w_ok = or w2, u16
    br w_ok -> L_ONE, L_UNSUPPORTED_WEIGHTS

L_ONE:
    !w_ok
    !w2
    !w1
    !w0
    !u16
    !s16
    !u8
    !s8
    !f32
    !weights
    !rotation
    !vec3_path
    !scale
    !translation
    !accessor_format
    !path
    return 1

L_UNSUPPORTED_WEIGHTS:
    !w_ok
    !w2
    !w1
    !w0
    !u16
    !s16
    !u8
    !s8
    !f32
    !weights
    !rotation
    !vec3_path
    !scale
    !translation
    !accessor_format
    !path
    return 0

L_UNSUPPORTED_PATH:
    !weights
    !rotation
    !vec3_path
    !scale
    !translation
    !accessor_format
    !path
    return 0

@sa3d_gltf_animation_scalar_to_f32(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64, accessor_format: i32) -> void:
L_ENTRY:
    f32 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_SCALAR
    br f32 -> L_F32, L_S8_CHECK

L_F32:
    call @sa3d_gltf_store_f32_raw_component(buffer, src_pos, dst, dst_pos)
    !f32
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_S8_CHECK:
    s8 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8_SCALAR
    br s8 -> L_S8, L_U8_CHECK

L_S8:
    call @sa3d_gltf_store_snorm8_f32_component(buffer, src_pos, dst, dst_pos)
    !s8
    !f32
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_U8_CHECK:
    u8 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8_SCALAR
    br u8 -> L_U8, L_S16_CHECK

L_U8:
    call @sa3d_gltf_store_unorm8_f32_component(buffer, src_pos, dst, dst_pos)
    !u8
    !s8
    !f32
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_S16_CHECK:
    s16 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16_SCALAR
    br s16 -> L_S16, L_U16

L_S16:
    call @sa3d_gltf_store_snorm16_f32_component(buffer, src_pos, dst, dst_pos)
    !s16
    !u8
    !s8
    !f32
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_U16:
    call @sa3d_gltf_store_unorm16_f32_component(buffer, src_pos, dst, dst_pos)
    !s16
    !u8
    !s8
    !f32
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_animation_rotation_to_f32(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64, accessor_format: i32) -> void:
L_ENTRY:
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    br f32x4 -> L_F32X4, L_S8X4_CHECK

L_F32X4:
    call @sa3d_gltf_raw_attribute_copy_element(buffer, src_pos, dst, dst_pos, 16)
    !f32x4
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_S8X4_CHECK:
    s8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X4
    br s8x4 -> L_S8X4, L_U8X4_CHECK

L_S8X4:
    s81 = add src_pos, 1
    s82 = add src_pos, 2
    s83 = add src_pos, 3
    d81 = add dst_pos, 4
    d82 = add dst_pos, 8
    d83 = add dst_pos, 12
    call @sa3d_gltf_store_snorm8_f32_component(buffer, src_pos, dst, dst_pos)
    call @sa3d_gltf_store_snorm8_f32_component(buffer, s81, dst, d81)
    call @sa3d_gltf_store_snorm8_f32_component(buffer, s82, dst, d82)
    call @sa3d_gltf_store_snorm8_f32_component(buffer, s83, dst, d83)
    !d83
    !d82
    !d81
    !s83
    !s82
    !s81
    !s8x4
    !f32x4
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_U8X4_CHECK:
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    br u8x4 -> L_U8X4, L_S16X4_CHECK

L_U8X4:
    u81 = add src_pos, 1
    u82 = add src_pos, 2
    u83 = add src_pos, 3
    du81 = add dst_pos, 4
    du82 = add dst_pos, 8
    du83 = add dst_pos, 12
    call @sa3d_gltf_store_unorm8_f32_component(buffer, src_pos, dst, dst_pos)
    call @sa3d_gltf_store_unorm8_f32_component(buffer, u81, dst, du81)
    call @sa3d_gltf_store_unorm8_f32_component(buffer, u82, dst, du82)
    call @sa3d_gltf_store_unorm8_f32_component(buffer, u83, dst, du83)
    !du83
    !du82
    !du81
    !u83
    !u82
    !u81
    !u8x4
    !s8x4
    !f32x4
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_S16X4_CHECK:
    s16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X4
    br s16x4 -> L_S16X4, L_U16X4

L_S16X4:
    s161 = add src_pos, 2
    s162 = add src_pos, 4
    s163 = add src_pos, 6
    d161 = add dst_pos, 4
    d162 = add dst_pos, 8
    d163 = add dst_pos, 12
    call @sa3d_gltf_store_snorm16_f32_component(buffer, src_pos, dst, dst_pos)
    call @sa3d_gltf_store_snorm16_f32_component(buffer, s161, dst, d161)
    call @sa3d_gltf_store_snorm16_f32_component(buffer, s162, dst, d162)
    call @sa3d_gltf_store_snorm16_f32_component(buffer, s163, dst, d163)
    !d163
    !d162
    !d161
    !s163
    !s162
    !s161
    !s16x4
    !u8x4
    !s8x4
    !f32x4
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_U16X4:
    u161 = add src_pos, 2
    u162 = add src_pos, 4
    u163 = add src_pos, 6
    du161 = add dst_pos, 4
    du162 = add dst_pos, 8
    du163 = add dst_pos, 12
    call @sa3d_gltf_store_unorm16_f32_component(buffer, src_pos, dst, dst_pos)
    call @sa3d_gltf_store_unorm16_f32_component(buffer, u161, dst, du161)
    call @sa3d_gltf_store_unorm16_f32_component(buffer, u162, dst, du162)
    call @sa3d_gltf_store_unorm16_f32_component(buffer, u163, dst, du163)
    !du163
    !du162
    !du161
    !u163
    !u162
    !u161
    !s16x4
    !u8x4
    !s8x4
    !f32x4
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_animation_output_copy_element(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64, path: i32, accessor_format: i32) -> void:
L_ENTRY:
    rotation = eq path, SA3D_GLTF_ANIMATION_PATH_ROTATION
    br rotation -> L_ROTATION, L_WEIGHTS_CHECK

L_ROTATION:
    call @sa3d_gltf_animation_rotation_to_f32(buffer, src_pos, dst, dst_pos, accessor_format)
    !rotation
    !accessor_format
    !path
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_WEIGHTS_CHECK:
    weights = eq path, SA3D_GLTF_ANIMATION_PATH_WEIGHTS
    br weights -> L_WEIGHTS, L_VEC3

L_WEIGHTS:
    call @sa3d_gltf_animation_scalar_to_f32(buffer, src_pos, dst, dst_pos, accessor_format)
    !weights
    !rotation
    !accessor_format
    !path
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_VEC3:
    call @sa3d_gltf_raw_attribute_copy_element(buffer, src_pos, dst, dst_pos, 12)
    !weights
    !rotation
    !accessor_format
    !path
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_animation_input_materialize(buffer: ptr, accessor_count: i64, accessor_format: i32, &layout: ptr, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    format_ok = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_SCALAR
    br format_ok -> L_LAYOUT_CHECK, L_UNSUPPORTED

L_LAYOUT_CHECK:
    layout_status = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_status as i32
    layout_ok = eq layout_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    br layout_ok -> L_PTR_CHECK, L_MALFORMED_LAYOUT

L_PTR_CHECK:
    count_nonnegative = sge accessor_count, 0
    cap_nonnegative = sge cap, 0
    nonnegative = and count_nonnegative, cap_nonnegative
    buffer_present = ne buffer, 0
    dst_present = ne dst, 0
    ptrs = and buffer_present, dst_present
    ok0 = and nonnegative, ptrs
    br ok0 -> L_SIZE_CHECK, L_MALFORMED_PTR

L_SIZE_CHECK:
    element_size = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size as i64
    size_ok = eq element_size, 4
    br size_ok -> L_CAP_CHECK, L_MALFORMED_SIZE

L_CAP_CHECK:
    required = mul accessor_count, 4
    cap_ok = sge cap, required
    br cap_ok -> L_LOOP_INIT, L_OUTPUT_SMALL

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    byte_offset = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset as i64
    stride = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride as i64
    store idx_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, accessor_count
    br done -> L_DONE, L_LOOP_BODY

L_LOOP_BODY:
    src_step = mul idx, stride
    src_pos = add byte_offset, src_step
    dst_pos = mul idx, 4
    call @sa3d_gltf_store_f32_raw_component(buffer, src_pos, dst, dst_pos)
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !dst_pos
    !src_pos
    !src_step
    !done
    !idx
    jmp L_LOOP_HEAD

L_DONE:
    store out_len+0, required as i64
    !done
    !idx
    !stride
    !byte_offset
    !cap_ok
    !required
    !size_ok
    !element_size
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_UNSUPPORTED:
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_LAYOUT:
L_MALFORMED_PTR:
L_MALFORMED_SIZE:
    !out_len
    !cap
    !dst
    !layout
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_LAYOUT_ERROR

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !size_ok
    !element_size
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_OUTPUT_TOO_SMALL

@sa3d_gltf_animation_output_materialize(buffer: ptr, accessor_count: i64, path: i32, accessor_format: i32, &layout: ptr, dst: ptr, cap: i64, &out_len: ptr, &out_component_count: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    store out_component_count+0, 0 as i64
    component_count = call @sa3d_gltf_animation_output_component_count(path, accessor_format)
    supported = sgt component_count, 0
    br supported -> L_LAYOUT_CHECK, L_UNSUPPORTED

L_LAYOUT_CHECK:
    layout_status = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_status as i32
    layout_ok = eq layout_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    br layout_ok -> L_PTR_CHECK, L_MALFORMED_LAYOUT

L_PTR_CHECK:
    count_nonnegative = sge accessor_count, 0
    cap_nonnegative = sge cap, 0
    nonnegative = and count_nonnegative, cap_nonnegative
    buffer_present = ne buffer, 0
    dst_present = ne dst, 0
    ptrs = and buffer_present, dst_present
    ok0 = and nonnegative, ptrs
    br ok0 -> L_SIZE_CHECK, L_MALFORMED_PTR

L_SIZE_CHECK:
    element_size = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size as i64
    expected_size = call @sa3d_gltf_accessor_format_byte_size(accessor_format)
    size_ok = eq element_size, expected_size
    br size_ok -> L_CAP_CHECK, L_MALFORMED_SIZE

L_CAP_CHECK:
    output_element_size = mul component_count, 4
    required = mul accessor_count, output_element_size
    cap_ok = sge cap, required
    br cap_ok -> L_LOOP_INIT, L_OUTPUT_SMALL

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    byte_offset = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset as i64
    stride = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride as i64
    store idx_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, accessor_count
    br done -> L_DONE, L_LOOP_BODY

L_LOOP_BODY:
    src_step = mul idx, stride
    src_pos = add byte_offset, src_step
    dst_pos = mul idx, output_element_size
    call @sa3d_gltf_animation_output_copy_element(buffer, src_pos, dst, dst_pos, path, accessor_format)
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !dst_pos
    !src_pos
    !src_step
    !done
    !idx
    jmp L_LOOP_HEAD

L_DONE:
    store out_len+0, required as i64
    store out_component_count+0, component_count as i64
    !done
    !idx
    !stride
    !byte_offset
    !cap_ok
    !required
    !output_element_size
    !size_ok
    !expected_size
    !element_size
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !supported
    !component_count
    !out_component_count
    !out_len
    !cap
    !dst
    !layout
    !accessor_format
    !path
    !accessor_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_UNSUPPORTED:
    !supported
    !component_count
    !out_component_count
    !out_len
    !cap
    !dst
    !layout
    !accessor_format
    !path
    !accessor_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_LAYOUT:
L_MALFORMED_PTR:
L_MALFORMED_SIZE:
    !out_component_count
    !out_len
    !cap
    !dst
    !layout
    !accessor_format
    !path
    !accessor_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_LAYOUT_ERROR

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !output_element_size
    !size_ok
    !expected_size
    !element_size
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !supported
    !component_count
    !out_component_count
    !out_len
    !cap
    !dst
    !layout
    !accessor_format
    !path
    !accessor_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_OUTPUT_TOO_SMALL

@sa3d_gltf_sparse_index_accessor_format(component_type: i32) -> i32:
L_ENTRY:
    u8 = eq component_type, SA3D_GLTF_COMPONENT_U8
    br u8 -> L_U8, L_U16_CHECK

L_U8:
    !u8
    !component_type
    return SA3D_GLTF_ACCESSOR_U8_SCALAR

L_U16_CHECK:
    u16 = eq component_type, SA3D_GLTF_COMPONENT_U16
    br u16 -> L_U16, L_U32_CHECK

L_U16:
    !u16
    !u8
    !component_type
    return SA3D_GLTF_ACCESSOR_U16_SCALAR

L_U32_CHECK:
    u32 = eq component_type, SA3D_GLTF_COMPONENT_U32
    br u32 -> L_U32, L_UNSUPPORTED

L_U32:
    !u32
    !u16
    !u8
    !component_type
    return SA3D_GLTF_ACCESSOR_U32_SCALAR

L_UNSUPPORTED:
    !u32
    !u16
    !u8
    !component_type
    return 0

@sa3d_gltf_sparse_read_index(buffer: ptr, src_pos: i64, component_type: i32) -> i64:
L_ENTRY:
    u8 = eq component_type, SA3D_GLTF_COMPONENT_U8
    br u8 -> L_U8, L_U16_CHECK

L_U8:
    p8 = ptr_add buffer, src_pos
    v8 = load p8+0 as u8
    out8 = zext v8 as i64
    !v8
    !p8
    !u8
    !component_type
    !src_pos
    !buffer
    return out8

L_U16_CHECK:
    u16 = eq component_type, SA3D_GLTF_COMPONENT_U16
    br u16 -> L_U16, L_U32

L_U16:
    v16 = call @sa3d_gltf_read_u16_le(buffer, src_pos)
    !u16
    !u8
    !component_type
    !src_pos
    !buffer
    return v16

L_U32:
    v32 = call @sa3d_gltf_read_u32_le(buffer, src_pos)
    !u16
    !u8
    !component_type
    !src_pos
    !buffer
    return v32

@sa3d_gltf_animation_output_zero_materialize(accessor_count: i64, path: i32, accessor_format: i32, dst: ptr, cap: i64, &out_len: ptr, &out_component_count: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    store out_component_count+0, 0 as i64
    component_count = call @sa3d_gltf_animation_output_component_count(path, accessor_format)
    supported = sgt component_count, 0
    br supported -> L_PTR_CHECK, L_UNSUPPORTED

L_PTR_CHECK:
    count_nonnegative = sge accessor_count, 0
    cap_nonnegative = sge cap, 0
    nonnegative = and count_nonnegative, cap_nonnegative
    dst_present = ne dst, 0
    ok0 = and nonnegative, dst_present
    br ok0 -> L_CAP_CHECK, L_LAYOUT_ERROR

L_CAP_CHECK:
    element_size = mul component_count, 4
    required = mul accessor_count, element_size
    cap_ok = sge cap, required
    br cap_ok -> L_LOOP_INIT, L_OUTPUT_SMALL

L_LOOP_INIT:
    byte_slot = stack_alloc 8
    store byte_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    byte_idx = load byte_slot+0 as i64
    done = sge byte_idx, required
    br done -> L_DONE, L_BODY

L_BODY:
    p = ptr_add dst, byte_idx
    store p+0, 0.0 as f32
    next = add byte_idx, 4
    store byte_slot+0, next as i64
    !next
    !p
    !done
    !byte_idx
    jmp L_LOOP_HEAD

L_DONE:
    store out_len+0, required as i64
    store out_component_count+0, component_count as i64
    !done
    !byte_idx
    !cap_ok
    !required
    !element_size
    !ok0
    !dst_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !supported
    !component_count
    !out_component_count
    !out_len
    !cap
    !dst
    !accessor_format
    !path
    !accessor_count
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_UNSUPPORTED:
    !supported
    !component_count
    !out_component_count
    !out_len
    !cap
    !dst
    !accessor_format
    !path
    !accessor_count
    return SA3D_GLTF_ANIMATION_READ_STATUS_UNSUPPORTED_FORMAT

L_LAYOUT_ERROR:
    !ok0
    !dst_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !supported
    !component_count
    !out_component_count
    !out_len
    !cap
    !dst
    !accessor_format
    !path
    !accessor_count
    return SA3D_GLTF_ANIMATION_READ_STATUS_LAYOUT_ERROR

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !element_size
    !ok0
    !dst_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !supported
    !component_count
    !out_component_count
    !out_len
    !cap
    !dst
    !accessor_format
    !path
    !accessor_count
    return SA3D_GLTF_ANIMATION_READ_STATUS_OUTPUT_TOO_SMALL

@sa3d_gltf_json_resolve_buffer_view_layout(bytes: ptr, len: i64, buffer_view_index: i64, buffer_index: i64, buffer_len: i64, byte_offset: i64, accessor_count: i64, accessor_format: i32, &view: ptr, &layout: ptr) -> i32:
L_ENTRY:
    buffer_table = stack_alloc SA3D_GLTF_BUFFER_TABLE_SIZE
    view_status = call @sa3d_gltf_json_buffer_view_parse(bytes, len, buffer_view_index, &view)
    view_ok = eq view_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br view_ok -> L_BUFFER_MATCH, L_JSON_ERROR_VIEW

L_BUFFER_MATCH:
    view_buffer = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer as i64
    same_buffer = eq view_buffer, buffer_index
    br same_buffer -> L_PARSE_BUFFER, L_BUFFER_MISMATCH

L_PARSE_BUFFER:
    buffer_status = call @sa3d_gltf_json_buffer_parse(bytes, len, view_buffer, &buffer_table)
    buffer_ok = eq buffer_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br buffer_ok -> L_BUFFER_LENGTH, L_JSON_ERROR_BUFFER

L_BUFFER_LENGTH:
    declared_len = load buffer_table+SA3D_GLTF_BUFFER_TABLE_byte_len as i64
    len_ok = sge buffer_len, declared_len
    br len_ok -> L_VALIDATE, L_LAYOUT_ERROR_BUFFER_LENGTH

L_VALIDATE:
    view_offset = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset as i64
    view_len = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len as i64
    view_stride = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride as i64
    layout_status = call @sa3d_gltf_accessor_layout_validate(buffer_len, view_offset, view_len, view_stride, byte_offset, accessor_count, accessor_format, &layout)
    layout_ok = eq layout_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    br layout_ok -> L_OK, L_LAYOUT_ERROR

L_OK:
    !layout_ok
    !layout_status
    !view_stride
    !view_len
    !view_offset
    !len_ok
    !declared_len
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !layout
    !view
    !accessor_format
    !accessor_count
    !byte_offset
    !buffer_len
    !buffer_index
    !buffer_view_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_OK

L_LAYOUT_ERROR:
    !layout_ok
    !layout_status
    !view_stride
    !view_len
    !view_offset
    !len_ok
    !declared_len
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !layout
    !view
    !accessor_format
    !accessor_count
    !byte_offset
    !buffer_len
    !buffer_index
    !buffer_view_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_LAYOUT_ERROR

L_LAYOUT_ERROR_BUFFER_LENGTH:
    !len_ok
    !declared_len
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !layout
    !view
    !accessor_format
    !accessor_count
    !byte_offset
    !buffer_len
    !buffer_index
    !buffer_view_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_LAYOUT_ERROR

L_JSON_ERROR_BUFFER:
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !layout
    !view
    !accessor_format
    !accessor_count
    !byte_offset
    !buffer_len
    !buffer_index
    !buffer_view_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_JSON_ERROR

L_BUFFER_MISMATCH:
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !layout
    !view
    !accessor_format
    !accessor_count
    !byte_offset
    !buffer_len
    !buffer_index
    !buffer_view_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_BUFFER_MISMATCH

L_JSON_ERROR_VIEW:
