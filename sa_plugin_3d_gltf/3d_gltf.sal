    index_bv = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_buffer_view as i64
    index_offset = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_byte_offset as i64
    index_resolve = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, index_bv, buffer_index, buffer_len, index_offset, sparse_count, index_format, &index_view, &index_layout)
    index_resolve_ok = eq index_resolve, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br index_resolve_ok -> L_VALUE_LAYOUT, L_INDEX_RESOLVE_ERROR

L_VALUE_LAYOUT:
