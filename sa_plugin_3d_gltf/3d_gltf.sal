L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_STORE

L_STORE:
    r = load r_slot+0 as i32
    g = load g_slot+0 as i32
    b = load b_slot+0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_specular_tint_r, r as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_specular_tint_g, g as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_specular_tint_b, b as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_specular_color_factor, 1 as i32
    !b
    !g
    !r
    !bad
    !missing
    !status
    !out
    !specular_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !out
    !specular_pos
