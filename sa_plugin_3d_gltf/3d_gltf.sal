@sa3d_gltf_json_mesh_morph_target_name_count(bytes: ptr, len: i64, mesh_index: i64) -> i64:
L_ENTRY:
    names_pos = call @sa3d_gltf_json_mesh_morph_target_names_array_pos(bytes, len, mesh_index)
    malformed = eq names_pos, -2
    br malformed -> L_BAD, L_MISSING_CHECK

L_MISSING_CHECK:
    missing = eq names_pos, -1
    br missing -> L_ZERO, L_COUNT

L_COUNT:
    count = call @sa3d_gltf_json_count_array_items(bytes, len, names_pos)
    count_bad = slt count, 0
    br count_bad -> L_BAD_COUNT, L_RETURN_COUNT

L_RETURN_COUNT:
    !count_bad
