    !sparse_ok
    !sparse_status
    !raw_component_count
    !dst
    !output_count
    !accessor_format
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_JSON_ERROR

@sa3d_gltf_json_animation_channel_materialize(bytes: ptr, len: i64, animation_index: i64, channel_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, input_dst: ptr, input_cap: i64, output_dst: ptr, output_cap: i64, &out: ptr) -> i32:
L_ENTRY:
    channel = stack_alloc SA3D_GLTF_ANIMATION_CHANNEL_TABLE_SIZE
    sampler = stack_alloc SA3D_GLTF_ANIMATION_SAMPLER_TABLE_SIZE
    input_len = stack_alloc 8
    output_len = stack_alloc 8
    keyframe_count_slot = stack_alloc 8
    component_count = stack_alloc 8
    call @sa3d_gltf_animation_channel_data_clear(&out)
    parse_status = call @sa3d_gltf_json_animation_channel_sampler_read(bytes, len, animation_index, channel_index, &channel, &sampler)
    parse_ok = eq parse_status, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    br parse_ok -> L_INPUT, L_FAIL_PARSE

L_INPUT:
    input_accessor = load sampler+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_input as i64
    input_status = call @sa3d_gltf_json_animation_input_read(bytes, len, input_accessor, buffer_index, buffer, buffer_len, input_dst, input_cap, &input_len, &keyframe_count_slot)
    input_ok = eq input_status, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    br input_ok -> L_OUTPUT, L_FAIL_INPUT

L_OUTPUT:
    output_accessor = load sampler+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_output as i64
    path = load channel+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_path as i32
    interpolation = load sampler+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_interpolation as i32
    keyframe_count = load keyframe_count_slot+0 as i64
    output_status = call @sa3d_gltf_json_animation_output_read(bytes, len, output_accessor, buffer_index, buffer, buffer_len, path, interpolation, keyframe_count, output_dst, output_cap, &output_len, &component_count)
    output_ok = eq output_status, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    br output_ok -> L_STORE_OK, L_FAIL_OUTPUT

L_STORE_OK:
    target_node = load channel+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_node as i64
    curve_kind = call @sa3d_gltf_animation_curve_kind(keyframe_count, interpolation)
    input_len_value = load input_len+0 as i64
    output_len_value = load output_len+0 as i64
    component_value = load component_count+0 as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_status, SA3D_GLTF_ANIMATION_READ_STATUS_OK as i32
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_target_node, target_node as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_target_path, path as i32
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_interpolation, interpolation as i32
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_curve_kind, curve_kind as i32
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_keyframe_count, keyframe_count as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_output_component_count, component_value as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_input_len, input_len_value as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_output_len, output_len_value as i64
    !component_value
    !output_len_value
    !input_len_value
    !curve_kind
    !target_node
    !output_ok
    !output_status
    !keyframe_count
    !interpolation
    !path
    !output_accessor
    !input_ok
    !input_status
    !input_accessor
    !parse_ok
    !parse_status
    !out
    !output_cap
    !output_dst
    !input_cap
    !input_dst
    !buffer_len
    !buffer
    !buffer_index
    !channel_index
    !animation_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_FAIL_OUTPUT:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_status, output_status as i32
    !output_ok
    !keyframe_count
    !interpolation
    !path
    !output_accessor
    !input_ok
    !input_status
    !input_accessor
    !parse_ok
    !parse_status
    !out
    !output_cap
    !output_dst
    !input_cap
    !input_dst
    !buffer_len
    !buffer
    !buffer_index
    !channel_index
    !animation_index
    !len
    !bytes
    return output_status

L_FAIL_INPUT:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_status, input_status as i32
    !input_ok
    !input_accessor
    !parse_ok
    !parse_status
    !out
    !output_cap
    !output_dst
    !input_cap
    !input_dst
    !buffer_len
    !buffer
    !buffer_index
    !channel_index
    !animation_index
    !len
    !bytes
    return input_status

L_FAIL_PARSE:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_status, parse_status as i32
    !parse_ok
    !out
    !output_cap
    !output_dst
    !input_cap
    !input_dst
    !buffer_len
    !buffer
    !buffer_index
    !channel_index
    !animation_index
    !len
    !bytes
    return parse_status

@sa3d_gltf_accessor_format_supported(accessor_format: i32) -> i32:
L_ENTRY:
    low = sge accessor_format, SA3D_GLTF_ACCESSOR_F32_SCALAR
    high = sle accessor_format, SA3D_GLTF_ACCESSOR_S16_SCALAR
    ok = and low, high
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !high
    !low
    !accessor_format
    return 1

L_FALSE:
    !ok
    !high
    !low
    !accessor_format
    return 0

@sa3d_gltf_accessor_any_supported(accessor_format: i32, normalized: i32) -> i32:
L_ENTRY:
    mat4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_MAT4
    br mat4 -> L_MAT4, L_NATIVE

L_MAT4:
    !mat4
    !normalized
    !accessor_format
    return 1

L_NATIVE:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    f32 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_SCALAR
    u32 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32_SCALAR
    f32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X2
    u32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X2
    f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    u32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X3
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    u32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X4
    a0 = or f32, u32
    a1 = or f32x2, u32x2
    a2 = or f32x3, u32x3
    a3 = or f32x4, u32x4
    a01 = or a0, a1
    a23 = or a2, a3
    native = or a01, a23
    native_ok = and native, not_norm
    s16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X2
    u16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X2
    s16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    s8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X2
    u8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X2
    s8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X4
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    b0 = or s16x2, u16x2
    b1 = or s16x4, u16x4
    b2 = or s8x2, u8x2
    b3 = or s8x4, u8x4
    b01 = or b0, b1
    b23 = or b2, b3
    normable = or b01, b23
    ok = or native_ok, normable
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !normable
    !b23
    !b01
    !b3
    !b2
    !b1
    !b0
    !u8x4
    !s8x4
    !u8x2
    !s8x2
    !u16x4
    !s16x4
    !u16x2
    !s16x2
    !native_ok
    !native
    !a23
    !a01
    !a3
    !a2
    !a1
    !a0
    !u32x4
    !f32x4
    !u32x3
    !f32x3
    !u32x2
    !f32x2
    !u32
    !f32
    !not_norm
    !norm
    !mat4
    !normalized
    !accessor_format
    return 1

L_FALSE:
    !ok
    !normable
    !b23
    !b01
    !b3
    !b2
    !b1
    !b0
    !u8x4
    !s8x4
    !u8x2
    !s8x2
    !u16x4
    !s16x4
    !u16x2
    !s16x2
    !native_ok
    !native
    !a23
    !a01
    !a3
    !a2
    !a1
    !a0
    !u32x4
    !f32x4
    !u32x3
    !f32x3
    !u32x2
    !f32x2
    !u32
    !f32
    !not_norm
    !norm
    !mat4
    !normalized
    !accessor_format
    return 0

@sa3d_gltf_accessor_conversion_supported(conversion: i32, accessor_format: i32, normalized: i32) -> i32:
L_ENTRY:
    is_any = eq conversion, SA3D_GLTF_CONVERSION_ANY
    br is_any -> L_ANY, L_RGBA_CHECK

L_ANY:
    out_any = call @sa3d_gltf_accessor_any_supported(accessor_format, normalized)
    !is_any
    !conversion
    !accessor_format
    !normalized
    return out_any

L_RGBA_CHECK:
    is_rgba = eq conversion, SA3D_GLTF_CONVERSION_RGBA
    br is_rgba -> L_RGBA, L_TEX_CHECK

L_RGBA:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    f32_ok0 = or f32x3, f32x4
    f32_ok = and f32_ok0, not_norm
    u8x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X3
    u16x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X3
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    n0 = or u8x3, u16x3
    n1 = or u8x4, u16x4
    normalized_color = or n0, n1
    normalized_ok = and normalized_color, norm
    rgba_ok = or f32_ok, normalized_ok
    br rgba_ok -> L_RGBA_TRUE, L_RGBA_FALSE

L_RGBA_TRUE:
    !rgba_ok
    !normalized_ok
    !normalized_color
    !n1
    !n0
    !u16x4
    !u8x4
    !u16x3
    !u8x3
    !f32_ok
    !f32_ok0
    !f32x4
    !f32x3
    !not_norm
    !norm
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 1

L_RGBA_FALSE:
    !rgba_ok
    !normalized_ok
    !normalized_color
    !n1
    !n0
    !u16x4
    !u8x4
    !u16x3
    !u8x3
    !f32_ok
    !f32_ok0
    !f32x4
    !f32x3
    !not_norm
    !norm
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 0

L_TEX_CHECK:
    is_tex = eq conversion, SA3D_GLTF_CONVERSION_TEX_COORD
    br is_tex -> L_TEX, L_JOINT_INDEX_CHECK

L_TEX:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    f32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X2
    f32_ok = and f32x2, not_norm
    u8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X2
    u16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X2
    normalized_tex = or u8x2, u16x2
    normalized_ok = and normalized_tex, norm
    tex_ok = or f32_ok, normalized_ok
    br tex_ok -> L_TEX_TRUE, L_TEX_FALSE

L_TEX_TRUE:
    !tex_ok
    !normalized_ok
    !normalized_tex
    !u16x2
    !u8x2
    !f32_ok
    !f32x2
    !not_norm
    !norm
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 1

L_TEX_FALSE:
    !tex_ok
    !normalized_ok
    !normalized_tex
    !u16x2
    !u8x2
    !f32_ok
    !f32x2
    !not_norm
    !norm
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 0

L_JOINT_INDEX_CHECK:
    is_joint_index = eq conversion, SA3D_GLTF_CONVERSION_JOINT_INDEX
    br is_joint_index -> L_JOINT_INDEX, L_JOINT_WEIGHT_CHECK

L_JOINT_INDEX:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    idx0 = or u8x4, u16x4
    idx_ok = and idx0, not_norm
    br idx_ok -> L_IDX_TRUE, L_IDX_FALSE

L_IDX_TRUE:
    !idx_ok
    !idx0
    !u16x4
    !u8x4
    !not_norm
    !norm
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 1

L_IDX_FALSE:
    !idx_ok
    !idx0
    !u16x4
    !u8x4
    !not_norm
    !norm
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 0

L_JOINT_WEIGHT_CHECK:
    is_joint_weight = eq conversion, SA3D_GLTF_CONVERSION_JOINT_WEIGHT
    br is_joint_weight -> L_JOINT_WEIGHT, L_UNKNOWN

L_JOINT_WEIGHT:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    f32_ok = and f32x4, not_norm
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    w0 = or u8x4, u16x4
    normalized_ok = and w0, norm
    weight_ok = or f32_ok, normalized_ok
    br weight_ok -> L_WEIGHT_TRUE, L_WEIGHT_FALSE

L_WEIGHT_TRUE:
    !weight_ok
    !normalized_ok
    !w0
    !u16x4
    !u8x4
    !f32_ok
    !f32x4
    !not_norm
    !norm
    !is_joint_weight
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
