    out = ptr_add dst, dst_pos
    raw = load src+0 as u8
    wide = zext raw as i32
    store out+0, wide as u16
    !wide
    !raw
    !out
    !src
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_attribute_materialize_output_byte_size(conversion: i32, accessor_format: i32, normalized: i32) -> i64:
L_ENTRY:
    supported_raw = call @sa3d_gltf_accessor_conversion_supported(conversion, accessor_format, normalized)
    supported = ne supported_raw, 0
    br supported -> L_KIND, L_ZERO

L_KIND:
    is_any = eq conversion, SA3D_GLTF_CONVERSION_ANY
    br is_any -> L_ANY, L_RGBA_CHECK

L_ANY:
    out_any = call @sa3d_gltf_accessor_format_byte_size(accessor_format)
    !is_any
    !supported
    !supported_raw
    !normalized
    !accessor_format
    !conversion
    return out_any

L_RGBA_CHECK:
    is_rgba = eq conversion, SA3D_GLTF_CONVERSION_RGBA
    br is_rgba -> L_RGBA, L_TEX_CHECK

L_RGBA:
