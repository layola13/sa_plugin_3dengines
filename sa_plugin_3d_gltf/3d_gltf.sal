@sa3d_gltf_scene_name_to_bytes(scene_index: i64, name_ptr: ptr, name_len: i64, &dst: ptr, cap: i64) -> i64:
L_ENTRY:
    has_ptr = ne name_ptr, 0
    len_ok = sge name_len, 0
    has_name = and has_ptr, len_ok
    br has_name -> L_COPY_NAME, L_FALLBACK

L_COPY_NAME:
    out_name = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &name_ptr, name_len)
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !scene_index
    return out_name

L_FALLBACK:
    out_fallback = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_SCENE, 5, scene_index)
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !scene_index
    return out_fallback

@sa3d_gltf_json_scene_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_SCENE_TABLE_index, 0 as i64
    store out+SA3D_GLTF_SCENE_TABLE_name_ptr, 0 as i64
    store out+SA3D_GLTF_SCENE_TABLE_name_len, 0 as i64
    store out+SA3D_GLTF_SCENE_TABLE_root_count, 0 as i64
    store out+SA3D_GLTF_SCENE_TABLE_roots_array_pos, -1 as i64
    store out+SA3D_GLTF_SCENE_TABLE_first_root, -1 as i64
    store out+SA3D_GLTF_SCENE_TABLE_has_extras, 0 as i32
    store out+SA3D_GLTF_SCENE_TABLE_extras_ptr, 0 as i64
    store out+SA3D_GLTF_SCENE_TABLE_extras_len, 0 as i64
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_scene_root_at_table(bytes: ptr, len: i64, &scene: ptr, root_index: i64) -> i64:
L_ENTRY:
    negative = slt root_index, 0
    br negative -> L_MISSING_NEGATIVE, L_RANGE

L_RANGE:
    count = load scene+SA3D_GLTF_SCENE_TABLE_root_count as i64
    in_range = slt root_index, count
    br in_range -> L_POS, L_MISSING_RANGE

L_POS:
    roots_pos = load scene+SA3D_GLTF_SCENE_TABLE_roots_array_pos as i64
    value_pos = call @sa3d_gltf_json_array_item_start(bytes, len, roots_pos, root_index)
    value_bad = slt value_pos, 0
    br value_bad -> L_BAD_VALUE_POS, L_PARSE

L_PARSE:
    root = call @sa3d_gltf_json_parse_positive_i64(bytes, len, value_pos)
    root_bad = slt root, 0
    br root_bad -> L_BAD_ROOT, L_OK

L_OK:
    !root_bad
    !value_bad
    !value_pos
    !roots_pos
    !in_range
    !count
    !negative
    !root_index
    !scene
    !len
    !bytes
    return root

L_BAD_ROOT:
    !root_bad
    !root
    !value_bad
    !value_pos
    !roots_pos
    !in_range
    !count
    !negative
    !root_index
    !scene
    !len
    !bytes
    return -2

L_BAD_VALUE_POS:
    !value_bad
    !value_pos
    !roots_pos
    !in_range
    !count
    !negative
    !root_index
    !scene
    !len
    !bytes
    return -2

L_MISSING_RANGE:
    !in_range
    !count
    !negative
    !root_index
    !scene
    !len
    !bytes
    return -1

L_MISSING_NEGATIVE:
    !negative
    !root_index
    !scene
    !len
    !bytes
    return -1

@sa3d_gltf_json_scene_parse(bytes: ptr, len: i64, scene_index: i64, &out: ptr) -> i32:
L_ENTRY:
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    extras_ptr_slot = stack_alloc 8
    extras_len_slot = stack_alloc 8
    call @sa3d_gltf_json_scene_table_clear(&out)
    store out+SA3D_GLTF_SCENE_TABLE_index, scene_index as i64
    scene_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_SCENES, 6, scene_index)
    missing = eq scene_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq scene_pos, -2
    br malformed -> L_MALFORMED, L_NAME

L_NAME:
    name_status = call @sa3d_gltf_json_object_string_span(bytes, len, scene_pos, &SA3D_GLTF_JSON_KEY_NAME, 4, &name_ptr_slot, &name_len_slot)
    name_bad = slt name_status, 0
    br name_bad -> L_BAD_NAME, L_NAME_STORE_CHECK

L_NAME_STORE_CHECK:
    name_found = eq name_status, 1
    br name_found -> L_NAME_STORE, L_NAME_SKIP

L_NAME_STORE:
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as i64
    store out+SA3D_GLTF_SCENE_TABLE_name_ptr, name_ptr as ptr
    store out+SA3D_GLTF_SCENE_TABLE_name_len, name_len as i64
    !name_len
    !name_ptr
    !name_found
    jmp L_ROOTS

L_NAME_SKIP:
    !name_found
    jmp L_ROOTS

L_ROOTS:
    roots_pos = call @sa3d_gltf_json_object_field_value(bytes, len, scene_pos, &SA3D_GLTF_JSON_KEY_NODES, 5)
    roots_missing = eq roots_pos, -1
    br roots_missing -> L_EXTRAS, L_ROOTS_MALFORMED_CHECK

L_ROOTS_MALFORMED_CHECK:
    roots_malformed = eq roots_pos, -2
    br roots_malformed -> L_BAD_ROOTS, L_ROOT_COUNT

L_ROOT_COUNT:
    root_count = call @sa3d_gltf_json_count_array_items(bytes, len, roots_pos)
    root_count_bad = slt root_count, 0
    br root_count_bad -> L_BAD_ROOT_COUNT, L_ROOTS_STORE

L_ROOTS_STORE:
    store out+SA3D_GLTF_SCENE_TABLE_root_count, root_count as i64
    store out+SA3D_GLTF_SCENE_TABLE_roots_array_pos, roots_pos as i64
    has_root = sgt root_count, 0
    br has_root -> L_FIRST_ROOT_POS, L_EXTRAS

L_FIRST_ROOT_POS:
    first_pos = call @sa3d_gltf_json_array_item_start(bytes, len, roots_pos, 0)
    first_bad = slt first_pos, 0
    br first_bad -> L_BAD_FIRST_POS, L_FIRST_ROOT_VALUE

L_FIRST_ROOT_VALUE:
    first_root = call @sa3d_gltf_json_parse_positive_i64(bytes, len, first_pos)
    first_value_bad = slt first_root, 0
    br first_value_bad -> L_BAD_FIRST_VALUE, L_STORE_FIRST

L_STORE_FIRST:
    store out+SA3D_GLTF_SCENE_TABLE_first_root, first_root as i64
    !first_value_bad
    !first_root
    !first_bad
    !first_pos
    !has_root
    jmp L_EXTRAS

L_EXTRAS:
    extras_status = call @sa3d_gltf_json_object_value_span(bytes, len, scene_pos, &SA3D_GLTF_JSON_KEY_EXTRAS, 6, &extras_ptr_slot, &extras_len_slot)
    extras_bad = slt extras_status, 0
    br extras_bad -> L_BAD_EXTRAS, L_EXTRAS_STORE_CHECK

L_EXTRAS_STORE_CHECK:
    extras_found = eq extras_status, 1
    br extras_found -> L_EXTRAS_STORE, L_EXTRAS_SKIP

L_EXTRAS_STORE:
    extras_ptr = load extras_ptr_slot+0 as ptr
    extras_len = load extras_len_slot+0 as i64
    store out+SA3D_GLTF_SCENE_TABLE_has_extras, 1 as i32
    store out+SA3D_GLTF_SCENE_TABLE_extras_ptr, extras_ptr as ptr
    store out+SA3D_GLTF_SCENE_TABLE_extras_len, extras_len as i64
    !extras_len
    !extras_ptr
    !extras_found
    jmp L_OK

L_EXTRAS_SKIP:
    !extras_found
    jmp L_OK

L_OK:
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !extras_bad
    !extras_status
    !roots_missing
    !roots_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !scene_pos
    !out
    !scene_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_EXTRAS:
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !extras_bad
    !extras_status
    !roots_missing
    !roots_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !scene_pos
    !out
    !scene_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_FIRST_VALUE:
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !first_value_bad
    !first_root
    !first_bad
    !first_pos
    !has_root
    !root_count_bad
    !root_count
    !roots_malformed
    !roots_missing
    !roots_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !scene_pos
    !out
    !scene_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_FIRST_POS:
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !first_bad
    !first_pos
    !has_root
    !root_count_bad
    !root_count
    !roots_malformed
    !roots_missing
    !roots_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !scene_pos
    !out
    !scene_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_ROOT_COUNT:
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !root_count_bad
    !root_count
    !roots_malformed
    !roots_missing
    !roots_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !scene_pos
    !out
    !scene_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_ROOTS:
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !roots_malformed
    !roots_missing
    !roots_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !scene_pos
    !out
    !scene_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_NAME:
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !name_bad
    !name_status
    !malformed
    !missing
    !scene_pos
    !out
    !scene_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING:
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !scene_pos
    !out
    !scene_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_SCENE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !scene_pos
    !out
    !scene_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_dimension_from_string(text: ptr, len: i64) -> i32:
L_ENTRY:
    scalar_len = eq len, 6
    br scalar_len -> L_SCALAR_CHECK, L_VEC_CHECK

L_SCALAR_CHECK:
    scalar_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_SCALAR, 6)
    br scalar_eq -> L_SCALAR, L_VEC_CHECK_AFTER_SCALAR

L_SCALAR:
    !scalar_eq
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_SCALAR

L_VEC_CHECK_AFTER_SCALAR:
    !scalar_eq
    jmp L_VEC_CHECK_WITH_SCALAR

L_VEC_CHECK:
    jmp L_VEC_CHECK_WITH_SCALAR

L_VEC_CHECK_WITH_SCALAR:
    vec_len = eq len, 4
    br vec_len -> L_VEC2_CHECK, L_UNSUPPORTED

L_VEC2_CHECK:
    vec2_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_VEC2, 4)
    br vec2_eq -> L_VEC2, L_VEC3_CHECK

L_VEC2:
    !vec2_eq
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_VEC2

L_VEC3_CHECK:
    vec3_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_VEC3, 4)
    br vec3_eq -> L_VEC3, L_VEC4_CHECK

L_VEC3:
    !vec3_eq
    !vec2_eq
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_VEC3

L_VEC4_CHECK:
    vec4_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_VEC4, 4)
    br vec4_eq -> L_VEC4, L_MAT4_CHECK

L_VEC4:
    !vec4_eq
    !vec3_eq
    !vec2_eq
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_VEC4

L_MAT4_CHECK:
    mat4_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_MAT4, 4)
    br mat4_eq -> L_MAT4, L_UNSUPPORTED_VEC

L_MAT4:
    !mat4_eq
    !vec4_eq
    !vec3_eq
    !vec2_eq
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_MAT4

L_UNSUPPORTED_VEC:
    !mat4_eq
    !vec4_eq
    !vec3_eq
    !vec2_eq
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_UNSUPPORTED

L_UNSUPPORTED:
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_UNSUPPORTED

@sa3d_gltf_accessor_format_from_component_dimension(component_type: i32, dimension: i32) -> i32:
L_ENTRY:
    is_f32 = eq component_type, SA3D_GLTF_COMPONENT_F32
    br is_f32 -> L_F32, L_U32_CHECK

L_F32:
    dim_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br dim_scalar -> L_F32_SCALAR, L_F32_VEC2_CHECK
L_F32_SCALAR:
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_F32_SCALAR
L_F32_VEC2_CHECK:
    dim_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br dim_vec2 -> L_F32_VEC2, L_F32_VEC3_CHECK
L_F32_VEC2:
    !dim_vec2
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_F32X2
L_F32_VEC3_CHECK:
    dim_vec3 = eq dimension, SA3D_GLTF_DIM_VEC3
    br dim_vec3 -> L_F32_VEC3, L_F32_VEC4_CHECK
L_F32_VEC3:
    !dim_vec3
    !dim_vec2
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_F32X3
L_F32_VEC4_CHECK:
    dim_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br dim_vec4 -> L_F32_VEC4, L_F32_MAT4_CHECK
L_F32_VEC4:
    !dim_vec4
    !dim_vec3
    !dim_vec2
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_F32X4
L_F32_MAT4_CHECK:
    dim_mat4 = eq dimension, SA3D_GLTF_DIM_MAT4
    br dim_mat4 -> L_F32_MAT4, L_UNSUPPORTED_F32
L_F32_MAT4:
    !dim_mat4
    !dim_vec4
    !dim_vec3
    !dim_vec2
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_F32_MAT4
L_UNSUPPORTED_F32:
    !dim_mat4
    !dim_vec4
    !dim_vec3
    !dim_vec2
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return 0

L_U32_CHECK:
    is_u32 = eq component_type, SA3D_GLTF_COMPONENT_U32
    br is_u32 -> L_U32, L_I16_CHECK

L_U32:
    u32_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br u32_scalar -> L_U32_SCALAR, L_U32_VEC2_CHECK
L_U32_SCALAR:
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U32_SCALAR
L_U32_VEC2_CHECK:
    u32_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br u32_vec2 -> L_U32_VEC2, L_U32_VEC3_CHECK
L_U32_VEC2:
    !u32_vec2
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U32X2
L_U32_VEC3_CHECK:
    u32_vec3 = eq dimension, SA3D_GLTF_DIM_VEC3
    br u32_vec3 -> L_U32_VEC3, L_U32_VEC4_CHECK
L_U32_VEC3:
    !u32_vec3
    !u32_vec2
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U32X3
L_U32_VEC4_CHECK:
    u32_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br u32_vec4 -> L_U32_VEC4, L_UNSUPPORTED_U32
L_U32_VEC4:
    !u32_vec4
    !u32_vec3
    !u32_vec2
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U32X4
L_UNSUPPORTED_U32:
    !u32_vec4
    !u32_vec3
    !u32_vec2
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_I16_CHECK:
    is_i16 = eq component_type, SA3D_GLTF_COMPONENT_I16
    br is_i16 -> L_I16, L_U16_CHECK
L_I16:
    i16_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br i16_scalar -> L_I16_SCALAR, L_I16_VEC2_CHECK
L_I16_SCALAR:
    !i16_scalar
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S16_SCALAR
L_I16_VEC2_CHECK:
    i16_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br i16_vec2 -> L_I16_VEC2, L_I16_VEC4_CHECK
L_I16_VEC2:
    !i16_vec2
    !i16_scalar
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S16X2
L_I16_VEC4_CHECK:
    i16_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br i16_vec4 -> L_I16_VEC4, L_UNSUPPORTED_I16
L_I16_VEC4:
    !i16_vec4
    !i16_vec2
    !i16_scalar
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S16X4
L_UNSUPPORTED_I16:
    !i16_vec4
    !i16_vec2
    !i16_scalar
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_U16_CHECK:
    is_u16 = eq component_type, SA3D_GLTF_COMPONENT_U16
    br is_u16 -> L_U16, L_I8_CHECK
L_U16:
    u16_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br u16_scalar -> L_U16_SCALAR, L_U16_VEC2_CHECK
L_U16_SCALAR:
    !u16_scalar
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U16_SCALAR
L_U16_VEC2_CHECK:
    !u16_scalar
    u16_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br u16_vec2 -> L_U16_VEC2, L_U16_VEC3_CHECK
L_U16_VEC2:
    !u16_vec2
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U16X2
L_U16_VEC3_CHECK:
    u16_vec3 = eq dimension, SA3D_GLTF_DIM_VEC3
    br u16_vec3 -> L_U16_VEC3, L_U16_VEC4_CHECK
L_U16_VEC3:
    !u16_vec3
    !u16_vec2
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U16X3
L_U16_VEC4_CHECK:
    u16_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br u16_vec4 -> L_U16_VEC4, L_UNSUPPORTED_U16
L_U16_VEC4:
    !u16_vec4
    !u16_vec3
    !u16_vec2
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U16X4
L_UNSUPPORTED_U16:
    !u16_vec4
    !u16_vec3
    !u16_vec2
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_I8_CHECK:
    is_i8 = eq component_type, SA3D_GLTF_COMPONENT_I8
    br is_i8 -> L_I8, L_U8_CHECK
L_I8:
    i8_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br i8_scalar -> L_I8_SCALAR, L_I8_VEC2_CHECK
L_I8_SCALAR:
    !i8_scalar
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S8_SCALAR
L_I8_VEC2_CHECK:
    i8_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br i8_vec2 -> L_I8_VEC2, L_I8_VEC4_CHECK
L_I8_VEC2:
    !i8_vec2
    !i8_scalar
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S8X2
L_I8_VEC4_CHECK:
    i8_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br i8_vec4 -> L_I8_VEC4, L_UNSUPPORTED_I8
L_I8_VEC4:
    !i8_vec4
    !i8_vec2
    !i8_scalar
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S8X4
L_UNSUPPORTED_I8:
    !i8_vec4
    !i8_vec2
    !i8_scalar
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_U8_CHECK:
    is_u8 = eq component_type, SA3D_GLTF_COMPONENT_U8
    br is_u8 -> L_U8, L_UNSUPPORTED
L_U8:
    u8_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br u8_scalar -> L_U8_SCALAR, L_U8_VEC2_CHECK
L_U8_SCALAR:
    !u8_scalar
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U8_SCALAR
L_U8_VEC2_CHECK:
    !u8_scalar
    u8_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br u8_vec2 -> L_U8_VEC2, L_U8_VEC3_CHECK
L_U8_VEC2:
    !u8_vec2
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U8X2
L_U8_VEC3_CHECK:
    u8_vec3 = eq dimension, SA3D_GLTF_DIM_VEC3
    br u8_vec3 -> L_U8_VEC3, L_U8_VEC4_CHECK
L_U8_VEC3:
    !u8_vec3
    !u8_vec2
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U8X3
L_U8_VEC4_CHECK:
    u8_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br u8_vec4 -> L_U8_VEC4, L_UNSUPPORTED_U8
L_U8_VEC4:
    !u8_vec4
    !u8_vec3
    !u8_vec2
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
