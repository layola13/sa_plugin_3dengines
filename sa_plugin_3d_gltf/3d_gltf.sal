@sa3d_gltf_json_resolve_status_to_attr_status(resolve_status: i32) -> i32:
L_ENTRY:
    is_ok = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br is_ok -> L_OK, L_UNSUPPORTED_CHECK

L_OK:
    !is_ok
    !resolve_status
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_UNSUPPORTED_CHECK:
    is_unsupported = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_UNSUPPORTED_FORMAT
    br is_unsupported -> L_UNSUPPORTED, L_MALFORMED

L_UNSUPPORTED:
    !is_unsupported
    !is_ok
    !resolve_status
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !is_unsupported
    !is_ok
    !resolve_status
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

@sa3d_gltf_vertex_attribute_zero_materialize(accessor_count: i64, conversion: i32, accessor_format: i32, normalized: i32, convert_coordinates: i32, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    output_element_size = call @sa3d_gltf_attribute_materialize_output_byte_size(conversion, accessor_format, normalized)
    supported = ne output_element_size, 0
    br supported -> L_PTR_CHECK, L_UNSUPPORTED

L_PTR_CHECK:
    count_nonnegative = sge accessor_count, 0
    cap_nonnegative = sge cap, 0
    nonnegative = and count_nonnegative, cap_nonnegative
    dst_present = ne dst, 0
    ok0 = and nonnegative, dst_present
    br ok0 -> L_CAP_CHECK, L_MALFORMED

L_CAP_CHECK:
    required = mul accessor_count, output_element_size
    cap_ok = sge cap, required
    br cap_ok -> L_ZERO_INIT, L_OUTPUT_SMALL

L_ZERO_INIT:
    byte_slot = stack_alloc 8
    store byte_slot+0, 0 as i64
    jmp L_ZERO_HEAD

L_ZERO_HEAD:
    byte_idx = load byte_slot+0 as i64
    done = sge byte_idx, required
    br done -> L_ALPHA_CHECK, L_ZERO_BODY

L_ZERO_BODY:
    p = ptr_add dst, byte_idx
    store p+0, 0 as u8
    next = add byte_idx, 1
    store byte_slot+0, next as i64
    !next
    !p
    !done
    !byte_idx
    jmp L_ZERO_HEAD

L_ALPHA_CHECK:
    rgba = eq conversion, SA3D_GLTF_CONVERSION_RGBA
    f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    u8x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X3
    u16x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X3
    rgb0 = or f32x3, u8x3
    rgb = or rgb0, u16x3
    set_alpha = and rgba, rgb
    br set_alpha -> L_ALPHA_INIT, L_DONE

L_ALPHA_INIT:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_ALPHA_HEAD

L_ALPHA_HEAD:
    idx = load idx_slot+0 as i64
    alpha_done = sge idx, accessor_count
    br alpha_done -> L_DONE_ALPHA, L_ALPHA_BODY

L_ALPHA_BODY:
    element_pos = mul idx, output_element_size
    alpha_pos = add element_pos, 12
    alpha_ptr = ptr_add dst, alpha_pos
    store alpha_ptr+0, 1.0 as f32
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !alpha_ptr
    !alpha_pos
    !element_pos
    !alpha_done
    !idx
    jmp L_ALPHA_HEAD

L_DONE_ALPHA:
    store out_len+0, required as i64
    !alpha_done
    !idx
    !set_alpha
    !rgb
    !rgb0
    !u16x3
    !u8x3
    !f32x3
    !rgba
    !done
    !byte_idx
    !cap_ok
    !required
    !ok0
    !dst_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !supported
    !output_element_size
    !out_len
    !cap
    !dst
    !convert_coordinates
    !normalized
    !accessor_format
    !conversion
    !accessor_count
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_DONE:
    store out_len+0, required as i64
    !set_alpha
    !rgb
    !rgb0
    !u16x3
    !u8x3
    !f32x3
    !rgba
    !done
    !byte_idx
    !cap_ok
    !required
