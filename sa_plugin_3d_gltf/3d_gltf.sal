@sa3d_gltf_json_f32_array_materialize(bytes: ptr, len: i64, array_pos: i64, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    count = call @sa3d_gltf_json_count_array_items(bytes, len, array_pos)
    count_bad = slt count, 0
    br count_bad -> L_BAD_COUNT, L_PTR_CHECK

L_PTR_CHECK:
    dst_present = ne dst, 0
    cap_nonnegative = sge cap, 0
    ok0 = and dst_present, cap_nonnegative
    br ok0 -> L_CAP_CHECK, L_MALFORMED_PTR

L_CAP_CHECK:
    required = mul count, 4
    cap_ok = sge cap, required
    br cap_ok -> L_LOOP_INIT, L_OUTPUT_SMALL

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    bits_slot = stack_alloc 4
    store idx_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, count
    br done -> L_DONE, L_LOOP_BODY

L_LOOP_BODY:
    item_pos = call @sa3d_gltf_json_array_item_start(bytes, len, array_pos, idx)
    item_bad = slt item_pos, 0
    br item_bad -> L_BAD_ITEM, L_PARSE

L_PARSE:
    parsed = call @sa3d_gltf_json_parse_f32_bits(bytes, len, item_pos, &bits_slot)
    parsed_ok = ne parsed, 0
    br parsed_ok -> L_STORE, L_BAD_VALUE

L_STORE:
    dst_pos = mul idx, 4
    dst_ptr = ptr_add dst, dst_pos
    bits = load bits_slot+0 as i32
    store dst_ptr+0, bits as i32
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !bits
    !dst_ptr
    !dst_pos
    !parsed_ok
    !parsed
    !item_bad
    !item_pos
    !done
    !idx
    jmp L_LOOP_HEAD

L_DONE:
    store out_len+0, required as i64
    !done
    !idx
    !cap_ok
    !required
    !ok0
    !cap_nonnegative
    !dst_present
    !count_bad
    !count
    !out_len
    !cap
    !dst
    !array_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OUTPUT_SMALL:
    store out_len+0, required as i64
    !cap_ok
    !required
    !ok0
    !cap_nonnegative
    !dst_present
    !count_bad
    !count
    !out_len
    !cap
    !dst
    !array_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OUTPUT_TOO_SMALL

L_BAD_VALUE:
    !parsed_ok
    !parsed
    !item_bad
    !item_pos
    !done
    !idx
    !cap_ok
    !required
    !ok0
    !cap_nonnegative
    !dst_present
    !count_bad
    !count
    !out_len
    !cap
    !dst
    !array_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_ITEM:
    !item_bad
    !item_pos
    !done
    !idx
    !cap_ok
    !required
    !ok0
    !cap_nonnegative
    !dst_present
    !count_bad
    !count
    !out_len
    !cap
    !dst
    !array_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_PTR:
    !ok0
    !cap_nonnegative
    !dst_present
    !count_bad
    !count
    !out_len
    !cap
    !dst
    !array_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_COUNT:
