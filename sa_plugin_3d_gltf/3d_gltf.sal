@sa3d_gltf_json_object_field_value(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64) -> i64:
L_ENTRY:
    obj = ptr_add bytes, object_pos
    remaining = sub len, object_pos
    rel = call @sa3d_gltf_json_find_root_key_value(obj, remaining, key, key_len)
    missing = eq rel, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq rel, -2
    br malformed -> L_MALFORMED, L_FOUND

L_FOUND:
    abs = add object_pos, rel
    !malformed
    !missing
    !rel
    !remaining
    !obj
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return abs

L_MISSING:
    !missing
    !rel
    !remaining
    !obj
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

L_MALFORMED:
    !malformed
    !missing
    !rel
    !remaining
    !obj
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -2

@sa3d_gltf_json_parse_positive_i64(bytes: ptr, len: i64, value_pos: i64) -> i64:
L_ENTRY:
    pos = call @sa3d_gltf_json_skip_ws_from(bytes, len, value_pos)
    idx_slot = stack_alloc 8
    value_slot = stack_alloc 8
    digits_slot = stack_alloc 8
    store idx_slot+0, pos as i64
    store value_slot+0, 0 as i64
    store digits_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_DONE, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    ge = sge b, 48
    le = sle b, 57
    digit = and ge, le
    br digit -> L_DIGIT, L_DONE_LOAD

L_DIGIT:
    current = load value_slot+0 as i64
    digits = load digits_slot+0 as i64
    b_i64 = zext b as i64
    raw = sub b_i64, 48
    times10 = mul current, 10
    next_value = add times10, raw
    next_digits = add digits, 1
    next_idx = add idx, 1
    store value_slot+0, next_value as i64
    store digits_slot+0, next_digits as i64
    store idx_slot+0, next_idx as i64
    !next_idx
    !next_digits
    !next_value
    !times10
    !raw
    !b_i64
    !digits
    !current
    !digit
    !le
    !ge
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_DONE_LOAD:
    digits2 = load digits_slot+0 as i64
    has_digits = sgt digits2, 0
    br has_digits -> L_RETURN_VALUE, L_BAD_NO_DIGITS

L_DONE:
    digits3 = load digits_slot+0 as i64
    has_digits3 = sgt digits3, 0
    br has_digits3 -> L_RETURN_VALUE_DONE, L_BAD_DONE

L_RETURN_VALUE:
    value = load value_slot+0 as i64
    !has_digits
    !digits2
    !digit
    !le
    !ge
    !b
    !p
    !done
    !idx
    !pos
    !value_pos
    !len
    !bytes
    return value

L_RETURN_VALUE_DONE:
    value3 = load value_slot+0 as i64
    !has_digits3
    !digits3
    !done
    !idx
    !pos
    !value_pos
    !len
    !bytes
    return value3

L_BAD_NO_DIGITS:
    !has_digits
    !digits2
    !digit
    !le
    !ge
    !b
    !p
    !done
    !idx
    !pos
    !value_pos
    !len
    !bytes
    return -1

L_BAD_DONE:
    !has_digits3
    !digits3
    !done
    !idx
    !pos
    !value_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_object_i64_or_default(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, default_value: i64) -> i64:
L_ENTRY:
    value_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, key, key_len)
    missing = eq value_pos, -1
    br missing -> L_DEFAULT, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq value_pos, -2
    br malformed -> L_BAD, L_PARSE

L_PARSE:
    parsed = call @sa3d_gltf_json_parse_positive_i64(bytes, len, value_pos)
    !malformed
    !missing
    !value_pos
    !default_value
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return parsed

L_DEFAULT:
    !missing
    !value_pos
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return default_value

L_BAD:
    !malformed
    !missing
    !value_pos
    !default_value
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_object_i64_value(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out_value: ptr) -> i32:
L_ENTRY:
    store out_value+0, 0 as i64
    value_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, key, key_len)
    missing = eq value_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq value_pos, -2
    br malformed -> L_BAD, L_PARSE

L_PARSE:
    parsed = call @sa3d_gltf_json_parse_positive_i64(bytes, len, value_pos)
    parsed_bad = slt parsed, 0
    br parsed_bad -> L_BAD_VALUE, L_OK

L_OK:
    store out_value+0, parsed as i64
    !parsed_bad
    !parsed
    !malformed
    !missing
    !value_pos
    !out_value
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 1

L_MISSING:
    !missing
    !value_pos
    !out_value
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 0

L_BAD_VALUE:
    !parsed_bad
    !parsed
    !malformed
    !missing
