@sa3d_gltf_buffer_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_BUFFER_TABLE_URI_ptr, 0 as i64
    store out+SA3D_GLTF_BUFFER_TABLE_URI_len, 0 as i64
    store out+SA3D_GLTF_BUFFER_TABLE_byte_len, 0 as i64
    store out+SA3D_GLTF_BUFFER_TABLE_has_uri, 0 as i32
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_buffer_view_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_has_stride, 0 as i32
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_accessor_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_ACCESSOR_TABLE_buffer_view, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_byte_offset, 0 as i64
    store out+SA3D_GLTF_ACCESSOR_TABLE_count, 0 as i64
    store out+SA3D_GLTF_ACCESSOR_TABLE_component_type, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_dimension, SA3D_GLTF_DIM_UNSUPPORTED as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_normalized, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_accessor_format, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_buffer_parse(bytes: ptr, len: i64, index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_buffer_table_clear(&out)
    object_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_BUFFERS, 7, index)
    missing_obj = eq object_pos, -1
    br missing_obj -> L_MISSING_OBJECT, L_MALFORMED_OBJ_CHECK

L_MALFORMED_OBJ_CHECK:
    malformed_obj = eq object_pos, -2
    br malformed_obj -> L_MALFORMED_OBJECT, L_BYTE_LENGTH_POS

L_BYTE_LENGTH_POS:
    byte_len_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_LENGTH, 10)
    missing_byte_len = eq byte_len_pos, -1
    br missing_byte_len -> L_MISSING_BYTE_LENGTH, L_BYTE_LENGTH_MALFORMED_CHECK

L_BYTE_LENGTH_MALFORMED_CHECK:
    malformed_byte_len_pos = eq byte_len_pos, -2
    br malformed_byte_len_pos -> L_MALFORMED_BYTE_LENGTH, L_PARSE_BYTE_LENGTH

L_PARSE_BYTE_LENGTH:
    byte_len = call @sa3d_gltf_json_parse_positive_i64(bytes, len, byte_len_pos)
    byte_len_bad = slt byte_len, 0
    br byte_len_bad -> L_MALFORMED_BYTE_LENGTH_VALUE, L_URI

L_URI:
    uri_ptr_slot = stack_alloc 8
    uri_len_slot = stack_alloc 8
    uri_status = call @sa3d_gltf_json_object_string_span(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_URI, 3, &uri_ptr_slot, &uri_len_slot)
    uri_bad = slt uri_status, 0
    br uri_bad -> L_MALFORMED_URI, L_STORE

L_STORE:
    has_uri = sgt uri_status, 0
    uri_ptr = load uri_ptr_slot+0 as ptr
    uri_len = load uri_len_slot+0 as i64
    store out+SA3D_GLTF_BUFFER_TABLE_URI_ptr, uri_ptr as ptr
    store out+SA3D_GLTF_BUFFER_TABLE_URI_len, uri_len as i64
    store out+SA3D_GLTF_BUFFER_TABLE_byte_len, byte_len as i64
    store out+SA3D_GLTF_BUFFER_TABLE_has_uri, has_uri as i32
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !uri_len
    !uri_ptr
    !has_uri
    !uri_bad
    !uri_status
    !byte_len_bad
    !byte_len
    !malformed_byte_len_pos
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING_OBJECT:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_OBJECT:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_BYTE_LENGTH:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_BYTE_LENGTH:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_byte_len_pos
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_BYTE_LENGTH_VALUE:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !byte_len_bad
    !byte_len
    !malformed_byte_len_pos
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_URI:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !uri_bad
    !uri_status
    !byte_len_bad
    !byte_len
    !malformed_byte_len_pos
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_buffer_view_parse(bytes: ptr, len: i64, index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_buffer_view_table_clear(&out)
    object_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_BUFFER_VIEWS, 11, index)
    missing_obj = eq object_pos, -1
    br missing_obj -> L_MISSING_OBJECT, L_MALFORMED_OBJ_CHECK

L_MALFORMED_OBJ_CHECK:
    malformed_obj = eq object_pos, -2
    br malformed_obj -> L_MALFORMED_OBJECT, L_BUFFER_POS

L_BUFFER_POS:
    buffer_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BUFFER, 6)
    buffer_missing = eq buffer_pos, -1
    br buffer_missing -> L_MISSING_BUFFER, L_BUFFER_MALFORMED_CHECK

L_BUFFER_MALFORMED_CHECK:
    buffer_malformed = eq buffer_pos, -2
    br buffer_malformed -> L_MALFORMED_BUFFER, L_PARSE_BUFFER

L_PARSE_BUFFER:
    buffer_idx = call @sa3d_gltf_json_parse_positive_i64(bytes, len, buffer_pos)
    buffer_bad = slt buffer_idx, 0
    br buffer_bad -> L_MALFORMED_BUFFER_VALUE, L_BYTE_LENGTH_POS

L_BYTE_LENGTH_POS:
    byte_len_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_LENGTH, 10)
    byte_len_missing = eq byte_len_pos, -1
    br byte_len_missing -> L_MISSING_BYTE_LENGTH, L_BYTE_LENGTH_MALFORMED_CHECK

L_BYTE_LENGTH_MALFORMED_CHECK:
    byte_len_malformed = eq byte_len_pos, -2
    br byte_len_malformed -> L_MALFORMED_BYTE_LENGTH, L_PARSE_BYTE_LENGTH

L_PARSE_BYTE_LENGTH:
    byte_len = call @sa3d_gltf_json_parse_positive_i64(bytes, len, byte_len_pos)
    byte_len_bad = slt byte_len, 0
    br byte_len_bad -> L_MALFORMED_BYTE_LENGTH_VALUE, L_OPTIONALS

L_OPTIONALS:
    byte_offset = call @sa3d_gltf_json_object_i64_or_default(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_OFFSET, 10, 0)
    byte_offset_bad = slt byte_offset, 0
    br byte_offset_bad -> L_MALFORMED_BYTE_OFFSET, L_STRIDE

L_STRIDE:
    stride_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_STRIDE, 10)
    stride_missing = eq stride_pos, -1
    br stride_missing -> L_STRIDE_DEFAULT, L_STRIDE_MALFORMED_CHECK

L_STRIDE_MALFORMED_CHECK:
    stride_malformed = eq stride_pos, -2
    br stride_malformed -> L_MALFORMED_STRIDE, L_PARSE_STRIDE

L_PARSE_STRIDE:
    byte_stride = call @sa3d_gltf_json_parse_positive_i64(bytes, len, stride_pos)
    stride_bad = slt byte_stride, 0
    br stride_bad -> L_MALFORMED_STRIDE_VALUE, L_STORE_WITH_STRIDE

L_STRIDE_DEFAULT:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer, buffer_idx as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset, byte_offset as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len, byte_len as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_has_stride, 0 as i32
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !stride_missing
    !stride_pos
    !byte_offset_bad
    !byte_offset
    !byte_len_bad
    !byte_len
    !byte_len_malformed
    !byte_len_missing
    !byte_len_pos
    !buffer_bad
    !buffer_idx
    !buffer_malformed
    !buffer_missing
    !buffer_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_STORE_WITH_STRIDE:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer, buffer_idx as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset, byte_offset as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len, byte_len as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride, byte_stride as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_has_stride, 1 as i32
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !stride_bad
    !byte_stride
    !stride_malformed
    !stride_missing
    !stride_pos
    !byte_offset_bad
    !byte_offset
    !byte_len_bad
    !byte_len
    !byte_len_malformed
    !byte_len_missing
    !byte_len_pos
    !buffer_bad
    !buffer_idx
    !buffer_malformed
    !buffer_missing
    !buffer_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING_OBJECT:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_OBJECT:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_BUFFER:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !buffer_missing
    !buffer_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_BUFFER:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !buffer_malformed
    !buffer_missing
