@sa3d_gltf_json_material_table_parse_specular(bytes: ptr, len: i64, material_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    extensions_pos = call @sa3d_gltf_json_object_field_value(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_EXTENSIONS, 10)
    extensions_missing = eq extensions_pos, -1
    br extensions_missing -> L_OK_MISSING_EXTENSIONS, L_EXTENSIONS_MALFORMED_CHECK

L_EXTENSIONS_MALFORMED_CHECK:
    extensions_malformed = eq extensions_pos, -2
    br extensions_malformed -> L_BAD_EXTENSIONS, L_EXTENSION

L_EXTENSION:
    specular_pos = call @sa3d_gltf_json_object_field_value(bytes, len, extensions_pos, &SA3D_GLTF_JSON_KEY_KHR_MATERIALS_SPECULAR, 22)
    specular_missing = eq specular_pos, -1
    br specular_missing -> L_OK_MISSING_SPECULAR_EXT, L_SPECULAR_EXT_MALFORMED_CHECK

L_SPECULAR_EXT_MALFORMED_CHECK:
    specular_malformed = eq specular_pos, -2
    br specular_malformed -> L_BAD_SPECULAR_EXT, L_FIELDS

L_FIELDS:
    factor_status = call @sa3d_gltf_json_material_table_parse_specular_factor(bytes, len, specular_pos, &out)
    color_status = call @sa3d_gltf_json_material_table_parse_specular_color_factor(bytes, len, specular_pos, &out)
    texture_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, specular_pos, &SA3D_GLTF_JSON_KEY_SPECULAR_TEXTURE, 15, &out, SA3D_GLTF_MATERIAL_TABLE_has_specular_texture, SA3D_GLTF_MATERIAL_TABLE_specular_texture, SA3D_GLTF_MATERIAL_TABLE_specular_uv, SA3D_GLTF_TEXTURE_USAGE_SPECULAR, 0)
    color_texture_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, specular_pos, &SA3D_GLTF_JSON_KEY_SPECULAR_COLOR_TEXTURE, 20, &out, SA3D_GLTF_MATERIAL_TABLE_has_specular_color_texture, SA3D_GLTF_MATERIAL_TABLE_specular_color_texture, SA3D_GLTF_MATERIAL_TABLE_specular_color_uv, SA3D_GLTF_TEXTURE_USAGE_SPECULAR_COLOR, 0)
    factor_bad = ne factor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    color_bad = ne color_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    texture_bad = ne texture_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    color_texture_bad = ne color_texture_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    a = or factor_bad, color_bad
    b = or texture_bad, color_texture_bad
    bad = or a, b
    br bad -> L_BAD_FIELDS, L_OK

L_OK:
    !bad
    !b
    !a
    !color_texture_bad
    !texture_bad
    !color_bad
    !factor_bad
    !color_texture_status
    !texture_status
    !color_status
    !factor_status
    !specular_malformed
    !specular_missing
    !specular_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_FIELDS:
    !bad
    !b
    !a
    !color_texture_bad
    !texture_bad
    !color_bad
