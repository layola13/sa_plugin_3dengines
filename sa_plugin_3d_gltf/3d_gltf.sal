L_BAD:
    !malformed
    !names_pos
    !mesh_index
    !len
    !bytes
    return -2

@sa3d_gltf_json_mesh_morph_target_name_span(bytes: ptr, len: i64, mesh_index: i64, name_index: i64, &out_ptr: ptr, &out_len: ptr) -> i32:
L_ENTRY:
    store out_ptr+0, 0 as i64
    store out_len+0, 0 as i64
    names_pos = call @sa3d_gltf_json_mesh_morph_target_names_array_pos(bytes, len, mesh_index)
    malformed = eq names_pos, -2
    br malformed -> L_BAD_NAMES, L_MISSING_CHECK

L_MISSING_CHECK:
    missing = eq names_pos, -1
    br missing -> L_MISSING, L_ITEM

L_ITEM:
    item_pos = call @sa3d_gltf_json_array_item_start(bytes, len, names_pos, name_index)
    item_malformed = eq item_pos, -2
    br item_malformed -> L_BAD_ITEM, L_ITEM_MISSING_CHECK

L_ITEM_MISSING_CHECK:
    item_missing = eq item_pos, -1
    br item_missing -> L_MISSING_ITEM, L_BOUNDS

L_BOUNDS:
    in_bounds = slt item_pos, len
    br in_bounds -> L_LOAD, L_BAD_BOUNDS

L_LOAD:
    p = ptr_add bytes, item_pos
    b = load p+0 as u8
    is_quote = eq b, 34
    br is_quote -> L_SKIP, L_BAD_NOT_STRING

L_SKIP:
    after = call @sa3d_gltf_json_skip_string(bytes, len, item_pos)
    bad_after = slt after, 0
    br bad_after -> L_BAD_SKIP, L_STORE

L_STORE:
    start = add item_pos, 1
    end = sub after, 1
    slen = sub end, start
    sptr = ptr_add bytes, start
    store out_ptr+0, sptr as ptr
    store out_len+0, slen as i64
    !sptr
    !slen
    !end
    !start
    !bad_after
    !after
    !is_quote
    !b
    !p
    !in_bounds
    !item_missing
    !item_malformed
    !item_pos
    !missing
    !malformed
    !names_pos
    !out_len
    !out_ptr
    !name_index
    !mesh_index
