    out = ptr_add dst, dst_pos
    raw = load src+0 as u8
    f = uitofp raw as f32
    n = fdiv f, 255.0
    store out+0, n as f32
    !n
    !f
    !raw
    !out
    !src
    !dst_pos
    !dst
    !src_pos
    !buffer
