@sa3d_gltf_json_texture_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_TEXTURE_TABLE_source, 0 as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_has_source, 0 as i32
    store out+SA3D_GLTF_TEXTURE_TABLE_sampler, 0 as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_has_sampler, 0 as i32
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_texture_table_parse(bytes: ptr, len: i64, texture_index: i64, &out: ptr) -> i32:
L_ENTRY:
    source_slot = stack_alloc 8
    sampler_slot = stack_alloc 8
    call @sa3d_gltf_json_texture_table_clear(&out)
    texture_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_TEXTURES, 8, texture_index)
    missing = eq texture_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq texture_pos, -2
    br malformed -> L_MALFORMED, L_SOURCE

L_SOURCE:
    source_status = call @sa3d_gltf_json_object_i64_value(bytes, len, texture_pos, &SA3D_GLTF_JSON_KEY_SOURCE, 6, &source_slot)
    source_ok = eq source_status, 1
    br source_ok -> L_SAMPLER, L_BAD_SOURCE_CHECK

L_BAD_SOURCE_CHECK:
    source_bad = slt source_status, 0
    br source_bad -> L_BAD_SOURCE, L_MISSING_SOURCE

L_SAMPLER:
    sampler_status = call @sa3d_gltf_json_object_i64_value(bytes, len, texture_pos, &SA3D_GLTF_JSON_KEY_SAMPLER, 7, &sampler_slot)
    sampler_bad = slt sampler_status, 0
    br sampler_bad -> L_BAD_SAMPLER, L_STORE

L_STORE:
    source = load source_slot+0 as i64
    has_sampler = eq sampler_status, 1
    sampler = load sampler_slot+0 as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_source, source as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_has_source, 1 as i32
    store out+SA3D_GLTF_TEXTURE_TABLE_sampler, sampler as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_has_sampler, has_sampler as i32
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !sampler
    !has_sampler
    !source
    !sampler_bad
    !sampler_status
    !source_ok
    !source_status
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_SOURCE:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !source_bad
    !source_ok
    !source_status
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_BAD_SOURCE:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !source_bad
    !source_ok
    !source_status
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_SAMPLER:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !sampler_bad
    !sampler_status
    !source_ok
    !source_status
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_image_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_IMAGE_TABLE_source_kind, SA3D_GLTF_IMAGE_SOURCE_URI as i32
    store out+SA3D_GLTF_IMAGE_TABLE_uri_ptr, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_uri_len, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_buffer_view, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_mime_ptr, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_mime_len, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_has_uri, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_buffer_view, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_mime, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_image_table_parse(bytes: ptr, len: i64, image_index: i64, &out: ptr) -> i32:
L_ENTRY:
    uri_ptr_slot = stack_alloc 8
    uri_len_slot = stack_alloc 8
    mime_ptr_slot = stack_alloc 8
    mime_len_slot = stack_alloc 8
    buffer_view_slot = stack_alloc 8
    call @sa3d_gltf_json_image_table_clear(&out)
    image_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_IMAGES, 6, image_index)
    missing = eq image_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq image_pos, -2
    br malformed -> L_MALFORMED, L_URI

L_URI:
    uri_status = call @sa3d_gltf_json_object_string_span(bytes, len, image_pos, &SA3D_GLTF_JSON_KEY_URI, 3, &uri_ptr_slot, &uri_len_slot)
    uri_bad = slt uri_status, 0
    br uri_bad -> L_BAD_URI, L_BUFFER_VIEW

L_BUFFER_VIEW:
    buffer_view_status = call @sa3d_gltf_json_object_i64_value(bytes, len, image_pos, &SA3D_GLTF_JSON_KEY_BUFFER_VIEW, 10, &buffer_view_slot)
    buffer_view_bad = slt buffer_view_status, 0
    br buffer_view_bad -> L_BAD_BUFFER_VIEW, L_MIME

L_MIME:
    mime_status = call @sa3d_gltf_json_object_string_span(bytes, len, image_pos, &SA3D_GLTF_JSON_KEY_MIME_TYPE, 8, &mime_ptr_slot, &mime_len_slot)
    mime_bad = slt mime_status, 0
    br mime_bad -> L_BAD_MIME, L_SOURCE_SELECT

L_SOURCE_SELECT:
    has_uri = eq uri_status, 1
    has_view = eq buffer_view_status, 1
    both = and has_uri, has_view
    br both -> L_BAD_BOTH_SOURCES, L_URI_CHECK

L_URI_CHECK:
    br has_uri -> L_STORE_URI, L_VIEW_CHECK

L_VIEW_CHECK:
    br has_view -> L_VIEW_MIME_CHECK, L_MISSING_SOURCE

L_VIEW_MIME_CHECK:
    has_mime_for_view = eq mime_status, 1
    br has_mime_for_view -> L_STORE_VIEW, L_MISSING_VIEW_MIME

L_STORE_URI:
    uri_ptr = load uri_ptr_slot+0 as ptr
    uri_len = load uri_len_slot+0 as i64
    has_mime = eq mime_status, 1
    mime_ptr = load mime_ptr_slot+0 as ptr
    mime_len = load mime_len_slot+0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_source_kind, SA3D_GLTF_IMAGE_SOURCE_URI as i32
    store out+SA3D_GLTF_IMAGE_TABLE_uri_ptr, uri_ptr as ptr
    store out+SA3D_GLTF_IMAGE_TABLE_uri_len, uri_len as i64
    store out+SA3D_GLTF_IMAGE_TABLE_mime_ptr, mime_ptr as ptr
    store out+SA3D_GLTF_IMAGE_TABLE_mime_len, mime_len as i64
    store out+SA3D_GLTF_IMAGE_TABLE_has_uri, 1 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_buffer_view, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_mime, has_mime as i32
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !mime_len
    !mime_ptr
    !has_mime
    !uri_len
    !uri_ptr
    !has_view
    !has_uri
    !both
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_STORE_VIEW:
    view = load buffer_view_slot+0 as i64
    mime_ptr_view = load mime_ptr_slot+0 as ptr
    mime_len_view = load mime_len_slot+0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_source_kind, SA3D_GLTF_IMAGE_SOURCE_VIEW as i32
    store out+SA3D_GLTF_IMAGE_TABLE_buffer_view, view as i64
    store out+SA3D_GLTF_IMAGE_TABLE_mime_ptr, mime_ptr_view as ptr
    store out+SA3D_GLTF_IMAGE_TABLE_mime_len, mime_len_view as i64
    store out+SA3D_GLTF_IMAGE_TABLE_has_uri, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_buffer_view, 1 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_mime, 1 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !mime_len_view
    !mime_ptr_view
    !view
    !has_mime_for_view
    !has_view
    !has_uri
    !both
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_VIEW_MIME:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !has_mime_for_view
    !has_view
    !has_uri
    !both
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MISSING_SOURCE:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !has_view
    !has_uri
    !both
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_BAD_BOTH_SOURCES:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !both
    !has_view
    !has_uri
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MIME:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_BUFFER_VIEW:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_URI:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_node_name_to_bytes(node_index: i64, name_ptr: ptr, name_len: i64, &dst: ptr, cap: i64) -> i64:
L_ENTRY:
    has_ptr = ne name_ptr, 0
    len_ok = sge name_len, 0
    has_name = and has_ptr, len_ok
    br has_name -> L_COPY_NAME, L_FALLBACK

L_COPY_NAME:
    out_name = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &name_ptr, name_len)
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !node_index
    return out_name

L_FALLBACK:
    p0 = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &SA3D_GLTF_NAME_TEXT_NODE_PREFIX, 8)
    p0_failed = slt p0, 0
    br p0_failed -> L_FAIL, L_INDEX

L_INDEX:
    out_fallback = call @sa3d_gltf_label_write_i64_decimal(&dst, cap, p0, node_index)
    !p0_failed
    !p0
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !node_index
    return out_fallback

L_FAIL:
    !p0_failed
    !p0
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !node_index
    return -1

@sa3d_gltf_primitive_name_to_bytes(mesh_name_ptr: ptr, mesh_name_len: i64, material_name_ptr: ptr, material_name_len: i64, &dst: ptr, cap: i64) -> i64:
L_ENTRY:
    mesh_has_ptr = ne mesh_name_ptr, 0
    mesh_len_ok = sge mesh_name_len, 0
    mesh_has_name = and mesh_has_ptr, mesh_len_ok
    br mesh_has_name -> L_MESH_NAME, L_MESH_FALLBACK

L_MESH_NAME:
    mesh_end = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &mesh_name_ptr, mesh_name_len)
    jmp L_MATERIAL_CHECK

L_MESH_FALLBACK:
    mesh_end = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &SA3D_GLTF_NAME_TEXT_MESH_FALLBACK, 4)
    jmp L_MATERIAL_CHECK

L_MATERIAL_CHECK:
    mesh_failed = slt mesh_end, 0
    br mesh_failed -> L_FAIL, L_MATERIAL_HAS

L_MATERIAL_HAS:
    material_has_ptr = ne material_name_ptr, 0
    material_len_ok = sge material_name_len, 0
    material_has_name = and material_has_ptr, material_len_ok
    br material_has_name -> L_DOT, L_DONE

L_DONE:
    !material_has_name
    !material_len_ok
    !material_has_ptr
    !mesh_failed
    !mesh_has_name
    !mesh_len_ok
    !mesh_has_ptr
    !cap
    !dst
    !material_name_len
    !material_name_ptr
    !mesh_name_len
    !mesh_name_ptr
    return mesh_end

L_DOT:
    dot_end = call @sa3d_gltf_label_write_byte(&dst, cap, mesh_end, 46)
    dot_failed = slt dot_end, 0
    br dot_failed -> L_FAIL_DOT, L_MATERIAL_COPY

L_MATERIAL_COPY:
    out_material = call @sa3d_gltf_label_copy_bytes(&dst, cap, dot_end, &material_name_ptr, material_name_len)
    !dot_failed
    !dot_end
    !material_has_name
    !material_len_ok
    !material_has_ptr
    !mesh_failed
    !mesh_end
    !mesh_has_name
    !mesh_len_ok
    !mesh_has_ptr
    !cap
    !dst
    !material_name_len
    !material_name_ptr
    !mesh_name_len
    !mesh_name_ptr
    return out_material

L_FAIL_DOT:
    !dot_failed
    !dot_end
    !material_has_name
    !material_len_ok
    !material_has_ptr
    !mesh_failed
    !mesh_end
    !mesh_has_name
    !mesh_len_ok
    !mesh_has_ptr
    !cap
    !dst
    !material_name_len
    !material_name_ptr
    !mesh_name_len
    !mesh_name_ptr
    return -1

L_FAIL:
    !mesh_failed
    !mesh_end
    !mesh_has_name
    !mesh_len_ok
    !mesh_has_ptr
    !cap
    !dst
    !material_name_len
    !material_name_ptr
    !mesh_name_len
    !mesh_name_ptr
    return -1

@sa3d_gltf_loader_settings_default(&settings: ptr) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_meshes, SA3D_GLTF_RENDER_ASSET_USAGE_DEFAULT as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_materials, SA3D_GLTF_RENDER_ASSET_USAGE_DEFAULT as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_cameras, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_lights, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_animations, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_include_source, 0 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_default_sampler_present, 0 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_override_sampler, 0 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_validate, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_convert_coordinates_present, 0 as i32
    convert = ptr_add settings, SA3D_GLTF_LOADER_SETTINGS_convert_coordinates
    call @sa3d_gltf_convert_coordinates_init(&convert)
    store settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy_present, 0 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy, SA3D_GLTF_SKINNED_BOUNDS_DYNAMIC as i32
    !convert
    !settings
    return

@sa3d_gltf_loader_settings_set_load_meshes(&settings: ptr, usages: i32) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_meshes, usages as i32
    !usages
    !settings
    return

@sa3d_gltf_loader_settings_set_load_materials(&settings: ptr, usages: i32) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_materials, usages as i32
    !usages
    !settings
    return

@sa3d_gltf_loader_settings_meshes_enabled(&settings: ptr) -> i32:
L_ENTRY:
    usages = load settings+SA3D_GLTF_LOADER_SETTINGS_load_meshes as i32
    enabled = ne usages, 0
    br enabled -> L_TRUE, L_FALSE

L_TRUE:
    !enabled
    !usages
    !settings
    return 1

L_FALSE:
    !enabled
    !usages
    !settings
    return 0

@sa3d_gltf_loader_settings_materials_enabled(&settings: ptr) -> i32:
L_ENTRY:
    usages = load settings+SA3D_GLTF_LOADER_SETTINGS_load_materials as i32
    enabled = ne usages, 0
    br enabled -> L_TRUE, L_FALSE

L_TRUE:
    !enabled
    !usages
    !settings
    return 1

L_FALSE:
    !enabled
    !usages
    !settings
    return 0

@sa3d_gltf_loader_settings_set_convert_coordinates(&settings: ptr, rotate_scene_entity: i32, rotate_meshes: i32) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_convert_coordinates_present, 1 as i32
    convert = ptr_add settings, SA3D_GLTF_LOADER_SETTINGS_convert_coordinates
    store convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity, rotate_scene_entity as i32
    store convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes, rotate_meshes as i32
    !convert
    !rotate_meshes
    !rotate_scene_entity
    !settings
    return

@sa3d_gltf_loader_settings_effective_convert_coordinates(&dst: ptr, &settings: ptr, &default_convert: ptr) -> void:
L_ENTRY:
    present = load settings+SA3D_GLTF_LOADER_SETTINGS_convert_coordinates_present as i32
    br present -> L_SETTINGS, L_DEFAULT

L_SETTINGS:
    convert = ptr_add settings, SA3D_GLTF_LOADER_SETTINGS_convert_coordinates
    scene = load convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity as i32
    meshes = load convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes as i32
    store dst+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity, scene as i32
    store dst+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes, meshes as i32
    !meshes
    !scene
    !convert
    !present
    !default_convert
    !settings
    !dst
    return

L_DEFAULT:
    scene = load default_convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity as i32
    meshes = load default_convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes as i32
    store dst+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity, scene as i32
    store dst+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes, meshes as i32
    !meshes
    !scene
    !present
    !default_convert
    !settings
    !dst
    return

@sa3d_gltf_loader_settings_set_skinned_bounds_policy(&settings: ptr, policy: i32) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy_present, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy, policy as i32
    !policy
    !settings
    return

@sa3d_gltf_loader_settings_effective_skinned_bounds_policy(&settings: ptr, default_policy: i32) -> i32:
L_ENTRY:
    present = load settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy_present as i32
    br present -> L_SETTINGS, L_DEFAULT

L_SETTINGS:
    policy = load settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy as i32
    !present
    !default_policy
    !settings
    return policy

L_DEFAULT:
    !present
    !settings
    return default_policy

@sa3d_gltf_vertex_attribute_desc_clear(&desc: ptr) -> void:
L_ENTRY:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_UNKNOWN as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 0 as i32
    !desc
    return

@sa3d_gltf_vertex_attribute_from_semantic(&desc: ptr, semantic: i32, convert_coordinates: i32, custom_attribute: i32) -> i32:
L_ENTRY:
    call @sa3d_gltf_vertex_attribute_desc_clear(&desc)
    is_position = eq semantic, SA3D_GLTF_SEMANTIC_POSITIONS
    br is_position -> L_POSITION, L_NORMAL_CHECK

L_POSITION:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_POSITION as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, convert_coordinates as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_NORMAL_CHECK:
    is_normal = eq semantic, SA3D_GLTF_SEMANTIC_NORMALS
    br is_normal -> L_NORMAL, L_TANGENT_CHECK

L_NORMAL:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_NORMAL as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, convert_coordinates as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_TANGENT_CHECK:
    is_tangent = eq semantic, SA3D_GLTF_SEMANTIC_TANGENTS
    br is_tangent -> L_TANGENT, L_COLOR_CHECK

L_TANGENT:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_TANGENT as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, convert_coordinates as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_COLOR_CHECK:
    is_color = eq semantic, SA3D_GLTF_SEMANTIC_COLORS_0
    br is_color -> L_COLOR, L_UV0_CHECK

L_COLOR:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_COLOR as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_RGBA as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_UV0_CHECK:
    is_uv0 = eq semantic, SA3D_GLTF_SEMANTIC_TEXCOORDS_0
    br is_uv0 -> L_UV0, L_UV1_CHECK

L_UV0:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_UV_0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_TEX_COORD as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_UV1_CHECK:
    is_uv1 = eq semantic, SA3D_GLTF_SEMANTIC_TEXCOORDS_1
    br is_uv1 -> L_UV1, L_JOINTS_CHECK

L_UV1:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_UV_1 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_TEX_COORD as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_JOINTS_CHECK:
    is_joints = eq semantic, SA3D_GLTF_SEMANTIC_JOINTS_0
    br is_joints -> L_JOINTS, L_WEIGHTS_CHECK

L_JOINTS:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_JOINT_INDEX as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_JOINT_INDEX as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_joints
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_WEIGHTS_CHECK:
    is_weights = eq semantic, SA3D_GLTF_SEMANTIC_WEIGHTS_0
    br is_weights -> L_WEIGHTS, L_EXTRAS_CHECK

L_WEIGHTS:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_JOINT_WEIGHT as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_JOINT_WEIGHT as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_weights
    !is_joints
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_EXTRAS_CHECK:
    is_extras = eq semantic, SA3D_GLTF_SEMANTIC_EXTRAS
    has_custom = ne custom_attribute, 0
    custom_ok = and is_extras, has_custom
    br custom_ok -> L_CUSTOM, L_UNKNOWN

L_CUSTOM:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, custom_attribute as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !custom_ok
    !has_custom
    !is_extras
    !is_weights
    !is_joints
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_UNKNOWN:
    !custom_ok
    !has_custom
    !is_extras
    !is_weights
    !is_joints
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 0

@sa3d_gltf_accessor_layout_clear(&layout: ptr) -> void:
L_ENTRY:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset, 0 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_len, 0 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride, 0 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size, 0 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA as i32
    !layout
    return

@sa3d_gltf_accessor_format_byte_size(accessor_format: i32) -> i64:
L_ENTRY:
    f32_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_SCALAR
    u32_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_U32_SCALAR
    s8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X4
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    s16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X2
    u16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X2
    group4_a = or f32_scalar, u32_scalar
    group4_b = or s8x4, u8x4
    group4_c = or s16x2, u16x2
    group4_ab = or group4_a, group4_b
    group4 = or group4_ab, group4_c
    br group4 -> L_SIZE4, L_SIZE8_CHECK

L_SIZE4:
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 4

L_SIZE8_CHECK:
    f32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X2
    u32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X2
    s16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    group8_a = or f32x2, u32x2
    group8_b = or s16x4, u16x4
    group8 = or group8_a, group8_b
    br group8 -> L_SIZE8, L_SIZE12_CHECK

L_SIZE8:
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 8

L_SIZE12_CHECK:
    f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    u32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X3
    group12 = or f32x3, u32x3
    br group12 -> L_SIZE12, L_SIZE16_CHECK

L_SIZE12:
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 12

L_SIZE16_CHECK:
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    u32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X4
    group16 = or f32x4, u32x4
    br group16 -> L_SIZE16, L_SIZE2_CHECK

L_SIZE16:
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 16

L_SIZE2_CHECK:
    u16_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_U16_SCALAR
    br u16_scalar -> L_SIZE2_SCALAR, L_SIZE2_VEC_CHECK

L_SIZE2_SCALAR:
    !u16_scalar
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 2

L_SIZE2_VEC_CHECK:
    !u16_scalar
    s8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X2
    u8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X2
    group2 = or s8x2, u8x2
    br group2 -> L_SIZE2, L_SIZE6_CHECK

L_SIZE2:
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 2

L_SIZE6_CHECK:
    u16x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X3
    br u16x3 -> L_SIZE6, L_SIZE3_CHECK

L_SIZE6:
    !u16x3
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 6

L_SIZE3_CHECK:
    u8x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X3
    br u8x3 -> L_SIZE3, L_SIZE1_CHECK

L_SIZE3:
    !u8x3
    !u16x3
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 3

L_SIZE1_CHECK:
    u8_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_U8_SCALAR
    br u8_scalar -> L_SIZE1, L_UNSUPPORTED

L_SIZE1:
    !u8_scalar
    !u8x3
    !u16x3
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 1

L_UNSUPPORTED:
    !u8_scalar
    !u8x3
    !u16x3
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c
    !group4_b
    !group4_a
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 0

@sa3d_gltf_accessor_layout_validate(buffer_len: i64, view_offset: i64, view_len: i64, view_stride: i64, accessor_offset: i64, accessor_count: i64, accessor_format: i32, &layout: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_accessor_layout_clear(&layout)
    element_size = call @sa3d_gltf_accessor_format_byte_size(accessor_format)
    supported = sgt element_size, 0
    br supported -> L_NONNEGATIVE, L_UNSUPPORTED_FORMAT

L_NONNEGATIVE:
    b0 = sge buffer_len, 0
    b1 = sge view_offset, 0
    b2 = sge view_len, 0
    b3 = sge view_stride, 0
    b4 = sge accessor_offset, 0
    b5 = sge accessor_count, 0
    a0 = and b0, b1
    a1 = and b2, b3
    a2 = and b4, b5
    a3 = and a0, a1
    nonnegative = and a3, a2
    br nonnegative -> L_STRIDE_SELECT, L_MALFORMED_NONNEG

L_STRIDE_SELECT:
    has_stride = sgt view_stride, 0
    br has_stride -> L_STRIDE_GIVEN, L_STRIDE_TIGHT

L_STRIDE_GIVEN:
    stride_given_ok = sge view_stride, element_size
    br stride_given_ok -> L_SPAN_GIVEN, L_MALFORMED_STRIDE

L_SPAN_GIVEN:
    empty_given = eq accessor_count, 0
    br empty_given -> L_SPAN_ZERO_GIVEN, L_SPAN_COUNT_GIVEN

L_SPAN_ZERO_GIVEN:
    required_given_zero = 0
    stride_given_final = add view_stride, 0
    jmp L_BOUNDS_GIVEN

L_SPAN_COUNT_GIVEN:
    count_minus_given = sub accessor_count, 1
    stepped_given = mul count_minus_given, view_stride
    required_given = add stepped_given, element_size
    stride_given_final2 = add view_stride, 0
    jmp L_BOUNDS_GIVEN_COUNT

L_BOUNDS_GIVEN:
    view_end_given_zero = add view_offset, view_len
    accessor_end_given_zero = add accessor_offset, required_given_zero
    byte_offset_given_zero = add view_offset, accessor_offset
    byte_end_given_zero = add byte_offset_given_zero, required_given_zero
    accessor_in_view_given_zero = sle accessor_end_given_zero, view_len
    view_in_buffer_given_zero = sle view_end_given_zero, buffer_len
    bytes_in_buffer_given_zero = sle byte_end_given_zero, buffer_len
    bounds_a_given_zero = and accessor_in_view_given_zero, view_in_buffer_given_zero
    bounds_ok_given_zero = and bounds_a_given_zero, bytes_in_buffer_given_zero
    br bounds_ok_given_zero -> L_OK_GIVEN_ZERO, L_MALFORMED_GIVEN_ZERO

L_BOUNDS_GIVEN_COUNT:
    view_end_given = add view_offset, view_len
    accessor_end_given = add accessor_offset, required_given
    byte_offset_given = add view_offset, accessor_offset
    byte_end_given = add byte_offset_given, required_given
    accessor_in_view_given = sle accessor_end_given, view_len
    view_in_buffer_given = sle view_end_given, buffer_len
    bytes_in_buffer_given = sle byte_end_given, buffer_len
    bounds_a_given = and accessor_in_view_given, view_in_buffer_given
    bounds_ok_given = and bounds_a_given, bytes_in_buffer_given
    br bounds_ok_given -> L_OK_GIVEN, L_MALFORMED_GIVEN

L_OK_GIVEN_ZERO:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset, byte_offset_given_zero as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_len, required_given_zero as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride, stride_given_final as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size, element_size as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK as i32
    !layout
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    return SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK

L_OK_GIVEN:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset, byte_offset_given as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_len, required_given as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride, stride_given_final2 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size, element_size as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK as i32
    !layout
    !accessor_format
    !accessor_count
