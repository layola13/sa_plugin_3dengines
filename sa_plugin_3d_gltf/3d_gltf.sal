@sa3d_gltf_index_materialize_output_format(index_format: i32) -> i32:
L_ENTRY:
    is_u32 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_u32 -> L_U32, L_U16_CHECK

L_U32:
    !is_u32
    !index_format
    return SA3D_GLTF_INDEX_FORMAT_U32

L_U16_CHECK:
    is_u16 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U16
    is_u8 = eq index_format, SA3D_GLTF_INDEX_FORMAT_U8
    small = or is_u16, is_u8
    br small -> L_U16, L_UNSUPPORTED

L_U16:
    !small
    !is_u8
    !is_u16
    !is_u32
    !index_format
    return SA3D_GLTF_INDEX_FORMAT_U16

L_UNSUPPORTED:
    !small
    !is_u8
    !is_u16
    !is_u32
    !index_format
    return 0

@sa3d_gltf_index_materialize_output_stride(index_format: i32) -> i64:
L_ENTRY:
    out_format = call @sa3d_gltf_index_materialize_output_format(index_format)
    is_u16 = eq out_format, SA3D_GLTF_INDEX_FORMAT_U16
    br is_u16 -> L_U16, L_U32_CHECK

L_U16:
    !is_u16
    !out_format
    !index_format
    return 2

L_U32_CHECK:
    is_u32 = eq out_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_u32 -> L_U32, L_UNSUPPORTED

L_U32:
    !is_u32
    !is_u16
    !out_format
    !index_format
    return 4

L_UNSUPPORTED:
    !is_u32
    !is_u16
    !out_format
    !index_format
    return 0

@sa3d_gltf_index_accessor_materialize(buffer: ptr, buffer_len: i64, view_offset: i64, view_len: i64, view_stride: i64, accessor_offset: i64, accessor_count: i64, index_format: i32, dst: ptr, cap: i64, &out_len: ptr, &out_index_format: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    store out_index_format+0, 0 as i32
    scan = stack_alloc SA3D_GLTF_INDEX_SCAN_RESULT_SIZE
    scan_status = call @sa3d_gltf_index_accessor_scan(buffer, buffer_len, view_offset, view_len, view_stride, accessor_offset, accessor_count, index_format, &scan)
    scan_ok = eq scan_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK
    br scan_ok -> L_OUTPUT_FORMAT, L_SCAN_ERROR

L_OUTPUT_FORMAT:
    output_format = call @sa3d_gltf_index_materialize_output_format(index_format)
    output_stride = call @sa3d_gltf_index_materialize_output_stride(index_format)
    output_ok = ne output_stride, 0
    br output_ok -> L_PTR_CHECK, L_UNSUPPORTED

L_PTR_CHECK:
    cap_nonnegative = sge cap, 0
    dst_present = ne dst, 0
    ptr_ok = and cap_nonnegative, dst_present
    br ptr_ok -> L_CAP_CHECK, L_MALFORMED_PTR

L_CAP_CHECK:
    count = load scan+SA3D_GLTF_INDEX_SCAN_RESULT_count as i64
    required = mul count, output_stride
    cap_ok = sge cap, required
    br cap_ok -> L_LOOP_SELECT, L_OUTPUT_SMALL

L_LOOP_SELECT:
    store out_index_format+0, output_format as i32
    byte_offset = load scan+SA3D_GLTF_INDEX_SCAN_RESULT_byte_offset as i64
    stride = load scan+SA3D_GLTF_INDEX_SCAN_RESULT_stride as i64
    is_output_u32 = eq output_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_output_u32 -> L_U32_LOOP_INIT, L_U16_LOOP_INIT

L_U16_LOOP_INIT:
    idx16_slot = stack_alloc 8
    store idx16_slot+0, 0 as i64
    jmp L_U16_LOOP_HEAD

L_U16_LOOP_HEAD:
    idx16 = load idx16_slot+0 as i64
    done16 = sge idx16, count
    br done16 -> L_DONE_U16, L_U16_LOOP_BODY

L_U16_LOOP_BODY:
    src16_step = mul idx16, stride
    src16_pos = add byte_offset, src16_step
    dst16_step = mul idx16, 2
    dst16_ptr = ptr_add dst, dst16_step
    value16 = call @sa3d_gltf_index_read_value(buffer, src16_pos, index_format)
    store dst16_ptr+0, value16 as u16
    next16 = add idx16, 1
    store idx16_slot+0, next16 as i64
    !next16
    !value16
    !dst16_ptr
    !dst16_step
    !src16_pos
    !src16_step
    !done16
    !idx16
    jmp L_U16_LOOP_HEAD

L_DONE_U16:
    store out_len+0, required as i64
    !done16
    !idx16
    !is_output_u32
    !stride
    !byte_offset
    !cap_ok
    !required
    !count
    !ptr_ok
    !dst_present
    !cap_nonnegative
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK

L_U32_LOOP_INIT:
    idx32_slot = stack_alloc 8
    store idx32_slot+0, 0 as i64
    jmp L_U32_LOOP_HEAD

L_U32_LOOP_HEAD:
    idx32 = load idx32_slot+0 as i64
    done32 = sge idx32, count
    br done32 -> L_DONE_U32, L_U32_LOOP_BODY

L_U32_LOOP_BODY:
    src32_step = mul idx32, stride
    src32_pos = add byte_offset, src32_step
    dst32_step = mul idx32, 4
    dst32_ptr = ptr_add dst, dst32_step
    value32 = call @sa3d_gltf_index_read_value(buffer, src32_pos, index_format)
    store dst32_ptr+0, value32 as u32
    next32 = add idx32, 1
    store idx32_slot+0, next32 as i64
    !next32
    !value32
    !dst32_ptr
    !dst32_step
    !src32_pos
    !src32_step
    !done32
    !idx32
    jmp L_U32_LOOP_HEAD

L_DONE_U32:
    store out_len+0, required as i64
    !done32
    !idx32
    !is_output_u32
    !stride
    !byte_offset
    !cap_ok
    !required
    !count
    !ptr_ok
    !dst_present
    !cap_nonnegative
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK

L_SCAN_ERROR:
    unsupported_scan = eq scan_status, SA3D_GLTF_INDEX_SCAN_STATUS_UNSUPPORTED_FORMAT
    br unsupported_scan -> L_SCAN_UNSUPPORTED, L_SCAN_MALFORMED

L_SCAN_UNSUPPORTED:
    !unsupported_scan
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_SCAN_MALFORMED:
    !unsupported_scan
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_MALFORMED_DATA

L_UNSUPPORTED:
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_PTR:
    !ptr_ok
    !dst_present
    !cap_nonnegative
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_MALFORMED_DATA

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !count
    !ptr_ok
    !dst_present
    !cap_nonnegative
    !output_ok
    !output_stride
    !output_format
    !scan_ok
    !scan_status
    !out_index_format
    !out_len
    !cap
    !dst
    !index_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !buffer_len
    !buffer
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OUTPUT_TOO_SMALL

@sa3d_gltf_f32_attribute_format_supported(accessor_format: i32) -> i32:
L_ENTRY:
    f32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X2
    f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    a = or f32x2, f32x3
    ok = or a, f32x4
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !a
    !f32x4
    !f32x3
    !f32x2
    !accessor_format
    return 1

L_FALSE:
    !ok
    !a
    !f32x4
    !f32x3
    !f32x2
    !accessor_format
    return 0

@sa3d_gltf_f32_attribute_copy_element(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64, accessor_format: i32, convert_coordinates: i32) -> void:
L_ENTRY:
    is_x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X2
    br is_x2 -> L_X2, L_X3_CHECK

L_X2:
    src0 = ptr_add buffer, src_pos
    src1_pos = add src_pos, 4
    src1 = ptr_add buffer, src1_pos
    dst0 = ptr_add dst, dst_pos
    dst1_pos = add dst_pos, 4
    dst1 = ptr_add dst, dst1_pos
    x = load src0+0 as i32
    y = load src1+0 as i32
    store dst0+0, x as i32
    store dst1+0, y as i32
    !y
    !x
    !dst1
    !dst1_pos
    !dst0
    !src1
    !src1_pos
    !src0
    !is_x2
    !convert_coordinates
    !accessor_format
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_X3_CHECK:
    is_x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    br is_x3 -> L_X3_LOAD, L_X4

L_X3_LOAD:
    src30 = ptr_add buffer, src_pos
    src31_pos = add src_pos, 4
    src31 = ptr_add buffer, src31_pos
    src32_pos = add src_pos, 8
    src32 = ptr_add buffer, src32_pos
    dst30 = ptr_add dst, dst_pos
    dst31_pos = add dst_pos, 4
    dst31 = ptr_add dst, dst31_pos
    dst32_pos = add dst_pos, 8
    dst32 = ptr_add dst, dst32_pos
    x3 = load src30+0 as i32
    y3 = load src31+0 as i32
    z3 = load src32+0 as i32
    do_convert3 = ne convert_coordinates, 0
    br do_convert3 -> L_X3_CONVERT, L_X3_STORE

L_X3_CONVERT:
    out_x3 = xor x3, -2147483648
    out_z3 = xor z3, -2147483648
    store dst30+0, out_x3 as i32
    store dst31+0, y3 as i32
    store dst32+0, out_z3 as i32
    !out_z3
    !out_x3
    !do_convert3
    !z3
    !y3
    !x3
    !dst32
    !dst32_pos
    !dst31
    !dst31_pos
    !dst30
    !src32
    !src32_pos
    !src31
    !src31_pos
    !src30
    !is_x3
    !is_x2
    !accessor_format
    !convert_coordinates
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_X3_STORE:
    store dst30+0, x3 as i32
    store dst31+0, y3 as i32
    store dst32+0, z3 as i32
    !do_convert3
    !z3
    !y3
    !x3
    !dst32
    !dst32_pos
    !dst31
    !dst31_pos
    !dst30
    !src32
    !src32_pos
    !src31
    !src31_pos
    !src30
    !is_x3
    !is_x2
    !accessor_format
    !convert_coordinates
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_X4:
    src40 = ptr_add buffer, src_pos
    src41_pos = add src_pos, 4
    src41 = ptr_add buffer, src41_pos
    src42_pos = add src_pos, 8
    src42 = ptr_add buffer, src42_pos
    src43_pos = add src_pos, 12
    src43 = ptr_add buffer, src43_pos
    dst40 = ptr_add dst, dst_pos
    dst41_pos = add dst_pos, 4
    dst41 = ptr_add dst, dst41_pos
    dst42_pos = add dst_pos, 8
    dst42 = ptr_add dst, dst42_pos
    dst43_pos = add dst_pos, 12
    dst43 = ptr_add dst, dst43_pos
    x4 = load src40+0 as i32
    y4 = load src41+0 as i32
    z4 = load src42+0 as i32
    w4 = load src43+0 as i32
    do_convert4 = ne convert_coordinates, 0
    br do_convert4 -> L_X4_CONVERT, L_X4_STORE

L_X4_CONVERT:
    out_x4 = xor x4, -2147483648
    out_z4 = xor z4, -2147483648
    store dst40+0, out_x4 as i32
    store dst41+0, y4 as i32
    store dst42+0, out_z4 as i32
    store dst43+0, w4 as i32
    !out_z4
    !out_x4
    !do_convert4
    !w4
    !z4
    !y4
    !x4
    !dst43
    !dst43_pos
    !dst42
    !dst42_pos
    !dst41
    !dst41_pos
    !dst40
    !src43
    !src43_pos
    !src42
    !src42_pos
    !src41
    !src41_pos
    !src40
    !is_x3
    !is_x2
    !accessor_format
    !convert_coordinates
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_X4_STORE:
    store dst40+0, x4 as i32
    store dst41+0, y4 as i32
    store dst42+0, z4 as i32
    store dst43+0, w4 as i32
    !do_convert4
    !w4
    !z4
    !y4
    !x4
    !dst43
    !dst43_pos
    !dst42
    !dst42_pos
    !dst41
    !dst41_pos
    !dst40
    !src43
    !src43_pos
    !src42
    !src42_pos
    !src41
    !src41_pos
    !src40
    !is_x3
    !is_x2
    !accessor_format
    !convert_coordinates
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_f32_attribute_materialize(buffer: ptr, accessor_count: i64, accessor_format: i32, convert_coordinates: i32, &layout: ptr, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    format_ok_raw = call @sa3d_gltf_f32_attribute_format_supported(accessor_format)
    format_ok = ne format_ok_raw, 0
    br format_ok -> L_LAYOUT_CHECK, L_UNSUPPORTED

L_LAYOUT_CHECK:
    layout_status = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_status as i32
    layout_ok = eq layout_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    br layout_ok -> L_PTR_CHECK, L_MALFORMED_LAYOUT

L_PTR_CHECK:
    count_nonnegative = sge accessor_count, 0
    cap_nonnegative = sge cap, 0
    nonnegative = and count_nonnegative, cap_nonnegative
    buffer_present = ne buffer, 0
    dst_present = ne dst, 0
    ptrs = and buffer_present, dst_present
    ok0 = and nonnegative, ptrs
    br ok0 -> L_SIZE_CHECK, L_MALFORMED_PTR

L_SIZE_CHECK:
    element_size = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size as i64
    expected_size = call @sa3d_gltf_accessor_format_byte_size(accessor_format)
    size_ok = eq element_size, expected_size
    br size_ok -> L_CAP_CHECK, L_MALFORMED_SIZE

L_CAP_CHECK:
    required = mul accessor_count, element_size
    cap_ok = sge cap, required
    br cap_ok -> L_LOOP_INIT, L_OUTPUT_SMALL

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    byte_offset = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset as i64
    stride = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride as i64
    store idx_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, accessor_count
    br done -> L_DONE, L_LOOP_BODY

L_LOOP_BODY:
    src_step = mul idx, stride
    src_pos = add byte_offset, src_step
    dst_pos = mul idx, element_size
    call @sa3d_gltf_f32_attribute_copy_element(buffer, src_pos, dst, dst_pos, accessor_format, convert_coordinates)
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !dst_pos
    !src_pos
    !src_step
    !done
    !idx
    jmp L_LOOP_HEAD

L_DONE:
    store out_len+0, required as i64
    !done
    !idx
    !stride
    !byte_offset
    !required
    !cap_ok
    !element_size
    !expected_size
    !size_ok
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !format_ok_raw
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_UNSUPPORTED:
    !format_ok
    !format_ok_raw
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_LAYOUT:
    !layout_ok
    !layout_status
    !format_ok
    !format_ok_raw
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

L_MALFORMED_PTR:
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !format_ok_raw
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

L_MALFORMED_SIZE:
    !size_ok
    !expected_size
    !element_size
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !format_ok_raw
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
