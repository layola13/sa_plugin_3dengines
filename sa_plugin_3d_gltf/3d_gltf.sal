    store out+0, bits as i32
    !bits
    !out
    !src
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_store_unorm8_f32_component(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64) -> void:
L_ENTRY:
