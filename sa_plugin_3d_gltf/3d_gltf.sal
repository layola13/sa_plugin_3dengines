@sa3d_gltf_json_mesh_parse(bytes: ptr, len: i64, mesh_index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_mesh_table_clear(&out)
    store out+SA3D_GLTF_MESH_TABLE_index, mesh_index as i64
    mesh_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MESHES, 6, mesh_index)
    missing = eq mesh_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq mesh_pos, -2
    br malformed -> L_MALFORMED, L_NAME

L_NAME:
    name_status = call @sa3d_gltf_json_mesh_store_name(bytes, len, mesh_pos, &out)
    name_ok = eq name_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br name_ok -> L_PRIMITIVES, L_RETURN_NAME

L_PRIMITIVES:
    primitive_status = call @sa3d_gltf_json_mesh_store_primitives(bytes, len, mesh_pos, &out)
    primitive_ok = eq primitive_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br primitive_ok -> L_WEIGHTS, L_RETURN_PRIMITIVES

L_WEIGHTS:
    weight_status = call @sa3d_gltf_json_mesh_store_weights(bytes, len, mesh_pos, &out)
    weight_ok = eq weight_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br weight_ok -> L_EXTRAS, L_RETURN_WEIGHTS

L_EXTRAS:
    extras_status = call @sa3d_gltf_json_mesh_store_extras(bytes, len, mesh_pos, &out)
    extras_ok = eq extras_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br extras_ok -> L_OK, L_RETURN_EXTRAS

L_OK:
    store out+SA3D_GLTF_MESH_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !extras_ok
    !extras_status
    !weight_ok
    !weight_status
    !primitive_ok
    !primitive_status
    !name_ok
    !name_status
    !malformed
    !missing
    !mesh_pos
    !out
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_EXTRAS:
    store out+SA3D_GLTF_MESH_TABLE_status, extras_status as i32
    !extras_ok
    !weight_ok
    !weight_status
    !primitive_ok
    !primitive_status
    !name_ok
    !name_status
    !malformed
    !missing
    !mesh_pos
    !out
    !mesh_index
    !len
    !bytes
    return extras_status

L_RETURN_WEIGHTS:
    store out+SA3D_GLTF_MESH_TABLE_status, weight_status as i32
    !weight_ok
    !primitive_ok
    !primitive_status
    !name_ok
    !name_status
    !malformed
    !missing
    !mesh_pos
    !out
    !mesh_index
    !len
    !bytes
    return weight_status

L_RETURN_PRIMITIVES:
    store out+SA3D_GLTF_MESH_TABLE_status, primitive_status as i32
    !primitive_ok
    !name_ok
    !name_status
    !malformed
    !missing
    !mesh_pos
    !out
    !mesh_index
    !len
    !bytes
    return primitive_status

L_RETURN_NAME:
    store out+SA3D_GLTF_MESH_TABLE_status, name_status as i32
    !name_ok
    !malformed
    !missing
    !mesh_pos
    !out
    !mesh_index
    !len
    !bytes
    return name_status

L_MISSING:
    store out+SA3D_GLTF_MESH_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !mesh_pos
    !out
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_MESH_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !mesh_pos
    !out
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_mesh_morph_target_names_array_pos(bytes: ptr, len: i64, mesh_index: i64) -> i64:
L_ENTRY:
    mesh_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MESHES, 6, mesh_index)
    mesh_missing = eq mesh_pos, -1
    br mesh_missing -> L_MISSING_MESH, L_MESH_MALFORMED_CHECK

L_MESH_MALFORMED_CHECK:
    mesh_malformed = eq mesh_pos, -2
    br mesh_malformed -> L_BAD_MESH, L_EXTRAS

L_EXTRAS:
    extras_pos = call @sa3d_gltf_json_object_field_value(bytes, len, mesh_pos, &SA3D_GLTF_JSON_KEY_EXTRAS, 6)
    extras_missing = eq extras_pos, -1
    br extras_missing -> L_MISSING_EXTRAS, L_EXTRAS_MALFORMED_CHECK

L_EXTRAS_MALFORMED_CHECK:
    extras_malformed = eq extras_pos, -2
    br extras_malformed -> L_BAD_EXTRAS, L_TARGET_NAMES

L_TARGET_NAMES:
    names_pos = call @sa3d_gltf_json_object_field_value(bytes, len, extras_pos, &SA3D_GLTF_JSON_KEY_TARGET_NAMES, 11)
    names_missing = eq names_pos, -1
    br names_missing -> L_MISSING_NAMES, L_NAMES_MALFORMED_CHECK

L_NAMES_MALFORMED_CHECK:
    names_malformed = eq names_pos, -2
    br names_malformed -> L_BAD_NAMES, L_VALIDATE_ARRAY

L_VALIDATE_ARRAY:
    count = call @sa3d_gltf_json_count_array_items(bytes, len, names_pos)
    count_bad = slt count, 0
    br count_bad -> L_BAD_COUNT, L_RETURN_NAMES

L_RETURN_NAMES:
