    return mapped_index

L_SPARSE_VALUE_RESOLVE_ERROR:
    mapped_value = call @sa3d_gltf_json_resolve_status_to_index_materialize_status(sparse_value_resolve)
    !sparse_value_ok
    !sparse_value_resolve
    !sparse_value_offset
    !sparse_value_bv
