    value_offset = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_values_byte_offset as i64
    value_resolve = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, value_bv, buffer_index, buffer_len, value_offset, sparse_count, accessor_format, &value_view, &value_layout)
    value_resolve_ok = eq value_resolve, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br value_resolve_ok -> L_PATCH, L_VALUE_RESOLVE_ERROR

L_PATCH:
    patch_status = call @sa3d_gltf_vertex_attribute_patch_sparse(buffer, sparse_count, conversion, accessor_format, normalized, convert_coordinates, index_component, &index_layout, &value_layout, dst, output_element_size, output_count)
    !value_resolve_ok
    !value_resolve
    !value_offset
    !value_bv
    !index_resolve_ok
    !index_resolve
    !index_offset
    !index_bv
    !index_format_ok
    !index_format
    !index_component
    !empty
    !sparse_count
