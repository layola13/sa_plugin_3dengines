@sa3d_gltf_morph_target_attribute_accessor(&target: ptr, attribute: i32, &out_accessor: ptr) -> i32:
L_ENTRY:
    is_position = eq attribute, SA3D_GLTF_ATTRIBUTE_POSITION
    br is_position -> L_POSITION, L_NORMAL_CHECK

L_POSITION:
    has_position = load target+SA3D_GLTF_MORPH_TARGET_TABLE_has_position as i32
    present_position = ne has_position, 0
    br present_position -> L_POSITION_STORE, L_POSITION_MISSING

L_POSITION_STORE:
    position_accessor = load target+SA3D_GLTF_MORPH_TARGET_TABLE_position as i64
    store out_accessor+0, position_accessor as i64
    !position_accessor
    !present_position
    !has_position
    !is_position
    !out_accessor
    !attribute
    !target
    return 1

L_POSITION_MISSING:
    !present_position
    !has_position
    !is_position
    !out_accessor
    !attribute
    !target
    return 0

L_NORMAL_CHECK:
    is_normal = eq attribute, SA3D_GLTF_ATTRIBUTE_NORMAL
    br is_normal -> L_NORMAL, L_TANGENT_CHECK

L_NORMAL:
    has_normal = load target+SA3D_GLTF_MORPH_TARGET_TABLE_has_normal as i32
    present_normal = ne has_normal, 0
    br present_normal -> L_NORMAL_STORE, L_NORMAL_MISSING

L_NORMAL_STORE:
    normal_accessor = load target+SA3D_GLTF_MORPH_TARGET_TABLE_normal as i64
    store out_accessor+0, normal_accessor as i64
    !normal_accessor
    !present_normal
    !has_normal
    !is_normal
    !is_position
    !out_accessor
    !attribute
    !target
    return 1

L_NORMAL_MISSING:
    !present_normal
    !has_normal
    !is_normal
    !is_position
    !out_accessor
    !attribute
    !target
    return 0

L_TANGENT_CHECK:
    is_tangent = eq attribute, SA3D_GLTF_ATTRIBUTE_TANGENT
    br is_tangent -> L_TANGENT, L_UNKNOWN

L_TANGENT:
    has_tangent = load target+SA3D_GLTF_MORPH_TARGET_TABLE_has_tangent as i32
    present_tangent = ne has_tangent, 0
    br present_tangent -> L_TANGENT_STORE, L_TANGENT_MISSING

L_TANGENT_STORE:
    tangent_accessor = load target+SA3D_GLTF_MORPH_TARGET_TABLE_tangent as i64
    store out_accessor+0, tangent_accessor as i64
    !tangent_accessor
    !present_tangent
    !has_tangent
    !is_tangent
    !is_normal
    !is_position
    !out_accessor
    !attribute
    !target
    return 1

L_TANGENT_MISSING:
    !present_tangent
    !has_tangent
    !is_tangent
    !is_normal
    !is_position
    !out_accessor
    !attribute
    !target
    return 0

L_UNKNOWN:
    !is_tangent
    !is_normal
    !is_position
    !out_accessor
    !attribute
    !target
    return 0

@sa3d_gltf_json_morph_target_attribute_materialize(bytes: ptr, len: i64, mesh_index: i64, primitive_index: i64, target_index: i64, attribute: i32, buffer_index: i64, buffer: ptr, buffer_len: i64, convert_coordinates: i32, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    target = stack_alloc SA3D_GLTF_MORPH_TARGET_TABLE_SIZE
    accessor = stack_alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    accessor_slot = stack_alloc 8
    store out_len+0, 0 as i64
    target_status = call @sa3d_gltf_json_primitive_morph_target_parse(bytes, len, mesh_index, primitive_index, target_index, &target)
    target_ok = eq target_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br target_ok -> L_ACCESSOR_SELECT, L_TARGET_STATUS_MAP

L_ACCESSOR_SELECT:
    has_accessor = call @sa3d_gltf_morph_target_attribute_accessor(&target, attribute, &accessor_slot)
    accessor_present = ne has_accessor, 0
    br accessor_present -> L_ACCESSOR_PARSE, L_OK_MISSING_ATTRIBUTE

L_ACCESSOR_PARSE:
    accessor_index = load accessor_slot+0 as i64
    accessor_status = call @sa3d_gltf_json_accessor_parse(bytes, len, accessor_index, &accessor)
    accessor_ok = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_ok -> L_FORMAT_CHECK, L_ACCESSOR_STATUS_MAP

L_FORMAT_CHECK:
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    is_f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    br is_f32x3 -> L_MATERIALIZE, L_UNSUPPORTED_FORMAT

L_MATERIALIZE:
    status = call @sa3d_gltf_json_vertex_attribute_materialize(bytes, len, accessor_index, buffer_index, buffer, buffer_len, SA3D_GLTF_CONVERSION_ANY, convert_coordinates, dst, cap, &out_len)
    !is_f32x3
    !accessor_format
    !accessor_ok
    !accessor_status
    !accessor_index
    !accessor_present
    !has_accessor
    !target_ok
    !target_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !attribute
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return status

L_OK_MISSING_ATTRIBUTE:
    !accessor_present
    !has_accessor
    !target_ok
    !target_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !attribute
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_UNSUPPORTED_FORMAT:
    !is_f32x3
    !accessor_format
    !accessor_ok
    !accessor_status
    !accessor_index
    !accessor_present
    !has_accessor
    !target_ok
    !target_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !attribute
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_ACCESSOR_STATUS_MAP:
    accessor_unsupported = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br accessor_unsupported -> L_ACCESSOR_UNSUPPORTED, L_ACCESSOR_MALFORMED

L_ACCESSOR_UNSUPPORTED:
    !accessor_unsupported
    !accessor_ok
    !accessor_index
    !accessor_present
    !has_accessor
    !target_ok
    !target_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !attribute
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_ACCESSOR_MALFORMED:
    !accessor_unsupported
    !accessor_ok
    !accessor_status
    !accessor_index
    !accessor_present
    !has_accessor
    !target_ok
    !target_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !attribute
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

L_TARGET_STATUS_MAP:
    target_unsupported = eq target_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br target_unsupported -> L_TARGET_UNSUPPORTED, L_TARGET_MALFORMED

L_TARGET_UNSUPPORTED:
    !target_unsupported
    !target_ok
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !attribute
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_TARGET_MALFORMED:
    !target_unsupported
    !target_ok
    !target_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !attribute
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

@sa3d_gltf_i64_max(a: i64, b: i64) -> i64:
L_ENTRY:
    b_gt = sgt b, a
    br b_gt -> L_B, L_A

L_B:
    !b_gt
    !a
    return b

L_A:
    !b_gt
    !b
    return a

@sa3d_gltf_morph_attributes_store_vec3(src: ptr, src_count: i64, idx: i64, dst: ptr, dst_base: i64, field_offset: i64) -> void:
L_ENTRY:
    has_value = slt idx, src_count
    br has_value -> L_COPY, L_ZERO

L_COPY:
    src_base = mul idx, 12
    src0 = ptr_add src, src_base
    src1_pos = add src_base, 4
    src1 = ptr_add src, src1_pos
    src2_pos = add src_base, 8
    src2 = ptr_add src, src2_pos
    dst_field = add dst_base, field_offset
    dst0 = ptr_add dst, dst_field
    dst1_pos = add dst_field, 4
    dst1 = ptr_add dst, dst1_pos
    dst2_pos = add dst_field, 8
    dst2 = ptr_add dst, dst2_pos
    v0 = load src0+0 as i32
    v1 = load src1+0 as i32
    v2 = load src2+0 as i32
    store dst0+0, v0 as i32
    store dst1+0, v1 as i32
    store dst2+0, v2 as i32
    !v2
    !v1
    !v0
    !dst2
    !dst2_pos
    !dst1
    !dst1_pos
    !dst0
    !dst_field
    !src2
    !src2_pos
    !src1
    !src1_pos
    !src0
    !src_base
    !has_value
    !field_offset
    !dst_base
    !dst
    !idx
    !src_count
    !src
    return

L_ZERO:
    dst_field_z = add dst_base, field_offset
    dst0z = ptr_add dst, dst_field_z
    dst1z_pos = add dst_field_z, 4
    dst1z = ptr_add dst, dst1z_pos
    dst2z_pos = add dst_field_z, 8
    dst2z = ptr_add dst, dst2z_pos
    store dst0z+0, 0.0 as f32
    store dst1z+0, 0.0 as f32
    store dst2z+0, 0.0 as f32
    !dst2z
    !dst2z_pos
    !dst1z
    !dst1z_pos
    !dst0z
    !dst_field_z
    !has_value
    !field_offset
    !dst_base
    !dst
    !idx
    !src_count
    !src
    return

@sa3d_gltf_morph_attributes_interleave(position_src: ptr, position_count: i64, normal_src: ptr, normal_count: i64, tangent_src: ptr, tangent_count: i64, output_count: i64, dst: ptr) -> void:
L_ENTRY:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, output_count
    br done -> L_DONE, L_BODY

L_BODY:
    dst_base = mul idx, SA3D_GLTF_MORPH_ATTRIBUTES_SIZE
    call @sa3d_gltf_morph_attributes_store_vec3(position_src, position_count, idx, dst, dst_base, SA3D_GLTF_MORPH_ATTRIBUTES_position)
    pad_a_pos = add dst_base, SA3D_GLTF_MORPH_ATTRIBUTES_pad_a
    pad_a = ptr_add dst, pad_a_pos
    store pad_a+0, 0.0 as f32
    call @sa3d_gltf_morph_attributes_store_vec3(normal_src, normal_count, idx, dst, dst_base, SA3D_GLTF_MORPH_ATTRIBUTES_normal)
    pad_b_pos = add dst_base, SA3D_GLTF_MORPH_ATTRIBUTES_pad_b
    pad_b = ptr_add dst, pad_b_pos
    store pad_b+0, 0.0 as f32
    call @sa3d_gltf_morph_attributes_store_vec3(tangent_src, tangent_count, idx, dst, dst_base, SA3D_GLTF_MORPH_ATTRIBUTES_tangent)
    pad_c_pos = add dst_base, SA3D_GLTF_MORPH_ATTRIBUTES_pad_c
    pad_c = ptr_add dst, pad_c_pos
    store pad_c+0, 0.0 as f32
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !pad_c
    !pad_c_pos
    !pad_b
    !pad_b_pos
    !pad_a
    !pad_a_pos
    !dst_base
    !done
    !idx
    jmp L_HEAD

L_DONE:
    !done
    !idx
    !dst
    !output_count
    !tangent_count
    !tangent_src
    !normal_count
    !normal_src
    !position_count
    !position_src
    return

@sa3d_gltf_json_morph_target_attributes_materialize(bytes: ptr, len: i64, mesh_index: i64, primitive_index: i64, target_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, convert_coordinates: i32, position_tmp: ptr, normal_tmp: ptr, tangent_tmp: ptr, tmp_cap: i64, dst: ptr, cap: i64, &out_len: ptr, &out_count: ptr) -> i32:
L_ENTRY:
    position_len_slot = stack_alloc 8
    normal_len_slot = stack_alloc 8
    tangent_len_slot = stack_alloc 8
    store out_len+0, 0 as i64
    store out_count+0, 0 as i64
    position_status = call @sa3d_gltf_json_morph_target_attribute_materialize(bytes, len, mesh_index, primitive_index, target_index, SA3D_GLTF_ATTRIBUTE_POSITION, buffer_index, buffer, buffer_len, convert_coordinates, position_tmp, tmp_cap, &position_len_slot)
    position_ok = eq position_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    br position_ok -> L_NORMAL, L_RETURN_POSITION_STATUS

L_NORMAL:
    normal_status = call @sa3d_gltf_json_morph_target_attribute_materialize(bytes, len, mesh_index, primitive_index, target_index, SA3D_GLTF_ATTRIBUTE_NORMAL, buffer_index, buffer, buffer_len, convert_coordinates, normal_tmp, tmp_cap, &normal_len_slot)
    normal_ok = eq normal_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    br normal_ok -> L_TANGENT, L_RETURN_NORMAL_STATUS

L_TANGENT:
    tangent_status = call @sa3d_gltf_json_morph_target_attribute_materialize(bytes, len, mesh_index, primitive_index, target_index, SA3D_GLTF_ATTRIBUTE_TANGENT, buffer_index, buffer, buffer_len, convert_coordinates, tangent_tmp, tmp_cap, &tangent_len_slot)
    tangent_ok = eq tangent_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    br tangent_ok -> L_COUNTS, L_RETURN_TANGENT_STATUS

L_COUNTS:
    position_len = load position_len_slot+0 as i64
    normal_len = load normal_len_slot+0 as i64
    tangent_len = load tangent_len_slot+0 as i64
    position_count = sdiv position_len, 12
    normal_count = sdiv normal_len, 12
    tangent_count = sdiv tangent_len, 12
    max_pos_norm = call @sa3d_gltf_i64_max(position_count, normal_count)
    output_count = call @sa3d_gltf_i64_max(max_pos_norm, tangent_count)
    empty = eq output_count, 0
    br empty -> L_OK_EMPTY, L_CAP_CHECK

L_CAP_CHECK:
    required = mul output_count, SA3D_GLTF_MORPH_ATTRIBUTES_SIZE
    dst_present = ne dst, 0
    cap_ok = sge cap, required
    cap_and_ptr = and dst_present, cap_ok
    br cap_and_ptr -> L_INTERLEAVE, L_OUTPUT_SMALL

L_INTERLEAVE:
    call @sa3d_gltf_morph_attributes_interleave(position_tmp, position_count, normal_tmp, normal_count, tangent_tmp, tangent_count, output_count, dst)
    store out_len+0, required as i64
    store out_count+0, output_count as i64
    !cap_and_ptr
    !cap_ok
    !dst_present
    !required
    !empty
    !output_count
    !max_pos_norm
    !tangent_count
    !normal_count
    !position_count
    !tangent_len
    !normal_len
    !position_len
    !tangent_ok
    !tangent_status
    !normal_ok
    !normal_status
    !position_ok
    !position_status
    !out_count
    !out_len
    !cap
    !dst
    !tmp_cap
    !tangent_tmp
    !normal_tmp
    !position_tmp
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_OK_EMPTY:
    !empty
    !output_count
    !max_pos_norm
    !tangent_count
    !normal_count
    !position_count
    !tangent_len
    !normal_len
    !position_len
    !tangent_ok
    !tangent_status
    !normal_ok
    !normal_status
    !position_ok
    !position_status
    !out_count
    !out_len
    !cap
    !dst
    !tmp_cap
    !tangent_tmp
    !normal_tmp
    !position_tmp
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK

L_OUTPUT_SMALL:
    store out_len+0, required as i64
    store out_count+0, output_count as i64
    !cap_and_ptr
    !cap_ok
    !dst_present
    !required
    !empty
    !output_count
    !max_pos_norm
    !tangent_count
    !normal_count
    !position_count
    !tangent_len
    !normal_len
    !position_len
    !tangent_ok
    !tangent_status
    !normal_ok
    !normal_status
    !position_ok
    !position_status
    !out_count
    !out_len
    !cap
    !dst
    !tmp_cap
    !tangent_tmp
    !normal_tmp
    !position_tmp
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OUTPUT_TOO_SMALL

L_RETURN_TANGENT_STATUS:
    !tangent_ok
    !normal_ok
    !normal_status
    !position_ok
    !position_status
    !out_count
    !out_len
    !cap
    !dst
    !tmp_cap
    !tangent_tmp
    !normal_tmp
    !position_tmp
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return tangent_status

L_RETURN_NORMAL_STATUS:
    !normal_ok
    !position_ok
    !position_status
    !out_count
    !out_len
    !cap
    !dst
    !tmp_cap
    !tangent_tmp
    !normal_tmp
    !position_tmp
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return normal_status

L_RETURN_POSITION_STATUS:
    !position_ok
    !out_count
    !out_len
    !cap
    !dst
    !tmp_cap
    !tangent_tmp
    !normal_tmp
    !position_tmp
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return position_status

@sa3d_gltf_json_mesh_primitive_object_start(bytes: ptr, len: i64, mesh_index: i64, primitive_index: i64) -> i64:
L_ENTRY:
    mesh_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MESHES, 6, mesh_index)
    mesh_missing = eq mesh_pos, -1
    br mesh_missing -> L_MISSING_MESH, L_MESH_MALFORMED_CHECK

L_MESH_MALFORMED_CHECK:
    mesh_malformed = eq mesh_pos, -2
    br mesh_malformed -> L_MALFORMED_MESH, L_PRIMITIVES_FIELD

L_PRIMITIVES_FIELD:
    primitives_pos = call @sa3d_gltf_json_object_field_value(bytes, len, mesh_pos, &SA3D_GLTF_JSON_KEY_PRIMITIVES, 10)
    primitives_missing = eq primitives_pos, -1
    br primitives_missing -> L_MISSING_PRIMITIVES, L_PRIMITIVES_MALFORMED_CHECK

L_PRIMITIVES_MALFORMED_CHECK:
    primitives_malformed = eq primitives_pos, -2
    br primitives_malformed -> L_MALFORMED_PRIMITIVES, L_PRIMITIVE_ITEM

L_PRIMITIVE_ITEM:
    primitive_pos = call @sa3d_gltf_json_array_item_start(bytes, len, primitives_pos, primitive_index)
    primitive_missing = eq primitive_pos, -1
    br primitive_missing -> L_MISSING_PRIMITIVE, L_PRIMITIVE_MALFORMED_CHECK

L_PRIMITIVE_MALFORMED_CHECK:
    primitive_malformed = eq primitive_pos, -2
    br primitive_malformed -> L_MALFORMED_PRIMITIVE, L_OK

L_OK:
    !primitive_malformed
    !primitive_missing
    !primitives_malformed
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return primitive_pos

L_MISSING_PRIMITIVE:
    !primitive_missing
    !primitive_pos
    !primitives_malformed
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -1

L_MALFORMED_PRIMITIVE:
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !primitives_malformed
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -2

L_MISSING_PRIMITIVES:
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -1

L_MALFORMED_PRIMITIVES:
    !primitives_malformed
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -2

L_MISSING_MESH:
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -1

L_MALFORMED_MESH:
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -2

@sa3d_gltf_json_primitive_parse(bytes: ptr, len: i64, mesh_index: i64, primitive_index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_json_primitive_table_clear(&out)
    mode_slot = stack_alloc 8
    indices_slot = stack_alloc 8
    material_slot = stack_alloc 8
    primitive_pos = call @sa3d_gltf_json_mesh_primitive_object_start(bytes, len, mesh_index, primitive_index)
    primitive_missing = eq primitive_pos, -1
    br primitive_missing -> L_MISSING_PRIMITIVE, L_PRIMITIVE_MALFORMED_CHECK

L_PRIMITIVE_MALFORMED_CHECK:
    primitive_malformed = eq primitive_pos, -2
    br primitive_malformed -> L_MALFORMED_PRIMITIVE, L_MODE

L_MODE:
    mode_status = call @sa3d_gltf_json_object_i64_value(bytes, len, primitive_pos, &SA3D_GLTF_JSON_KEY_MODE, 4, &mode_slot)
    mode_bad = slt mode_status, 0
    br mode_bad -> L_BAD_MODE, L_MODE_MISSING_CHECK

L_MODE_MISSING_CHECK:
    mode_missing = eq mode_status, 0
    br mode_missing -> L_MODE_DEFAULT, L_MODE_FOUND

L_MODE_DEFAULT:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_mode, SA3D_GLTF_MODE_TRIANGLES as i32
    !mode_missing
    !mode_bad
    !mode_status
    jmp L_INDICES

L_MODE_FOUND:
    mode_value = load mode_slot+0 as i64
    mode_i32 = trunc mode_value as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_mode, mode_i32 as i32
    !mode_i32
    !mode_value
    !mode_missing
    !mode_bad
    !mode_status
    jmp L_INDICES

L_INDICES:
    indices_status = call @sa3d_gltf_json_object_i64_value(bytes, len, primitive_pos, &SA3D_GLTF_JSON_KEY_INDICES, 7, &indices_slot)
    indices_bad = slt indices_status, 0
    br indices_bad -> L_BAD_INDICES, L_INDICES_MISSING_CHECK

L_INDICES_MISSING_CHECK:
    indices_missing = eq indices_status, 0
    br indices_missing -> L_INDICES_DONE_MISSING, L_INDICES_FOUND

L_INDICES_DONE_MISSING:
    !indices_missing
    !indices_bad
    !indices_status
    jmp L_MATERIAL

L_INDICES_FOUND:
    indices_value = load indices_slot+0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_has_indices, 1 as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_indices, indices_value as i64
    !indices_value
    !indices_missing
    !indices_bad
    !indices_status
    jmp L_MATERIAL

L_MATERIAL:
    material_status = call @sa3d_gltf_json_object_i64_value(bytes, len, primitive_pos, &SA3D_GLTF_JSON_KEY_MATERIAL, 8, &material_slot)
    material_bad = slt material_status, 0
    br material_bad -> L_BAD_MATERIAL, L_MATERIAL_MISSING_CHECK

L_MATERIAL_MISSING_CHECK:
    material_missing = eq material_status, 0
    br material_missing -> L_MATERIAL_DONE_MISSING, L_MATERIAL_FOUND

L_MATERIAL_DONE_MISSING:
    !material_missing
    !material_bad
    !material_status
    jmp L_ATTRIBUTES

L_MATERIAL_FOUND:
    material_value = load material_slot+0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_has_material, 1 as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_material, material_value as i64
    !material_value
    !material_missing
    !material_bad
    !material_status
    jmp L_ATTRIBUTES

L_ATTRIBUTES:
    attrs = ptr_add out, SA3D_GLTF_PRIMITIVE_TABLE_attributes
    attr_status = call @sa3d_gltf_json_primitive_attr_table_parse(bytes, len, primitive_pos, &attrs)
    attr_ok = eq attr_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br attr_ok -> L_TARGETS, L_BAD_ATTRIBUTES

L_TARGETS:
    target_status = call @sa3d_gltf_json_primitive_store_targets(bytes, len, primitive_pos, &out)
    target_ok = eq target_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br target_ok -> L_OK, L_BAD_TARGETS

L_OK:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !target_ok
    !target_status
    !attr_ok
    !attr_status
    !attrs
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_TARGETS:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, target_status as i32
    !target_ok
    !attr_ok
    !attr_status
    !attrs
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return target_status

L_BAD_ATTRIBUTES:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, attr_status as i32
    !attr_ok
    !attrs
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return attr_status

L_MISSING_PRIMITIVE:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_PRIMITIVE:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MODE:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !mode_bad
    !mode_status
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_INDICES:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !indices_bad
    !indices_status
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MATERIAL:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !material_bad
    !material_status
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_index_format_from_component_type(component_type: i32) -> i32:
L_ENTRY:
    is_u8 = eq component_type, SA3D_GLTF_COMPONENT_U8
    br is_u8 -> L_U8, L_U16_CHECK

L_U8:
    !is_u8
    !component_type
    return SA3D_GLTF_INDEX_FORMAT_U8

L_U16_CHECK:
    is_u16 = eq component_type, SA3D_GLTF_COMPONENT_U16
    br is_u16 -> L_U16, L_U32_CHECK

L_U16:
    !is_u16
    !is_u8
    !component_type
    return SA3D_GLTF_INDEX_FORMAT_U16

L_U32_CHECK:
    is_u32 = eq component_type, SA3D_GLTF_COMPONENT_U32
    br is_u32 -> L_U32, L_UNSUPPORTED

L_U32:
    !is_u32
    !is_u16
    !is_u8
    !component_type
    return SA3D_GLTF_INDEX_FORMAT_U32

L_UNSUPPORTED:
    !is_u32
    !is_u16
    !is_u8
    !component_type
    return 0

@sa3d_gltf_json_resolve_accessor_layout(bytes: ptr, len: i64, accessor_index: i64, buffer_index: i64, buffer_len: i64, &accessor: ptr, &view: ptr, &layout: ptr) -> i32:
L_ENTRY:
    buffer_table = stack_alloc SA3D_GLTF_BUFFER_TABLE_SIZE
    accessor_status = call @sa3d_gltf_json_accessor_parse(bytes, len, accessor_index, &accessor)
    accessor_ok = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_ok -> L_HAS_BUFFER_VIEW, L_ACCESSOR_UNSUPPORTED_CHECK

L_ACCESSOR_UNSUPPORTED_CHECK:
    accessor_unsupported = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br accessor_unsupported -> L_UNSUPPORTED_FORMAT, L_JSON_ERROR_ACCESSOR

L_HAS_BUFFER_VIEW:
    has_bv = load accessor+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view as i32
    has_bv_bool = ne has_bv, 0
    br has_bv_bool -> L_PARSE_VIEW, L_MISSING_BUFFER_VIEW

L_PARSE_VIEW:
    bv_i32 = load accessor+SA3D_GLTF_ACCESSOR_TABLE_buffer_view as i32
    bv_index = zext bv_i32 as i64
    view_status = call @sa3d_gltf_json_buffer_view_parse(bytes, len, bv_index, &view)
    view_ok = eq view_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br view_ok -> L_BUFFER_MATCH, L_JSON_ERROR_VIEW

L_BUFFER_MATCH:
    view_buffer = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer as i64
    same_buffer = eq view_buffer, buffer_index
    br same_buffer -> L_PARSE_BUFFER, L_BUFFER_MISMATCH

L_PARSE_BUFFER:
    buffer_status = call @sa3d_gltf_json_buffer_parse(bytes, len, view_buffer, &buffer_table)
    buffer_ok = eq buffer_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br buffer_ok -> L_BUFFER_LENGTH, L_JSON_ERROR_BUFFER

L_BUFFER_LENGTH:
    declared_len = load buffer_table+SA3D_GLTF_BUFFER_TABLE_byte_len as i64
    len_ok = sge buffer_len, declared_len
    br len_ok -> L_VALIDATE, L_LAYOUT_ERROR_BUFFER_LENGTH

L_VALIDATE:
    view_offset = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset as i64
    view_len = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len as i64
    view_stride = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride as i64
    accessor_offset = load accessor+SA3D_GLTF_ACCESSOR_TABLE_byte_offset as i64
    accessor_count = load accessor+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    layout_status = call @sa3d_gltf_accessor_layout_validate(buffer_len, view_offset, view_len, view_stride, accessor_offset, accessor_count, accessor_format, &layout)
    layout_ok = eq layout_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    br layout_ok -> L_OK, L_LAYOUT_ERROR

L_OK:
    !layout_ok
    !layout_status
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !len_ok
    !declared_len
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_OK

L_LAYOUT_ERROR:
    !layout_ok
    !layout_status
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !len_ok
    !declared_len
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_LAYOUT_ERROR

L_LAYOUT_ERROR_BUFFER_LENGTH:
    !len_ok
    !declared_len
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_LAYOUT_ERROR

L_JSON_ERROR_BUFFER:
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_JSON_ERROR

L_BUFFER_MISMATCH:
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_BUFFER_MISMATCH

L_JSON_ERROR_VIEW:
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_JSON_ERROR

L_MISSING_BUFFER_VIEW:
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_MISSING_BUFFER_VIEW

L_UNSUPPORTED_FORMAT:
    !accessor_unsupported
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_UNSUPPORTED_FORMAT

L_JSON_ERROR_ACCESSOR:
    !accessor_unsupported
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_JSON_ERROR

@sa3d_gltf_inverse_bind_matrices_identity(accessor_count: i64, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    count_nonnegative = sge accessor_count, 0
    cap_nonnegative = sge cap, 0
    nonnegative = and count_nonnegative, cap_nonnegative
    br nonnegative -> L_SIZE, L_MALFORMED

L_SIZE:
    required = mul accessor_count, SA3D_MAT4_SIZE
    cap_ok = sge cap, required
    br cap_ok -> L_PTR_CHECK, L_OUTPUT_SMALL

L_PTR_CHECK:
    empty = eq required, 0
    dst_present = ne dst, 0
    ptr_ok = or empty, dst_present
    br ptr_ok -> L_LOOP_INIT, L_MALFORMED_PTR

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, accessor_count
    br done -> L_DONE, L_LOOP_BODY

L_LOOP_BODY:
    dst_pos = mul idx, SA3D_MAT4_SIZE
    mat = ptr_add dst, dst_pos
    call @sa3d_mat4_identity(&mat)
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !mat
    !dst_pos
    !done
    !idx
    jmp L_LOOP_HEAD

L_DONE:
    store out_len+0, required as i64
    !done
    !idx
    !ptr_ok
    !dst_present
    !empty
    !cap_ok
    !required
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !out_len
    !cap
    !dst
    !accessor_count
    return SA3D_GLTF_IBM_STATUS_OK

L_MALFORMED:
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !out_len
    !cap
    !dst
    !accessor_count
    return SA3D_GLTF_IBM_STATUS_MALFORMED_DATA

L_MALFORMED_PTR:
    !ptr_ok
    !dst_present
    !empty
    !cap_ok
    !required
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !out_len
    !cap
    !dst
    !accessor_count
    return SA3D_GLTF_IBM_STATUS_MALFORMED_DATA

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !out_len
    !cap
    !dst
    !accessor_count
    return SA3D_GLTF_IBM_STATUS_OUTPUT_TOO_SMALL

@sa3d_gltf_inverse_bind_matrix_copy_element(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64, convert_coordinates: i32) -> void:
L_ENTRY:
    src_mat = stack_alloc SA3D_MAT4_SIZE
    src0p = ptr_add buffer, src_pos
    src1_pos = add src_pos, 4
    src1p = ptr_add buffer, src1_pos
    src2_pos = add src_pos, 8
    src2p = ptr_add buffer, src2_pos
    src3_pos = add src_pos, 12
    src3p = ptr_add buffer, src3_pos
    src4_pos = add src_pos, 16
    src4p = ptr_add buffer, src4_pos
    src5_pos = add src_pos, 20
    src5p = ptr_add buffer, src5_pos
    src6_pos = add src_pos, 24
    src6p = ptr_add buffer, src6_pos
    src7_pos = add src_pos, 28
    src7p = ptr_add buffer, src7_pos
    src8_pos = add src_pos, 32
    src8p = ptr_add buffer, src8_pos
    src9_pos = add src_pos, 36
    src9p = ptr_add buffer, src9_pos
    src10_pos = add src_pos, 40
    src10p = ptr_add buffer, src10_pos
    src11_pos = add src_pos, 44
    src11p = ptr_add buffer, src11_pos
    src12_pos = add src_pos, 48
    src12p = ptr_add buffer, src12_pos
    src13_pos = add src_pos, 52
    src13p = ptr_add buffer, src13_pos
    src14_pos = add src_pos, 56
    src14p = ptr_add buffer, src14_pos
    src15_pos = add src_pos, 60
    src15p = ptr_add buffer, src15_pos
    v0 = load src0p+0 as i32
    v1 = load src1p+0 as i32
    v2 = load src2p+0 as i32
    v3 = load src3p+0 as i32
    v4 = load src4p+0 as i32
    v5 = load src5p+0 as i32
    v6 = load src6p+0 as i32
    v7 = load src7p+0 as i32
    v8 = load src8p+0 as i32
    v9 = load src9p+0 as i32
    v10 = load src10p+0 as i32
    v11 = load src11p+0 as i32
    v12 = load src12p+0 as i32
    v13 = load src13p+0 as i32
    v14 = load src14p+0 as i32
    v15 = load src15p+0 as i32
    store src_mat+0, v0 as i32
    store src_mat+4, v1 as i32
    store src_mat+8, v2 as i32
    store src_mat+12, v3 as i32
    store src_mat+16, v4 as i32
    store src_mat+20, v5 as i32
    store src_mat+24, v6 as i32
    store src_mat+28, v7 as i32
    store src_mat+32, v8 as i32
    store src_mat+36, v9 as i32
    store src_mat+40, v10 as i32
    store src_mat+44, v11 as i32
    store src_mat+48, v12 as i32
    store src_mat+52, v13 as i32
    store src_mat+56, v14 as i32
    store src_mat+60, v15 as i32
    do_convert = ne convert_coordinates, 0
    br do_convert -> L_CONVERT, L_COPY

L_CONVERT:
    conversion = stack_alloc SA3D_MAT4_SIZE
    out_mat = ptr_add dst, dst_pos
    call @sa3d_mat4_identity(&conversion)
    store conversion+0, SA3D_F32_NEG_ONE_BITS as i32
    store conversion+40, SA3D_F32_NEG_ONE_BITS as i32
    call @sa3d_mat4_mul(&out_mat, &src_mat, &conversion)
    !out_mat
    !do_convert
    !v15
    !v14
    !v13
    !v12
    !v11
    !v10
    !v9
    !v8
    !v7
    !v6
    !v5
    !v4
    !v3
    !v2
    !v1
    !v0
    !src15p
    !src15_pos
    !src14p
    !src14_pos
    !src13p
    !src13_pos
    !src12p
    !src12_pos
    !src11p
    !src11_pos
    !src10p
    !src10_pos
    !src9p
    !src9_pos
    !src8p
    !src8_pos
    !src7p
    !src7_pos
    !src6p
    !src6_pos
    !src5p
    !src5_pos
    !src4p
    !src4_pos
    !src3p
    !src3_pos
    !src2p
    !src2_pos
    !src1p
    !src1_pos
    !src0p
    !convert_coordinates
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

L_COPY:
    out_mat_copy = ptr_add dst, dst_pos
    call @sa3d_mat4_copy(&out_mat_copy, &src_mat)
    !out_mat_copy
    !do_convert
    !v15
    !v14
    !v13
    !v12
    !v11
    !v10
    !v9
    !v8
    !v7
    !v6
    !v5
    !v4
    !v3
    !v2
    !v1
    !v0
    !src15p
    !src15_pos
    !src14p
    !src14_pos
    !src13p
    !src13_pos
    !src12p
    !src12_pos
    !src11p
    !src11_pos
    !src10p
    !src10_pos
    !src9p
    !src9_pos
    !src8p
    !src8_pos
    !src7p
    !src7_pos
    !src6p
    !src6_pos
    !src5p
    !src5_pos
    !src4p
    !src4_pos
    !src3p
    !src3_pos
    !src2p
    !src2_pos
    !src1p
    !src1_pos
    !src0p
    !convert_coordinates
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_inverse_bind_matrices_materialize(buffer: ptr, accessor_count: i64, accessor_format: i32, convert_coordinates: i32, &layout: ptr, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    format_ok = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_MAT4
    br format_ok -> L_LAYOUT_CHECK, L_UNSUPPORTED

L_LAYOUT_CHECK:
    layout_status = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_status as i32
    layout_ok = eq layout_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    br layout_ok -> L_PTR_CHECK, L_MALFORMED_LAYOUT

L_PTR_CHECK:
    count_nonnegative = sge accessor_count, 0
    cap_nonnegative = sge cap, 0
    nonnegative = and count_nonnegative, cap_nonnegative
    br nonnegative -> L_SIZE_CHECK, L_MALFORMED_NONNEG

L_SIZE_CHECK:
    element_size = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size as i64
    size_ok = eq element_size, SA3D_MAT4_SIZE
    br size_ok -> L_CAP_CHECK, L_MALFORMED_SIZE

L_CAP_CHECK:
    required = mul accessor_count, SA3D_MAT4_SIZE
    cap_ok = sge cap, required
    br cap_ok -> L_BUFFER_PTR_CHECK, L_OUTPUT_SMALL

L_BUFFER_PTR_CHECK:
    empty = eq required, 0
    buffer_present = ne buffer, 0
    dst_present = ne dst, 0
    ptrs_present = and buffer_present, dst_present
    ptr_ok = or empty, ptrs_present
    br ptr_ok -> L_LOOP_INIT, L_MALFORMED_PTR

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    byte_offset = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset as i64
    stride = load layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride as i64
    store idx_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, accessor_count
    br done -> L_DONE, L_LOOP_BODY

L_LOOP_BODY:
    src_step = mul idx, stride
    src_pos = add byte_offset, src_step
    dst_pos = mul idx, SA3D_MAT4_SIZE
    call @sa3d_gltf_inverse_bind_matrix_copy_element(buffer, src_pos, dst, dst_pos, convert_coordinates)
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !dst_pos
    !src_pos
    !src_step
    !done
    !idx
    jmp L_LOOP_HEAD

L_DONE:
    store out_len+0, required as i64
    !done
    !idx
    !stride
    !byte_offset
    !ptr_ok
    !ptrs_present
    !dst_present
    !buffer_present
    !empty
    !cap_ok
    !required
    !size_ok
    !element_size
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_IBM_STATUS_OK

L_UNSUPPORTED:
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_IBM_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_LAYOUT:
    !layout_ok
    !layout_status
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_IBM_STATUS_MALFORMED_DATA

L_MALFORMED_NONNEG:
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_IBM_STATUS_MALFORMED_DATA

L_MALFORMED_SIZE:
    !size_ok
    !element_size
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_IBM_STATUS_MALFORMED_DATA

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !size_ok
    !element_size
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_IBM_STATUS_OUTPUT_TOO_SMALL

L_MALFORMED_PTR:
    !ptr_ok
    !ptrs_present
    !dst_present
    !buffer_present
    !empty
    !cap_ok
    !required
    !size_ok
    !element_size
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
    !out_len
    !cap
    !dst
    !layout
    !convert_coordinates
    !accessor_format
    !accessor_count
    !buffer
    return SA3D_GLTF_IBM_STATUS_MALFORMED_DATA

@sa3d_gltf_json_resolve_status_to_ibm_status(resolve_status: i32) -> i32:
L_ENTRY:
    is_ok = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br is_ok -> L_OK, L_JSON_CHECK

L_OK:
    !is_ok
    !resolve_status
    return SA3D_GLTF_IBM_STATUS_OK

L_JSON_CHECK:
    is_json = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_JSON_ERROR
    br is_json -> L_JSON, L_MISSING_CHECK

L_JSON:
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_IBM_STATUS_JSON_ERROR

L_MISSING_CHECK:
    is_missing = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_MISSING_BUFFER_VIEW
    br is_missing -> L_MISSING, L_BUFFER_CHECK

L_MISSING:
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_IBM_STATUS_MISSING_BUFFER_VIEW

L_BUFFER_CHECK:
    is_buffer = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_BUFFER_MISMATCH
    br is_buffer -> L_BUFFER, L_LAYOUT_CHECK_MAP

L_BUFFER:
    !is_buffer
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_IBM_STATUS_BUFFER_MISMATCH

L_LAYOUT_CHECK_MAP:
    is_layout = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_LAYOUT_ERROR
    br is_layout -> L_LAYOUT, L_UNSUPPORTED_CHECK

L_LAYOUT:
    !is_layout
    !is_buffer
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_IBM_STATUS_LAYOUT_ERROR

L_UNSUPPORTED_CHECK:
    is_unsupported = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_UNSUPPORTED_FORMAT
    br is_unsupported -> L_UNSUPPORTED_MAP, L_MALFORMED

L_UNSUPPORTED_MAP:
    !is_unsupported
    !is_layout
    !is_buffer
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_IBM_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !is_unsupported
    !is_layout
    !is_buffer
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_IBM_STATUS_MALFORMED_DATA

@sa3d_gltf_attr_status_to_ibm_status(attr_status: i32) -> i32:
L_ENTRY:
    ok = eq attr_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    br ok -> L_OK, L_UNSUPPORTED_CHECK

L_OK:
    !ok
    !attr_status
    return SA3D_GLTF_IBM_STATUS_OK

L_UNSUPPORTED_CHECK:
    unsupported = eq attr_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT
    br unsupported -> L_UNSUPPORTED, L_OUTPUT_SMALL_CHECK

L_UNSUPPORTED:
    !unsupported
    !ok
    !attr_status
    return SA3D_GLTF_IBM_STATUS_UNSUPPORTED_FORMAT

L_OUTPUT_SMALL_CHECK:
    output_small = eq attr_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OUTPUT_TOO_SMALL
    br output_small -> L_OUTPUT_SMALL, L_MALFORMED

L_OUTPUT_SMALL:
    !output_small
    !unsupported
    !ok
    !attr_status
    return SA3D_GLTF_IBM_STATUS_OUTPUT_TOO_SMALL

L_MALFORMED:
    !output_small
    !unsupported
    !ok
    !attr_status
    return SA3D_GLTF_IBM_STATUS_MALFORMED_DATA

@sa3d_gltf_inverse_bind_matrices_apply_coordinate_conversion(dst: ptr, accessor_count: i64) -> void:
L_ENTRY:
    conversion = stack_alloc SA3D_MAT4_SIZE
    temp = stack_alloc SA3D_MAT4_SIZE
    call @sa3d_mat4_identity(&conversion)
    store conversion+0, SA3D_F32_NEG_ONE_BITS as i32
    store conversion+40, SA3D_F32_NEG_ONE_BITS as i32
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, accessor_count
    br done -> L_DONE, L_BODY

L_BODY:
    dst_pos = mul idx, SA3D_MAT4_SIZE
    out_mat = ptr_add dst, dst_pos
    call @sa3d_mat4_copy(&temp, &out_mat)
    call @sa3d_mat4_mul(&out_mat, &temp, &conversion)
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !out_mat
    !dst_pos
    !done
    !idx
    jmp L_HEAD

L_DONE:
    !done
    !idx
    !accessor_count
    !dst
    return

@sa3d_gltf_json_resolve_status_to_animation_status(resolve_status: i32) -> i32:
L_ENTRY:
    is_ok = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br is_ok -> L_OK, L_JSON_CHECK

L_OK:
    !is_ok
    !resolve_status
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_JSON_CHECK:
    is_json = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_JSON_ERROR
    br is_json -> L_JSON, L_MISSING_CHECK

L_JSON:
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_ANIMATION_READ_STATUS_JSON_ERROR

L_MISSING_CHECK:
    is_missing = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_MISSING_BUFFER_VIEW
    br is_missing -> L_MISSING, L_BUFFER_CHECK

L_MISSING:
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_ANIMATION_READ_STATUS_MISSING_BUFFER_VIEW

L_BUFFER_CHECK:
    is_buffer = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_BUFFER_MISMATCH
    br is_buffer -> L_BUFFER, L_LAYOUT_CHECK_MAP

L_BUFFER:
    !is_buffer
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_ANIMATION_READ_STATUS_BUFFER_MISMATCH

L_LAYOUT_CHECK_MAP:
    is_layout = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_LAYOUT_ERROR
    br is_layout -> L_LAYOUT, L_UNSUPPORTED_CHECK

L_LAYOUT:
    !is_layout
    !is_buffer
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_ANIMATION_READ_STATUS_LAYOUT_ERROR

L_UNSUPPORTED_CHECK:
    is_unsupported = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_UNSUPPORTED_FORMAT
    br is_unsupported -> L_UNSUPPORTED_MAP, L_MALFORMED

L_UNSUPPORTED_MAP:
    !is_unsupported
    !is_layout
    !is_buffer
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_ANIMATION_READ_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !is_unsupported
    !is_layout
    !is_buffer
    !is_missing
    !is_json
    !is_ok
    !resolve_status
    return SA3D_GLTF_ANIMATION_READ_STATUS_LAYOUT_ERROR

@sa3d_gltf_json_skin_inverse_bind_matrices_materialize(bytes: ptr, len: i64, skin_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, convert_coordinates: i32, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    skin = stack_alloc SA3D_GLTF_SKIN_TABLE_SIZE
    accessor = stack_alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    store out_len+0, 0 as i64
    skin_status = call @sa3d_gltf_json_skin_parse(bytes, len, skin_index, &skin)
    skin_ok = eq skin_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br skin_ok -> L_HAS_IBM, L_SKIN_JSON_ERROR

L_HAS_IBM:
    has_ibm = load skin+SA3D_GLTF_SKIN_TABLE_has_inverse_bind_matrices as i32
    has_ibm_bool = ne has_ibm, 0
    br has_ibm_bool -> L_ACCESSOR_PARSE, L_IDENTITY

L_IDENTITY:
    joint_count = load skin+SA3D_GLTF_SKIN_TABLE_joint_count as i64
    status_identity = call @sa3d_gltf_inverse_bind_matrices_identity(joint_count, dst, cap, &out_len)
    !joint_count
    !has_ibm_bool
    !has_ibm
    !skin_ok
    !skin_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !skin_index
    !len
    !bytes
    return status_identity

L_ACCESSOR_PARSE:
    ibm_accessor = load skin+SA3D_GLTF_SKIN_TABLE_inverse_bind_matrices as i64
    accessor_status = call @sa3d_gltf_json_accessor_parse(bytes, len, ibm_accessor, &accessor)
    accessor_ok = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_ok -> L_FORMAT, L_ACCESSOR_ERROR_CHECK

L_FORMAT:
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    format_ok = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_MAT4
    br format_ok -> L_MATERIALIZE, L_UNSUPPORTED_FORMAT

L_MATERIALIZE:
    accessor_count = load accessor+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    attr_status = call @sa3d_gltf_json_vertex_attribute_materialize(bytes, len, ibm_accessor, buffer_index, buffer, buffer_len, SA3D_GLTF_CONVERSION_ANY, 0, dst, cap, &out_len)
    attr_ok = eq attr_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    br attr_ok -> L_CONVERT_CHECK, L_ATTR_ERROR

L_CONVERT_CHECK:
    do_convert = ne convert_coordinates, 0
    br do_convert -> L_APPLY_CONVERT, L_OK

L_APPLY_CONVERT:
    call @sa3d_gltf_inverse_bind_matrices_apply_coordinate_conversion(dst, accessor_count)
    !do_convert
    !attr_ok
    !attr_status
    !accessor_count
    !format_ok
    !accessor_format
    !accessor_ok
    !accessor_status
    !ibm_accessor
    !has_ibm_bool
    !has_ibm
    !skin_ok
    !skin_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_IBM_STATUS_OK

L_OK:
    !do_convert
    !attr_ok
    !attr_status
    !accessor_count
    !format_ok
    !accessor_format
    !accessor_ok
    !accessor_status
    !ibm_accessor
    !has_ibm_bool
    !has_ibm
    !skin_ok
    !skin_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_IBM_STATUS_OK

L_ATTR_ERROR:
    mapped_attr = call @sa3d_gltf_attr_status_to_ibm_status(attr_status)
    !attr_ok
    !attr_status
    !accessor_count
    !format_ok
    !accessor_format
    !accessor_ok
    !accessor_status
    !ibm_accessor
    !has_ibm_bool
    !has_ibm
    !skin_ok
    !skin_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !skin_index
    !len
    !bytes
    return mapped_attr

L_ACCESSOR_ERROR_CHECK:
    accessor_unsupported = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br accessor_unsupported -> L_ACCESSOR_UNSUPPORTED, L_ACCESSOR_JSON_ERROR

L_ACCESSOR_UNSUPPORTED:
    !accessor_unsupported
    !accessor_ok
    !accessor_status
    !ibm_accessor
    !has_ibm_bool
    !has_ibm
    !skin_ok
    !skin_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_IBM_STATUS_UNSUPPORTED_FORMAT

L_ACCESSOR_JSON_ERROR:
    !accessor_unsupported
    !accessor_ok
    !accessor_status
    !ibm_accessor
    !has_ibm_bool
    !has_ibm
    !skin_ok
    !skin_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_IBM_STATUS_JSON_ERROR

L_UNSUPPORTED_FORMAT:
    !format_ok
    !accessor_format
    !accessor_ok
    !accessor_status
    !ibm_accessor
    !has_ibm_bool
    !has_ibm
    !skin_ok
    !skin_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_IBM_STATUS_UNSUPPORTED_FORMAT

L_SKIN_JSON_ERROR:
    !skin_ok
    !skin_status
    !out_len
    !cap
    !dst
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_IBM_STATUS_JSON_ERROR

@sa3d_gltf_json_primitive_mesh_add_accessor_attribute(bytes: ptr, len: i64, buffer_index: i64, buffer_len: i64, accessor_index: i64, semantic: i32, convert_coordinates: i32, mesh_on_skinned_nodes: i32, mesh_on_non_skinned_nodes: i32, &mesh: ptr) -> i32:
L_ENTRY:
    accessor = stack_alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    desc = stack_alloc SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_SIZE
    resolve_status = call @sa3d_gltf_json_resolve_accessor_layout(bytes, len, accessor_index, buffer_index, buffer_len, &accessor, &view, &layout)
    resolve_ok = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br resolve_ok -> L_DESC, L_SKIP_RESOLVE

L_DESC:
    known = call @sa3d_gltf_vertex_attribute_from_semantic(&desc, semantic, convert_coordinates, 0)
    known_bool = ne known, 0
    br known_bool -> L_CONVERSION, L_SKIP_UNKNOWN

L_CONVERSION:
    conversion = load desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion as i32
    attr = load desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute as i32
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    normalized = load accessor+SA3D_GLTF_ACCESSOR_TABLE_normalized as i32
    supported = call @sa3d_gltf_accessor_conversion_supported(conversion, accessor_format, normalized)
    supported_bool = ne supported, 0
    br supported_bool -> L_INSERT, L_SKIP_UNSUPPORTED

L_INSERT:
    count = load accessor+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    inserted = call @sa3d_gltf_primitive_mesh_add_attribute(&mesh, attr, count, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes)
    !inserted
    !count
    !supported_bool
    !supported
    !normalized
    !accessor_format
    !attr
    !conversion
    !known_bool
    !known
    !resolve_ok
    !resolve_status
    !mesh
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !convert_coordinates
    !semantic
    !accessor_index
    !buffer_len
    !buffer_index
    !len
    !bytes
    return 1

L_SKIP_UNSUPPORTED:
    !supported_bool
    !supported
    !normalized
    !accessor_format
    !attr
    !conversion
    !known_bool
    !known
    !resolve_ok
    !resolve_status
    !mesh
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !convert_coordinates
    !semantic
    !accessor_index
    !buffer_len
    !buffer_index
    !len
    !bytes
    return 0

L_SKIP_UNKNOWN:
    !known_bool
    !known
    !resolve_ok
    !resolve_status
    !mesh
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !convert_coordinates
    !semantic
    !accessor_index
    !buffer_len
    !buffer_index
    !len
    !bytes
    return 0

L_SKIP_RESOLVE:
    !resolve_ok
    !resolve_status
    !mesh
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !convert_coordinates
    !semantic
    !accessor_index
    !buffer_len
    !buffer_index
    !len
    !bytes
    return 0

@sa3d_gltf_json_primitive_mesh_maybe_add_attr(bytes: ptr, len: i64, buffer_index: i64, buffer_len: i64, &attrs: ptr, value_offset: i64, has_offset: i64, semantic: i32, convert_coordinates: i32, mesh_on_skinned_nodes: i32, mesh_on_non_skinned_nodes: i32, &mesh: ptr) -> i32:
L_ENTRY:
    has_ptr = ptr_add attrs, has_offset
    has_value = load has_ptr+0 as i32
    present = ne has_value, 0
    br present -> L_ADD, L_SKIP

L_ADD:
    value_ptr = ptr_add attrs, value_offset
    accessor_index = load value_ptr+0 as i64
    inserted = call @sa3d_gltf_json_primitive_mesh_add_accessor_attribute(bytes, len, buffer_index, buffer_len, accessor_index, semantic, convert_coordinates, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes, &mesh)
    !inserted
    !accessor_index
    !value_ptr
    !present
    !has_value
    !has_ptr
    !mesh
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !convert_coordinates
    !semantic
    !has_offset
    !value_offset
    !attrs
    !buffer_len
    !buffer_index
    !len
    !bytes
    return 1

L_SKIP:
    !present
    !has_value
    !has_ptr
    !mesh
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !convert_coordinates
    !semantic
    !has_offset
    !value_offset
    !attrs
    !buffer_len
    !buffer_index
    !len
    !bytes
    return 0

@sa3d_gltf_json_primitive_mesh_set_indices_from_accessor(bytes: ptr, len: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, accessor_index: i64, &mesh: ptr) -> i32:
L_ENTRY:
    accessor = stack_alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    scan = stack_alloc SA3D_GLTF_INDEX_SCAN_RESULT_SIZE
    accessor_status = call @sa3d_gltf_json_accessor_parse(bytes, len, accessor_index, &accessor)
    accessor_ok = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_ok -> L_INDEX_FORMAT, L_SKIP_ACCESSOR

L_INDEX_FORMAT:
    component_type = load accessor+SA3D_GLTF_ACCESSOR_TABLE_component_type as i32
    index_format = call @sa3d_gltf_index_format_from_component_type(component_type)
    index_supported = ne index_format, 0
    br index_supported -> L_SCAN, L_SKIP_UNSUPPORTED

L_SCAN:
    scan_status = call @sa3d_gltf_json_index_accessor_scan(bytes, len, accessor_index, buffer_index, buffer, buffer_len, &scan)
    set = call @sa3d_gltf_primitive_mesh_set_indices(&mesh, &scan, index_format)
    !set
    !scan_status
    !index_supported
    !index_format
    !component_type
    !accessor_ok
    !accessor_status
    !mesh
    !accessor_index
    !buffer_len
    !buffer
    !buffer_index
    !len
    !bytes
    return 1

L_SKIP_UNSUPPORTED:
    !index_supported
    !index_format
    !component_type
    !accessor_ok
    !accessor_status
    !mesh
    !accessor_index
    !buffer_len
    !buffer
    !buffer_index
    !len
    !bytes
    return 0

L_SKIP_ACCESSOR:
    !accessor_ok
    !accessor_status
    !mesh
    !accessor_index
    !buffer_len
    !buffer
    !buffer_index
    !len
    !bytes
    return 0

@sa3d_gltf_json_primitive_mesh_from_tables(bytes: ptr, len: i64, mesh_index: i64, primitive_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, convert_coordinates: i32, material_needs_tangents: i32, skinned_bounds_policy: i32, mesh_on_skinned_nodes: i32, mesh_on_non_skinned_nodes: i32, &mesh: ptr) -> i32:
L_ENTRY:
    primitive = stack_alloc SA3D_GLTF_PRIMITIVE_TABLE_SIZE
    material_needs_slot = stack_alloc 4
    parse_status = call @sa3d_gltf_json_primitive_parse(bytes, len, mesh_index, primitive_index, &primitive)
    parse_ok = eq parse_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br parse_ok -> L_BEGIN, L_PARSE_ERROR

L_BEGIN:
    mode = load primitive+SA3D_GLTF_PRIMITIVE_TABLE_mode as i32
    begin_status = call @sa3d_gltf_primitive_mesh_begin(&mesh, mode)
    begin_ok = eq begin_status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK
    br begin_ok -> L_ATTRIBUTES, L_BEGIN_ERROR

L_ATTRIBUTES:
    attrs = ptr_add primitive, SA3D_GLTF_PRIMITIVE_TABLE_attributes
    a0 = call @sa3d_gltf_json_primitive_mesh_maybe_add_attr(bytes, len, buffer_index, buffer_len, &attrs, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_position, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_position, SA3D_GLTF_SEMANTIC_POSITIONS, convert_coordinates, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes, &mesh)
    a1 = call @sa3d_gltf_json_primitive_mesh_maybe_add_attr(bytes, len, buffer_index, buffer_len, &attrs, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_normal, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_normal, SA3D_GLTF_SEMANTIC_NORMALS, convert_coordinates, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes, &mesh)
    a2 = call @sa3d_gltf_json_primitive_mesh_maybe_add_attr(bytes, len, buffer_index, buffer_len, &attrs, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_tangent, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_tangent, SA3D_GLTF_SEMANTIC_TANGENTS, convert_coordinates, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes, &mesh)
    a3 = call @sa3d_gltf_json_primitive_mesh_maybe_add_attr(bytes, len, buffer_index, buffer_len, &attrs, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_color0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_color0, SA3D_GLTF_SEMANTIC_COLORS_0, convert_coordinates, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes, &mesh)
    a4 = call @sa3d_gltf_json_primitive_mesh_maybe_add_attr(bytes, len, buffer_index, buffer_len, &attrs, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord0, SA3D_GLTF_SEMANTIC_TEXCOORDS_0, convert_coordinates, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes, &mesh)
    a5 = call @sa3d_gltf_json_primitive_mesh_maybe_add_attr(bytes, len, buffer_index, buffer_len, &attrs, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord1, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord1, SA3D_GLTF_SEMANTIC_TEXCOORDS_1, convert_coordinates, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes, &mesh)
    a6 = call @sa3d_gltf_json_primitive_mesh_maybe_add_attr(bytes, len, buffer_index, buffer_len, &attrs, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_joints0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_joints0, SA3D_GLTF_SEMANTIC_JOINTS_0, convert_coordinates, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes, &mesh)
    a7 = call @sa3d_gltf_json_primitive_mesh_maybe_add_attr(bytes, len, buffer_index, buffer_len, &attrs, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_weights0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_weights0, SA3D_GLTF_SEMANTIC_WEIGHTS_0, convert_coordinates, mesh_on_skinned_nodes, mesh_on_non_skinned_nodes, &mesh)
    !a7
    !a6
    !a5
    !a4
    !a3
    !a2
    !a1
    !a0
    jmp L_INDICES

L_INDICES:
    has_indices = load primitive+SA3D_GLTF_PRIMITIVE_TABLE_has_indices as i32
    indices_present = ne has_indices, 0
    br indices_present -> L_SET_INDICES, L_NO_INDICES

L_SET_INDICES:
    indices_accessor = load primitive+SA3D_GLTF_PRIMITIVE_TABLE_indices as i64
    indices_set = call @sa3d_gltf_json_primitive_mesh_set_indices_from_accessor(bytes, len, buffer_index, buffer, buffer_len, indices_accessor, &mesh)
    !indices_set
    !indices_accessor
    !indices_present
    !has_indices
    jmp L_MATERIAL_NEEDS

L_NO_INDICES:
    !indices_present
    !has_indices
    jmp L_MATERIAL_NEEDS

L_MATERIAL_NEEDS:
    auto_material = slt material_needs_tangents, 0
    br auto_material -> L_COMPUTE_MATERIAL_NEEDS, L_USE_GIVEN_MATERIAL_NEEDS

L_USE_GIVEN_MATERIAL_NEEDS:
    store material_needs_slot+0, material_needs_tangents as i32
    !auto_material
    jmp L_FINALIZE

L_COMPUTE_MATERIAL_NEEDS:
    primitive_has_material = load primitive+SA3D_GLTF_PRIMITIVE_TABLE_has_material as i32
    primitive_material = load primitive+SA3D_GLTF_PRIMITIVE_TABLE_material as i64
    computed_material_needs = call @sa3d_gltf_json_material_needs_tangents(bytes, len, primitive_has_material, primitive_material)
    computed_bad = slt computed_material_needs, 0
    br computed_bad -> L_COMPUTE_MATERIAL_NEEDS_BAD, L_COMPUTE_MATERIAL_NEEDS_STORE

L_COMPUTE_MATERIAL_NEEDS_STORE:
    store material_needs_slot+0, computed_material_needs as i32
    !computed_bad
    !computed_material_needs
    !primitive_material
    !primitive_has_material
    !auto_material
    jmp L_FINALIZE

L_COMPUTE_MATERIAL_NEEDS_BAD:
    store material_needs_slot+0, 0 as i32
    !computed_bad
    !computed_material_needs
    !primitive_material
    !primitive_has_material
    !auto_material
    jmp L_FINALIZE

L_FINALIZE:
    effective_material_needs = load material_needs_slot+0 as i32
    finalize_status = call @sa3d_gltf_primitive_mesh_finalize(&mesh, effective_material_needs, skinned_bounds_policy, mesh_on_skinned_nodes)
    !effective_material_needs
    !attrs
    !begin_ok
    !begin_status
    !mode
    !parse_ok
    !parse_status
    !mesh
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !skinned_bounds_policy
    !material_needs_tangents
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return finalize_status

L_BEGIN_ERROR:
    !begin_ok
    !mode
    !parse_ok
    !parse_status
    !mesh
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !skinned_bounds_policy
    !material_needs_tangents
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return begin_status

L_PARSE_ERROR:
    call @sa3d_gltf_primitive_mesh_init(&mesh)
    !parse_ok
    !mesh
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !skinned_bounds_policy
    !material_needs_tangents
    !convert_coordinates
    !buffer_len
    !buffer
    !buffer_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_PRIMITIVE_MESH_STATUS_UNSUPPORTED_PRIMITIVE

@sa3d_gltf_bytes_starts_with(bytes: ptr, len: i64, prefix: ptr, prefix_len: i64) -> i32:
L_ENTRY:
    too_short = slt len, prefix_len
    br too_short -> L_FALSE, L_CHECK

L_CHECK:
    ok = call @sa3d_gltf_bytes_eq(bytes, prefix, prefix_len)
    !too_short
    !len
    !prefix
    !bytes
    return ok

L_FALSE:
    !too_short
    !prefix_len
    !prefix
    !len
    !bytes
    return 0

@sa3d_gltf_bytes_ends_with(bytes: ptr, len: i64, suffix: ptr, suffix_len: i64) -> i32:
L_ENTRY:
    too_short = slt len, suffix_len
    br too_short -> L_FALSE, L_CHECK

L_CHECK:
    start = sub len, suffix_len
    tail = ptr_add bytes, start
    ok = call @sa3d_gltf_bytes_eq(tail, suffix, suffix_len)
    !tail
    !start
    !too_short
    !len
    !suffix
    !bytes
    return ok

L_FALSE:
    !too_short
    !suffix_len
    !suffix
    !len
    !bytes
    return 0

@sa3d_gltf_find_byte(bytes: ptr, len: i64, target: u8) -> i64:
L_ENTRY:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_CHECK

L_CHECK:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_NONE, L_LOAD

L_LOAD:
    cur_ptr = ptr_add bytes, idx
    byte = load cur_ptr+0 as u8
    found = eq byte, target
    br found -> L_FOUND, L_NEXT

L_NEXT:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !found
    !byte
    !cur_ptr
    !idx
    !done
    jmp L_CHECK

L_FOUND:
    !found
    !byte
    !cur_ptr
    !done
    !target
    !len
    !bytes
    return idx

L_NONE:
    !done
    !idx
    !target
    !len
    !bytes
    return -1

@sa3d_gltf_data_uri_view_init(&view: ptr) -> void:
L_ENTRY:
    store view+SA3D_GLTF_DATA_URI_VIEW_mime_ptr, 0 as i64
    store view+SA3D_GLTF_DATA_URI_VIEW_mime_len, 0 as i64
    store view+SA3D_GLTF_DATA_URI_VIEW_data_ptr, 0 as i64
    store view+SA3D_GLTF_DATA_URI_VIEW_data_len, 0 as i64
    store view+SA3D_GLTF_DATA_URI_VIEW_base64, 0 as i32
    store view+SA3D_GLTF_DATA_URI_VIEW_status, SA3D_GLTF_DATA_URI_STATUS_NOT_DATA_URI as i32
    !view
    return

@sa3d_gltf_data_uri_view_set_status(&view: ptr, status: i32) -> i32:
L_ENTRY:
    store view+SA3D_GLTF_DATA_URI_VIEW_status, status as i32
    !view
    return status

@sa3d_gltf_data_uri_parse(uri: ptr, len: i64, &view: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_data_uri_view_init(&view)
    prefix_ok = call @sa3d_gltf_bytes_starts_with(uri, len, &SA3D_GLTF_DATA_URI_PREFIX, 5)
    has_prefix = ne prefix_ok, 0
    br has_prefix -> L_AFTER_PREFIX, L_NOT_DATA

L_AFTER_PREFIX:
    rest_len = sub len, 5
    rest_ptr = ptr_add uri, 5
    comma_rel = call @sa3d_gltf_find_byte(rest_ptr, rest_len, 44)
    comma_found = sge comma_rel, 0
    br comma_found -> L_CHECK_SUFFIX, L_MISSING_COMMA

L_CHECK_SUFFIX:
    data_offset = add 5, comma_rel
    data_start = add data_offset, 1
    data_len = sub len, data_start
    mime_len_raw = comma_rel
    suffix_ok = call @sa3d_gltf_bytes_ends_with(rest_ptr, mime_len_raw, &SA3D_GLTF_DATA_URI_BASE64_SUFFIX, 7)
    has_suffix = ne suffix_ok, 0
    br has_suffix -> L_STORE_BASE64, L_STORE_RAW

L_STORE_BASE64:
    mime_len_base64 = sub mime_len_raw, 7
    data_ptr_base64 = ptr_add uri, data_start
    store view+SA3D_GLTF_DATA_URI_VIEW_mime_ptr, rest_ptr as ptr
    store view+SA3D_GLTF_DATA_URI_VIEW_mime_len, mime_len_base64 as i64
    store view+SA3D_GLTF_DATA_URI_VIEW_data_ptr, data_ptr_base64 as ptr
    store view+SA3D_GLTF_DATA_URI_VIEW_data_len, data_len as i64
    store view+SA3D_GLTF_DATA_URI_VIEW_base64, 1 as i32
    status_base64 = call @sa3d_gltf_data_uri_view_set_status(&view, SA3D_GLTF_DATA_URI_STATUS_OK)
    !data_ptr_base64
    !rest_ptr
    !view
    !len
    !uri
    return status_base64

L_STORE_RAW:
    data_ptr_raw = ptr_add uri, data_start
    store view+SA3D_GLTF_DATA_URI_VIEW_mime_ptr, rest_ptr as ptr
    store view+SA3D_GLTF_DATA_URI_VIEW_mime_len, mime_len_raw as i64
    store view+SA3D_GLTF_DATA_URI_VIEW_data_ptr, data_ptr_raw as ptr
    store view+SA3D_GLTF_DATA_URI_VIEW_data_len, data_len as i64
    store view+SA3D_GLTF_DATA_URI_VIEW_base64, 0 as i32
    status_raw = call @sa3d_gltf_data_uri_view_set_status(&view, SA3D_GLTF_DATA_URI_STATUS_OK)
    !data_ptr_raw
    !rest_ptr
    !view
    !len
    !uri
    return status_raw

L_NOT_DATA:
    status_not_data = call @sa3d_gltf_data_uri_view_set_status(&view, SA3D_GLTF_DATA_URI_STATUS_NOT_DATA_URI)
    !view
    !len
    !uri
    return status_not_data

L_MISSING_COMMA:
    status_missing_comma = call @sa3d_gltf_data_uri_view_set_status(&view, SA3D_GLTF_DATA_URI_STATUS_MISSING_COMMA)
    !rest_ptr
    !view
    !len
    !uri
    return status_missing_comma

@sa3d_gltf_buffer_data_uri_mime_is_valid(mime: ptr, len: i64) -> i32:
L_ENTRY:
    is_octet_len = eq len, 24
    br is_octet_len -> L_CHECK_OCTET, L_CHECK_GLTF_LEN

L_CHECK_OCTET:
    octet_ok = call @sa3d_gltf_bytes_eq(mime, &SA3D_GLTF_MIME_OCTET_STREAM, 24)
    !is_octet_len
    !len
    !mime
    return octet_ok

L_CHECK_GLTF_LEN:
    is_gltf_len = eq len, 23
    br is_gltf_len -> L_CHECK_GLTF, L_FALSE

L_CHECK_GLTF:
    gltf_ok = call @sa3d_gltf_bytes_eq(mime, &SA3D_GLTF_MIME_GLTF_BUFFER, 23)
    !is_gltf_len
    !is_octet_len
    !len
    !mime
    return gltf_ok

L_FALSE:
    !is_gltf_len
    !is_octet_len
    !len
    !mime
    return 0

@sa3d_gltf_buffer_uri_kind(uri: ptr, len: i64, &view: ptr) -> i32:
L_ENTRY:
    status = call @sa3d_gltf_data_uri_parse(uri, len, &view)
    ok = eq status, SA3D_GLTF_DATA_URI_STATUS_OK
    br ok -> L_CHECK_MIME, L_EXTERNAL

L_CHECK_MIME:
    mime_ptr = load view+SA3D_GLTF_DATA_URI_VIEW_mime_ptr as ptr
    mime_len = load view+SA3D_GLTF_DATA_URI_VIEW_mime_len as i64
    mime_ok = call @sa3d_gltf_buffer_data_uri_mime_is_valid(mime_ptr, mime_len)
    valid = ne mime_ok, 0
    br valid -> L_DATA, L_UNSUPPORTED

L_DATA:
    !view
    !len
    !uri
    return SA3D_GLTF_BUFFER_URI_DATA

L_UNSUPPORTED:
    !view
    !len
    !uri
    return SA3D_GLTF_BUFFER_URI_UNSUPPORTED_DATA_MIME

L_EXTERNAL:
    !view
    !len
    !uri
    return SA3D_GLTF_BUFFER_URI_EXTERNAL

@sa3d_gltf_base64_char_value(byte: u8) -> i32:
L_ENTRY:
    b = zext byte as i32
    ge_a_upper = sge b, 65
    le_z_upper = sle b, 90
    upper = and ge_a_upper, le_z_upper
    br upper -> L_UPPER, L_LOWER_CHECK

L_UPPER:
    out_upper = sub b, 65
    !upper
    !le_z_upper
    !ge_a_upper
    !b
    !byte
    return out_upper

L_LOWER_CHECK:
    ge_a_lower = sge b, 97
    le_z_lower = sle b, 122
    lower = and ge_a_lower, le_z_lower
    br lower -> L_LOWER, L_DIGIT_CHECK

L_LOWER:
    raw_lower = sub b, 97
    out_lower = add raw_lower, 26
    !raw_lower
    !lower
    !le_z_lower
    !ge_a_lower
    !upper
    !le_z_upper
    !ge_a_upper
    !b
    !byte
    return out_lower

L_DIGIT_CHECK:
    ge_digit = sge b, 48
    le_digit = sle b, 57
    digit = and ge_digit, le_digit
    br digit -> L_DIGIT, L_PLUS_CHECK

L_DIGIT:
    raw_digit = sub b, 48
    out_digit = add raw_digit, 52
    !raw_digit
    !digit
    !le_digit
    !ge_digit
    !lower
    !le_z_lower
    !ge_a_lower
    !upper
    !le_z_upper
    !ge_a_upper
    !b
    !byte
    return out_digit

L_PLUS_CHECK:
    plus = eq b, 43
    br plus -> L_PLUS, L_SLASH_CHECK

L_PLUS:
    !plus
    !digit
    !le_digit
    !ge_digit
    !lower
    !le_z_lower
    !ge_a_lower
    !upper
    !le_z_upper
    !ge_a_upper
    !b
    !byte
    return 62

L_SLASH_CHECK:
    slash = eq b, 47
    br slash -> L_SLASH, L_PAD_CHECK

L_SLASH:
    !slash
    !plus
    !digit
    !le_digit
    !ge_digit
    !lower
    !le_z_lower
    !ge_a_lower
    !upper
    !le_z_upper
    !ge_a_upper
    !b
    !byte
    return 63

L_PAD_CHECK:
    pad = eq b, 61
    br pad -> L_PAD, L_INVALID

L_PAD:
    !pad
    !slash
    !plus
    !digit
    !le_digit
    !ge_digit
    !lower
    !le_z_lower
    !ge_a_lower
    !upper
    !le_z_upper
    !ge_a_upper
    !b
    !byte
    return -2

L_INVALID:
    !pad
    !slash
    !plus
    !digit
    !le_digit
    !ge_digit
    !lower
    !le_z_lower
    !ge_a_lower
    !upper
    !le_z_upper
    !ge_a_upper
    !b
    !byte
    return -1

@sa3d_gltf_base64_emit1(dst: ptr, v0: i32, v1: i32, &out_count: ptr) -> i32:
L_ENTRY:
    s0 = shl v0, 18
    s1 = shl v1, 12
    bits = or s0, s1
    b0_shift = lshr bits, 16
    b0_mask = and b0_shift, 255
    b0 = trunc b0_mask as u8
    store dst+0, b0 as u8
    store out_count+0, 1 as i64
    !b0
    !b0_mask
    !b0_shift
    !bits
    !s1
    !s0
    !out_count
    !v1
    !v0
    !dst
    return SA3D_GLTF_BUFFER_DECODE_STATUS_OK

@sa3d_gltf_base64_emit2(dst: ptr, v0: i32, v1: i32, v2: i32, &out_count: ptr) -> i32:
L_ENTRY:
    s0 = shl v0, 18
    s1 = shl v1, 12
    s2 = shl v2, 6
    bits_a = or s0, s1
    bits = or bits_a, s2
    b0_shift = lshr bits, 16
    b0_mask = and b0_shift, 255
    b0 = trunc b0_mask as u8
    b1_shift = lshr bits, 8
    b1_mask = and b1_shift, 255
    b1 = trunc b1_mask as u8
    dst1 = ptr_add dst, 1
    store dst+0, b0 as u8
    store dst1+0, b1 as u8
    store out_count+0, 2 as i64
    !dst1
    !b1
    !b1_mask
    !b1_shift
    !b0
    !b0_mask
    !b0_shift
    !bits
    !bits_a
    !s2
    !s1
    !s0
    !out_count
    !v2
    !v1
    !v0
    !dst
    return SA3D_GLTF_BUFFER_DECODE_STATUS_OK

@sa3d_gltf_base64_emit3(dst: ptr, v0: i32, v1: i32, v2: i32, v3: i32, &out_count: ptr) -> i32:
L_ENTRY:
    s0 = shl v0, 18
    s1 = shl v1, 12
    s2 = shl v2, 6
    bits_a = or s0, s1
    bits_b = or bits_a, s2
    bits = or bits_b, v3
    b0_shift = lshr bits, 16
    b0_mask = and b0_shift, 255
    b0 = trunc b0_mask as u8
    b1_shift = lshr bits, 8
    b1_mask = and b1_shift, 255
    b1 = trunc b1_mask as u8
    b2_mask = and bits, 255
    b2 = trunc b2_mask as u8
    dst1 = ptr_add dst, 1
    dst2 = ptr_add dst, 2
    store dst+0, b0 as u8
    store dst1+0, b1 as u8
    store dst2+0, b2 as u8
    store out_count+0, 3 as i64
    !dst2
    !dst1
    !b2
    !b2_mask
    !b1
    !b1_mask
    !b1_shift
    !b0
    !b0_mask
    !b0_shift
    !bits
    !bits_b
    !bits_a
    !s2
    !s1
    !s0
    !out_count
    !v3
    !v2
    !v1
    !v0
    !dst
    return SA3D_GLTF_BUFFER_DECODE_STATUS_OK

@sa3d_gltf_base64_decode_quad(src: ptr, final_block: i32, dst: ptr, &out_count: ptr) -> i32:
L_ENTRY:
    store out_count+0, 0 as i64
    src1 = ptr_add src, 1
    src2 = ptr_add src, 2
    src3 = ptr_add src, 3
    c0 = load src+0 as u8
    c1 = load src1+0 as u8
    c2 = load src2+0 as u8
    c3 = load src3+0 as u8
    v0 = call @sa3d_gltf_base64_char_value(c0)
    v1 = call @sa3d_gltf_base64_char_value(c1)
    v2 = call @sa3d_gltf_base64_char_value(c2)
    v3 = call @sa3d_gltf_base64_char_value(c3)
    v0_bad = slt v0, 0
    v1_bad = slt v1, 0
    first_bad = or v0_bad, v1_bad
    v2_invalid = eq v2, -1
    v3_invalid = eq v3, -1
    invalid_char = or v2_invalid, v3_invalid
    pad2 = eq v2, -2
    pad3 = eq v3, -2
    pad_any = or pad2, pad3
    not_final = eq final_block, 0
    padding_nonfinal = and pad_any, not_final
    no_pad3 = eq pad3, 0
    pad2_without_pad3 = and pad2, no_pad3
    br first_bad -> L_BAD_PADDING, L_INVALID_CHECK

L_INVALID_CHECK:
    br invalid_char -> L_BAD_CHAR, L_PAD2_CHECK

L_PAD2_CHECK:
    br pad2_without_pad3 -> L_BAD_PADDING, L_NONFINAL_CHECK

L_NONFINAL_CHECK:
    br padding_nonfinal -> L_BAD_PADDING, L_EMIT_SELECT

L_EMIT_SELECT:
    br pad2 -> L_EMIT1, L_EMIT2_SELECT

L_EMIT2_SELECT:
    br pad3 -> L_EMIT2, L_EMIT3

L_EMIT1:
    status1 = call @sa3d_gltf_base64_emit1(dst, v0, v1, &out_count)
    !pad2_without_pad3
    !no_pad3
    !padding_nonfinal
    !not_final
    !pad_any
    !pad3
    !pad2
    !invalid_char
    !v3_invalid
    !v2_invalid
    !first_bad
    !v1_bad
    !v0_bad
    !v3
    !v2
    !v1
    !v0
    !c3
    !c2
    !c1
    !c0
    !src3
    !src2
    !src1
    !dst
    !final_block
    !src
    return status1

L_EMIT2:
    status2 = call @sa3d_gltf_base64_emit2(dst, v0, v1, v2, &out_count)
    !pad2_without_pad3
    !no_pad3
    !padding_nonfinal
    !not_final
    !pad_any
    !pad3
    !pad2
    !invalid_char
    !v3_invalid
    !v2_invalid
    !first_bad
    !v1_bad
    !v0_bad
    !v3
    !v2
    !v1
    !v0
    !c3
    !c2
    !c1
    !c0
    !src3
    !src2
    !src1
    !dst
    !final_block
    !src
    return status2

L_EMIT3:
    status3 = call @sa3d_gltf_base64_emit3(dst, v0, v1, v2, v3, &out_count)
    !pad2_without_pad3
    !no_pad3
    !padding_nonfinal
    !not_final
    !pad_any
    !pad3
    !pad2
    !invalid_char
    !v3_invalid
    !v2_invalid
    !first_bad
    !v1_bad
    !v0_bad
    !v3
    !v2
    !v1
    !v0
    !c3
    !c2
    !c1
    !c0
    !src3
    !src2
    !src1
    !dst
    !final_block
    !src
    return status3

L_BAD_CHAR:
    !pad2_without_pad3
    !no_pad3
    !padding_nonfinal
    !not_final
    !pad_any
    !pad3
    !pad2
    !invalid_char
    !v3_invalid
    !v2_invalid
    !first_bad
    !v1_bad
    !v0_bad
    !v3
    !v2
    !v1
    !v0
    !c3
    !c2
    !c1
    !c0
    !src3
    !src2
    !src1
    !out_count
    !dst
    !final_block
    !src
    return SA3D_GLTF_BUFFER_DECODE_STATUS_INVALID_BASE64_CHAR

L_BAD_PADDING:
    !pad2_without_pad3
    !no_pad3
    !padding_nonfinal
    !not_final
    !pad_any
    !pad3
    !pad2
    !invalid_char
    !v3_invalid
    !v2_invalid
    !first_bad
    !v1_bad
    !v0_bad
    !v3
    !v2
    !v1
    !v0
    !c3
    !c2
    !c1
    !c0
    !src3
    !src2
    !src1
    !out_count
    !dst
    !final_block
    !src
    return SA3D_GLTF_BUFFER_DECODE_STATUS_BAD_BASE64_PADDING

@sa3d_gltf_base64_decode(src: ptr, len: i64, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    len_nonnegative = sge len, 0
    cap_nonnegative = sge cap, 0
    nonnegative = and len_nonnegative, cap_nonnegative
    br nonnegative -> L_PTR_CHECK, L_BAD_LENGTH_INIT

L_PTR_CHECK:
    src_ok_zero = eq len, 0
    src_present = ne src, 0
    src_ok = or src_ok_zero, src_present
    dst_ok_zero = eq cap, 0
    dst_present = ne dst, 0
    dst_ok = or dst_ok_zero, dst_present
    ptr_ok = and src_ok, dst_ok
    br ptr_ok -> L_ALIGN_CHECK, L_BAD_LENGTH_PTR

L_ALIGN_CHECK:
    align_bits = and len, 3
    align_ok = eq align_bits, 0
    br align_ok -> L_EMPTY_CHECK, L_BAD_LENGTH_ALIGN

L_EMPTY_CHECK:
    empty = eq len, 0
    br empty -> L_OK_EMPTY, L_PADDING_READ

L_PADDING_READ:
    last1_off = sub len, 1
    last2_off = sub len, 2
    last1_ptr = ptr_add src, last1_off
    last2_ptr = ptr_add src, last2_off
    last1 = load last1_ptr+0 as u8
    last2 = load last2_ptr+0 as u8
    pad1 = eq last1, 61
    pad2 = eq last2, 61
    no_pad1 = eq pad1, 0
    bad_pad_order = and pad2, no_pad1
    br bad_pad_order -> L_BAD_PADDING_ORDER, L_CAP_CHECK

L_CAP_CHECK:
    pad1_i = zext pad1 as i64
    pad2_i = zext pad2 as i64
    padding = add pad1_i, pad2_i
    quads = sdiv len, 4
    max_out = mul quads, 3
    decoded_len = sub max_out, padding
    cap_ok = sge cap, decoded_len
    br cap_ok -> L_LOOP_INIT, L_OUTPUT_TOO_SMALL

L_LOOP_INIT:
    offset_slot = stack_alloc 8
    out_slot = stack_alloc 8
    count_slot = stack_alloc 8
    store offset_slot+0, 0 as i64
    store out_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    offset = load offset_slot+0 as i64
    done = eq offset, len
    br done -> L_DONE, L_DECODE_BLOCK

L_DECODE_BLOCK:
    next_offset = add offset, 4
    final_block_bool = eq next_offset, len
    final_block = zext final_block_bool as i32
    out_pos = load out_slot+0 as i64
    src_block = ptr_add src, offset
    dst_block = ptr_add dst, out_pos
    block_status = call @sa3d_gltf_base64_decode_quad(src_block, final_block, dst_block, &count_slot)
    block_ok = eq block_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OK
    br block_ok -> L_LOOP_NEXT, L_BLOCK_ERROR

L_LOOP_NEXT:
    count = load count_slot+0 as i64
    next_out = add out_pos, count
    store offset_slot+0, next_offset as i64
    store out_slot+0, next_out as i64
    !next_out
    !count
    !block_ok
    !block_status
    !dst_block
    !src_block
    !out_pos
    !final_block
    !final_block_bool
    !next_offset
    !done
    !offset
    jmp L_LOOP_HEAD

L_DONE:
    final_len = load out_slot+0 as i64
    store out_len+0, final_len as i64
    !final_len
    !done
    !offset
    !decoded_len
    !max_out
    !quads
    !padding
    !pad2_i
    !pad1_i
    !bad_pad_order
    !no_pad1
    !pad2
    !pad1
    !last2
    !last1
    !last2_ptr
    !last1_ptr
    !last2_off
    !last1_off
    !empty
    !align_ok
    !align_bits
    !ptr_ok
    !dst_ok
    !dst_present
    !dst_ok_zero
    !src_ok
    !src_present
    !src_ok_zero
    !nonnegative
    !cap_nonnegative
    !len_nonnegative
    !out_len
    !cap
    !dst
    !len
    !src
    return SA3D_GLTF_BUFFER_DECODE_STATUS_OK

L_OK_EMPTY:
    !empty
    !align_ok
    !align_bits
    !ptr_ok
    !dst_ok
    !dst_present
    !dst_ok_zero
    !src_ok
    !src_present
    !src_ok_zero
    !nonnegative
    !cap_nonnegative
    !len_nonnegative
    !out_len
    !cap
    !dst
    !len
    !src
    return SA3D_GLTF_BUFFER_DECODE_STATUS_OK

L_BLOCK_ERROR:
    !block_ok
    !dst_block
    !src_block
    !out_pos
    !final_block
    !final_block_bool
    !next_offset
    !done
    !offset
    !decoded_len
    !max_out
    !quads
    !padding
    !pad2_i
    !pad1_i
    !bad_pad_order
    !no_pad1
    !pad2
    !pad1
    !last2
    !last1
    !last2_ptr
    !last1_ptr
    !last2_off
    !last1_off
    !empty
    !align_ok
    !align_bits
    !ptr_ok
    !dst_ok
    !dst_present
    !dst_ok_zero
    !src_ok
    !src_present
    !src_ok_zero
    !nonnegative
    !cap_nonnegative
    !len_nonnegative
    !out_len
    !cap
    !dst
    !len
    !src
    return block_status

L_OUTPUT_TOO_SMALL:
    !cap_ok
    !decoded_len
    !max_out
    !quads
    !padding
    !pad2_i
    !pad1_i
    !bad_pad_order
    !no_pad1
    !pad2
    !pad1
    !last2
    !last1
    !last2_ptr
    !last1_ptr
    !last2_off
    !last1_off
    !empty
    !align_ok
    !align_bits
    !ptr_ok
    !dst_ok
    !dst_present
    !dst_ok_zero
    !src_ok
    !src_present
    !src_ok_zero
    !nonnegative
    !cap_nonnegative
    !len_nonnegative
    !out_len
    !cap
    !dst
    !len
    !src
    return SA3D_GLTF_BUFFER_DECODE_STATUS_OUTPUT_TOO_SMALL

L_BAD_PADDING_ORDER:
    !bad_pad_order
    !no_pad1
    !pad2
    !pad1
    !last2
    !last1
    !last2_ptr
    !last1_ptr
    !last2_off
    !last1_off
    !empty
    !align_ok
    !align_bits
    !ptr_ok
    !dst_ok
    !dst_present
    !dst_ok_zero
    !src_ok
    !src_present
    !src_ok_zero
    !nonnegative
    !cap_nonnegative
    !len_nonnegative
    !out_len
    !cap
    !dst
    !len
    !src
    return SA3D_GLTF_BUFFER_DECODE_STATUS_BAD_BASE64_PADDING

L_BAD_LENGTH_ALIGN:
    !align_ok
    !align_bits
    !ptr_ok
    !dst_ok
    !dst_present
    !dst_ok_zero
    !src_ok
    !src_present
    !src_ok_zero
    !nonnegative
    !cap_nonnegative
    !len_nonnegative
    !out_len
    !cap
    !dst
    !len
    !src
    return SA3D_GLTF_BUFFER_DECODE_STATUS_BAD_BASE64_LENGTH

L_BAD_LENGTH_PTR:
    !ptr_ok
    !dst_ok
    !dst_present
    !dst_ok_zero
    !src_ok
    !src_present
    !src_ok_zero
    !nonnegative
    !cap_nonnegative
    !len_nonnegative
    !out_len
    !cap
    !dst
    !len
    !src
    return SA3D_GLTF_BUFFER_DECODE_STATUS_BAD_BASE64_LENGTH

L_BAD_LENGTH_INIT:
    !nonnegative
    !cap_nonnegative
    !len_nonnegative
    !out_len
    !cap
    !dst
    !len
    !src
    return SA3D_GLTF_BUFFER_DECODE_STATUS_BAD_BASE64_LENGTH

@sa3d_gltf_data_uri_decode_to_buffer(&view: ptr, dst: ptr, cap: i64, &out_len: ptr) -> i32:
L_ENTRY:
    store out_len+0, 0 as i64
    data_ptr = load view+SA3D_GLTF_DATA_URI_VIEW_data_ptr as ptr
    data_len = load view+SA3D_GLTF_DATA_URI_VIEW_data_len as i64
    base64 = load view+SA3D_GLTF_DATA_URI_VIEW_base64 as i32
    is_base64 = ne base64, 0
    br is_base64 -> L_BASE64, L_RAW_CAP

L_BASE64:
    status = call @sa3d_gltf_base64_decode(data_ptr, data_len, dst, cap, &out_len)
    !is_base64
    !base64
    !data_len
    !data_ptr
    !view
    return status

L_RAW_CAP:
    cap_ok = sge cap, data_len
    br cap_ok -> L_RAW_COPY, L_RAW_SMALL

L_RAW_COPY:
    copied = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &data_ptr, data_len)
    copied_ok = eq copied, data_len
    br copied_ok -> L_RAW_OK, L_RAW_COPY_FAIL

L_RAW_OK:
    store out_len+0, data_len as i64
    !copied_ok
    !copied
    !cap_ok
    !is_base64
    !base64
    !data_len
    !data_ptr
    !view
    !out_len
    !cap
    !dst
    return SA3D_GLTF_BUFFER_DECODE_STATUS_OK

L_RAW_COPY_FAIL:
    !copied_ok
    !copied
    !cap_ok
    !is_base64
    !base64
    !data_len
    !data_ptr
    !view
    !out_len
    !cap
    !dst
    return SA3D_GLTF_BUFFER_DECODE_STATUS_OUTPUT_TOO_SMALL

L_RAW_SMALL:
    !cap_ok
    !is_base64
    !base64
    !data_len
    !data_ptr
    !view
    !out_len
    !cap
    !dst
    return SA3D_GLTF_BUFFER_DECODE_STATUS_OUTPUT_TOO_SMALL

@sa3d_gltf_buffer_load_result_init(&result: ptr) -> void:
L_ENTRY:
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_ptr, 0 as i64
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_len, 0 as i64
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_external_uri_ptr, 0 as i64
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_external_uri_len, 0 as i64
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_source_kind, -1 as i32
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_status, SA3D_GLTF_BUFFER_LOAD_STATUS_INVALID_SOURCE as i32
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_decode_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OK as i32
    !result
    return

@sa3d_gltf_buffer_load_result_set_status(&result: ptr, status: i32) -> i32:
L_ENTRY:
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_status, status as i32
    !result
    return status

@sa3d_gltf_buffer_source_resolve(source_kind: i32, uri: ptr, uri_len: i64, blob: ptr, blob_len: i64, has_blob: i32, dst: ptr, cap: i64, &result: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_buffer_load_result_init(&result)
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_source_kind, source_kind as i32
    is_bin = eq source_kind, SA3D_GLTF_BUFFER_SOURCE_BIN
    br is_bin -> L_BIN, L_URI_CHECK

L_BIN:
    blob_present = ne has_blob, 0
    br blob_present -> L_BIN_VALIDATE, L_BIN_MISSING

L_BIN_VALIDATE:
    blob_valid = call @sa3d_gltf_ptr_len_pair_is_valid(blob, blob_len)
    blob_ok = ne blob_valid, 0
    br blob_ok -> L_BIN_OK, L_BIN_INVALID

L_BIN_OK:
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_ptr, blob as ptr
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_len, blob_len as i64
    status_bin_ok = call @sa3d_gltf_buffer_load_result_set_status(&result, SA3D_GLTF_BUFFER_LOAD_STATUS_OK)
    !blob_ok
    !blob_valid
    !blob_present
    !is_bin
    !result
    !cap
    !dst
    !has_blob
    !blob_len
    !blob
    !uri_len
    !uri
    !source_kind
    return status_bin_ok

L_BIN_INVALID:
    status_bin_invalid = call @sa3d_gltf_buffer_load_result_set_status(&result, SA3D_GLTF_BUFFER_LOAD_STATUS_INVALID_SOURCE)
    !blob_ok
    !blob_valid
    !blob_present
    !is_bin
    !result
    !cap
    !dst
    !has_blob
    !blob_len
    !blob
    !uri_len
    !uri
    !source_kind
    return status_bin_invalid

L_BIN_MISSING:
    status_missing = call @sa3d_gltf_buffer_load_result_set_status(&result, SA3D_GLTF_BUFFER_LOAD_STATUS_MISSING_BLOB)
    !blob_present
    !is_bin
    !result
    !cap
    !dst
    !has_blob
    !blob_len
    !blob
    !uri_len
    !uri
    !source_kind
    return status_missing

L_URI_CHECK:
    is_uri = eq source_kind, SA3D_GLTF_BUFFER_SOURCE_URI
    br is_uri -> L_URI, L_INVALID_SOURCE

L_URI:
    view = stack_alloc SA3D_GLTF_DATA_URI_VIEW_SIZE
    out_len_slot = stack_alloc 8
    uri_kind = call @sa3d_gltf_buffer_uri_kind(uri, uri_len, &view)
    is_data = eq uri_kind, SA3D_GLTF_BUFFER_URI_DATA
    br is_data -> L_URI_DATA, L_URI_EXTERNAL_CHECK

L_URI_DATA:
    decode_status = call @sa3d_gltf_data_uri_decode_to_buffer(&view, dst, cap, &out_len_slot)
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_decode_status, decode_status as i32
    decode_ok = eq decode_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OK
    br decode_ok -> L_URI_DATA_OK, L_URI_DATA_SMALL_CHECK

L_URI_DATA_OK:
    decoded_len = load out_len_slot+0 as i64
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_ptr, dst as ptr
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_len, decoded_len as i64
    status_data_ok = call @sa3d_gltf_buffer_load_result_set_status(&result, SA3D_GLTF_BUFFER_LOAD_STATUS_OK)
    !decoded_len
    !decode_ok
    !decode_status
    !is_data
    !uri_kind
    !is_uri
    !is_bin
    !result
    !cap
    !dst
    !has_blob
    !blob_len
    !blob
    !uri_len
    !uri
    !source_kind
    return status_data_ok

L_URI_DATA_SMALL_CHECK:
    decode_small = eq decode_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OUTPUT_TOO_SMALL
    br decode_small -> L_URI_DATA_SMALL, L_URI_DATA_DECODE_ERROR

L_URI_DATA_SMALL:
    status_data_small = call @sa3d_gltf_buffer_load_result_set_status(&result, SA3D_GLTF_BUFFER_LOAD_STATUS_OUTPUT_TOO_SMALL)
    !decode_small
    !decode_ok
    !decode_status
    !is_data
    !uri_kind
    !is_uri
    !is_bin
    !result
    !cap
    !dst
    !has_blob
    !blob_len
    !blob
    !uri_len
    !uri
    !source_kind
    return status_data_small

L_URI_DATA_DECODE_ERROR:
    status_decode_error = call @sa3d_gltf_buffer_load_result_set_status(&result, SA3D_GLTF_BUFFER_LOAD_STATUS_DECODE_ERROR)
    !decode_small
    !decode_ok
    !decode_status
    !is_data
    !uri_kind
    !is_uri
    !is_bin
    !result
    !cap
    !dst
    !has_blob
    !blob_len
    !blob
    !uri_len
    !uri
    !source_kind
    return status_decode_error

L_URI_EXTERNAL_CHECK:
    is_external = eq uri_kind, SA3D_GLTF_BUFFER_URI_EXTERNAL
    br is_external -> L_URI_EXTERNAL, L_URI_UNSUPPORTED

L_URI_EXTERNAL:
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_external_uri_ptr, uri as ptr
    store result+SA3D_GLTF_BUFFER_LOAD_RESULT_external_uri_len, uri_len as i64
    status_external = call @sa3d_gltf_buffer_load_result_set_status(&result, SA3D_GLTF_BUFFER_LOAD_STATUS_EXTERNAL_URI)
    !is_external
    !is_data
    !uri_kind
    !is_uri
    !is_bin
    !result
    !cap
    !dst
    !has_blob
    !blob_len
    !blob
    !uri_len
    !uri
    !source_kind
    return status_external

L_URI_UNSUPPORTED:
    status_unsupported = call @sa3d_gltf_buffer_load_result_set_status(&result, SA3D_GLTF_BUFFER_LOAD_STATUS_UNSUPPORTED_DATA_MIME)
    !is_external
    !is_data
    !uri_kind
    !is_uri
    !is_bin
    !result
    !cap
    !dst
    !has_blob
    !blob_len
    !blob
    !uri_len
    !uri
    !source_kind
    return status_unsupported

L_INVALID_SOURCE:
    status_invalid = call @sa3d_gltf_buffer_load_result_set_status(&result, SA3D_GLTF_BUFFER_LOAD_STATUS_INVALID_SOURCE)
    !is_uri
    !is_bin
    !result
    !cap
    !dst
    !has_blob
    !blob_len
    !blob
    !uri_len
    !uri
    !source_kind
    return status_invalid

@sa3d_gltf_json_header_is_valid(&desc: ptr) -> i32:
L_ENTRY:
    source = load desc+SA3D_GLTF_ASSET_DESC_source_ptr as ptr
    len = load desc+SA3D_GLTF_ASSET_DESC_source_len as i64
    has_source = ne source, 0
    len_ok = sgt len, 0
    ok = and has_source, len_ok
    br ok -> L_CHECK, L_FALSE

L_CHECK:
    first = call @sa3d_gltf_find_first_non_ws(source, len)
    last = call @sa3d_gltf_find_last_non_ws(source, len)
    first_ok = sge first, 0
    last_ok = sge last, 0
    enough = and first_ok, last_ok
    br enough -> L_LOAD, L_FALSE

L_LOAD:
    first_ptr = ptr_add source, first
    last_ptr = ptr_add source, last
    first_byte = load first_ptr+0 as u8
    last_byte = load last_ptr+0 as u8
    open_ok = eq first_byte, 123
    close_ok = eq last_byte, 125
    valid = and open_ok, close_ok
    br valid -> L_TRUE, L_FALSE

L_TRUE:
    !desc
    return 1

L_FALSE:
    !desc
    return 0

@sa3d_gltf_glb_header_is_valid(&desc: ptr) -> i32:
L_ENTRY:
    view = stack_alloc SA3D_GLTF_GLB_VIEW_SIZE
    status = call @sa3d_gltf_glb_parse_desc(&desc, &view)
    ok = eq status, SA3D_GLTF_GLB_STATUS_OK
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !desc
    return 1

L_FALSE:
    !desc
    return 0

@sa3d_gltf_asset_desc_set_source(&desc: ptr, source: ptr, len: i64) -> void:
L_ENTRY:
    negative = slt len, 0
    br negative -> L_ZERO, L_SET

L_ZERO:
    store desc+SA3D_GLTF_ASSET_DESC_source_ptr, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_source_len, 0 as i64
    !negative
    !len
    !source
    !desc
    return

L_SET:
    store desc+SA3D_GLTF_ASSET_DESC_source_ptr, source as ptr
    store desc+SA3D_GLTF_ASSET_DESC_source_len, len as i64
    !negative
    !len
    !source
    !desc
    return

@sa3d_gltf_asset_desc_set_flags(&desc: ptr, flags: i32) -> void:
L_ENTRY:
    store desc+SA3D_GLTF_ASSET_DESC_flags, flags as i32
    !flags
    !desc
    return

@sa3d_gltf_asset_desc_is_valid(&desc: ptr) -> i32:
L_ENTRY:
    source_ptr = load desc+SA3D_GLTF_ASSET_DESC_source_ptr as ptr
    source_len = load desc+SA3D_GLTF_ASSET_DESC_source_len as i64
    base_uri_ptr = load desc+SA3D_GLTF_ASSET_DESC_base_uri_ptr as ptr
    base_uri_len = load desc+SA3D_GLTF_ASSET_DESC_base_uri_len as i64
    format = load desc+SA3D_GLTF_ASSET_DESC_format as i32
    flags = load desc+SA3D_GLTF_ASSET_DESC_flags as i32
    has_source_ptr = ne source_ptr, 0
    has_source_len = sgt source_len, 0
    has_source = and has_source_ptr, has_source_len
    base_uri_ok = call @sa3d_gltf_ptr_len_pair_is_valid(base_uri_ptr, base_uri_len)
    format_ok = call @sa3d_gltf_format_is_valid(format)
    flags_ok = call @sa3d_gltf_load_flags_are_valid(flags)
    format_valid = ne format_ok, 0
    flags_valid = ne flags_ok, 0
    json_ok = call @sa3d_gltf_json_header_is_valid(&desc)
    glb_ok = call @sa3d_gltf_glb_header_is_valid(&desc)
    header_json = eq format, SA3D_GLTF_FORMAT_JSON
    br header_json -> L_JSON, L_GLB

L_JSON:
    header_valid = ne json_ok, 0
    a = and has_source, base_uri_ok
    b = and a, format_valid
    c = and b, flags_valid
    ok = and c, header_valid
    br ok -> L_TRUE, L_FALSE

L_GLB:
    header_valid = ne glb_ok, 0
    a = and has_source, base_uri_ok
    b = and a, format_valid
    c = and b, flags_valid
    ok = and c, header_valid
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !a
    !flags_valid
    !format_valid
    !flags_ok
    !format_ok
    !header_valid
    !glb_ok
    !json_ok
    !header_json
    !base_uri_ok
    !has_source
    !has_source_len
    !has_source_ptr
    !base_uri_len
    !base_uri_ptr
    !flags
    !format
    !source_len
    !source_ptr
    !desc
    return 1

L_FALSE:
    !ok
    !a
    !flags_valid
    !format_valid
    !flags_ok
    !format_ok
    !header_valid
    !glb_ok
    !json_ok
    !header_json
    !base_uri_ok
    !has_source
    !has_source_len
    !has_source_ptr
    !base_uri_len
    !base_uri_ptr
    !flags
    !format
    !source_len
    !source_ptr
    !desc
    return 0

@sa3d_gltf_asset_desc_enabled_kind_count(&desc: ptr) -> i32:
L_ENTRY:
    flags = load desc+SA3D_GLTF_ASSET_DESC_flags as i32
    meshes_bit = and flags, SA3D_GLTF_LOAD_MESHES
    materials_bit = and flags, SA3D_GLTF_LOAD_MATERIALS
    textures_bit = and flags, SA3D_GLTF_LOAD_TEXTURES
    animations_bit = and flags, SA3D_GLTF_LOAD_ANIMATIONS
    scenes_bit = and flags, SA3D_GLTF_LOAD_SCENES
    meshes = ne meshes_bit, 0
    materials = ne materials_bit, 0
    textures = ne textures_bit, 0
    animations = ne animations_bit, 0
    scenes = ne scenes_bit, 0
    mi = zext meshes as i32
    mati = zext materials as i32
    ti = zext textures as i32
    ai = zext animations as i32
    si = zext scenes as i32
    a = add mi, mati
    b = add ti, ai
    c = add a, b
    out = add c, si
    !c
    !b
    !a
    !si
    !ai
    !ti
    !mati
    !mi
    !scenes
    !animations
    !textures
    !materials
    !meshes
    !scenes_bit
    !animations_bit
    !textures_bit
    !materials_bit
    !meshes_bit
    !flags
    !desc
    return out

@sa3d_gltf_import_result_init(&result: ptr) -> void:
L_ENTRY:
    store result+SA3D_GLTF_IMPORT_RESULT_scene_handle, 0 as i64
    store result+SA3D_GLTF_IMPORT_RESULT_mesh_count, 0 as i64
    store result+SA3D_GLTF_IMPORT_RESULT_material_count, 0 as i64
    store result+SA3D_GLTF_IMPORT_RESULT_image_count, 0 as i64
    store result+SA3D_GLTF_IMPORT_RESULT_animation_count, 0 as i64
    store result+SA3D_GLTF_IMPORT_RESULT_scene_count, 0 as i64
    store result+SA3D_GLTF_IMPORT_RESULT_skin_count, 0 as i64
    store result+SA3D_GLTF_IMPORT_RESULT_node_count, 0 as i64
    !result
    return

@sa3d_gltf_import_result_get_mesh_count(&result: ptr) -> i64:
L_ENTRY:
    mc = load result+SA3D_GLTF_IMPORT_RESULT_mesh_count as i64
    !result
    return mc

@sa3d_gltf_import_result_set_counts(&result: ptr, meshes: i64, materials: i64, images: i64, animations: i64) -> void:
L_ENTRY:
    store result+SA3D_GLTF_IMPORT_RESULT_mesh_count, meshes as i64
    store result+SA3D_GLTF_IMPORT_RESULT_material_count, materials as i64
    store result+SA3D_GLTF_IMPORT_RESULT_image_count, images as i64
    store result+SA3D_GLTF_IMPORT_RESULT_animation_count, animations as i64
    !animations
    !images
    !materials
    !meshes
    !result
    return

@sa3d_gltf_import_result_set_extended_counts(&result: ptr, scenes: i64, skins: i64, nodes: i64) -> void:
L_ENTRY:
    store result+SA3D_GLTF_IMPORT_RESULT_scene_count, scenes as i64
    store result+SA3D_GLTF_IMPORT_RESULT_skin_count, skins as i64
    store result+SA3D_GLTF_IMPORT_RESULT_node_count, nodes as i64
    !nodes
    !skins
    !scenes
    !result
    return

@sa3d_gltf_import_result_total_assets(&result: ptr) -> i64:
L_ENTRY:
    meshes = load result+SA3D_GLTF_IMPORT_RESULT_mesh_count as i64
    materials = load result+SA3D_GLTF_IMPORT_RESULT_material_count as i64
    images = load result+SA3D_GLTF_IMPORT_RESULT_image_count as i64
    animations = load result+SA3D_GLTF_IMPORT_RESULT_animation_count as i64
    scenes = load result+SA3D_GLTF_IMPORT_RESULT_scene_count as i64
    skins = load result+SA3D_GLTF_IMPORT_RESULT_skin_count as i64
    nodes = load result+SA3D_GLTF_IMPORT_RESULT_node_count as i64
    a = add meshes, materials
    b = add images, animations
    c = add scenes, skins
    d = add c, nodes
    e = add a, b
    total = add e, d
    !d
    !c
    !b
    !a
    !animations
    !images
    !materials
    !meshes
    !nodes
    !skins
    !scenes
    !result
    return total

@sa3d_gltf_import_result_apply_load_flags(&result: ptr, flags: i32) -> void:
L_ENTRY:
    mesh_bit = and flags, SA3D_GLTF_LOAD_MESHES
    mat_bit = and flags, SA3D_GLTF_LOAD_MATERIALS
    tex_bit = and flags, SA3D_GLTF_LOAD_TEXTURES
    anim_bit = and flags, SA3D_GLTF_LOAD_ANIMATIONS
    scene_bit = and flags, SA3D_GLTF_LOAD_SCENES
    mesh_on = ne mesh_bit, 0
    mat_on = ne mat_bit, 0
    tex_on = ne tex_bit, 0
    anim_on = ne anim_bit, 0
    scene_on = ne scene_bit, 0
    mesh_i = zext mesh_on as i64
    mat_i = zext mat_on as i64
    tex_i = zext tex_on as i64
    anim_i = zext anim_on as i64
    scene_i = zext scene_on as i64
    store result+SA3D_GLTF_IMPORT_RESULT_scene_handle, scene_i as i64
    store result+SA3D_GLTF_IMPORT_RESULT_mesh_count, mesh_i as i64
    store result+SA3D_GLTF_IMPORT_RESULT_material_count, mat_i as i64
    store result+SA3D_GLTF_IMPORT_RESULT_image_count, tex_i as i64
    store result+SA3D_GLTF_IMPORT_RESULT_animation_count, anim_i as i64
    store result+SA3D_GLTF_IMPORT_RESULT_scene_count, scene_i as i64
    !scene_i
    !anim_i
    !tex_i
    !mat_i
    !mesh_i
    !scene_on
    !anim_on
    !tex_on
    !mat_on
    !mesh_on
    !scene_bit
    !anim_bit
    !tex_bit
    !mat_bit
    !mesh_bit
    !flags
    !result
    return

@sa3d_gltf_asset_label_init(&label: ptr, kind: i32, index: i64) -> void:
L_ENTRY:
    store label+SA3D_GLTF_ASSET_LABEL_kind, kind as i32
    store label+SA3D_GLTF_ASSET_LABEL_index, index as i64
    store label+SA3D_GLTF_ASSET_LABEL_mesh, 0 as i64
    store label+SA3D_GLTF_ASSET_LABEL_primitive, 0 as i64
    store label+SA3D_GLTF_ASSET_LABEL_is_scale_inverted, 0 as i32
    !index
    !kind
    !label
    return

@sa3d_gltf_asset_label_scene(&label: ptr, index: i64) -> void:
L_ENTRY:
    call @sa3d_gltf_asset_label_init(&label, SA3D_GLTF_LABEL_SCENE, index)
