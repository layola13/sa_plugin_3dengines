    store out+SA3D_GLTF_MESH_TABLE_name_len, 0 as i64
    store out+SA3D_GLTF_MESH_TABLE_primitive_count, 0 as i64
    store out+SA3D_GLTF_MESH_TABLE_primitives_array_pos, -1 as i64
    store out+SA3D_GLTF_MESH_TABLE_has_weights, 0 as i32
    store out+SA3D_GLTF_MESH_TABLE_weight_count, 0 as i64
    store out+SA3D_GLTF_MESH_TABLE_weights_array_pos, -1 as i64
