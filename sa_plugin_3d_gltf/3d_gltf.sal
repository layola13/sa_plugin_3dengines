    !len
    !bytes
    return -2

L_MALFORMED_STRING_AM:
    !bad_am
    !skipped_am
    !colon_in_bounds
    !colon_pos
    !key_end
    !matched
    !root_key_candidate
    !no_array
    !at_root_object
