    mr_bad = ne mr_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    factor_bad = ne factor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    a = or base_bad, mr_bad
    bad = or a, factor_bad
    br bad -> L_BAD, L_OK

L_OK:
