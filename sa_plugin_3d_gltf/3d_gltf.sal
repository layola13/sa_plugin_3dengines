L_STORE:
    mesh = load mesh_slot+0 as i64
    store out+SA3D_GLTF_NODE_TABLE_has_mesh, 1 as i32
    store out+SA3D_GLTF_NODE_TABLE_mesh, mesh as i64
    !mesh
    !found
    !bad
