    store out+SA3D_GLTF_CAMERA_TABLE_has_zfar, 1 as i32
    !zfar_ok
    !zfar_status
    !znear_ok
    !znear_status
    !ymag_ok
    !ymag_status
    !xmag_ok
    !xmag_status
    !malformed
    !missing
    !orthographic_pos
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_ZFAR:
    !zfar_ok
    !znear_ok
    !znear_status
    !ymag_ok
    !ymag_status
    !xmag_ok
    !xmag_status
    !malformed
    !missing
    !orthographic_pos
    !out
    !camera_pos
    !len
    !bytes
    return zfar_status

L_RETURN_ZNEAR:
    !znear_ok
    !ymag_ok
    !ymag_status
    !xmag_ok
    !xmag_status
    !malformed
    !missing
    !orthographic_pos
    !out
    !camera_pos
    !len
    !bytes
    return znear_status

L_RETURN_YMAG:
    !ymag_ok
    !xmag_ok
    !xmag_status
    !malformed
    !missing
    !orthographic_pos
    !out
    !camera_pos
    !len
    !bytes
    return ymag_status

L_RETURN_XMAG:
    !xmag_ok
    !malformed
    !missing
    !orthographic_pos
    !out
    !camera_pos
    !len
    !bytes
    return xmag_status

L_MISSING:
    !missing
    !orthographic_pos
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    !malformed
    !missing
    !orthographic_pos
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_camera_parse(bytes: ptr, len: i64, camera_index: i64, &out: ptr) -> i32:
L_ENTRY:
    type_ptr_slot = stack_alloc 8
    type_len_slot = stack_alloc 8
    call @sa3d_gltf_camera_table_clear(&out)
    store out+SA3D_GLTF_CAMERA_TABLE_index, camera_index as i64
    camera_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_CAMERAS, 7, camera_index)
    missing = eq camera_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq camera_pos, -2
    br malformed -> L_MALFORMED, L_NAME

L_NAME:
    name_status = call @sa3d_gltf_json_camera_store_name(bytes, len, camera_pos, &out)
    name_ok = eq name_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br name_ok -> L_TYPE, L_RETURN_NAME_STATUS

L_TYPE:
    type_status = call @sa3d_gltf_json_object_string_span(bytes, len, camera_pos, &SA3D_GLTF_JSON_KEY_TYPE, 4, &type_ptr_slot, &type_len_slot)
    type_missing = eq type_status, 0
    br type_missing -> L_MISSING_TYPE, L_TYPE_BAD_CHECK

L_TYPE_BAD_CHECK:
    type_bad = slt type_status, 0
    br type_bad -> L_MALFORMED_TYPE, L_TYPE_PARSE

L_TYPE_PARSE:
    type_ptr = load type_ptr_slot+0 as ptr
    type_len = load type_len_slot+0 as i64
    projection = call @sa3d_gltf_json_camera_projection_from_span(type_ptr, type_len)
    projection_ok = ne projection, 0
    br projection_ok -> L_PROJECTION_KIND, L_UNSUPPORTED_TYPE

L_PROJECTION_KIND:
    is_perspective = eq projection, SA3D_GLTF_CAMERA_PROJECTION_PERSPECTIVE
    br is_perspective -> L_PERSPECTIVE, L_ORTHOGRAPHIC

L_PERSPECTIVE:
    projection_status_p = call @sa3d_gltf_json_camera_parse_perspective(bytes, len, camera_pos, &out)
    projection_ok_p = eq projection_status_p, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br projection_ok_p -> L_EXTRAS_AFTER_P, L_RETURN_PROJECTION_P_STATUS

L_ORTHOGRAPHIC:
    projection_status_o = call @sa3d_gltf_json_camera_parse_orthographic(bytes, len, camera_pos, &out)
    projection_ok_o = eq projection_status_o, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br projection_ok_o -> L_EXTRAS_AFTER_O, L_RETURN_PROJECTION_O_STATUS

L_EXTRAS_AFTER_P:
    extras_status_p = call @sa3d_gltf_json_camera_store_extras(bytes, len, camera_pos, &out)
    extras_ok_p = eq extras_status_p, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br extras_ok_p -> L_OK_P, L_RETURN_EXTRAS_P_STATUS

L_EXTRAS_AFTER_O:
    extras_status_o = call @sa3d_gltf_json_camera_store_extras(bytes, len, camera_pos, &out)
    extras_ok_o = eq extras_status_o, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br extras_ok_o -> L_OK_O, L_RETURN_EXTRAS_O_STATUS

L_OK_P:
    store out+SA3D_GLTF_CAMERA_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !extras_ok_p
    !extras_status_p
    !projection_ok_p
    !projection_status_p
    !is_perspective
    !projection_ok
    !projection
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_O:
    store out+SA3D_GLTF_CAMERA_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !extras_ok_o
    !extras_status_o
    !projection_ok_o
    !projection_status_o
    !is_perspective
    !projection_ok
    !projection
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_EXTRAS_P_STATUS:
    store out+SA3D_GLTF_CAMERA_TABLE_status, extras_status_p as i32
    !extras_ok_p
    !projection_ok_p
    !projection_status_p
    !is_perspective
    !projection_ok
    !projection
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return extras_status_p

L_RETURN_EXTRAS_O_STATUS:
    store out+SA3D_GLTF_CAMERA_TABLE_status, extras_status_o as i32
    !extras_ok_o
    !projection_ok_o
    !projection_status_o
    !is_perspective
    !projection_ok
    !projection
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return extras_status_o

L_RETURN_PROJECTION_P_STATUS:
    store out+SA3D_GLTF_CAMERA_TABLE_status, projection_status_p as i32
    !projection_ok_p
    !is_perspective
    !projection_ok
    !projection
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return projection_status_p

L_RETURN_PROJECTION_O_STATUS:
    store out+SA3D_GLTF_CAMERA_TABLE_status, projection_status_o as i32
    !projection_ok_o
    !is_perspective
    !projection_ok
    !projection
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return projection_status_o

L_UNSUPPORTED_TYPE:
    store out+SA3D_GLTF_CAMERA_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT as i32
    !projection_ok
    !projection
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_TYPE:
    store out+SA3D_GLTF_CAMERA_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_TYPE:
    store out+SA3D_GLTF_CAMERA_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_RETURN_NAME_STATUS:
    store out+SA3D_GLTF_CAMERA_TABLE_status, name_status as i32
    !name_ok
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return name_status

L_MISSING:
    store out+SA3D_GLTF_CAMERA_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_CAMERA_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !camera_pos
    !out
    !camera_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_node_child_count_by_index(bytes: ptr, len: i64, node_index: i64) -> i64:
L_ENTRY:
    children_pos = call @sa3d_gltf_json_node_children_array_pos(bytes, len, node_index)
    missing = eq children_pos, -1
    br missing -> L_ZERO, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq children_pos, -2
    br malformed -> L_BAD, L_COUNT

L_COUNT:
    count = call @sa3d_gltf_json_count_array_items(bytes, len, children_pos)
    !malformed
    !missing
    !children_pos
    !node_index
    !len
    !bytes
    return count

L_ZERO:
    !missing
    !children_pos
    !node_index
    !len
    !bytes
    return 0

L_BAD:
    !malformed
    !missing
    !children_pos
    !node_index
    !len
    !bytes
    return -2

@sa3d_gltf_json_node_child_at_by_index(bytes: ptr, len: i64, node_index: i64, child_index: i64) -> i64:
L_ENTRY:
    children_pos = call @sa3d_gltf_json_node_children_array_pos(bytes, len, node_index)
    missing = eq children_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq children_pos, -2
    br malformed -> L_BAD, L_VALUE_POS

L_VALUE_POS:
    value_pos = call @sa3d_gltf_json_array_item_start(bytes, len, children_pos, child_index)
    value_bad = slt value_pos, 0
    br value_bad -> L_BAD_VALUE_POS, L_PARSE

L_PARSE:
    child = call @sa3d_gltf_json_parse_positive_i64(bytes, len, value_pos)
    child_bad = slt child, 0
    br child_bad -> L_BAD_CHILD, L_OK

L_OK:
    !child_bad
    !value_bad
    !value_pos
    !malformed
    !missing
    !children_pos
    !child_index
    !node_index
    !len
    !bytes
    return child

L_BAD_CHILD:
    !child_bad
    !child
    !value_bad
    !value_pos
    !malformed
    !missing
    !children_pos
    !child_index
    !node_index
    !len
    !bytes
    return -2

L_BAD_VALUE_POS:
    !value_bad
    !value_pos
    !malformed
    !missing
    !children_pos
    !child_index
    !node_index
    !len
    !bytes
    return -2

L_MISSING:
    !missing
    !children_pos
    !child_index
    !node_index
    !len
    !bytes
    return -1

L_BAD:
    !malformed
    !missing
    !children_pos
    !child_index
    !node_index
    !len
    !bytes
    return -2

@sa3d_gltf_json_default_scene_index(bytes: ptr, len: i64) -> i64:
L_ENTRY:
    value_pos = call @sa3d_gltf_json_find_root_key_value(bytes, len, &SA3D_GLTF_JSON_KEY_SCENE, 5)
    missing = eq value_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq value_pos, -2
    br malformed -> L_BAD_ROOT, L_PARSE

L_PARSE:
    parsed = call @sa3d_gltf_json_parse_positive_i64(bytes, len, value_pos)
    parsed_bad = slt parsed, 0
    br parsed_bad -> L_BAD_VALUE, L_SCENE_COUNT

L_SCENE_COUNT:
    scenes_count = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_SCENES, 6)
    count_bad = slt scenes_count, 0
    br count_bad -> L_BAD_COUNT, L_RANGE

L_RANGE:
    in_range = slt parsed, scenes_count
    br in_range -> L_RETURN, L_BAD_RANGE

L_RETURN:
    !in_range
    !count_bad
    !scenes_count
    !parsed_bad
    !malformed
    !missing
    !value_pos
    !len
    !bytes
    return parsed

L_BAD_RANGE:
    !in_range
    !count_bad
    !scenes_count
    !parsed_bad
    !parsed
    !malformed
    !missing
    !value_pos
    !len
    !bytes
    return -2

L_BAD_COUNT:
    !count_bad
    !scenes_count
    !parsed_bad
    !parsed
    !malformed
    !missing
    !value_pos
    !len
    !bytes
    return -2

L_BAD_VALUE:
    !parsed_bad
    !parsed
    !malformed
    !missing
    !value_pos
    !len
    !bytes
    return -2

L_BAD_ROOT:
    !malformed
    !missing
    !value_pos
    !len
    !bytes
    return -2

L_MISSING:
    !missing
    !value_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_scene_nodes_array_pos(bytes: ptr, len: i64, scene_index: i64) -> i64:
L_ENTRY:
    scene_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_SCENES, 6, scene_index)
    missing = eq scene_pos, -1
    br missing -> L_MISSING_SCENE, L_MALFORMED_SCENE_CHECK

L_MALFORMED_SCENE_CHECK:
    malformed = eq scene_pos, -2
    br malformed -> L_MALFORMED_SCENE, L_NODES

L_NODES:
    nodes_pos = call @sa3d_gltf_json_object_field_value(bytes, len, scene_pos, &SA3D_GLTF_JSON_KEY_NODES, 5)
    !malformed
    !missing
    !scene_pos
    !scene_index
    !len
    !bytes
    return nodes_pos

L_MISSING_SCENE:
    !missing
    !scene_pos
    !scene_index
    !len
    !bytes
    return -1

L_MALFORMED_SCENE:
    !malformed
    !missing
    !scene_pos
    !scene_index
    !len
    !bytes
    return -2

@sa3d_gltf_json_scene_root_count(bytes: ptr, len: i64, scene_index: i64) -> i64:
L_ENTRY:
    nodes_pos = call @sa3d_gltf_json_scene_nodes_array_pos(bytes, len, scene_index)
    missing = eq nodes_pos, -1
    br missing -> L_ZERO, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq nodes_pos, -2
    br malformed -> L_BAD, L_COUNT

L_COUNT:
    count = call @sa3d_gltf_json_count_array_items(bytes, len, nodes_pos)
    !malformed
    !missing
    !nodes_pos
    !scene_index
    !len
    !bytes
    return count

L_ZERO:
    !missing
    !nodes_pos
    !scene_index
    !len
    !bytes
    return 0

L_BAD:
    !malformed
    !missing
    !nodes_pos
    !scene_index
    !len
    !bytes
    return -2

@sa3d_gltf_json_scene_root_at(bytes: ptr, len: i64, scene_index: i64, root_index: i64) -> i64:
L_ENTRY:
    nodes_pos = call @sa3d_gltf_json_scene_nodes_array_pos(bytes, len, scene_index)
    missing = eq nodes_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq nodes_pos, -2
    br malformed -> L_BAD, L_VALUE_POS

L_VALUE_POS:
    value_pos = call @sa3d_gltf_json_array_item_start(bytes, len, nodes_pos, root_index)
    value_bad = slt value_pos, 0
    br value_bad -> L_BAD_VALUE_POS, L_PARSE

L_PARSE:
    node = call @sa3d_gltf_json_parse_positive_i64(bytes, len, value_pos)
    node_bad = slt node, 0
    br node_bad -> L_BAD_NODE, L_OK

L_OK:
    !node_bad
    !value_bad
    !value_pos
    !malformed
    !missing
    !nodes_pos
    !root_index
    !scene_index
    !len
    !bytes
    return node

L_BAD_NODE:
    !node_bad
    !node
    !value_bad
    !value_pos
    !malformed
    !missing
    !nodes_pos
    !root_index
    !scene_index
    !len
    !bytes
    return -2

L_BAD_VALUE_POS:
    !value_bad
    !value_pos
    !malformed
    !missing
    !nodes_pos
    !root_index
    !scene_index
    !len
    !bytes
    return -2

L_MISSING:
