@sa3d_gltf_raw_attribute_copy_element(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64, byte_len: i64) -> void:
L_ENTRY:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, byte_len
    br done -> L_DONE, L_BODY

L_BODY:
    src_delta = add src_pos, idx
    dst_delta = add dst_pos, idx
    src_ptr = ptr_add buffer, src_delta
    dst_ptr = ptr_add dst, dst_delta
    byte = load src_ptr+0 as u8
    store dst_ptr+0, byte as u8
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !byte
    !dst_ptr
    !src_ptr
    !dst_delta
    !src_delta
    !done
    !idx
    jmp L_HEAD

L_DONE:
    !done
    !idx
    !byte_len
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

