    !len
    !bytes
    return -2

L_MALFORMED_STRING_M:
    !bad_m
    !skipped_m
    !matched
    !root_key_candidate
    !no_array
    !at_root_object
    !arr_depth
    !obj_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !after_root
    !is_object
    !root_byte
