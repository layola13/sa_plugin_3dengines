@sa3d_gltf_label_write_byte(&dst: ptr, cap: i64, pos: i64, byte: u8) -> i64:
L_ENTRY:
    in_bounds = slt pos, cap
    nonnegative = sge pos, 0
    ok = and in_bounds, nonnegative
    br ok -> L_WRITE, L_FAIL

L_WRITE:
    out_ptr = ptr_add dst, pos
    store out_ptr+0, byte as u8
    next = add pos, 1
    !out_ptr
    !ok
    !nonnegative
    !in_bounds
    !byte
    !pos
    !cap
    !dst
    return next

L_FAIL:
    !ok
    !nonnegative
    !in_bounds
    !byte
    !pos
    !cap
    !dst
    return -1

@sa3d_gltf_label_copy_bytes(&dst: ptr, cap: i64, pos: i64, &src: ptr, len: i64) -> i64:
L_ENTRY:
    i_slot = stack_alloc 8
    pos_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    store pos_slot+0, pos as i64
    jmp L_CHECK

L_CHECK:
    i = load i_slot+0 as i64
    done = sge i, len
    br done -> L_DONE, L_COPY

L_COPY:
    cur_src = ptr_add src, i
    b = load cur_src+0 as u8
    cur_pos = load pos_slot+0 as i64
    next_pos = call @sa3d_gltf_label_write_byte(&dst, cap, cur_pos, b)
    failed = slt next_pos, 0
    br failed -> L_FAIL, L_NEXT

L_NEXT:
    next_i = add i, 1
    store i_slot+0, next_i as i64
    store pos_slot+0, next_pos as i64
    !next_i
    !failed
    !next_pos
    !cur_pos
    !b
    !cur_src
    !done
    !i
    jmp L_CHECK

L_DONE:
    out = load pos_slot+0 as i64
    !done
    !i
    !len
    !src
    !pos
    !cap
    !dst
    return out

L_FAIL:
    !failed
    !next_pos
    !cur_pos
    !b
    !cur_src
    !done
    !i
    !len
    !src
    !pos
    !cap
    !dst
    return -1

@sa3d_gltf_label_write_i64_decimal(&dst: ptr, cap: i64, pos: i64, value: i64) -> i64:
L_ENTRY:
    negative = slt value, 0
    br negative -> L_FAIL, L_ZERO_CHECK

L_ZERO_CHECK:
    is_zero = eq value, 0
    br is_zero -> L_ZERO, L_BUILD

L_ZERO:
    out_zero = call @sa3d_gltf_label_write_byte(&dst, cap, pos, 48)
    !is_zero
    !negative
    !value
    !pos
    !cap
    !dst
    return out_zero

L_BUILD:
    digits = stack_alloc 20
    count_slot = stack_alloc 8
    cur_slot = stack_alloc 8
    pos_slot = stack_alloc 8
    store count_slot+0, 0 as i64
    store cur_slot+0, value as i64
    store pos_slot+0, pos as i64
    jmp L_DIGIT_CHECK

L_DIGIT_CHECK:
    cur = load cur_slot+0 as i64
    done_digits = eq cur, 0
    br done_digits -> L_WRITE_CHECK, L_DIGIT

L_DIGIT:
    q = sdiv cur, 10
    q10 = mul q, 10
    rem = sub cur, q10
    digit = add rem, 48
    digit8 = trunc digit as u8
    count = load count_slot+0 as i64
    digit_ptr = ptr_add digits, count
    store digit_ptr+0, digit8 as u8
    next_count = add count, 1
    store count_slot+0, next_count as i64
    store cur_slot+0, q as i64
    !next_count
    !digit_ptr
    !count
    !digit8
    !digit
    !rem
    !q10
    !q
    !done_digits
    !cur
    jmp L_DIGIT_CHECK

L_WRITE_CHECK:
    count2 = load count_slot+0 as i64
    done_write = eq count2, 0
    br done_write -> L_DONE, L_WRITE_DIGIT

L_WRITE_DIGIT:
    prev_count = sub count2, 1
    src_digit = ptr_add digits, prev_count
    byte = load src_digit+0 as u8
    cur_pos2 = load pos_slot+0 as i64
    next_pos2 = call @sa3d_gltf_label_write_byte(&dst, cap, cur_pos2, byte)
    failed2 = slt next_pos2, 0
    br failed2 -> L_FAIL_WRITE, L_WRITE_NEXT

L_WRITE_NEXT:
    store count_slot+0, prev_count as i64
    store pos_slot+0, next_pos2 as i64
    !failed2
    !next_pos2
    !cur_pos2
    !byte
    !src_digit
    !prev_count
    !done_write
    !count2
    jmp L_WRITE_CHECK

L_DONE:
    out = load pos_slot+0 as i64
    !done_write
    !count2
    !is_zero
    !negative
    !value
    !pos
    !cap
    !dst
    return out

L_FAIL_WRITE:
    !failed2
    !next_pos2
    !cur_pos2
    !byte
    !src_digit
    !prev_count
    !done_write
    !count2
    !is_zero
    !negative
    !value
    !pos
    !cap
    !dst
    return -1

L_FAIL:
    !negative
    !value
    !pos
    !cap
    !dst
    return -1

@sa3d_gltf_label_write_prefixed_index(&dst: ptr, cap: i64, &prefix: ptr, prefix_len: i64, index: i64) -> i64:
L_ENTRY:
    p = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &prefix, prefix_len)
    failed = slt p, 0
    br failed -> L_FAIL, L_INDEX

L_INDEX:
    out = call @sa3d_gltf_label_write_i64_decimal(&dst, cap, p, index)
    !failed
    !p
    !index
    !prefix_len
    !prefix
    !cap
    !dst
    return out

L_FAIL:
    !failed
    !p
    !index
    !prefix_len
    !prefix
    !cap
    !dst
    return -1

@sa3d_gltf_asset_label_to_bytes(&label: ptr, &dst: ptr, cap: i64) -> i64:
L_ENTRY:
    kind = load label+SA3D_GLTF_ASSET_LABEL_kind as i32
    is_scene = eq kind, SA3D_GLTF_LABEL_SCENE
    br is_scene -> L_SCENE, L_NODE_CHECK

L_NODE_CHECK:
    is_node = eq kind, SA3D_GLTF_LABEL_NODE
    br is_node -> L_NODE, L_MESH_CHECK

L_MESH_CHECK:
    is_mesh = eq kind, SA3D_GLTF_LABEL_MESH
    br is_mesh -> L_MESH, L_PRIMITIVE_CHECK

L_PRIMITIVE_CHECK:
    is_primitive = eq kind, SA3D_GLTF_LABEL_PRIMITIVE
    br is_primitive -> L_PRIMITIVE, L_TEXTURE_CHECK

L_TEXTURE_CHECK:
    is_texture = eq kind, SA3D_GLTF_LABEL_TEXTURE
    br is_texture -> L_TEXTURE, L_MATERIAL_CHECK

L_MATERIAL_CHECK:
    is_material = eq kind, SA3D_GLTF_LABEL_MATERIAL
    br is_material -> L_MATERIAL, L_DEFAULT_CHECK

L_DEFAULT_CHECK:
    is_default = eq kind, SA3D_GLTF_LABEL_DEFAULT_MATERIAL
    br is_default -> L_DEFAULT, L_ANIMATION_CHECK

L_ANIMATION_CHECK:
    is_animation = eq kind, SA3D_GLTF_LABEL_ANIMATION
    br is_animation -> L_ANIMATION, L_SKIN_CHECK

L_SKIN_CHECK:
    is_skin = eq kind, SA3D_GLTF_LABEL_SKIN
    br is_skin -> L_SKIN, L_IBM_CHECK

L_IBM_CHECK:
    is_ibm = eq kind, SA3D_GLTF_LABEL_INVERSE_BIND_MATRICES
    br is_ibm -> L_IBM, L_FAIL

L_SCENE:
    idx_scene = load label+SA3D_GLTF_ASSET_LABEL_index as i64
    out_scene = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_SCENE, 5, idx_scene)
    !idx_scene
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_scene

L_NODE:
    idx_node = load label+SA3D_GLTF_ASSET_LABEL_index as i64
    out_node = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_NODE, 4, idx_node)
    !idx_node
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_node

L_MESH:
    idx_mesh = load label+SA3D_GLTF_ASSET_LABEL_index as i64
    out_mesh = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_MESH, 4, idx_mesh)
    !idx_mesh
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_mesh

L_PRIMITIVE:
    mesh = load label+SA3D_GLTF_ASSET_LABEL_mesh as i64
    primitive = load label+SA3D_GLTF_ASSET_LABEL_primitive as i64
    p0 = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_MESH, 4, mesh)
    p0_failed = slt p0, 0
    br p0_failed -> L_PRIMITIVE_FAIL, L_PRIMITIVE_SLASH

L_PRIMITIVE_SLASH:
    p1 = call @sa3d_gltf_label_write_byte(&dst, cap, p0, 47)
    p1_failed = slt p1, 0
    br p1_failed -> L_PRIMITIVE_FAIL2, L_PRIMITIVE_TEXT

L_PRIMITIVE_TEXT:
    p2 = call @sa3d_gltf_label_copy_bytes(&dst, cap, p1, &SA3D_GLTF_LABEL_TEXT_PRIMITIVE, 9)
    p2_failed = slt p2, 0
    br p2_failed -> L_PRIMITIVE_FAIL3, L_PRIMITIVE_INDEX

L_PRIMITIVE_INDEX:
    out_primitive = call @sa3d_gltf_label_write_i64_decimal(&dst, cap, p2, primitive)
    !p2_failed
    !p2
    !p1_failed
    !p1
    !p0_failed
    !p0
    !primitive
    !mesh
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_primitive

L_PRIMITIVE_FAIL:
    !p0_failed
    !p0
    !primitive
    !mesh
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return -1

L_PRIMITIVE_FAIL2:
    !p1_failed
    !p1
    !p0_failed
    !p0
    !primitive
    !mesh
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return -1

L_PRIMITIVE_FAIL3:
    !p2_failed
    !p2
    !p1_failed
    !p1
    !p0_failed
    !p0
    !primitive
    !mesh
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return -1

L_TEXTURE:
    idx_texture = load label+SA3D_GLTF_ASSET_LABEL_index as i64
    out_texture = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_TEXTURE, 7, idx_texture)
    !idx_texture
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_texture

L_MATERIAL:
    idx_material = load label+SA3D_GLTF_ASSET_LABEL_index as i64
    inverted = load label+SA3D_GLTF_ASSET_LABEL_is_scale_inverted as i32
    pmat = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_MATERIAL, 8, idx_material)
    inv = ne inverted, 0
    br inv -> L_MATERIAL_INVERTED, L_MATERIAL_DONE

L_MATERIAL_DONE:
    !inv
    !inverted
    !idx_material
    !is_material
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return pmat

L_MATERIAL_INVERTED:
    out_mat_inv = call @sa3d_gltf_label_copy_bytes(&dst, cap, pmat, &SA3D_GLTF_LABEL_TEXT_INVERTED, 11)
    !inv
    !pmat
    !inverted
    !idx_material
    !is_material
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_mat_inv

L_DEFAULT:
    out_default = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &SA3D_GLTF_LABEL_TEXT_DEFAULT_MATERIAL, 15)
    !is_default
    !is_material
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_default

L_ANIMATION:
    idx_animation = load label+SA3D_GLTF_ASSET_LABEL_index as i64
    out_animation = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_ANIMATION, 9, idx_animation)
    !idx_animation
    !is_animation
    !is_default
    !is_material
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_animation

L_SKIN:
    idx_skin = load label+SA3D_GLTF_ASSET_LABEL_index as i64
    out_skin = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_SKIN, 4, idx_skin)
    !idx_skin
    !is_skin
    !is_animation
    !is_default
    !is_material
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_skin

L_IBM:
    idx_ibm = load label+SA3D_GLTF_ASSET_LABEL_index as i64
    pibm0 = call @sa3d_gltf_label_write_prefixed_index(&dst, cap, &SA3D_GLTF_LABEL_TEXT_SKIN, 4, idx_ibm)
    pibm0_failed = slt pibm0, 0
    br pibm0_failed -> L_IBM_FAIL, L_IBM_SLASH

L_IBM_SLASH:
    pibm1 = call @sa3d_gltf_label_write_byte(&dst, cap, pibm0, 47)
    pibm1_failed = slt pibm1, 0
    br pibm1_failed -> L_IBM_FAIL2, L_IBM_TEXT

L_IBM_TEXT:
    out_ibm = call @sa3d_gltf_label_copy_bytes(&dst, cap, pibm1, &SA3D_GLTF_LABEL_TEXT_INVERSE_BIND_MATRICES, 19)
    !pibm1_failed
    !pibm1
    !pibm0_failed
    !pibm0
    !idx_ibm
    !is_ibm
    !is_skin
    !is_animation
    !is_default
    !is_material
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return out_ibm

L_IBM_FAIL:
    !pibm0_failed
    !pibm0
    !idx_ibm
    !is_ibm
    !is_skin
    !is_animation
    !is_default
    !is_material
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return -1

L_IBM_FAIL2:
    !pibm1_failed
    !pibm1
    !pibm0_failed
    !pibm0
    !idx_ibm
    !is_ibm
    !is_skin
    !is_animation
    !is_default
    !is_material
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return -1

L_FAIL:
    !is_ibm
    !is_skin
    !is_animation
    !is_default
    !is_material
    !is_texture
    !is_primitive
    !is_mesh
    !is_node
    !is_scene
    !kind
    !cap
    !dst
    !label
    return -1

@sa3d_gltf_asset_label_from_asset(&label: ptr, &asset_path: ptr, asset_path_len: i64, &dst: ptr, cap: i64) -> i64:
L_ENTRY:
    p0 = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &asset_path, asset_path_len)
    p0_failed = slt p0, 0
    br p0_failed -> L_FAIL, L_HASH

L_HASH:
    p1 = call @sa3d_gltf_label_write_byte(&dst, cap, p0, 35)
    p1_failed = slt p1, 0
    br p1_failed -> L_FAIL2, L_LABEL

L_LABEL:
    label_dst = ptr_add dst, p1
    remaining = sub cap, p1
    label_len = call @sa3d_gltf_asset_label_to_bytes(&label, &label_dst, remaining)
    label_failed = slt label_len, 0
    br label_failed -> L_FAIL3, L_DONE

L_DONE:
    out = add p1, label_len
    !label_failed
    !label_len
    !remaining
    !label_dst
    !p1_failed
    !p1
    !p0_failed
    !p0
    !cap
    !dst
    !asset_path_len
    !asset_path
    !label
    return out

L_FAIL:
    !p0_failed
    !p0
    !cap
    !dst
    !asset_path_len
    !asset_path
    !label
    return -1

L_FAIL2:
    !p1_failed
    !p1
    !p0_failed
    !p0
    !cap
    !dst
    !asset_path_len
    !asset_path
    !label
    return -1

L_FAIL3:
    !label_failed
    !label_len
    !remaining
    !label_dst
    !p1_failed
    !p1
    !p0_failed
    !p0
    !cap
    !dst
    !asset_path_len
    !asset_path
    !label
    return -1

@sa3d_gltf_primitive_topology(mode: i32) -> i32:
L_ENTRY:
    is_points = eq mode, SA3D_GLTF_MODE_POINTS
    br is_points -> L_POINTS, L_LINES_CHECK

L_POINTS:
    !is_points
    !mode
    return SA3D_GLTF_PRIMITIVE_TOPOLOGY_POINT_LIST

L_LINES_CHECK:
    is_lines = eq mode, SA3D_GLTF_MODE_LINES
    br is_lines -> L_LINES, L_LINE_STRIP_CHECK

L_LINES:
    !is_lines
    !is_points
    !mode
    return SA3D_GLTF_PRIMITIVE_TOPOLOGY_LINE_LIST

L_LINE_STRIP_CHECK:
    is_line_strip = eq mode, SA3D_GLTF_MODE_LINE_STRIP
    br is_line_strip -> L_LINE_STRIP, L_TRIANGLES_CHECK

L_LINE_STRIP:
    !is_line_strip
    !is_lines
    !is_points
    !mode
    return SA3D_GLTF_PRIMITIVE_TOPOLOGY_LINE_STRIP

L_TRIANGLES_CHECK:
    is_triangles = eq mode, SA3D_GLTF_MODE_TRIANGLES
    br is_triangles -> L_TRIANGLES, L_TRIANGLE_STRIP_CHECK

L_TRIANGLES:
    !is_triangles
    !is_line_strip
    !is_lines
    !is_points
    !mode
    return SA3D_GLTF_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST

L_TRIANGLE_STRIP_CHECK:
    is_triangle_strip = eq mode, SA3D_GLTF_MODE_TRIANGLE_STRIP
    br is_triangle_strip -> L_TRIANGLE_STRIP, L_UNSUPPORTED

L_TRIANGLE_STRIP:
    !is_triangle_strip
    !is_triangles
    !is_line_strip
    !is_lines
    !is_points
    !mode
    return SA3D_GLTF_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP

L_UNSUPPORTED:
    !is_triangle_strip
    !is_triangles
    !is_line_strip
    !is_lines
    !is_points
    !mode
    return SA3D_GLTF_PRIMITIVE_TOPOLOGY_UNSUPPORTED

@sa3d_gltf_primitive_topology_is_supported(mode: i32) -> i32:
L_ENTRY:
    topology = call @sa3d_gltf_primitive_topology(mode)
    ok = ne topology, SA3D_GLTF_PRIMITIVE_TOPOLOGY_UNSUPPORTED
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !topology
    !mode
    return 1

L_FALSE:
    !ok
    !topology
    !mode
    return 0

@sa3d_gltf_primitive_mesh_init(&mesh: ptr) -> void:
L_ENTRY:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_topology, SA3D_GLTF_PRIMITIVE_TOPOLOGY_UNSUPPORTED as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_attribute_count, 0 as i64
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_vertex_count, 0 as i64
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_vertex_count_mismatch, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_position, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_normal, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_tangent, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_color, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_uv0, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_uv1, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_joint_index, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_joint_weight, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_ignored_skinned_attributes, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_mixed_skinned_usage, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_indices, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_index_count, 0 as i64
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_index_max, 0 as i64
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_source_index_format, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_stored_index_format, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_compute_flat_normals, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_generate_tangents, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_generate_skinned_bounds, 0 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_draw_count, 0 as i64
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_triangle_count, 0 as i64
    !mesh
    return

@sa3d_gltf_primitive_mesh_begin(&mesh: ptr, mode: i32) -> i32:
L_ENTRY:
    call @sa3d_gltf_primitive_mesh_init(&mesh)
    topology = call @sa3d_gltf_primitive_topology(mode)
    supported = ne topology, SA3D_GLTF_PRIMITIVE_TOPOLOGY_UNSUPPORTED
    br supported -> L_OK, L_UNSUPPORTED

L_OK:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_topology, topology as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK as i32
    !supported
    !topology
    !mode
    !mesh
    return SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK

L_UNSUPPORTED:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_topology, topology as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_UNSUPPORTED_PRIMITIVE as i32
    !supported
    !topology
    !mode
    !mesh
    return SA3D_GLTF_PRIMITIVE_MESH_STATUS_UNSUPPORTED_PRIMITIVE

@sa3d_gltf_primitive_mesh_add_attribute(&mesh: ptr, attribute: i32, vertex_count: i64, materialize_status: i32, mesh_on_skinned_nodes: i32, mesh_on_non_skinned_nodes: i32) -> i32:
L_ENTRY:
    ok_status = eq materialize_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    br ok_status -> L_SKIN_CHECK, L_SKIP_STATUS

L_SKIN_CHECK:
    is_joint_index = eq attribute, SA3D_GLTF_ATTRIBUTE_JOINT_INDEX
    is_joint_weight = eq attribute, SA3D_GLTF_ATTRIBUTE_JOINT_WEIGHT
    is_skinned_attr = or is_joint_index, is_joint_weight
    on_skinned = ne mesh_on_skinned_nodes, 0
    not_on_skinned = eq on_skinned, 0
    skip_skinned = and is_skinned_attr, not_on_skinned
    br skip_skinned -> L_SKIP_SKINNED, L_MIXED_CHECK

L_MIXED_CHECK:
    on_non_skinned = ne mesh_on_non_skinned_nodes, 0
    mixed = and is_skinned_attr, on_non_skinned
    br mixed -> L_MARK_MIXED, L_INSERT

L_MARK_MIXED:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_mixed_skinned_usage, 1 as i32
    jmp L_INSERT

L_INSERT:
    old_count = load mesh+SA3D_GLTF_PRIMITIVE_MESH_attribute_count as i64
    next_count = add old_count, 1
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_attribute_count, next_count as i64
    has_existing_count = sgt old_count, 0
    current_vertices = load mesh+SA3D_GLTF_PRIMITIVE_MESH_vertex_count as i64
    same_vertices = eq current_vertices, vertex_count
    mismatch = and has_existing_count, same_vertices
    mismatch_final = eq mismatch, 0
    real_mismatch = and has_existing_count, mismatch_final
    br has_existing_count -> L_COUNT_CHECK, L_COUNT_SET

L_COUNT_SET:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_vertex_count, vertex_count as i64
    jmp L_FLAGS

L_COUNT_CHECK:
    br real_mismatch -> L_COUNT_MISMATCH, L_FLAGS

L_COUNT_MISMATCH:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_vertex_count_mismatch, 1 as i32
    jmp L_FLAGS

L_FLAGS:
    old_pos = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_position as i32
    old_normal = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_normal as i32
    old_tangent = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_tangent as i32
    old_color = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_color as i32
    old_uv0 = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_uv0 as i32
    old_uv1 = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_uv1 as i32
    old_joint_index = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_joint_index as i32
    old_joint_weight = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_joint_weight as i32
    is_pos = eq attribute, SA3D_GLTF_ATTRIBUTE_POSITION
    is_normal_attr = eq attribute, SA3D_GLTF_ATTRIBUTE_NORMAL
    is_tangent_attr = eq attribute, SA3D_GLTF_ATTRIBUTE_TANGENT
    is_color_attr = eq attribute, SA3D_GLTF_ATTRIBUTE_COLOR
    is_uv0_attr = eq attribute, SA3D_GLTF_ATTRIBUTE_UV_0
    is_uv1_attr = eq attribute, SA3D_GLTF_ATTRIBUTE_UV_1
    pos_flag = or old_pos, is_pos
    normal_flag = or old_normal, is_normal_attr
    tangent_flag = or old_tangent, is_tangent_attr
    color_flag = or old_color, is_color_attr
    uv0_flag = or old_uv0, is_uv0_attr
    uv1_flag = or old_uv1, is_uv1_attr
    joint_index_flag = or old_joint_index, is_joint_index
    joint_weight_flag = or old_joint_weight, is_joint_weight
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_position, pos_flag as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_normal, normal_flag as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_tangent, tangent_flag as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_color, color_flag as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_uv0, uv0_flag as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_uv1, uv1_flag as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_joint_index, joint_index_flag as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_joint_weight, joint_weight_flag as i32
    !joint_weight_flag
    !joint_index_flag
    !uv1_flag
    !uv0_flag
    !color_flag
    !tangent_flag
    !normal_flag
    !pos_flag
    !is_uv1_attr
    !is_uv0_attr
    !is_color_attr
    !is_tangent_attr
    !is_normal_attr
    !is_pos
    !old_joint_weight
    !old_joint_index
    !old_uv1
    !old_uv0
    !old_color
    !old_tangent
    !old_normal
    !old_pos
    !real_mismatch
    !mismatch_final
    !mismatch
    !same_vertices
    !current_vertices
    !has_existing_count
    !next_count
    !old_count
    !mixed
    !on_non_skinned
    !skip_skinned
    !not_on_skinned
    !on_skinned
    !is_skinned_attr
    !is_joint_weight
    !is_joint_index
    !ok_status
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !materialize_status
    !vertex_count
    !attribute
    !mesh
    return 1

L_SKIP_SKINNED:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_ignored_skinned_attributes, 1 as i32
    !skip_skinned
    !not_on_skinned
    !on_skinned
    !is_skinned_attr
    !is_joint_weight
    !is_joint_index
    !ok_status
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !materialize_status
    !vertex_count
    !attribute
    !mesh
    return 0

L_SKIP_STATUS:
    !ok_status
    !mesh_on_non_skinned_nodes
    !mesh_on_skinned_nodes
    !materialize_status
    !vertex_count
    !attribute
    !mesh
    return 0

@sa3d_gltf_primitive_mesh_set_indices(&mesh: ptr, &scan: ptr, source_index_format: i32) -> i32:
L_ENTRY:
    scan_status = load scan+SA3D_GLTF_INDEX_SCAN_RESULT_status as i32
    ok = eq scan_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK
    br ok -> L_SET, L_BAD

L_SET:
    count = load scan+SA3D_GLTF_INDEX_SCAN_RESULT_count as i64
    max_index = load scan+SA3D_GLTF_INDEX_SCAN_RESULT_max_index as i64
    is_u32 = eq source_index_format, SA3D_GLTF_INDEX_FORMAT_U32
    br is_u32 -> L_STORE_U32, L_STORE_U16

L_STORE_U32:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_indices, 1 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_index_count, count as i64
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_index_max, max_index as i64
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_source_index_format, source_index_format as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_stored_index_format, SA3D_GLTF_INDEX_FORMAT_U32 as i32
    !is_u32
    !max_index
    !count
    !ok
    !scan_status
    !source_index_format
    !scan
    !mesh
    return 1

L_STORE_U16:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_has_indices, 1 as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_index_count, count as i64
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_index_max, max_index as i64
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_source_index_format, source_index_format as i32
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_stored_index_format, SA3D_GLTF_INDEX_FORMAT_U16 as i32
    !is_u32
    !max_index
    !count
    !ok
    !scan_status
    !source_index_format
    !scan
    !mesh
    return 1

L_BAD:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_BAD_INDICES as i32
    !ok
    !scan_status
    !source_index_format
    !scan
    !mesh
    return 0

@sa3d_gltf_primitive_mesh_triangle_count(topology: i32, draw_count: i64) -> i64:
L_ENTRY:
    is_list = eq topology, SA3D_GLTF_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    br is_list -> L_LIST, L_STRIP_CHECK

L_LIST:
    triangles = sdiv draw_count, 3
    !is_list
    !draw_count
    !topology
    return triangles

L_STRIP_CHECK:
    is_strip = eq topology, SA3D_GLTF_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP
    enough = sge draw_count, 3
    ok = and is_strip, enough
    br ok -> L_STRIP, L_ZERO

L_STRIP:
    triangles = sub draw_count, 2
    !ok
    !enough
    !is_strip
    !is_list
    !draw_count
    !topology
    return triangles

L_ZERO:
    !ok
    !enough
    !is_strip
    !is_list
    !draw_count
    !topology
    return 0

@sa3d_gltf_primitive_mesh_finalize(&mesh: ptr, material_needs_tangents: i32, skinned_bounds_policy: i32, mesh_on_skinned_nodes: i32) -> i32:
L_ENTRY:
    status = load mesh+SA3D_GLTF_PRIMITIVE_MESH_status as i32
    status_ok = eq status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK
    br status_ok -> L_FINALIZE, L_RETURN_STATUS

L_FINALIZE:
    topology = load mesh+SA3D_GLTF_PRIMITIVE_MESH_topology as i32
    has_normal = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_normal as i32
    has_tangent = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_tangent as i32
    has_indices = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_indices as i32
    vertex_count = load mesh+SA3D_GLTF_PRIMITIVE_MESH_vertex_count as i64
    index_count = load mesh+SA3D_GLTF_PRIMITIVE_MESH_index_count as i64
    is_tri_list = eq topology, SA3D_GLTF_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    no_normal = eq has_normal, 0
    compute_normals = and no_normal, is_tri_list
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_compute_flat_normals, compute_normals as i32
    effective_normal = or has_normal, compute_normals
    no_tangent = eq has_tangent, 0
    needs_tangent_bool = ne material_needs_tangents, 0
    tangent_a = and no_tangent, effective_normal
    generate_tangent = and tangent_a, needs_tangent_bool
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_generate_tangents, generate_tangent as i32
    dynamic_policy = eq skinned_bounds_policy, SA3D_GLTF_SKINNED_BOUNDS_DYNAMIC
    on_skinned = ne mesh_on_skinned_nodes, 0
    gen_bounds = and dynamic_policy, on_skinned
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_generate_skinned_bounds, gen_bounds as i32
    br has_indices -> L_DRAW_INDEXED, L_DRAW_VERTICES

L_DRAW_INDEXED:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_draw_count, index_count as i64
    triangles_i = call @sa3d_gltf_primitive_mesh_triangle_count(topology, index_count)
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_triangle_count, triangles_i as i64
    !triangles_i
    !gen_bounds
    !on_skinned
    !dynamic_policy
    !generate_tangent
    !tangent_a
    !needs_tangent_bool
    !no_tangent
    !effective_normal
    !compute_normals
    !no_normal
    !is_tri_list
    !index_count
    !vertex_count
    !has_indices
    !has_tangent
    !has_normal
    !topology
    !status_ok
    !status
    !mesh_on_skinned_nodes
    !skinned_bounds_policy
    !material_needs_tangents
    !mesh
    return SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK

L_DRAW_VERTICES:
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_draw_count, vertex_count as i64
    triangles_v = call @sa3d_gltf_primitive_mesh_triangle_count(topology, vertex_count)
    store mesh+SA3D_GLTF_PRIMITIVE_MESH_triangle_count, triangles_v as i64
    !triangles_v
    !gen_bounds
    !on_skinned
    !dynamic_policy
    !generate_tangent
    !tangent_a
    !needs_tangent_bool
    !no_tangent
    !effective_normal
    !compute_normals
    !no_normal
    !is_tri_list
    !index_count
    !vertex_count
    !has_indices
    !has_tangent
    !has_normal
    !topology
    !status_ok
    !status
    !mesh_on_skinned_nodes
    !skinned_bounds_policy
    !material_needs_tangents
    !mesh
    return SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK

L_RETURN_STATUS:
    !status_ok
    !mesh_on_skinned_nodes
    !skinned_bounds_policy
    !material_needs_tangents
    !mesh
    return status

@sa3d_gltf_json_texture_info_parse(bytes: ptr, len: i64, object_pos: i64, &out_index: ptr, &out_tex_coord: ptr) -> i32:
L_ENTRY:
    index_slot = stack_alloc 8
    tex_slot = stack_alloc 8
    index_status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_INDEX, 5, &index_slot)
    index_ok = eq index_status, 1
    br index_ok -> L_TEX_COORD, L_INDEX_MISSING_CHECK

L_INDEX_MISSING_CHECK:
    index_missing = eq index_status, 0
    br index_missing -> L_MISSING_INDEX, L_MALFORMED_INDEX

L_TEX_COORD:
    index_value = load index_slot+0 as i64
    tex_status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_TEX_COORD, 8, &tex_slot)
    tex_bad = slt tex_status, 0
    br tex_bad -> L_MALFORMED_TEX, L_TEX_MISSING_CHECK

L_TEX_MISSING_CHECK:
    tex_missing = eq tex_status, 0
    br tex_missing -> L_TEX_DEFAULT, L_TEX_FOUND

L_TEX_DEFAULT:
    store out_index+0, index_value as i64
    store out_tex_coord+0, 0 as i64
    !tex_missing
    !tex_bad
    !tex_status
    !index_value
    !index_ok
    !index_status
    !out_tex_coord
    !out_index
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_TEX_FOUND:
    tex_value = load tex_slot+0 as i64
    store out_index+0, index_value as i64
    store out_tex_coord+0, tex_value as i64
    !tex_value
    !tex_missing
    !tex_bad
    !tex_status
    !index_value
    !index_ok
    !index_status
    !out_tex_coord
    !out_index
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING_INDEX:
    store out_index+0, 0 as i64
    store out_tex_coord+0, 0 as i64
    !index_missing
    !index_ok
    !index_status
    !out_tex_coord
    !out_index
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_INDEX:
    store out_index+0, 0 as i64
    store out_tex_coord+0, 0 as i64
    !index_missing
    !index_ok
    !index_status
    !out_tex_coord
    !out_index
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_TEX:
    store out_index+0, 0 as i64
    store out_tex_coord+0, 0 as i64
    !tex_bad
    !tex_status
    !index_value
    !index_ok
    !index_status
    !out_tex_coord
    !out_index
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_object_texture_info_field_parse(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out_index: ptr, &out_tex_coord: ptr) -> i32:
L_ENTRY:
    texture_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, key, key_len)
    missing = eq texture_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq texture_pos, -2
    br malformed -> L_MALFORMED, L_PARSE

L_PARSE:
    status = call @sa3d_gltf_json_texture_info_parse(bytes, len, texture_pos, &out_index, &out_tex_coord)
    !malformed
    !missing
    !texture_pos
    !out_tex_coord
    !out_index
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return status

L_MISSING:
    store out_index+0, 0 as i64
    store out_tex_coord+0, 0 as i64
    !missing
    !texture_pos
    !out_tex_coord
    !out_index
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out_index+0, 0 as i64
    store out_tex_coord+0, 0 as i64
    !malformed
    !missing
    !texture_pos
    !out_tex_coord
    !out_index
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_MATERIAL_TABLE_has_base_color_texture, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_texture, 0 as i64
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_uv, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_normal_texture, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_normal_texture, 0 as i64
    store out+SA3D_GLTF_MATERIAL_TABLE_normal_uv, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_metallic_roughness_texture, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_metallic_roughness_texture, 0 as i64
    store out+SA3D_GLTF_MATERIAL_TABLE_metallic_roughness_uv, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_occlusion_texture, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_occlusion_texture, 0 as i64
    store out+SA3D_GLTF_MATERIAL_TABLE_occlusion_uv, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_emissive_texture, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_emissive_texture, 0 as i64
    store out+SA3D_GLTF_MATERIAL_TABLE_emissive_uv, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_linear_texture_mask, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_texture_mask, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_needs_tangents, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_double_sided, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_unlit, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_gltf_alpha_mode, SA3D_GLTF_ALPHA_MODE_OPAQUE as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_alpha_mode, SA3D_ALPHA_MODE_OPAQUE as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_alpha_cutoff, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_alpha_cutoff_bits, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_r, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_g, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_b, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_a, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_metallic, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_roughness, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_emissive_r, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_emissive_g, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_emissive_b, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_base_color_factor, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_metallic_factor, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_roughness_factor, 0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_emissive_factor, 0 as i32
    !out
    return

@sa3d_gltf_json_material_table_set_texture(&out: ptr, has_offset: i64, index_offset: i64, uv_offset: i64, texture_index: i64, tex_coord: i64, usage_bit: i32, linear_bit: i32) -> void:
L_ENTRY:
    has_ptr = ptr_add out, has_offset
    index_ptr = ptr_add out, index_offset
    uv_ptr = ptr_add out, uv_offset
    tex_i32 = trunc tex_coord as i32
    uv_channel = call @sa3d_gltf_uv_channel(tex_i32)
    old_mask = load out+SA3D_GLTF_MATERIAL_TABLE_texture_mask as i32
    next_mask = or old_mask, usage_bit
    old_linear = load out+SA3D_GLTF_MATERIAL_TABLE_linear_texture_mask as i32
    next_linear_raw = or old_linear, usage_bit
    is_linear = ne linear_bit, 0
    store has_ptr+0, 1 as i32
    store index_ptr+0, texture_index as i64
    store uv_ptr+0, uv_channel as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_texture_mask, next_mask as i32
    br is_linear -> L_STORE_LINEAR, L_DONE

L_STORE_LINEAR:
    store out+SA3D_GLTF_MATERIAL_TABLE_linear_texture_mask, next_linear_raw as i32
    !is_linear
    !next_linear_raw
    !old_linear
    !next_mask
    !old_mask
    !uv_channel
    !tex_i32
    !uv_ptr
    !index_ptr
    !has_ptr
    !linear_bit
    !usage_bit
    !tex_coord
    !texture_index
    !uv_offset
    !index_offset
    !has_offset
    !out
    return

L_DONE:
    !is_linear
    !next_linear_raw
    !old_linear
    !next_mask
    !old_mask
    !uv_channel
    !tex_i32
    !uv_ptr
    !index_ptr
    !has_ptr
    !linear_bit
    !usage_bit
    !tex_coord
    !texture_index
    !uv_offset
    !index_offset
    !has_offset
    !out
    return

@sa3d_gltf_json_material_table_parse_texture_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out: ptr, has_offset: i64, index_offset: i64, uv_offset: i64, usage_bit: i32, linear_bit: i32) -> i32:
L_ENTRY:
    index_slot = stack_alloc 8
    tex_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_texture_info_field_parse(bytes, len, object_pos, key, key_len, &index_slot, &tex_slot)
    ok = eq status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br ok -> L_SET, L_MISSING_CHECK

L_MISSING_CHECK:
    missing = eq status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED
    br missing -> L_MISSING, L_BAD

L_SET:
    texture_index = load index_slot+0 as i64
    tex_coord = load tex_slot+0 as i64
    call @sa3d_gltf_json_material_table_set_texture(&out, has_offset, index_offset, uv_offset, texture_index, tex_coord, usage_bit, linear_bit)
    !tex_coord
    !texture_index
    !ok
    !status
    !linear_bit
    !usage_bit
    !uv_offset
    !index_offset
    !has_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    !missing
    !ok
    !status
    !linear_bit
    !usage_bit
    !uv_offset
    !index_offset
    !has_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !missing
    !ok
    !status
    !linear_bit
    !usage_bit
    !uv_offset
    !index_offset
    !has_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_texture_info_parse(bytes: ptr, len: i64, material_index: i64, key: ptr, key_len: i64, &out_index: ptr, &out_tex_coord: ptr) -> i32:
L_ENTRY:
    material_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MATERIALS, 9, material_index)
    missing = eq material_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq material_pos, -2
    br malformed -> L_MALFORMED, L_PARSE

L_PARSE:
    status = call @sa3d_gltf_json_object_texture_info_field_parse(bytes, len, material_pos, key, key_len, &out_index, &out_tex_coord)
    !malformed
    !missing
    !material_pos
    !out_tex_coord
    !out_index
    !key_len
    !key
    !material_index
    !len
    !bytes
    return status

L_MISSING:
    store out_index+0, 0 as i64
    store out_tex_coord+0, 0 as i64
    !missing
    !material_pos
    !out_tex_coord
    !out_index
    !key_len
    !key
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out_index+0, 0 as i64
    store out_tex_coord+0, 0 as i64
    !malformed
    !missing
    !material_pos
    !out_tex_coord
    !out_index
    !key_len
    !key
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse_f32_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out: ptr, value_offset: i64, has_offset: i64) -> i32:
L_ENTRY:
    value_slot = stack_alloc 4
    status = call @sa3d_gltf_json_object_f32_bits_value(bytes, len, object_pos, key, key_len, &value_slot)
    missing = eq status, 0
    br missing -> L_OK_MISSING, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_STORE

L_STORE:
    value = load value_slot+0 as i32
    value_ptr = ptr_add out, value_offset
    has_ptr = ptr_add out, has_offset
    store value_ptr+0, value as i32
    store has_ptr+0, 1 as i32
    !has_ptr
    !value_ptr
    !value
    !bad
    !missing
    !status
    !has_offset
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !has_offset
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !missing
    !status
    !has_offset
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse_base_color_factor(bytes: ptr, len: i64, pbr_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    r_slot = stack_alloc 4
    g_slot = stack_alloc 4
    b_slot = stack_alloc 4
    a_slot = stack_alloc 4
    status = call @sa3d_gltf_json_object_f32_array4_value(bytes, len, pbr_pos, &SA3D_GLTF_JSON_KEY_BASE_COLOR_FACTOR, 15, &r_slot, &g_slot, &b_slot, &a_slot)
    missing = eq status, 0
    br missing -> L_OK_MISSING, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_STORE

L_STORE:
    r = load r_slot+0 as i32
    g = load g_slot+0 as i32
    b = load b_slot+0 as i32
    a = load a_slot+0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_r, r as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_g, g as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_b, b as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_base_color_a, a as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_base_color_factor, 1 as i32
    !a
    !b
    !g
    !r
    !bad
    !missing
    !status
    !out
    !pbr_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !out
    !pbr_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !missing
    !status
    !out
    !pbr_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse_pbr_factor_fields(bytes: ptr, len: i64, pbr_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    base_status = call @sa3d_gltf_json_material_table_parse_base_color_factor(bytes, len, pbr_pos, &out)
    metallic_status = call @sa3d_gltf_json_material_table_parse_f32_field(bytes, len, pbr_pos, &SA3D_GLTF_JSON_KEY_METALLIC_FACTOR, 14, &out, SA3D_GLTF_MATERIAL_TABLE_metallic, SA3D_GLTF_MATERIAL_TABLE_has_metallic_factor)
    roughness_status = call @sa3d_gltf_json_material_table_parse_f32_field(bytes, len, pbr_pos, &SA3D_GLTF_JSON_KEY_ROUGHNESS_FACTOR, 15, &out, SA3D_GLTF_MATERIAL_TABLE_roughness, SA3D_GLTF_MATERIAL_TABLE_has_roughness_factor)
    base_bad = ne base_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    metallic_bad = ne metallic_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    roughness_bad = ne roughness_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    a = or base_bad, metallic_bad
    bad = or a, roughness_bad
    br bad -> L_BAD, L_OK

L_OK:
    !bad
    !a
    !roughness_bad
    !metallic_bad
    !base_bad
    !roughness_status
    !metallic_status
    !base_status
    !out
    !pbr_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !a
    !roughness_bad
    !metallic_bad
    !base_bad
    !roughness_status
    !metallic_status
    !base_status
    !out
    !pbr_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse_emissive_factor(bytes: ptr, len: i64, material_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    r_slot = stack_alloc 4
