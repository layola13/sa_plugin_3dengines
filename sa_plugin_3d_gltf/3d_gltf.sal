    raw = call @sa3d_gltf_read_u16_le(buffer, src_pos)
    f = uitofp raw as f32
    n = fdiv f, 65535.0
    store out+0, n as f32
    !n
    !f
    !raw
    !out
    !dst_pos
    !dst
    !src_pos
    !buffer
    return

@sa3d_gltf_store_u8_as_u16_component(buffer: ptr, src_pos: i64, dst: ptr, dst_pos: i64) -> void:
L_ENTRY:
