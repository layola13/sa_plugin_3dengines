L_UNSUPPORTED_U8:
    !u8_vec4
    !u8_vec3
    !u8_vec2
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_UNSUPPORTED:
