    return 0

@sa3d_gltf_json_object_f32_bits_value(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out_bits: ptr) -> i32:
L_ENTRY:
    store out_bits+0, 0 as i32
    value_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, key, key_len)
    missing = eq value_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq value_pos, -2
    br malformed -> L_BAD, L_PARSE

L_PARSE:
    parsed = call @sa3d_gltf_json_parse_positive_f32_bits(bytes, len, value_pos, &out_bits)
    ok = ne parsed, 0
    br ok -> L_OK, L_BAD_VALUE

L_OK:
    !ok
    !parsed
    !malformed
    !missing
    !value_pos
    !out_bits
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 1

L_MISSING:
    !missing
    !value_pos
    !out_bits
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 0

L_BAD_VALUE:
    !ok
    !parsed
    !malformed
    !missing
    !value_pos
    !out_bits
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

L_BAD:
    !malformed
    !missing
    !value_pos
    !out_bits
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_parse_f32_bits(bytes: ptr, len: i64, value_pos: i64, &out_bits: ptr) -> i32:
L_ENTRY:
    pos = call @sa3d_gltf_json_skip_ws_from(bytes, len, value_pos)
    in_bounds = slt pos, len
    br in_bounds -> L_LOAD, L_BAD_BOUNDS

L_LOAD:
    p = ptr_add bytes, pos
    b = load p+0 as u8
    minus = eq b, 45
    br minus -> L_NEGATIVE, L_POSITIVE

L_POSITIVE:
    parsed = call @sa3d_gltf_json_parse_positive_f32_bits(bytes, len, pos, &out_bits)
    !minus
    !b
    !p
    !in_bounds
    !pos
    !value_pos
    !len
    !bytes
    return parsed

L_NEGATIVE:
    next = add pos, 1
    tmp_slot = stack_alloc 4
    parsed_neg = call @sa3d_gltf_json_parse_positive_f32_bits(bytes, len, next, &tmp_slot)
    ok_neg = ne parsed_neg, 0
    br ok_neg -> L_NEG_STORE, L_NEG_BAD

L_NEG_STORE:
    positive = load tmp_slot+0 as f32
    neg = fneg positive
    store out_bits+0, neg as f32
    !neg
    !positive
    !ok_neg
    !parsed_neg
    !next
    !minus
    !b
    !p
    !in_bounds
    !pos
    !value_pos
    !len
    !bytes
    return 1

L_NEG_BAD:
    !ok_neg
    !parsed_neg
    !next
    !minus
    !b
    !p
    !in_bounds
    !pos
    !value_pos
    !len
    !bytes
    return 0

L_BAD_BOUNDS:
    !in_bounds
    !pos
    !value_pos
    !out_bits
    !len
    !bytes
    return 0

@sa3d_gltf_json_delim_after_number(bytes: ptr, len: i64, value_pos: i64) -> i64:
L_ENTRY:
    pos = call @sa3d_gltf_json_skip_ws_from(bytes, len, value_pos)
    idx_slot = stack_alloc 8
    store idx_slot+0, pos as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_BAD_EOF, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    comma = eq b, 44
    close = eq b, 93
    space = eq b, 32
    tab = eq b, 9
    lf = eq b, 10
    cr = eq b, 13
    a0 = or comma, close
    a1 = or space, tab
    a2 = or lf, cr
    d0 = or a0, a1
    delim = or d0, a2
    br delim -> L_RETURN, L_NEXT

L_NEXT:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !delim
    !d0
    !a2
    !a1
    !a0
    !cr
    !lf
    !tab
    !space
    !close
    !comma
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_RETURN:
    !delim
    !d0
    !a2
    !a1
    !a0
    !cr
    !lf
    !tab
    !space
    !close
    !comma
    !b
    !p
    !done
    !pos
    !value_pos
    !len
    !bytes
    return idx

L_BAD_EOF:
    !done
    !idx
    !pos
    !value_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_expect_byte_after_number(bytes: ptr, len: i64, value_pos: i64, expected: u8) -> i64:
L_ENTRY:
    delim0 = call @sa3d_gltf_json_delim_after_number(bytes, len, value_pos)
    bad_delim = slt delim0, 0
    br bad_delim -> L_BAD, L_SKIP

L_SKIP:
    delim = call @sa3d_gltf_json_skip_ws_from(bytes, len, delim0)
    in_bounds = slt delim, len
    br in_bounds -> L_LOAD, L_BAD_BOUNDS

L_LOAD:
    p = ptr_add bytes, delim
    b = load p+0 as u8
    ok = eq b, expected
    br ok -> L_OK, L_BAD_BYTE

L_OK:
    next = add delim, 1
    !ok
    !b
    !p
    !in_bounds
    !delim
    !bad_delim
    !delim0
    !expected
    !value_pos
    !len
    !bytes
    return next

L_BAD_BYTE:
    !ok
    !b
    !p
    !in_bounds
    !delim
    !bad_delim
    !delim0
    !expected
    !value_pos
    !len
    !bytes
    return -1

L_BAD_BOUNDS:
    !in_bounds
    !delim
