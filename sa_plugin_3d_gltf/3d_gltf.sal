L_SPARSE_INDEX_RESOLVE_ERROR:
    mapped_index = call @sa3d_gltf_json_resolve_status_to_index_materialize_status(sparse_index_resolve)
    !sparse_index_ok
    !sparse_index_resolve
    !sparse_index_offset
