    value_view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    index_layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    value_layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    store out_len+0, 0 as i64
    store out_index_format+0, 0 as i32
    accessor_status = call @sa3d_gltf_json_accessor_parse(bytes, len, accessor_index, &accessor)
    accessor_ok = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_ok -> L_FORMAT, L_ACCESSOR_ERROR

L_FORMAT:
    component_type = load accessor+SA3D_GLTF_ACCESSOR_TABLE_component_type as i32
    index_format = call @sa3d_gltf_index_format_from_component_type(component_type)
    index_supported = ne index_format, 0
    br index_supported -> L_ACCESSOR_VALUES, L_UNSUPPORTED_FORMAT

L_ACCESSOR_VALUES:
    accessor_count = load accessor+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    has_bv = load accessor+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view as i32
    has_bv_bool = ne has_bv, 0
    br has_bv_bool -> L_BASE_RESOLVE, L_SPARSE_CHECK

L_BASE_RESOLVE:
    bv_i32 = load accessor+SA3D_GLTF_ACCESSOR_TABLE_buffer_view as i32
    bv_index = zext bv_i32 as i64
    accessor_offset = load accessor+SA3D_GLTF_ACCESSOR_TABLE_byte_offset as i64
    base_resolve = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, bv_index, buffer_index, buffer_len, accessor_offset, accessor_count, accessor_format, &base_view, &base_layout)
    base_ok = eq base_resolve, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br base_ok -> L_BASE_OK, L_BASE_RESOLVE_ERROR

L_BASE_OK:
    !base_ok
    !base_resolve
    !accessor_offset
    !bv_index
    !bv_i32
    jmp L_SPARSE_CHECK

L_SPARSE_CHECK:
    sparse_present_raw = call @sa3d_gltf_json_accessor_has_sparse(bytes, len, accessor_index)
    sparse_bad = slt sparse_present_raw, 0
    br sparse_bad -> L_MALFORMED_SPARSE, L_SPARSE_PRESENT_CHECK

L_SPARSE_PRESENT_CHECK:
    sparse_present = sgt sparse_present_raw, 0
    br sparse_present -> L_SPARSE_PARSE, L_FINAL_NO_SPARSE

L_FINAL_NO_SPARSE:
    final_no_status = call @sa3d_gltf_index_final_materialize_loop(buffer, accessor_count, has_bv, index_format, 0, 0, &base_layout, &index_layout, &value_layout, dst, cap, &out_len, &out_index_format)
    !sparse_present
    !sparse_present_raw
    !has_bv_bool
    !has_bv
    !accessor_format
    !accessor_count
    !index_supported
    !index_format
    !component_type
    !accessor_ok
    !accessor_status
    !out_index_format
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return final_no_status

L_SPARSE_PARSE:
    sparse_status = call @sa3d_gltf_json_accessor_sparse_parse(bytes, len, accessor_index, &sparse)
    sparse_ok = eq sparse_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br sparse_ok -> L_SPARSE_COUNT, L_SPARSE_PARSE_ERROR

L_SPARSE_COUNT:
    sparse_count = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_count as i64
    sparse_empty = eq sparse_count, 0
    br sparse_empty -> L_FINAL_EMPTY_SPARSE, L_SPARSE_INDEX_FORMAT

L_FINAL_EMPTY_SPARSE:
    final_empty_status = call @sa3d_gltf_index_final_materialize_loop(buffer, accessor_count, has_bv, index_format, 0, 0, &base_layout, &index_layout, &value_layout, dst, cap, &out_len, &out_index_format)
    !sparse_empty
    !sparse_count
    !sparse_ok
    !sparse_status
    !sparse_present
    !sparse_present_raw
    !has_bv_bool
    !has_bv
    !accessor_format
    !accessor_count
    !index_supported
    !index_format
    !component_type
    !accessor_ok
    !accessor_status
    !out_index_format
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return final_empty_status

L_SPARSE_INDEX_FORMAT:
    sparse_index_component = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_component_type as i32
    sparse_index_format = call @sa3d_gltf_sparse_index_accessor_format(sparse_index_component)
    sparse_index_format_ok = ne sparse_index_format, 0
    br sparse_index_format_ok -> L_SPARSE_INDEX_LAYOUT, L_UNSUPPORTED_SPARSE_INDEX

L_SPARSE_INDEX_LAYOUT:
    sparse_index_bv = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_buffer_view as i64
    sparse_index_offset = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_byte_offset as i64
    sparse_index_resolve = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, sparse_index_bv, buffer_index, buffer_len, sparse_index_offset, sparse_count, sparse_index_format, &index_view, &index_layout)
    sparse_index_ok = eq sparse_index_resolve, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br sparse_index_ok -> L_SPARSE_VALUE_LAYOUT, L_SPARSE_INDEX_RESOLVE_ERROR

L_SPARSE_VALUE_LAYOUT:
    sparse_value_bv = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_values_buffer_view as i64
    sparse_value_offset = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_values_byte_offset as i64
    sparse_value_resolve = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, sparse_value_bv, buffer_index, buffer_len, sparse_value_offset, sparse_count, accessor_format, &value_view, &value_layout)
    sparse_value_ok = eq sparse_value_resolve, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br sparse_value_ok -> L_FINAL_SPARSE, L_SPARSE_VALUE_RESOLVE_ERROR

L_FINAL_SPARSE:
    final_sparse_status = call @sa3d_gltf_index_final_materialize_loop(buffer, accessor_count, has_bv, index_format, sparse_count, sparse_index_component, &base_layout, &index_layout, &value_layout, dst, cap, &out_len, &out_index_format)
    !sparse_value_ok
    !sparse_value_resolve
    !sparse_value_offset
    !sparse_value_bv
    !sparse_index_ok
    !sparse_index_resolve
    !sparse_index_offset
    !sparse_index_bv
    !sparse_index_format_ok
    !sparse_index_format
    !sparse_index_component
    !sparse_empty
    !sparse_count
    !sparse_ok
    !sparse_status
    !sparse_present
    !sparse_present_raw
    !has_bv_bool
    !has_bv
    !accessor_format
    !accessor_count
    !index_supported
    !index_format
    !component_type
    !accessor_ok
    !accessor_status
    !out_index_format
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return final_sparse_status

L_BASE_RESOLVE_ERROR:
    mapped_base = call @sa3d_gltf_json_resolve_status_to_index_materialize_status(base_resolve)
    !base_ok
    !base_resolve
    !accessor_offset
    !bv_index
