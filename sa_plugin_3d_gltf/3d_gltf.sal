    br count_bad -> L_BAD_COUNT, L_STORE

L_STORE:
    store out+SA3D_GLTF_NODE_TABLE_has_weights, 1 as i32
    store out+SA3D_GLTF_NODE_TABLE_weight_count, count as i64
    store out+SA3D_GLTF_NODE_TABLE_weights_array_pos, weights_pos as i64
    !count_bad
