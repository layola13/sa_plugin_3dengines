    store idx_slot+0, next_item as i64
    !target
    !next_item
    !next_item0
    !next_current
    !current
    !top_comma
    !top_a
    !obj_top
    !arr_top
    !is_comma
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OTHER:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !top_comma
    !top_a
    !obj_top
    !arr_top
    !is_comma
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_RETURN_NEXT_ITEM:
    !target
    !next_item0
    !next_current
    !current
    !top_comma
    !top_a
    !obj_top
    !arr_top
    !is_comma
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !is_zero
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first
    !first0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !negative_index
    !item_index
    !array_pos
    !len
    !bytes
    return next_item

L_RETURN_FIRST:
    !is_zero
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !negative_index
    !item_index
    !array_pos
    !len
    !bytes
    return first

L_MISSING_END:
    !finished
    !arr_prev
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !is_zero
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first
    !first0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !negative_index
    !item_index
    !array_pos
    !len
    !bytes
    return -1

L_MISSING_EMPTY:
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
