@sa3d_gltf_json_node_store_camera(bytes: ptr, len: i64, node_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    camera_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_CAMERA, 6, &camera_slot)
    bad = slt status, 0
    br bad -> L_BAD, L_FOUND_CHECK

L_FOUND_CHECK:
    found = eq status, 1
    br found -> L_STORE, L_OK_MISSING

L_STORE:
    camera = load camera_slot+0 as i64
    store out+SA3D_GLTF_NODE_TABLE_has_camera, 1 as i32
