    store out+SA3D_GLTF_MORPH_TARGET_TABLE_has_normal, 0 as i32
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_normal, 0 as i64
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_has_tangent, 0 as i32
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_tangent, 0 as i64
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_attribute_count, 0 as i64
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_morph_target_parse_fields(bytes: ptr, len: i64, target_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    count_slot = stack_alloc 8
    store count_slot+0, 0 as i64
    s0 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, target_pos, &SA3D_GLTF_JSON_TEXT_POSITION, 8, &out, SA3D_GLTF_MORPH_TARGET_TABLE_position, SA3D_GLTF_MORPH_TARGET_TABLE_has_position, &count_slot)
    s1 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, target_pos, &SA3D_GLTF_JSON_TEXT_NORMAL, 6, &out, SA3D_GLTF_MORPH_TARGET_TABLE_normal, SA3D_GLTF_MORPH_TARGET_TABLE_has_normal, &count_slot)
    s2 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, target_pos, &SA3D_GLTF_JSON_TEXT_TANGENT, 7, &out, SA3D_GLTF_MORPH_TARGET_TABLE_tangent, SA3D_GLTF_MORPH_TARGET_TABLE_has_tangent, &count_slot)
    b0 = slt s0, 0
    b1 = slt s1, 0
    b2 = slt s2, 0
    a0 = or b0, b1
    any_bad = or a0, b2
    br any_bad -> L_BAD, L_OK

L_OK:
    count = load count_slot+0 as i64
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_attribute_count, count as i64
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !count
    !any_bad
    !a0
    !b2
    !b1
    !b0
    !s2
    !s1
    !s0
    !out
    !target_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !any_bad
    !a0
    !b2
    !b1
    !b0
    !s2
    !s1
    !s0
    !out
    !target_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_primitive_morph_target_parse(bytes: ptr, len: i64, mesh_index: i64, primitive_index: i64, target_index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_morph_target_table_clear(&out)
    primitive_pos = call @sa3d_gltf_json_mesh_primitive_object_start(bytes, len, mesh_index, primitive_index)
    primitive_missing = eq primitive_pos, -1
    br primitive_missing -> L_MISSING_PRIMITIVE, L_PRIMITIVE_MALFORMED_CHECK

L_PRIMITIVE_MALFORMED_CHECK:
    primitive_malformed = eq primitive_pos, -2
    br primitive_malformed -> L_MALFORMED_PRIMITIVE, L_TARGETS

L_TARGETS:
    targets_pos = call @sa3d_gltf_json_object_field_value(bytes, len, primitive_pos, &SA3D_GLTF_JSON_KEY_TARGETS, 7)
    targets_missing = eq targets_pos, -1
    br targets_missing -> L_MISSING_TARGETS, L_TARGETS_MALFORMED_CHECK

L_TARGETS_MALFORMED_CHECK:
    targets_malformed = eq targets_pos, -2
    br targets_malformed -> L_MALFORMED_TARGETS, L_TARGET_ITEM

L_TARGET_ITEM:
    target_pos = call @sa3d_gltf_json_array_item_start(bytes, len, targets_pos, target_index)
    target_missing = eq target_pos, -1
    br target_missing -> L_MISSING_TARGET, L_TARGET_MALFORMED_CHECK

L_TARGET_MALFORMED_CHECK:
    target_malformed = eq target_pos, -2
    br target_malformed -> L_MALFORMED_TARGET, L_FIELDS

L_FIELDS:
    field_status = call @sa3d_gltf_json_morph_target_parse_fields(bytes, len, target_pos, &out)
    field_ok = eq field_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br field_ok -> L_OK, L_RETURN_FIELD_STATUS

L_OK:
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !field_ok
    !field_status
    !target_malformed
    !target_missing
    !target_pos
    !targets_malformed
    !targets_missing
    !targets_pos
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_FIELD_STATUS:
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, field_status as i32
    !field_ok
    !target_malformed
    !target_missing
    !target_pos
    !targets_malformed
    !targets_missing
    !targets_pos
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return field_status

L_MISSING_PRIMITIVE:
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !primitive_missing
    !primitive_pos
    !out
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_PRIMITIVE:
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_TARGETS:
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !targets_missing
    !targets_pos
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !target_index
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_TARGETS:
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !targets_malformed
    !targets_missing
    !targets_pos
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !target_index
    !primitive_index
    !mesh_index
    !len
