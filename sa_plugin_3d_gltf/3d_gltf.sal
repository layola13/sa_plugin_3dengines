    store out+SA3D_GLTF_MATERIAL_TABLE_emissive_r, r as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_emissive_g, g as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_emissive_b, b as i32
