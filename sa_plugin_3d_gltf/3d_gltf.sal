    br mat4 -> L_SIZE64, L_UNSUPPORTED

L_SIZE64:
    !mat4
    !u8_scalar
    !u8x3
    !u16x3
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 64

L_UNSUPPORTED:
    !mat4
    !u8_scalar
    !u8x3
    !u16x3
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
