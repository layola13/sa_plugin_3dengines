@sa3d_gltf_json_material_table_parse_specular_color_factor(bytes: ptr, len: i64, specular_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    r_slot = stack_alloc 4
    g_slot = stack_alloc 4
    b_slot = stack_alloc 4
