L_ENTRY:
    normal_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_NORMAL_TEXTURE, 13, &out, SA3D_GLTF_MATERIAL_TABLE_has_normal_texture, SA3D_GLTF_MATERIAL_TABLE_normal_texture, SA3D_GLTF_MATERIAL_TABLE_normal_uv, SA3D_GLTF_TEXTURE_USAGE_NORMAL, 1)
    occlusion_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_OCCLUSION_TEXTURE, 16, &out, SA3D_GLTF_MATERIAL_TABLE_has_occlusion_texture, SA3D_GLTF_MATERIAL_TABLE_occlusion_texture, SA3D_GLTF_MATERIAL_TABLE_occlusion_uv, SA3D_GLTF_TEXTURE_USAGE_OCCLUSION, 1)
    emissive_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_EMISSIVE_TEXTURE, 15, &out, SA3D_GLTF_MATERIAL_TABLE_has_emissive_texture, SA3D_GLTF_MATERIAL_TABLE_emissive_texture, SA3D_GLTF_MATERIAL_TABLE_emissive_uv, SA3D_GLTF_TEXTURE_USAGE_EMISSIVE, 0)
    bevy_status = call @sa3d_gltf_json_material_table_parse_bevy_direct_fields(bytes, len, material_pos, &out)
    emissive_factor_status = call @sa3d_gltf_json_material_table_parse_emissive_factor(bytes, len, material_pos, &out)
    emissive_strength_status = call @sa3d_gltf_json_material_table_parse_emissive_strength(bytes, len, material_pos, &out)
    ior_status = call @sa3d_gltf_json_material_table_parse_ior(bytes, len, material_pos, &out)
    transmission_status = call @sa3d_gltf_json_material_table_parse_transmission(bytes, len, material_pos, &out)
    volume_status = call @sa3d_gltf_json_material_table_parse_volume(bytes, len, material_pos, &out)
    specular_status = call @sa3d_gltf_json_material_table_parse_specular(bytes, len, material_pos, &out)
    clearcoat_status = call @sa3d_gltf_json_material_table_parse_clearcoat(bytes, len, material_pos, &out)
    anisotropy_status = call @sa3d_gltf_json_material_table_parse_anisotropy(bytes, len, material_pos, &out)
    normal_bad = ne normal_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    occlusion_bad = ne occlusion_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    emissive_bad = ne emissive_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    bevy_bad = ne bevy_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    emissive_factor_bad = ne emissive_factor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    emissive_strength_bad = ne emissive_strength_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    ior_bad = ne ior_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    transmission_bad = ne transmission_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    volume_bad = ne volume_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    specular_bad = ne specular_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    clearcoat_bad = ne clearcoat_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    anisotropy_bad = ne anisotropy_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    a = or normal_bad, occlusion_bad
    b = or emissive_bad, bevy_bad
    c = or b, emissive_factor_bad
    d = or c, emissive_strength_bad
    e = or d, ior_bad
    f = or e, transmission_bad
    g = or f, volume_bad
    h = or g, specular_bad
    i = or h, clearcoat_bad
    j = or i, anisotropy_bad
    bad = or a, j
    br bad -> L_BAD, L_OK

L_OK:
    call @sa3d_gltf_material_table_apply_emissive_strength(&out)
    !bad
    !j
    !i
    !h
    !g
    !f
    !e
    !d
    !c
    !b
    !a
    !anisotropy_bad
    !clearcoat_bad
    !specular_bad
    !volume_bad
    !transmission_bad
    !ior_bad
    !emissive_strength_bad
    !emissive_factor_bad
    !bevy_bad
    !emissive_bad
    !occlusion_bad
    !normal_bad
    !anisotropy_status
    !clearcoat_status
    !specular_status
    !volume_status
    !transmission_status
    !ior_status
    !emissive_strength_status
    !emissive_factor_status
    !bevy_status
    !emissive_status
    !occlusion_status
    !normal_status
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !j
    !i
    !h
    !g
    !f
    !e
    !d
    !c
    !b
    !a
    !anisotropy_bad
    !clearcoat_bad
    !specular_bad
    !volume_bad
    !transmission_bad
    !ior_bad
    !emissive_strength_bad
    !emissive_factor_bad
    !bevy_bad
    !emissive_bad
    !occlusion_bad
    !normal_bad
    !anisotropy_status
    !clearcoat_status
    !specular_status
    !volume_status
    !transmission_status
    !ior_status
    !emissive_strength_status
    !emissive_factor_status
    !bevy_status
    !emissive_status
    !occlusion_status
    !normal_status
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse(bytes: ptr, len: i64, material_index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_json_material_table_clear(&out)
    material_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MATERIALS, 9, material_index)
    missing = eq material_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq material_pos, -2
    br malformed -> L_MALFORMED, L_PBR

L_PBR:
    pbr_pos = call @sa3d_gltf_json_object_field_value(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_PBR_METALLIC_ROUGHNESS, 20)
    pbr_missing = eq pbr_pos, -1
    br pbr_missing -> L_DIRECT, L_PBR_MALFORMED_CHECK

L_PBR_MALFORMED_CHECK:
    pbr_malformed = eq pbr_pos, -2
    br pbr_malformed -> L_MALFORMED_PBR, L_PBR_FIELDS

L_PBR_FIELDS:
    pbr_status = call @sa3d_gltf_json_material_table_parse_pbr_fields(bytes, len, pbr_pos, &out)
    pbr_ok = eq pbr_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br pbr_ok -> L_DIRECT_AFTER_PBR, L_MALFORMED_PBR_FIELDS

L_DIRECT_AFTER_PBR:
    !pbr_ok
    !pbr_status
    !pbr_malformed
    !pbr_missing
    !pbr_pos
    jmp L_DIRECT_COMMON

L_DIRECT:
    !pbr_missing
    !pbr_pos
    jmp L_DIRECT_COMMON

L_DIRECT_COMMON:
    direct_status = call @sa3d_gltf_json_material_table_parse_direct_fields(bytes, len, material_pos, &out)
    direct_ok = eq direct_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br direct_ok -> L_NEEDS, L_MALFORMED_DIRECT

L_NEEDS:
    needs = call @sa3d_gltf_json_material_needs_tangents(bytes, len, 1, material_index)
    needs_bad = slt needs, 0
    br needs_bad -> L_MALFORMED_NEEDS, L_OK

L_OK:
    store out+SA3D_GLTF_MATERIAL_TABLE_needs_tangents, needs as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !needs_bad
    !needs
    !direct_ok
    !direct_status
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_PBR:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !pbr_malformed
    !pbr_missing
    !pbr_pos
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_PBR_FIELDS:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !pbr_ok
    !pbr_status
    !pbr_malformed
    !pbr_missing
    !pbr_pos
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_DIRECT:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !direct_ok
    !direct_status
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_NEEDS:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !needs_bad
    !needs
    !direct_ok
    !direct_status
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_needs_tangents(bytes: ptr, len: i64, has_material: i32, material_index: i64) -> i32:
L_ENTRY:
    index_slot = stack_alloc 8
    tex_slot = stack_alloc 8
    has_mat = ne has_material, 0
    br has_mat -> L_NORMAL_TEXTURE, L_FALSE_NO_MATERIAL

L_NORMAL_TEXTURE:
    normal_status = call @sa3d_gltf_json_material_texture_info_parse(bytes, len, material_index, &SA3D_GLTF_JSON_KEY_NORMAL_TEXTURE, 13, &index_slot, &tex_slot)
    normal_ok = eq normal_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br normal_ok -> L_TRUE_NORMAL, L_NORMAL_MALFORMED_CHECK

L_NORMAL_MALFORMED_CHECK:
    normal_bad = eq normal_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON
    br normal_bad -> L_BAD_NORMAL, L_MATERIAL_POS

L_MATERIAL_POS:
    material_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MATERIALS, 9, material_index)
    material_missing = eq material_pos, -1
    br material_missing -> L_FALSE_MATERIAL_MISSING, L_MATERIAL_MALFORMED_CHECK

L_MATERIAL_MALFORMED_CHECK:
    material_malformed = eq material_pos, -2
    br material_malformed -> L_BAD_MATERIAL, L_EXTENSIONS

L_EXTENSIONS:
    extensions_pos = call @sa3d_gltf_json_object_field_value(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_EXTENSIONS, 10)
    extensions_missing = eq extensions_pos, -1
    br extensions_missing -> L_FALSE_EXTENSIONS_MISSING, L_EXTENSIONS_MALFORMED_CHECK

L_EXTENSIONS_MALFORMED_CHECK:
    extensions_malformed = eq extensions_pos, -2
    br extensions_malformed -> L_BAD_EXTENSIONS, L_CLEARCOAT

L_CLEARCOAT:
    clearcoat_pos = call @sa3d_gltf_json_object_field_value(bytes, len, extensions_pos, &SA3D_GLTF_JSON_KEY_KHR_MATERIALS_CLEARCOAT, 23)
    clearcoat_missing = eq clearcoat_pos, -1
    br clearcoat_missing -> L_FALSE_CLEARCOAT_MISSING, L_CLEARCOAT_MALFORMED_CHECK

L_CLEARCOAT_MALFORMED_CHECK:
    clearcoat_malformed = eq clearcoat_pos, -2
    br clearcoat_malformed -> L_BAD_CLEARCOAT, L_CLEARCOAT_NORMAL

L_CLEARCOAT_NORMAL:
    clearcoat_normal_status = call @sa3d_gltf_json_object_texture_info_field_parse(bytes, len, clearcoat_pos, &SA3D_GLTF_JSON_KEY_CLEARCOAT_NORMAL_TEXTURE, 22, &index_slot, &tex_slot)
    clearcoat_normal_ok = eq clearcoat_normal_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br clearcoat_normal_ok -> L_TRUE_CLEARCOAT, L_CLEARCOAT_NORMAL_MALFORMED_CHECK

L_CLEARCOAT_NORMAL_MALFORMED_CHECK:
    clearcoat_normal_bad = eq clearcoat_normal_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON
    br clearcoat_normal_bad -> L_BAD_CLEARCOAT_NORMAL, L_FALSE_CLEARCOAT_NORMAL_MISSING

L_TRUE_NORMAL:
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 1

L_TRUE_CLEARCOAT:
    !clearcoat_normal_ok
    !clearcoat_normal_status
    !clearcoat_malformed
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 1

L_FALSE_CLEARCOAT_NORMAL_MISSING:
    !clearcoat_normal_bad
    !clearcoat_normal_ok
    !clearcoat_normal_status
    !clearcoat_malformed
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_FALSE_CLEARCOAT_MISSING:
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_FALSE_EXTENSIONS_MISSING:
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_FALSE_MATERIAL_MISSING:
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_FALSE_NO_MATERIAL:
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_BAD_CLEARCOAT_NORMAL:
    !clearcoat_normal_bad
    !clearcoat_normal_ok
    !clearcoat_normal_status
    !clearcoat_malformed
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

L_BAD_CLEARCOAT:
    !clearcoat_malformed
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

L_BAD_EXTENSIONS:
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

L_BAD_MATERIAL:
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

L_BAD_NORMAL:
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

@sa3d_gltf_material_label_from_index(&label: ptr, has_index: i32, index: i64, is_scale_inverted: i32) -> void:
L_ENTRY:
    br has_index -> L_INDEXED, L_DEFAULT

L_INDEXED:
    call @sa3d_gltf_asset_label_material(&label, index, is_scale_inverted)
    !has_index
    !index
    !is_scale_inverted
    !label
    return

L_DEFAULT:
    call @sa3d_gltf_asset_label_default_material(&label)
    !has_index
    !index
    !is_scale_inverted
    !label
    return

@sa3d_gltf_alpha_mode_to_sa3d(mode: i32, has_cutoff: i32, cutoff_bits: i32, &out_cutoff: ptr) -> i32:
L_ENTRY:
    is_mask = eq mode, SA3D_GLTF_ALPHA_MODE_MASK
    br is_mask -> L_MASK, L_BLEND_CHECK

L_MASK:
    br has_cutoff -> L_MASK_CUSTOM, L_MASK_DEFAULT

L_MASK_CUSTOM:
    store out_cutoff+0, cutoff_bits as i32
    !has_cutoff
    !cutoff_bits
    !is_mask
    !mode
    !out_cutoff
    return SA3D_ALPHA_MODE_MASK

L_MASK_DEFAULT:
    store out_cutoff+0, SA3D_GLTF_ALPHA_CUTOFF_DEFAULT_BITS as i32
    !has_cutoff
    !cutoff_bits
    !is_mask
    !mode
    !out_cutoff
    return SA3D_ALPHA_MODE_MASK

L_BLEND_CHECK:
    is_blend = eq mode, SA3D_GLTF_ALPHA_MODE_BLEND
    br is_blend -> L_BLEND, L_OPAQUE

L_BLEND:
    store out_cutoff+0, 0 as i32
    !is_blend
    !has_cutoff
    !cutoff_bits
    !is_mask
    !mode
    !out_cutoff
    return SA3D_ALPHA_MODE_BLEND

L_OPAQUE:
    store out_cutoff+0, 0 as i32
    !is_blend
    !has_cutoff
    !cutoff_bits
    !is_mask
    !mode
    !out_cutoff
    return SA3D_ALPHA_MODE_OPAQUE

@sa3d_gltf_material_cull_mode(double_sided: i32, is_scale_inverted: i32) -> i32:
L_ENTRY:
    double = ne double_sided, 0
    br double -> L_NONE, L_INVERTED_CHECK

L_INVERTED_CHECK:
    inverted = ne is_scale_inverted, 0
    br inverted -> L_FRONT, L_BACK

L_NONE:
    !double
    !is_scale_inverted
    !double_sided
    return SA3D_FACE_NONE

L_FRONT:
    !inverted
    !double
    !is_scale_inverted
    !double_sided
    return SA3D_FACE_FRONT

L_BACK:
    !inverted
    !double
    !is_scale_inverted
    !double_sided
    return SA3D_FACE_BACK

@sa3d_gltf_uv_channel(tex_coord: i32) -> i32:
L_ENTRY:
    is_one = eq tex_coord, 1
    br is_one -> L_UV1, L_UV0

L_UV1:
    !is_one
    !tex_coord
    return SA3D_GLTF_UV_CHANNEL_UV1

L_UV0:
    !is_one
    !tex_coord
    return SA3D_GLTF_UV_CHANNEL_UV0

@sa3d_gltf_texture_address_mode(wrapping_mode: i32) -> i32:
L_ENTRY:
    is_repeat = eq wrapping_mode, SA3D_GLTF_WRAP_REPEAT
    br is_repeat -> L_REPEAT, L_MIRROR_CHECK

L_REPEAT:
    !is_repeat
    !wrapping_mode
    return SA3D_SAMPLER_ADDRESS_REPEAT

L_MIRROR_CHECK:
    is_mirror = eq wrapping_mode, SA3D_GLTF_WRAP_MIRRORED_REPEAT
    br is_mirror -> L_MIRROR, L_CLAMP

L_MIRROR:
    !is_mirror
    !is_repeat
    !wrapping_mode
    return SA3D_SAMPLER_ADDRESS_MIRROR_REPEAT

L_CLAMP:
    !is_mirror
    !is_repeat
    !wrapping_mode
    return SA3D_SAMPLER_ADDRESS_CLAMP_TO_EDGE

@sa3d_gltf_mag_filter_mode(filter: i32) -> i32:
L_ENTRY:
    is_linear = eq filter, SA3D_GLTF_FILTER_LINEAR
    br is_linear -> L_LINEAR, L_NEAREST

L_LINEAR:
    !is_linear
    !filter
    return SA3D_SAMPLER_FILTER_LINEAR

L_NEAREST:
    !is_linear
    !filter
    return SA3D_SAMPLER_FILTER_NEAREST

@sa3d_gltf_min_filter_mode(filter: i32) -> i32:
L_ENTRY:
    is_linear = eq filter, SA3D_GLTF_FILTER_LINEAR
    is_linear_mn = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_NEAREST
    is_linear_ml = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_LINEAR
    linear_a = or is_linear, is_linear_mn
    linear = or linear_a, is_linear_ml
    br linear -> L_LINEAR, L_NEAREST

L_LINEAR:
    !linear
    !linear_a
    !is_linear_ml
    !is_linear_mn
    !is_linear
    !filter
    return SA3D_SAMPLER_FILTER_LINEAR

L_NEAREST:
    !linear
    !linear_a
    !is_linear_ml
    !is_linear_mn
    !is_linear
    !filter
    return SA3D_SAMPLER_FILTER_NEAREST

@sa3d_gltf_mipmap_filter_mode(filter: i32) -> i32:
L_ENTRY:
    is_nearest_ml = eq filter, SA3D_GLTF_FILTER_NEAREST_MIPMAP_LINEAR
    is_linear_ml = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_LINEAR
    linear = or is_nearest_ml, is_linear_ml
    br linear -> L_LINEAR, L_NEAREST

L_LINEAR:
    !linear
    !is_linear_ml
    !is_nearest_ml
    !filter
    return SA3D_SAMPLER_FILTER_LINEAR

L_NEAREST:
    !linear
    !is_linear_ml
    !is_nearest_ml
    !filter
    return SA3D_SAMPLER_FILTER_NEAREST

@sa3d_gltf_wrap_mode_supported(wrapping_mode: i32) -> i32:
L_ENTRY:
    clamp = eq wrapping_mode, SA3D_GLTF_WRAP_CLAMP_TO_EDGE
    repeat = eq wrapping_mode, SA3D_GLTF_WRAP_REPEAT
    mirror = eq wrapping_mode, SA3D_GLTF_WRAP_MIRRORED_REPEAT
    a = or clamp, repeat
    ok = or a, mirror
    !a
    !mirror
    !repeat
    !clamp
    !wrapping_mode
    return ok

@sa3d_gltf_mag_filter_supported(filter: i32) -> i32:
L_ENTRY:
    nearest = eq filter, SA3D_GLTF_FILTER_NEAREST
    linear = eq filter, SA3D_GLTF_FILTER_LINEAR
    ok = or nearest, linear
    !linear
    !nearest
    !filter
    return ok

@sa3d_gltf_min_filter_supported(filter: i32) -> i32:
L_ENTRY:
    nearest = eq filter, SA3D_GLTF_FILTER_NEAREST
    linear = eq filter, SA3D_GLTF_FILTER_LINEAR
    nn = eq filter, SA3D_GLTF_FILTER_NEAREST_MIPMAP_NEAREST
    ln = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_NEAREST
    nl = eq filter, SA3D_GLTF_FILTER_NEAREST_MIPMAP_LINEAR
    ll = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_LINEAR
    a0 = or nearest, linear
    a1 = or nn, ln
    a2 = or nl, ll
    b0 = or a0, a1
    ok = or b0, a2
    !b0
    !a2
    !a1
    !a0
    !ll
    !nl
    !ln
    !nn
    !linear
    !nearest
    !filter
    return ok

@sa3d_gltf_json_sampler_table_clear(&out: ptr) -> void:
L_ENTRY:
    call @sa3d_sampler_desc_init(&out)
    store out+SA3D_GLTF_SAMPLER_TABLE_address_u, SA3D_SAMPLER_ADDRESS_REPEAT as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_address_v, SA3D_SAMPLER_ADDRESS_REPEAT as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_has_mag_filter, 0 as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_has_min_filter, 0 as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_wrap_s, SA3D_GLTF_WRAP_REPEAT as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_wrap_t, SA3D_GLTF_WRAP_REPEAT as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_sampler_table_parse_mag(bytes: ptr, len: i64, object_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    value_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_MAG_FILTER, 9, &value_slot)
    missing = eq status, 0
    br missing -> L_OK_MISSING, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_PARSE

L_PARSE:
    raw = load value_slot+0 as i64
    filter = trunc raw as i32
    supported = call @sa3d_gltf_mag_filter_supported(filter)
    ok = ne supported, 0
    br ok -> L_STORE, L_UNSUPPORTED

L_STORE:
    mapped = call @sa3d_gltf_mag_filter_mode(filter)
    store out+SA3D_GLTF_SAMPLER_TABLE_has_mag_filter, 1 as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_mag_filter, mapped as i32
    !mapped
    !ok
    !supported
    !filter
    !raw
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_UNSUPPORTED:
    !ok
    !supported
    !filter
    !raw
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_BAD:
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_sampler_table_parse_min(bytes: ptr, len: i64, object_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    value_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_MIN_FILTER, 9, &value_slot)
    missing = eq status, 0
    br missing -> L_OK_MISSING, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_PARSE

L_PARSE:
    raw = load value_slot+0 as i64
    filter = trunc raw as i32
    supported = call @sa3d_gltf_min_filter_supported(filter)
    ok = ne supported, 0
    br ok -> L_STORE, L_UNSUPPORTED

L_STORE:
    min_mapped = call @sa3d_gltf_min_filter_mode(filter)
    mip_mapped = call @sa3d_gltf_mipmap_filter_mode(filter)
    store out+SA3D_GLTF_SAMPLER_TABLE_has_min_filter, 1 as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_min_filter, min_mapped as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_mipmap_filter, mip_mapped as i32
    !mip_mapped
    !min_mapped
    !ok
    !supported
    !filter
    !raw
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_UNSUPPORTED:
    !ok
    !supported
    !filter
    !raw
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_BAD:
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_sampler_table_parse_wrap_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out: ptr, raw_offset: i64, address_offset: i64) -> i32:
L_ENTRY:
    value_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, key, key_len, &value_slot)
    missing = eq status, 0
    br missing -> L_OK_MISSING, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_PARSE

L_PARSE:
    raw = load value_slot+0 as i64
    wrap = trunc raw as i32
    supported = call @sa3d_gltf_wrap_mode_supported(wrap)
    ok = ne supported, 0
    br ok -> L_STORE, L_UNSUPPORTED

L_STORE:
    raw_ptr = ptr_add out, raw_offset
    address_ptr = ptr_add out, address_offset
    address = call @sa3d_gltf_texture_address_mode(wrap)
    store raw_ptr+0, wrap as i32
    store address_ptr+0, address as i32
    !address
    !address_ptr
    !raw_ptr
    !ok
    !supported
    !wrap
    !raw
    !bad
    !missing
    !status
    !address_offset
    !raw_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !address_offset
    !raw_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_UNSUPPORTED:
    !ok
    !supported
    !wrap
    !raw
    !bad
    !missing
    !status
    !address_offset
    !raw_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_BAD:
    !bad
    !missing
    !status
    !address_offset
    !raw_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_sampler_table_parse(bytes: ptr, len: i64, sampler_index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_json_sampler_table_clear(&out)
    sampler_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_SAMPLERS, 8, sampler_index)
    missing = eq sampler_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq sampler_pos, -2
    br malformed -> L_MALFORMED, L_MAG

L_MAG:
    mag_status = call @sa3d_gltf_json_sampler_table_parse_mag(bytes, len, sampler_pos, &out)
    mag_ok = eq mag_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br mag_ok -> L_MIN, L_BAD_MAG

L_MIN:
    min_status = call @sa3d_gltf_json_sampler_table_parse_min(bytes, len, sampler_pos, &out)
    min_ok = eq min_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br min_ok -> L_WRAP_S, L_BAD_MIN

L_WRAP_S:
    wrap_s_status = call @sa3d_gltf_json_sampler_table_parse_wrap_field(bytes, len, sampler_pos, &SA3D_GLTF_JSON_KEY_WRAP_S, 5, &out, SA3D_GLTF_SAMPLER_TABLE_wrap_s, SA3D_GLTF_SAMPLER_TABLE_address_u)
    wrap_s_ok = eq wrap_s_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br wrap_s_ok -> L_WRAP_T, L_BAD_WRAP_S

L_WRAP_T:
    wrap_t_status = call @sa3d_gltf_json_sampler_table_parse_wrap_field(bytes, len, sampler_pos, &SA3D_GLTF_JSON_KEY_WRAP_T, 5, &out, SA3D_GLTF_SAMPLER_TABLE_wrap_t, SA3D_GLTF_SAMPLER_TABLE_address_v)
    wrap_t_ok = eq wrap_t_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br wrap_t_ok -> L_OK, L_BAD_WRAP_T

L_OK:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !wrap_t_ok
    !wrap_t_status
    !wrap_s_ok
    !wrap_s_status
    !min_ok
    !min_status
    !mag_ok
    !mag_status
    !malformed
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_WRAP_T:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, wrap_t_status as i32
    !wrap_t_ok
    !wrap_t_status
    !wrap_s_ok
    !wrap_s_status
    !min_ok
    !min_status
    !mag_ok
    !mag_status
    !malformed
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_WRAP_S:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, wrap_s_status as i32
    !wrap_s_ok
    !wrap_s_status
    !min_ok
    !min_status
    !mag_ok
    !mag_status
    !malformed
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MIN:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, min_status as i32
    !min_ok
    !min_status
    !mag_ok
    !mag_status
    !malformed
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MAG:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, mag_status as i32
    !mag_ok
    !mag_status
    !malformed
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_texture_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_TEXTURE_TABLE_source, 0 as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_has_source, 0 as i32
    store out+SA3D_GLTF_TEXTURE_TABLE_sampler, 0 as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_has_sampler, 0 as i32
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_texture_table_parse(bytes: ptr, len: i64, texture_index: i64, &out: ptr) -> i32:
L_ENTRY:
    source_slot = stack_alloc 8
    sampler_slot = stack_alloc 8
    call @sa3d_gltf_json_texture_table_clear(&out)
    texture_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_TEXTURES, 8, texture_index)
    missing = eq texture_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq texture_pos, -2
    br malformed -> L_MALFORMED, L_SOURCE

L_SOURCE:
    source_status = call @sa3d_gltf_json_object_i64_value(bytes, len, texture_pos, &SA3D_GLTF_JSON_KEY_SOURCE, 6, &source_slot)
    source_ok = eq source_status, 1
    br source_ok -> L_SAMPLER, L_BAD_SOURCE_CHECK

L_BAD_SOURCE_CHECK:
    source_bad = slt source_status, 0
    br source_bad -> L_BAD_SOURCE, L_MISSING_SOURCE

L_SAMPLER:
    sampler_status = call @sa3d_gltf_json_object_i64_value(bytes, len, texture_pos, &SA3D_GLTF_JSON_KEY_SAMPLER, 7, &sampler_slot)
    sampler_bad = slt sampler_status, 0
    br sampler_bad -> L_BAD_SAMPLER, L_STORE

L_STORE:
    source = load source_slot+0 as i64
    has_sampler = eq sampler_status, 1
    sampler = load sampler_slot+0 as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_source, source as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_has_source, 1 as i32
    store out+SA3D_GLTF_TEXTURE_TABLE_sampler, sampler as i64
    store out+SA3D_GLTF_TEXTURE_TABLE_has_sampler, has_sampler as i32
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !sampler
    !has_sampler
    !source
    !sampler_bad
    !sampler_status
    !source_ok
    !source_status
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_SOURCE:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !source_bad
    !source_ok
    !source_status
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_BAD_SOURCE:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !source_bad
    !source_ok
    !source_status
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_SAMPLER:
    store out+SA3D_GLTF_TEXTURE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !sampler_bad
    !sampler_status
    !source_ok
    !source_status
    !malformed
    !missing
    !texture_pos
    !out
    !texture_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_image_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_IMAGE_TABLE_source_kind, SA3D_GLTF_IMAGE_SOURCE_URI as i32
    store out+SA3D_GLTF_IMAGE_TABLE_uri_ptr, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_uri_len, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_buffer_view, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_mime_ptr, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_mime_len, 0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_has_uri, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_buffer_view, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_mime, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_image_table_parse(bytes: ptr, len: i64, image_index: i64, &out: ptr) -> i32:
L_ENTRY:
    uri_ptr_slot = stack_alloc 8
    uri_len_slot = stack_alloc 8
    mime_ptr_slot = stack_alloc 8
    mime_len_slot = stack_alloc 8
    buffer_view_slot = stack_alloc 8
    call @sa3d_gltf_json_image_table_clear(&out)
    image_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_IMAGES, 6, image_index)
    missing = eq image_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq image_pos, -2
    br malformed -> L_MALFORMED, L_URI

L_URI:
    uri_status = call @sa3d_gltf_json_object_string_span(bytes, len, image_pos, &SA3D_GLTF_JSON_KEY_URI, 3, &uri_ptr_slot, &uri_len_slot)
    uri_bad = slt uri_status, 0
    br uri_bad -> L_BAD_URI, L_BUFFER_VIEW

L_BUFFER_VIEW:
    buffer_view_status = call @sa3d_gltf_json_object_i64_value(bytes, len, image_pos, &SA3D_GLTF_JSON_KEY_BUFFER_VIEW, 10, &buffer_view_slot)
    buffer_view_bad = slt buffer_view_status, 0
    br buffer_view_bad -> L_BAD_BUFFER_VIEW, L_MIME

L_MIME:
    mime_status = call @sa3d_gltf_json_object_string_span(bytes, len, image_pos, &SA3D_GLTF_JSON_KEY_MIME_TYPE, 8, &mime_ptr_slot, &mime_len_slot)
    mime_bad = slt mime_status, 0
    br mime_bad -> L_BAD_MIME, L_SOURCE_SELECT

L_SOURCE_SELECT:
    has_uri = eq uri_status, 1
    has_view = eq buffer_view_status, 1
    both = and has_uri, has_view
    br both -> L_BAD_BOTH_SOURCES, L_URI_CHECK

L_URI_CHECK:
    br has_uri -> L_STORE_URI, L_VIEW_CHECK

L_VIEW_CHECK:
    br has_view -> L_VIEW_MIME_CHECK, L_MISSING_SOURCE

L_VIEW_MIME_CHECK:
    has_mime_for_view = eq mime_status, 1
    br has_mime_for_view -> L_STORE_VIEW, L_MISSING_VIEW_MIME

L_STORE_URI:
    uri_ptr = load uri_ptr_slot+0 as ptr
    uri_len = load uri_len_slot+0 as i64
    has_mime = eq mime_status, 1
    mime_ptr = load mime_ptr_slot+0 as ptr
    mime_len = load mime_len_slot+0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_source_kind, SA3D_GLTF_IMAGE_SOURCE_URI as i32
    store out+SA3D_GLTF_IMAGE_TABLE_uri_ptr, uri_ptr as ptr
    store out+SA3D_GLTF_IMAGE_TABLE_uri_len, uri_len as i64
    store out+SA3D_GLTF_IMAGE_TABLE_mime_ptr, mime_ptr as ptr
    store out+SA3D_GLTF_IMAGE_TABLE_mime_len, mime_len as i64
    store out+SA3D_GLTF_IMAGE_TABLE_has_uri, 1 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_buffer_view, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_mime, has_mime as i32
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !mime_len
    !mime_ptr
    !has_mime
    !uri_len
    !uri_ptr
    !has_view
    !has_uri
    !both
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_STORE_VIEW:
    view = load buffer_view_slot+0 as i64
    mime_ptr_view = load mime_ptr_slot+0 as ptr
    mime_len_view = load mime_len_slot+0 as i64
    store out+SA3D_GLTF_IMAGE_TABLE_source_kind, SA3D_GLTF_IMAGE_SOURCE_VIEW as i32
    store out+SA3D_GLTF_IMAGE_TABLE_buffer_view, view as i64
    store out+SA3D_GLTF_IMAGE_TABLE_mime_ptr, mime_ptr_view as ptr
    store out+SA3D_GLTF_IMAGE_TABLE_mime_len, mime_len_view as i64
    store out+SA3D_GLTF_IMAGE_TABLE_has_uri, 0 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_buffer_view, 1 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_has_mime, 1 as i32
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !mime_len_view
    !mime_ptr_view
    !view
    !has_mime_for_view
    !has_view
    !has_uri
    !both
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_VIEW_MIME:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !has_mime_for_view
    !has_view
    !has_uri
    !both
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MISSING_SOURCE:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !has_view
    !has_uri
    !both
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_BAD_BOTH_SOURCES:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !both
    !has_view
    !has_uri
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MIME:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !mime_bad
    !mime_status
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_BUFFER_VIEW:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !buffer_view_bad
    !buffer_view_status
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_URI:
    store out+SA3D_GLTF_IMAGE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !uri_bad
    !uri_status
    !malformed
    !missing
    !image_pos
    !out
    !image_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_node_name_to_bytes(node_index: i64, name_ptr: ptr, name_len: i64, &dst: ptr, cap: i64) -> i64:
L_ENTRY:
    has_ptr = ne name_ptr, 0
    len_ok = sge name_len, 0
    has_name = and has_ptr, len_ok
    br has_name -> L_COPY_NAME, L_FALLBACK

L_COPY_NAME:
    out_name = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &name_ptr, name_len)
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !node_index
    return out_name

L_FALLBACK:
    p0 = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &SA3D_GLTF_NAME_TEXT_NODE_PREFIX, 8)
    p0_failed = slt p0, 0
    br p0_failed -> L_FAIL, L_INDEX

L_INDEX:
    out_fallback = call @sa3d_gltf_label_write_i64_decimal(&dst, cap, p0, node_index)
    !p0_failed
    !p0
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !node_index
    return out_fallback

L_FAIL:
    !p0_failed
    !p0
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !node_index
    return -1

@sa3d_gltf_primitive_name_to_bytes(mesh_name_ptr: ptr, mesh_name_len: i64, material_name_ptr: ptr, material_name_len: i64, &dst: ptr, cap: i64) -> i64:
L_ENTRY:
    mesh_has_ptr = ne mesh_name_ptr, 0
    mesh_len_ok = sge mesh_name_len, 0
    mesh_has_name = and mesh_has_ptr, mesh_len_ok
    br mesh_has_name -> L_MESH_NAME, L_MESH_FALLBACK

L_MESH_NAME:
    mesh_end = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &mesh_name_ptr, mesh_name_len)
    jmp L_MATERIAL_CHECK

L_MESH_FALLBACK:
    mesh_end = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &SA3D_GLTF_NAME_TEXT_MESH_FALLBACK, 4)
    jmp L_MATERIAL_CHECK

L_MATERIAL_CHECK:
    mesh_failed = slt mesh_end, 0
    br mesh_failed -> L_FAIL, L_MATERIAL_HAS

L_MATERIAL_HAS:
    material_has_ptr = ne material_name_ptr, 0
    material_len_ok = sge material_name_len, 0
    material_has_name = and material_has_ptr, material_len_ok
    br material_has_name -> L_DOT, L_DONE

L_DONE:
    !material_has_name
    !material_len_ok
    !material_has_ptr
    !mesh_failed
    !mesh_has_name
    !mesh_len_ok
    !mesh_has_ptr
    !cap
    !dst
    !material_name_len
    !material_name_ptr
    !mesh_name_len
    !mesh_name_ptr
    return mesh_end

L_DOT:
    dot_end = call @sa3d_gltf_label_write_byte(&dst, cap, mesh_end, 46)
    dot_failed = slt dot_end, 0
    br dot_failed -> L_FAIL_DOT, L_MATERIAL_COPY

L_MATERIAL_COPY:
    out_material = call @sa3d_gltf_label_copy_bytes(&dst, cap, dot_end, &material_name_ptr, material_name_len)
    !dot_failed
    !dot_end
    !material_has_name
    !material_len_ok
    !material_has_ptr
    !mesh_failed
    !mesh_end
    !mesh_has_name
    !mesh_len_ok
    !mesh_has_ptr
    !cap
    !dst
    !material_name_len
    !material_name_ptr
    !mesh_name_len
    !mesh_name_ptr
    return out_material

L_FAIL_DOT:
    !dot_failed
    !dot_end
    !material_has_name
    !material_len_ok
    !material_has_ptr
    !mesh_failed
    !mesh_end
    !mesh_has_name
    !mesh_len_ok
    !mesh_has_ptr
    !cap
    !dst
    !material_name_len
    !material_name_ptr
    !mesh_name_len
    !mesh_name_ptr
    return -1

L_FAIL:
    !mesh_failed
    !mesh_end
    !mesh_has_name
    !mesh_len_ok
    !mesh_has_ptr
    !cap
    !dst
    !material_name_len
    !material_name_ptr
    !mesh_name_len
    !mesh_name_ptr
    return -1

@sa3d_gltf_loader_settings_default(&settings: ptr) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_meshes, SA3D_GLTF_RENDER_ASSET_USAGE_DEFAULT as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_materials, SA3D_GLTF_RENDER_ASSET_USAGE_DEFAULT as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_cameras, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_lights, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_animations, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_include_source, 0 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_default_sampler_present, 0 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_override_sampler, 0 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_validate, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_convert_coordinates_present, 0 as i32
    convert = ptr_add settings, SA3D_GLTF_LOADER_SETTINGS_convert_coordinates
    call @sa3d_gltf_convert_coordinates_init(&convert)
    store settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy_present, 0 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy, SA3D_GLTF_SKINNED_BOUNDS_DYNAMIC as i32
    !convert
    !settings
    return

@sa3d_gltf_loader_settings_set_load_meshes(&settings: ptr, usages: i32) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_meshes, usages as i32
    !usages
    !settings
    return

@sa3d_gltf_loader_settings_set_load_materials(&settings: ptr, usages: i32) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_load_materials, usages as i32
    !usages
    !settings
    return

@sa3d_gltf_loader_settings_meshes_enabled(&settings: ptr) -> i32:
L_ENTRY:
    usages = load settings+SA3D_GLTF_LOADER_SETTINGS_load_meshes as i32
    enabled = ne usages, 0
    br enabled -> L_TRUE, L_FALSE

L_TRUE:
    !enabled
    !usages
    !settings
    return 1

L_FALSE:
    !enabled
    !usages
    !settings
    return 0

@sa3d_gltf_loader_settings_materials_enabled(&settings: ptr) -> i32:
L_ENTRY:
    usages = load settings+SA3D_GLTF_LOADER_SETTINGS_load_materials as i32
    enabled = ne usages, 0
    br enabled -> L_TRUE, L_FALSE

L_TRUE:
    !enabled
    !usages
    !settings
    return 1

L_FALSE:
    !enabled
    !usages
    !settings
    return 0

@sa3d_gltf_loader_settings_set_convert_coordinates(&settings: ptr, rotate_scene_entity: i32, rotate_meshes: i32) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_convert_coordinates_present, 1 as i32
    convert = ptr_add settings, SA3D_GLTF_LOADER_SETTINGS_convert_coordinates
    store convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity, rotate_scene_entity as i32
    store convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes, rotate_meshes as i32
    !convert
    !rotate_meshes
    !rotate_scene_entity
    !settings
    return

@sa3d_gltf_loader_settings_effective_convert_coordinates(&dst: ptr, &settings: ptr, &default_convert: ptr) -> void:
L_ENTRY:
    present = load settings+SA3D_GLTF_LOADER_SETTINGS_convert_coordinates_present as i32
    br present -> L_SETTINGS, L_DEFAULT

L_SETTINGS:
    convert = ptr_add settings, SA3D_GLTF_LOADER_SETTINGS_convert_coordinates
    scene = load convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity as i32
    meshes = load convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes as i32
    store dst+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity, scene as i32
    store dst+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes, meshes as i32
    !meshes
    !scene
    !convert
    !present
    !default_convert
    !settings
    !dst
    return

L_DEFAULT:
    scene = load default_convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity as i32
    meshes = load default_convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes as i32
    store dst+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity, scene as i32
    store dst+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes, meshes as i32
    !meshes
    !scene
    !present
    !default_convert
    !settings
    !dst
    return

@sa3d_gltf_loader_settings_set_skinned_bounds_policy(&settings: ptr, policy: i32) -> void:
L_ENTRY:
    store settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy_present, 1 as i32
    store settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy, policy as i32
    !policy
    !settings
    return

@sa3d_gltf_loader_settings_effective_skinned_bounds_policy(&settings: ptr, default_policy: i32) -> i32:
L_ENTRY:
    present = load settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy_present as i32
    br present -> L_SETTINGS, L_DEFAULT

L_SETTINGS:
    policy = load settings+SA3D_GLTF_LOADER_SETTINGS_skinned_mesh_bounds_policy as i32
    !present
    !default_policy
    !settings
    return policy

L_DEFAULT:
    !present
    !settings
    return default_policy

@sa3d_gltf_vertex_attribute_desc_clear(&desc: ptr) -> void:
L_ENTRY:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_UNKNOWN as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 0 as i32
    !desc
    return

@sa3d_gltf_vertex_attribute_from_semantic(&desc: ptr, semantic: i32, convert_coordinates: i32, custom_attribute: i32) -> i32:
L_ENTRY:
    call @sa3d_gltf_vertex_attribute_desc_clear(&desc)
    is_position = eq semantic, SA3D_GLTF_SEMANTIC_POSITIONS
    br is_position -> L_POSITION, L_NORMAL_CHECK

L_POSITION:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_POSITION as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, convert_coordinates as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_NORMAL_CHECK:
    is_normal = eq semantic, SA3D_GLTF_SEMANTIC_NORMALS
    br is_normal -> L_NORMAL, L_TANGENT_CHECK

L_NORMAL:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_NORMAL as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, convert_coordinates as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_TANGENT_CHECK:
    is_tangent = eq semantic, SA3D_GLTF_SEMANTIC_TANGENTS
    br is_tangent -> L_TANGENT, L_COLOR_CHECK

L_TANGENT:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_TANGENT as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, convert_coordinates as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_COLOR_CHECK:
    is_color = eq semantic, SA3D_GLTF_SEMANTIC_COLORS_0
    br is_color -> L_COLOR, L_UV0_CHECK

L_COLOR:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_COLOR as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_RGBA as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_UV0_CHECK:
    is_uv0 = eq semantic, SA3D_GLTF_SEMANTIC_TEXCOORDS_0
    br is_uv0 -> L_UV0, L_UV1_CHECK

L_UV0:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_UV_0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_TEX_COORD as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_UV1_CHECK:
    is_uv1 = eq semantic, SA3D_GLTF_SEMANTIC_TEXCOORDS_1
    br is_uv1 -> L_UV1, L_JOINTS_CHECK

L_UV1:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_UV_1 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_TEX_COORD as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_JOINTS_CHECK:
    is_joints = eq semantic, SA3D_GLTF_SEMANTIC_JOINTS_0
    br is_joints -> L_JOINTS, L_WEIGHTS_CHECK

L_JOINTS:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_JOINT_INDEX as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_JOINT_INDEX as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_joints
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_WEIGHTS_CHECK:
    is_weights = eq semantic, SA3D_GLTF_SEMANTIC_WEIGHTS_0
    br is_weights -> L_WEIGHTS, L_EXTRAS_CHECK

L_WEIGHTS:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, SA3D_GLTF_ATTRIBUTE_JOINT_WEIGHT as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_JOINT_WEIGHT as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !is_weights
    !is_joints
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_EXTRAS_CHECK:
    is_extras = eq semantic, SA3D_GLTF_SEMANTIC_EXTRAS
    has_custom = ne custom_attribute, 0
    custom_ok = and is_extras, has_custom
    br custom_ok -> L_CUSTOM, L_UNKNOWN

L_CUSTOM:
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_attribute, custom_attribute as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_conversion, SA3D_GLTF_CONVERSION_ANY as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_convert_coordinates, 0 as i32
    store desc+SA3D_GLTF_VERTEX_ATTRIBUTE_DESC_known, 1 as i32
    !custom_ok
    !has_custom
    !is_extras
    !is_weights
    !is_joints
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 1

L_UNKNOWN:
    !custom_ok
    !has_custom
    !is_extras
    !is_weights
    !is_joints
    !is_uv1
    !is_uv0
    !is_color
    !is_tangent
    !is_normal
    !is_position
    !custom_attribute
    !convert_coordinates
    !semantic
    !desc
    return 0

@sa3d_gltf_accessor_layout_clear(&layout: ptr) -> void:
L_ENTRY:
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset, 0 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_len, 0 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride, 0 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_element_size, 0 as i64
    store layout+SA3D_GLTF_ACCESSOR_LAYOUT_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_MALFORMED_DATA as i32
    !layout
    return

@sa3d_gltf_accessor_format_byte_size(accessor_format: i32) -> i64:
L_ENTRY:
    f32_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_SCALAR
    u32_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_U32_SCALAR
    s16_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_S16_SCALAR
    s8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X4
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    s16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X2
    u16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X2
    group4_a = or f32_scalar, u32_scalar
    group4_b = or s8x4, u8x4
    group4_c = or s16x2, u16x2
    group4_ab = or group4_a, group4_b
    group4_c2 = or group4_c, s16_scalar
    group4 = or group4_ab, group4_c2
    br group4 -> L_SIZE4, L_SIZE8_CHECK

L_SIZE4:
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 4

L_SIZE8_CHECK:
    f32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X2
    u32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X2
    s16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    group8_a = or f32x2, u32x2
    group8_b = or s16x4, u16x4
    group8 = or group8_a, group8_b
    br group8 -> L_SIZE8, L_SIZE12_CHECK

L_SIZE8:
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 8

L_SIZE12_CHECK:
    f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    u32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X3
    group12 = or f32x3, u32x3
    br group12 -> L_SIZE12, L_SIZE16_CHECK

L_SIZE12:
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 12

L_SIZE16_CHECK:
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    u32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X4
    group16 = or f32x4, u32x4
    br group16 -> L_SIZE16, L_SIZE2_CHECK

L_SIZE16:
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 16

L_SIZE2_CHECK:
    u16_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_U16_SCALAR
    br u16_scalar -> L_SIZE2_SCALAR, L_SIZE2_VEC_CHECK

L_SIZE2_SCALAR:
    !u16_scalar
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 2

L_SIZE2_VEC_CHECK:
    !u16_scalar
    s8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X2
    u8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X2
    group2 = or s8x2, u8x2
    br group2 -> L_SIZE2, L_SIZE6_CHECK

L_SIZE2:
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 2

L_SIZE6_CHECK:
    u16x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X3
    br u16x3 -> L_SIZE6, L_SIZE3_CHECK

L_SIZE6:
    !u16x3
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 6

L_SIZE3_CHECK:
    u8x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X3
    br u8x3 -> L_SIZE3, L_SIZE1_CHECK

L_SIZE3:
    !u8x3
    !u16x3
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
    !accessor_format
    return 3

L_SIZE1_CHECK:
    u8_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_U8_SCALAR
    s8_scalar = eq accessor_format, SA3D_GLTF_ACCESSOR_S8_SCALAR
    size1_scalar = or u8_scalar, s8_scalar
    br size1_scalar -> L_SIZE1, L_SIZE64_CHECK

L_SIZE1:
    !size1_scalar
    !s8_scalar
    !u8_scalar
    !u8x3
    !u16x3
    !group2
    !u8x2
    !s8x2
    !group16
    !u32x4
    !f32x4
    !group12
    !u32x3
    !f32x3
    !group8
    !group8_b
    !group8_a
    !u16x4
    !s16x4
    !u32x2
    !f32x2
    !group4
    !group4_ab
    !group4_c2
    !group4_c
    !group4_b
    !group4_a
    !s16_scalar
    !u16x2
    !s16x2
    !u8x4
    !s8x4
    !u32_scalar
    !f32_scalar
