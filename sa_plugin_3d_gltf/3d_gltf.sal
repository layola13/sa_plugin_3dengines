    !max_morph_target_count
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_COPY_WEIGHT:
    !copy_ok_weight
    !weights_pos_weight
    !cap_and_ptr_weight
    !dst_present_weight
    !cap_ok_weight
    !required_weight
