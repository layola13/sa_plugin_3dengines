@sa3d_gltf_json_material_table_parse_bevy_direct_fields(bytes: ptr, len: i64, material_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    cutoff_slot = stack_alloc 4
    alpha_cutoff_out = stack_alloc 4
    double_sided = call @sa3d_gltf_json_object_bool_or_default(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_DOUBLE_SIDED, 11, 0)
    double_bad = slt double_sided, 0
    br double_bad -> L_BAD_DOUBLE, L_UNLIT

L_UNLIT:
    unlit = call @sa3d_gltf_json_material_has_unlit_extension(bytes, len, material_pos)
    unlit_bad = slt unlit, 0
    br unlit_bad -> L_BAD_UNLIT, L_ALPHA_MODE

L_ALPHA_MODE:
    alpha_mode_gltf = call @sa3d_gltf_json_object_alpha_mode_or_default(bytes, len, material_pos)
    alpha_mode_bad = slt alpha_mode_gltf, 0
    br alpha_mode_bad -> L_BAD_ALPHA_MODE, L_ALPHA_CUTOFF

L_ALPHA_CUTOFF:
    cutoff_status = call @sa3d_gltf_json_object_f32_bits_value(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_ALPHA_CUTOFF, 11, &cutoff_slot)
    cutoff_bad = slt cutoff_status, 0
    br cutoff_bad -> L_BAD_CUTOFF, L_STORE

L_STORE:
    has_cutoff = eq cutoff_status, 1
    cutoff_bits = load cutoff_slot+0 as i32
    alpha_mode_sa = call @sa3d_gltf_alpha_mode_to_sa3d(alpha_mode_gltf, has_cutoff, cutoff_bits, &alpha_cutoff_out)
    effective_cutoff = load alpha_cutoff_out+0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_double_sided, double_sided as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_unlit, unlit as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_gltf_alpha_mode, alpha_mode_gltf as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_alpha_mode, alpha_mode_sa as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_alpha_cutoff, has_cutoff as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_alpha_cutoff_bits, effective_cutoff as i32
    !effective_cutoff
    !alpha_mode_sa
    !cutoff_bits
    !has_cutoff
    !cutoff_bad
    !cutoff_status
    !alpha_mode_bad
    !alpha_mode_gltf
    !unlit_bad
    !unlit
    !double_bad
    !double_sided
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_CUTOFF:
    !cutoff_bad
    !cutoff_status
    !alpha_mode_bad
    !alpha_mode_gltf
    !unlit_bad
    !unlit
    !double_bad
    !double_sided
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_ALPHA_MODE:
    !alpha_mode_bad
    !alpha_mode_gltf
    !unlit_bad
