    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse_pbr_fields(bytes: ptr, len: i64, pbr_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    base_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, pbr_pos, &SA3D_GLTF_JSON_KEY_BASE_COLOR_TEXTURE, 16, &out, SA3D_GLTF_MATERIAL_TABLE_has_base_color_texture, SA3D_GLTF_MATERIAL_TABLE_base_color_texture, SA3D_GLTF_MATERIAL_TABLE_base_color_uv, SA3D_GLTF_TEXTURE_USAGE_BASE_COLOR, 0)
    mr_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, pbr_pos, &SA3D_GLTF_JSON_KEY_METALLIC_ROUGHNESS_TEXTURE, 24, &out, SA3D_GLTF_MATERIAL_TABLE_has_metallic_roughness_texture, SA3D_GLTF_MATERIAL_TABLE_metallic_roughness_texture, SA3D_GLTF_MATERIAL_TABLE_metallic_roughness_uv, SA3D_GLTF_TEXTURE_USAGE_METALLIC_ROUGHNESS, 1)
    factor_status = call @sa3d_gltf_json_material_table_parse_pbr_factor_fields(bytes, len, pbr_pos, &out)
    base_bad = ne base_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    mr_bad = ne mr_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    factor_bad = ne factor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    a = or base_bad, mr_bad
    bad = or a, factor_bad
    br bad -> L_BAD, L_OK

L_OK:
    !bad
    !a
    !factor_bad
    !mr_bad
    !base_bad
    !factor_status
    !mr_status
    !base_status
    !out
    !pbr_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !a
    !factor_bad
    !mr_bad
    !base_bad
    !factor_status
    !mr_status
    !base_status
    !out
    !pbr_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse_bevy_direct_fields(bytes: ptr, len: i64, material_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    cutoff_slot = stack_alloc 4
    alpha_cutoff_out = stack_alloc 4
    double_sided = call @sa3d_gltf_json_object_bool_or_default(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_DOUBLE_SIDED, 11, 0)
    double_bad = slt double_sided, 0
    br double_bad -> L_BAD_DOUBLE, L_UNLIT

L_UNLIT:
    unlit = call @sa3d_gltf_json_material_has_unlit_extension(bytes, len, material_pos)
    unlit_bad = slt unlit, 0
    br unlit_bad -> L_BAD_UNLIT, L_ALPHA_MODE

L_ALPHA_MODE:
    alpha_mode_gltf = call @sa3d_gltf_json_object_alpha_mode_or_default(bytes, len, material_pos)
    alpha_mode_bad = slt alpha_mode_gltf, 0
    br alpha_mode_bad -> L_BAD_ALPHA_MODE, L_ALPHA_CUTOFF

L_ALPHA_CUTOFF:
    cutoff_status = call @sa3d_gltf_json_object_f32_bits_value(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_ALPHA_CUTOFF, 11, &cutoff_slot)
    cutoff_bad = slt cutoff_status, 0
    br cutoff_bad -> L_BAD_CUTOFF, L_STORE

L_STORE:
    has_cutoff = eq cutoff_status, 1
    cutoff_bits = load cutoff_slot+0 as i32
    alpha_mode_sa = call @sa3d_gltf_alpha_mode_to_sa3d(alpha_mode_gltf, has_cutoff, cutoff_bits, &alpha_cutoff_out)
    effective_cutoff = load alpha_cutoff_out+0 as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_double_sided, double_sided as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_unlit, unlit as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_gltf_alpha_mode, alpha_mode_gltf as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_alpha_mode, alpha_mode_sa as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_has_alpha_cutoff, has_cutoff as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_alpha_cutoff_bits, effective_cutoff as i32
    !effective_cutoff
    !alpha_mode_sa
    !cutoff_bits
    !has_cutoff
    !cutoff_bad
    !cutoff_status
    !alpha_mode_bad
    !alpha_mode_gltf
    !unlit_bad
    !unlit
    !double_bad
    !double_sided
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_CUTOFF:
    !cutoff_bad
    !cutoff_status
    !alpha_mode_bad
    !alpha_mode_gltf
    !unlit_bad
    !unlit
    !double_bad
    !double_sided
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_ALPHA_MODE:
    !alpha_mode_bad
    !alpha_mode_gltf
    !unlit_bad
    !unlit
    !double_bad
    !double_sided
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_UNLIT:
    !unlit_bad
    !unlit
    !double_bad
    !double_sided
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_DOUBLE:
    !double_bad
    !double_sided
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse_direct_fields(bytes: ptr, len: i64, material_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    normal_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_NORMAL_TEXTURE, 13, &out, SA3D_GLTF_MATERIAL_TABLE_has_normal_texture, SA3D_GLTF_MATERIAL_TABLE_normal_texture, SA3D_GLTF_MATERIAL_TABLE_normal_uv, SA3D_GLTF_TEXTURE_USAGE_NORMAL, 1)
    occlusion_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_OCCLUSION_TEXTURE, 16, &out, SA3D_GLTF_MATERIAL_TABLE_has_occlusion_texture, SA3D_GLTF_MATERIAL_TABLE_occlusion_texture, SA3D_GLTF_MATERIAL_TABLE_occlusion_uv, SA3D_GLTF_TEXTURE_USAGE_OCCLUSION, 1)
    emissive_status = call @sa3d_gltf_json_material_table_parse_texture_field(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_EMISSIVE_TEXTURE, 15, &out, SA3D_GLTF_MATERIAL_TABLE_has_emissive_texture, SA3D_GLTF_MATERIAL_TABLE_emissive_texture, SA3D_GLTF_MATERIAL_TABLE_emissive_uv, SA3D_GLTF_TEXTURE_USAGE_EMISSIVE, 0)
    bevy_status = call @sa3d_gltf_json_material_table_parse_bevy_direct_fields(bytes, len, material_pos, &out)
    emissive_factor_status = call @sa3d_gltf_json_material_table_parse_emissive_factor(bytes, len, material_pos, &out)
    normal_bad = ne normal_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    occlusion_bad = ne occlusion_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    emissive_bad = ne emissive_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    bevy_bad = ne bevy_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    emissive_factor_bad = ne emissive_factor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    a = or normal_bad, occlusion_bad
    b = or emissive_bad, bevy_bad
    c = or b, emissive_factor_bad
    bad = or a, c
    br bad -> L_BAD, L_OK

L_OK:
    !bad
    !c
    !b
    !a
    !emissive_factor_bad
    !bevy_bad
    !emissive_bad
    !occlusion_bad
    !normal_bad
    !emissive_factor_status
    !bevy_status
    !emissive_status
    !occlusion_status
    !normal_status
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !c
    !b
    !a
    !emissive_factor_bad
    !bevy_bad
    !emissive_bad
    !occlusion_bad
    !normal_bad
    !emissive_factor_status
    !bevy_status
    !emissive_status
    !occlusion_status
    !normal_status
    !out
    !material_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse(bytes: ptr, len: i64, material_index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_json_material_table_clear(&out)
    material_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MATERIALS, 9, material_index)
    missing = eq material_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq material_pos, -2
    br malformed -> L_MALFORMED, L_PBR

L_PBR:
    pbr_pos = call @sa3d_gltf_json_object_field_value(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_PBR_METALLIC_ROUGHNESS, 20)
    pbr_missing = eq pbr_pos, -1
    br pbr_missing -> L_DIRECT, L_PBR_MALFORMED_CHECK

L_PBR_MALFORMED_CHECK:
    pbr_malformed = eq pbr_pos, -2
    br pbr_malformed -> L_MALFORMED_PBR, L_PBR_FIELDS

L_PBR_FIELDS:
    pbr_status = call @sa3d_gltf_json_material_table_parse_pbr_fields(bytes, len, pbr_pos, &out)
    pbr_ok = eq pbr_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br pbr_ok -> L_DIRECT_AFTER_PBR, L_MALFORMED_PBR_FIELDS

L_DIRECT_AFTER_PBR:
    !pbr_ok
    !pbr_status
    !pbr_malformed
    !pbr_missing
    !pbr_pos
    jmp L_DIRECT_COMMON

L_DIRECT:
    !pbr_missing
    !pbr_pos
    jmp L_DIRECT_COMMON

L_DIRECT_COMMON:
    direct_status = call @sa3d_gltf_json_material_table_parse_direct_fields(bytes, len, material_pos, &out)
    direct_ok = eq direct_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br direct_ok -> L_NEEDS, L_MALFORMED_DIRECT

L_NEEDS:
    needs = call @sa3d_gltf_json_material_needs_tangents(bytes, len, 1, material_index)
    needs_bad = slt needs, 0
    br needs_bad -> L_MALFORMED_NEEDS, L_OK

L_OK:
    store out+SA3D_GLTF_MATERIAL_TABLE_needs_tangents, needs as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !needs_bad
    !needs
    !direct_ok
    !direct_status
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_PBR:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !pbr_malformed
    !pbr_missing
    !pbr_pos
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_PBR_FIELDS:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !pbr_ok
    !pbr_status
    !pbr_malformed
    !pbr_missing
    !pbr_pos
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_DIRECT:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !direct_ok
    !direct_status
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_NEEDS:
    store out+SA3D_GLTF_MATERIAL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !needs_bad
    !needs
    !direct_ok
    !direct_status
    !malformed
    !missing
    !material_pos
    !out
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_needs_tangents(bytes: ptr, len: i64, has_material: i32, material_index: i64) -> i32:
L_ENTRY:
    index_slot = stack_alloc 8
    tex_slot = stack_alloc 8
    has_mat = ne has_material, 0
    br has_mat -> L_NORMAL_TEXTURE, L_FALSE_NO_MATERIAL

L_NORMAL_TEXTURE:
    normal_status = call @sa3d_gltf_json_material_texture_info_parse(bytes, len, material_index, &SA3D_GLTF_JSON_KEY_NORMAL_TEXTURE, 13, &index_slot, &tex_slot)
    normal_ok = eq normal_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br normal_ok -> L_TRUE_NORMAL, L_NORMAL_MALFORMED_CHECK

L_NORMAL_MALFORMED_CHECK:
    normal_bad = eq normal_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON
    br normal_bad -> L_BAD_NORMAL, L_MATERIAL_POS

L_MATERIAL_POS:
    material_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MATERIALS, 9, material_index)
    material_missing = eq material_pos, -1
    br material_missing -> L_FALSE_MATERIAL_MISSING, L_MATERIAL_MALFORMED_CHECK

L_MATERIAL_MALFORMED_CHECK:
    material_malformed = eq material_pos, -2
    br material_malformed -> L_BAD_MATERIAL, L_EXTENSIONS

L_EXTENSIONS:
    extensions_pos = call @sa3d_gltf_json_object_field_value(bytes, len, material_pos, &SA3D_GLTF_JSON_KEY_EXTENSIONS, 10)
    extensions_missing = eq extensions_pos, -1
    br extensions_missing -> L_FALSE_EXTENSIONS_MISSING, L_EXTENSIONS_MALFORMED_CHECK

L_EXTENSIONS_MALFORMED_CHECK:
    extensions_malformed = eq extensions_pos, -2
    br extensions_malformed -> L_BAD_EXTENSIONS, L_CLEARCOAT

L_CLEARCOAT:
    clearcoat_pos = call @sa3d_gltf_json_object_field_value(bytes, len, extensions_pos, &SA3D_GLTF_JSON_KEY_KHR_MATERIALS_CLEARCOAT, 23)
    clearcoat_missing = eq clearcoat_pos, -1
    br clearcoat_missing -> L_FALSE_CLEARCOAT_MISSING, L_CLEARCOAT_MALFORMED_CHECK

L_CLEARCOAT_MALFORMED_CHECK:
    clearcoat_malformed = eq clearcoat_pos, -2
    br clearcoat_malformed -> L_BAD_CLEARCOAT, L_CLEARCOAT_NORMAL

L_CLEARCOAT_NORMAL:
    clearcoat_normal_status = call @sa3d_gltf_json_object_texture_info_field_parse(bytes, len, clearcoat_pos, &SA3D_GLTF_JSON_KEY_CLEARCOAT_NORMAL_TEXTURE, 22, &index_slot, &tex_slot)
    clearcoat_normal_ok = eq clearcoat_normal_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br clearcoat_normal_ok -> L_TRUE_CLEARCOAT, L_CLEARCOAT_NORMAL_MALFORMED_CHECK

L_CLEARCOAT_NORMAL_MALFORMED_CHECK:
    clearcoat_normal_bad = eq clearcoat_normal_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON
    br clearcoat_normal_bad -> L_BAD_CLEARCOAT_NORMAL, L_FALSE_CLEARCOAT_NORMAL_MISSING

L_TRUE_NORMAL:
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 1

L_TRUE_CLEARCOAT:
    !clearcoat_normal_ok
    !clearcoat_normal_status
    !clearcoat_malformed
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 1

L_FALSE_CLEARCOAT_NORMAL_MISSING:
    !clearcoat_normal_bad
    !clearcoat_normal_ok
    !clearcoat_normal_status
    !clearcoat_malformed
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_FALSE_CLEARCOAT_MISSING:
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_FALSE_EXTENSIONS_MISSING:
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_FALSE_MATERIAL_MISSING:
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_FALSE_NO_MATERIAL:
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return 0

L_BAD_CLEARCOAT_NORMAL:
    !clearcoat_normal_bad
    !clearcoat_normal_ok
    !clearcoat_normal_status
    !clearcoat_malformed
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

L_BAD_CLEARCOAT:
    !clearcoat_malformed
    !clearcoat_missing
    !clearcoat_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

L_BAD_EXTENSIONS:
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

L_BAD_MATERIAL:
    !material_malformed
    !material_missing
    !material_pos
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

L_BAD_NORMAL:
    !normal_bad
    !normal_ok
    !normal_status
    !has_mat
    !material_index
    !has_material
    !len
    !bytes
    return -1

@sa3d_gltf_material_label_from_index(&label: ptr, has_index: i32, index: i64, is_scale_inverted: i32) -> void:
L_ENTRY:
    br has_index -> L_INDEXED, L_DEFAULT

L_INDEXED:
    call @sa3d_gltf_asset_label_material(&label, index, is_scale_inverted)
    !has_index
    !index
    !is_scale_inverted
    !label
    return

L_DEFAULT:
    call @sa3d_gltf_asset_label_default_material(&label)
    !has_index
    !index
    !is_scale_inverted
    !label
    return

@sa3d_gltf_alpha_mode_to_sa3d(mode: i32, has_cutoff: i32, cutoff_bits: i32, &out_cutoff: ptr) -> i32:
L_ENTRY:
    is_mask = eq mode, SA3D_GLTF_ALPHA_MODE_MASK
    br is_mask -> L_MASK, L_BLEND_CHECK

L_MASK:
    br has_cutoff -> L_MASK_CUSTOM, L_MASK_DEFAULT

L_MASK_CUSTOM:
    store out_cutoff+0, cutoff_bits as i32
    !has_cutoff
    !cutoff_bits
    !is_mask
    !mode
    !out_cutoff
    return SA3D_ALPHA_MODE_MASK

L_MASK_DEFAULT:
    store out_cutoff+0, SA3D_GLTF_ALPHA_CUTOFF_DEFAULT_BITS as i32
    !has_cutoff
    !cutoff_bits
    !is_mask
    !mode
    !out_cutoff
    return SA3D_ALPHA_MODE_MASK

L_BLEND_CHECK:
    is_blend = eq mode, SA3D_GLTF_ALPHA_MODE_BLEND
    br is_blend -> L_BLEND, L_OPAQUE

L_BLEND:
    store out_cutoff+0, 0 as i32
    !is_blend
    !has_cutoff
    !cutoff_bits
    !is_mask
    !mode
    !out_cutoff
    return SA3D_ALPHA_MODE_BLEND

L_OPAQUE:
    store out_cutoff+0, 0 as i32
    !is_blend
    !has_cutoff
    !cutoff_bits
    !is_mask
    !mode
    !out_cutoff
    return SA3D_ALPHA_MODE_OPAQUE

@sa3d_gltf_material_cull_mode(double_sided: i32, is_scale_inverted: i32) -> i32:
L_ENTRY:
    double = ne double_sided, 0
    br double -> L_NONE, L_INVERTED_CHECK

L_INVERTED_CHECK:
    inverted = ne is_scale_inverted, 0
    br inverted -> L_FRONT, L_BACK

L_NONE:
    !double
    !is_scale_inverted
    !double_sided
    return SA3D_FACE_NONE

L_FRONT:
    !inverted
    !double
    !is_scale_inverted
    !double_sided
    return SA3D_FACE_FRONT

L_BACK:
    !inverted
    !double
    !is_scale_inverted
    !double_sided
    return SA3D_FACE_BACK

@sa3d_gltf_uv_channel(tex_coord: i32) -> i32:
L_ENTRY:
    is_one = eq tex_coord, 1
    br is_one -> L_UV1, L_UV0

L_UV1:
    !is_one
    !tex_coord
    return SA3D_GLTF_UV_CHANNEL_UV1

L_UV0:
    !is_one
    !tex_coord
    return SA3D_GLTF_UV_CHANNEL_UV0

@sa3d_gltf_texture_address_mode(wrapping_mode: i32) -> i32:
L_ENTRY:
    is_repeat = eq wrapping_mode, SA3D_GLTF_WRAP_REPEAT
    br is_repeat -> L_REPEAT, L_MIRROR_CHECK

L_REPEAT:
    !is_repeat
    !wrapping_mode
    return SA3D_SAMPLER_ADDRESS_REPEAT

L_MIRROR_CHECK:
    is_mirror = eq wrapping_mode, SA3D_GLTF_WRAP_MIRRORED_REPEAT
    br is_mirror -> L_MIRROR, L_CLAMP

L_MIRROR:
    !is_mirror
    !is_repeat
    !wrapping_mode
    return SA3D_SAMPLER_ADDRESS_MIRROR_REPEAT

L_CLAMP:
    !is_mirror
    !is_repeat
    !wrapping_mode
    return SA3D_SAMPLER_ADDRESS_CLAMP_TO_EDGE

@sa3d_gltf_mag_filter_mode(filter: i32) -> i32:
L_ENTRY:
    is_linear = eq filter, SA3D_GLTF_FILTER_LINEAR
    br is_linear -> L_LINEAR, L_NEAREST

L_LINEAR:
    !is_linear
    !filter
    return SA3D_SAMPLER_FILTER_LINEAR

L_NEAREST:
    !is_linear
    !filter
    return SA3D_SAMPLER_FILTER_NEAREST

@sa3d_gltf_min_filter_mode(filter: i32) -> i32:
L_ENTRY:
    is_linear = eq filter, SA3D_GLTF_FILTER_LINEAR
    is_linear_mn = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_NEAREST
    is_linear_ml = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_LINEAR
    linear_a = or is_linear, is_linear_mn
    linear = or linear_a, is_linear_ml
    br linear -> L_LINEAR, L_NEAREST

L_LINEAR:
    !linear
    !linear_a
    !is_linear_ml
    !is_linear_mn
    !is_linear
    !filter
    return SA3D_SAMPLER_FILTER_LINEAR

L_NEAREST:
    !linear
    !linear_a
    !is_linear_ml
    !is_linear_mn
    !is_linear
    !filter
    return SA3D_SAMPLER_FILTER_NEAREST

@sa3d_gltf_mipmap_filter_mode(filter: i32) -> i32:
L_ENTRY:
    is_nearest_ml = eq filter, SA3D_GLTF_FILTER_NEAREST_MIPMAP_LINEAR
    is_linear_ml = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_LINEAR
    linear = or is_nearest_ml, is_linear_ml
    br linear -> L_LINEAR, L_NEAREST

L_LINEAR:
    !linear
    !is_linear_ml
    !is_nearest_ml
    !filter
    return SA3D_SAMPLER_FILTER_LINEAR

L_NEAREST:
    !linear
    !is_linear_ml
    !is_nearest_ml
    !filter
    return SA3D_SAMPLER_FILTER_NEAREST

@sa3d_gltf_wrap_mode_supported(wrapping_mode: i32) -> i32:
L_ENTRY:
    clamp = eq wrapping_mode, SA3D_GLTF_WRAP_CLAMP_TO_EDGE
    repeat = eq wrapping_mode, SA3D_GLTF_WRAP_REPEAT
    mirror = eq wrapping_mode, SA3D_GLTF_WRAP_MIRRORED_REPEAT
    a = or clamp, repeat
    ok = or a, mirror
    !a
    !mirror
    !repeat
    !clamp
    !wrapping_mode
    return ok

@sa3d_gltf_mag_filter_supported(filter: i32) -> i32:
L_ENTRY:
    nearest = eq filter, SA3D_GLTF_FILTER_NEAREST
    linear = eq filter, SA3D_GLTF_FILTER_LINEAR
    ok = or nearest, linear
    !linear
    !nearest
    !filter
    return ok

@sa3d_gltf_min_filter_supported(filter: i32) -> i32:
L_ENTRY:
    nearest = eq filter, SA3D_GLTF_FILTER_NEAREST
    linear = eq filter, SA3D_GLTF_FILTER_LINEAR
    nn = eq filter, SA3D_GLTF_FILTER_NEAREST_MIPMAP_NEAREST
    ln = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_NEAREST
    nl = eq filter, SA3D_GLTF_FILTER_NEAREST_MIPMAP_LINEAR
    ll = eq filter, SA3D_GLTF_FILTER_LINEAR_MIPMAP_LINEAR
    a0 = or nearest, linear
    a1 = or nn, ln
    a2 = or nl, ll
    b0 = or a0, a1
    ok = or b0, a2
    !b0
    !a2
    !a1
    !a0
    !ll
    !nl
    !ln
    !nn
    !linear
    !nearest
    !filter
    return ok

@sa3d_gltf_json_sampler_table_clear(&out: ptr) -> void:
L_ENTRY:
    call @sa3d_sampler_desc_init(&out)
    store out+SA3D_GLTF_SAMPLER_TABLE_address_u, SA3D_SAMPLER_ADDRESS_REPEAT as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_address_v, SA3D_SAMPLER_ADDRESS_REPEAT as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_has_mag_filter, 0 as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_has_min_filter, 0 as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_wrap_s, SA3D_GLTF_WRAP_REPEAT as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_wrap_t, SA3D_GLTF_WRAP_REPEAT as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_sampler_table_parse_mag(bytes: ptr, len: i64, object_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    value_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_MAG_FILTER, 9, &value_slot)
    missing = eq status, 0
    br missing -> L_OK_MISSING, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_PARSE

L_PARSE:
    raw = load value_slot+0 as i64
    filter = trunc raw as i32
    supported = call @sa3d_gltf_mag_filter_supported(filter)
    ok = ne supported, 0
    br ok -> L_STORE, L_UNSUPPORTED

L_STORE:
    mapped = call @sa3d_gltf_mag_filter_mode(filter)
    store out+SA3D_GLTF_SAMPLER_TABLE_has_mag_filter, 1 as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_mag_filter, mapped as i32
    !mapped
    !ok
    !supported
    !filter
    !raw
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_UNSUPPORTED:
    !ok
    !supported
    !filter
    !raw
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_BAD:
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_sampler_table_parse_min(bytes: ptr, len: i64, object_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    value_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_MIN_FILTER, 9, &value_slot)
    missing = eq status, 0
    br missing -> L_OK_MISSING, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_PARSE

L_PARSE:
    raw = load value_slot+0 as i64
    filter = trunc raw as i32
    supported = call @sa3d_gltf_min_filter_supported(filter)
    ok = ne supported, 0
    br ok -> L_STORE, L_UNSUPPORTED

L_STORE:
    min_mapped = call @sa3d_gltf_min_filter_mode(filter)
    mip_mapped = call @sa3d_gltf_mipmap_filter_mode(filter)
    store out+SA3D_GLTF_SAMPLER_TABLE_has_min_filter, 1 as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_min_filter, min_mapped as i32
    store out+SA3D_GLTF_SAMPLER_TABLE_mipmap_filter, mip_mapped as i32
    !mip_mapped
    !min_mapped
    !ok
    !supported
    !filter
    !raw
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_UNSUPPORTED:
    !ok
    !supported
    !filter
    !raw
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_BAD:
    !bad
    !missing
    !status
    !out
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_sampler_table_parse_wrap_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out: ptr, raw_offset: i64, address_offset: i64) -> i32:
L_ENTRY:
    value_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, key, key_len, &value_slot)
    missing = eq status, 0
    br missing -> L_OK_MISSING, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_PARSE

L_PARSE:
    raw = load value_slot+0 as i64
    wrap = trunc raw as i32
    supported = call @sa3d_gltf_wrap_mode_supported(wrap)
    ok = ne supported, 0
    br ok -> L_STORE, L_UNSUPPORTED

L_STORE:
    raw_ptr = ptr_add out, raw_offset
    address_ptr = ptr_add out, address_offset
    address = call @sa3d_gltf_texture_address_mode(wrap)
    store raw_ptr+0, wrap as i32
    store address_ptr+0, address as i32
    !address
    !address_ptr
    !raw_ptr
    !ok
    !supported
    !wrap
    !raw
    !bad
    !missing
    !status
    !address_offset
    !raw_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !address_offset
    !raw_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_UNSUPPORTED:
    !ok
    !supported
    !wrap
    !raw
    !bad
    !missing
    !status
    !address_offset
    !raw_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_BAD:
    !bad
    !missing
    !status
    !address_offset
    !raw_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_sampler_table_parse(bytes: ptr, len: i64, sampler_index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_json_sampler_table_clear(&out)
    sampler_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_SAMPLERS, 8, sampler_index)
    missing = eq sampler_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq sampler_pos, -2
    br malformed -> L_MALFORMED, L_MAG

L_MAG:
    mag_status = call @sa3d_gltf_json_sampler_table_parse_mag(bytes, len, sampler_pos, &out)
    mag_ok = eq mag_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br mag_ok -> L_MIN, L_BAD_MAG

L_MIN:
    min_status = call @sa3d_gltf_json_sampler_table_parse_min(bytes, len, sampler_pos, &out)
    min_ok = eq min_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br min_ok -> L_WRAP_S, L_BAD_MIN

L_WRAP_S:
    wrap_s_status = call @sa3d_gltf_json_sampler_table_parse_wrap_field(bytes, len, sampler_pos, &SA3D_GLTF_JSON_KEY_WRAP_S, 5, &out, SA3D_GLTF_SAMPLER_TABLE_wrap_s, SA3D_GLTF_SAMPLER_TABLE_address_u)
    wrap_s_ok = eq wrap_s_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br wrap_s_ok -> L_WRAP_T, L_BAD_WRAP_S

L_WRAP_T:
    wrap_t_status = call @sa3d_gltf_json_sampler_table_parse_wrap_field(bytes, len, sampler_pos, &SA3D_GLTF_JSON_KEY_WRAP_T, 5, &out, SA3D_GLTF_SAMPLER_TABLE_wrap_t, SA3D_GLTF_SAMPLER_TABLE_address_v)
    wrap_t_ok = eq wrap_t_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br wrap_t_ok -> L_OK, L_BAD_WRAP_T

L_OK:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !wrap_t_ok
    !wrap_t_status
    !wrap_s_ok
    !wrap_s_status
    !min_ok
    !min_status
    !mag_ok
    !mag_status
    !malformed
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_WRAP_T:
    store out+SA3D_GLTF_SAMPLER_TABLE_status, wrap_t_status as i32
    !wrap_t_ok
    !wrap_t_status
    !wrap_s_ok
    !wrap_s_status
    !min_ok
    !min_status
    !mag_ok
    !mag_status
    !malformed
    !missing
    !sampler_pos
    !out
    !sampler_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_WRAP_S:
