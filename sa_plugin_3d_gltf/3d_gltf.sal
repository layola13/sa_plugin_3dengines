@sa3d_gltf_index_scan_status_to_materialize_status(scan_status: i32) -> i32:
L_ENTRY:
    ok = eq scan_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK
    br ok -> L_OK, L_UNSUPPORTED_CHECK

L_OK:
    !ok
    !scan_status
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK

L_UNSUPPORTED_CHECK:
    unsupported = eq scan_status, SA3D_GLTF_INDEX_SCAN_STATUS_UNSUPPORTED_FORMAT
    br unsupported -> L_UNSUPPORTED, L_MALFORMED

L_UNSUPPORTED:
    !unsupported
    !ok
    !scan_status
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED:
    !unsupported
    !ok
    !scan_status
    return SA3D_GLTF_INDEX_MATERIALIZE_STATUS_MALFORMED_DATA

@sa3d_gltf_json_index_accessor_materialize(bytes: ptr, len: i64, accessor_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, dst: ptr, cap: i64, &out_len: ptr, &out_index_format: ptr) -> i32:
