@sa3d_gltf_accessor_format_supported(accessor_format: i32) -> i32:
L_ENTRY:
    low = sge accessor_format, SA3D_GLTF_ACCESSOR_F32_SCALAR
    high = sle accessor_format, SA3D_GLTF_ACCESSOR_U16_SCALAR
    ok = and low, high
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !high
    !low
    !accessor_format
    return 1

L_FALSE:
    !ok
    !high
    !low
    !accessor_format
    return 0

@sa3d_gltf_accessor_any_supported(accessor_format: i32, normalized: i32) -> i32:
L_ENTRY:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    f32 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32_SCALAR
    u32 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32_SCALAR
    f32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X2
    u32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X2
    f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    u32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X3
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    u32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U32X4
    a0 = or f32, u32
    a1 = or f32x2, u32x2
    a2 = or f32x3, u32x3
    a3 = or f32x4, u32x4
    a01 = or a0, a1
    a23 = or a2, a3
    native = or a01, a23
    native_ok = and native, not_norm
    s16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X2
    u16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X2
    s16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S16X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    s8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X2
    u8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X2
    s8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_S8X4
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    b0 = or s16x2, u16x2
    b1 = or s16x4, u16x4
    b2 = or s8x2, u8x2
    b3 = or s8x4, u8x4
    b01 = or b0, b1
    b23 = or b2, b3
    normable = or b01, b23
    ok = or native_ok, normable
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !normable
    !b23
    !b01
    !b3
    !b2
    !b1
    !b0
    !u8x4
    !s8x4
    !u8x2
    !s8x2
    !u16x4
    !s16x4
    !u16x2
    !s16x2
    !native_ok
    !native
    !a23
    !a01
    !a3
    !a2
    !a1
    !a0
    !u32x4
    !f32x4
    !u32x3
    !f32x3
    !u32x2
    !f32x2
    !u32
    !f32
    !not_norm
    !norm
    !normalized
    !accessor_format
    return 1

L_FALSE:
    !ok
    !normable
    !b23
    !b01
    !b3
    !b2
    !b1
    !b0
    !u8x4
    !s8x4
    !u8x2
    !s8x2
    !u16x4
    !s16x4
    !u16x2
    !s16x2
    !native_ok
    !native
    !a23
    !a01
    !a3
    !a2
    !a1
    !a0
    !u32x4
    !f32x4
    !u32x3
    !f32x3
    !u32x2
    !f32x2
    !u32
    !f32
    !not_norm
    !norm
    !normalized
    !accessor_format
    return 0

@sa3d_gltf_accessor_conversion_supported(conversion: i32, accessor_format: i32, normalized: i32) -> i32:
L_ENTRY:
    is_any = eq conversion, SA3D_GLTF_CONVERSION_ANY
    br is_any -> L_ANY, L_RGBA_CHECK

L_ANY:
    out_any = call @sa3d_gltf_accessor_any_supported(accessor_format, normalized)
    !is_any
    !conversion
    !accessor_format
    !normalized
    return out_any

L_RGBA_CHECK:
    is_rgba = eq conversion, SA3D_GLTF_CONVERSION_RGBA
    br is_rgba -> L_RGBA, L_TEX_CHECK

L_RGBA:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    f32x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X3
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    f32_ok0 = or f32x3, f32x4
    f32_ok = and f32_ok0, not_norm
    u8x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X3
    u16x3 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X3
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    n0 = or u8x3, u16x3
    n1 = or u8x4, u16x4
    normalized_color = or n0, n1
    normalized_ok = and normalized_color, norm
    rgba_ok = or f32_ok, normalized_ok
    br rgba_ok -> L_RGBA_TRUE, L_RGBA_FALSE

L_RGBA_TRUE:
    !rgba_ok
    !normalized_ok
    !normalized_color
    !n1
    !n0
    !u16x4
    !u8x4
    !u16x3
    !u8x3
    !f32_ok
    !f32_ok0
    !f32x4
    !f32x3
    !not_norm
    !norm
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 1

L_RGBA_FALSE:
    !rgba_ok
    !normalized_ok
    !normalized_color
    !n1
    !n0
    !u16x4
    !u8x4
    !u16x3
    !u8x3
    !f32_ok
    !f32_ok0
    !f32x4
    !f32x3
    !not_norm
    !norm
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 0

L_TEX_CHECK:
    is_tex = eq conversion, SA3D_GLTF_CONVERSION_TEX_COORD
    br is_tex -> L_TEX, L_JOINT_INDEX_CHECK

L_TEX:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    f32x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X2
    f32_ok = and f32x2, not_norm
    u8x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X2
    u16x2 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X2
    normalized_tex = or u8x2, u16x2
    normalized_ok = and normalized_tex, norm
    tex_ok = or f32_ok, normalized_ok
    br tex_ok -> L_TEX_TRUE, L_TEX_FALSE

L_TEX_TRUE:
    !tex_ok
    !normalized_ok
    !normalized_tex
    !u16x2
    !u8x2
    !f32_ok
    !f32x2
    !not_norm
    !norm
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 1

L_TEX_FALSE:
    !tex_ok
    !normalized_ok
    !normalized_tex
    !u16x2
    !u8x2
    !f32_ok
    !f32x2
    !not_norm
    !norm
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 0

L_JOINT_INDEX_CHECK:
    is_joint_index = eq conversion, SA3D_GLTF_CONVERSION_JOINT_INDEX
    br is_joint_index -> L_JOINT_INDEX, L_JOINT_WEIGHT_CHECK

L_JOINT_INDEX:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    idx0 = or u8x4, u16x4
    idx_ok = and idx0, not_norm
    br idx_ok -> L_IDX_TRUE, L_IDX_FALSE

L_IDX_TRUE:
    !idx_ok
    !idx0
    !u16x4
    !u8x4
    !not_norm
    !norm
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 1

L_IDX_FALSE:
    !idx_ok
    !idx0
    !u16x4
    !u8x4
    !not_norm
    !norm
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 0

L_JOINT_WEIGHT_CHECK:
    is_joint_weight = eq conversion, SA3D_GLTF_CONVERSION_JOINT_WEIGHT
    br is_joint_weight -> L_JOINT_WEIGHT, L_UNKNOWN

L_JOINT_WEIGHT:
    norm = ne normalized, 0
    not_norm = eq norm, 0
    f32x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_F32X4
    f32_ok = and f32x4, not_norm
    u8x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U8X4
    u16x4 = eq accessor_format, SA3D_GLTF_ACCESSOR_U16X4
    w0 = or u8x4, u16x4
    normalized_ok = and w0, norm
    weight_ok = or f32_ok, normalized_ok
    br weight_ok -> L_WEIGHT_TRUE, L_WEIGHT_FALSE

L_WEIGHT_TRUE:
    !weight_ok
    !normalized_ok
    !w0
    !u16x4
    !u8x4
    !f32_ok
    !f32x4
    !not_norm
    !norm
    !is_joint_weight
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 1

L_WEIGHT_FALSE:
    !weight_ok
    !normalized_ok
    !w0
    !u16x4
    !u8x4
    !f32_ok
    !f32x4
    !not_norm
    !norm
    !is_joint_weight
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 0

L_UNKNOWN:
    !is_joint_weight
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 0

@sa3d_gltf_convert_coordinates_init(&convert: ptr) -> void:
L_ENTRY:
    store convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity, 0 as i32
    store convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes, 0 as i32
    !convert
    return

@sa3d_gltf_convert_coordinates_set_rotate_scene_entity(&convert: ptr, rotate: i32) -> void:
L_ENTRY:
    store convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity, rotate as i32
    !rotate
    !convert
    return

@sa3d_gltf_convert_coordinates_set_rotate_meshes(&convert: ptr, rotate: i32) -> void:
L_ENTRY:
    store convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes, rotate as i32
    !rotate
    !convert
    return

@sa3d_gltf_vec3_convert_coordinates(&dst: ptr, &src: ptr) -> void:
L_ENTRY:
    x = load src+SA3D_VEC3_x as i32
    y = load src+SA3D_VEC3_y as i32
    z = load src+SA3D_VEC3_z as i32
    neg_x = xor x, -2147483648
    neg_z = xor z, -2147483648
    store dst+SA3D_VEC3_x, neg_x as i32
    store dst+SA3D_VEC3_y, y as i32
    store dst+SA3D_VEC3_z, neg_z as i32
    !neg_z
    !neg_x
    !z
    !y
    !x
    !src
    !dst
    return

@sa3d_gltf_vec4_convert_coordinates(&dst: ptr, &src: ptr) -> void:
L_ENTRY:
    x = load src+SA3D_VEC4_x as i32
    y = load src+SA3D_VEC4_y as i32
    z = load src+SA3D_VEC4_z as i32
    w = load src+SA3D_VEC4_w as i32
    neg_x = xor x, -2147483648
    neg_z = xor z, -2147483648
    store dst+SA3D_VEC4_x, neg_x as i32
    store dst+SA3D_VEC4_y, y as i32
    store dst+SA3D_VEC4_z, neg_z as i32
    store dst+SA3D_VEC4_w, w as i32
    !w
    !neg_z
    !neg_x
    !z
    !y
    !x
    !src
    !dst
    return

@sa3d_gltf_convert_coordinates_scene_transform(&dst: ptr, &convert: ptr) -> void:
L_ENTRY:
    rotate = load convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_scene_entity as i32
    call @sa3d_transform3d_identity(&dst)
    br rotate -> L_ROTATE, L_DONE

L_ROTATE:
    call @sa3d_transform3d_set_rotation(&dst, 0.0, 1.0, 0.0, 0.0)
    jmp L_DONE

L_DONE:
    !convert
    !dst
    return

@sa3d_gltf_convert_coordinates_mesh_transform(&dst: ptr, &convert: ptr) -> void:
L_ENTRY:
    rotate = load convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes as i32
    call @sa3d_transform3d_identity(&dst)
    br rotate -> L_ROTATE, L_DONE

L_ROTATE:
    call @sa3d_transform3d_set_rotation(&dst, 0.0, 1.0, 0.0, 0.0)
    jmp L_DONE

L_DONE:
    !convert
    !dst
    return

@sa3d_gltf_convert_coordinates_mesh_transform_inverse(&dst: ptr, &convert: ptr) -> void:
L_ENTRY:
    call @sa3d_gltf_convert_coordinates_mesh_transform(&dst, &convert)
    !convert
    !dst
    return

@sa3d_gltf_convert_coordinates_mesh_mat4(&dst: ptr, &convert: ptr) -> void:
L_ENTRY:
    rotate = load convert+SA3D_GLTF_CONVERT_COORDINATES_rotate_meshes as i32
    br rotate -> L_ROTATE, L_ID

L_ROTATE:
    call @sa3d_mat4_identity(&dst)
    store dst+0, SA3D_F32_NEG_ONE_BITS as i32
    store dst+40, SA3D_F32_NEG_ONE_BITS as i32
    !rotate
    !convert
    !dst
    return

L_ID:
    call @sa3d_mat4_identity(&dst)
    !rotate
    !convert
    !dst
    return
