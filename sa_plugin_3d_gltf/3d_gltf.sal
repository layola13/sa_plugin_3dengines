@sa3d_gltf_json_dimension_from_string(text: ptr, len: i64) -> i32:
L_ENTRY:
    scalar_len = eq len, 6
    br scalar_len -> L_SCALAR_CHECK, L_VEC_CHECK

L_SCALAR_CHECK:
    scalar_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_SCALAR, 6)
    br scalar_eq -> L_SCALAR, L_VEC_CHECK_AFTER_SCALAR

L_SCALAR:
    !scalar_eq
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_SCALAR

L_VEC_CHECK_AFTER_SCALAR:
    !scalar_eq
    jmp L_VEC_CHECK_WITH_SCALAR

L_VEC_CHECK:
    jmp L_VEC_CHECK_WITH_SCALAR

L_VEC_CHECK_WITH_SCALAR:
    vec_len = eq len, 4
    br vec_len -> L_VEC2_CHECK, L_UNSUPPORTED

L_VEC2_CHECK:
    vec2_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_VEC2, 4)
    br vec2_eq -> L_VEC2, L_VEC3_CHECK

L_VEC2:
    !vec2_eq
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_VEC2

L_VEC3_CHECK:
    vec3_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_VEC3, 4)
    br vec3_eq -> L_VEC3, L_VEC4_CHECK

L_VEC3:
    !vec3_eq
    !vec2_eq
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_VEC3

L_VEC4_CHECK:
    vec4_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_VEC4, 4)
    br vec4_eq -> L_VEC4, L_UNSUPPORTED_VEC

L_VEC4:
    !vec4_eq
    !vec3_eq
    !vec2_eq
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_VEC4

L_UNSUPPORTED_VEC:
    !vec4_eq
    !vec3_eq
    !vec2_eq
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_UNSUPPORTED

L_UNSUPPORTED:
    !vec_len
    !scalar_len
    !len
    !text
    return SA3D_GLTF_DIM_UNSUPPORTED

@sa3d_gltf_accessor_format_from_component_dimension(component_type: i32, dimension: i32) -> i32:
L_ENTRY:
    is_f32 = eq component_type, SA3D_GLTF_COMPONENT_F32
    br is_f32 -> L_F32, L_U32_CHECK

L_F32:
    dim_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br dim_scalar -> L_F32_SCALAR, L_F32_VEC2_CHECK
L_F32_SCALAR:
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_F32_SCALAR
L_F32_VEC2_CHECK:
    dim_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br dim_vec2 -> L_F32_VEC2, L_F32_VEC3_CHECK
L_F32_VEC2:
    !dim_vec2
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_F32X2
L_F32_VEC3_CHECK:
    dim_vec3 = eq dimension, SA3D_GLTF_DIM_VEC3
    br dim_vec3 -> L_F32_VEC3, L_F32_VEC4_CHECK
L_F32_VEC3:
    !dim_vec3
    !dim_vec2
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_F32X3
L_F32_VEC4_CHECK:
    dim_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br dim_vec4 -> L_F32_VEC4, L_UNSUPPORTED_F32
L_F32_VEC4:
    !dim_vec4
    !dim_vec3
    !dim_vec2
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_F32X4
L_UNSUPPORTED_F32:
    !dim_vec4
    !dim_vec3
    !dim_vec2
    !dim_scalar
    !is_f32
    !dimension
    !component_type
    return 0

L_U32_CHECK:
    is_u32 = eq component_type, SA3D_GLTF_COMPONENT_U32
    br is_u32 -> L_U32, L_I16_CHECK

L_U32:
    u32_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br u32_scalar -> L_U32_SCALAR, L_U32_VEC2_CHECK
L_U32_SCALAR:
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U32_SCALAR
L_U32_VEC2_CHECK:
    u32_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br u32_vec2 -> L_U32_VEC2, L_U32_VEC3_CHECK
L_U32_VEC2:
    !u32_vec2
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U32X2
L_U32_VEC3_CHECK:
    u32_vec3 = eq dimension, SA3D_GLTF_DIM_VEC3
    br u32_vec3 -> L_U32_VEC3, L_U32_VEC4_CHECK
L_U32_VEC3:
    !u32_vec3
    !u32_vec2
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U32X3
L_U32_VEC4_CHECK:
    u32_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br u32_vec4 -> L_U32_VEC4, L_UNSUPPORTED_U32
L_U32_VEC4:
    !u32_vec4
    !u32_vec3
    !u32_vec2
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U32X4
L_UNSUPPORTED_U32:
    !u32_vec4
    !u32_vec3
    !u32_vec2
    !u32_scalar
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_I16_CHECK:
    is_i16 = eq component_type, SA3D_GLTF_COMPONENT_I16
    br is_i16 -> L_I16, L_U16_CHECK
L_I16:
    i16_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br i16_vec2 -> L_I16_VEC2, L_I16_VEC4_CHECK
L_I16_VEC2:
    !i16_vec2
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S16X2
L_I16_VEC4_CHECK:
    i16_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br i16_vec4 -> L_I16_VEC4, L_UNSUPPORTED_I16
L_I16_VEC4:
    !i16_vec4
    !i16_vec2
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S16X4
L_UNSUPPORTED_I16:
    !i16_vec4
    !i16_vec2
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_U16_CHECK:
    is_u16 = eq component_type, SA3D_GLTF_COMPONENT_U16
    br is_u16 -> L_U16, L_I8_CHECK
L_U16:
    u16_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br u16_scalar -> L_U16_SCALAR, L_U16_VEC2_CHECK
L_U16_SCALAR:
    !u16_scalar
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U16_SCALAR
L_U16_VEC2_CHECK:
    !u16_scalar
    u16_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br u16_vec2 -> L_U16_VEC2, L_U16_VEC3_CHECK
L_U16_VEC2:
    !u16_vec2
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U16X2
L_U16_VEC3_CHECK:
    u16_vec3 = eq dimension, SA3D_GLTF_DIM_VEC3
    br u16_vec3 -> L_U16_VEC3, L_U16_VEC4_CHECK
L_U16_VEC3:
    !u16_vec3
    !u16_vec2
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U16X3
L_U16_VEC4_CHECK:
    u16_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br u16_vec4 -> L_U16_VEC4, L_UNSUPPORTED_U16
L_U16_VEC4:
    !u16_vec4
    !u16_vec3
    !u16_vec2
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U16X4
L_UNSUPPORTED_U16:
    !u16_vec4
    !u16_vec3
    !u16_vec2
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_I8_CHECK:
    is_i8 = eq component_type, SA3D_GLTF_COMPONENT_I8
    br is_i8 -> L_I8, L_U8_CHECK
L_I8:
    i8_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br i8_vec2 -> L_I8_VEC2, L_I8_VEC4_CHECK
L_I8_VEC2:
    !i8_vec2
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S8X2
L_I8_VEC4_CHECK:
    i8_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br i8_vec4 -> L_I8_VEC4, L_UNSUPPORTED_I8
L_I8_VEC4:
    !i8_vec4
    !i8_vec2
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_S8X4
L_UNSUPPORTED_I8:
    !i8_vec4
    !i8_vec2
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_U8_CHECK:
    is_u8 = eq component_type, SA3D_GLTF_COMPONENT_U8
    br is_u8 -> L_U8, L_UNSUPPORTED
L_U8:
    u8_scalar = eq dimension, SA3D_GLTF_DIM_SCALAR
    br u8_scalar -> L_U8_SCALAR, L_U8_VEC2_CHECK
L_U8_SCALAR:
    !u8_scalar
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U8_SCALAR
L_U8_VEC2_CHECK:
    !u8_scalar
    u8_vec2 = eq dimension, SA3D_GLTF_DIM_VEC2
    br u8_vec2 -> L_U8_VEC2, L_U8_VEC3_CHECK
L_U8_VEC2:
    !u8_vec2
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U8X2
L_U8_VEC3_CHECK:
    u8_vec3 = eq dimension, SA3D_GLTF_DIM_VEC3
    br u8_vec3 -> L_U8_VEC3, L_U8_VEC4_CHECK
L_U8_VEC3:
    !u8_vec3
    !u8_vec2
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U8X3
L_U8_VEC4_CHECK:
    u8_vec4 = eq dimension, SA3D_GLTF_DIM_VEC4
    br u8_vec4 -> L_U8_VEC4, L_UNSUPPORTED_U8
L_U8_VEC4:
    !u8_vec4
    !u8_vec3
    !u8_vec2
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return SA3D_GLTF_ACCESSOR_U8X4
L_UNSUPPORTED_U8:
    !u8_vec4
    !u8_vec3
    !u8_vec2
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

L_UNSUPPORTED:
    !is_u8
    !is_i8
    !is_u16
    !is_i16
    !is_u32
    !is_f32
    !dimension
    !component_type
    return 0

@sa3d_gltf_buffer_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_BUFFER_TABLE_URI_ptr, 0 as i64
    store out+SA3D_GLTF_BUFFER_TABLE_URI_len, 0 as i64
    store out+SA3D_GLTF_BUFFER_TABLE_byte_len, 0 as i64
    store out+SA3D_GLTF_BUFFER_TABLE_has_uri, 0 as i32
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_buffer_view_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_has_stride, 0 as i32
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_accessor_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_ACCESSOR_TABLE_buffer_view, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_byte_offset, 0 as i64
    store out+SA3D_GLTF_ACCESSOR_TABLE_count, 0 as i64
    store out+SA3D_GLTF_ACCESSOR_TABLE_component_type, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_dimension, SA3D_GLTF_DIM_UNSUPPORTED as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_normalized, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_accessor_format, 0 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_buffer_parse(bytes: ptr, len: i64, index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_buffer_table_clear(&out)
    object_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_BUFFERS, 7, index)
    missing_obj = eq object_pos, -1
    br missing_obj -> L_MISSING_OBJECT, L_MALFORMED_OBJ_CHECK

L_MALFORMED_OBJ_CHECK:
    malformed_obj = eq object_pos, -2
    br malformed_obj -> L_MALFORMED_OBJECT, L_BYTE_LENGTH_POS

L_BYTE_LENGTH_POS:
    byte_len_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_LENGTH, 10)
    missing_byte_len = eq byte_len_pos, -1
    br missing_byte_len -> L_MISSING_BYTE_LENGTH, L_BYTE_LENGTH_MALFORMED_CHECK

L_BYTE_LENGTH_MALFORMED_CHECK:
    malformed_byte_len_pos = eq byte_len_pos, -2
    br malformed_byte_len_pos -> L_MALFORMED_BYTE_LENGTH, L_PARSE_BYTE_LENGTH

L_PARSE_BYTE_LENGTH:
    byte_len = call @sa3d_gltf_json_parse_positive_i64(bytes, len, byte_len_pos)
    byte_len_bad = slt byte_len, 0
    br byte_len_bad -> L_MALFORMED_BYTE_LENGTH_VALUE, L_URI

L_URI:
    uri_ptr_slot = stack_alloc 8
    uri_len_slot = stack_alloc 8
    uri_status = call @sa3d_gltf_json_object_string_span(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_URI, 3, &uri_ptr_slot, &uri_len_slot)
    uri_bad = slt uri_status, 0
    br uri_bad -> L_MALFORMED_URI, L_STORE

L_STORE:
    has_uri = sgt uri_status, 0
    uri_ptr = load uri_ptr_slot+0 as ptr
    uri_len = load uri_len_slot+0 as i64
    store out+SA3D_GLTF_BUFFER_TABLE_URI_ptr, uri_ptr as ptr
    store out+SA3D_GLTF_BUFFER_TABLE_URI_len, uri_len as i64
    store out+SA3D_GLTF_BUFFER_TABLE_byte_len, byte_len as i64
    store out+SA3D_GLTF_BUFFER_TABLE_has_uri, has_uri as i32
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !uri_len
    !uri_ptr
    !has_uri
    !uri_bad
    !uri_status
    !byte_len_bad
    !byte_len
    !malformed_byte_len_pos
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING_OBJECT:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_OBJECT:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_BYTE_LENGTH:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_BYTE_LENGTH:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_byte_len_pos
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_BYTE_LENGTH_VALUE:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !byte_len_bad
    !byte_len
    !malformed_byte_len_pos
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_URI:
    store out+SA3D_GLTF_BUFFER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !uri_bad
    !uri_status
    !byte_len_bad
    !byte_len
    !malformed_byte_len_pos
    !missing_byte_len
    !byte_len_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_buffer_view_parse(bytes: ptr, len: i64, index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_buffer_view_table_clear(&out)
    object_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_BUFFER_VIEWS, 11, index)
    missing_obj = eq object_pos, -1
    br missing_obj -> L_MISSING_OBJECT, L_MALFORMED_OBJ_CHECK

L_MALFORMED_OBJ_CHECK:
    malformed_obj = eq object_pos, -2
    br malformed_obj -> L_MALFORMED_OBJECT, L_BUFFER_POS

L_BUFFER_POS:
    buffer_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BUFFER, 6)
    buffer_missing = eq buffer_pos, -1
    br buffer_missing -> L_MISSING_BUFFER, L_BUFFER_MALFORMED_CHECK

L_BUFFER_MALFORMED_CHECK:
    buffer_malformed = eq buffer_pos, -2
    br buffer_malformed -> L_MALFORMED_BUFFER, L_PARSE_BUFFER

L_PARSE_BUFFER:
    buffer_idx = call @sa3d_gltf_json_parse_positive_i64(bytes, len, buffer_pos)
    buffer_bad = slt buffer_idx, 0
    br buffer_bad -> L_MALFORMED_BUFFER_VALUE, L_BYTE_LENGTH_POS

L_BYTE_LENGTH_POS:
    byte_len_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_LENGTH, 10)
    byte_len_missing = eq byte_len_pos, -1
    br byte_len_missing -> L_MISSING_BYTE_LENGTH, L_BYTE_LENGTH_MALFORMED_CHECK

L_BYTE_LENGTH_MALFORMED_CHECK:
    byte_len_malformed = eq byte_len_pos, -2
    br byte_len_malformed -> L_MALFORMED_BYTE_LENGTH, L_PARSE_BYTE_LENGTH

L_PARSE_BYTE_LENGTH:
    byte_len = call @sa3d_gltf_json_parse_positive_i64(bytes, len, byte_len_pos)
    byte_len_bad = slt byte_len, 0
    br byte_len_bad -> L_MALFORMED_BYTE_LENGTH_VALUE, L_OPTIONALS

L_OPTIONALS:
    byte_offset = call @sa3d_gltf_json_object_i64_or_default(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_OFFSET, 10, 0)
    byte_offset_bad = slt byte_offset, 0
    br byte_offset_bad -> L_MALFORMED_BYTE_OFFSET, L_STRIDE

L_STRIDE:
    stride_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_STRIDE, 10)
    stride_missing = eq stride_pos, -1
    br stride_missing -> L_STRIDE_DEFAULT, L_STRIDE_MALFORMED_CHECK

L_STRIDE_MALFORMED_CHECK:
    stride_malformed = eq stride_pos, -2
    br stride_malformed -> L_MALFORMED_STRIDE, L_PARSE_STRIDE

L_PARSE_STRIDE:
    byte_stride = call @sa3d_gltf_json_parse_positive_i64(bytes, len, stride_pos)
    stride_bad = slt byte_stride, 0
    br stride_bad -> L_MALFORMED_STRIDE_VALUE, L_STORE_WITH_STRIDE

L_STRIDE_DEFAULT:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer, buffer_idx as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset, byte_offset as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len, byte_len as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride, 0 as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_has_stride, 0 as i32
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !stride_missing
    !stride_pos
    !byte_offset_bad
    !byte_offset
    !byte_len_bad
    !byte_len
    !byte_len_malformed
    !byte_len_missing
    !byte_len_pos
    !buffer_bad
    !buffer_idx
    !buffer_malformed
    !buffer_missing
    !buffer_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_STORE_WITH_STRIDE:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer, buffer_idx as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset, byte_offset as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len, byte_len as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride, byte_stride as i64
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_has_stride, 1 as i32
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !stride_bad
    !byte_stride
    !stride_malformed
    !stride_missing
    !stride_pos
    !byte_offset_bad
    !byte_offset
    !byte_len_bad
    !byte_len
    !byte_len_malformed
    !byte_len_missing
    !byte_len_pos
    !buffer_bad
    !buffer_idx
    !buffer_malformed
    !buffer_missing
    !buffer_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING_OBJECT:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_OBJECT:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_BUFFER:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !buffer_missing
    !buffer_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_BUFFER:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !buffer_malformed
    !buffer_missing
    !buffer_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_BUFFER_VALUE:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !buffer_bad
    !buffer_idx
    !buffer_malformed
    !buffer_missing
    !buffer_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_BYTE_LENGTH:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !byte_len_missing
    !byte_len_pos
    !buffer_bad
    !buffer_idx
    !buffer_malformed
    !buffer_missing
    !buffer_pos
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_BYTE_LENGTH:
L_MALFORMED_BYTE_LENGTH_VALUE:
L_MALFORMED_BYTE_OFFSET:
L_MALFORMED_STRIDE:
L_MALFORMED_STRIDE_VALUE:
    store out+SA3D_GLTF_BUFFER_VIEW_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_accessor_parse(bytes: ptr, len: i64, index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_accessor_table_clear(&out)
    buffer_view_slot = stack_alloc 8
    has_buffer_view_slot = stack_alloc 4
    byte_offset_slot = stack_alloc 8
    count_slot = stack_alloc 8
    component_type_slot = stack_alloc 4
    dimension_slot = stack_alloc 4
    normalized_slot = stack_alloc 4
    format_slot = stack_alloc 4
    type_ptr_slot = stack_alloc 8
    type_len_slot = stack_alloc 8
    object_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_ACCESSORS, 9, index)
    missing_obj = eq object_pos, -1
    br missing_obj -> L_MISSING_OBJECT, L_MALFORMED_OBJ_CHECK

L_MALFORMED_OBJ_CHECK:
    malformed_obj = eq object_pos, -2
    br malformed_obj -> L_MALFORMED_OBJECT, L_BUFFER_VIEW

L_BUFFER_VIEW:
    bv_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BUFFER_VIEW, 10)
    bv_missing = eq bv_pos, -1
    br bv_missing -> L_BUFFER_VIEW_DEFAULT, L_BUFFER_VIEW_MALFORMED_CHECK

L_BUFFER_VIEW_MALFORMED_CHECK:
    bv_malformed = eq bv_pos, -2
    br bv_malformed -> L_MALFORMED_BUFFER_VIEW, L_PARSE_BUFFER_VIEW

L_PARSE_BUFFER_VIEW:
    bv_value = call @sa3d_gltf_json_parse_positive_i64(bytes, len, bv_pos)
    bv_bad = slt bv_value, 0
    br bv_bad -> L_MALFORMED_BUFFER_VIEW_VALUE, L_STORE_BUFFER_VIEW

L_STORE_BUFFER_VIEW:
    store buffer_view_slot+0, bv_value as i64
    store has_buffer_view_slot+0, 1 as i32
    !bv_bad
    !bv_value
    !bv_malformed
    !bv_missing
    !bv_pos
    jmp L_BYTE_OFFSET

L_BUFFER_VIEW_DEFAULT:
    store buffer_view_slot+0, 0 as i64
    store has_buffer_view_slot+0, 0 as i32
    !bv_missing
    !bv_pos
    jmp L_BYTE_OFFSET

L_BYTE_OFFSET:
    byte_offset = call @sa3d_gltf_json_object_i64_or_default(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_BYTE_OFFSET, 10, 0)
    byte_offset_bad = slt byte_offset, 0
    br byte_offset_bad -> L_MALFORMED_BYTE_OFFSET, L_STORE_BYTE_OFFSET

L_STORE_BYTE_OFFSET:
    store byte_offset_slot+0, byte_offset as i64
    !byte_offset_bad
    !byte_offset
    jmp L_COUNT_POS

L_COUNT_POS:
    count_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_COUNT, 5)
    count_missing = eq count_pos, -1
    br count_missing -> L_MISSING_COUNT, L_COUNT_MALFORMED_CHECK

L_COUNT_MALFORMED_CHECK:
    count_malformed = eq count_pos, -2
    br count_malformed -> L_MALFORMED_COUNT, L_PARSE_COUNT

L_PARSE_COUNT:
    count_value = call @sa3d_gltf_json_parse_positive_i64(bytes, len, count_pos)
    count_bad = slt count_value, 0
    br count_bad -> L_MALFORMED_COUNT_VALUE, L_STORE_COUNT

L_STORE_COUNT:
    store count_slot+0, count_value as i64
    !count_bad
    !count_value
    !count_malformed
    !count_missing
    !count_pos
    jmp L_COMPONENT_POS

L_COMPONENT_POS:
    comp_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_COMPONENT_TYPE, 13)
    comp_missing = eq comp_pos, -1
    br comp_missing -> L_MISSING_COMPONENT, L_COMPONENT_MALFORMED_CHECK

L_COMPONENT_MALFORMED_CHECK:
    comp_malformed = eq comp_pos, -2
    br comp_malformed -> L_MALFORMED_COMPONENT, L_PARSE_COMPONENT

L_PARSE_COMPONENT:
    comp_value64 = call @sa3d_gltf_json_parse_positive_i64(bytes, len, comp_pos)
    comp_bad = slt comp_value64, 0
    br comp_bad -> L_MALFORMED_COMPONENT_VALUE, L_STORE_COMPONENT

L_STORE_COMPONENT:
    comp_value = trunc comp_value64 as i32
    store component_type_slot+0, comp_value as i32
    !comp_value
    !comp_bad
    !comp_value64
    !comp_malformed
    !comp_missing
    !comp_pos
    jmp L_TYPE

L_TYPE:
    type_status = call @sa3d_gltf_json_object_string_span(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_TYPE, 4, &type_ptr_slot, &type_len_slot)
    type_missing = eq type_status, 0
    br type_missing -> L_MISSING_TYPE, L_TYPE_MALFORMED_CHECK

L_TYPE_MALFORMED_CHECK:
    type_bad = slt type_status, 0
    br type_bad -> L_MALFORMED_TYPE, L_DIMENSION

L_DIMENSION:
    type_ptr = load type_ptr_slot+0 as ptr
    type_len = load type_len_slot+0 as i64
    dimension = call @sa3d_gltf_json_dimension_from_string(type_ptr, type_len)
    dimension_bad = eq dimension, SA3D_GLTF_DIM_UNSUPPORTED
    br dimension_bad -> L_UNSUPPORTED_DIMENSION, L_STORE_DIMENSION

L_STORE_DIMENSION:
    store dimension_slot+0, dimension as i32
    !dimension_bad
    !dimension
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    jmp L_NORMALIZED

L_NORMALIZED:
    normalized = call @sa3d_gltf_json_object_bool_or_default(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_NORMALIZED, 10, 0)
    normalized_bad = slt normalized, 0
    br normalized_bad -> L_MALFORMED_NORMALIZED, L_STORE_NORMALIZED

L_STORE_NORMALIZED:
    store normalized_slot+0, normalized as i32
    !normalized_bad
    !normalized
    jmp L_FORMAT

L_FORMAT:
    component_type = load component_type_slot+0 as i32
    dimension2 = load dimension_slot+0 as i32
    accessor_format = call @sa3d_gltf_accessor_format_from_component_dimension(component_type, dimension2)
    format_bad = eq accessor_format, 0
    br format_bad -> L_UNSUPPORTED_FORMAT, L_STORE_SUCCESS

L_STORE_SUCCESS:
    buffer_view = load buffer_view_slot+0 as i64
    has_buffer_view = load has_buffer_view_slot+0 as i32
    byte_offset_final = load byte_offset_slot+0 as i64
    count_final = load count_slot+0 as i64
    normalized_final = load normalized_slot+0 as i32
    store format_slot+0, accessor_format as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_buffer_view, buffer_view as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view, has_buffer_view as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_byte_offset, byte_offset_final as i64
    store out+SA3D_GLTF_ACCESSOR_TABLE_count, count_final as i64
    store out+SA3D_GLTF_ACCESSOR_TABLE_component_type, component_type as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_dimension, dimension2 as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_normalized, normalized_final as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_accessor_format, accessor_format as i32
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !normalized_final
    !count_final
    !byte_offset_final
    !has_buffer_view
    !buffer_view
    !format_bad
    !accessor_format
    !dimension2
    !component_type
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING_OBJECT:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_OBJECT:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_obj
    !missing_obj
    !object_pos
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MALFORMED_BUFFER_VIEW:
L_MALFORMED_BUFFER_VIEW_VALUE:
L_MALFORMED_BYTE_OFFSET:
L_MALFORMED_COUNT:
L_MALFORMED_COUNT_VALUE:
L_MALFORMED_COMPONENT:
L_MALFORMED_COMPONENT_VALUE:
L_MALFORMED_TYPE:
L_MALFORMED_NORMALIZED:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_COUNT:
L_MISSING_COMPONENT:
L_MISSING_TYPE:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_UNSUPPORTED_DIMENSION:
L_UNSUPPORTED_FORMAT:
    store out+SA3D_GLTF_ACCESSOR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT as i32
    !out
    !index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

@sa3d_gltf_json_primitive_attr_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_position, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_normal, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_tangent, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_color0, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord0, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord1, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_joints0, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_weights0, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_position, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_normal, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_tangent, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_color0, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord0, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord1, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_joints0, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_weights0, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_count, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_primitive_attr_table_read_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &table: ptr, value_offset: i64, has_offset: i64, &count_slot: ptr) -> i32:
L_ENTRY:
    value_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, object_pos, key, key_len, &value_slot)
    found = eq status, 1
    br found -> L_FOUND, L_MISSING_CHECK

L_MISSING_CHECK:
    missing = eq status, 0
    br missing -> L_MISSING, L_BAD

L_FOUND:
    value = load value_slot+0 as i64
    value_ptr = ptr_add table, value_offset
    has_ptr = ptr_add table, has_offset
    old_count = load count_slot+0 as i64
    next_count = add old_count, 1
    store value_ptr+0, value as i64
    store has_ptr+0, 1 as i32
    store count_slot+0, next_count as i64
    !next_count
    !old_count
    !has_ptr
    !value_ptr
    !value
    !found
    !status
    !count_slot
    !has_offset
    !value_offset
    !table
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 1

L_MISSING:
    !missing
    !found
    !status
    !count_slot
    !has_offset
    !value_offset
    !table
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return 0

L_BAD:
    !missing
    !found
    !status
    !count_slot
    !has_offset
    !value_offset
    !table
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_primitive_attr_table_parse(bytes: ptr, len: i64, primitive_object_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_json_primitive_attr_table_clear(&out)
    attr_pos = call @sa3d_gltf_json_object_field_value(bytes, len, primitive_object_pos, &SA3D_GLTF_JSON_KEY_ATTRIBUTES, 10)
    missing_attr = eq attr_pos, -1
    br missing_attr -> L_MISSING_ATTR, L_MALFORMED_ATTR_CHECK

L_MALFORMED_ATTR_CHECK:
    malformed_attr = eq attr_pos, -2
    br malformed_attr -> L_MALFORMED_ATTR, L_PARSE_FIELDS

L_PARSE_FIELDS:
    count_slot = stack_alloc 8
    store count_slot+0, 0 as i64
    s0 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_POSITION, 8, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_position, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_position, &count_slot)
    s1 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_NORMAL, 6, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_normal, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_normal, &count_slot)
    s2 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_TANGENT, 7, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_tangent, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_tangent, &count_slot)
    s3 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_COLOR_0, 7, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_color0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_color0, &count_slot)
    s4 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_TEXCOORD_0, 10, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord0, &count_slot)
    s5 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_TEXCOORD_1, 10, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_texcoord1, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_texcoord1, &count_slot)
    s6 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_JOINTS_0, 8, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_joints0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_joints0, &count_slot)
    s7 = call @sa3d_gltf_json_primitive_attr_table_read_field(bytes, len, attr_pos, &SA3D_GLTF_JSON_TEXT_WEIGHTS_0, 9, &out, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_weights0, SA3D_GLTF_PRIMITIVE_ATTR_TABLE_has_weights0, &count_slot)
    b0 = slt s0, 0
    b1 = slt s1, 0
    b2 = slt s2, 0
    b3 = slt s3, 0
    b4 = slt s4, 0
    b5 = slt s5, 0
    b6 = slt s6, 0
    b7 = slt s7, 0
    a0 = or b0, b1
    a1 = or b2, b3
    a2 = or b4, b5
    a3 = or b6, b7
    a4 = or a0, a1
    a5 = or a2, a3
    any_bad = or a4, a5
    br any_bad -> L_BAD_FIELDS, L_OK_FIELDS

L_OK_FIELDS:
    count = load count_slot+0 as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_count, count as i64
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !count
    !any_bad
    !a5
    !a4
    !a3
    !a2
    !a1
    !a0
    !b7
    !b6
    !b5
    !b4
    !b3
    !b2
    !b1
    !b0
    !s7
    !s6
    !s5
    !s4
    !s3
    !s2
    !s1
    !s0
    !malformed_attr
    !missing_attr
    !attr_pos
    !out
    !primitive_object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_FIELDS:
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !any_bad
    !a5
    !a4
    !a3
    !a2
    !a1
    !a0
    !b7
    !b6
    !b5
    !b4
    !b3
    !b2
    !b1
    !b0
    !s7
    !s6
    !s5
    !s4
    !s3
    !s2
    !s1
    !s0
    !malformed_attr
    !missing_attr
    !attr_pos
    !out
    !primitive_object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_ATTR:
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing_attr
    !attr_pos
    !out
    !primitive_object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_ATTR:
    store out+SA3D_GLTF_PRIMITIVE_ATTR_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed_attr
    !missing_attr
    !attr_pos
    !out
    !primitive_object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_primitive_table_clear(&out: ptr) -> void:
L_ENTRY:
    attrs = ptr_add out, SA3D_GLTF_PRIMITIVE_TABLE_attributes
    store out+SA3D_GLTF_PRIMITIVE_TABLE_mode, SA3D_GLTF_MODE_TRIANGLES as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_has_indices, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_indices, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_has_material, 0 as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_material, 0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    call @sa3d_gltf_json_primitive_attr_table_clear(&attrs)
    !attrs
    !out
    return

@sa3d_gltf_json_mesh_primitive_object_start(bytes: ptr, len: i64, mesh_index: i64, primitive_index: i64) -> i64:
L_ENTRY:
    mesh_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MESHES, 6, mesh_index)
    mesh_missing = eq mesh_pos, -1
    br mesh_missing -> L_MISSING_MESH, L_MESH_MALFORMED_CHECK

L_MESH_MALFORMED_CHECK:
    mesh_malformed = eq mesh_pos, -2
    br mesh_malformed -> L_MALFORMED_MESH, L_PRIMITIVES_FIELD

L_PRIMITIVES_FIELD:
    primitives_pos = call @sa3d_gltf_json_object_field_value(bytes, len, mesh_pos, &SA3D_GLTF_JSON_KEY_PRIMITIVES, 10)
    primitives_missing = eq primitives_pos, -1
    br primitives_missing -> L_MISSING_PRIMITIVES, L_PRIMITIVES_MALFORMED_CHECK

L_PRIMITIVES_MALFORMED_CHECK:
    primitives_malformed = eq primitives_pos, -2
    br primitives_malformed -> L_MALFORMED_PRIMITIVES, L_PRIMITIVE_ITEM

L_PRIMITIVE_ITEM:
    primitive_pos = call @sa3d_gltf_json_array_item_start(bytes, len, primitives_pos, primitive_index)
    primitive_missing = eq primitive_pos, -1
    br primitive_missing -> L_MISSING_PRIMITIVE, L_PRIMITIVE_MALFORMED_CHECK

L_PRIMITIVE_MALFORMED_CHECK:
    primitive_malformed = eq primitive_pos, -2
    br primitive_malformed -> L_MALFORMED_PRIMITIVE, L_OK

L_OK:
    !primitive_malformed
    !primitive_missing
    !primitives_malformed
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return primitive_pos

L_MISSING_PRIMITIVE:
    !primitive_missing
    !primitive_pos
    !primitives_malformed
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -1

L_MALFORMED_PRIMITIVE:
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !primitives_malformed
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -2

L_MISSING_PRIMITIVES:
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -1

L_MALFORMED_PRIMITIVES:
    !primitives_malformed
    !primitives_missing
    !primitives_pos
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -2

L_MISSING_MESH:
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -1

L_MALFORMED_MESH:
    !mesh_malformed
    !mesh_missing
    !mesh_pos
    !primitive_index
    !mesh_index
    !len
    !bytes
    return -2

@sa3d_gltf_json_primitive_parse(bytes: ptr, len: i64, mesh_index: i64, primitive_index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_json_primitive_table_clear(&out)
    mode_slot = stack_alloc 8
    indices_slot = stack_alloc 8
    material_slot = stack_alloc 8
    primitive_pos = call @sa3d_gltf_json_mesh_primitive_object_start(bytes, len, mesh_index, primitive_index)
    primitive_missing = eq primitive_pos, -1
    br primitive_missing -> L_MISSING_PRIMITIVE, L_PRIMITIVE_MALFORMED_CHECK

L_PRIMITIVE_MALFORMED_CHECK:
    primitive_malformed = eq primitive_pos, -2
    br primitive_malformed -> L_MALFORMED_PRIMITIVE, L_MODE

L_MODE:
    mode_status = call @sa3d_gltf_json_object_i64_value(bytes, len, primitive_pos, &SA3D_GLTF_JSON_KEY_MODE, 4, &mode_slot)
    mode_bad = slt mode_status, 0
    br mode_bad -> L_BAD_MODE, L_MODE_MISSING_CHECK

L_MODE_MISSING_CHECK:
    mode_missing = eq mode_status, 0
    br mode_missing -> L_MODE_DEFAULT, L_MODE_FOUND

L_MODE_DEFAULT:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_mode, SA3D_GLTF_MODE_TRIANGLES as i32
    !mode_missing
    !mode_bad
    !mode_status
    jmp L_INDICES

L_MODE_FOUND:
    mode_value = load mode_slot+0 as i64
    mode_i32 = trunc mode_value as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_mode, mode_i32 as i32
    !mode_i32
    !mode_value
    !mode_missing
    !mode_bad
    !mode_status
    jmp L_INDICES

L_INDICES:
    indices_status = call @sa3d_gltf_json_object_i64_value(bytes, len, primitive_pos, &SA3D_GLTF_JSON_KEY_INDICES, 7, &indices_slot)
    indices_bad = slt indices_status, 0
    br indices_bad -> L_BAD_INDICES, L_INDICES_MISSING_CHECK

L_INDICES_MISSING_CHECK:
    indices_missing = eq indices_status, 0
    br indices_missing -> L_INDICES_DONE_MISSING, L_INDICES_FOUND

L_INDICES_DONE_MISSING:
    !indices_missing
    !indices_bad
    !indices_status
    jmp L_MATERIAL

L_INDICES_FOUND:
    indices_value = load indices_slot+0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_has_indices, 1 as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_indices, indices_value as i64
    !indices_value
    !indices_missing
    !indices_bad
    !indices_status
    jmp L_MATERIAL

L_MATERIAL:
    material_status = call @sa3d_gltf_json_object_i64_value(bytes, len, primitive_pos, &SA3D_GLTF_JSON_KEY_MATERIAL, 8, &material_slot)
    material_bad = slt material_status, 0
    br material_bad -> L_BAD_MATERIAL, L_MATERIAL_MISSING_CHECK

L_MATERIAL_MISSING_CHECK:
    material_missing = eq material_status, 0
    br material_missing -> L_MATERIAL_DONE_MISSING, L_MATERIAL_FOUND

L_MATERIAL_DONE_MISSING:
    !material_missing
    !material_bad
    !material_status
    jmp L_ATTRIBUTES

L_MATERIAL_FOUND:
    material_value = load material_slot+0 as i64
    store out+SA3D_GLTF_PRIMITIVE_TABLE_has_material, 1 as i32
    store out+SA3D_GLTF_PRIMITIVE_TABLE_material, material_value as i64
    !material_value
    !material_missing
    !material_bad
    !material_status
    jmp L_ATTRIBUTES

L_ATTRIBUTES:
    attrs = ptr_add out, SA3D_GLTF_PRIMITIVE_TABLE_attributes
    attr_status = call @sa3d_gltf_json_primitive_attr_table_parse(bytes, len, primitive_pos, &attrs)
    attr_ok = eq attr_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br attr_ok -> L_OK, L_BAD_ATTRIBUTES

L_OK:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !attr_ok
    !attr_status
    !attrs
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_ATTRIBUTES:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, attr_status as i32
    !attr_ok
    !attrs
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return attr_status

L_MISSING_PRIMITIVE:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED_PRIMITIVE:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MODE:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !mode_bad
    !mode_status
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_INDICES:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !indices_bad
    !indices_status
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MATERIAL:
    store out+SA3D_GLTF_PRIMITIVE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !material_bad
    !material_status
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !primitive_index
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_index_format_from_component_type(component_type: i32) -> i32:
L_ENTRY:
    is_u8 = eq component_type, SA3D_GLTF_COMPONENT_U8
    br is_u8 -> L_U8, L_U16_CHECK

L_U8:
    !is_u8
    !component_type
    return SA3D_GLTF_INDEX_FORMAT_U8

L_U16_CHECK:
    is_u16 = eq component_type, SA3D_GLTF_COMPONENT_U16
    br is_u16 -> L_U16, L_U32_CHECK

L_U16:
    !is_u16
    !is_u8
    !component_type
    return SA3D_GLTF_INDEX_FORMAT_U16

L_U32_CHECK:
    is_u32 = eq component_type, SA3D_GLTF_COMPONENT_U32
    br is_u32 -> L_U32, L_UNSUPPORTED

L_U32:
    !is_u32
    !is_u16
    !is_u8
    !component_type
    return SA3D_GLTF_INDEX_FORMAT_U32

L_UNSUPPORTED:
    !is_u32
    !is_u16
    !is_u8
    !component_type
    return 0

@sa3d_gltf_json_resolve_accessor_layout(bytes: ptr, len: i64, accessor_index: i64, buffer_index: i64, buffer_len: i64, &accessor: ptr, &view: ptr, &layout: ptr) -> i32:
L_ENTRY:
    buffer_table = stack_alloc SA3D_GLTF_BUFFER_TABLE_SIZE
    accessor_status = call @sa3d_gltf_json_accessor_parse(bytes, len, accessor_index, &accessor)
    accessor_ok = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_ok -> L_HAS_BUFFER_VIEW, L_ACCESSOR_UNSUPPORTED_CHECK

L_ACCESSOR_UNSUPPORTED_CHECK:
    accessor_unsupported = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br accessor_unsupported -> L_UNSUPPORTED_FORMAT, L_JSON_ERROR_ACCESSOR

L_HAS_BUFFER_VIEW:
    has_bv = load accessor+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view as i32
    has_bv_bool = ne has_bv, 0
    br has_bv_bool -> L_PARSE_VIEW, L_MISSING_BUFFER_VIEW

L_PARSE_VIEW:
    bv_i32 = load accessor+SA3D_GLTF_ACCESSOR_TABLE_buffer_view as i32
    bv_index = zext bv_i32 as i64
    view_status = call @sa3d_gltf_json_buffer_view_parse(bytes, len, bv_index, &view)
    view_ok = eq view_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br view_ok -> L_BUFFER_MATCH, L_JSON_ERROR_VIEW

L_BUFFER_MATCH:
    view_buffer = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer as i64
    same_buffer = eq view_buffer, buffer_index
    br same_buffer -> L_PARSE_BUFFER, L_BUFFER_MISMATCH

L_PARSE_BUFFER:
    buffer_status = call @sa3d_gltf_json_buffer_parse(bytes, len, view_buffer, &buffer_table)
    buffer_ok = eq buffer_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br buffer_ok -> L_BUFFER_LENGTH, L_JSON_ERROR_BUFFER

L_BUFFER_LENGTH:
    declared_len = load buffer_table+SA3D_GLTF_BUFFER_TABLE_byte_len as i64
    len_ok = sge buffer_len, declared_len
    br len_ok -> L_VALIDATE, L_LAYOUT_ERROR_BUFFER_LENGTH

L_VALIDATE:
    view_offset = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset as i64
    view_len = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len as i64
    view_stride = load view+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride as i64
    accessor_offset = load accessor+SA3D_GLTF_ACCESSOR_TABLE_byte_offset as i64
    accessor_count = load accessor+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    layout_status = call @sa3d_gltf_accessor_layout_validate(buffer_len, view_offset, view_len, view_stride, accessor_offset, accessor_count, accessor_format, &layout)
    layout_ok = eq layout_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    br layout_ok -> L_OK, L_LAYOUT_ERROR

L_OK:
    !layout_ok
    !layout_status
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !len_ok
    !declared_len
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_OK

L_LAYOUT_ERROR:
    !layout_ok
    !layout_status
    !accessor_format
    !accessor_count
    !accessor_offset
    !view_stride
    !view_len
    !view_offset
    !len_ok
    !declared_len
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_LAYOUT_ERROR

L_LAYOUT_ERROR_BUFFER_LENGTH:
    !len_ok
    !declared_len
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_LAYOUT_ERROR

L_JSON_ERROR_BUFFER:
    !buffer_ok
    !buffer_status
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_JSON_ERROR

L_BUFFER_MISMATCH:
    !same_buffer
    !view_buffer
    !view_ok
    !view_status
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_ok
    !accessor_status
    !layout
    !view
    !accessor
    !buffer_len
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_JSON_RESOLVE_STATUS_BUFFER_MISMATCH

L_JSON_ERROR_VIEW:
    !view_ok
    !view_status
    !bv_index
    !bv_i32
