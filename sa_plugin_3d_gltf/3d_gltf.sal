@sa3d_gltf_vertex_attribute_materialize(buffer: ptr, accessor_count: i64, conversion: i32, accessor_format: i32, normalized: i32, convert_coordinates: i32, &layout: ptr, dst: ptr, cap: i64, &out_len: ptr) -> i32:
