@sa3d_gltf_json_object_string_span(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out_ptr: ptr, &out_len: ptr) -> i32:
L_ENTRY:
    store out_ptr+0, 0 as i64
    store out_len+0, 0 as i64
    value_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, key, key_len)
    missing = eq value_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

