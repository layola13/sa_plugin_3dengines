    return SA3D_GLTF_JSON_RESOLVE_STATUS_JSON_ERROR

@sa3d_gltf_animation_channel_output_width(keyframe_count: i64, output_count: i64, path: i32, interpolation: i32) -> i64:
L_ENTRY:
    keyframes_positive = sgt keyframe_count, 0
    output_positive = sgt output_count, 0
    counts_positive = and keyframes_positive, output_positive
    br counts_positive -> L_SINGLE_CHECK, L_INVALID_COUNTS

L_SINGLE_CHECK:
    single = eq keyframe_count, 1
    br single -> L_SINGLE, L_WEIGHTS_CHECK

L_SINGLE:
    weights_single = eq path, SA3D_GLTF_ANIMATION_PATH_WEIGHTS
    br weights_single -> L_SINGLE_WEIGHTS, L_SINGLE_NON_WEIGHTS

L_SINGLE_WEIGHTS:
    !weights_single
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !interpolation
    !path
    !keyframe_count
    return output_count

L_SINGLE_NON_WEIGHTS:
    !weights_single
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !output_count
    !interpolation
    !path
    !keyframe_count
    return 1

L_WEIGHTS_CHECK:
    weights = eq path, SA3D_GLTF_ANIMATION_PATH_WEIGHTS
    br weights -> L_WEIGHTS, L_NON_WEIGHTS

L_WEIGHTS:
    cubic_weights = eq interpolation, SA3D_GLTF_ANIMATION_INTERPOLATION_CUBIC_SPLINE
    br cubic_weights -> L_WEIGHTS_CUBIC, L_WEIGHTS_WIDE

L_WEIGHTS_CUBIC:
    divisor = mul keyframe_count, 3
    q = sdiv output_count, divisor
    rem = srem output_count, divisor
    rem_ok = eq rem, 0
    q_ok = sgt q, 0
    ok = and rem_ok, q_ok
    br ok -> L_WEIGHTS_CUBIC_OK, L_WEIGHTS_CUBIC_BAD

L_WEIGHTS_CUBIC_OK:
    !ok
    !q_ok
    !rem_ok
    !rem
    !divisor
    !cubic_weights
    !weights
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !interpolation
    !path
    !output_count
    !keyframe_count
    return q

L_WEIGHTS_CUBIC_BAD:
    !ok
    !q_ok
    !rem_ok
    !rem
    !q
    !divisor
    !cubic_weights
    !weights
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !interpolation
    !path
    !output_count
    !keyframe_count
    return 0

L_WEIGHTS_WIDE:
    q_w = sdiv output_count, keyframe_count
    rem_w = srem output_count, keyframe_count
    rem_w_ok = eq rem_w, 0
    q_w_ok = sgt q_w, 0
    ok_w = and rem_w_ok, q_w_ok
    br ok_w -> L_WEIGHTS_WIDE_OK, L_WEIGHTS_WIDE_BAD

L_WEIGHTS_WIDE_OK:
    !ok_w
    !q_w_ok
    !rem_w_ok
    !rem_w
    !cubic_weights
    !weights
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !interpolation
    !path
    !output_count
    !keyframe_count
    return q_w

L_WEIGHTS_WIDE_BAD:
    !ok_w
    !q_w_ok
    !rem_w_ok
    !rem_w
    !q_w
    !cubic_weights
    !weights
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !interpolation
    !path
    !output_count
    !keyframe_count
    return 0

L_NON_WEIGHTS:
    cubic = eq interpolation, SA3D_GLTF_ANIMATION_INTERPOLATION_CUBIC_SPLINE
    br cubic -> L_NON_WEIGHTS_CUBIC, L_NON_WEIGHTS_WIDE

L_NON_WEIGHTS_CUBIC:
    expected = mul keyframe_count, 3
    eq_expected = eq output_count, expected
    br eq_expected -> L_NON_WEIGHTS_OK_CUBIC, L_NON_WEIGHTS_BAD_CUBIC

L_NON_WEIGHTS_OK_CUBIC:
    !eq_expected
    !expected
    !cubic
    !weights
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !output_count
    !interpolation
    !path
    !keyframe_count
    return 1

L_NON_WEIGHTS_BAD_CUBIC:
    !eq_expected
    !expected
    !cubic
    !weights
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !output_count
    !interpolation
    !path
    !keyframe_count
    return 0

L_NON_WEIGHTS_WIDE:
    eq_keyframes = eq output_count, keyframe_count
    br eq_keyframes -> L_NON_WEIGHTS_OK_WIDE, L_NON_WEIGHTS_BAD_WIDE

L_NON_WEIGHTS_OK_WIDE:
    !eq_keyframes
    !cubic
    !weights
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !output_count
    !interpolation
    !path
    !keyframe_count
    return 1

L_NON_WEIGHTS_BAD_WIDE:
    !eq_keyframes
    !cubic
    !weights
    !single
    !counts_positive
    !output_positive
    !keyframes_positive
    !output_count
    !interpolation
    !path
    !keyframe_count
    return 0

L_INVALID_COUNTS:
    !counts_positive
    !output_positive
    !keyframes_positive
    !output_count
    !interpolation
    !path
    !keyframe_count
    return 0

@sa3d_gltf_json_animation_channel_sampler_read(bytes: ptr, len: i64, animation_index: i64, channel_index: i64, &channel: ptr, &sampler: ptr) -> i32:
L_ENTRY:
    animation = stack_alloc SA3D_GLTF_ANIMATION_TABLE_SIZE
    animation_status = call @sa3d_gltf_json_animation_parse(bytes, len, animation_index, &animation)
    animation_ok = eq animation_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br animation_ok -> L_CHANNEL, L_JSON_ERROR_ANIMATION

L_CHANNEL:
    channel_status = call @sa3d_gltf_json_animation_channel_parse(bytes, len, &animation, channel_index, &channel)
    channel_ok = eq channel_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br channel_ok -> L_SAMPLER, L_JSON_ERROR_CHANNEL

L_SAMPLER:
    sampler_index = load channel+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_sampler as i64
    sampler_status = call @sa3d_gltf_json_animation_sampler_parse(bytes, len, &animation, sampler_index, &sampler)
    sampler_ok = eq sampler_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br sampler_ok -> L_INPUT_CHECK, L_JSON_ERROR_SAMPLER

L_INPUT_CHECK:
    missing_input = load sampler+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_input as i32
    input_missing = ne missing_input, 0
    br input_missing -> L_MISSING_INPUT, L_OUTPUT_CHECK

L_OUTPUT_CHECK:
    missing_output = load sampler+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_output as i32
    output_missing = ne missing_output, 0
    br output_missing -> L_MISSING_OUTPUT, L_OK

L_OK:
    !output_missing
    !missing_output
    !input_missing
    !missing_input
    !sampler_ok
    !sampler_status
    !sampler_index
    !channel_ok
    !channel_status
    !animation_ok
    !animation_status
    !sampler
    !channel
    !channel_index
    !animation_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_MISSING_OUTPUT:
    !output_missing
    !missing_output
    !input_missing
    !missing_input
    !sampler_ok
    !sampler_status
    !sampler_index
    !channel_ok
    !channel_status
    !animation_ok
    !animation_status
    !sampler
    !channel
    !channel_index
    !animation_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_MISSING_SAMPLER_OUTPUT

L_MISSING_INPUT:
    !input_missing
    !missing_input
    !sampler_ok
    !sampler_status
    !sampler_index
    !channel_ok
    !channel_status
    !animation_ok
    !animation_status
    !sampler
    !channel
    !channel_index
    !animation_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_MISSING_SAMPLER_INPUT

L_JSON_ERROR_SAMPLER:
    !sampler_ok
    !sampler_status
    !sampler_index
    !channel_ok
    !channel_status
    !animation_ok
    !animation_status
    !sampler
    !channel
    !channel_index
    !animation_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_JSON_ERROR

L_JSON_ERROR_CHANNEL:
    !channel_ok
    !channel_status
    !animation_ok
    !animation_status
    !sampler
    !channel
    !channel_index
    !animation_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_JSON_ERROR

L_JSON_ERROR_ANIMATION:
    !animation_ok
    !animation_status
    !sampler
    !channel
    !channel_index
    !animation_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_JSON_ERROR

@sa3d_gltf_json_animation_input_read(bytes: ptr, len: i64, accessor_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, dst: ptr, cap: i64, &out_len: ptr, &out_count: ptr) -> i32:
L_ENTRY:
    accessor = stack_alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    store out_len+0, 0 as i64
    store out_count+0, 0 as i64
    sparse = call @sa3d_gltf_json_accessor_has_sparse(bytes, len, accessor_index)
    sparse_bad = slt sparse, 0
    br sparse_bad -> L_JSON_ERROR_SPARSE, L_SPARSE_CHECK

L_SPARSE_CHECK:
    sparse_present = sgt sparse, 0
    br sparse_present -> L_SPARSE_SKIP, L_ACCESSOR_FOR_VIEW

L_ACCESSOR_FOR_VIEW:
    accessor_parse_status = call @sa3d_gltf_json_accessor_parse(bytes, len, accessor_index, &accessor)
    accessor_parse_ok = eq accessor_parse_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_parse_ok -> L_INPUT_HAS_BUFFER_VIEW, L_ACCESSOR_PARSE_ERROR

L_INPUT_HAS_BUFFER_VIEW:
    has_bv = load accessor+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view as i32
    has_bv_bool = ne has_bv, 0
    br has_bv_bool -> L_RESOLVE, L_SPARSE_SKIP_NO_BASE

L_RESOLVE:
    resolve_status = call @sa3d_gltf_json_resolve_accessor_layout(bytes, len, accessor_index, buffer_index, buffer_len, &accessor, &view, &layout)
    resolve_ok = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br resolve_ok -> L_COUNT, L_RESOLVE_ERROR

L_COUNT:
    accessor_count = load accessor+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    empty = eq accessor_count, 0
    br empty -> L_EMPTY_INPUT, L_MATERIALIZE

L_MATERIALIZE:
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    status = call @sa3d_gltf_animation_input_materialize(buffer, accessor_count, accessor_format, &layout, dst, cap, &out_len)
    status_ok = eq status, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    br status_ok -> L_OK, L_RETURN_STATUS

L_OK:
    store out_count+0, accessor_count as i64
    !status_ok
    !status
    !accessor_format
    !empty
    !accessor_count
    !resolve_ok
    !resolve_status
    !sparse_present
    !sparse_bad
    !sparse
    !out_count
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_RETURN_STATUS:
    !status_ok
    !accessor_format
    !empty
    !accessor_count
    !resolve_ok
    !resolve_status
    !sparse_present
    !sparse_bad
    !sparse
    !out_count
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return status

L_EMPTY_INPUT:
    !empty
    !accessor_count
    !resolve_ok
    !resolve_status
    !sparse_present
    !sparse_bad
    !sparse
    !out_count
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_EMPTY_INPUT

L_RESOLVE_ERROR:
    mapped = call @sa3d_gltf_json_resolve_status_to_animation_status(resolve_status)
    !resolve_ok
    !resolve_status
    !has_bv_bool
    !has_bv
    !accessor_parse_ok
    !accessor_parse_status
    !sparse_present
    !sparse_bad
    !sparse
    !out_count
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return mapped

L_ACCESSOR_PARSE_ERROR:
    mapped_accessor = call @sa3d_gltf_json_resolve_status_to_animation_status(SA3D_GLTF_JSON_RESOLVE_STATUS_JSON_ERROR)
    !accessor_parse_ok
    !accessor_parse_status
    !sparse_present
    !sparse_bad
    !sparse
    !out_count
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return mapped_accessor

L_SPARSE_SKIP_NO_BASE:
    !has_bv_bool
    !has_bv
    !accessor_parse_ok
    !accessor_parse_status
    !sparse_present
    !sparse_bad
    !sparse
    !out_count
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_CHANNEL_SKIPPED

L_SPARSE_SKIP:
    !sparse_present
    !sparse_bad
    !sparse
    !out_count
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_CHANNEL_SKIPPED

L_JSON_ERROR_SPARSE:
    !sparse_bad
    !sparse
    !out_count
    !out_len
    !cap
    !dst
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_JSON_ERROR

@sa3d_gltf_json_animation_output_read(bytes: ptr, len: i64, accessor_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, path: i32, interpolation: i32, keyframe_count: i64, dst: ptr, cap: i64, &out_len: ptr, &out_component_count: ptr) -> i32:
L_ENTRY:
    accessor = stack_alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    materialized_components = stack_alloc 8
    store out_len+0, 0 as i64
    store out_component_count+0, 0 as i64
    accessor_status = call @sa3d_gltf_json_accessor_parse(bytes, len, accessor_index, &accessor)
    accessor_ok = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br accessor_ok -> L_SPARSE_CHECK, L_ACCESSOR_UNSUPPORTED_CHECK

L_ACCESSOR_UNSUPPORTED_CHECK:
    accessor_unsupported = eq accessor_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br accessor_unsupported -> L_ACCESSOR_UNSUPPORTED, L_ACCESSOR_JSON_ERROR

L_SPARSE_CHECK:
    sparse = call @sa3d_gltf_json_accessor_has_sparse(bytes, len, accessor_index)
    sparse_bad = slt sparse, 0
    br sparse_bad -> L_JSON_ERROR_SPARSE, L_COUNT

L_COUNT:
    output_count = load accessor+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    width = call @sa3d_gltf_animation_channel_output_width(keyframe_count, output_count, path, interpolation)
    valid_width = sgt width, 0
    br valid_width -> L_FORMAT, L_INVALID_WIDTH

L_FORMAT:
    accessor_format = load accessor+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32
    has_bv = load accessor+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view as i32
    has_bv_bool = ne has_bv, 0
    br has_bv_bool -> L_RESOLVE_BASE, L_ZERO_BASE

L_RESOLVE_BASE:
    bv_i32 = load accessor+SA3D_GLTF_ACCESSOR_TABLE_buffer_view as i32
    bv_index = zext bv_i32 as i64
    accessor_offset = load accessor+SA3D_GLTF_ACCESSOR_TABLE_byte_offset as i64
    resolve_status = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, bv_index, buffer_index, buffer_len, accessor_offset, output_count, accessor_format, &view, &layout)
    resolve_ok = eq resolve_status, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br resolve_ok -> L_MATERIALIZE_BASE, L_RESOLVE_ERROR

L_MATERIALIZE_BASE:
    status = call @sa3d_gltf_animation_output_materialize(buffer, output_count, path, accessor_format, &layout, dst, cap, &out_len, &materialized_components)
    status_ok = eq status, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    br status_ok -> L_BASE_OK, L_RETURN_STATUS

L_BASE_OK:
    !status_ok
    !status
    !resolve_ok
    !resolve_status
    !accessor_offset
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    jmp L_SPARSE_APPLY_CHECK

L_ZERO_BASE:
    zero_status = call @sa3d_gltf_animation_output_zero_materialize(output_count, path, accessor_format, dst, cap, &out_len, &materialized_components)
    zero_ok = eq zero_status, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    br zero_ok -> L_ZERO_OK, L_RETURN_ZERO_STATUS

L_ZERO_OK:
    !zero_ok
    !zero_status
    !has_bv_bool
    !has_bv
    jmp L_SPARSE_APPLY_CHECK

L_SPARSE_APPLY_CHECK:
    sparse_present = sgt sparse, 0
    br sparse_present -> L_APPLY_SPARSE, L_WIDTH_STORE

L_APPLY_SPARSE:
    raw_component_count = load materialized_components+0 as i64
    patch_status = call @sa3d_gltf_json_animation_output_apply_sparse(bytes, len, accessor_index, buffer_index, buffer, buffer_len, path, accessor_format, output_count, dst, raw_component_count)
    patch_ok = eq patch_status, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    br patch_ok -> L_SPARSE_OK, L_RETURN_PATCH_STATUS

L_SPARSE_OK:
    !patch_ok
    !patch_status
    !raw_component_count
    jmp L_WIDTH_STORE

L_WIDTH_STORE:
    weights = eq path, SA3D_GLTF_ANIMATION_PATH_WEIGHTS
    br weights -> L_STORE_WEIGHT_WIDTH, L_STORE_MATERIALIZED_WIDTH

L_STORE_WEIGHT_WIDTH:
    store out_component_count+0, width as i64
    !weights
    !accessor_format
    !sparse_present
    !valid_width
    !width
    !output_count
    !sparse_bad
    !sparse
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_STORE_MATERIALIZED_WIDTH:
    component_count = load materialized_components+0 as i64
    store out_component_count+0, component_count as i64
    !component_count
    !weights
    !accessor_format
    !sparse_present
    !valid_width
    !width
    !output_count
    !sparse_bad
    !sparse
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_RETURN_STATUS:
    !status_ok
    !accessor_format
    !resolve_ok
    !resolve_status
    !accessor_offset
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !valid_width
    !width
    !output_count
    !sparse_bad
    !sparse
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return status

L_RETURN_ZERO_STATUS:
    !zero_ok
    !accessor_format
    !has_bv_bool
    !has_bv
    !valid_width
    !width
    !output_count
    !sparse_bad
    !sparse
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return zero_status

L_RETURN_PATCH_STATUS:
    !patch_ok
    !raw_component_count
    !sparse_present
    !accessor_format
    !valid_width
    !width
    !output_count
    !sparse_bad
    !sparse
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return patch_status

L_INVALID_WIDTH:
    !valid_width
    !width
    !output_count
    !sparse_bad
    !sparse
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_CHANNEL_SKIPPED

L_RESOLVE_ERROR:
    mapped = call @sa3d_gltf_json_resolve_status_to_animation_status(resolve_status)
    !resolve_ok
    !resolve_status
    !accessor_offset
    !bv_index
    !bv_i32
    !has_bv_bool
    !has_bv
    !accessor_format
    !valid_width
    !width
    !output_count
    !sparse_bad
    !sparse
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return mapped

L_JSON_ERROR_SPARSE:
    !sparse_bad
    !sparse
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_JSON_ERROR

L_ACCESSOR_UNSUPPORTED:
    !accessor_unsupported
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_UNSUPPORTED_FORMAT

L_ACCESSOR_JSON_ERROR:
    !accessor_unsupported
    !accessor_ok
    !accessor_status
    !out_component_count
    !out_len
    !cap
    !dst
    !keyframe_count
    !interpolation
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_JSON_ERROR

@sa3d_gltf_animation_output_patch_sparse(buffer: ptr, sparse_count: i64, path: i32, accessor_format: i32, index_component_type: i32, &index_layout: ptr, &value_layout: ptr, dst: ptr, raw_component_count: i64, output_count: i64) -> i32:
L_ENTRY:
    count_nonnegative = sge sparse_count, 0
    output_nonnegative = sge output_count, 0
    raw_positive = sgt raw_component_count, 0
    a0 = and count_nonnegative, output_nonnegative
    a1 = and a0, raw_positive
    buffer_present = ne buffer, 0
    dst_present = ne dst, 0
    ptrs = and buffer_present, dst_present
    ok0 = and a1, ptrs
    br ok0 -> L_LAYOUTS, L_LAYOUT_ERROR

L_LAYOUTS:
    index_status = load index_layout+SA3D_GLTF_ACCESSOR_LAYOUT_status as i32
    value_status = load value_layout+SA3D_GLTF_ACCESSOR_LAYOUT_status as i32
    index_ok = eq index_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    value_ok = eq value_status, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    layouts_ok = and index_ok, value_ok
    br layouts_ok -> L_LOOP_INIT, L_LAYOUT_ERROR_STATUS

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    index_base = load index_layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset as i64
    index_stride = load index_layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride as i64
    value_base = load value_layout+SA3D_GLTF_ACCESSOR_LAYOUT_byte_offset as i64
    value_stride = load value_layout+SA3D_GLTF_ACCESSOR_LAYOUT_stride as i64
    output_element_size = mul raw_component_count, 4
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    i = load idx_slot+0 as i64
    done = sge i, sparse_count
    br done -> L_DONE, L_BODY

L_BODY:
    index_step = mul i, index_stride
    index_pos = add index_base, index_step
    target_index = call @sa3d_gltf_sparse_read_index(buffer, index_pos, index_component_type)
    in_range_low = sge target_index, 0
    in_range_high = slt target_index, output_count
    in_range = and in_range_low, in_range_high
    br in_range -> L_PATCH, L_INDEX_RANGE_ERROR

L_PATCH:
    value_step = mul i, value_stride
    value_pos = add value_base, value_step
    dst_pos = mul target_index, output_element_size
    call @sa3d_gltf_animation_output_copy_element(buffer, value_pos, dst, dst_pos, path, accessor_format)
    next_i = add i, 1
    store idx_slot+0, next_i as i64
    !next_i
    !dst_pos
    !value_pos
    !value_step
    !in_range
    !in_range_high
    !in_range_low
    !target_index
    !index_pos
    !index_step
    !done
    !i
    jmp L_HEAD

L_DONE:
    !done
    !i
    !output_element_size
    !value_stride
    !value_base
    !index_stride
    !index_base
    !layouts_ok
    !value_ok
    !index_ok
    !value_status
    !index_status
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !a1
    !a0
    !raw_positive
    !output_nonnegative
    !count_nonnegative
    !output_count
    !raw_component_count
    !dst
    !value_layout
    !index_layout
    !index_component_type
    !accessor_format
    !path
    !sparse_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_OK

L_INDEX_RANGE_ERROR:
    !in_range
    !in_range_high
    !in_range_low
    !target_index
    !index_pos
    !index_step
    !done
    !i
    !output_element_size
    !value_stride
    !value_base
    !index_stride
    !index_base
    !layouts_ok
    !value_ok
    !index_ok
    !value_status
    !index_status
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !a1
    !a0
    !raw_positive
    !output_nonnegative
    !count_nonnegative
    !output_count
    !raw_component_count
    !dst
    !value_layout
    !index_layout
    !index_component_type
    !accessor_format
    !path
    !sparse_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_LAYOUT_ERROR

L_LAYOUT_ERROR_STATUS:
    !layouts_ok
    !value_ok
    !index_ok
    !value_status
    !index_status
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !a1
    !a0
    !raw_positive
    !output_nonnegative
    !count_nonnegative
    !output_count
    !raw_component_count
    !dst
    !value_layout
    !index_layout
    !index_component_type
    !accessor_format
    !path
    !sparse_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_LAYOUT_ERROR

L_LAYOUT_ERROR:
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !a1
    !a0
    !raw_positive
    !output_nonnegative
    !count_nonnegative
    !output_count
    !raw_component_count
    !dst
    !value_layout
    !index_layout
    !index_component_type
    !accessor_format
    !path
    !sparse_count
    !buffer
    return SA3D_GLTF_ANIMATION_READ_STATUS_LAYOUT_ERROR

@sa3d_gltf_json_animation_output_apply_sparse(bytes: ptr, len: i64, accessor_index: i64, buffer_index: i64, buffer: ptr, buffer_len: i64, path: i32, accessor_format: i32, output_count: i64, dst: ptr, raw_component_count: i64) -> i32:
L_ENTRY:
    sparse = stack_alloc SA3D_GLTF_ACCESSOR_SPARSE_TABLE_SIZE
    index_view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    value_view = stack_alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    index_layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    value_layout = stack_alloc SA3D_GLTF_ACCESSOR_LAYOUT_SIZE
    sparse_status = call @sa3d_gltf_json_accessor_sparse_parse(bytes, len, accessor_index, &sparse)
    sparse_ok = eq sparse_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br sparse_ok -> L_COUNT, L_PARSE_ERROR_CHECK

L_PARSE_ERROR_CHECK:
    sparse_unsupported = eq sparse_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT
    br sparse_unsupported -> L_UNSUPPORTED_PARSE, L_JSON_PARSE_ERROR

L_COUNT:
    sparse_count = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_count as i64
    empty = eq sparse_count, 0
    br empty -> L_OK_EMPTY, L_INDEX_RESOLVE

L_INDEX_RESOLVE:
    index_bv = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_buffer_view as i64
    index_offset = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_byte_offset as i64
    index_component = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_indices_component_type as i32
    index_format = call @sa3d_gltf_sparse_index_accessor_format(index_component)
    index_format_ok = ne index_format, 0
    br index_format_ok -> L_INDEX_LAYOUT, L_UNSUPPORTED_INDEX_FORMAT

L_INDEX_LAYOUT:
    index_resolve = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, index_bv, buffer_index, buffer_len, index_offset, sparse_count, index_format, &index_view, &index_layout)
    index_resolve_ok = eq index_resolve, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br index_resolve_ok -> L_VALUE_LAYOUT, L_INDEX_RESOLVE_ERROR

L_VALUE_LAYOUT:
    value_bv = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_values_buffer_view as i64
    value_offset = load sparse+SA3D_GLTF_ACCESSOR_SPARSE_TABLE_values_byte_offset as i64
    value_resolve = call @sa3d_gltf_json_resolve_buffer_view_layout(bytes, len, value_bv, buffer_index, buffer_len, value_offset, sparse_count, accessor_format, &value_view, &value_layout)
    value_resolve_ok = eq value_resolve, SA3D_GLTF_JSON_RESOLVE_STATUS_OK
    br value_resolve_ok -> L_PATCH, L_VALUE_RESOLVE_ERROR

L_PATCH:
    patch_status = call @sa3d_gltf_animation_output_patch_sparse(buffer, sparse_count, path, accessor_format, index_component, &index_layout, &value_layout, dst, raw_component_count, output_count)
    !value_resolve_ok
    !value_resolve
    !value_offset
    !value_bv
    !index_resolve_ok
    !index_resolve
    !index_format_ok
    !index_format
    !index_component
    !index_offset
    !index_bv
    !empty
    !sparse_count
    !sparse_ok
    !sparse_status
    !raw_component_count
    !dst
    !output_count
    !accessor_format
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return patch_status

L_VALUE_RESOLVE_ERROR:
    value_mapped = call @sa3d_gltf_json_resolve_status_to_animation_status(value_resolve)
    !value_resolve_ok
    !value_resolve
    !value_offset
    !value_bv
    !index_resolve_ok
    !index_resolve
    !index_format_ok
    !index_format
    !index_component
    !index_offset
    !index_bv
    !empty
    !sparse_count
    !sparse_ok
    !sparse_status
    !raw_component_count
    !dst
    !output_count
    !accessor_format
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return value_mapped

L_INDEX_RESOLVE_ERROR:
    index_mapped = call @sa3d_gltf_json_resolve_status_to_animation_status(index_resolve)
    !index_resolve_ok
    !index_resolve
    !index_format_ok
    !index_format
    !index_component
    !index_offset
    !index_bv
    !empty
    !sparse_count
    !sparse_ok
    !sparse_status
    !raw_component_count
    !dst
    !output_count
    !accessor_format
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return index_mapped

L_UNSUPPORTED_INDEX_FORMAT:
    !index_format_ok
    !index_format
    !index_component
    !index_offset
    !index_bv
    !empty
    !sparse_count
    !sparse_ok
    !sparse_status
    !raw_component_count
    !dst
    !output_count
    !accessor_format
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
    !bytes
    return SA3D_GLTF_ANIMATION_READ_STATUS_UNSUPPORTED_FORMAT

L_OK_EMPTY:
    !empty
    !sparse_count
    !sparse_ok
    !sparse_status
    !raw_component_count
    !dst
    !output_count
    !accessor_format
    !path
    !buffer_len
    !buffer
    !buffer_index
    !accessor_index
    !len
