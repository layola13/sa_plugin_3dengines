    !default_value
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_object_i64_value(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out_value: ptr) -> i32:
L_ENTRY:
    store out_value+0, 0 as i64
    value_pos = call @sa3d_gltf_json_object_field_value(bytes, len, object_pos, key, key_len)
