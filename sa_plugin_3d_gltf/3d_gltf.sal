@sa3d_gltf_json_material_table_set_texture(&out: ptr, has_offset: i64, index_offset: i64, uv_offset: i64, texture_index: i64, tex_coord: i64, usage_bit: i32, linear_bit: i32) -> void:
L_ENTRY:
    has_ptr = ptr_add out, has_offset
    index_ptr = ptr_add out, index_offset
    uv_ptr = ptr_add out, uv_offset
    tex_i32 = trunc tex_coord as i32
    uv_channel = call @sa3d_gltf_uv_channel(tex_i32)
    old_mask = load out+SA3D_GLTF_MATERIAL_TABLE_texture_mask as i32
    next_mask = or old_mask, usage_bit
    old_linear = load out+SA3D_GLTF_MATERIAL_TABLE_linear_texture_mask as i32
    next_linear_raw = or old_linear, usage_bit
    is_linear = ne linear_bit, 0
    store has_ptr+0, 1 as i32
    store index_ptr+0, texture_index as i64
    store uv_ptr+0, uv_channel as i32
    store out+SA3D_GLTF_MATERIAL_TABLE_texture_mask, next_mask as i32
    br is_linear -> L_STORE_LINEAR, L_DONE

L_STORE_LINEAR:
    store out+SA3D_GLTF_MATERIAL_TABLE_linear_texture_mask, next_linear_raw as i32
    !is_linear
    !next_linear_raw
    !old_linear
    !next_mask
    !old_mask
    !uv_channel
    !tex_i32
    !uv_ptr
    !index_ptr
    !has_ptr
    !linear_bit
    !usage_bit
    !tex_coord
    !texture_index
    !uv_offset
    !index_offset
    !has_offset
    !out
    return

L_DONE:
    !is_linear
    !next_linear_raw
    !old_linear
    !next_mask
    !old_mask
    !uv_channel
    !tex_i32
    !uv_ptr
    !index_ptr
    !has_ptr
    !linear_bit
    !usage_bit
    !tex_coord
    !texture_index
    !uv_offset
    !index_offset
    !has_offset
    !out
    return

@sa3d_gltf_json_material_table_parse_texture_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out: ptr, has_offset: i64, index_offset: i64, uv_offset: i64, usage_bit: i32, linear_bit: i32) -> i32:
L_ENTRY:
    index_slot = stack_alloc 8
    tex_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_texture_info_field_parse(bytes, len, object_pos, key, key_len, &index_slot, &tex_slot)
    ok = eq status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br ok -> L_SET, L_MISSING_CHECK

L_MISSING_CHECK:
    missing = eq status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED
    br missing -> L_MISSING, L_BAD

L_SET:
    texture_index = load index_slot+0 as i64
    tex_coord = load tex_slot+0 as i64
    call @sa3d_gltf_json_material_table_set_texture(&out, has_offset, index_offset, uv_offset, texture_index, tex_coord, usage_bit, linear_bit)
    !tex_coord
    !texture_index
    !ok
    !status
    !linear_bit
    !usage_bit
    !uv_offset
    !index_offset
    !has_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING:
    !missing
    !ok
    !status
    !linear_bit
    !usage_bit
    !uv_offset
    !index_offset
    !has_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !missing
    !ok
    !status
    !linear_bit
    !usage_bit
    !uv_offset
    !index_offset
    !has_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_texture_info_parse(bytes: ptr, len: i64, material_index: i64, key: ptr, key_len: i64, &out_index: ptr, &out_tex_coord: ptr) -> i32:
L_ENTRY:
    material_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_MATERIALS, 9, material_index)
    missing = eq material_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq material_pos, -2
    br malformed -> L_MALFORMED, L_PARSE

L_PARSE:
    status = call @sa3d_gltf_json_object_texture_info_field_parse(bytes, len, material_pos, key, key_len, &out_index, &out_tex_coord)
    !malformed
    !missing
    !material_pos
    !out_tex_coord
    !out_index
    !key_len
    !key
    !material_index
    !len
    !bytes
    return status

L_MISSING:
    store out_index+0, 0 as i64
    store out_tex_coord+0, 0 as i64
    !missing
    !material_pos
    !out_tex_coord
    !out_index
    !key_len
    !key
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out_index+0, 0 as i64
    store out_tex_coord+0, 0 as i64
    !malformed
    !missing
    !material_pos
    !out_tex_coord
    !out_index
    !key_len
    !key
    !material_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_material_table_parse_f32_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out: ptr, value_offset: i64, has_offset: i64) -> i32:
L_ENTRY:
    value_slot = stack_alloc 4
    status = call @sa3d_gltf_json_object_f32_bits_value(bytes, len, object_pos, key, key_len, &value_slot)
    missing = eq status, 0
    br missing -> L_OK_MISSING, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_STORE

L_STORE:
    value = load value_slot+0 as i32
    value_ptr = ptr_add out, value_offset
    has_ptr = ptr_add out, has_offset
    store value_ptr+0, value as i32
    store has_ptr+0, 1 as i32
    !has_ptr
    !value_ptr
    !value
    !bad
    !missing
    !status
    !has_offset
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !status
    !has_offset
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !missing
