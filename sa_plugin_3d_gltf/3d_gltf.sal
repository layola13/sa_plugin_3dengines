@sa3d_gltf_json_parse_signed_f32_array16_mat4(bytes: ptr, len: i64, value_pos: i64, &mat: ptr) -> i32:
L_ENTRY:
    count = call @sa3d_gltf_json_count_array_items(bytes, len, value_pos)
    count_ok = eq count, 16
    br count_ok -> L_LOOP_INIT, L_BAD_COUNT

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    bits_slot = stack_alloc 4
    store idx_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    idx = load idx_slot+0 as i64
    done = eq idx, 16
    br done -> L_OK, L_ITEM_POS

L_ITEM_POS:
    item_pos = call @sa3d_gltf_json_array_item_start(bytes, len, value_pos, idx)
    item_bad = slt item_pos, 0
    br item_bad -> L_BAD_ITEM, L_PARSE

L_PARSE:
    parsed = call @sa3d_gltf_json_parse_f32_bits(bytes, len, item_pos, &bits_slot)
    parsed_ok = ne parsed, 0
    br parsed_ok -> L_STORE, L_BAD_PARSE

L_STORE:
    bits = load bits_slot+0 as i32
    offset = mul idx, 4
    dst = ptr_add mat, offset
    store dst+0, bits as i32
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !dst
    !offset
    !bits
    !parsed_ok
    !parsed
    !item_bad
    !item_pos
    !done
    !idx
    jmp L_LOOP_HEAD

L_OK:
    !done
    !idx
    !count_ok
    !count
    !mat
    !value_pos
    !len
    !bytes
    return 1

L_BAD_PARSE:
    !parsed_ok
    !parsed
    !item_bad
    !item_pos
    !done
    !idx
    !count_ok
    !count
    !mat
    !value_pos
    !len
    !bytes
    return 0

L_BAD_ITEM:
    !item_bad
    !item_pos
    !done
    !idx
    !count_ok
    !count
    !mat
    !value_pos
    !len
    !bytes
    return 0

L_BAD_COUNT:
    !count_ok
    !count
    !mat
    !value_pos
    !len
    !bytes
    return 0

@sa3d_gltf_json_node_table_clear(&out: ptr) -> void:
L_ENTRY:
    transform = ptr_add out, SA3D_GLTF_NODE_TABLE_transform
    store out+SA3D_GLTF_NODE_TABLE_index, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_name_ptr, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_name_len, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_child_count, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_children_array_pos, -1 as i64
    store out+SA3D_GLTF_NODE_TABLE_first_child, -1 as i64
    store out+SA3D_GLTF_NODE_TABLE_has_mesh, 0 as i32
    store out+SA3D_GLTF_NODE_TABLE_mesh, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_has_skin, 0 as i32
    store out+SA3D_GLTF_NODE_TABLE_skin, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_has_extras, 0 as i32
    store out+SA3D_GLTF_NODE_TABLE_extras_ptr, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_extras_len, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    store out+SA3D_GLTF_NODE_TABLE_has_camera, 0 as i32
    store out+SA3D_GLTF_NODE_TABLE_camera, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_has_light, 0 as i32
    store out+SA3D_GLTF_NODE_TABLE_light, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_has_weights, 0 as i32
    store out+SA3D_GLTF_NODE_TABLE_weight_count, 0 as i64
    store out+SA3D_GLTF_NODE_TABLE_weights_array_pos, -1 as i64
    call @sa3d_transform3d_identity(&transform)
    !transform
    !out
    return

@sa3d_gltf_json_node_store_name(bytes: ptr, len: i64, node_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    ptr_slot = stack_alloc 8
    len_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_string_span(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_NAME, 4, &ptr_slot, &len_slot)
    bad = slt status, 0
    br bad -> L_BAD, L_FOUND_CHECK

L_FOUND_CHECK:
    found = eq status, 1
    br found -> L_STORE, L_OK_MISSING

L_STORE:
    name_ptr = load ptr_slot+0 as ptr
    name_len = load len_slot+0 as i64
    store out+SA3D_GLTF_NODE_TABLE_name_ptr, name_ptr as ptr
    store out+SA3D_GLTF_NODE_TABLE_name_len, name_len as i64
    !name_len
    !name_ptr
    !found
    !bad
    !status
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !found
    !bad
    !status
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !status
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_node_store_children(bytes: ptr, len: i64, node_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    children_pos = call @sa3d_gltf_json_object_field_value(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_CHILDREN, 8)
    missing = eq children_pos, -1
    br missing -> L_OK_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq children_pos, -2
    br malformed -> L_BAD, L_COUNT

L_COUNT:
    count = call @sa3d_gltf_json_count_array_items(bytes, len, children_pos)
    count_bad = slt count, 0
    br count_bad -> L_BAD_COUNT, L_STORE_COUNT

L_STORE_COUNT:
    store out+SA3D_GLTF_NODE_TABLE_child_count, count as i64
    store out+SA3D_GLTF_NODE_TABLE_children_array_pos, children_pos as i64
    has_child = sgt count, 0
    br has_child -> L_FIRST_POS, L_OK_NO_CHILD

L_FIRST_POS:
    first_pos = call @sa3d_gltf_json_array_item_start(bytes, len, children_pos, 0)
    first_bad = slt first_pos, 0
    br first_bad -> L_BAD_FIRST_POS, L_FIRST_VALUE

L_FIRST_VALUE:
    first_child = call @sa3d_gltf_json_parse_positive_i64(bytes, len, first_pos)
    first_value_bad = slt first_child, 0
    br first_value_bad -> L_BAD_FIRST_VALUE, L_STORE_FIRST

L_STORE_FIRST:
    store out+SA3D_GLTF_NODE_TABLE_first_child, first_child as i64
    !first_value_bad
    !first_child
    !first_bad
    !first_pos
    !has_child
    !count_bad
    !count
    !malformed
    !missing
    !children_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_NO_CHILD:
    !has_child
    !count_bad
    !count
    !malformed
    !missing
    !children_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !missing
    !children_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_FIRST_VALUE:
    !first_value_bad
    !first_child
    !first_bad
    !first_pos
    !has_child
    !count_bad
    !count
    !malformed
    !missing
    !children_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_FIRST_POS:
    !first_bad
    !first_pos
    !has_child
    !count_bad
    !count
    !malformed
    !missing
    !children_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_COUNT:
    !count_bad
    !count
    !malformed
    !missing
    !children_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD:
    !malformed
    !missing
    !children_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_node_child_at(bytes: ptr, len: i64, &node: ptr, child_index: i64) -> i64:
L_ENTRY:
    negative = slt child_index, 0
    br negative -> L_MISSING_NEGATIVE, L_RANGE

L_RANGE:
    count = load node+SA3D_GLTF_NODE_TABLE_child_count as i64
    in_range = slt child_index, count
    br in_range -> L_POS, L_MISSING_RANGE

L_POS:
    children_pos = load node+SA3D_GLTF_NODE_TABLE_children_array_pos as i64
    value_pos = call @sa3d_gltf_json_array_item_start(bytes, len, children_pos, child_index)
    value_bad = slt value_pos, 0
    br value_bad -> L_BAD_VALUE_POS, L_PARSE

L_PARSE:
    child = call @sa3d_gltf_json_parse_positive_i64(bytes, len, value_pos)
    child_bad = slt child, 0
    br child_bad -> L_BAD_CHILD, L_OK

L_OK:
    !child_bad
    !value_bad
    !value_pos
    !children_pos
    !in_range
    !count
    !negative
    !child_index
    !node
    !len
    !bytes
    return child

L_BAD_CHILD:
    !child_bad
    !child
    !value_bad
    !value_pos
    !children_pos
    !in_range
    !count
    !negative
    !child_index
    !node
    !len
    !bytes
    return -2

L_BAD_VALUE_POS:
    !value_bad
    !value_pos
    !children_pos
    !in_range
    !count
    !negative
    !child_index
    !node
    !len
    !bytes
    return -2

L_MISSING_RANGE:
    !in_range
    !count
    !negative
    !child_index
    !node
    !len
    !bytes
    return -1

L_MISSING_NEGATIVE:
    !negative
    !child_index
    !node
    !len
    !bytes
    return -1

@sa3d_gltf_json_node_store_mesh(bytes: ptr, len: i64, node_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    mesh_slot = stack_alloc 8
