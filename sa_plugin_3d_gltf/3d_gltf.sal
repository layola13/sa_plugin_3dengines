L_WEIGHT_FALSE:
    !weight_ok
    !normalized_ok
    !w0
    !u16x4
    !u8x4
    !f32_ok
    !f32x4
    !not_norm
    !norm
    !is_joint_weight
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
    !normalized
    return 0

L_UNKNOWN:
    !is_joint_weight
    !is_joint_index
    !is_tex
    !is_rgba
    !is_any
    !conversion
    !accessor_format
