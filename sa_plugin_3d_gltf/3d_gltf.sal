    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_f32_zero_fill(dst: ptr, byte_len: i64) -> void:
L_ENTRY:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, byte_len
    br done -> L_DONE, L_BODY

L_BODY:
    p = ptr_add dst, idx
    store p+0, 0.0 as f32
    next = add idx, 4
    store idx_slot+0, next as i64
    !next
    !p
    !done
    !idx
    jmp L_HEAD

L_DONE:
    !done
    !idx
    !byte_len
    !dst
    return

@sa3d_gltf_json_bevy_morph_weights_materialize(bytes: ptr, len: i64, mesh_index: i64, max_morph_target_count: i64, dst: ptr, cap: i64, &out_len: ptr, &out_count: ptr) -> i32:
L_ENTRY:
    mesh = stack_alloc SA3D_GLTF_MESH_TABLE_SIZE
    tmp_len = stack_alloc 8
    store out_len+0, 0 as i64
    store out_count+0, 0 as i64
    mesh_status = call @sa3d_gltf_json_mesh_parse(bytes, len, mesh_index, &mesh)
    mesh_ok = eq mesh_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br mesh_ok -> L_NEED_CHECK, L_RETURN_MESH_STATUS

L_NEED_CHECK:
    has_weights = load mesh+SA3D_GLTF_MESH_TABLE_has_weights as i32
    weight_count = load mesh+SA3D_GLTF_MESH_TABLE_weight_count as i64
    max_positive = sgt max_morph_target_count, 0
    has_weights_bool = ne has_weights, 0
    need = or max_positive, has_weights_bool
    br need -> L_COUNT, L_OK_EMPTY

L_COUNT:
    count_lt_max = slt weight_count, max_morph_target_count
    br count_lt_max -> L_USE_MAX, L_USE_WEIGHT_COUNT

L_USE_MAX:
    output_count_max = add max_morph_target_count, 0
    jmp L_COUNT_LIMIT_MAX

L_COUNT_LIMIT_MAX:
    count_too_large_max = sgt output_count_max, SA3D_GLTF_MAX_MORPH_WEIGHTS
    br count_too_large_max -> L_UNSUPPORTED_MAX, L_CAP_CHECK_MAX

L_CAP_CHECK_MAX:
    required_max = mul output_count_max, 4
    cap_ok_max = sge cap, required_max
    dst_present_max = ne dst, 0
    cap_and_ptr_max = and cap_ok_max, dst_present_max
    br cap_and_ptr_max -> L_ZERO_MAX, L_OUTPUT_SMALL_MAX

L_ZERO_MAX:
    call @sa3d_gltf_f32_zero_fill(dst, required_max)
    br has_weights_bool -> L_COPY_WEIGHTS_MAX, L_DONE_MAX

L_COPY_WEIGHTS_MAX:
    weights_pos_max = load mesh+SA3D_GLTF_MESH_TABLE_weights_array_pos as i64
    copy_status_max = call @sa3d_gltf_json_f32_array_materialize(bytes, len, weights_pos_max, dst, cap, &tmp_len)
    copy_ok_max = eq copy_status_max, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br copy_ok_max -> L_DONE_COPY_MAX, L_RETURN_COPY_MAX

L_DONE_COPY_MAX:
    store out_len+0, required_max as i64
    store out_count+0, output_count_max as i64
    !copy_ok_max
    !copy_status_max
    !weights_pos_max
    !cap_and_ptr_max
    !dst_present_max
    !cap_ok_max
    !required_max
    !count_too_large_max
    !output_count_max
    !count_lt_max
    !need
    !has_weights_bool
    !max_positive
    !weight_count
    !has_weights
    !mesh_ok
    !mesh_status
    !out_count
    !out_len
    !cap
    !dst
    !max_morph_target_count
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_COPY_MAX:
    !copy_ok_max
    !weights_pos_max
    !cap_and_ptr_max
    !dst_present_max
    !cap_ok_max
    !required_max
    !count_too_large_max
    !output_count_max
    !count_lt_max
    !need
    !has_weights_bool
    !max_positive
    !weight_count
    !has_weights
    !mesh_ok
    !mesh_status
    !out_count
    !out_len
    !cap
    !dst
    !max_morph_target_count
    !mesh_index
    !len
    !bytes
    return copy_status_max

L_DONE_MAX:
    store out_len+0, required_max as i64
    store out_count+0, output_count_max as i64
    !cap_and_ptr_max
    !dst_present_max
    !cap_ok_max
    !required_max
    !count_too_large_max
    !output_count_max
    !count_lt_max
    !need
    !has_weights_bool
    !max_positive
    !weight_count
    !has_weights
    !mesh_ok
    !mesh_status
    !out_count
    !out_len
    !cap
    !dst
    !max_morph_target_count
    !mesh_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_USE_WEIGHT_COUNT:
    output_count_weight = add weight_count, 0
    jmp L_COUNT_LIMIT_WEIGHT

L_COUNT_LIMIT_WEIGHT:
    count_too_large_weight = sgt output_count_weight, SA3D_GLTF_MAX_MORPH_WEIGHTS
    br count_too_large_weight -> L_UNSUPPORTED_WEIGHT, L_CAP_CHECK_WEIGHT

L_CAP_CHECK_WEIGHT:
    required_weight = mul output_count_weight, 4
    cap_ok_weight = sge cap, required_weight
    dst_present_weight = ne dst, 0
    cap_and_ptr_weight = and cap_ok_weight, dst_present_weight
    br cap_and_ptr_weight -> L_ZERO_WEIGHT, L_OUTPUT_SMALL_WEIGHT

L_ZERO_WEIGHT:
    call @sa3d_gltf_f32_zero_fill(dst, required_weight)
    br has_weights_bool -> L_COPY_WEIGHTS_WEIGHT, L_DONE_WEIGHT

L_COPY_WEIGHTS_WEIGHT:
    weights_pos_weight = load mesh+SA3D_GLTF_MESH_TABLE_weights_array_pos as i64
    copy_status_weight = call @sa3d_gltf_json_f32_array_materialize(bytes, len, weights_pos_weight, dst, cap, &tmp_len)
    copy_ok_weight = eq copy_status_weight, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br copy_ok_weight -> L_DONE_COPY_WEIGHT, L_RETURN_COPY_WEIGHT

L_DONE_COPY_WEIGHT:
    store out_len+0, required_weight as i64
    store out_count+0, output_count_weight as i64
    !copy_ok_weight
    !copy_status_weight
    !weights_pos_weight
    !cap_and_ptr_weight
    !dst_present_weight
    !cap_ok_weight
    !required_weight
    !count_too_large_weight
    !output_count_weight
    !count_lt_max
    !need
    !has_weights_bool
