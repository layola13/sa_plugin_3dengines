@sa3d_gltf_json_alpha_mode_from_span(text: ptr, len: i64) -> i32:
L_ENTRY:
    mask_len = eq len, 4
    br mask_len -> L_MASK_CHECK, L_BLEND_LEN

L_MASK_CHECK:
    mask_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_MASK, 4)
    br mask_eq -> L_MASK, L_BLEND_LEN_AFTER_MASK

L_MASK:
    !mask_eq
    !mask_len
    !len
    !text
    return SA3D_GLTF_ALPHA_MODE_MASK

L_BLEND_LEN_AFTER_MASK:
    !mask_eq
    jmp L_BLEND_LEN_COMMON

L_BLEND_LEN:
    jmp L_BLEND_LEN_COMMON

L_BLEND_LEN_COMMON:
    blend_len = eq len, 5
    br blend_len -> L_BLEND_CHECK, L_OPAQUE_LEN

L_BLEND_CHECK:
    blend_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_BLEND, 5)
    br blend_eq -> L_BLEND, L_OPAQUE_LEN_AFTER_BLEND

L_BLEND:
    !blend_eq
    !blend_len
    !mask_len
    !len
    !text
    return SA3D_GLTF_ALPHA_MODE_BLEND

L_OPAQUE_LEN_AFTER_BLEND:
    !blend_eq
    jmp L_OPAQUE_LEN_COMMON

L_OPAQUE_LEN:
    jmp L_OPAQUE_LEN_COMMON

L_OPAQUE_LEN_COMMON:
    opaque_len = eq len, 6
    br opaque_len -> L_OPAQUE_CHECK, L_UNSUPPORTED

L_OPAQUE_CHECK:
    opaque_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_OPAQUE, 6)
    br opaque_eq -> L_OPAQUE, L_UNSUPPORTED_AFTER_OPAQUE

L_OPAQUE:
    !opaque_eq
    !opaque_len
    !blend_len
    !mask_len
    !len
    !text
    return SA3D_GLTF_ALPHA_MODE_OPAQUE

L_UNSUPPORTED_AFTER_OPAQUE:
    !opaque_eq
    !opaque_len
    !blend_len
    !mask_len
    !len
    !text
    return -1

L_UNSUPPORTED:
    !opaque_len
    !blend_len
    !mask_len
    !len
    !text
    return -1

@sa3d_gltf_json_object_alpha_mode_or_default(bytes: ptr, len: i64, object_pos: i64) -> i32:
L_ENTRY:
    text_ptr_slot = stack_alloc 8
    text_len_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_string_span(bytes, len, object_pos, &SA3D_GLTF_JSON_KEY_ALPHA_MODE, 9, &text_ptr_slot, &text_len_slot)
    missing = eq status, 0
    br missing -> L_DEFAULT, L_BAD_CHECK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_PARSE

L_PARSE:
    text_ptr = load text_ptr_slot+0 as ptr
    text_len = load text_len_slot+0 as i64
    mode = call @sa3d_gltf_json_alpha_mode_from_span(text_ptr, text_len)
    !text_len
    !text_ptr
    !bad
    !missing
    !status
    !object_pos
    !len
    !bytes
    return mode

L_DEFAULT:
    !missing
    !status
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_ALPHA_MODE_OPAQUE

L_BAD:
    !bad
    !missing
    !status
    !object_pos
    !len
    !bytes
