    idx_slot = stack_alloc 8
    array_depth_slot = stack_alloc 8
    object_depth_slot = stack_alloc 8
    count_slot = stack_alloc 8
    store idx_slot+0, first_pos as i64
    store array_depth_slot+0, 1 as i64
    store object_depth_slot+0, 0 as i64
    store count_slot+0, 1 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_BAD_SCAN_EOF, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    is_quote = eq b, 34
    br is_quote -> L_STRING, L_STRUCTURAL

L_STRING:
    skipped = call @sa3d_gltf_json_skip_string(bytes, len, idx)
    bad_string = slt skipped, 0
    br bad_string -> L_BAD_STRING, L_STORE_STRING

L_STORE_STRING:
    store idx_slot+0, skipped as i64
    !bad_string
    !skipped
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_STRUCTURAL:
    arr_depth = load array_depth_slot+0 as i64
    obj_depth = load object_depth_slot+0 as i64
    is_arr_open = eq b, 91
    br is_arr_open -> L_ARR_OPEN, L_ARR_CLOSE_CHECK

L_ARR_OPEN:
    arr_next = add arr_depth, 1
    idx_next_ao = add idx, 1
    store array_depth_slot+0, arr_next as i64
    store idx_slot+0, idx_next_ao as i64
    !idx_next_ao
    !arr_next
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_ARR_CLOSE_CHECK:
    is_arr_close = eq b, 93
    br is_arr_close -> L_ARR_CLOSE, L_OBJ_OPEN_CHECK

L_ARR_CLOSE:
    arr_prev = sub arr_depth, 1
    finished = eq arr_prev, 0
    br finished -> L_DONE_COUNT, L_ARR_CLOSE_STORE

L_ARR_CLOSE_STORE:
    idx_next_ac = add idx, 1
    store array_depth_slot+0, arr_prev as i64
    store idx_slot+0, idx_next_ac as i64
    !idx_next_ac
    !finished
    !arr_prev
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OBJ_OPEN_CHECK:
    is_obj_open = eq b, 123
    br is_obj_open -> L_OBJ_OPEN, L_OBJ_CLOSE_CHECK

L_OBJ_OPEN:
    obj_next = add obj_depth, 1
    idx_next_oo = add idx, 1
    store object_depth_slot+0, obj_next as i64
    store idx_slot+0, idx_next_oo as i64
    !idx_next_oo
    !obj_next
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OBJ_CLOSE_CHECK:
    is_obj_close = eq b, 125
    br is_obj_close -> L_OBJ_CLOSE, L_COMMA_CHECK

L_OBJ_CLOSE:
    obj_prev = sub obj_depth, 1
    idx_next_oc = add idx, 1
    store object_depth_slot+0, obj_prev as i64
    store idx_slot+0, idx_next_oc as i64
    !idx_next_oc
    !obj_prev
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_COMMA_CHECK:
    is_comma = eq b, 44
    arr_top = eq arr_depth, 1
    obj_top = eq obj_depth, 0
    top_a = and arr_top, obj_top
    top_comma = and top_a, is_comma
    br top_comma -> L_COUNT_COMMA, L_OTHER

L_COUNT_COMMA:
    old_count = load count_slot+0 as i64
    new_count = add old_count, 1
    idx_next_c = add idx, 1
    store count_slot+0, new_count as i64
    store idx_slot+0, idx_next_c as i64
    !idx_next_c
    !new_count
    !old_count
    !top_comma
    !top_a
    !obj_top
    !arr_top
    !is_comma
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OTHER:
    idx_next = add idx, 1
    store idx_slot+0, idx_next as i64
    !idx_next
    !top_comma
    !top_a
    !obj_top
    !arr_top
    !is_comma
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_DONE_COUNT:
    count = load count_slot+0 as i64
    !finished
    !arr_prev
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first_pos
    !first_pos0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !array_pos
    !len
    !bytes
    return count

L_EMPTY:
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first_pos
    !first_pos0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !array_pos
    !len
    !bytes
    return 0

L_BAD_STRING:
    !bad_string
    !skipped
    !is_quote
    !b
    !p
    !done
    !idx
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first_pos
    !first_pos0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !array_pos
    !len
    !bytes
    return -1

L_BAD_SCAN_EOF:
    !done
    !idx
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first_pos
    !first_pos0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !array_pos
    !len
    !bytes
    return -1

L_BAD_EOF:
    !first_in_bounds
    !first_pos
    !first_pos0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !array_pos
    !len
    !bytes
    return -1

L_BAD_ARRAY:
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !array_pos
    !len
    !bytes
    return -1

L_BAD_BOUNDS:
    !in_bounds
    !array_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_root_array_item_count(bytes: ptr, len: i64, key: ptr, key_len: i64) -> i64:
L_ENTRY:
    value_pos = call @sa3d_gltf_json_find_root_key_value(bytes, len, key, key_len)
    malformed_find = eq value_pos, -2
    br malformed_find -> L_MALFORMED, L_MISSING_CHECK

L_MISSING_CHECK:
    missing = eq value_pos, -1
    br missing -> L_ZERO, L_COUNT

L_COUNT:
    count = call @sa3d_gltf_json_count_array_items(bytes, len, value_pos)
    !missing
    !malformed_find
    !value_pos
    !key_len
    !key
    !len
    !bytes
    return count

L_ZERO:
    !missing
    !malformed_find
    !value_pos
    !key_len
    !key
    !len
    !bytes
    return 0

L_MALFORMED:
    !malformed_find
    !value_pos
    !key_len
    !key
    !len
    !bytes
    return -1

@sa3d_gltf_document_summary_init(&summary: ptr) -> void:
L_ENTRY:
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_scene_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_node_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_mesh_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_material_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_image_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_texture_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_animation_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_skin_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_buffer_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_buffer_view_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_accessor_count, 0 as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_status, SA3D_GLTF_DOCUMENT_STATUS_OK as i32
    !summary
    return

@sa3d_gltf_document_summary_from_json(bytes: ptr, len: i64, &summary: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_document_summary_init(&summary)
    scenes = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_SCENES, 6)
    nodes = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_NODES, 5)
    meshes = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_MESHES, 6)
    materials = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_MATERIALS, 9)
    images = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_IMAGES, 6)
    textures = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_TEXTURES, 8)
    animations = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_ANIMATIONS, 10)
    skins = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_SKINS, 5)
    buffers = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_BUFFERS, 7)
    buffer_views = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_BUFFER_VIEWS, 11)
    accessors = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_ACCESSORS, 9)
    scenes_bad = slt scenes, 0
    nodes_bad = slt nodes, 0
    meshes_bad = slt meshes, 0
    materials_bad = slt materials, 0
    images_bad = slt images, 0
    textures_bad = slt textures, 0
    animations_bad = slt animations, 0
    skins_bad = slt skins, 0
    buffers_bad = slt buffers, 0
    buffer_views_bad = slt buffer_views, 0
    accessors_bad = slt accessors, 0
    b0 = or scenes_bad, nodes_bad
    b1 = or meshes_bad, materials_bad
    b2 = or images_bad, textures_bad
    b3 = or animations_bad, skins_bad
    b4 = or buffers_bad, buffer_views_bad
    b5 = or b0, b1
    b6 = or b2, b3
    b7 = or b4, accessors_bad
    b8 = or b5, b6
    any_bad = or b8, b7
    br any_bad -> L_BAD, L_OK

L_OK:
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_scene_count, scenes as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_node_count, nodes as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_mesh_count, meshes as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_material_count, materials as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_image_count, images as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_texture_count, textures as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_animation_count, animations as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_skin_count, skins as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_buffer_count, buffers as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_buffer_view_count, buffer_views as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_accessor_count, accessors as i64
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_status, SA3D_GLTF_DOCUMENT_STATUS_OK as i32
    !any_bad
    !b8
    !b7
    !b6
    !b5
    !b4
    !b3
    !b2
    !b1
    !b0
    !accessors_bad
    !buffer_views_bad
    !buffers_bad
    !skins_bad
    !animations_bad
    !textures_bad
    !images_bad
    !materials_bad
    !meshes_bad
    !nodes_bad
    !scenes_bad
    !accessors
    !buffer_views
    !buffers
    !skins
    !animations
    !textures
    !images
    !materials
    !meshes
    !nodes
    !scenes
    !summary
    !len
    !bytes
    return SA3D_GLTF_DOCUMENT_STATUS_OK

L_BAD:
    store summary+SA3D_GLTF_DOCUMENT_SUMMARY_status, SA3D_GLTF_DOCUMENT_STATUS_MALFORMED_JSON as i32
    !any_bad
    !b8
    !b7
    !b6
    !b5
    !b4
    !b3
    !b2
    !b1
    !b0
    !accessors_bad
    !buffer_views_bad
    !buffers_bad
    !skins_bad
    !animations_bad
    !textures_bad
    !images_bad
    !materials_bad
    !meshes_bad
    !nodes_bad
    !scenes_bad
    !accessors
    !buffer_views
    !buffers
    !skins
    !animations
    !textures
    !images
    !materials
    !meshes
    !nodes
    !scenes
    !summary
    !len
    !bytes
    return SA3D_GLTF_DOCUMENT_STATUS_MALFORMED_JSON

@sa3d_gltf_json_root_array_item_start(bytes: ptr, len: i64, key: ptr, key_len: i64, item_index: i64) -> i64:
L_ENTRY:
    negative_index = slt item_index, 0
    br negative_index -> L_MISSING_INDEX, L_FIND_ARRAY

L_FIND_ARRAY:
    value_pos = call @sa3d_gltf_json_find_root_key_value(bytes, len, key, key_len)
    malformed_find = eq value_pos, -2
    br malformed_find -> L_MALFORMED_FIND, L_MISSING_CHECK

L_MISSING_CHECK:
    missing = eq value_pos, -1
    br missing -> L_MISSING, L_CHECK_ARRAY

L_CHECK_ARRAY:
    in_bounds = slt value_pos, len
    br in_bounds -> L_ARRAY_LOAD, L_MALFORMED_BOUNDS

L_ARRAY_LOAD:
    array_ptr = ptr_add bytes, value_pos
    array_byte = load array_ptr+0 as u8
    is_array = eq array_byte, 91
    br is_array -> L_FIRST, L_MALFORMED_ARRAY

L_FIRST:
    first0 = add value_pos, 1
    first = call @sa3d_gltf_json_skip_ws_from(bytes, len, first0)
    first_in_bounds = slt first, len
    br first_in_bounds -> L_EMPTY_CHECK, L_MALFORMED_FIRST

L_EMPTY_CHECK:
    first_ptr = ptr_add bytes, first
    first_byte = load first_ptr+0 as u8
    is_empty = eq first_byte, 93
    br is_empty -> L_MISSING_EMPTY, L_TARGET_ZERO

L_TARGET_ZERO:
    is_zero = eq item_index, 0
    br is_zero -> L_RETURN_FIRST, L_LOOP_INIT

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    arr_depth_slot = stack_alloc 8
    obj_depth_slot = stack_alloc 8
    current_slot = stack_alloc 8
    store idx_slot+0, first as i64
    store arr_depth_slot+0, 1 as i64
    store obj_depth_slot+0, 0 as i64
    store current_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_MALFORMED_SCAN_EOF, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    is_quote = eq b, 34
    br is_quote -> L_STRING, L_STRUCTURAL

L_STRING:
    skipped = call @sa3d_gltf_json_skip_string(bytes, len, idx)
    bad_string = slt skipped, 0
    br bad_string -> L_MALFORMED_STRING, L_STORE_STRING

L_STORE_STRING:
    store idx_slot+0, skipped as i64
    !bad_string
    !skipped
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_STRUCTURAL:
    arr_depth = load arr_depth_slot+0 as i64
    obj_depth = load obj_depth_slot+0 as i64
    is_arr_open = eq b, 91
    br is_arr_open -> L_ARR_OPEN, L_ARR_CLOSE_CHECK

L_ARR_OPEN:
    arr_next = add arr_depth, 1
    next_ao = add idx, 1
    store arr_depth_slot+0, arr_next as i64
    store idx_slot+0, next_ao as i64
    !next_ao
    !arr_next
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_ARR_CLOSE_CHECK:
    is_arr_close = eq b, 93
    br is_arr_close -> L_ARR_CLOSE, L_OBJ_OPEN_CHECK

L_ARR_CLOSE:
    arr_prev = sub arr_depth, 1
    finished = eq arr_prev, 0
    br finished -> L_MISSING_END, L_ARR_CLOSE_STORE

L_ARR_CLOSE_STORE:
    next_ac = add idx, 1
    store arr_depth_slot+0, arr_prev as i64
    store idx_slot+0, next_ac as i64
    !next_ac
    !finished
    !arr_prev
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OBJ_OPEN_CHECK:
    is_obj_open = eq b, 123
    br is_obj_open -> L_OBJ_OPEN, L_OBJ_CLOSE_CHECK

L_OBJ_OPEN:
    obj_next = add obj_depth, 1
    next_oo = add idx, 1
    store obj_depth_slot+0, obj_next as i64
    store idx_slot+0, next_oo as i64
    !next_oo
    !obj_next
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OBJ_CLOSE_CHECK:
    is_obj_close = eq b, 125
    br is_obj_close -> L_OBJ_CLOSE, L_COMMA_CHECK

L_OBJ_CLOSE:
    obj_prev = sub obj_depth, 1
    next_oc = add idx, 1
    store obj_depth_slot+0, obj_prev as i64
    store idx_slot+0, next_oc as i64
    !next_oc
    !obj_prev
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_COMMA_CHECK:
    is_comma = eq b, 44
    arr_top = eq arr_depth, 1
    obj_top = eq obj_depth, 0
    top_a = and arr_top, obj_top
    top_comma = and top_a, is_comma
    br top_comma -> L_NEXT_ITEM, L_OTHER

L_NEXT_ITEM:
    current = load current_slot+0 as i64
    next_current = add current, 1
    next_item0 = add idx, 1
    next_item = call @sa3d_gltf_json_skip_ws_from(bytes, len, next_item0)
    target = eq next_current, item_index
    br target -> L_RETURN_NEXT_ITEM, L_STORE_NEXT_ITEM

L_STORE_NEXT_ITEM:
    store current_slot+0, next_current as i64
    store idx_slot+0, next_item as i64
    !target
    !next_item
    !next_item0
    !next_current
    !current
    !top_comma
    !top_a
    !obj_top
    !arr_top
    !is_comma
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OTHER:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !top_comma
    !top_a
    !obj_top
    !arr_top
    !is_comma
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_RETURN_NEXT_ITEM:
    !target
    !next_item0
    !next_current
    !current
    !top_comma
    !top_a
    !obj_top
    !arr_top
    !is_comma
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !is_zero
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first
    !first0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !missing
    !malformed_find
    !value_pos
    !negative_index
    !item_index
    !key_len
    !key
    !len
    !bytes
    return next_item

L_RETURN_FIRST:
    !is_zero
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !missing
    !malformed_find
    !value_pos
    !negative_index
    !item_index
    !key_len
    !key
    !len
    !bytes
    return first

L_MISSING_END:
    !finished
    !arr_prev
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !is_zero
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first
    !first0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !missing
    !malformed_find
    !value_pos
    !negative_index
    !item_index
    !key_len
    !key
    !len
    !bytes
    return -1

L_MISSING_EMPTY:
    !is_empty
    !first_byte
    !first_ptr
    !first_in_bounds
    !first
    !first0
    !is_array
    !array_byte
    !array_ptr
    !in_bounds
    !missing
    !malformed_find
    !value_pos
    !negative_index
    !item_index
    !key_len
    !key
    !len
    !bytes
    return -1

L_MISSING:
    !missing
    !malformed_find
    !value_pos
    !negative_index
    !item_index
    !key_len
    !key
    !len
    !bytes
    return -1

L_MISSING_INDEX:
    !negative_index
    !item_index
