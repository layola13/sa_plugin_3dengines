    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_TARGET:
    store out+SA3D_GLTF_MORPH_TARGET_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !target_missing
    !target_pos
    !targets_malformed
    !targets_missing
    !targets_pos
    !primitive_malformed
    !primitive_missing
    !primitive_pos
    !out
    !target_index
    !primitive_index
    !mesh_index
    !len
