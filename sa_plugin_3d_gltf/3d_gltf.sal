    return SA3D_GLTF_ATTR_MATERIALIZE_STATUS_MALFORMED_DATA

L_OUTPUT_SMALL:
    !cap_ok
    !required
    !size_ok
    !expected_size
    !element_size
    !ok0
    !ptrs
    !dst_present
    !buffer_present
    !nonnegative
    !cap_nonnegative
    !count_nonnegative
    !layout_ok
    !layout_status
    !format_ok
