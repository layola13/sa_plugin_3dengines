@sa3d_gltf_json_array_item_start(bytes: ptr, len: i64, array_pos: i64, item_index: i64) -> i64:
L_ENTRY:
    negative_index = slt item_index, 0
    br negative_index -> L_MISSING_INDEX, L_CHECK_ARRAY

L_CHECK_ARRAY:
    in_bounds = slt array_pos, len
    br in_bounds -> L_ARRAY_LOAD, L_MALFORMED_BOUNDS

L_ARRAY_LOAD:
    array_ptr = ptr_add bytes, array_pos
    array_byte = load array_ptr+0 as u8
    is_array = eq array_byte, 91
    br is_array -> L_FIRST, L_MALFORMED_ARRAY

L_FIRST:
    first0 = add array_pos, 1
    first = call @sa3d_gltf_json_skip_ws_from(bytes, len, first0)
    first_in_bounds = slt first, len
    br first_in_bounds -> L_EMPTY_CHECK, L_MALFORMED_FIRST

L_EMPTY_CHECK:
    first_ptr = ptr_add bytes, first
    first_byte = load first_ptr+0 as u8
    is_empty = eq first_byte, 93
    br is_empty -> L_MISSING_EMPTY, L_TARGET_ZERO

L_TARGET_ZERO:
    is_zero = eq item_index, 0
    br is_zero -> L_RETURN_FIRST, L_LOOP_INIT

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    arr_depth_slot = stack_alloc 8
    obj_depth_slot = stack_alloc 8
    current_slot = stack_alloc 8
    store idx_slot+0, first as i64
    store arr_depth_slot+0, 1 as i64
    store obj_depth_slot+0, 0 as i64
    store current_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_MALFORMED_SCAN_EOF, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    is_quote = eq b, 34
    br is_quote -> L_STRING, L_STRUCTURAL

L_STRING:
    skipped = call @sa3d_gltf_json_skip_string(bytes, len, idx)
    bad_string = slt skipped, 0
    br bad_string -> L_MALFORMED_STRING, L_STORE_STRING

L_STORE_STRING:
    store idx_slot+0, skipped as i64
    !bad_string
    !skipped
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_STRUCTURAL:
    arr_depth = load arr_depth_slot+0 as i64
    obj_depth = load obj_depth_slot+0 as i64
    is_arr_open = eq b, 91
    br is_arr_open -> L_ARR_OPEN, L_ARR_CLOSE_CHECK

L_ARR_OPEN:
    arr_next = add arr_depth, 1
    next_ao = add idx, 1
    store arr_depth_slot+0, arr_next as i64
    store idx_slot+0, next_ao as i64
    !next_ao
    !arr_next
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_ARR_CLOSE_CHECK:
    is_arr_close = eq b, 93
    br is_arr_close -> L_ARR_CLOSE, L_OBJ_OPEN_CHECK

L_ARR_CLOSE:
    arr_prev = sub arr_depth, 1
    finished = eq arr_prev, 0
    br finished -> L_MISSING_END, L_ARR_CLOSE_STORE

L_ARR_CLOSE_STORE:
    next_ac = add idx, 1
    store arr_depth_slot+0, arr_prev as i64
    store idx_slot+0, next_ac as i64
    !next_ac
    !finished
    !arr_prev
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OBJ_OPEN_CHECK:
    is_obj_open = eq b, 123
    br is_obj_open -> L_OBJ_OPEN, L_OBJ_CLOSE_CHECK

L_OBJ_OPEN:
    obj_next = add obj_depth, 1
    next_oo = add idx, 1
    store obj_depth_slot+0, obj_next as i64
    store idx_slot+0, next_oo as i64
    !next_oo
    !obj_next
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OBJ_CLOSE_CHECK:
    is_obj_close = eq b, 125
    br is_obj_close -> L_OBJ_CLOSE, L_COMMA_CHECK

L_OBJ_CLOSE:
    obj_prev = sub obj_depth, 1
    next_oc = add idx, 1
    store obj_depth_slot+0, obj_prev as i64
    store idx_slot+0, next_oc as i64
    !next_oc
    !obj_prev
    !is_obj_close
    !is_obj_open
    !is_arr_close
    !is_arr_open
    !obj_depth
    !arr_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_COMMA_CHECK:
    is_comma = eq b, 44
    arr_top = eq arr_depth, 1
    obj_top = eq obj_depth, 0
    top_a = and arr_top, obj_top
    top_comma = and top_a, is_comma
    br top_comma -> L_NEXT_ITEM, L_OTHER

L_NEXT_ITEM:
    current = load current_slot+0 as i64
    next_current = add current, 1
    next_item0 = add idx, 1
    next_item = call @sa3d_gltf_json_skip_ws_from(bytes, len, next_item0)
    target = eq next_current, item_index
    br target -> L_RETURN_NEXT_ITEM, L_STORE_NEXT_ITEM

L_STORE_NEXT_ITEM:
