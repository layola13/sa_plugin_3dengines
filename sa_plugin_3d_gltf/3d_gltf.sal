@sa3d_gltf_json_animation_sampler_parse(bytes: ptr, len: i64, &animation: ptr, sampler_index: i64, &out: ptr) -> i32:
L_ENTRY:
    input_slot = stack_alloc 8
    output_slot = stack_alloc 8
    interp_ptr_slot = stack_alloc 8
    interp_len_slot = stack_alloc 8
    call @sa3d_gltf_json_animation_sampler_table_clear(&out)
    negative = slt sampler_index, 0
    br negative -> L_MISSING, L_RANGE

L_RANGE:
    sampler_count = load animation+SA3D_GLTF_ANIMATION_TABLE_sampler_count as i64
    in_range = slt sampler_index, sampler_count
    br in_range -> L_ITEM, L_MISSING_RANGE

L_ITEM:
    samplers_pos = load animation+SA3D_GLTF_ANIMATION_TABLE_samplers_array_pos as i64
    sampler_pos = call @sa3d_gltf_json_array_item_start(bytes, len, samplers_pos, sampler_index)
    sampler_missing = eq sampler_pos, -1
    br sampler_missing -> L_MISSING_ITEM, L_ITEM_MALFORMED_CHECK

L_ITEM_MALFORMED_CHECK:
    sampler_malformed = eq sampler_pos, -2
    br sampler_malformed -> L_BAD_ITEM, L_INPUT

L_INPUT:
    input_status = call @sa3d_gltf_json_object_i64_value(bytes, len, sampler_pos, &SA3D_GLTF_JSON_KEY_INPUT, 5, &input_slot)
    input_bad = slt input_status, 0
    br input_bad -> L_BAD_INPUT, L_INPUT_STORE

L_INPUT_STORE:
    input_found = eq input_status, 1
    br input_found -> L_INPUT_VALUE, L_INPUT_MISSING_STORE

L_INPUT_VALUE:
    input_value = load input_slot+0 as i64
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_input, input_value as i64
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_input, 0 as i32
    !input_value
    !input_found
    jmp L_OUTPUT

L_INPUT_MISSING_STORE:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_input, 1 as i32
    !input_found
    jmp L_OUTPUT

L_OUTPUT:
    output_status = call @sa3d_gltf_json_object_i64_value(bytes, len, sampler_pos, &SA3D_GLTF_JSON_KEY_OUTPUT, 6, &output_slot)
    output_bad = slt output_status, 0
    br output_bad -> L_BAD_OUTPUT, L_OUTPUT_STORE

L_OUTPUT_STORE:
    output_found = eq output_status, 1
    br output_found -> L_OUTPUT_VALUE, L_OUTPUT_MISSING_STORE

L_OUTPUT_VALUE:
    output_value = load output_slot+0 as i64
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_output, output_value as i64
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_output, 0 as i32
    !output_value
    !output_found
    jmp L_INTERPOLATION

L_OUTPUT_MISSING_STORE:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_output, 1 as i32
    !output_found
    jmp L_INTERPOLATION

L_INTERPOLATION:
    interp_status = call @sa3d_gltf_json_object_string_span(bytes, len, sampler_pos, &SA3D_GLTF_JSON_KEY_INTERPOLATION, 13, &interp_ptr_slot, &interp_len_slot)
    interp_bad = slt interp_status, 0
    br interp_bad -> L_BAD_INTERPOLATION, L_INTERP_FOUND_CHECK

L_INTERP_FOUND_CHECK:
    interp_found = eq interp_status, 1
    br interp_found -> L_INTERP_PARSE, L_INTERP_SKIP

L_INTERP_PARSE:
    interp_ptr = load interp_ptr_slot+0 as ptr
    interp_len = load interp_len_slot+0 as i64
    interp_value = call @sa3d_gltf_json_animation_interpolation_from_span(interp_ptr, interp_len)
    interp_value_bad = slt interp_value, 0
    br interp_value_bad -> L_BAD_INTERPOLATION_VALUE, L_INTERP_STORE

L_INTERP_STORE:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_interpolation, interp_value as i32
    !interp_value_bad
    !interp_value
    !interp_len
    !interp_ptr
    !interp_found
    jmp L_OK

L_INTERP_SKIP:
    !interp_found
    jmp L_OK

L_OK:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !interp_bad
    !interp_status
    !output_bad
    !output_status
    !input_bad
    !input_status
    !sampler_malformed
    !sampler_missing
    !sampler_pos
    !in_range
    !sampler_count
    !negative
    !out
    !sampler_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_INTERPOLATION_VALUE:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT as i32
    !interp_value_bad
    !interp_value
    !interp_len
    !interp_ptr
    !interp_bad
    !interp_status
    !output_bad
    !output_status
    !input_bad
    !input_status
    !sampler_malformed
    !sampler_missing
    !sampler_pos
    !in_range
    !sampler_count
    !negative
    !out
    !sampler_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_BAD_INTERPOLATION:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !interp_bad
    !interp_status
    !output_bad
    !output_status
    !input_bad
    !input_status
    !sampler_malformed
    !sampler_missing
    !sampler_pos
    !in_range
    !sampler_count
    !negative
    !out
    !sampler_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_OUTPUT:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !output_bad
    !output_status
    !input_bad
    !input_status
    !sampler_malformed
    !sampler_missing
    !sampler_pos
    !in_range
    !sampler_count
    !negative
    !out
    !sampler_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_INPUT:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !input_bad
    !input_status
    !sampler_malformed
    !sampler_missing
    !sampler_pos
    !in_range
    !sampler_count
    !negative
    !out
    !sampler_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_ITEM:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !sampler_malformed
    !sampler_missing
    !sampler_pos
    !in_range
    !sampler_count
    !negative
    !out
    !sampler_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_ITEM:
L_MISSING_RANGE:
L_MISSING:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !negative
    !out
    !sampler_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

@sa3d_gltf_json_animation_channel_parse(bytes: ptr, len: i64, &animation: ptr, channel_index: i64, &out: ptr) -> i32:
L_ENTRY:
    sampler_slot = stack_alloc 8
    node_slot = stack_alloc 8
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8
    call @sa3d_gltf_json_animation_channel_table_clear(&out)
    negative = slt channel_index, 0
    br negative -> L_MISSING, L_RANGE

L_RANGE:
    channel_count = load animation+SA3D_GLTF_ANIMATION_TABLE_channel_count as i64
    in_range = slt channel_index, channel_count
    br in_range -> L_ITEM, L_MISSING_RANGE

L_ITEM:
    channels_pos = load animation+SA3D_GLTF_ANIMATION_TABLE_channels_array_pos as i64
    channel_pos = call @sa3d_gltf_json_array_item_start(bytes, len, channels_pos, channel_index)
    channel_missing = eq channel_pos, -1
    br channel_missing -> L_MISSING_ITEM, L_ITEM_MALFORMED_CHECK

L_ITEM_MALFORMED_CHECK:
    channel_malformed = eq channel_pos, -2
    br channel_malformed -> L_BAD_ITEM, L_SAMPLER

L_SAMPLER:
    sampler_status = call @sa3d_gltf_json_object_i64_value(bytes, len, channel_pos, &SA3D_GLTF_JSON_KEY_SAMPLER, 7, &sampler_slot)
    sampler_bad = slt sampler_status, 0
    br sampler_bad -> L_BAD_SAMPLER, L_SAMPLER_FOUND_CHECK

L_SAMPLER_FOUND_CHECK:
    sampler_found = eq sampler_status, 1
    br sampler_found -> L_SAMPLER_STORE, L_MISSING_SAMPLER

L_SAMPLER_STORE:
    sampler_value = load sampler_slot+0 as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_sampler, sampler_value as i64
    !sampler_value
    !sampler_found
    jmp L_TARGET

L_TARGET:
    target_pos = call @sa3d_gltf_json_object_field_value(bytes, len, channel_pos, &SA3D_GLTF_JSON_KEY_TARGET, 6)
    target_missing = eq target_pos, -1
    br target_missing -> L_MISSING_TARGET, L_TARGET_MALFORMED_CHECK

L_TARGET_MALFORMED_CHECK:
    target_malformed = eq target_pos, -2
    br target_malformed -> L_BAD_TARGET, L_NODE

L_NODE:
    node_status = call @sa3d_gltf_json_object_i64_value(bytes, len, target_pos, &SA3D_GLTF_JSON_KEY_NODE, 4, &node_slot)
    node_bad = slt node_status, 0
    br node_bad -> L_BAD_NODE, L_NODE_FOUND_CHECK

L_NODE_FOUND_CHECK:
    node_found = eq node_status, 1
    br node_found -> L_NODE_STORE, L_MISSING_NODE

L_NODE_STORE:
    node_value = load node_slot+0 as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_node, node_value as i64
    !node_value
    !node_found
    jmp L_PATH

L_PATH:
    path_status = call @sa3d_gltf_json_object_string_span(bytes, len, target_pos, &SA3D_GLTF_JSON_KEY_PATH, 4, &path_ptr_slot, &path_len_slot)
    path_bad = slt path_status, 0
    br path_bad -> L_BAD_PATH, L_PATH_FOUND_CHECK

L_PATH_FOUND_CHECK:
    path_found = eq path_status, 1
    br path_found -> L_PATH_PARSE, L_MISSING_PATH

L_PATH_PARSE:
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as i64
    path_value = call @sa3d_gltf_json_animation_path_from_span(path_ptr, path_len)
    path_value_bad = eq path_value, 0
    br path_value_bad -> L_BAD_PATH_VALUE, L_PATH_STORE

L_PATH_STORE:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_path, path_value as i32
    !path_value_bad
    !path_value
    !path_len
    !path_ptr
    !path_found
    jmp L_OK

L_OK:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !path_bad
    !path_status
    !node_bad
    !node_status
    !target_malformed
    !target_missing
    !target_pos
    !sampler_bad
    !sampler_status
    !channel_malformed
    !channel_missing
    !channel_pos
    !in_range
    !channel_count
    !negative
    !out
    !channel_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_PATH_VALUE:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT as i32
    !path_value_bad
    !path_value
    !path_len
    !path_ptr
    !path_found
    !path_bad
    !path_status
    !node_bad
    !node_status
    !target_malformed
    !target_missing
    !target_pos
    !sampler_bad
    !sampler_status
    !channel_malformed
    !channel_missing
    !channel_pos
    !in_range
    !channel_count
    !negative
    !out
    !channel_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_BAD_PATH:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !path_bad
    !path_status
    !node_bad
    !node_status
    !target_malformed
    !target_missing
    !target_pos
    !sampler_bad
    !sampler_status
    !channel_malformed
    !channel_missing
    !channel_pos
    !in_range
    !channel_count
    !negative
    !out
    !channel_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_PATH:
L_MISSING_NODE:
L_MISSING_TARGET:
L_MISSING_SAMPLER:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    !channel_index
    !animation
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_BAD_NODE:
L_BAD_TARGET:
L_BAD_SAMPLER:
L_BAD_ITEM:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !out
    !channel_index
    !animation
    !len
