L_BAD:
    !malformed
    !missing
    !nodes_pos
    !root_index
    !scene_index
    !len
    !bytes
    return -2

@sa3d_gltf_json_cycle_clear_visited(&visited: ptr, visited_len: i64, node_count: i64) -> i32:
L_ENTRY:
    too_small = slt visited_len, node_count
    br too_small -> L_TOO_SMALL, L_LOOP_INIT

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = eq idx, node_count
    br done -> L_OK, L_BODY

L_BODY:
    p = ptr_add visited, idx
    store p+0, 0 as u8
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !p
    !done
    !idx
    jmp L_HEAD

L_OK:
    !done
    !idx
    !too_small
    !node_count
    !visited_len
    !visited
    return SA3D_GLTF_CYCLE_STATUS_OK

L_TOO_SMALL:
    !too_small
    !node_count
    !visited_len
    !visited
    return SA3D_GLTF_CYCLE_STATUS_OUTPUT_TOO_SMALL

@sa3d_gltf_json_node_cycle_dfs(bytes: ptr, len: i64, node_index: i64, node_count: i64, &visited: ptr, visited_len: i64) -> i32:
L_ENTRY:
    negative = slt node_index, 0
    br negative -> L_INVALID_NODE, L_RANGE

L_RANGE:
    in_range = slt node_index, node_count
    br in_range -> L_VISITED_SIZE, L_INVALID_NODE_RANGE

L_VISITED_SIZE:
    too_small = slt visited_len, node_count
    br too_small -> L_TOO_SMALL, L_VISITED_CHECK

L_VISITED_CHECK:
    mark_ptr = ptr_add visited, node_index
    mark = load mark_ptr+0 as u8
    marked = ne mark, 0
    br marked -> L_CYCLE, L_MARK

L_MARK:
    store mark_ptr+0, 1 as u8
    child_count = call @sa3d_gltf_json_node_child_count_by_index(bytes, len, node_index)
    count_bad = slt child_count, 0
    br count_bad -> L_BAD_CHILD_COUNT, L_LOOP_INIT

L_LOOP_INIT:
    child_idx_slot = stack_alloc 8
    store child_idx_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    child_idx = load child_idx_slot+0 as i64
    done = eq child_idx, child_count
    br done -> L_UNMARK_OK, L_CHILD

L_CHILD:
    child = call @sa3d_gltf_json_node_child_at_by_index(bytes, len, node_index, child_idx)
    child_bad = slt child, 0
    br child_bad -> L_BAD_CHILD, L_RECURSE

L_RECURSE:
    status = call @sa3d_gltf_json_node_cycle_dfs(bytes, len, child, node_count, &visited, visited_len)
    status_ok = eq status, SA3D_GLTF_CYCLE_STATUS_OK
    br status_ok -> L_NEXT, L_RETURN_STATUS

L_NEXT:
    next = add child_idx, 1
    store child_idx_slot+0, next as i64
    !next
    !status_ok
    !status
    !child_bad
    !child
    !done
    !child_idx
    jmp L_LOOP_HEAD

L_UNMARK_OK:
    store mark_ptr+0, 0 as u8
    !done
    !child_idx
    !count_bad
    !child_count
    !marked
    !mark
    !mark_ptr
    !too_small
    !in_range
    !negative
    !visited_len
    !visited
    !node_count
    !node_index
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_OK

L_RETURN_STATUS:
    store mark_ptr+0, 0 as u8
    !status_ok
    !child_bad
    !child
    !done
    !child_idx
    !count_bad
    !child_count
    !marked
    !mark
    !mark_ptr
    !too_small
    !in_range
    !negative
    !visited_len
    !visited
    !node_count
    !node_index
    !len
    !bytes
    return status

L_BAD_CHILD:
    store mark_ptr+0, 0 as u8
    !child_bad
    !child
    !done
    !child_idx
    !count_bad
    !child_count
    !marked
    !mark
    !mark_ptr
    !too_small
    !in_range
    !negative
    !visited_len
    !visited
    !node_count
    !node_index
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_MALFORMED_JSON

L_BAD_CHILD_COUNT:
    store mark_ptr+0, 0 as u8
    !count_bad
    !child_count
    !marked
    !mark
    !mark_ptr
    !too_small
    !in_range
    !negative
    !visited_len
    !visited
    !node_count
    !node_index
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_MALFORMED_JSON

L_CYCLE:
    !marked
    !mark
    !mark_ptr
    !too_small
    !in_range
    !negative
    !visited_len
    !visited
    !node_count
    !node_index
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_CYCLE

L_TOO_SMALL:
    !too_small
    !in_range
    !negative
    !visited_len
    !visited
    !node_count
    !node_index
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_OUTPUT_TOO_SMALL

L_INVALID_NODE_RANGE:
    !in_range
    !negative
    !visited_len
    !visited
    !node_count
    !node_index
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_INVALID_NODE_INDEX

L_INVALID_NODE:
    !negative
    !visited_len
    !visited
    !node_count
    !node_index
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_INVALID_NODE_INDEX

@sa3d_gltf_json_check_for_cycles(bytes: ptr, len: i64, &visited: ptr, visited_len: i64) -> i32:
L_ENTRY:
    scene_idx_slot = stack_alloc 8
    root_idx_slot = stack_alloc 8
    node_count = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_NODES, 5)
    node_count_bad = slt node_count, 0
    br node_count_bad -> L_BAD_NODE_COUNT, L_CLEAR

L_CLEAR:
    clear_status = call @sa3d_gltf_json_cycle_clear_visited(&visited, visited_len, node_count)
    clear_ok = eq clear_status, SA3D_GLTF_CYCLE_STATUS_OK
    br clear_ok -> L_SCENE_COUNT, L_RETURN_CLEAR

L_SCENE_COUNT:
    scene_count = call @sa3d_gltf_json_root_array_item_count(bytes, len, &SA3D_GLTF_JSON_KEY_SCENES, 6)
    scene_count_bad = slt scene_count, 0
    br scene_count_bad -> L_BAD_SCENE_COUNT, L_SCENE_LOOP_INIT

L_SCENE_LOOP_INIT:
    store scene_idx_slot+0, 0 as i64
    store root_idx_slot+0, 0 as i64
    jmp L_SCENE_HEAD

L_SCENE_HEAD:
    scene_idx = load scene_idx_slot+0 as i64
    scenes_done = eq scene_idx, scene_count
    br scenes_done -> L_OK, L_ROOT_COUNT

L_ROOT_COUNT:
    root_count = call @sa3d_gltf_json_scene_root_count(bytes, len, scene_idx)
    root_count_bad = slt root_count, 0
    br root_count_bad -> L_BAD_ROOT_COUNT, L_ROOT_LOOP_INIT

L_ROOT_LOOP_INIT:
    store root_idx_slot+0, 0 as i64
    jmp L_ROOT_HEAD

L_ROOT_HEAD:
    root_idx = load root_idx_slot+0 as i64
    roots_done = eq root_idx, root_count
    br roots_done -> L_NEXT_SCENE, L_ROOT_VALUE

L_ROOT_VALUE:
    root_node = call @sa3d_gltf_json_scene_root_at(bytes, len, scene_idx, root_idx)
    root_bad = slt root_node, 0
    br root_bad -> L_BAD_ROOT_VALUE, L_DFS

L_DFS:
    dfs_status = call @sa3d_gltf_json_node_cycle_dfs(bytes, len, root_node, node_count, &visited, visited_len)
    dfs_ok = eq dfs_status, SA3D_GLTF_CYCLE_STATUS_OK
    br dfs_ok -> L_NEXT_ROOT, L_RETURN_DFS

L_NEXT_ROOT:
    next_root = add root_idx, 1
    store root_idx_slot+0, next_root as i64
    !next_root
    !dfs_ok
    !dfs_status
    !root_bad
    !root_node
    !roots_done
    !root_idx
    jmp L_ROOT_HEAD

L_NEXT_SCENE:
    next_scene = add scene_idx, 1
    store scene_idx_slot+0, next_scene as i64
    !next_scene
    !roots_done
    !root_idx
    !root_count_bad
    !root_count
    !scenes_done
    !scene_idx
    jmp L_SCENE_HEAD

L_OK:
    !scenes_done
    !scene_idx
    !scene_count_bad
    !scene_count
    !clear_ok
    !clear_status
    !node_count_bad
    !node_count
    !visited_len
    !visited
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_OK

L_RETURN_DFS:
    !dfs_ok
    !root_bad
    !root_node
    !roots_done
    !root_idx
    !root_count_bad
    !root_count
    !scenes_done
    !scene_idx
    !scene_count_bad
    !scene_count
    !clear_ok
    !clear_status
    !node_count_bad
    !node_count
    !visited_len
    !visited
    !len
    !bytes
    return dfs_status

L_BAD_ROOT_VALUE:
    !root_bad
    !root_node
    !roots_done
    !root_idx
    !root_count_bad
    !root_count
    !scenes_done
    !scene_idx
    !scene_count_bad
    !scene_count
    !clear_ok
    !clear_status
    !node_count_bad
    !node_count
    !visited_len
    !visited
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_MALFORMED_JSON

L_BAD_ROOT_COUNT:
    !root_count_bad
    !root_count
    !scenes_done
    !scene_idx
    !scene_count_bad
    !scene_count
    !clear_ok
    !clear_status
    !node_count_bad
    !node_count
    !visited_len
    !visited
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_MALFORMED_JSON

L_BAD_SCENE_COUNT:
    !scene_count_bad
    !scene_count
    !clear_ok
    !clear_status
    !node_count_bad
    !node_count
    !visited_len
    !visited
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_MALFORMED_JSON

L_RETURN_CLEAR:
    !clear_ok
    !node_count_bad
    !node_count
    !visited_len
    !visited
    !len
    !bytes
    return clear_status

L_BAD_NODE_COUNT:
    !node_count_bad
    !node_count
    !visited_len
    !visited
    !len
    !bytes
    return SA3D_GLTF_CYCLE_STATUS_MALFORMED_JSON

@sa3d_gltf_skin_name_to_bytes(skin_index: i64, name_ptr: ptr, name_len: i64, &dst: ptr, cap: i64) -> i64:
L_ENTRY:
    has_ptr = ne name_ptr, 0
    len_ok = sge name_len, 0
    has_name = and has_ptr, len_ok
    br has_name -> L_COPY_NAME, L_FALLBACK

L_COPY_NAME:
    out_name = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &name_ptr, name_len)
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !skin_index
    return out_name

L_FALLBACK:
    p0 = call @sa3d_gltf_label_copy_bytes(&dst, cap, 0, &SA3D_GLTF_NAME_TEXT_SKIN_PREFIX, 8)
    p0_failed = slt p0, 0
    br p0_failed -> L_FAIL, L_INDEX

L_INDEX:
    out_fallback = call @sa3d_gltf_label_write_i64_decimal(&dst, cap, p0, skin_index)
    !p0_failed
    !p0
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !skin_index
    return out_fallback

L_FAIL:
    !p0_failed
    !p0
    !has_name
    !len_ok
    !has_ptr
    !cap
    !dst
    !name_len
    !name_ptr
    !skin_index
    return -1

@sa3d_gltf_json_skin_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_SKIN_TABLE_index, 0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_name_ptr, 0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_name_len, 0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_joint_count, 0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_joints_array_pos, -1 as i64
    store out+SA3D_GLTF_SKIN_TABLE_first_joint, -1 as i64
    store out+SA3D_GLTF_SKIN_TABLE_has_inverse_bind_matrices, 0 as i32
    store out+SA3D_GLTF_SKIN_TABLE_inverse_bind_matrices, 0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_has_extras, 0 as i32
    store out+SA3D_GLTF_SKIN_TABLE_extras_ptr, 0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_extras_len, 0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_exceeds_max_joints, 0 as i32
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_skin_joint_at(bytes: ptr, len: i64, &skin: ptr, joint_index: i64) -> i64:
L_ENTRY:
    negative = slt joint_index, 0
    br negative -> L_MISSING_NEGATIVE, L_RANGE

L_RANGE:
    count = load skin+SA3D_GLTF_SKIN_TABLE_joint_count as i64
    in_range = slt joint_index, count
    br in_range -> L_POS, L_MISSING_RANGE

L_POS:
    joints_pos = load skin+SA3D_GLTF_SKIN_TABLE_joints_array_pos as i64
    value_pos = call @sa3d_gltf_json_array_item_start(bytes, len, joints_pos, joint_index)
    value_bad = slt value_pos, 0
    br value_bad -> L_BAD_VALUE_POS, L_PARSE

L_PARSE:
    joint = call @sa3d_gltf_json_parse_positive_i64(bytes, len, value_pos)
    joint_bad = slt joint, 0
    br joint_bad -> L_BAD_JOINT, L_OK

L_OK:
    !joint_bad
    !value_bad
    !value_pos
    !joints_pos
    !in_range
    !count
    !negative
    !joint_index
    !skin
    !len
    !bytes
    return joint

L_BAD_JOINT:
    !joint_bad
    !joint
    !value_bad
    !value_pos
    !joints_pos
    !in_range
    !count
    !negative
    !joint_index
    !skin
    !len
    !bytes
    return -2

L_BAD_VALUE_POS:
    !value_bad
    !value_pos
    !joints_pos
    !in_range
    !count
    !negative
    !joint_index
    !skin
    !len
    !bytes
    return -2

L_MISSING_RANGE:
    !in_range
    !count
    !negative
    !joint_index
    !skin
    !len
    !bytes
    return -1

L_MISSING_NEGATIVE:
    !negative
    !joint_index
    !skin
    !len
    !bytes
    return -1

@sa3d_gltf_json_skin_parse(bytes: ptr, len: i64, skin_index: i64, &out: ptr) -> i32:
L_ENTRY:
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    ibm_slot = stack_alloc 8
    extras_ptr_slot = stack_alloc 8
    extras_len_slot = stack_alloc 8
    call @sa3d_gltf_json_skin_table_clear(&out)
    store out+SA3D_GLTF_SKIN_TABLE_index, skin_index as i64
    skin_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_SKINS, 5, skin_index)
    missing = eq skin_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq skin_pos, -2
    br malformed -> L_MALFORMED, L_NAME

L_NAME:
    name_status = call @sa3d_gltf_json_object_string_span(bytes, len, skin_pos, &SA3D_GLTF_JSON_KEY_NAME, 4, &name_ptr_slot, &name_len_slot)
    name_bad = slt name_status, 0
    br name_bad -> L_BAD_NAME, L_NAME_STORE_CHECK

L_NAME_STORE_CHECK:
    name_found = eq name_status, 1
    br name_found -> L_NAME_STORE, L_NAME_SKIP

L_NAME_STORE:
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_name_ptr, name_ptr as ptr
    store out+SA3D_GLTF_SKIN_TABLE_name_len, name_len as i64
    !name_len
    !name_ptr
    !name_found
    jmp L_JOINTS

L_NAME_SKIP:
    !name_found
    jmp L_JOINTS

L_JOINTS:
    joints_pos = call @sa3d_gltf_json_object_field_value(bytes, len, skin_pos, &SA3D_GLTF_JSON_KEY_JOINTS, 6)
    joints_missing = eq joints_pos, -1
    br joints_missing -> L_MISSING_JOINTS, L_JOINTS_MALFORMED_CHECK

L_JOINTS_MALFORMED_CHECK:
    joints_malformed = eq joints_pos, -2
    br joints_malformed -> L_BAD_JOINTS, L_JOINTS_COUNT

L_JOINTS_COUNT:
    joint_count = call @sa3d_gltf_json_count_array_items(bytes, len, joints_pos)
    joint_count_bad = slt joint_count, 0
    br joint_count_bad -> L_BAD_JOINT_COUNT, L_JOINTS_STORE

L_JOINTS_STORE:
    store out+SA3D_GLTF_SKIN_TABLE_joint_count, joint_count as i64
    store out+SA3D_GLTF_SKIN_TABLE_joints_array_pos, joints_pos as i64
    exceeds = sgt joint_count, SA3D_GLTF_MAX_JOINTS
    exceeds_i = zext exceeds as i32
    store out+SA3D_GLTF_SKIN_TABLE_exceeds_max_joints, exceeds_i as i32
    has_joint = sgt joint_count, 0
    br has_joint -> L_FIRST_JOINT_POS, L_FIRST_JOINT_SKIP

L_FIRST_JOINT_POS:
    first_pos = call @sa3d_gltf_json_array_item_start(bytes, len, joints_pos, 0)
    first_bad = slt first_pos, 0
    br first_bad -> L_BAD_FIRST_POS, L_FIRST_JOINT_VALUE

L_FIRST_JOINT_VALUE:
    first_joint = call @sa3d_gltf_json_parse_positive_i64(bytes, len, first_pos)
    first_value_bad = slt first_joint, 0
    br first_value_bad -> L_BAD_FIRST_VALUE, L_STORE_FIRST

L_STORE_FIRST:
    store out+SA3D_GLTF_SKIN_TABLE_first_joint, first_joint as i64
    !first_value_bad
    !first_joint
    !first_bad
    !first_pos
    !has_joint
    jmp L_INVERSE_BIND

L_FIRST_JOINT_SKIP:
    !has_joint
    jmp L_INVERSE_BIND

L_INVERSE_BIND:
    ibm_status = call @sa3d_gltf_json_object_i64_value(bytes, len, skin_pos, &SA3D_GLTF_JSON_KEY_INVERSE_BIND_MATRICES, 19, &ibm_slot)
    ibm_bad = slt ibm_status, 0
    br ibm_bad -> L_BAD_IBM, L_IBM_STORE_CHECK

L_IBM_STORE_CHECK:
    ibm_found = eq ibm_status, 1
    br ibm_found -> L_IBM_STORE, L_IBM_SKIP

L_IBM_STORE:
    ibm = load ibm_slot+0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_has_inverse_bind_matrices, 1 as i32
    store out+SA3D_GLTF_SKIN_TABLE_inverse_bind_matrices, ibm as i64
    !ibm
    !ibm_found
    jmp L_EXTRAS

L_IBM_SKIP:
    !ibm_found
    jmp L_EXTRAS

L_EXTRAS:
    extras_status = call @sa3d_gltf_json_object_value_span(bytes, len, skin_pos, &SA3D_GLTF_JSON_KEY_EXTRAS, 6, &extras_ptr_slot, &extras_len_slot)
    extras_bad = slt extras_status, 0
    br extras_bad -> L_BAD_EXTRAS, L_EXTRAS_STORE_CHECK

L_EXTRAS_STORE_CHECK:
    extras_found = eq extras_status, 1
    br extras_found -> L_EXTRAS_STORE, L_EXTRAS_SKIP

L_EXTRAS_STORE:
    extras_ptr = load extras_ptr_slot+0 as ptr
    extras_len = load extras_len_slot+0 as i64
    store out+SA3D_GLTF_SKIN_TABLE_has_extras, 1 as i32
    store out+SA3D_GLTF_SKIN_TABLE_extras_ptr, extras_ptr as ptr
    store out+SA3D_GLTF_SKIN_TABLE_extras_len, extras_len as i64
    !extras_len
    !extras_ptr
    !extras_found
    jmp L_OK

L_EXTRAS_SKIP:
    !extras_found
    jmp L_OK

L_OK:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !extras_bad
    !extras_status
    !ibm_bad
    !ibm_status
    !exceeds_i
    !exceeds
    !joint_count_bad
    !joint_count
    !joints_malformed
    !joints_missing
    !joints_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_EXTRAS:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !extras_bad
    !extras_status
    !ibm_bad
    !ibm_status
    !exceeds_i
    !exceeds
    !joint_count_bad
    !joint_count
    !joints_malformed
    !joints_missing
    !joints_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_IBM:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !ibm_bad
    !ibm_status
    !exceeds_i
    !exceeds
    !joint_count_bad
    !joint_count
    !joints_malformed
    !joints_missing
    !joints_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_FIRST_VALUE:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !first_value_bad
    !first_joint
    !first_bad
    !first_pos
    !has_joint
    !exceeds_i
    !exceeds
    !joint_count_bad
    !joint_count
    !joints_malformed
    !joints_missing
    !joints_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_FIRST_POS:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !first_bad
    !first_pos
    !has_joint
    !exceeds_i
    !exceeds
    !joint_count_bad
    !joint_count
    !joints_malformed
    !joints_missing
    !joints_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_JOINT_COUNT:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !joint_count_bad
    !joint_count
    !joints_malformed
    !joints_missing
    !joints_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_JOINTS:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !joints_malformed
    !joints_missing
    !joints_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_JOINTS:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !joints_missing
    !joints_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_BAD_NAME:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !name_bad
    !name_status
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_SKIN_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !skin_pos
    !out
    !skin_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_animation_interpolation_from_span(text: ptr, len: i64) -> i32:
L_ENTRY:
    linear_len = eq len, 6
    br linear_len -> L_LINEAR_CHECK, L_STEP_LEN

L_LINEAR_CHECK:
    linear_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_LINEAR, 6)
    br linear_eq -> L_LINEAR, L_STEP_LEN_AFTER_LINEAR

L_LINEAR:
    !linear_eq
    !linear_len
    !len
    !text
    return SA3D_GLTF_ANIMATION_INTERPOLATION_LINEAR

L_STEP_LEN_AFTER_LINEAR:
    !linear_eq
    jmp L_STEP_LEN_COMMON

L_STEP_LEN:
    jmp L_STEP_LEN_COMMON

L_STEP_LEN_COMMON:
    step_len = eq len, 4
    br step_len -> L_STEP_CHECK, L_CUBIC_LEN

L_STEP_CHECK:
    step_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_STEP, 4)
    br step_eq -> L_STEP, L_CUBIC_LEN_AFTER_STEP

L_STEP:
    !step_eq
    !step_len
    !linear_len
    !len
    !text
    return SA3D_GLTF_ANIMATION_INTERPOLATION_STEP

L_CUBIC_LEN_AFTER_STEP:
    !step_eq
    jmp L_CUBIC_LEN_COMMON

L_CUBIC_LEN:
    jmp L_CUBIC_LEN_COMMON

L_CUBIC_LEN_COMMON:
    cubic_len = eq len, 11
    br cubic_len -> L_CUBIC_CHECK, L_UNSUPPORTED

L_CUBIC_CHECK:
    cubic_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_CUBICSPLINE, 11)
    br cubic_eq -> L_CUBIC, L_UNSUPPORTED_AFTER_CUBIC

L_CUBIC:
    !cubic_eq
    !cubic_len
    !step_len
    !linear_len
    !len
    !text
    return SA3D_GLTF_ANIMATION_INTERPOLATION_CUBIC_SPLINE

L_UNSUPPORTED_AFTER_CUBIC:
    !cubic_eq
    !cubic_len
    !step_len
    !linear_len
    !len
    !text
    return -1

L_UNSUPPORTED:
    !cubic_len
    !step_len
    !linear_len
    !len
    !text
    return -1

@sa3d_gltf_json_animation_path_from_span(text: ptr, len: i64) -> i32:
L_ENTRY:
    translation_len = eq len, 11
    br translation_len -> L_TRANSLATION_CHECK, L_ROTATION_LEN

L_TRANSLATION_CHECK:
    translation_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_TRANSLATION, 11)
    br translation_eq -> L_TRANSLATION, L_ROTATION_LEN_AFTER_TRANSLATION

L_TRANSLATION:
    !translation_eq
    !translation_len
    !len
    !text
    return SA3D_GLTF_ANIMATION_PATH_TRANSLATION

L_ROTATION_LEN_AFTER_TRANSLATION:
    !translation_eq
    jmp L_ROTATION_LEN_COMMON

L_ROTATION_LEN:
    jmp L_ROTATION_LEN_COMMON

L_ROTATION_LEN_COMMON:
    rotation_len = eq len, 8
    br rotation_len -> L_ROTATION_CHECK, L_SCALE_LEN

L_ROTATION_CHECK:
    rotation_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_ROTATION, 8)
    br rotation_eq -> L_ROTATION, L_SCALE_LEN_AFTER_ROTATION

L_ROTATION:
    !rotation_eq
    !rotation_len
    !translation_len
    !len
    !text
    return SA3D_GLTF_ANIMATION_PATH_ROTATION

L_SCALE_LEN_AFTER_ROTATION:
    !rotation_eq
    jmp L_SCALE_LEN_COMMON

L_SCALE_LEN:
    jmp L_SCALE_LEN_COMMON

L_SCALE_LEN_COMMON:
    scale_len = eq len, 5
    br scale_len -> L_SCALE_CHECK, L_WEIGHTS_LEN

L_SCALE_CHECK:
    scale_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_SCALE, 5)
    br scale_eq -> L_SCALE, L_WEIGHTS_LEN_AFTER_SCALE

L_SCALE:
    !scale_eq
    !scale_len
    !rotation_len
    !translation_len
    !len
    !text
    return SA3D_GLTF_ANIMATION_PATH_SCALE

L_WEIGHTS_LEN_AFTER_SCALE:
    !scale_eq
    jmp L_WEIGHTS_LEN_COMMON

L_WEIGHTS_LEN:
    jmp L_WEIGHTS_LEN_COMMON

L_WEIGHTS_LEN_COMMON:
    weights_len = eq len, 7
    br weights_len -> L_WEIGHTS_CHECK, L_UNSUPPORTED

L_WEIGHTS_CHECK:
    weights_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_WEIGHTS, 7)
    br weights_eq -> L_WEIGHTS, L_UNSUPPORTED_AFTER_WEIGHTS

L_WEIGHTS:
    !weights_eq
    !weights_len
    !scale_len
    !rotation_len
    !translation_len
    !len
    !text
    return SA3D_GLTF_ANIMATION_PATH_WEIGHTS

L_UNSUPPORTED_AFTER_WEIGHTS:
    !weights_eq
    !weights_len
    !scale_len
    !rotation_len
    !translation_len
    !len
    !text
    return 0

L_UNSUPPORTED:
    !weights_len
    !scale_len
    !rotation_len
    !translation_len
    !len
    !text
    return 0

@sa3d_gltf_animation_curve_kind(keyframe_count: i64, interpolation: i32) -> i32:
L_ENTRY:
    single = eq keyframe_count, 1
    br single -> L_CONSTANT, L_INTERPOLATION

L_CONSTANT:
    !single
    !interpolation
    !keyframe_count
    return SA3D_GLTF_ANIMATION_CURVE_CONSTANT

L_INTERPOLATION:
    is_step = eq interpolation, SA3D_GLTF_ANIMATION_INTERPOLATION_STEP
    br is_step -> L_STEP, L_CUBIC_CHECK

L_STEP:
    !is_step
    !single
    !interpolation
    !keyframe_count
    return SA3D_GLTF_ANIMATION_CURVE_STEP

L_CUBIC_CHECK:
    is_cubic = eq interpolation, SA3D_GLTF_ANIMATION_INTERPOLATION_CUBIC_SPLINE
    br is_cubic -> L_CUBIC, L_LINEAR

L_CUBIC:
    !is_cubic
    !is_step
    !single
    !interpolation
    !keyframe_count
    return SA3D_GLTF_ANIMATION_CURVE_CUBIC_SPLINE

L_LINEAR:
    !is_cubic
    !is_step
    !single
    !interpolation
    !keyframe_count
    return SA3D_GLTF_ANIMATION_CURVE_LINEAR

@sa3d_gltf_json_animation_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_ANIMATION_TABLE_index, 0 as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_name_ptr, 0 as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_name_len, 0 as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_channel_count, 0 as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_sampler_count, 0 as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_channels_array_pos, -1 as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_samplers_array_pos, -1 as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_animation_sampler_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_input, 0 as i64
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_output, 0 as i64
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_interpolation, SA3D_GLTF_ANIMATION_INTERPOLATION_LINEAR as i32
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_input, 0 as i32
    store out+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_output, 0 as i32
    !out
    return

@sa3d_gltf_json_animation_channel_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_sampler, 0 as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_node, 0 as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_path, 0 as i32
    store out+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_animation_channel_data_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_status, SA3D_GLTF_ANIMATION_READ_STATUS_JSON_ERROR as i32
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_target_node, 0 as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_target_path, 0 as i32
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_interpolation, SA3D_GLTF_ANIMATION_INTERPOLATION_LINEAR as i32
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_curve_kind, 0 as i32
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_keyframe_count, 0 as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_output_component_count, 0 as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_input_len, 0 as i64
    store out+SA3D_GLTF_ANIMATION_CHANNEL_DATA_output_len, 0 as i64
    !out
    return

@sa3d_gltf_json_animation_parse(bytes: ptr, len: i64, animation_index: i64, &out: ptr) -> i32:
L_ENTRY:
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    call @sa3d_gltf_json_animation_table_clear(&out)
    store out+SA3D_GLTF_ANIMATION_TABLE_index, animation_index as i64
    animation_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_ANIMATIONS, 10, animation_index)
    missing = eq animation_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq animation_pos, -2
    br malformed -> L_MALFORMED, L_NAME

L_NAME:
    name_status = call @sa3d_gltf_json_object_string_span(bytes, len, animation_pos, &SA3D_GLTF_JSON_KEY_NAME, 4, &name_ptr_slot, &name_len_slot)
    name_bad = slt name_status, 0
    br name_bad -> L_BAD_NAME, L_NAME_STORE_CHECK

L_NAME_STORE_CHECK:
    name_found = eq name_status, 1
    br name_found -> L_NAME_STORE, L_NAME_SKIP

L_NAME_STORE:
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_name_ptr, name_ptr as ptr
    store out+SA3D_GLTF_ANIMATION_TABLE_name_len, name_len as i64
    !name_len
    !name_ptr
    !name_found
    jmp L_CHANNELS

L_NAME_SKIP:
    !name_found
    jmp L_CHANNELS

L_CHANNELS:
    channels_pos = call @sa3d_gltf_json_object_field_value(bytes, len, animation_pos, &SA3D_GLTF_JSON_KEY_CHANNELS, 8)
    channels_missing = eq channels_pos, -1
    br channels_missing -> L_MISSING_CHANNELS, L_CHANNELS_MALFORMED_CHECK

L_CHANNELS_MALFORMED_CHECK:
    channels_malformed = eq channels_pos, -2
    br channels_malformed -> L_BAD_CHANNELS, L_CHANNELS_COUNT

L_CHANNELS_COUNT:
    channel_count = call @sa3d_gltf_json_count_array_items(bytes, len, channels_pos)
    channel_count_bad = slt channel_count, 0
    br channel_count_bad -> L_BAD_CHANNEL_COUNT, L_SAMPLERS

L_SAMPLERS:
    samplers_pos = call @sa3d_gltf_json_object_field_value(bytes, len, animation_pos, &SA3D_GLTF_JSON_KEY_SAMPLERS, 8)
    samplers_missing = eq samplers_pos, -1
    br samplers_missing -> L_MISSING_SAMPLERS, L_SAMPLERS_MALFORMED_CHECK

L_SAMPLERS_MALFORMED_CHECK:
    samplers_malformed = eq samplers_pos, -2
    br samplers_malformed -> L_BAD_SAMPLERS, L_SAMPLERS_COUNT

L_SAMPLERS_COUNT:
    sampler_count = call @sa3d_gltf_json_count_array_items(bytes, len, samplers_pos)
    sampler_count_bad = slt sampler_count, 0
    br sampler_count_bad -> L_BAD_SAMPLER_COUNT, L_OK

L_OK:
    store out+SA3D_GLTF_ANIMATION_TABLE_channel_count, channel_count as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_sampler_count, sampler_count as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_channels_array_pos, channels_pos as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_samplers_array_pos, samplers_pos as i64
    store out+SA3D_GLTF_ANIMATION_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !sampler_count_bad
    !sampler_count
    !samplers_malformed
    !samplers_missing
    !samplers_pos
    !channel_count_bad
    !channel_count
    !channels_malformed
    !channels_missing
    !channels_pos
    !name_bad
    !name_status
    !malformed
    !missing
    !animation_pos
    !out
    !animation_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_SAMPLER_COUNT:
    store out+SA3D_GLTF_ANIMATION_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !sampler_count_bad
    !sampler_count
    !samplers_malformed
    !samplers_missing
    !samplers_pos
    !channel_count_bad
    !channel_count
    !channels_malformed
    !channels_missing
