@sa3d_gltf_json_array_item_start(bytes: ptr, len: i64, array_pos: i64, item_index: i64) -> i64:
L_ENTRY:
    negative_index = slt item_index, 0
    br negative_index -> L_MISSING_INDEX, L_CHECK_ARRAY

L_CHECK_ARRAY:
    in_bounds = slt array_pos, len
    br in_bounds -> L_ARRAY_LOAD, L_MALFORMED_BOUNDS

L_ARRAY_LOAD:
    array_ptr = ptr_add bytes, array_pos
    array_byte = load array_ptr+0 as u8
    is_array = eq array_byte, 91
    br is_array -> L_FIRST, L_MALFORMED_ARRAY

L_FIRST:
    first0 = add array_pos, 1
    first = call @sa3d_gltf_json_skip_ws_from(bytes, len, first0)
    first_in_bounds = slt first, len
    br first_in_bounds -> L_EMPTY_CHECK, L_MALFORMED_FIRST

L_EMPTY_CHECK:
    first_ptr = ptr_add bytes, first
    first_byte = load first_ptr+0 as u8
    is_empty = eq first_byte, 93
    br is_empty -> L_MISSING_EMPTY, L_TARGET_ZERO

L_TARGET_ZERO:
    is_zero = eq item_index, 0
    br is_zero -> L_RETURN_FIRST, L_LOOP_INIT

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    arr_depth_slot = stack_alloc 8
    obj_depth_slot = stack_alloc 8
    current_slot = stack_alloc 8
    store idx_slot+0, first as i64
    store arr_depth_slot+0, 1 as i64
    store obj_depth_slot+0, 0 as i64
    store current_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_MALFORMED_SCAN_EOF, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    is_quote = eq b, 34
    br is_quote -> L_STRING, L_STRUCTURAL

L_STRING:
    skipped = call @sa3d_gltf_json_skip_string(bytes, len, idx)
    bad_string = slt skipped, 0
    br bad_string -> L_MALFORMED_STRING, L_STORE_STRING

L_STORE_STRING:
