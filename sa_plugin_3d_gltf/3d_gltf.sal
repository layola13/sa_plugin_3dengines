    mask_len = eq len, 4
    br mask_len -> L_MASK_CHECK, L_BLEND_LEN

L_MASK_CHECK:
    mask_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_MASK, 4)
    br mask_eq -> L_MASK, L_BLEND_LEN_AFTER_MASK

L_MASK:
