@sa3d_gltf_asset_desc_init(&desc: ptr) -> void:
L_ENTRY:
    store desc+SA3D_GLTF_ASSET_DESC_source_ptr, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_source_len, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_ptr, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_len, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_format, SA3D_GLTF_FORMAT_JSON as i32
    store desc+SA3D_GLTF_ASSET_DESC_flags, 0 as i32
    !desc
    return

@sa3d_gltf_asset_desc_get_format(&desc: ptr) -> i32:
L_ENTRY:
    fmt = load desc+SA3D_GLTF_ASSET_DESC_format as i32
    !desc
    return fmt

@sa3d_gltf_asset_desc_set_format(&desc: ptr, format: i32) -> void:
L_ENTRY:
    store desc+SA3D_GLTF_ASSET_DESC_format, format as i32
    !format
    !desc
    return

@sa3d_gltf_ptr_len_pair_is_valid(ptr: ptr, len: i64) -> i32:
L_ENTRY:
    nonnegative = sge len, 0
    zero = eq len, 0
    has_ptr = ne ptr, 0
    ptr_ok = or zero, has_ptr
    ok = and nonnegative, ptr_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !ptr_ok
    !has_ptr
    !zero
    !nonnegative
    !len
    !ptr
    return 1

L_FALSE:
    !ok
    !ptr_ok
    !has_ptr
    !zero
    !nonnegative
    !len
    !ptr
    return 0

@sa3d_gltf_asset_desc_set_base_uri(&desc: ptr, base_uri: ptr, len: i64) -> void:
L_ENTRY:
    negative = slt len, 0
    br negative -> L_ZERO, L_SET

L_ZERO:
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_ptr, 0 as i64
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_len, 0 as i64
    !negative
    !len
    !base_uri
    !desc
    return

L_SET:
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_ptr, base_uri as ptr
    store desc+SA3D_GLTF_ASSET_DESC_base_uri_len, len as i64
    !negative
    !len
    !base_uri
    !desc
    return

@sa3d_gltf_format_is_valid(format: i32) -> i32:
L_ENTRY:
    is_json = eq format, SA3D_GLTF_FORMAT_JSON
    is_glb = eq format, SA3D_GLTF_FORMAT_GLB
    ok = or is_json, is_glb
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !is_glb
    !is_json
    !format
    return 1

L_FALSE:
    !ok
    !is_glb
    !is_json
    !format
    return 0

@sa3d_gltf_load_flags_are_valid(flags: i32) -> i32:
L_ENTRY:
    extra = and flags, -32
    ok = eq extra, 0
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !extra
    !flags
    return 1

L_FALSE:
    !ok
    !extra
    !flags
    return 0

@sa3d_gltf_byte_is_ws(byte: u8) -> i32:
L_ENTRY:
    space = eq byte, 32
    tab = eq byte, 9
    lf = eq byte, 10
    cr = eq byte, 13
    a = or space, tab
    b = or lf, cr
    ok = or a, b
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !b
    !a
    !cr
    !lf
    !tab
    !space
    !byte
    return 1

L_FALSE:
    !ok
    !b
    !a
    !cr
    !lf
    !tab
    !space
    !byte
    return 0

@sa3d_gltf_find_first_non_ws(bytes: ptr, len: i64) -> i64:
L_ENTRY:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_CHECK

L_CHECK:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_NONE, L_LOAD

L_LOAD:
    cur_ptr = ptr_add bytes, idx
    byte = load cur_ptr+0 as u8
    is_ws = call @sa3d_gltf_byte_is_ws(byte)
    br is_ws -> L_NEXT, L_FOUND

L_NEXT:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !is_ws
    !byte
    !cur_ptr
    !idx
    !done
    jmp L_CHECK

L_FOUND:
    !is_ws
    !byte
    !cur_ptr
    !done
    !len
    !bytes
    return idx

L_NONE:
    !done
    !idx
    !len
    !bytes
    return -1

@sa3d_gltf_find_last_non_ws(bytes: ptr, len: i64) -> i64:
L_ENTRY:
    idx_slot = stack_alloc 8
    last = sub len, 1
    store idx_slot+0, last as i64
    jmp L_CHECK

L_CHECK:
    idx = load idx_slot+0 as i64
    done = slt idx, 0
    br done -> L_NONE, L_LOAD

L_LOAD:
    cur_ptr = ptr_add bytes, idx
    byte = load cur_ptr+0 as u8
    is_ws = call @sa3d_gltf_byte_is_ws(byte)
    br is_ws -> L_PREV, L_FOUND

L_PREV:
    prev = sub idx, 1
    store idx_slot+0, prev as i64
    !prev
    !is_ws
    !byte
    !cur_ptr
    !idx
    !done
    jmp L_CHECK

L_FOUND:
    !is_ws
    !byte
    !cur_ptr
    !done
    !len
    !bytes
    return idx

L_NONE:
    !done
    !idx
    !len
    !bytes
    return -1

@sa3d_gltf_read_u32_le(bytes: ptr, offset: i64) -> i64:
L_ENTRY:
    base = ptr_add bytes, offset
    b0 = load base+0 as u8
    b1 = load base+1 as u8
    b2 = load base+2 as u8
    b3 = load base+3 as u8
    v0 = zext b0 as i64
    v1z = zext b1 as i64
    v2z = zext b2 as i64
    v3z = zext b3 as i64
    v1 = shl v1z, 8
    v2 = shl v2z, 16
    v3 = shl v3z, 24
    s0 = add v0, v1
    s1 = add v2, v3
    value = add s0, s1
    !base
    !offset
    !bytes
    return value

@sa3d_gltf_read_u16_le(bytes: ptr, offset: i64) -> i64:
L_ENTRY:
    base = ptr_add bytes, offset
    b0 = load base+0 as u8
    b1 = load base+1 as u8
    v0 = zext b0 as i64
    v1z = zext b1 as i64
    v1 = shl v1z, 8
    value = add v0, v1
    !base
    !offset
    !bytes
    return value

@sa3d_gltf_read_i8_as_i32(bytes: ptr, offset: i64) -> i32:
L_ENTRY:
    p = ptr_add bytes, offset
    raw = load p+0 as i8
    value = sext raw as i32
    !raw
    !p
    !offset
    !bytes
    return value

@sa3d_gltf_read_i16_le_as_i32(bytes: ptr, offset: i64) -> i32:
L_ENTRY:
    p = ptr_add bytes, offset
    raw = load p+0 as i16
    value = sext raw as i32
    !raw
    !p
    !offset
    !bytes
    return value

@sa3d_gltf_glb_view_init(&view: ptr) -> void:
L_ENTRY:
    store view+SA3D_GLTF_GLB_VIEW_json_ptr, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_json_len, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_bin_ptr, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_bin_len, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_declared_len, 0 as i64
    store view+SA3D_GLTF_GLB_VIEW_chunk_count, 0 as i32
    store view+SA3D_GLTF_GLB_VIEW_has_bin, 0 as i32
    store view+SA3D_GLTF_GLB_VIEW_status, SA3D_GLTF_GLB_STATUS_MISSING_JSON as i32
    !view
    return

@sa3d_gltf_glb_view_set_status(&view: ptr, status: i32) -> i32:
L_ENTRY:
    store view+SA3D_GLTF_GLB_VIEW_status, status as i32
    !view
    return status

@sa3d_gltf_glb_parse_bytes(bytes: ptr, len: i64, &view: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_glb_view_init(&view)
    has_bytes = ne bytes, 0
    len_min = sge len, 20
    len_align_bits = and len, 3
    len_aligned = eq len_align_bits, 0
    head_a = and has_bytes, len_min
    head_ok = and head_a, len_aligned
    br head_ok -> L_HEADER_FIELDS, L_BAD_HEADER_INIT

L_HEADER_FIELDS:
    magic = call @sa3d_gltf_read_u32_le(bytes, 0)
    version = call @sa3d_gltf_read_u32_le(bytes, 4)
    declared_len = call @sa3d_gltf_read_u32_le(bytes, 8)
    store view+SA3D_GLTF_GLB_VIEW_declared_len, declared_len as i64
    magic_ok = eq magic, SA3D_GLTF_GLB_MAGIC
    version_ok = eq version, 2
    hv = and magic_ok, version_ok
    declared_ok = eq declared_len, len
    br hv -> L_DECLARED_CHECK, L_BAD_HEADER_FIELDS

L_DECLARED_CHECK:
    br declared_ok -> L_LOOP_INIT, L_BAD_DECLARED_LENGTH

L_LOOP_INIT:
    offset_slot = stack_alloc 8
    store offset_slot+0, 12 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    offset = load offset_slot+0 as i64
    done = eq offset, len
    br done -> L_DONE, L_CHUNK_HEADER_CHECK

L_CHUNK_HEADER_CHECK:
    remaining = sub len, offset
    header_ok = sge remaining, 8
    br header_ok -> L_READ_CHUNK, L_CHUNK_OVERFLOW_HEADER

L_READ_CHUNK:
    chunk_len = call @sa3d_gltf_read_u32_le(bytes, offset)
    type_offset = add offset, 4
    chunk_type = call @sa3d_gltf_read_u32_le(bytes, type_offset)
    align_bits = and chunk_len, 3
    align_ok = eq align_bits, 0
    data_start = add offset, 8
    data_end = add data_start, chunk_len
    within = sle data_end, len
    br align_ok -> L_CHUNK_BOUNDS, L_CHUNK_ALIGNMENT

L_CHUNK_BOUNDS:
    br within -> L_CHUNK_KIND, L_CHUNK_OVERFLOW_BOUNDS

L_CHUNK_KIND:
    first = eq offset, 12
    br first -> L_FIRST_CHUNK, L_NON_FIRST_CHUNK

L_FIRST_CHUNK:
    is_json = eq chunk_type, SA3D_GLTF_GLB_CHUNK_TYPE_JSON
    json_nonempty = sgt chunk_len, 0
    json_ok = and is_json, json_nonempty
    br json_ok -> L_STORE_JSON, L_BAD_FIRST_CHUNK

L_STORE_JSON:
    json_ptr = ptr_add bytes, data_start
    store view+SA3D_GLTF_GLB_VIEW_json_ptr, json_ptr as ptr
    store view+SA3D_GLTF_GLB_VIEW_json_len, chunk_len as i64
    store view+SA3D_GLTF_GLB_VIEW_chunk_count, 1 as i32
    store offset_slot+0, data_end as i64
    !json_ptr
    !json_ok
    !json_nonempty
    !is_json
    !first
    !within
    !data_end
    !data_start
    !align_ok
    !align_bits
    !chunk_type
    !type_offset
    !chunk_len
    !header_ok
    !remaining
    !done
    !offset
    jmp L_LOOP_HEAD

L_NON_FIRST_CHUNK:
    is_bin = eq chunk_type, SA3D_GLTF_GLB_CHUNK_TYPE_BIN
    br is_bin -> L_BIN_CHUNK, L_SKIP_CHUNK

L_BIN_CHUNK:
    has_bin = load view+SA3D_GLTF_GLB_VIEW_has_bin as i32
    no_bin = eq has_bin, 0
    br no_bin -> L_STORE_BIN, L_DUPLICATE_BIN

L_STORE_BIN:
    bin_ptr = ptr_add bytes, data_start
    old_count = load view+SA3D_GLTF_GLB_VIEW_chunk_count as i32
    next_count = add old_count, 1
    store view+SA3D_GLTF_GLB_VIEW_bin_ptr, bin_ptr as ptr
    store view+SA3D_GLTF_GLB_VIEW_bin_len, chunk_len as i64
    store view+SA3D_GLTF_GLB_VIEW_has_bin, 1 as i32
    store view+SA3D_GLTF_GLB_VIEW_chunk_count, next_count as i32
    store offset_slot+0, data_end as i64
    !bin_ptr
    !next_count
    !old_count
    !no_bin
    !has_bin
    !is_bin
    !first
    !within
    !data_end
    !data_start
    !align_ok
    !align_bits
    !chunk_type
    !type_offset
    !chunk_len
    !header_ok
    !remaining
    !done
    !offset
    jmp L_LOOP_HEAD

L_SKIP_CHUNK:
    old_count_skip = load view+SA3D_GLTF_GLB_VIEW_chunk_count as i32
    next_count_skip = add old_count_skip, 1
    store view+SA3D_GLTF_GLB_VIEW_chunk_count, next_count_skip as i32
    store offset_slot+0, data_end as i64
    !next_count_skip
    !old_count_skip
    !is_bin
    !first
    !within
    !data_end
    !data_start
    !align_ok
    !align_bits
    !chunk_type
    !type_offset
    !chunk_len
    !header_ok
    !remaining
    !done
    !offset
    jmp L_LOOP_HEAD

L_DONE:
    json_len = load view+SA3D_GLTF_GLB_VIEW_json_len as i64
    has_json = sgt json_len, 0
    br has_json -> L_OK, L_MISSING_JSON

L_OK:
    status_ok = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_OK)
    !has_json
    !json_len
    !done
    !offset
    !view
    !len
    !bytes
    return status_ok

L_BAD_HEADER_INIT:
    status_header = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_BAD_HEADER)
    !view
    !len
    !bytes
    return status_header

L_BAD_HEADER_FIELDS:
    status_header_fields = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_BAD_HEADER)
    !view
    !len
    !bytes
    return status_header_fields

L_BAD_DECLARED_LENGTH:
    status_declared = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_BAD_DECLARED_LENGTH)
    !view
    !len
    !bytes
    return status_declared

L_MISSING_JSON:
    status_missing = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_MISSING_JSON)
    !has_json
    !json_len
    !done
    !offset
    !view
    !len
    !bytes
    return status_missing

L_BAD_FIRST_CHUNK:
    status_first = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_BAD_FIRST_CHUNK)
    !view
    !len
    !bytes
    return status_first

L_CHUNK_OVERFLOW_HEADER:
    status_overflow = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_CHUNK_OVERFLOW)
    !view
    !len
    !bytes
    return status_overflow

L_CHUNK_OVERFLOW_BOUNDS:
    status_overflow_bounds = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_CHUNK_OVERFLOW)
    !view
    !len
    !bytes
    return status_overflow_bounds

L_CHUNK_ALIGNMENT:
    status_alignment = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_CHUNK_ALIGNMENT)
    !view
    !len
    !bytes
    return status_alignment

L_DUPLICATE_BIN:
    status_dup = call @sa3d_gltf_glb_view_set_status(&view, SA3D_GLTF_GLB_STATUS_DUPLICATE_BIN)
    !view
    !len
    !bytes
    return status_dup

@sa3d_gltf_glb_parse_desc(&desc: ptr, &view: ptr) -> i32:
L_ENTRY:
    source = load desc+SA3D_GLTF_ASSET_DESC_source_ptr as ptr
    len = load desc+SA3D_GLTF_ASSET_DESC_source_len as i64
    status = call @sa3d_gltf_glb_parse_bytes(source, len, &view)
    !view
    !desc
    return status

@sa3d_gltf_bytes_eq(lhs: ptr, rhs: ptr, len: i64) -> i32:
L_ENTRY:
    negative = slt len, 0
    br negative -> L_FALSE, L_LOOP_INIT

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = eq idx, len
    br done -> L_TRUE, L_BODY

L_BODY:
    lhs_ip = ptr_add lhs, idx
    rhs_ip = ptr_add rhs, idx
    lhs_byte = load lhs_ip+0 as u8
    rhs_byte = load rhs_ip+0 as u8
    same = eq lhs_byte, rhs_byte
    !rhs_ip
    !lhs_ip
    br same -> L_NEXT, L_FALSE_BODY

L_NEXT:
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !same
    !rhs_byte
    !lhs_byte
    !done
    !idx
    jmp L_HEAD

L_TRUE:
    !done
    !idx
    !negative
    !len
    !rhs
    !lhs
    return 1

L_FALSE_BODY:
    !same
    !rhs_byte
    !lhs_byte
    !done
    !idx
    !negative
    !len
    !rhs
    !lhs
    return 0

L_FALSE:
    !negative
    !len
    !rhs
    !lhs
    return 0

@sa3d_gltf_json_skip_ws_from(bytes: ptr, len: i64, pos: i64) -> i64:
L_ENTRY:
    idx_slot = stack_alloc 8
    store idx_slot+0, pos as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_DONE, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    ws = call @sa3d_gltf_byte_is_ws(b)
    br ws -> L_NEXT, L_DONE_LOAD

L_NEXT:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !ws
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_DONE_LOAD:
    !ws
    !b
    !p
    !done
    !len
    !bytes
    !pos
    return idx

L_DONE:
    !done
    !len
    !bytes
    !pos
    return idx

@sa3d_gltf_json_skip_string(bytes: ptr, len: i64, quote_pos: i64) -> i64:
L_ENTRY:
    idx_slot = stack_alloc 8
    escaped_slot = stack_alloc 4
    start = add quote_pos, 1
    store idx_slot+0, start as i64
    store escaped_slot+0, 0 as i32
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_BAD, L_BODY

L_BODY:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    escaped = load escaped_slot+0 as i32
    br escaped -> L_CLEAR_ESCAPE, L_CHECK_ESCAPE

L_CLEAR_ESCAPE:
    store escaped_slot+0, 0 as i32
    next_e = add idx, 1
    store idx_slot+0, next_e as i64
    !next_e
    !escaped
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_CHECK_ESCAPE:
    is_backslash = eq b, 92
    br is_backslash -> L_SET_ESCAPE, L_CHECK_QUOTE

L_SET_ESCAPE:
    store escaped_slot+0, 1 as i32
    next_bs = add idx, 1
    store idx_slot+0, next_bs as i64
    !next_bs
    !is_backslash
    !escaped
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_CHECK_QUOTE:
    is_quote = eq b, 34
    br is_quote -> L_FOUND, L_NEXT

L_NEXT:
    next = add idx, 1
    store idx_slot+0, next as i64
    !next
    !is_quote
    !is_backslash
    !escaped
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_FOUND:
    out = add idx, 1
    !is_quote
    !is_backslash
    !escaped
    !b
    !p
    !done
    !start
    !quote_pos
    !len
    !bytes
    return out

L_BAD:
    !done
    !start
    !quote_pos
    !len
    !bytes
    return -1

@sa3d_gltf_json_string_key_match(bytes: ptr, len: i64, quote_pos: i64, key: ptr, key_len: i64, &out_end: ptr) -> i32:
L_ENTRY:
    start = add quote_pos, 1
    end = add start, key_len
    in_bounds = slt end, len
    br in_bounds -> L_CHECK_END, L_FALSE_BOUNDS

L_CHECK_END:
    end_ptr = ptr_add bytes, end
    end_byte = load end_ptr+0 as u8
    is_quote = eq end_byte, 34
    br is_quote -> L_COMPARE, L_FALSE_END

L_COMPARE:
    value_ptr = ptr_add bytes, start
    same = call @sa3d_gltf_bytes_eq(value_ptr, key, key_len)
    br same -> L_TRUE, L_FALSE_COMPARE

L_TRUE:
    after = add end, 1
    store out_end+0, after as i64
    !after
    !same
    !value_ptr
    !is_quote
    !end_byte
    !end_ptr
    !in_bounds
    !end
    !start
    !out_end
    !key_len
    !key
    !quote_pos
    !len
    !bytes
    return 1

L_FALSE_COMPARE:
    !same
    !value_ptr
    !is_quote
    !end_byte
    !end_ptr
    !in_bounds
    !end
    !start
    !out_end
    !key_len
    !key
    !quote_pos
    !len
    !bytes
    return 0

L_FALSE_END:
    !is_quote
    !end_byte
    !end_ptr
    !in_bounds
    !end
    !start
    !out_end
    !key_len
    !key
    !quote_pos
    !len
    !bytes
    return 0

L_FALSE_BOUNDS:
    !in_bounds
    !end
    !start
    !out_end
    !key_len
    !key
    !quote_pos
    !len
    !bytes
    return 0

@sa3d_gltf_json_find_root_key_value(bytes: ptr, len: i64, key: ptr, key_len: i64) -> i64:
L_ENTRY:
    first = call @sa3d_gltf_find_first_non_ws(bytes, len)
    has_first = sge first, 0
    br has_first -> L_CHECK_ROOT, L_MALFORMED_EMPTY

L_CHECK_ROOT:
    root_ptr = ptr_add bytes, first
    root_byte = load root_ptr+0 as u8
    is_object = eq root_byte, 123
    br is_object -> L_INIT, L_MALFORMED_ROOT

L_INIT:
    idx_slot = stack_alloc 8
    object_depth_slot = stack_alloc 8
    array_depth_slot = stack_alloc 8
    key_end_slot = stack_alloc 8
    after_root = add first, 1
    store idx_slot+0, after_root as i64
    store object_depth_slot+0, 1 as i64
    store array_depth_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = sge idx, len
    br done -> L_MALFORMED_EOF, L_LOAD

L_LOAD:
    p = ptr_add bytes, idx
    b = load p+0 as u8
    is_quote = eq b, 34
    br is_quote -> L_STRING, L_STRUCTURAL

L_STRING:
    obj_depth = load object_depth_slot+0 as i64
    arr_depth = load array_depth_slot+0 as i64
    at_root_object = eq obj_depth, 1
    no_array = eq arr_depth, 0
    root_key_candidate = and at_root_object, no_array
    br root_key_candidate -> L_TRY_KEY, L_SKIP_STRING

L_TRY_KEY:
    matched = call @sa3d_gltf_json_string_key_match(bytes, len, idx, key, key_len, &key_end_slot)
    br matched -> L_CHECK_COLON, L_SKIP_STRING_MATCHED

L_CHECK_COLON:
    key_end = load key_end_slot+0 as i64
    colon_pos = call @sa3d_gltf_json_skip_ws_from(bytes, len, key_end)
    colon_in_bounds = slt colon_pos, len
    br colon_in_bounds -> L_COLON_LOAD, L_SKIP_STRING_AFTER_MATCH

L_COLON_LOAD:
    colon_ptr = ptr_add bytes, colon_pos
    colon_byte = load colon_ptr+0 as u8
    is_colon = eq colon_byte, 58
    br is_colon -> L_VALUE_POS, L_NOT_PROPERTY

L_VALUE_POS:
    value_start0 = add colon_pos, 1
    value_start = call @sa3d_gltf_json_skip_ws_from(bytes, len, value_start0)
    !value_start0
    !is_colon
    !colon_byte
    !colon_ptr
    !colon_in_bounds
    !colon_pos
    !key_end
    !matched
    !root_key_candidate
    !no_array
    !at_root_object
    !arr_depth
    !obj_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !after_root
    !is_object
    !root_byte
    !root_ptr
    !has_first
    !first
    !key_len
    !key
    !len
    !bytes
    return value_start

L_NOT_PROPERTY:
    skipped_np = call @sa3d_gltf_json_skip_string(bytes, len, idx)
    bad_np = slt skipped_np, 0
    br bad_np -> L_MALFORMED_STRING_NP, L_STORE_SKIPPED_NP

L_STORE_SKIPPED_NP:
    store idx_slot+0, skipped_np as i64
    !bad_np
    !skipped_np
    !is_colon
    !colon_byte
    !colon_ptr
    !colon_in_bounds
    !colon_pos
    !key_end
    !matched
    !root_key_candidate
    !no_array
    !at_root_object
    !arr_depth
    !obj_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_SKIP_STRING_AFTER_MATCH:
    skipped_am = call @sa3d_gltf_json_skip_string(bytes, len, idx)
    bad_am = slt skipped_am, 0
    br bad_am -> L_MALFORMED_STRING_AM, L_STORE_SKIPPED_AM

L_STORE_SKIPPED_AM:
    store idx_slot+0, skipped_am as i64
    !bad_am
    !skipped_am
    !colon_in_bounds
    !colon_pos
    !key_end
    !matched
    !root_key_candidate
    !no_array
    !at_root_object
    !arr_depth
    !obj_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_SKIP_STRING_MATCHED:
    skipped_m = call @sa3d_gltf_json_skip_string(bytes, len, idx)
    bad_m = slt skipped_m, 0
    br bad_m -> L_MALFORMED_STRING_M, L_STORE_SKIPPED_M

L_STORE_SKIPPED_M:
    store idx_slot+0, skipped_m as i64
    !bad_m
    !skipped_m
    !matched
    !root_key_candidate
    !no_array
    !at_root_object
    !arr_depth
    !obj_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_SKIP_STRING:
    skipped = call @sa3d_gltf_json_skip_string(bytes, len, idx)
    bad_skip = slt skipped, 0
    br bad_skip -> L_MALFORMED_STRING, L_STORE_SKIPPED

L_STORE_SKIPPED:
    store idx_slot+0, skipped as i64
    !bad_skip
    !skipped
    !root_key_candidate
    !no_array
    !at_root_object
    !arr_depth
    !obj_depth
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_STRUCTURAL:
    obj_depth2 = load object_depth_slot+0 as i64
    arr_depth2 = load array_depth_slot+0 as i64
    is_obj_open = eq b, 123
    br is_obj_open -> L_OBJ_OPEN, L_OBJ_CLOSE_CHECK

L_OBJ_OPEN:
    obj_next = add obj_depth2, 1
    idx_next_obj = add idx, 1
    store object_depth_slot+0, obj_next as i64
    store idx_slot+0, idx_next_obj as i64
    !idx_next_obj
    !obj_next
    !is_obj_open
    !arr_depth2
    !obj_depth2
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OBJ_CLOSE_CHECK:
    is_obj_close = eq b, 125
    br is_obj_close -> L_OBJ_CLOSE, L_ARR_OPEN_CHECK

L_OBJ_CLOSE:
    obj_prev = sub obj_depth2, 1
    closed_root = eq obj_prev, 0
    br closed_root -> L_MISSING, L_OBJ_CLOSE_STORE

L_OBJ_CLOSE_STORE:
    idx_next_oc = add idx, 1
    store object_depth_slot+0, obj_prev as i64
    store idx_slot+0, idx_next_oc as i64
    !idx_next_oc
    !closed_root
    !obj_prev
    !is_obj_close
    !is_obj_open
    !arr_depth2
    !obj_depth2
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_ARR_OPEN_CHECK:
    is_arr_open = eq b, 91
    br is_arr_open -> L_ARR_OPEN, L_ARR_CLOSE_CHECK

L_ARR_OPEN:
    arr_next = add arr_depth2, 1
    idx_next_ao = add idx, 1
    store array_depth_slot+0, arr_next as i64
    store idx_slot+0, idx_next_ao as i64
    !idx_next_ao
    !arr_next
    !is_arr_open
    !is_obj_close
    !is_obj_open
    !arr_depth2
    !obj_depth2
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_ARR_CLOSE_CHECK:
    is_arr_close = eq b, 93
    br is_arr_close -> L_ARR_CLOSE, L_OTHER

L_ARR_CLOSE:
    arr_prev = sub arr_depth2, 1
    idx_next_ac = add idx, 1
    store array_depth_slot+0, arr_prev as i64
    store idx_slot+0, idx_next_ac as i64
    !idx_next_ac
    !arr_prev
    !is_arr_close
    !is_arr_open
    !is_obj_close
    !is_obj_open
    !arr_depth2
    !obj_depth2
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_OTHER:
    idx_next = add idx, 1
    store idx_slot+0, idx_next as i64
    !idx_next
    !is_arr_close
    !is_arr_open
    !is_obj_close
    !is_obj_open
    !arr_depth2
    !obj_depth2
    !is_quote
    !b
    !p
    !done
    !idx
    jmp L_HEAD

L_MISSING:
    !closed_root
    !obj_prev
    !is_obj_close
    !is_obj_open
    !arr_depth2
    !obj_depth2
    !is_quote
    !b
    !p
    !done
    !idx
    !after_root
    !is_object
    !root_byte
    !root_ptr
    !has_first
    !first
    !key_len
    !key
    !len
    !bytes
    return -1

L_MALFORMED_STRING_NP:
    !bad_np
    !skipped_np
    !is_colon
    !colon_byte
    !colon_ptr
    !colon_in_bounds
    !colon_pos
    !key_end
    !matched
    !root_key_candidate
    !no_array
    !at_root_object
    !arr_depth
    !obj_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !after_root
    !is_object
    !root_byte
    !root_ptr
    !has_first
    !first
    !key_len
    !key
    !len
    !bytes
    return -2

L_MALFORMED_STRING_AM:
    !bad_am
    !skipped_am
    !colon_in_bounds
    !colon_pos
    !key_end
    !matched
    !root_key_candidate
    !no_array
    !at_root_object
    !arr_depth
    !obj_depth
    !is_quote
    !b
    !p
    !done
    !idx
    !after_root
    !is_object
    !root_byte
    !root_ptr
    !has_first
    !first
    !key_len
