@sa3d_gltf_json_node_store_light(bytes: ptr, len: i64, node_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    light_slot = stack_alloc 8
    extensions_pos = call @sa3d_gltf_json_object_field_value(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_EXTENSIONS, 10)
    extensions_missing = eq extensions_pos, -1
    br extensions_missing -> L_OK_MISSING_EXTENSIONS, L_EXTENSIONS_MALFORMED_CHECK

L_EXTENSIONS_MALFORMED_CHECK:
    extensions_malformed = eq extensions_pos, -2
    br extensions_malformed -> L_BAD_EXTENSIONS, L_KHR

L_KHR:
    khr_pos = call @sa3d_gltf_json_object_field_value(bytes, len, extensions_pos, &SA3D_GLTF_JSON_KEY_KHR_LIGHTS_PUNCTUAL, 19)
    khr_missing = eq khr_pos, -1
    br khr_missing -> L_OK_MISSING_KHR, L_KHR_MALFORMED_CHECK

L_KHR_MALFORMED_CHECK:
    khr_malformed = eq khr_pos, -2
    br khr_malformed -> L_BAD_KHR, L_LIGHT

L_LIGHT:
    status = call @sa3d_gltf_json_object_i64_value(bytes, len, khr_pos, &SA3D_GLTF_JSON_KEY_LIGHT, 5, &light_slot)
    missing = eq status, 0
    br missing -> L_MISSING_LIGHT, L_STATUS_BAD_CHECK

L_STATUS_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD_LIGHT, L_STORE

L_STORE:
    light = load light_slot+0 as i64
    store out+SA3D_GLTF_NODE_TABLE_has_light, 1 as i32
    store out+SA3D_GLTF_NODE_TABLE_light, light as i64
    !light
    !bad
    !missing
    !status
    !khr_malformed
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING_KHR:
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING_EXTENSIONS:
    !extensions_missing
    !extensions_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_MISSING_LIGHT:
    !missing
    !status
    !khr_malformed
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_BAD_LIGHT:
    !bad
    !missing
    !status
    !khr_malformed
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_KHR:
    !khr_malformed
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_EXTENSIONS:
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_node_store_extras(bytes: ptr, len: i64, node_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    ptr_slot = stack_alloc 8
    len_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_value_span(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_EXTRAS, 6, &ptr_slot, &len_slot)
    bad = slt status, 0
    br bad -> L_BAD, L_FOUND_CHECK

L_FOUND_CHECK:
    found = eq status, 1
    br found -> L_STORE, L_OK_MISSING

L_STORE:
    extras_ptr = load ptr_slot+0 as ptr
    extras_len = load len_slot+0 as i64
    store out+SA3D_GLTF_NODE_TABLE_has_extras, 1 as i32
    store out+SA3D_GLTF_NODE_TABLE_extras_ptr, extras_ptr as ptr
    store out+SA3D_GLTF_NODE_TABLE_extras_len, extras_len as i64
    !extras_len
    !extras_ptr
    !found
    !bad
    !status
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !found
    !bad
    !status
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !status
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_node_store_transform(bytes: ptr, len: i64, node_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    transform = ptr_add out, SA3D_GLTF_NODE_TABLE_transform
    matrix_pos = call @sa3d_gltf_json_object_field_value(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_MATRIX, 6)
    matrix_malformed = eq matrix_pos, -2
    br matrix_malformed -> L_BAD_MATRIX, L_MATRIX_MISSING_CHECK

L_MATRIX_MISSING_CHECK:
    matrix_missing = eq matrix_pos, -1
    br matrix_missing -> L_TRANSLATION, L_MATRIX_PARSE

L_MATRIX_PARSE:
    matrix_mat = alloc SA3D_MAT4_SIZE
    parsed_matrix = call @sa3d_gltf_json_parse_signed_f32_array16_mat4(bytes, len, matrix_pos, &matrix_mat)
    matrix_ok = ne parsed_matrix, 0
    br matrix_ok -> L_MATRIX_STORE, L_BAD_MATRIX_VALUE

L_MATRIX_STORE:
    call @sa3d_transform3d_from_matrix(&transform, &matrix_mat)
    !matrix_ok
    !parsed_matrix
    !matrix_mat
    !matrix_missing
    !matrix_malformed
    !matrix_pos
    !transform
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_TRANSLATION:
    tx_slot = stack_alloc 4
    ty_slot = stack_alloc 4
    tz_slot = stack_alloc 4
    t_status = call @sa3d_gltf_json_object_signed_f32_array3_value(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_TRANSLATION, 11, &tx_slot, &ty_slot, &tz_slot)
    t_bad = slt t_status, 0
    br t_bad -> L_BAD_TRANSLATION, L_TRANSLATION_STORE_CHECK

L_TRANSLATION_STORE_CHECK:
    t_found = eq t_status, 1
    br t_found -> L_TRANSLATION_STORE, L_TRANSLATION_SKIP

L_TRANSLATION_STORE:
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    tx = load tx_slot+0 as i32
    ty = load ty_slot+0 as i32
    tz = load tz_slot+0 as i32
    store translation+SA3D_VEC3_x, tx as i32
    store translation+SA3D_VEC3_y, ty as i32
    store translation+SA3D_VEC3_z, tz as i32
    !tz
    !ty
    !tx
    !translation
    !t_found
    jmp L_ROTATION

L_TRANSLATION_SKIP:
    !t_found
    jmp L_ROTATION

L_ROTATION:
    rx_slot = stack_alloc 4
    ry_slot = stack_alloc 4
    rz_slot = stack_alloc 4
    rw_slot = stack_alloc 4
    r_status = call @sa3d_gltf_json_object_signed_f32_array4_value(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_ROTATION, 8, &rx_slot, &ry_slot, &rz_slot, &rw_slot)
    r_bad = slt r_status, 0
    br r_bad -> L_BAD_ROTATION, L_ROTATION_STORE_CHECK

L_ROTATION_STORE_CHECK:
    r_found = eq r_status, 1
    br r_found -> L_ROTATION_STORE, L_ROTATION_SKIP

L_ROTATION_STORE:
    rotation = ptr_add transform, SA3D_TRANSFORM3D_rotation
    rx = load rx_slot+0 as i32
    ry = load ry_slot+0 as i32
    rz = load rz_slot+0 as i32
    rw = load rw_slot+0 as i32
    store rotation+SA3D_QUAT_x, rx as i32
    store rotation+SA3D_QUAT_y, ry as i32
    store rotation+SA3D_QUAT_z, rz as i32
    store rotation+SA3D_QUAT_w, rw as i32
    !rw
    !rz
    !ry
    !rx
    !rotation
    !r_found
    jmp L_SCALE

L_ROTATION_SKIP:
    !r_found
    jmp L_SCALE

L_SCALE:
    sx_slot = stack_alloc 4
    sy_slot = stack_alloc 4
    sz_slot = stack_alloc 4
    s_status = call @sa3d_gltf_json_object_signed_f32_array3_value(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_SCALE, 5, &sx_slot, &sy_slot, &sz_slot)
    s_bad = slt s_status, 0
    br s_bad -> L_BAD_SCALE, L_SCALE_STORE_CHECK

L_SCALE_STORE_CHECK:
    s_found = eq s_status, 1
    br s_found -> L_SCALE_STORE, L_SCALE_SKIP

L_SCALE_STORE:
    scale = ptr_add transform, SA3D_TRANSFORM3D_scale
    sx = load sx_slot+0 as i32
    sy = load sy_slot+0 as i32
    sz = load sz_slot+0 as i32
    store scale+SA3D_VEC3_x, sx as i32
    store scale+SA3D_VEC3_y, sy as i32
    store scale+SA3D_VEC3_z, sz as i32
    !sz
    !sy
    !sx
    !scale
    !s_found
    jmp L_OK

L_SCALE_SKIP:
    !s_found
    jmp L_OK

L_OK:
    !s_bad
    !s_status
    !r_bad
    !r_status
    !t_bad
    !t_status
    !matrix_missing
    !matrix_malformed
    !matrix_pos
    !transform
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_SCALE:
    !s_bad
    !s_status
    !r_bad
    !r_status
    !t_bad
    !t_status
    !matrix_missing
    !matrix_malformed
    !matrix_pos
    !transform
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_ROTATION:
    !r_bad
    !r_status
    !t_bad
    !t_status
    !matrix_missing
    !matrix_malformed
    !matrix_pos
    !transform
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_TRANSLATION:
    !t_bad
    !t_status
    !matrix_missing
    !matrix_malformed
    !matrix_pos
    !transform
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MATRIX_VALUE:
    !matrix_ok
    !parsed_matrix
    !matrix_mat
    !matrix_missing
    !matrix_malformed
    !matrix_pos
    !transform
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_BAD_MATRIX:
    !matrix_malformed
    !matrix_pos
    !transform
    !out
    !node_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_node_parse(bytes: ptr, len: i64, node_index: i64, &out: ptr) -> i32:
L_ENTRY:
    call @sa3d_gltf_json_node_table_clear(&out)
    store out+SA3D_GLTF_NODE_TABLE_index, node_index as i64
    node_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_NODES, 5, node_index)
    missing = eq node_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq node_pos, -2
    br malformed -> L_MALFORMED, L_NAME

L_NAME:
    name_status = call @sa3d_gltf_json_node_store_name(bytes, len, node_pos, &out)
    name_ok = eq name_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br name_ok -> L_CHILDREN, L_RETURN_NAME_STATUS

L_CHILDREN:
    children_status = call @sa3d_gltf_json_node_store_children(bytes, len, node_pos, &out)
    children_ok = eq children_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br children_ok -> L_MESH, L_RETURN_CHILDREN_STATUS

L_MESH:
    mesh_status = call @sa3d_gltf_json_node_store_mesh(bytes, len, node_pos, &out)
    mesh_ok = eq mesh_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br mesh_ok -> L_SKIN, L_RETURN_MESH_STATUS

L_SKIN:
    skin_status = call @sa3d_gltf_json_node_store_skin(bytes, len, node_pos, &out)
    skin_ok = eq skin_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br skin_ok -> L_WEIGHTS, L_RETURN_SKIN_STATUS

L_WEIGHTS:
    weight_status = call @sa3d_gltf_json_node_store_weights(bytes, len, node_pos, &out)
    weight_ok = eq weight_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br weight_ok -> L_CAMERA, L_RETURN_WEIGHTS_STATUS

L_CAMERA:
    camera_status = call @sa3d_gltf_json_node_store_camera(bytes, len, node_pos, &out)
    camera_ok = eq camera_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br camera_ok -> L_LIGHT, L_RETURN_CAMERA_STATUS

L_LIGHT:
    light_status = call @sa3d_gltf_json_node_store_light(bytes, len, node_pos, &out)
    light_ok = eq light_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br light_ok -> L_TRANSFORM, L_RETURN_LIGHT_STATUS

L_TRANSFORM:
    transform_status = call @sa3d_gltf_json_node_store_transform(bytes, len, node_pos, &out)
    transform_ok = eq transform_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br transform_ok -> L_EXTRAS, L_RETURN_TRANSFORM_STATUS

L_EXTRAS:
    extras_status = call @sa3d_gltf_json_node_store_extras(bytes, len, node_pos, &out)
    extras_ok = eq extras_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br extras_ok -> L_OK, L_RETURN_EXTRAS_STATUS

L_OK:
    store out+SA3D_GLTF_NODE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !extras_ok
    !extras_status
    !transform_ok
    !transform_status
    !light_ok
    !light_status
    !camera_ok
    !camera_status
    !weight_ok
    !weight_status
    !skin_ok
    !skin_status
    !mesh_ok
    !mesh_status
    !children_ok
    !children_status
    !name_ok
    !name_status
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_EXTRAS_STATUS:
    store out+SA3D_GLTF_NODE_TABLE_status, extras_status as i32
    !extras_ok
    !transform_ok
    !transform_status
    !light_ok
    !light_status
    !camera_ok
    !camera_status
    !weight_ok
    !weight_status
    !skin_ok
    !skin_status
    !mesh_ok
    !mesh_status
    !children_ok
    !children_status
    !name_ok
    !name_status
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return extras_status

L_RETURN_TRANSFORM_STATUS:
    store out+SA3D_GLTF_NODE_TABLE_status, transform_status as i32
    !transform_ok
    !light_ok
    !light_status
    !camera_ok
    !camera_status
    !weight_ok
    !weight_status
    !skin_ok
    !skin_status
    !mesh_ok
    !mesh_status
    !children_ok
    !children_status
    !name_ok
    !name_status
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return transform_status

L_RETURN_LIGHT_STATUS:
    store out+SA3D_GLTF_NODE_TABLE_status, light_status as i32
    !light_ok
    !camera_ok
    !camera_status
    !weight_ok
    !weight_status
    !skin_ok
    !skin_status
    !mesh_ok
    !mesh_status
    !children_ok
    !children_status
    !name_ok
    !name_status
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return light_status

L_RETURN_CAMERA_STATUS:
    store out+SA3D_GLTF_NODE_TABLE_status, camera_status as i32
    !camera_ok
    !weight_ok
    !weight_status
    !skin_ok
    !skin_status
    !mesh_ok
    !mesh_status
    !children_ok
    !children_status
    !name_ok
    !name_status
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return camera_status

L_RETURN_WEIGHTS_STATUS:
    store out+SA3D_GLTF_NODE_TABLE_status, weight_status as i32
    !weight_ok
    !skin_ok
    !skin_status
    !mesh_ok
    !mesh_status
    !children_ok
    !children_status
    !name_ok
    !name_status
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return weight_status

L_RETURN_SKIN_STATUS:
    store out+SA3D_GLTF_NODE_TABLE_status, skin_status as i32
    !skin_ok
    !mesh_ok
    !mesh_status
    !children_ok
    !children_status
    !name_ok
    !name_status
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return skin_status

L_RETURN_MESH_STATUS:
    store out+SA3D_GLTF_NODE_TABLE_status, mesh_status as i32
    !mesh_ok
    !children_ok
    !children_status
    !name_ok
    !name_status
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return mesh_status

L_RETURN_CHILDREN_STATUS:
    store out+SA3D_GLTF_NODE_TABLE_status, children_status as i32
    !children_ok
    !name_ok
    !name_status
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return children_status

L_RETURN_NAME_STATUS:
    store out+SA3D_GLTF_NODE_TABLE_status, name_status as i32
    !name_ok
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return name_status

L_MISSING:
    store out+SA3D_GLTF_NODE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_NODE_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !node_pos
    !out
    !node_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_node_children_array_pos(bytes: ptr, len: i64, node_index: i64) -> i64:
L_ENTRY:
    node_pos = call @sa3d_gltf_json_root_array_item_start(bytes, len, &SA3D_GLTF_JSON_KEY_NODES, 5, node_index)
    missing = eq node_pos, -1
    br missing -> L_MISSING_NODE, L_MALFORMED_NODE_CHECK

L_MALFORMED_NODE_CHECK:
    malformed = eq node_pos, -2
    br malformed -> L_MALFORMED_NODE, L_CHILDREN

L_CHILDREN:
    children_pos = call @sa3d_gltf_json_object_field_value(bytes, len, node_pos, &SA3D_GLTF_JSON_KEY_CHILDREN, 8)
    !malformed
    !missing
    !node_pos
    !node_index
    !len
    !bytes
    return children_pos

L_MISSING_NODE:
    !missing
    !node_pos
    !node_index
    !len
    !bytes
    return -1

L_MALFORMED_NODE:
    !malformed
    !missing
    !node_pos
    !node_index
    !len
    !bytes
    return -2

@sa3d_gltf_json_table_store_required_f32_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out: ptr, value_offset: i64) -> i32:
L_ENTRY:
    value_slot = stack_alloc 4
    status = call @sa3d_gltf_json_object_f32_bits_value(bytes, len, object_pos, key, key_len, &value_slot)
    found = eq status, 1
    br found -> L_STORE, L_BAD_CHECK

L_STORE:
    value = load value_slot+0 as i32
    dst = ptr_add out, value_offset
    store dst+0, value as i32
    !dst
    !value
    !found
    !status
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_MISSING

L_MISSING:
    !bad
    !found
    !status
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_BAD:
    !bad
    !found
    !status
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_table_store_optional_f32_field(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out: ptr, value_offset: i64, has_offset: i64) -> i32:
L_ENTRY:
    value_slot = stack_alloc 4
    status = call @sa3d_gltf_json_object_f32_bits_value(bytes, len, object_pos, key, key_len, &value_slot)
    found = eq status, 1
    br found -> L_STORE, L_BAD_CHECK

L_STORE:
    value = load value_slot+0 as i32
    dst = ptr_add out, value_offset
    has = ptr_add out, has_offset
    store dst+0, value as i32
    store has+0, 1 as i32
    !has
    !dst
    !value
    !found
    !status
    !has_offset
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_OK_MISSING

L_OK_MISSING:
    !bad
    !found
    !status
    !has_offset
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !found
    !status
    !has_offset
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_table_store_optional_f32_value(bytes: ptr, len: i64, object_pos: i64, key: ptr, key_len: i64, &out: ptr, value_offset: i64) -> i32:
L_ENTRY:
    value_slot = stack_alloc 4
    status = call @sa3d_gltf_json_object_f32_bits_value(bytes, len, object_pos, key, key_len, &value_slot)
    found = eq status, 1
    br found -> L_STORE, L_BAD_CHECK

L_STORE:
    value = load value_slot+0 as i32
    dst = ptr_add out, value_offset
    store dst+0, value as i32
    !dst
    !value
    !found
    !status
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD_CHECK:
    bad = slt status, 0
    br bad -> L_BAD, L_OK_MISSING

L_OK_MISSING:
    !bad
    !found
    !status
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !found
    !status
    !value_offset
    !out
    !key_len
    !key
    !object_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_khr_light_root_array_item_start(bytes: ptr, len: i64, light_index: i64) -> i64:
L_ENTRY:
    extensions_pos = call @sa3d_gltf_json_find_root_key_value(bytes, len, &SA3D_GLTF_JSON_KEY_EXTENSIONS, 10)
    extensions_missing = eq extensions_pos, -1
    br extensions_missing -> L_MISSING, L_EXTENSIONS_MALFORMED_CHECK

L_EXTENSIONS_MALFORMED_CHECK:
    extensions_malformed = eq extensions_pos, -2
    br extensions_malformed -> L_MALFORMED_EXTENSIONS, L_KHR

L_KHR:
    khr_pos = call @sa3d_gltf_json_object_field_value(bytes, len, extensions_pos, &SA3D_GLTF_JSON_KEY_KHR_LIGHTS_PUNCTUAL, 19)
    khr_missing = eq khr_pos, -1
    br khr_missing -> L_MISSING_KHR, L_KHR_MALFORMED_CHECK

L_KHR_MALFORMED_CHECK:
    khr_malformed = eq khr_pos, -2
    br khr_malformed -> L_MALFORMED_KHR, L_LIGHTS

L_LIGHTS:
    lights_pos = call @sa3d_gltf_json_object_field_value(bytes, len, khr_pos, &SA3D_GLTF_JSON_KEY_LIGHTS, 6)
    lights_missing = eq lights_pos, -1
    br lights_missing -> L_MALFORMED_MISSING_LIGHTS, L_LIGHTS_MALFORMED_CHECK

L_LIGHTS_MALFORMED_CHECK:
    lights_malformed = eq lights_pos, -2
    br lights_malformed -> L_MALFORMED_LIGHTS, L_ITEM

L_ITEM:
    item_pos = call @sa3d_gltf_json_array_item_start(bytes, len, lights_pos, light_index)
    !lights_malformed
    !lights_missing
    !lights_pos
    !khr_malformed
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !light_index
    !len
    !bytes
    return item_pos

L_MALFORMED_LIGHTS:
    !lights_malformed
    !lights_missing
    !lights_pos
    !khr_malformed
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !light_index
    !len
    !bytes
    return -2

L_MALFORMED_MISSING_LIGHTS:
    !lights_missing
    !lights_pos
    !khr_malformed
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !light_index
    !len
    !bytes
    return -2

L_MALFORMED_KHR:
    !khr_malformed
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !light_index
    !len
    !bytes
    return -2

L_MISSING_KHR:
    !khr_missing
    !khr_pos
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !light_index
    !len
    !bytes
    return -1

L_MALFORMED_EXTENSIONS:
    !extensions_malformed
    !extensions_missing
    !extensions_pos
    !light_index
    !len
    !bytes
    return -2

L_MISSING:
    !extensions_missing
    !extensions_pos
    !light_index
    !len
    !bytes
    return -1

@sa3d_gltf_json_light_kind_from_span(text: ptr, len: i64) -> i32:
L_ENTRY:
    directional_len = eq len, 11
    br directional_len -> L_DIRECTIONAL_CHECK, L_POINT_LEN

L_DIRECTIONAL_CHECK:
    directional_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_DIRECTIONAL, 11)
    br directional_eq -> L_DIRECTIONAL, L_POINT_LEN_AFTER_DIRECTIONAL

L_DIRECTIONAL:
    !directional_eq
    !directional_len
    !len
    !text
    return SA3D_GLTF_LIGHT_KIND_DIRECTIONAL

L_POINT_LEN_AFTER_DIRECTIONAL:
    !directional_eq
    jmp L_POINT_LEN_COMMON

L_POINT_LEN:
    jmp L_POINT_LEN_COMMON

L_POINT_LEN_COMMON:
    point_len = eq len, 5
    br point_len -> L_POINT_CHECK, L_SPOT_LEN

L_POINT_CHECK:
    point_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_POINT, 5)
    br point_eq -> L_POINT, L_SPOT_LEN_AFTER_POINT

L_POINT:
    !point_eq
    !point_len
    !directional_len
    !len
    !text
    return SA3D_GLTF_LIGHT_KIND_POINT

L_SPOT_LEN_AFTER_POINT:
    !point_eq
    jmp L_SPOT_LEN_COMMON

L_SPOT_LEN:
    jmp L_SPOT_LEN_COMMON

L_SPOT_LEN_COMMON:
    spot_len = eq len, 4
    br spot_len -> L_SPOT_CHECK, L_UNSUPPORTED

L_SPOT_CHECK:
    spot_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_SPOT, 4)
    br spot_eq -> L_SPOT, L_UNSUPPORTED_AFTER_SPOT

L_SPOT:
    !spot_eq
    !spot_len
    !point_len
    !directional_len
    !len
    !text
    return SA3D_GLTF_LIGHT_KIND_SPOT

L_UNSUPPORTED_AFTER_SPOT:
    !spot_eq
    !spot_len
    !point_len
    !directional_len
    !len
    !text
    return 0

L_UNSUPPORTED:
    !spot_len
    !point_len
    !directional_len
    !len
    !text
    return 0

@sa3d_gltf_light_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_LIGHT_TABLE_index, 0 as i64
    store out+SA3D_GLTF_LIGHT_TABLE_name_ptr, 0 as i64
    store out+SA3D_GLTF_LIGHT_TABLE_name_len, 0 as i64
    store out+SA3D_GLTF_LIGHT_TABLE_kind, 0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_color_r, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_LIGHT_TABLE_color_g, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_LIGHT_TABLE_color_b, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_LIGHT_TABLE_intensity, SA3D_F32_ONE_BITS as i32
    store out+SA3D_GLTF_LIGHT_TABLE_has_range, 0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_range, 0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_inner_cone_angle, 0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_outer_cone_angle, SA3D_GLTF_LIGHT_DEFAULT_OUTER_CONE_BITS as i32
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_intensity, 0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_range, 0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_radius, 0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_has_extras, 0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_extras_ptr, 0 as i64
    store out+SA3D_GLTF_LIGHT_TABLE_extras_len, 0 as i64
    store out+SA3D_GLTF_LIGHT_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_light_store_name(bytes: ptr, len: i64, light_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    ptr_slot = stack_alloc 8
    len_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_string_span(bytes, len, light_pos, &SA3D_GLTF_JSON_KEY_NAME, 4, &ptr_slot, &len_slot)
    bad = slt status, 0
    br bad -> L_BAD, L_FOUND_CHECK

L_FOUND_CHECK:
    found = eq status, 1
    br found -> L_STORE, L_OK_MISSING

L_STORE:
    name_ptr = load ptr_slot+0 as ptr
    name_len = load len_slot+0 as i64
    store out+SA3D_GLTF_LIGHT_TABLE_name_ptr, name_ptr as ptr
    store out+SA3D_GLTF_LIGHT_TABLE_name_len, name_len as i64
    !name_len
    !name_ptr
    !found
    !bad
    !status
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !found
    !bad
    !status
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !status
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_light_store_extras(bytes: ptr, len: i64, light_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    ptr_slot = stack_alloc 8
    len_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_value_span(bytes, len, light_pos, &SA3D_GLTF_JSON_KEY_EXTRAS, 6, &ptr_slot, &len_slot)
    bad = slt status, 0
    br bad -> L_BAD, L_FOUND_CHECK

L_FOUND_CHECK:
    found = eq status, 1
    br found -> L_STORE, L_OK_MISSING

L_STORE:
    extras_ptr = load ptr_slot+0 as ptr
    extras_len = load len_slot+0 as i64
    store out+SA3D_GLTF_LIGHT_TABLE_has_extras, 1 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_extras_ptr, extras_ptr as ptr
    store out+SA3D_GLTF_LIGHT_TABLE_extras_len, extras_len as i64
    !extras_len
    !extras_ptr
    !found
    !bad
    !status
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !found
    !bad
    !status
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !status
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_light_store_color(bytes: ptr, len: i64, light_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    r_slot = stack_alloc 4
    g_slot = stack_alloc 4
    b_slot = stack_alloc 4
    status = call @sa3d_gltf_json_object_f32_array3_value(bytes, len, light_pos, &SA3D_GLTF_JSON_KEY_COLOR, 5, &r_slot, &g_slot, &b_slot)
    bad = slt status, 0
    br bad -> L_BAD, L_FOUND_CHECK

L_FOUND_CHECK:
    found = eq status, 1
    br found -> L_STORE, L_OK_MISSING

L_STORE:
    r = load r_slot+0 as i32
    g = load g_slot+0 as i32
    b = load b_slot+0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_color_r, r as i32
    store out+SA3D_GLTF_LIGHT_TABLE_color_g, g as i32
    store out+SA3D_GLTF_LIGHT_TABLE_color_b, b as i32
    !b
    !g
    !r
    !found
    !bad
    !status
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !found
    !bad
    !status
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !status
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_light_update_bevy_fields(&out: ptr) -> void:
L_ENTRY:
    kind = load out+SA3D_GLTF_LIGHT_TABLE_kind as i32
    intensity_bits = load out+SA3D_GLTF_LIGHT_TABLE_intensity as i32
    is_directional = eq kind, SA3D_GLTF_LIGHT_KIND_DIRECTIONAL
    br is_directional -> L_DIRECTIONAL, L_POINT_OR_SPOT

L_DIRECTIONAL:
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_intensity, intensity_bits as i32
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_range, 0 as i32
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_radius, 0 as i32
    !is_directional
    !intensity_bits
    !kind
    !out
    return

L_POINT_OR_SPOT:
    scale_slot = stack_alloc 4
    store scale_slot+0, SA3D_GLTF_LIGHT_BEVY_INTENSITY_SCALE_BITS as i32
    intensity = load out+SA3D_GLTF_LIGHT_TABLE_intensity as f32
    scale = load scale_slot+0 as f32
    bevy_intensity = fmul intensity, scale
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_intensity, bevy_intensity as f32
    has_range = load out+SA3D_GLTF_LIGHT_TABLE_has_range as i32
    has_range_bool = ne has_range, 0
    br has_range_bool -> L_RANGE_PRESENT, L_RANGE_DEFAULT

L_RANGE_PRESENT:
    range_bits = load out+SA3D_GLTF_LIGHT_TABLE_range as i32
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_range, range_bits as i32
    !range_bits
    jmp L_RADIUS

L_RANGE_DEFAULT:
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_range, SA3D_GLTF_LIGHT_BEVY_DEFAULT_RANGE_BITS as i32
    jmp L_RADIUS

L_RADIUS:
    is_spot = eq kind, SA3D_GLTF_LIGHT_KIND_SPOT
    radius_bits = load out+SA3D_GLTF_LIGHT_TABLE_range as i32
    spot_radius_ok = and is_spot, has_range_bool
    br spot_radius_ok -> L_SPOT_RADIUS, L_ZERO_RADIUS

L_SPOT_RADIUS:
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_radius, radius_bits as i32
    !spot_radius_ok
    !radius_bits
    !is_spot
    !has_range_bool
    !has_range
    !bevy_intensity
    !scale
    !intensity
    !is_directional
    !intensity_bits
    !kind
    !out
    return

L_ZERO_RADIUS:
    store out+SA3D_GLTF_LIGHT_TABLE_bevy_radius, 0 as i32
    !spot_radius_ok
    !radius_bits
    !is_spot
    !has_range_bool
    !has_range
    !bevy_intensity
    !scale
    !intensity
    !is_directional
    !intensity_bits
    !kind
    !out
    return

@sa3d_gltf_json_light_parse_spot(bytes: ptr, len: i64, light_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    spot_pos = call @sa3d_gltf_json_object_field_value(bytes, len, light_pos, &SA3D_GLTF_JSON_KEY_SPOT, 4)
    missing = eq spot_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq spot_pos, -2
    br malformed -> L_MALFORMED, L_INNER

L_INNER:
    inner_status = call @sa3d_gltf_json_table_store_optional_f32_value(bytes, len, spot_pos, &SA3D_GLTF_JSON_KEY_INNER_CONE_ANGLE, 14, &out, SA3D_GLTF_LIGHT_TABLE_inner_cone_angle)
    inner_ok = eq inner_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br inner_ok -> L_OUTER, L_RETURN_INNER

L_OUTER:
    outer_status = call @sa3d_gltf_json_table_store_optional_f32_value(bytes, len, spot_pos, &SA3D_GLTF_JSON_KEY_OUTER_CONE_ANGLE, 14, &out, SA3D_GLTF_LIGHT_TABLE_outer_cone_angle)
    outer_ok = eq outer_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br outer_ok -> L_OK, L_RETURN_OUTER

L_OK:
    !outer_ok
    !outer_status
    !inner_ok
    !inner_status
    !malformed
    !missing
    !spot_pos
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_OUTER:
    !outer_ok
    !inner_ok
    !inner_status
    !malformed
    !missing
    !spot_pos
    !out
    !light_pos
    !len
    !bytes
    return outer_status

L_RETURN_INNER:
    !inner_ok
    !malformed
    !missing
    !spot_pos
    !out
    !light_pos
    !len
    !bytes
    return inner_status

L_MISSING:
    !missing
    !spot_pos
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    !malformed
    !missing
    !spot_pos
    !out
    !light_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_light_parse(bytes: ptr, len: i64, light_index: i64, &out: ptr) -> i32:
L_ENTRY:
    type_ptr_slot = stack_alloc 8
    type_len_slot = stack_alloc 8
    call @sa3d_gltf_light_table_clear(&out)
    store out+SA3D_GLTF_LIGHT_TABLE_index, light_index as i64
    light_pos = call @sa3d_gltf_json_khr_light_root_array_item_start(bytes, len, light_index)
    missing = eq light_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq light_pos, -2
    br malformed -> L_MALFORMED, L_NAME

L_NAME:
    name_status = call @sa3d_gltf_json_light_store_name(bytes, len, light_pos, &out)
    name_ok = eq name_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br name_ok -> L_TYPE, L_RETURN_NAME_STATUS

L_TYPE:
    type_status = call @sa3d_gltf_json_object_string_span(bytes, len, light_pos, &SA3D_GLTF_JSON_KEY_TYPE, 4, &type_ptr_slot, &type_len_slot)
    type_missing = eq type_status, 0
    br type_missing -> L_MISSING_TYPE, L_TYPE_BAD_CHECK

L_TYPE_BAD_CHECK:
    type_bad = slt type_status, 0
    br type_bad -> L_MALFORMED_TYPE, L_TYPE_PARSE

L_TYPE_PARSE:
    type_ptr = load type_ptr_slot+0 as ptr
    type_len = load type_len_slot+0 as i64
    kind = call @sa3d_gltf_json_light_kind_from_span(type_ptr, type_len)
    kind_ok = ne kind, 0
    br kind_ok -> L_KIND_STORE, L_UNSUPPORTED_TYPE

L_KIND_STORE:
    store out+SA3D_GLTF_LIGHT_TABLE_kind, kind as i32
    color_status = call @sa3d_gltf_json_light_store_color(bytes, len, light_pos, &out)
    color_ok = eq color_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br color_ok -> L_INTENSITY, L_RETURN_COLOR_STATUS

L_INTENSITY:
    intensity_status = call @sa3d_gltf_json_table_store_optional_f32_value(bytes, len, light_pos, &SA3D_GLTF_JSON_KEY_INTENSITY, 9, &out, SA3D_GLTF_LIGHT_TABLE_intensity)
    intensity_ok = eq intensity_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br intensity_ok -> L_RANGE, L_RETURN_INTENSITY_STATUS

L_RANGE:
    range_status = call @sa3d_gltf_json_table_store_optional_f32_field(bytes, len, light_pos, &SA3D_GLTF_JSON_KEY_RANGE, 5, &out, SA3D_GLTF_LIGHT_TABLE_range, SA3D_GLTF_LIGHT_TABLE_has_range)
    range_ok = eq range_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br range_ok -> L_SPOT_CHECK, L_RETURN_RANGE_STATUS

L_SPOT_CHECK:
    is_spot = eq kind, SA3D_GLTF_LIGHT_KIND_SPOT
    br is_spot -> L_SPOT, L_EXTRAS

L_SPOT:
    spot_status = call @sa3d_gltf_json_light_parse_spot(bytes, len, light_pos, &out)
    spot_ok = eq spot_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br spot_ok -> L_EXTRAS_AFTER_SPOT, L_RETURN_SPOT_STATUS

L_EXTRAS_AFTER_SPOT:
    extras_status_s = call @sa3d_gltf_json_light_store_extras(bytes, len, light_pos, &out)
    extras_ok_s = eq extras_status_s, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br extras_ok_s -> L_OK_SPOT, L_RETURN_EXTRAS_SPOT_STATUS

L_EXTRAS:
    extras_status = call @sa3d_gltf_json_light_store_extras(bytes, len, light_pos, &out)
    extras_ok = eq extras_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br extras_ok -> L_OK, L_RETURN_EXTRAS_STATUS

L_OK_SPOT:
    call @sa3d_gltf_light_update_bevy_fields(&out)
    store out+SA3D_GLTF_LIGHT_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !extras_ok_s
    !extras_status_s
    !spot_ok
    !spot_status
    !is_spot
    !range_ok
    !range_status
    !intensity_ok
    !intensity_status
    !color_ok
    !color_status
    !kind_ok
    !kind
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK:
    call @sa3d_gltf_light_update_bevy_fields(&out)
    store out+SA3D_GLTF_LIGHT_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_OK as i32
    !extras_ok
    !extras_status
    !is_spot
    !range_ok
    !range_status
    !intensity_ok
    !intensity_status
    !color_ok
    !color_status
    !kind_ok
    !kind
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_EXTRAS_SPOT_STATUS:
    store out+SA3D_GLTF_LIGHT_TABLE_status, extras_status_s as i32
    !extras_ok_s
    !spot_ok
    !spot_status
    !is_spot
    !range_ok
    !range_status
    !intensity_ok
    !intensity_status
    !color_ok
    !color_status
    !kind_ok
    !kind
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return extras_status_s

L_RETURN_EXTRAS_STATUS:
    store out+SA3D_GLTF_LIGHT_TABLE_status, extras_status as i32
    !extras_ok
    !is_spot
    !range_ok
    !range_status
    !intensity_ok
    !intensity_status
    !color_ok
    !color_status
    !kind_ok
    !kind
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return extras_status

L_RETURN_SPOT_STATUS:
    store out+SA3D_GLTF_LIGHT_TABLE_status, spot_status as i32
    !spot_ok
    !is_spot
    !range_ok
    !range_status
    !intensity_ok
    !intensity_status
    !color_ok
    !color_status
    !kind_ok
    !kind
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return spot_status

L_RETURN_RANGE_STATUS:
    store out+SA3D_GLTF_LIGHT_TABLE_status, range_status as i32
    !range_ok
    !intensity_ok
    !intensity_status
    !color_ok
    !color_status
    !kind_ok
    !kind
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return range_status

L_RETURN_INTENSITY_STATUS:
    store out+SA3D_GLTF_LIGHT_TABLE_status, intensity_status as i32
    !intensity_ok
    !color_ok
    !color_status
    !kind_ok
    !kind
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return intensity_status

L_RETURN_COLOR_STATUS:
    store out+SA3D_GLTF_LIGHT_TABLE_status, color_status as i32
    !color_ok
    !kind_ok
    !kind
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return color_status

L_UNSUPPORTED_TYPE:
    store out+SA3D_GLTF_LIGHT_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT as i32
    !kind_ok
    !kind
    !type_len
    !type_ptr
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_UNSUPPORTED_FORMAT

L_MALFORMED_TYPE:
    store out+SA3D_GLTF_LIGHT_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !type_bad
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

L_MISSING_TYPE:
    store out+SA3D_GLTF_LIGHT_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !type_missing
    !type_status
    !name_ok
    !name_status
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_RETURN_NAME_STATUS:
    store out+SA3D_GLTF_LIGHT_TABLE_status, name_status as i32
    !name_ok
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return name_status

L_MISSING:
    store out+SA3D_GLTF_LIGHT_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    store out+SA3D_GLTF_LIGHT_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON as i32
    !malformed
    !missing
    !light_pos
    !out
    !light_index
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_camera_table_clear(&out: ptr) -> void:
L_ENTRY:
    store out+SA3D_GLTF_CAMERA_TABLE_index, 0 as i64
    store out+SA3D_GLTF_CAMERA_TABLE_name_ptr, 0 as i64
    store out+SA3D_GLTF_CAMERA_TABLE_name_len, 0 as i64
    store out+SA3D_GLTF_CAMERA_TABLE_projection_kind, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_has_aspect_ratio, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_aspect_ratio, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_yfov, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_znear, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_has_zfar, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_zfar, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_xmag, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_ymag, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_has_extras, 0 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_extras_ptr, 0 as i64
    store out+SA3D_GLTF_CAMERA_TABLE_extras_len, 0 as i64
    store out+SA3D_GLTF_CAMERA_TABLE_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED as i32
    !out
    return

@sa3d_gltf_json_camera_projection_from_span(text: ptr, len: i64) -> i32:
L_ENTRY:
    perspective_len = eq len, 11
    br perspective_len -> L_PERSPECTIVE_CHECK, L_ORTHOGRAPHIC_LEN

L_PERSPECTIVE_CHECK:
    perspective_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_PERSPECTIVE, 11)
    br perspective_eq -> L_PERSPECTIVE, L_ORTHOGRAPHIC_LEN_AFTER_PERSPECTIVE

L_PERSPECTIVE:
    !perspective_eq
    !perspective_len
    !len
    !text
    return SA3D_GLTF_CAMERA_PROJECTION_PERSPECTIVE

L_ORTHOGRAPHIC_LEN_AFTER_PERSPECTIVE:
    !perspective_eq
    jmp L_ORTHOGRAPHIC_LEN_COMMON

L_ORTHOGRAPHIC_LEN:
    jmp L_ORTHOGRAPHIC_LEN_COMMON

L_ORTHOGRAPHIC_LEN_COMMON:
    orthographic_len = eq len, 12
    br orthographic_len -> L_ORTHOGRAPHIC_CHECK, L_UNSUPPORTED

L_ORTHOGRAPHIC_CHECK:
    orthographic_eq = call @sa3d_gltf_bytes_eq(text, &SA3D_GLTF_JSON_TEXT_ORTHOGRAPHIC, 12)
    br orthographic_eq -> L_ORTHOGRAPHIC, L_UNSUPPORTED_AFTER_ORTHOGRAPHIC

L_ORTHOGRAPHIC:
    !orthographic_eq
    !orthographic_len
    !perspective_len
    !len
    !text
    return SA3D_GLTF_CAMERA_PROJECTION_ORTHOGRAPHIC

L_UNSUPPORTED_AFTER_ORTHOGRAPHIC:
    !orthographic_eq
    !orthographic_len
    !perspective_len
    !len
    !text
    return 0

L_UNSUPPORTED:
    !orthographic_len
    !perspective_len
    !len
    !text
    return 0

@sa3d_gltf_json_camera_store_name(bytes: ptr, len: i64, camera_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    ptr_slot = stack_alloc 8
    len_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_string_span(bytes, len, camera_pos, &SA3D_GLTF_JSON_KEY_NAME, 4, &ptr_slot, &len_slot)
    bad = slt status, 0
    br bad -> L_BAD, L_FOUND_CHECK

L_FOUND_CHECK:
    found = eq status, 1
    br found -> L_STORE, L_OK_MISSING

L_STORE:
    name_ptr = load ptr_slot+0 as ptr
    name_len = load len_slot+0 as i64
    store out+SA3D_GLTF_CAMERA_TABLE_name_ptr, name_ptr as ptr
    store out+SA3D_GLTF_CAMERA_TABLE_name_len, name_len as i64
    !name_len
    !name_ptr
    !found
    !bad
    !status
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !found
    !bad
    !status
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !status
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_camera_store_extras(bytes: ptr, len: i64, camera_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    ptr_slot = stack_alloc 8
    len_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_value_span(bytes, len, camera_pos, &SA3D_GLTF_JSON_KEY_EXTRAS, 6, &ptr_slot, &len_slot)
    bad = slt status, 0
    br bad -> L_BAD, L_FOUND_CHECK

L_FOUND_CHECK:
    found = eq status, 1
    br found -> L_STORE, L_OK_MISSING

L_STORE:
    extras_ptr = load ptr_slot+0 as ptr
    extras_len = load len_slot+0 as i64
    store out+SA3D_GLTF_CAMERA_TABLE_has_extras, 1 as i32
    store out+SA3D_GLTF_CAMERA_TABLE_extras_ptr, extras_ptr as ptr
    store out+SA3D_GLTF_CAMERA_TABLE_extras_len, extras_len as i64
    !extras_len
    !extras_ptr
    !found
    !bad
    !status
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !found
    !bad
    !status
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !status
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_camera_parse_perspective(bytes: ptr, len: i64, camera_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    perspective_pos = call @sa3d_gltf_json_object_field_value(bytes, len, camera_pos, &SA3D_GLTF_JSON_KEY_PERSPECTIVE, 11)
    missing = eq perspective_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq perspective_pos, -2
    br malformed -> L_MALFORMED, L_YFOV

L_YFOV:
    yfov_status = call @sa3d_gltf_json_table_store_required_f32_field(bytes, len, perspective_pos, &SA3D_GLTF_JSON_KEY_YFOV, 4, &out, SA3D_GLTF_CAMERA_TABLE_yfov)
    yfov_ok = eq yfov_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br yfov_ok -> L_ZNEAR, L_RETURN_YFOV

L_ZNEAR:
    znear_status = call @sa3d_gltf_json_table_store_required_f32_field(bytes, len, perspective_pos, &SA3D_GLTF_JSON_KEY_ZNEAR, 5, &out, SA3D_GLTF_CAMERA_TABLE_znear)
    znear_ok = eq znear_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br znear_ok -> L_ASPECT, L_RETURN_ZNEAR

L_ASPECT:
    aspect_status = call @sa3d_gltf_json_table_store_optional_f32_field(bytes, len, perspective_pos, &SA3D_GLTF_JSON_KEY_ASPECT_RATIO, 11, &out, SA3D_GLTF_CAMERA_TABLE_aspect_ratio, SA3D_GLTF_CAMERA_TABLE_has_aspect_ratio)
    aspect_ok = eq aspect_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br aspect_ok -> L_ZFAR, L_RETURN_ASPECT

L_ZFAR:
    zfar_status = call @sa3d_gltf_json_table_store_optional_f32_field(bytes, len, perspective_pos, &SA3D_GLTF_JSON_KEY_ZFAR, 4, &out, SA3D_GLTF_CAMERA_TABLE_zfar, SA3D_GLTF_CAMERA_TABLE_has_zfar)
    zfar_ok = eq zfar_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br zfar_ok -> L_OK, L_RETURN_ZFAR

L_OK:
    store out+SA3D_GLTF_CAMERA_TABLE_projection_kind, SA3D_GLTF_CAMERA_PROJECTION_PERSPECTIVE as i32
    !zfar_ok
    !zfar_status
    !aspect_ok
    !aspect_status
    !znear_ok
    !znear_status
    !yfov_ok
    !yfov_status
    !malformed
    !missing
    !perspective_pos
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_RETURN_ZFAR:
    !zfar_ok
    !aspect_ok
    !aspect_status
    !znear_ok
    !znear_status
    !yfov_ok
    !yfov_status
    !malformed
    !missing
    !perspective_pos
    !out
    !camera_pos
    !len
    !bytes
    return zfar_status

L_RETURN_ASPECT:
    !aspect_ok
    !znear_ok
    !znear_status
    !yfov_ok
    !yfov_status
    !malformed
    !missing
    !perspective_pos
    !out
    !camera_pos
    !len
    !bytes
    return aspect_status

L_RETURN_ZNEAR:
    !znear_ok
    !yfov_ok
    !yfov_status
    !malformed
    !missing
    !perspective_pos
    !out
    !camera_pos
    !len
    !bytes
    return znear_status

L_RETURN_YFOV:
    !yfov_ok
    !malformed
    !missing
    !perspective_pos
    !out
    !camera_pos
    !len
    !bytes
    return yfov_status

L_MISSING:
    !missing
    !perspective_pos
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED

L_MALFORMED:
    !malformed
    !missing
    !perspective_pos
    !out
    !camera_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

@sa3d_gltf_json_camera_parse_orthographic(bytes: ptr, len: i64, camera_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    orthographic_pos = call @sa3d_gltf_json_object_field_value(bytes, len, camera_pos, &SA3D_GLTF_JSON_KEY_ORTHOGRAPHIC, 12)
    missing = eq orthographic_pos, -1
    br missing -> L_MISSING, L_MALFORMED_CHECK

L_MALFORMED_CHECK:
    malformed = eq orthographic_pos, -2
    br malformed -> L_MALFORMED, L_XMAG

L_XMAG:
    xmag_status = call @sa3d_gltf_json_table_store_required_f32_field(bytes, len, orthographic_pos, &SA3D_GLTF_JSON_KEY_XMAG, 4, &out, SA3D_GLTF_CAMERA_TABLE_xmag)
    xmag_ok = eq xmag_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    br xmag_ok -> L_YMAG, L_RETURN_XMAG

L_YMAG:
    ymag_status = call @sa3d_gltf_json_table_store_required_f32_field(bytes, len, orthographic_pos, &SA3D_GLTF_JSON_KEY_YMAG, 4, &out, SA3D_GLTF_CAMERA_TABLE_ymag)
