@sa3d_gltf_json_mesh_store_name(bytes: ptr, len: i64, mesh_pos: i64, &out: ptr) -> i32:
L_ENTRY:
    ptr_slot = stack_alloc 8
    len_slot = stack_alloc 8
    status = call @sa3d_gltf_json_object_string_span(bytes, len, mesh_pos, &SA3D_GLTF_JSON_KEY_NAME, 4, &ptr_slot, &len_slot)
    bad = slt status, 0
    br bad -> L_BAD, L_FOUND_CHECK

L_FOUND_CHECK:
    found = eq status, 1
    br found -> L_STORE, L_OK_MISSING

L_STORE:
    name_ptr = load ptr_slot+0 as ptr
    name_len = load len_slot+0 as i64
    store out+SA3D_GLTF_MESH_TABLE_name_ptr, name_ptr as ptr
    store out+SA3D_GLTF_MESH_TABLE_name_len, name_len as i64
    !name_len
    !name_ptr
    !found
    !bad
    !status
    !out
    !mesh_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_OK_MISSING:
    !found
    !bad
    !status
    !out
    !mesh_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_OK

L_BAD:
    !bad
    !status
    !out
    !mesh_pos
    !len
    !bytes
    return SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON

