    joint_u16_2_ok = eq joint_u16_2, 300
    joint_u16_3_ok = eq joint_u16_3, 65535

    weight_u8_layout_ok = eq weight_u8_layout, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    weight_u8_status_ok = eq weight_u8_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    weight_u8_len_ok = eq weight_u8_len, 16
    weight_u8_0_ok = eq weight_u8_0, 0
    weight_u8_1_ok = eq weight_u8_1, 1056997505
    weight_u8_2_ok = eq weight_u8_2, 1065353216
    weight_u8_3_ok = eq weight_u8_3, 998277249
    weight_u16_layout_ok = eq weight_u16_layout, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    weight_u16_status_ok = eq weight_u16_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK
    weight_u16_len_ok = eq weight_u16_len, 16
    weight_u16_0_ok = eq weight_u16_0, 0
    weight_u16_1_ok = eq weight_u16_1, 1056964736
    weight_u16_2_ok = eq weight_u16_2, 1065353216
    weight_u16_3_ok = eq weight_u16_3, 931135616

    unsupported_rgba_ok = eq unsupported_rgba_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT
    small_tex_layout_ok = eq small_tex_layout, SA3D_GLTF_ACCESSOR_LAYOUT_STATUS_OK
    small_tex_ok = eq small_tex_status, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OUTPUT_TOO_SMALL

    p0 = and rgba_f32_layout_ok, rgba_f32_status_ok
    p1 = and rgba_f32_len_ok, rgba_f32_r_ok
    p2 = and rgba_f32_g_ok, rgba_f32_b_ok
    p3 = and rgba_f32_a_ok, rgba_u8_layout_ok
    p4 = and rgba_u8_status_ok, rgba_u8_len_ok
    p5 = and rgba_u8_r_ok, rgba_u8_g_ok
    p6 = and rgba_u8_b_ok, rgba_u8_a_ok
    p7 = and rgba_u16_layout_ok, rgba_u16_status_ok
    p8 = and rgba_u16_len_ok, rgba_u16_r_ok
    p9 = and rgba_u16_g_ok, rgba_u16_b_ok
    p10 = and rgba_u16_a_ok, tex_u8_layout_ok
    p11 = and tex_u8_status_ok, tex_u8_len_ok
    p12 = and tex_u8_x_ok, tex_u8_y_ok
    p13 = and tex_u16_layout_ok, tex_u16_status_ok
    p14 = and tex_u16_len_ok, tex_u16_x_ok
    p15 = and tex_u16_y_ok, joint_u8_layout_ok
    p16 = and joint_u8_status_ok, joint_u8_len_ok
    p17 = and joint_u8_0_ok, joint_u8_1_ok
    p18 = and joint_u8_2_ok, joint_u8_3_ok
    p19 = and joint_u16_layout_ok, joint_u16_status_ok
    p20 = and joint_u16_len_ok, joint_u16_2_ok
    p21 = and joint_u16_3_ok, weight_u8_layout_ok
    p22 = and weight_u8_status_ok, weight_u8_len_ok
    p23 = and weight_u8_0_ok, weight_u8_1_ok
    p24 = and weight_u8_2_ok, weight_u8_3_ok
    p25 = and weight_u16_layout_ok, weight_u16_status_ok
    p26 = and weight_u16_len_ok, weight_u16_0_ok
    p27 = and weight_u16_1_ok, weight_u16_2_ok
    p28 = and weight_u16_3_ok, unsupported_rgba_ok
    p29 = and small_tex_layout_ok, small_tex_ok

    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    q5 = and p10, p11
    q6 = and p12, p13
    q7 = and p14, p15
    q8 = and p16, p17
    q9 = and p18, p19
    q10 = and p20, p21
    q11 = and p22, p23
    q12 = and p24, p25
    q13 = and p26, p27
    q14 = and p28, p29

    r0 = and q0, q1
    r1 = and q2, q3
    r2 = and q4, q5
    r3 = and q6, q7
    r4 = and q8, q9
    r5 = and q10, q11
    r6 = and q12, q13
    s0 = and r0, r1
    s1 = and r2, r3
    s2 = and r4, r5
    s3 = and s0, s1
    s4 = and s2, r6
    ok0 = and s3, s4
    ok = and ok0, q14

    !layout
    !out_len
    !out
    !buf
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3187)

@test "3d_gltf Bevy primitive mesh assembly metadata"():
L_ENTRY:
    mesh = alloc SA3D_GLTF_PRIMITIVE_MESH_SIZE
    unsupported_mesh = alloc SA3D_GLTF_PRIMITIVE_MESH_SIZE
    scan = alloc SA3D_GLTF_INDEX_SCAN_RESULT_SIZE
    buf = alloc 16

    store buf+0, 0 as u8
    store buf+1, 1 as u8
    store buf+2, 2 as u8
    store buf+3, 0 as u8
    store buf+4, 2 as u8
    store buf+5, 3 as u8

    begin_status = call @sa3d_gltf_primitive_mesh_begin(&mesh, SA3D_GLTF_MODE_TRIANGLES)
    pos_inserted = call @sa3d_gltf_primitive_mesh_add_attribute(&mesh, SA3D_GLTF_ATTRIBUTE_POSITION, 4, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK, 0, 0)
    joint_skipped = call @sa3d_gltf_primitive_mesh_add_attribute(&mesh, SA3D_GLTF_ATTRIBUTE_JOINT_INDEX, 4, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK, 0, 0)
    weight_inserted = call @sa3d_gltf_primitive_mesh_add_attribute(&mesh, SA3D_GLTF_ATTRIBUTE_JOINT_WEIGHT, 4, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_OK, 1, 1)
    bad_attr_skipped = call @sa3d_gltf_primitive_mesh_add_attribute(&mesh, SA3D_GLTF_ATTRIBUTE_COLOR, 4, SA3D_GLTF_ATTR_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT, 0, 0)

    scan_status = call @sa3d_gltf_index_accessor_scan(&buf, 16, 0, 6, 0, 0, 6, SA3D_GLTF_INDEX_FORMAT_U8, &scan)
    indices_set = call @sa3d_gltf_primitive_mesh_set_indices(&mesh, &scan, SA3D_GLTF_INDEX_FORMAT_U8)
    finalize_status = call @sa3d_gltf_primitive_mesh_finalize(&mesh, 1, SA3D_GLTF_SKINNED_BOUNDS_DYNAMIC, 1)

    topology = load mesh+SA3D_GLTF_PRIMITIVE_MESH_topology as i32
    status = load mesh+SA3D_GLTF_PRIMITIVE_MESH_status as i32
    attr_count = load mesh+SA3D_GLTF_PRIMITIVE_MESH_attribute_count as i64
    vertex_count = load mesh+SA3D_GLTF_PRIMITIVE_MESH_vertex_count as i64
    has_position = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_position as i32
    has_joint_index = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_joint_index as i32
    has_joint_weight = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_joint_weight as i32
    ignored_skin = load mesh+SA3D_GLTF_PRIMITIVE_MESH_ignored_skinned_attributes as i32
    mixed_skin = load mesh+SA3D_GLTF_PRIMITIVE_MESH_mixed_skinned_usage as i32
    has_indices = load mesh+SA3D_GLTF_PRIMITIVE_MESH_has_indices as i32
    index_count = load mesh+SA3D_GLTF_PRIMITIVE_MESH_index_count as i64
    index_max = load mesh+SA3D_GLTF_PRIMITIVE_MESH_index_max as i64
    source_index_format = load mesh+SA3D_GLTF_PRIMITIVE_MESH_source_index_format as i32
    stored_index_format = load mesh+SA3D_GLTF_PRIMITIVE_MESH_stored_index_format as i32
    compute_normals = load mesh+SA3D_GLTF_PRIMITIVE_MESH_compute_flat_normals as i32
    generate_tangents = load mesh+SA3D_GLTF_PRIMITIVE_MESH_generate_tangents as i32
    generate_bounds = load mesh+SA3D_GLTF_PRIMITIVE_MESH_generate_skinned_bounds as i32
    draw_count = load mesh+SA3D_GLTF_PRIMITIVE_MESH_draw_count as i64
    triangle_count = load mesh+SA3D_GLTF_PRIMITIVE_MESH_triangle_count as i64

    unsupported_status = call @sa3d_gltf_primitive_mesh_begin(&unsupported_mesh, SA3D_GLTF_MODE_LINE_LOOP)
    unsupported_field = load unsupported_mesh+SA3D_GLTF_PRIMITIVE_MESH_status as i32

    begin_ok = eq begin_status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK
    pos_inserted_ok = eq pos_inserted, 1
    joint_skipped_ok = eq joint_skipped, 0
    weight_inserted_ok = eq weight_inserted, 1
    bad_attr_skipped_ok = eq bad_attr_skipped, 0
    scan_ok = eq scan_status, SA3D_GLTF_INDEX_SCAN_STATUS_OK
    indices_set_ok = eq indices_set, 1
    finalize_ok = eq finalize_status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK
    topology_ok = eq topology, SA3D_GLTF_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    status_ok = eq status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_OK
    attr_count_ok = eq attr_count, 2
    vertex_count_ok = eq vertex_count, 4
    has_position_ok = eq has_position, 1
    has_joint_index_ok = eq has_joint_index, 0
    has_joint_weight_ok = eq has_joint_weight, 1
    ignored_skin_ok = eq ignored_skin, 1
    mixed_skin_ok = eq mixed_skin, 1
    has_indices_ok = eq has_indices, 1
    index_count_ok = eq index_count, 6
    index_max_ok = eq index_max, 3
    source_index_format_ok = eq source_index_format, SA3D_GLTF_INDEX_FORMAT_U8
    stored_index_format_ok = eq stored_index_format, SA3D_GLTF_INDEX_FORMAT_U16
    compute_normals_ok = eq compute_normals, 1
    generate_tangents_ok = eq generate_tangents, 1
    generate_bounds_ok = eq generate_bounds, 1
    draw_count_ok = eq draw_count, 6
    triangle_count_ok = eq triangle_count, 2
    unsupported_status_ok = eq unsupported_status, SA3D_GLTF_PRIMITIVE_MESH_STATUS_UNSUPPORTED_PRIMITIVE
    unsupported_field_ok = eq unsupported_field, SA3D_GLTF_PRIMITIVE_MESH_STATUS_UNSUPPORTED_PRIMITIVE

    p0 = and begin_ok, pos_inserted_ok
    p1 = and joint_skipped_ok, weight_inserted_ok
    p2 = and bad_attr_skipped_ok, scan_ok
    p3 = and indices_set_ok, finalize_ok
    p4 = and topology_ok, status_ok
    p5 = and attr_count_ok, vertex_count_ok
    p6 = and has_position_ok, has_joint_index_ok
    p7 = and has_joint_weight_ok, ignored_skin_ok
    p8 = and mixed_skin_ok, has_indices_ok
    p9 = and index_count_ok, index_max_ok
    p10 = and source_index_format_ok, stored_index_format_ok
    p11 = and compute_normals_ok, generate_tangents_ok
    p12 = and generate_bounds_ok, draw_count_ok
    p13 = and triangle_count_ok, unsupported_status_ok
    p14 = and unsupported_field_ok, p13

    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    q5 = and p10, p11
    q6 = and p12, p14
    r0 = and q0, q1
    r1 = and q2, q3
    r2 = and q4, q5
    s0 = and r0, r1
    s1 = and r2, q6
    ok = and s0, s1

    !buf
    !scan
    !unsupported_mesh
    !mesh
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3188)

@test "3d_gltf Bevy ReadIndices materialize"():
L_ENTRY:
    buf = alloc 48
    out = alloc 32
    out_len = alloc 8
    out_format = alloc 4

    store buf+2, 1 as u8
    store buf+3, 4 as u8
    store buf+4, 2 as u8
    store buf+5, 9 as u8

    store buf+8, 5 as u16
    store buf+10, 300 as u16
    store buf+12, 2 as u16

    store buf+16, 7 as u32
    store buf+24, 65537 as u32

    u8_status = call @sa3d_gltf_index_accessor_materialize(&buf, 48, 2, 4, 0, 0, 4, SA3D_GLTF_INDEX_FORMAT_U8, &out, 32, &out_len, &out_format)
    u8_len = load out_len+0 as i64
    u8_format = load out_format+0 as i32
    u8_0 = load out+0 as u16
    u8_1 = load out+2 as u16
    u8_2 = load out+4 as u16
    u8_3 = load out+6 as u16

    u16_status = call @sa3d_gltf_index_accessor_materialize(&buf, 48, 8, 6, 0, 0, 3, SA3D_GLTF_INDEX_FORMAT_U16, &out, 32, &out_len, &out_format)
    u16_len = load out_len+0 as i64
    u16_format = load out_format+0 as i32
    u16_0 = load out+0 as u16
    u16_1 = load out+2 as u16
    u16_2 = load out+4 as u16

    u32_status = call @sa3d_gltf_index_accessor_materialize(&buf, 48, 16, 16, 8, 0, 2, SA3D_GLTF_INDEX_FORMAT_U32, &out, 32, &out_len, &out_format)
    u32_len = load out_len+0 as i64
    u32_format = load out_format+0 as i32
    u32_0 = load out+0 as u32
    u32_1 = load out+4 as u32

    small_status = call @sa3d_gltf_index_accessor_materialize(&buf, 48, 8, 6, 0, 0, 3, SA3D_GLTF_INDEX_FORMAT_U16, &out, 4, &out_len, &out_format)
    bad_status = call @sa3d_gltf_index_accessor_materialize(&buf, 48, 44, 4, 0, 0, 2, SA3D_GLTF_INDEX_FORMAT_U32, &out, 32, &out_len, &out_format)
    unsupported_status = call @sa3d_gltf_index_accessor_materialize(&buf, 48, 0, 4, 0, 0, 1, 99, &out, 32, &out_len, &out_format)

    u8_status_ok = eq u8_status, SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK
    u8_len_ok = eq u8_len, 8
    u8_format_ok = eq u8_format, SA3D_GLTF_INDEX_FORMAT_U16
    u8_0_ok = eq u8_0, 1
    u8_1_ok = eq u8_1, 4
    u8_2_ok = eq u8_2, 2
    u8_3_ok = eq u8_3, 9

    u16_status_ok = eq u16_status, SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK
    u16_len_ok = eq u16_len, 6
    u16_format_ok = eq u16_format, SA3D_GLTF_INDEX_FORMAT_U16
    u16_0_ok = eq u16_0, 5
    u16_1_ok = eq u16_1, 300
    u16_2_ok = eq u16_2, 2

    u32_status_ok = eq u32_status, SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OK
    u32_len_ok = eq u32_len, 8
    u32_format_ok = eq u32_format, SA3D_GLTF_INDEX_FORMAT_U32
    u32_0_ok = eq u32_0, 7
    u32_1_ok = eq u32_1, 65537

    small_ok = eq small_status, SA3D_GLTF_INDEX_MATERIALIZE_STATUS_OUTPUT_TOO_SMALL
    bad_ok = eq bad_status, SA3D_GLTF_INDEX_MATERIALIZE_STATUS_MALFORMED_DATA
    unsupported_ok = eq unsupported_status, SA3D_GLTF_INDEX_MATERIALIZE_STATUS_UNSUPPORTED_FORMAT

    p0 = and u8_status_ok, u8_len_ok
    p1 = and u8_format_ok, u8_0_ok
    p2 = and u8_1_ok, u8_2_ok
    p3 = and u8_3_ok, u16_status_ok
    p4 = and u16_len_ok, u16_format_ok
    p5 = and u16_0_ok, u16_1_ok
    p6 = and u16_2_ok, u32_status_ok
    p7 = and u32_len_ok, u32_format_ok
    p8 = and u32_0_ok, u32_1_ok
    p9 = and small_ok, bad_ok
    p10 = and unsupported_ok, p9
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p10
    r0 = and q0, q1
    r1 = and q2, q3
    s0 = and r0, r1
    ok = and s0, q4

    !out_format
    !out_len
    !out
    !buf
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3189)
