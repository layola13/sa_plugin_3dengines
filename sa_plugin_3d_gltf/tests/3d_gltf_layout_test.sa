    cutoff2 = load material2+SA3D_GLTF_MATERIAL_TABLE_alpha_cutoff_bits as i32

    cull0 = call @sa3d_gltf_material_cull_mode(double0, 0)
    cull2_front = call @sa3d_gltf_material_cull_mode(double2, 1)
    cull2_back = call @sa3d_gltf_material_cull_mode(double2, 0)

    status0_ok = eq status0, SA3D_GLTF_JSON_TABLE_STATUS_OK
    status1_ok = eq status1, SA3D_GLTF_JSON_TABLE_STATUS_OK
    status2_ok = eq status2, SA3D_GLTF_JSON_TABLE_STATUS_OK
    double0_ok = eq double0, 1
    unlit0_ok = eq unlit0, 1
    gltf_alpha0_ok = eq gltf_alpha0, SA3D_GLTF_ALPHA_MODE_MASK
    alpha0_ok = eq alpha0, SA3D_ALPHA_MODE_MASK
    has_cutoff0_ok = eq has_cutoff0, 1
    cutoff0_ok = eq cutoff0, 1048576000
    cull0_ok = eq cull0, SA3D_FACE_NONE

    double1_ok = eq double1, 0
    unlit1_ok = eq unlit1, 0
    gltf_alpha1_ok = eq gltf_alpha1, SA3D_GLTF_ALPHA_MODE_BLEND
    alpha1_ok = eq alpha1, SA3D_ALPHA_MODE_BLEND
    has_cutoff1_ok = eq has_cutoff1, 0
    cutoff1_ok = eq cutoff1, 0

    double2_ok = eq double2, 0
    unlit2_ok = eq unlit2, 0
    gltf_alpha2_ok = eq gltf_alpha2, SA3D_GLTF_ALPHA_MODE_OPAQUE
    alpha2_ok = eq alpha2, SA3D_ALPHA_MODE_OPAQUE
    has_cutoff2_ok = eq has_cutoff2, 0
    cutoff2_ok = eq cutoff2, 0
    cull2_front_ok = eq cull2_front, SA3D_FACE_FRONT
    cull2_back_ok = eq cull2_back, SA3D_FACE_BACK

    p0 = and status0_ok, status1_ok
    p1 = and status2_ok, double0_ok
    p2 = and unlit0_ok, gltf_alpha0_ok
    p3 = and alpha0_ok, has_cutoff0_ok
    p4 = and cutoff0_ok, cull0_ok
    p5 = and double1_ok, unlit1_ok
    p6 = and gltf_alpha1_ok, alpha1_ok
    p7 = and has_cutoff1_ok, cutoff1_ok
    p8 = and double2_ok, unlit2_ok
    p9 = and gltf_alpha2_ok, alpha2_ok
    p10 = and has_cutoff2_ok, cutoff2_ok
    p11 = and cull2_front_ok, cull2_back_ok
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    q5 = and p10, p11
    r0 = and q0, q1
    r1 = and q2, q3
    r2 = and q4, q5
    s0 = and r0, r1
    ok = and s0, r2

    !material2
    !material1
    !material0
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3196)

