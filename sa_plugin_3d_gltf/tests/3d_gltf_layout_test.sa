@gltf_test_bytes_eq(&lhs: ptr, lhs_len: i64, &rhs: ptr, rhs_len: i64) -> i32:
L_ENTRY:
    same_len = eq lhs_len, rhs_len
    br same_len -> L_LOOP_INIT, L_FALSE

L_LOOP_INIT:
    idx_slot = stack_alloc 8
    store idx_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    idx = load idx_slot+0 as i64
    done = eq idx, lhs_len
    br done -> L_TRUE, L_BODY

L_BODY:
    lhs_ip = ptr_add lhs, idx
    rhs_ip = ptr_add rhs, idx
    lhs_byte = load lhs_ip+0 as u8
    rhs_byte = load rhs_ip+0 as u8
    byte_ok = eq lhs_byte, rhs_byte
    !rhs_ip
    !lhs_ip
    br byte_ok -> L_NEXT, L_FALSE_BODY

L_NEXT:
    next_idx = add idx, 1
    store idx_slot+0, next_idx as i64
    !next_idx
    !byte_ok
    !rhs_byte
    !lhs_byte
    !done
    !idx
    jmp L_HEAD

L_TRUE:
    !done
    !idx
    !same_len
    !rhs_len
    !rhs
    !lhs_len
    !lhs
    return 1

L_FALSE_BODY:
    !byte_ok
    !rhs_byte
    !lhs_byte
    !done
    !idx
    !same_len
    !rhs_len
    !rhs
    !lhs_len
    !lhs
    return 0

L_FALSE:
    !same_len
    !rhs_len
    !rhs
    !lhs_len
    !lhs
    return 0

@gltf_test_f32_between(value: f32, low: f32, high: f32) -> i32:
L_ENTRY:
    low_ok = fcmp_gt value, low
    high_ok = fcmp_lt value, high
    ok = and low_ok, high_ok
    !high_ok
    !low_ok
    !high
    !low
    !value
    return ok

@test "3d_gltf asset desc init"():
L_ENTRY:
    d = alloc SA3D_GLTF_ASSET_DESC_SIZE
    call @sa3d_gltf_asset_desc_init(&d)
    fmt = call @sa3d_gltf_asset_desc_get_format(&d)
    fmt_ok = eq fmt, SA3D_GLTF_FORMAT_JSON
    br fmt_ok -> L_STEP2, L_ERR
L_STEP2:
    call @sa3d_gltf_asset_desc_set_format(&d, SA3D_GLTF_FORMAT_GLB)
    fmt2 = call @sa3d_gltf_asset_desc_get_format(&d)
    ok = eq fmt2, SA3D_GLTF_FORMAT_GLB
    !d
    br ok -> L_OK, L_ERR2
L_OK:
    return 0
L_ERR:
    !d
    panic(3150)
L_ERR2:
    panic(3151)

@test "3d_gltf json and glb header helpers"():
L_ENTRY:
    json_desc = alloc SA3D_GLTF_ASSET_DESC_SIZE
    glb_desc = alloc SA3D_GLTF_ASSET_DESC_SIZE
    bad_glb_desc = alloc SA3D_GLTF_ASSET_DESC_SIZE
    json_src = alloc 6
    glb_src = alloc 24
    bad_glb_src = alloc 12
    base_uri = alloc 4

    store json_src+0, 32 as u8
    store json_src+1, 32 as u8
    store json_src+2, 123 as u8
    store json_src+3, 125 as u8
    store json_src+4, 32 as u8
    store json_src+5, 10 as u8

    store glb_src+0, 103 as u8
    store glb_src+1, 108 as u8
    store glb_src+2, 84 as u8
    store glb_src+3, 70 as u8
    store glb_src+4, 2 as u8
    store glb_src+5, 0 as u8
    store glb_src+6, 0 as u8
    store glb_src+7, 0 as u8
    store glb_src+8, 24 as u8
    store glb_src+9, 0 as u8
    store glb_src+10, 0 as u8
    store glb_src+11, 0 as u8
    store glb_src+12, 4 as u8
    store glb_src+13, 0 as u8
    store glb_src+14, 0 as u8
    store glb_src+15, 0 as u8
    store glb_src+16, 74 as u8
    store glb_src+17, 83 as u8
    store glb_src+18, 79 as u8
    store glb_src+19, 78 as u8
    store glb_src+20, 123 as u8
    store glb_src+21, 125 as u8
    store glb_src+22, 32 as u8
    store glb_src+23, 32 as u8

    store bad_glb_src+0, 103 as u8
    store bad_glb_src+1, 108 as u8
    store bad_glb_src+2, 84 as u8
    store bad_glb_src+3, 70 as u8
    store bad_glb_src+4, 1 as u8
    store bad_glb_src+5, 0 as u8
    store bad_glb_src+6, 0 as u8
    store bad_glb_src+7, 0 as u8
    store bad_glb_src+8, 12 as u8
    store bad_glb_src+9, 0 as u8
    store bad_glb_src+10, 0 as u8
    store bad_glb_src+11, 0 as u8

    call @sa3d_gltf_asset_desc_init(&json_desc)
    call @sa3d_gltf_asset_desc_set_source(&json_desc, &json_src, 6)
    call @sa3d_gltf_asset_desc_set_base_uri(&json_desc, 0, 4)
    call @sa3d_gltf_asset_desc_set_format(&json_desc, SA3D_GLTF_FORMAT_JSON)
    call @sa3d_gltf_asset_desc_set_flags(&json_desc, SA3D_GLTF_LOAD_MESHES)
    invalid_base = call @sa3d_gltf_asset_desc_is_valid(&json_desc)
    call @sa3d_gltf_asset_desc_set_base_uri(&json_desc, &base_uri, 4)
    json_header_ok = call @sa3d_gltf_json_header_is_valid(&json_desc)
    json_valid = call @sa3d_gltf_asset_desc_is_valid(&json_desc)

    call @sa3d_gltf_asset_desc_init(&glb_desc)
    call @sa3d_gltf_asset_desc_set_source(&glb_desc, &glb_src, 24)
    call @sa3d_gltf_asset_desc_set_base_uri(&glb_desc, &base_uri, 4)
    call @sa3d_gltf_asset_desc_set_format(&glb_desc, SA3D_GLTF_FORMAT_GLB)
    call @sa3d_gltf_asset_desc_set_flags(&glb_desc, SA3D_GLTF_LOAD_MESHES)
    glb_header_ok = call @sa3d_gltf_glb_header_is_valid(&glb_desc)
    glb_valid = call @sa3d_gltf_asset_desc_is_valid(&glb_desc)

    call @sa3d_gltf_asset_desc_init(&bad_glb_desc)
    call @sa3d_gltf_asset_desc_set_source(&bad_glb_desc, &bad_glb_src, 12)
    call @sa3d_gltf_asset_desc_set_base_uri(&bad_glb_desc, &base_uri, 4)
    call @sa3d_gltf_asset_desc_set_format(&bad_glb_desc, SA3D_GLTF_FORMAT_GLB)
    bad_glb_header = call @sa3d_gltf_glb_header_is_valid(&bad_glb_desc)

    invalid_base_ok = eq invalid_base, 0
    json_header_ok2 = eq json_header_ok, 1
    json_valid_ok = eq json_valid, 1
    glb_header_ok2 = eq glb_header_ok, 1
    glb_valid_ok = eq glb_valid, 1
    bad_glb_header_ok = eq bad_glb_header, 0

    a = and invalid_base_ok, json_header_ok2
    b = and json_valid_ok, glb_header_ok2
    c = and glb_valid_ok, bad_glb_header_ok
    ok = and a, b
    ok2 = and ok, c

    !bad_glb_desc
    !bad_glb_src
    !glb_desc
    !json_desc
    !glb_src
    !json_src
    !base_uri
    br ok2 -> L_OK, L_ERR

L_OK:
    return 0

L_ERR:
    panic(3153)

@test "3d_gltf GLB chunk parser validates JSON and BIN chunks"():
L_ENTRY:
    buf = alloc 36
    view = alloc SA3D_GLTF_GLB_VIEW_SIZE

    store buf+0, 103 as u8
    store buf+1, 108 as u8
    store buf+2, 84 as u8
    store buf+3, 70 as u8
    store buf+4, 2 as u8
    store buf+5, 0 as u8
    store buf+6, 0 as u8
    store buf+7, 0 as u8
    store buf+8, 24 as u8
    store buf+9, 0 as u8
    store buf+10, 0 as u8
    store buf+11, 0 as u8
    store buf+12, 4 as u8
    store buf+13, 0 as u8
    store buf+14, 0 as u8
    store buf+15, 0 as u8
    store buf+16, 74 as u8
    store buf+17, 83 as u8
    store buf+18, 79 as u8
    store buf+19, 78 as u8
    store buf+20, 123 as u8
    store buf+21, 125 as u8
    store buf+22, 32 as u8
    store buf+23, 32 as u8

    status_json = call @sa3d_gltf_glb_parse_bytes(&buf, 24, &view)
    json_len = load view+SA3D_GLTF_GLB_VIEW_json_len as i64
    json_ptr = load view+SA3D_GLTF_GLB_VIEW_json_ptr as ptr
    json_first = load json_ptr+0 as u8
    json_second = load json_ptr+1 as u8
    json_has_bin = load view+SA3D_GLTF_GLB_VIEW_has_bin as i32
    json_count = load view+SA3D_GLTF_GLB_VIEW_chunk_count as i32
    json_declared = load view+SA3D_GLTF_GLB_VIEW_declared_len as i64
    json_field_status = load view+SA3D_GLTF_GLB_VIEW_status as i32

    store buf+8, 36 as u8
    store buf+24, 4 as u8
    store buf+25, 0 as u8
    store buf+26, 0 as u8
    store buf+27, 0 as u8
    store buf+28, 66 as u8
    store buf+29, 73 as u8
    store buf+30, 78 as u8
    store buf+31, 0 as u8
    store buf+32, 1 as u8
    store buf+33, 2 as u8
    store buf+34, 3 as u8
    store buf+35, 4 as u8

    status_bin = call @sa3d_gltf_glb_parse_bytes(&buf, 36, &view)
    bin_len = load view+SA3D_GLTF_GLB_VIEW_bin_len as i64
    bin_ptr = load view+SA3D_GLTF_GLB_VIEW_bin_ptr as ptr
    bin_first = load bin_ptr+0 as u8
    bin_has = load view+SA3D_GLTF_GLB_VIEW_has_bin as i32
    bin_count = load view+SA3D_GLTF_GLB_VIEW_chunk_count as i32

    store buf+8, 24 as u8
    store buf+16, 66 as u8
    store buf+17, 73 as u8
    store buf+18, 78 as u8
    store buf+19, 0 as u8
    status_bad_first = call @sa3d_gltf_glb_parse_bytes(&buf, 24, &view)

    store buf+16, 74 as u8
    store buf+17, 83 as u8
    store buf+18, 79 as u8
    store buf+19, 78 as u8
    store buf+12, 8 as u8
    status_overflow = call @sa3d_gltf_glb_parse_bytes(&buf, 24, &view)

    store buf+12, 4 as u8
    store buf+8, 28 as u8
    status_bad_declared = call @sa3d_gltf_glb_parse_bytes(&buf, 24, &view)

    json_status_ok = eq status_json, SA3D_GLTF_GLB_STATUS_OK
    json_len_ok = eq json_len, 4
    json_first_ok = eq json_first, 123
    json_second_ok = eq json_second, 125
    json_has_bin_ok = eq json_has_bin, 0
    json_count_ok = eq json_count, 1
    json_declared_ok = eq json_declared, 24
    json_field_status_ok = eq json_field_status, SA3D_GLTF_GLB_STATUS_OK

    bin_status_ok = eq status_bin, SA3D_GLTF_GLB_STATUS_OK
    bin_len_ok = eq bin_len, 4
    bin_first_ok = eq bin_first, 1
    bin_has_ok = eq bin_has, 1
    bin_count_ok = eq bin_count, 2

    bad_first_ok = eq status_bad_first, SA3D_GLTF_GLB_STATUS_BAD_FIRST_CHUNK
    overflow_ok = eq status_overflow, SA3D_GLTF_GLB_STATUS_CHUNK_OVERFLOW
    bad_declared_ok = eq status_bad_declared, SA3D_GLTF_GLB_STATUS_BAD_DECLARED_LENGTH

    p0 = and json_status_ok, json_len_ok
    p1 = and json_first_ok, json_second_ok
    p2 = and json_has_bin_ok, json_count_ok
    p3 = and json_declared_ok, json_field_status_ok
    p4 = and bin_status_ok, bin_len_ok
    p5 = and bin_first_ok, bin_has_ok
    p6 = and bin_count_ok, bad_first_ok
    p7 = and overflow_ok, bad_declared_ok
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    r0 = and q0, q1
    r1 = and q2, q3
    ok = and r0, r1

    !view
    !buf
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3180)

@test "3d_gltf Bevy DataUri parse and buffer mime policy"():
L_ENTRY:
    view = alloc SA3D_GLTF_DATA_URI_VIEW_SIZE

    status_octet = call @sa3d_gltf_data_uri_parse(&DATA_URI_OCTET_B64, 41, &view)
    mime_len_octet = load view+SA3D_GLTF_DATA_URI_VIEW_mime_len as i64
    data_len_octet = load view+SA3D_GLTF_DATA_URI_VIEW_data_len as i64
    base64_octet = load view+SA3D_GLTF_DATA_URI_VIEW_base64 as i32
    data_ptr_octet = load view+SA3D_GLTF_DATA_URI_VIEW_data_ptr as ptr
    data_first_octet = load data_ptr_octet+0 as u8
    kind_octet = call @sa3d_gltf_buffer_uri_kind(&DATA_URI_OCTET_B64, 41, &view)

    status_gltf = call @sa3d_gltf_data_uri_parse(&DATA_URI_GLTF_RAW, 32, &view)
    mime_len_gltf = load view+SA3D_GLTF_DATA_URI_VIEW_mime_len as i64
    data_len_gltf = load view+SA3D_GLTF_DATA_URI_VIEW_data_len as i64
    base64_gltf = load view+SA3D_GLTF_DATA_URI_VIEW_base64 as i32
    data_ptr_gltf = load view+SA3D_GLTF_DATA_URI_VIEW_data_ptr as ptr
    data_first_gltf = load data_ptr_gltf+0 as u8
    kind_gltf = call @sa3d_gltf_buffer_uri_kind(&DATA_URI_GLTF_RAW, 32, &view)

    kind_text = call @sa3d_gltf_buffer_uri_kind(&DATA_URI_TEXT_B64, 27, &view)
    kind_external = call @sa3d_gltf_buffer_uri_kind(&DATA_URI_EXTERNAL, 10, &view)

    octet_status_ok = eq status_octet, SA3D_GLTF_DATA_URI_STATUS_OK
    octet_mime_len_ok = eq mime_len_octet, 24
    octet_data_len_ok = eq data_len_octet, 4
    octet_base64_ok = eq base64_octet, 1
    octet_data_first_ok = eq data_first_octet, 65
    octet_kind_ok = eq kind_octet, SA3D_GLTF_BUFFER_URI_DATA

    gltf_status_ok = eq status_gltf, SA3D_GLTF_DATA_URI_STATUS_OK
    gltf_mime_len_ok = eq mime_len_gltf, 23
    gltf_data_len_ok = eq data_len_gltf, 3
    gltf_base64_ok = eq base64_gltf, 0
    gltf_data_first_ok = eq data_first_gltf, 114
    gltf_kind_ok = eq kind_gltf, SA3D_GLTF_BUFFER_URI_DATA

    text_kind_ok = eq kind_text, SA3D_GLTF_BUFFER_URI_UNSUPPORTED_DATA_MIME
    external_kind_ok = eq kind_external, SA3D_GLTF_BUFFER_URI_EXTERNAL

    p0 = and octet_status_ok, octet_mime_len_ok
    p1 = and octet_data_len_ok, octet_base64_ok
    p2 = and octet_data_first_ok, octet_kind_ok
    p3 = and gltf_status_ok, gltf_mime_len_ok
    p4 = and gltf_data_len_ok, gltf_base64_ok
    p5 = and gltf_data_first_ok, gltf_kind_ok
    p6 = and text_kind_ok, external_kind_ok
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    r0 = and q0, q1
    r1 = and q2, p6
    ok = and r0, r1

    !view
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3181)

@test "3d_gltf Bevy DataUri decode base64 and raw buffers"():
L_ENTRY:
    out = alloc 8
    out_len = alloc 8
    view = alloc SA3D_GLTF_DATA_URI_VIEW_SIZE

    man_status = call @sa3d_gltf_base64_decode(&BASE64_MAN, 4, &out, 8, &out_len)
    man_len = load out_len+0 as i64
    man0 = load out+0 as u8
    man1 = load out+1 as u8
    man2 = load out+2 as u8

    ma_status = call @sa3d_gltf_base64_decode(&BASE64_MA, 4, &out, 8, &out_len)
    ma_len = load out_len+0 as i64
    ma0 = load out+0 as u8
    ma1 = load out+1 as u8

    m_status = call @sa3d_gltf_base64_decode(&BASE64_M, 4, &out, 8, &out_len)
    m_len = load out_len+0 as i64
    m0 = load out+0 as u8

    invalid_status = call @sa3d_gltf_base64_decode(&BASE64_INVALID_CHAR, 4, &out, 8, &out_len)
    bad_padding_status = call @sa3d_gltf_base64_decode(&BASE64_BAD_PADDING, 4, &out, 8, &out_len)
    small_status = call @sa3d_gltf_base64_decode(&BASE64_MAN, 4, &out, 2, &out_len)

    call @sa3d_gltf_data_uri_parse(&DATA_URI_OCTET_B64, 41, &view)
    uri_b64_status = call @sa3d_gltf_data_uri_decode_to_buffer(&view, &out, 8, &out_len)
    uri_b64_len = load out_len+0 as i64
    uri_b64_0 = load out+0 as u8
    uri_b64_1 = load out+1 as u8
    uri_b64_2 = load out+2 as u8

    call @sa3d_gltf_data_uri_parse(&DATA_URI_GLTF_RAW, 32, &view)
    uri_raw_status = call @sa3d_gltf_data_uri_decode_to_buffer(&view, &out, 8, &out_len)
    uri_raw_len = load out_len+0 as i64
    uri_raw_0 = load out+0 as u8
    uri_raw_1 = load out+1 as u8
    uri_raw_2 = load out+2 as u8

    man_status_ok = eq man_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OK
    man_len_ok = eq man_len, 3
    man0_ok = eq man0, 77
    man1_ok = eq man1, 97
    man2_ok = eq man2, 110
    ma_status_ok = eq ma_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OK
    ma_len_ok = eq ma_len, 2
    ma0_ok = eq ma0, 77
    ma1_ok = eq ma1, 97
    m_status_ok = eq m_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OK
    m_len_ok = eq m_len, 1
    m0_ok = eq m0, 77
    invalid_ok = eq invalid_status, SA3D_GLTF_BUFFER_DECODE_STATUS_INVALID_BASE64_CHAR
    bad_padding_ok = eq bad_padding_status, SA3D_GLTF_BUFFER_DECODE_STATUS_BAD_BASE64_PADDING
    small_ok = eq small_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OUTPUT_TOO_SMALL
    uri_b64_status_ok = eq uri_b64_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OK
    uri_b64_len_ok = eq uri_b64_len, 3
    uri_b64_0_ok = eq uri_b64_0, 0
    uri_b64_1_ok = eq uri_b64_1, 0
    uri_b64_2_ok = eq uri_b64_2, 0
    uri_raw_status_ok = eq uri_raw_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OK
    uri_raw_len_ok = eq uri_raw_len, 3
    uri_raw_0_ok = eq uri_raw_0, 114
    uri_raw_1_ok = eq uri_raw_1, 97
    uri_raw_2_ok = eq uri_raw_2, 119

    p0 = and man_status_ok, man_len_ok
    p1 = and man0_ok, man1_ok
    p2 = and man2_ok, ma_status_ok
    p3 = and ma_len_ok, ma0_ok
    p4 = and ma1_ok, m_status_ok
    p5 = and m_len_ok, m0_ok
    p6 = and invalid_ok, bad_padding_ok
    p7 = and small_ok, uri_b64_status_ok
    p8 = and uri_b64_len_ok, uri_b64_0_ok
    p9 = and uri_b64_1_ok, uri_b64_2_ok
    p10 = and uri_raw_status_ok, uri_raw_len_ok
    p11 = and uri_raw_0_ok, uri_raw_1_ok
    p12 = and uri_raw_2_ok, p11
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    q5 = and p10, p12
    r0 = and q0, q1
    r1 = and q2, q3
    r2 = and q4, q5
    s0 = and r0, r1
    ok = and s0, r2

    !view
    !out_len
    !out
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3182)

@test "3d_gltf Bevy load_buffers source resolution"():
L_ENTRY:
    out = alloc 8
    result = alloc SA3D_GLTF_BUFFER_LOAD_RESULT_SIZE
    blob = alloc 4
    store blob+0, 9 as u8
    store blob+1, 8 as u8
    store blob+2, 7 as u8
    store blob+3, 6 as u8

    bin_status = call @sa3d_gltf_buffer_source_resolve(SA3D_GLTF_BUFFER_SOURCE_BIN, 0, 0, &blob, 4, 1, &out, 8, &result)
    bin_ptr = load result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_ptr as ptr
    bin_len = load result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_len as i64
    bin_first = load bin_ptr+0 as u8
    bin_kind = load result+SA3D_GLTF_BUFFER_LOAD_RESULT_source_kind as i32

    missing_status = call @sa3d_gltf_buffer_source_resolve(SA3D_GLTF_BUFFER_SOURCE_BIN, 0, 0, 0, 0, 0, &out, 8, &result)

    data_status = call @sa3d_gltf_buffer_source_resolve(SA3D_GLTF_BUFFER_SOURCE_URI, &DATA_URI_GLTF_RAW, 32, 0, 0, 0, &out, 8, &result)
    data_ptr = load result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_ptr as ptr
    data_len = load result+SA3D_GLTF_BUFFER_LOAD_RESULT_bytes_len as i64
    data_first = load data_ptr+0 as u8
    data_decode_status = load result+SA3D_GLTF_BUFFER_LOAD_RESULT_decode_status as i32

    external_status = call @sa3d_gltf_buffer_source_resolve(SA3D_GLTF_BUFFER_SOURCE_URI, &DATA_URI_EXTERNAL, 10, 0, 0, 0, &out, 8, &result)
    external_ptr = load result+SA3D_GLTF_BUFFER_LOAD_RESULT_external_uri_ptr as ptr
    external_len = load result+SA3D_GLTF_BUFFER_LOAD_RESULT_external_uri_len as i64
    external_first = load external_ptr+0 as u8

    unsupported_status = call @sa3d_gltf_buffer_source_resolve(SA3D_GLTF_BUFFER_SOURCE_URI, &DATA_URI_TEXT_B64, 27, 0, 0, 0, &out, 8, &result)
    small_status = call @sa3d_gltf_buffer_source_resolve(SA3D_GLTF_BUFFER_SOURCE_URI, &DATA_URI_GLTF_RAW, 32, 0, 0, 0, &out, 2, &result)
    small_decode_status = load result+SA3D_GLTF_BUFFER_LOAD_RESULT_decode_status as i32
    invalid_status = call @sa3d_gltf_buffer_source_resolve(99, 0, 0, 0, 0, 0, &out, 8, &result)

    bin_status_ok = eq bin_status, SA3D_GLTF_BUFFER_LOAD_STATUS_OK
    bin_len_ok = eq bin_len, 4
    bin_first_ok = eq bin_first, 9
    bin_kind_ok = eq bin_kind, SA3D_GLTF_BUFFER_SOURCE_BIN
    missing_ok = eq missing_status, SA3D_GLTF_BUFFER_LOAD_STATUS_MISSING_BLOB
    data_status_ok = eq data_status, SA3D_GLTF_BUFFER_LOAD_STATUS_OK
    data_len_ok = eq data_len, 3
    data_first_ok = eq data_first, 114
    data_decode_ok = eq data_decode_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OK
    external_status_ok = eq external_status, SA3D_GLTF_BUFFER_LOAD_STATUS_EXTERNAL_URI
    external_len_ok = eq external_len, 10
    external_first_ok = eq external_first, 98
    unsupported_ok = eq unsupported_status, SA3D_GLTF_BUFFER_LOAD_STATUS_UNSUPPORTED_DATA_MIME
    small_status_ok = eq small_status, SA3D_GLTF_BUFFER_LOAD_STATUS_OUTPUT_TOO_SMALL
    small_decode_ok = eq small_decode_status, SA3D_GLTF_BUFFER_DECODE_STATUS_OUTPUT_TOO_SMALL
    invalid_ok = eq invalid_status, SA3D_GLTF_BUFFER_LOAD_STATUS_INVALID_SOURCE

    p0 = and bin_status_ok, bin_len_ok
    p1 = and bin_first_ok, bin_kind_ok
    p2 = and missing_ok, data_status_ok
    p3 = and data_len_ok, data_first_ok
    p4 = and data_decode_ok, external_status_ok
    p5 = and external_len_ok, external_first_ok
    p6 = and unsupported_ok, small_status_ok
    p7 = and small_decode_ok, invalid_ok
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    r0 = and q0, q1
    r1 = and q2, q3
    ok = and r0, r1

    !blob
    !result
    !out
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3183)

@test "3d_gltf import result init"():
