    extras_eq = call @gltf_test_bytes_eq(&extras_ptr0, extras_len0, &EXPECT_NODE_EXTRAS, 15)

    status2 = call @sa3d_gltf_json_node_parse(&JSON_NODE_TABLE, 201, 2, &node2)
    fallback_len = call @sa3d_gltf_node_name_to_bytes(2, 0, 0, &name_buf, 32)
    fallback_eq = call @gltf_test_bytes_eq(&name_buf, fallback_len, &EXPECT_NODE2_FALLBACK, 9)
    transform2 = ptr_add node2, SA3D_GLTF_NODE_TABLE_transform
    translation2 = ptr_add transform2, SA3D_TRANSFORM3D_translation
    rotation2 = ptr_add transform2, SA3D_TRANSFORM3D_rotation
    scale2 = ptr_add transform2, SA3D_TRANSFORM3D_scale
    t2x = load translation2+SA3D_VEC3_x as i32
    r2w = load rotation2+SA3D_QUAT_w as i32
    s2x = load scale2+SA3D_VEC3_x as i32

    matrix_status = call @sa3d_gltf_json_node_parse(&JSON_NODE_MATRIX, 88, 0, &matrix_node)
    matrix_table_status = load matrix_node+SA3D_GLTF_NODE_TABLE_status as i32
