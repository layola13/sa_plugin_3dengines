@test "3d_gltf Bevy material transmission and volume extensions"():
L_ENTRY:
    material = alloc SA3D_GLTF_MATERIAL_TABLE_SIZE
    missing = alloc SA3D_GLTF_MATERIAL_TABLE_SIZE
    bad_transmission = alloc SA3D_GLTF_MATERIAL_TABLE_SIZE
    bad_volume = alloc SA3D_GLTF_MATERIAL_TABLE_SIZE

    status = call @sa3d_gltf_json_material_table_parse(&JSON_MATERIAL_TRANSMISSION_VOLUME, 289, 0, &material)
    missing_status = call @sa3d_gltf_json_material_table_parse(&JSON_MATERIAL_TRANSMISSION_VOLUME, 289, 1, &missing)
    bad_transmission_status = call @sa3d_gltf_json_material_table_parse(&JSON_MATERIAL_TRANSMISSION_BAD, 88, 0, &bad_transmission)
    bad_volume_status = call @sa3d_gltf_json_material_table_parse(&JSON_MATERIAL_VOLUME_BAD, 90, 0, &bad_volume)

    transmission = load material+SA3D_GLTF_MATERIAL_TABLE_specular_transmission as i32
    has_transmission = load material+SA3D_GLTF_MATERIAL_TABLE_has_specular_transmission as i32
    has_transmission_texture = load material+SA3D_GLTF_MATERIAL_TABLE_has_specular_transmission_texture as i32
    transmission_texture = load material+SA3D_GLTF_MATERIAL_TABLE_specular_transmission_texture as i64
    transmission_uv = load material+SA3D_GLTF_MATERIAL_TABLE_specular_transmission_uv as i32
    thickness = load material+SA3D_GLTF_MATERIAL_TABLE_thickness as i32
    has_thickness = load material+SA3D_GLTF_MATERIAL_TABLE_has_thickness as i32
    has_thickness_texture = load material+SA3D_GLTF_MATERIAL_TABLE_has_thickness_texture as i32
    thickness_texture = load material+SA3D_GLTF_MATERIAL_TABLE_thickness_texture as i64
    thickness_uv = load material+SA3D_GLTF_MATERIAL_TABLE_thickness_uv as i32
    attenuation_distance = load material+SA3D_GLTF_MATERIAL_TABLE_attenuation_distance as i32
    has_attenuation_distance = load material+SA3D_GLTF_MATERIAL_TABLE_has_attenuation_distance as i32
    attenuation_r = load material+SA3D_GLTF_MATERIAL_TABLE_attenuation_color_r as i32
    attenuation_g = load material+SA3D_GLTF_MATERIAL_TABLE_attenuation_color_g as i32
    attenuation_b = load material+SA3D_GLTF_MATERIAL_TABLE_attenuation_color_b as i32
    has_attenuation_color = load material+SA3D_GLTF_MATERIAL_TABLE_has_attenuation_color as i32
    texture_mask = load material+SA3D_GLTF_MATERIAL_TABLE_texture_mask as i32
    linear_mask = load material+SA3D_GLTF_MATERIAL_TABLE_linear_texture_mask as i32

    default_transmission = load missing+SA3D_GLTF_MATERIAL_TABLE_specular_transmission as i32
    default_has_transmission = load missing+SA3D_GLTF_MATERIAL_TABLE_has_specular_transmission as i32
    default_distance = load missing+SA3D_GLTF_MATERIAL_TABLE_attenuation_distance as i32
    default_color_r = load missing+SA3D_GLTF_MATERIAL_TABLE_attenuation_color_r as i32
    default_has_color = load missing+SA3D_GLTF_MATERIAL_TABLE_has_attenuation_color as i32

    status_ok = eq status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    missing_status_ok = eq missing_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    bad_transmission_ok = eq bad_transmission_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON
    bad_volume_ok = eq bad_volume_status, SA3D_GLTF_JSON_TABLE_STATUS_MALFORMED_JSON
    transmission_ok = eq transmission, SA3D_GLTF_ALPHA_CUTOFF_DEFAULT_BITS
    has_transmission_ok = eq has_transmission, 1
    has_transmission_texture_ok = eq has_transmission_texture, 1
    transmission_texture_ok = eq transmission_texture, 7
    transmission_uv_ok = eq transmission_uv, SA3D_GLTF_UV_CHANNEL_UV1
    thickness_ok = eq thickness, 1073741824
    has_thickness_ok = eq has_thickness, 1
    has_thickness_texture_ok = eq has_thickness_texture, 1
    thickness_texture_ok = eq thickness_texture, 8
    thickness_uv_ok = eq thickness_uv, SA3D_GLTF_UV_CHANNEL_UV0
    attenuation_distance_ok = eq attenuation_distance, 1077936128
    has_attenuation_distance_ok = eq has_attenuation_distance, 1
    attenuation_r_ok = eq attenuation_r, 1048576000
    attenuation_g_ok = eq attenuation_g, SA3D_GLTF_ALPHA_CUTOFF_DEFAULT_BITS
    attenuation_b_ok = eq attenuation_b, SA3D_F32_ONE_BITS
    has_attenuation_color_ok = eq has_attenuation_color, 1
    texture_mask_ok = eq texture_mask, 96
    linear_mask_ok = eq linear_mask, 0
    default_transmission_ok = eq default_transmission, 0
    default_has_transmission_ok = eq default_has_transmission, 0
    default_distance_ok = eq default_distance, 2139095040
    default_color_r_ok = eq default_color_r, SA3D_F32_ONE_BITS
    default_has_color_ok = eq default_has_color, 0

    p0 = and status_ok, missing_status_ok
    p1 = and bad_transmission_ok, bad_volume_ok
    p2 = and transmission_ok, has_transmission_ok
    p3 = and has_transmission_texture_ok, transmission_texture_ok
    p4 = and transmission_uv_ok, thickness_ok
    p5 = and has_thickness_ok, has_thickness_texture_ok
    p6 = and thickness_texture_ok, thickness_uv_ok
    p7 = and attenuation_distance_ok, has_attenuation_distance_ok
    p8 = and attenuation_r_ok, attenuation_g_ok
    p9 = and attenuation_b_ok, has_attenuation_color_ok
    p10 = and texture_mask_ok, linear_mask_ok
    p11 = and default_transmission_ok, default_has_transmission_ok
    p12 = and default_distance_ok, default_color_r_ok
    p13 = and default_has_color_ok, p12
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    q5 = and p10, p11
    r0 = and q0, q1
    r1 = and q2, q3
    r2 = and q4, q5
    s0 = and r0, r1
    s1 = and r2, p13
    ok = and s0, s1

    !bad_volume
    !bad_transmission
    !missing
    !material
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3200)

@test "3d_gltf Bevy material specular extension"():
L_ENTRY:
    material = alloc SA3D_GLTF_MATERIAL_TABLE_SIZE
    missing = alloc SA3D_GLTF_MATERIAL_TABLE_SIZE
    bad = alloc SA3D_GLTF_MATERIAL_TABLE_SIZE

    status = call @sa3d_gltf_json_material_table_parse(&JSON_MATERIAL_SPECULAR, 212, 0, &material)
    missing_status = call @sa3d_gltf_json_material_table_parse(&JSON_MATERIAL_SPECULAR, 212, 1, &missing)
