@test "3d_gltf import result counts and load flags"():
L_ENTRY:
    r = alloc SA3D_GLTF_IMPORT_RESULT_SIZE
    call @sa3d_gltf_import_result_init(&r)
    call @sa3d_gltf_import_result_set_counts(&r, 2, 3, 4, 5)
    total = call @sa3d_gltf_import_result_total_assets(&r)
    total_ok = eq total, 14
    br total_ok -> L_STEP2, L_ERR
L_STEP2:
    flags = or SA3D_GLTF_LOAD_MATERIALS, SA3D_GLTF_LOAD_ANIMATIONS
    call @sa3d_gltf_import_result_apply_load_flags(&r, flags)
    call @sa3d_gltf_import_result_set_extended_counts(&r, 1, 2, 3)
    meshes = call @sa3d_gltf_import_result_get_mesh_count(&r)
    mats = load r+SA3D_GLTF_IMPORT_RESULT_material_count as i64
    anims = load r+SA3D_GLTF_IMPORT_RESULT_animation_count as i64
    scene = load r+SA3D_GLTF_IMPORT_RESULT_scene_handle as i64
    scenes = load r+SA3D_GLTF_IMPORT_RESULT_scene_count as i64
    skins = load r+SA3D_GLTF_IMPORT_RESULT_skin_count as i64
    nodes = load r+SA3D_GLTF_IMPORT_RESULT_node_count as i64
    meshes_ok = eq meshes, 0
    mats_ok = eq mats, 1
    anims_ok = eq anims, 1
    scene_ok = eq scene, 0
    scenes_ok = eq scenes, 1
    skins_ok = eq skins, 2
    nodes_ok = eq nodes, 3
    a = and meshes_ok, mats_ok
    b = and anims_ok, scene_ok
    c = and scenes_ok, skins_ok
    d = and nodes_ok, c
    ok = and a, b
    ok2 = and d, ok
    !r
    br ok2 -> L_OK, L_ERR2
L_OK:
    return 0
L_ERR:
    !r
    panic(3154)
L_ERR2:
    panic(3155)

@test "3d_gltf Bevy document summary counts root arrays"():
L_ENTRY:
    summary = alloc SA3D_GLTF_DOCUMENT_SUMMARY_SIZE
    bad_summary = alloc SA3D_GLTF_DOCUMENT_SUMMARY_SIZE

    status = call @sa3d_gltf_document_summary_from_json(&JSON_DOC_SUMMARY, 379, &summary)
    scenes = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_scene_count as i64
    nodes = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_node_count as i64
    meshes = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_mesh_count as i64
    materials = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_material_count as i64
    images = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_image_count as i64
    textures = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_texture_count as i64
    animations = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_animation_count as i64
    skins = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_skin_count as i64
    cameras = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_camera_count as i64
    buffers = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_buffer_count as i64
    buffer_views = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_buffer_view_count as i64
    accessors = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_accessor_count as i64
    field_status = load summary+SA3D_GLTF_DOCUMENT_SUMMARY_status as i32
    meshes_direct = call @sa3d_gltf_json_root_array_item_count(&JSON_DOC_SUMMARY, 379, &SA3D_GLTF_JSON_KEY_MESHES, 6)
    bad_status = call @sa3d_gltf_document_summary_from_json(&JSON_DOC_BAD, 1, &bad_summary)
    bad_field_status = load bad_summary+SA3D_GLTF_DOCUMENT_SUMMARY_status as i32

    status_ok = eq status, SA3D_GLTF_DOCUMENT_STATUS_OK
    scenes_ok = eq scenes, 2
    nodes_ok = eq nodes, 2
    meshes_ok = eq meshes, 1
    materials_ok = eq materials, 2
    images_ok = eq images, 1
    textures_ok = eq textures, 1
    animations_ok = eq animations, 0
    skins_ok = eq skins, 1
    cameras_ok = eq cameras, 1
    buffers_ok = eq buffers, 1
    buffer_views_ok = eq buffer_views, 2
    accessors_ok = eq accessors, 3
    field_status_ok = eq field_status, SA3D_GLTF_DOCUMENT_STATUS_OK
    meshes_direct_ok = eq meshes_direct, 1
    bad_status_ok = eq bad_status, SA3D_GLTF_DOCUMENT_STATUS_MALFORMED_JSON
    bad_field_status_ok = eq bad_field_status, SA3D_GLTF_DOCUMENT_STATUS_MALFORMED_JSON

    p0 = and status_ok, scenes_ok
    p1 = and nodes_ok, meshes_ok
    p2 = and materials_ok, images_ok
    p3 = and textures_ok, animations_ok
    p4 = and skins_ok, cameras_ok
    p5 = and buffer_views_ok, accessors_ok
    p6a = and buffers_ok, field_status_ok
    p6 = and p6a, meshes_direct_ok
    p7 = and bad_status_ok, bad_field_status_ok
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    r0 = and q0, q1
    r1 = and q2, q3
    ok = and r0, r1

    !bad_summary
    !summary
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3190)

@test "3d_gltf Bevy JSON buffer bufferView accessor tables"():
L_ENTRY:
    buffer0 = alloc SA3D_GLTF_BUFFER_TABLE_SIZE
    buffer1 = alloc SA3D_GLTF_BUFFER_TABLE_SIZE
    view0 = alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    view1 = alloc SA3D_GLTF_BUFFER_VIEW_TABLE_SIZE
    accessor0 = alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    accessor1 = alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE
    accessor2 = alloc SA3D_GLTF_ACCESSOR_TABLE_SIZE

    buffer0_status = call @sa3d_gltf_json_buffer_parse(&JSON_TABLES, 393, 0, &buffer0)
    buffer0_uri = load buffer0+SA3D_GLTF_BUFFER_TABLE_URI_ptr as ptr
    buffer0_uri_len = load buffer0+SA3D_GLTF_BUFFER_TABLE_URI_len as i64
    buffer0_byte_len = load buffer0+SA3D_GLTF_BUFFER_TABLE_byte_len as i64
    buffer0_has_uri = load buffer0+SA3D_GLTF_BUFFER_TABLE_has_uri as i32
    buffer0_uri_eq = call @gltf_test_bytes_eq(&buffer0_uri, buffer0_uri_len, &EXPECT_BUFFER_BIN, 10)
    buffer1_status = call @sa3d_gltf_json_buffer_parse(&JSON_TABLES, 393, 1, &buffer1)
    buffer1_byte_len = load buffer1+SA3D_GLTF_BUFFER_TABLE_byte_len as i64
    buffer1_has_uri = load buffer1+SA3D_GLTF_BUFFER_TABLE_has_uri as i32

    view0_status = call @sa3d_gltf_json_buffer_view_parse(&JSON_TABLES, 393, 0, &view0)
    view0_buffer = load view0+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer as i64
    view0_offset = load view0+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset as i64
    view0_len = load view0+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len as i64
    view0_stride = load view0+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride as i64
    view0_has_stride = load view0+SA3D_GLTF_BUFFER_VIEW_TABLE_has_stride as i32
    view1_status = call @sa3d_gltf_json_buffer_view_parse(&JSON_TABLES, 393, 1, &view1)
    view1_buffer = load view1+SA3D_GLTF_BUFFER_VIEW_TABLE_buffer as i64
    view1_offset = load view1+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_offset as i64
    view1_len = load view1+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_len as i64
    view1_stride = load view1+SA3D_GLTF_BUFFER_VIEW_TABLE_byte_stride as i64
    view1_has_stride = load view1+SA3D_GLTF_BUFFER_VIEW_TABLE_has_stride as i32

    accessor0_status = call @sa3d_gltf_json_accessor_parse(&JSON_TABLES, 393, 0, &accessor0)
    accessor0_bv = load accessor0+SA3D_GLTF_ACCESSOR_TABLE_buffer_view as i32
    accessor0_has_bv = load accessor0+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view as i32
    accessor0_offset = load accessor0+SA3D_GLTF_ACCESSOR_TABLE_byte_offset as i64
    accessor0_count = load accessor0+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    accessor0_component = load accessor0+SA3D_GLTF_ACCESSOR_TABLE_component_type as i32
    accessor0_dim = load accessor0+SA3D_GLTF_ACCESSOR_TABLE_dimension as i32
    accessor0_norm = load accessor0+SA3D_GLTF_ACCESSOR_TABLE_normalized as i32
    accessor0_format = load accessor0+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32

    accessor1_status = call @sa3d_gltf_json_accessor_parse(&JSON_TABLES, 393, 1, &accessor1)
    accessor1_bv = load accessor1+SA3D_GLTF_ACCESSOR_TABLE_buffer_view as i32
    accessor1_count = load accessor1+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    accessor1_component = load accessor1+SA3D_GLTF_ACCESSOR_TABLE_component_type as i32
    accessor1_dim = load accessor1+SA3D_GLTF_ACCESSOR_TABLE_dimension as i32
    accessor1_norm = load accessor1+SA3D_GLTF_ACCESSOR_TABLE_normalized as i32
    accessor1_format = load accessor1+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32

    accessor2_status = call @sa3d_gltf_json_accessor_parse(&JSON_TABLES, 393, 2, &accessor2)
    accessor2_has_bv = load accessor2+SA3D_GLTF_ACCESSOR_TABLE_has_buffer_view as i32
    accessor2_count = load accessor2+SA3D_GLTF_ACCESSOR_TABLE_count as i64
    accessor2_dim = load accessor2+SA3D_GLTF_ACCESSOR_TABLE_dimension as i32
    accessor2_format = load accessor2+SA3D_GLTF_ACCESSOR_TABLE_accessor_format as i32

    buffer0_status_ok = eq buffer0_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    buffer0_uri_eq_ok = eq buffer0_uri_eq, 1
    buffer0_byte_len_ok = eq buffer0_byte_len, 96
    buffer0_has_uri_ok = eq buffer0_has_uri, 1
    buffer1_status_ok = eq buffer1_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    buffer1_byte_len_ok = eq buffer1_byte_len, 32
    buffer1_has_uri_ok = eq buffer1_has_uri, 0

    view0_status_ok = eq view0_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    view0_buffer_ok = eq view0_buffer, 0
    view0_offset_ok = eq view0_offset, 4
    view0_len_ok = eq view0_len, 48
    view0_stride_ok = eq view0_stride, 12
    view0_has_stride_ok = eq view0_has_stride, 1
    view1_status_ok = eq view1_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    view1_buffer_ok = eq view1_buffer, 1
    view1_offset_ok = eq view1_offset, 0
    view1_len_ok = eq view1_len, 16
    view1_stride_ok = eq view1_stride, 0
    view1_has_stride_ok = eq view1_has_stride, 0

    accessor0_status_ok = eq accessor0_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    accessor0_bv_ok = eq accessor0_bv, 0
    accessor0_has_bv_ok = eq accessor0_has_bv, 1
    accessor0_offset_ok = eq accessor0_offset, 4
    accessor0_count_ok = eq accessor0_count, 3
    accessor0_component_ok = eq accessor0_component, SA3D_GLTF_COMPONENT_F32
    accessor0_dim_ok = eq accessor0_dim, SA3D_GLTF_DIM_VEC3
    accessor0_norm_ok = eq accessor0_norm, 0
    accessor0_format_ok = eq accessor0_format, SA3D_GLTF_ACCESSOR_F32X3

    accessor1_status_ok = eq accessor1_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    accessor1_bv_ok = eq accessor1_bv, 1
    accessor1_count_ok = eq accessor1_count, 4
    accessor1_component_ok = eq accessor1_component, SA3D_GLTF_COMPONENT_U8
    accessor1_dim_ok = eq accessor1_dim, SA3D_GLTF_DIM_VEC4
    accessor1_norm_ok = eq accessor1_norm, 1
    accessor1_format_ok = eq accessor1_format, SA3D_GLTF_ACCESSOR_U8X4

    accessor2_status_ok = eq accessor2_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    accessor2_has_bv_ok = eq accessor2_has_bv, 0
    accessor2_count_ok = eq accessor2_count, 6
    accessor2_dim_ok = eq accessor2_dim, SA3D_GLTF_DIM_SCALAR
    accessor2_format_ok = eq accessor2_format, SA3D_GLTF_ACCESSOR_U16_SCALAR

    p0 = and buffer0_status_ok, buffer0_uri_eq_ok
    p1 = and buffer0_byte_len_ok, buffer0_has_uri_ok
    p2 = and buffer1_status_ok, buffer1_byte_len_ok
    p3 = and buffer1_has_uri_ok, view0_status_ok
    p4 = and view0_buffer_ok, view0_offset_ok
    p5 = and view0_len_ok, view0_stride_ok
    p6 = and view0_has_stride_ok, view1_status_ok
    p7 = and view1_buffer_ok, view1_offset_ok
    p8 = and view1_len_ok, view1_stride_ok
    p9 = and view1_has_stride_ok, accessor0_status_ok
    p10 = and accessor0_bv_ok, accessor0_has_bv_ok
    p11 = and accessor0_offset_ok, accessor0_count_ok
    p12 = and accessor0_component_ok, accessor0_dim_ok
    p13 = and accessor0_norm_ok, accessor0_format_ok
    p14 = and accessor1_status_ok, accessor1_bv_ok
    p15 = and accessor1_count_ok, accessor1_component_ok
    p16 = and accessor1_dim_ok, accessor1_norm_ok
    p17 = and accessor1_format_ok, accessor2_status_ok
    p18 = and accessor2_has_bv_ok, accessor2_count_ok
    p19 = and accessor2_dim_ok, accessor2_format_ok
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    q5 = and p10, p11
    q6 = and p12, p13
    q7 = and p14, p15
    q8 = and p16, p17
    q9 = and p18, p19
    r0 = and q0, q1
    r1 = and q2, q3
    r2 = and q4, q5
    r3 = and q6, q7
    r4 = and q8, q9
    s0 = and r0, r1
    s1 = and r2, r3
    s2 = and s0, s1
    ok = and s2, r4

    !accessor2
    !accessor1
    !accessor0
    !view1
    !view0
    !buffer1
    !buffer0
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3191)

@test "3d_gltf Bevy mesh morph targets and weights JSON tables"():
L_ENTRY:
    mesh = alloc SA3D_GLTF_MESH_TABLE_SIZE
    primitive = alloc SA3D_GLTF_PRIMITIVE_TABLE_SIZE
    target0 = alloc SA3D_GLTF_MORPH_TARGET_TABLE_SIZE
    target1 = alloc SA3D_GLTF_MORPH_TARGET_TABLE_SIZE
    node = alloc SA3D_GLTF_NODE_TABLE_SIZE
    name_ptr_slot = alloc 8
    name_len_slot = alloc 8

    mesh_status = call @sa3d_gltf_json_mesh_parse(&JSON_MORPH_TARGETS, 607, 0, &mesh)
    primitive_status = call @sa3d_gltf_json_primitive_parse(&JSON_MORPH_TARGETS, 607, 0, 0, &primitive)
    target0_status = call @sa3d_gltf_json_primitive_morph_target_parse(&JSON_MORPH_TARGETS, 607, 0, 0, 0, &target0)
    target1_status = call @sa3d_gltf_json_primitive_morph_target_parse(&JSON_MORPH_TARGETS, 607, 0, 0, 1, &target1)
    node_status = call @sa3d_gltf_json_node_parse(&JSON_MORPH_TARGETS, 607, 0, &node)
    names_pos = call @sa3d_gltf_json_mesh_morph_target_names_array_pos(&JSON_MORPH_TARGETS, 607, 0)
    names_count = call @sa3d_gltf_json_mesh_morph_target_name_count(&JSON_MORPH_TARGETS, 607, 0)
    name0_status = call @sa3d_gltf_json_mesh_morph_target_name_span(&JSON_MORPH_TARGETS, 607, 0, 0, &name_ptr_slot, &name_len_slot)
    name0_ptr = load name_ptr_slot+0 as ptr
    name0_len = load name_len_slot+0 as i64
    name0_eq = call @gltf_test_bytes_eq(&name0_ptr, name0_len, &EXPECT_MORPH_NAME_SMILE, 5)
    name1_status = call @sa3d_gltf_json_mesh_morph_target_name_span(&JSON_MORPH_TARGETS, 607, 0, 1, &name_ptr_slot, &name_len_slot)
    name1_ptr = load name_ptr_slot+0 as ptr
    name1_len = load name_len_slot+0 as i64
    name1_eq = call @gltf_test_bytes_eq(&name1_ptr, name1_len, &EXPECT_MORPH_NAME_BLINK, 5)
    out_of_range_status = call @sa3d_gltf_json_mesh_morph_target_name_span(&JSON_MORPH_TARGETS, 607, 0, 2, &name_ptr_slot, &name_len_slot)
    missing_count = call @sa3d_gltf_json_mesh_morph_target_name_count(&JSON_PRIMITIVE_MESH, 485, 0)
    missing_span_status = call @sa3d_gltf_json_mesh_morph_target_name_span(&JSON_PRIMITIVE_MESH, 485, 0, 0, &name_ptr_slot, &name_len_slot)
    bad_names_pos = call @sa3d_gltf_json_mesh_morph_target_names_array_pos(&JSON_MORPH_TARGET_NAMES_BAD, 86, 0)
    bad_count = call @sa3d_gltf_json_mesh_morph_target_name_count(&JSON_MORPH_TARGET_NAMES_BAD, 86, 0)
    bad_span_status = call @sa3d_gltf_json_mesh_morph_target_name_span(&JSON_MORPH_TARGET_NAMES_BAD, 86, 0, 0, &name_ptr_slot, &name_len_slot)

    mesh_primitive_count = load mesh+SA3D_GLTF_MESH_TABLE_primitive_count as i64
    mesh_has_weights = load mesh+SA3D_GLTF_MESH_TABLE_has_weights as i32
    mesh_weight_count = load mesh+SA3D_GLTF_MESH_TABLE_weight_count as i64
    mesh_has_extras = load mesh+SA3D_GLTF_MESH_TABLE_has_extras as i32
    primitive_target_count = load primitive+SA3D_GLTF_PRIMITIVE_TABLE_target_count as i64
    target0_has_position = load target0+SA3D_GLTF_MORPH_TARGET_TABLE_has_position as i32
    target0_position = load target0+SA3D_GLTF_MORPH_TARGET_TABLE_position as i64
    target0_has_normal = load target0+SA3D_GLTF_MORPH_TARGET_TABLE_has_normal as i32
    target0_normal = load target0+SA3D_GLTF_MORPH_TARGET_TABLE_normal as i64
    target0_has_tangent = load target0+SA3D_GLTF_MORPH_TARGET_TABLE_has_tangent as i32
    target0_count = load target0+SA3D_GLTF_MORPH_TARGET_TABLE_attribute_count as i64
    target1_has_tangent = load target1+SA3D_GLTF_MORPH_TARGET_TABLE_has_tangent as i32
    target1_tangent = load target1+SA3D_GLTF_MORPH_TARGET_TABLE_tangent as i64
    target1_count = load target1+SA3D_GLTF_MORPH_TARGET_TABLE_attribute_count as i64
    node_has_mesh = load node+SA3D_GLTF_NODE_TABLE_has_mesh as i32
    node_mesh = load node+SA3D_GLTF_NODE_TABLE_mesh as i64
    node_has_weights = load node+SA3D_GLTF_NODE_TABLE_has_weights as i32
    node_weight_count = load node+SA3D_GLTF_NODE_TABLE_weight_count as i64

    q0 = eq mesh_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q1 = eq primitive_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q2 = eq target0_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q3 = eq target1_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q4 = eq node_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q5 = eq mesh_primitive_count, 1
    q6 = eq mesh_has_weights, 1
    q7 = eq mesh_weight_count, 2
    q8 = eq mesh_has_extras, 1
    q9 = eq primitive_target_count, 2
    q10 = eq target0_has_position, 1
    q11 = eq target0_position, 0
    q12 = eq target0_has_normal, 1
    q13 = eq target0_normal, 1
    q14 = eq target0_has_tangent, 0
    q15 = eq target0_count, 2
    q16 = eq target1_has_tangent, 1
    q17 = eq target1_tangent, 2
    q18 = eq target1_count, 1
    q19 = eq node_has_mesh, 1
    q20 = eq node_mesh, 0
    q21 = eq node_has_weights, 1
    q22 = eq node_weight_count, 1
    q23 = sge names_pos, 0
    q24 = eq names_count, 2
    q25 = eq name0_status, 1
    q26 = eq name0_eq, 1
    q27 = eq name1_status, 1
    q28 = eq name1_eq, 1
    q29 = eq out_of_range_status, 0
    q30 = eq missing_count, 0
    q31 = eq missing_span_status, 0
    q32 = eq bad_names_pos, -2
    q33 = eq bad_count, -2
    q34 = eq bad_span_status, -1

    p0 = and q0, q1
    p1 = and q2, q3
    p2 = and q4, q5
    p3 = and q6, q7
    p4 = and q8, q9
    p5 = and q10, q11
