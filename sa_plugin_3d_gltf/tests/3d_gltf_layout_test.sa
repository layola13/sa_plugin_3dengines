@test "3d_gltf Bevy asset labels render exactly"():
L_ENTRY:
    label = alloc SA3D_GLTF_ASSET_LABEL_SIZE
    buf = alloc 96

    call @sa3d_gltf_asset_label_scene(&label, 7)
    len_scene = call @sa3d_gltf_asset_label_to_bytes(&label, &buf, 96)
    scene_eq = call @gltf_test_bytes_eq(&buf, len_scene, &EXPECT_SCENE7, 6)
    scene_ok = eq scene_eq, 1
    br scene_ok -> L_PRIMITIVE, L_ERR_SCENE

L_PRIMITIVE:
    call @sa3d_gltf_asset_label_primitive(&label, 2, 5)
    len_primitive = call @sa3d_gltf_asset_label_to_bytes(&label, &buf, 96)
    primitive_eq = call @gltf_test_bytes_eq(&buf, len_primitive, &EXPECT_PRIMITIVE, 16)
    primitive_ok = eq primitive_eq, 1
    br primitive_ok -> L_MATERIAL, L_ERR_PRIMITIVE

L_MATERIAL:
    call @sa3d_gltf_asset_label_material(&label, 3, 1)
    len_material = call @sa3d_gltf_asset_label_to_bytes(&label, &buf, 96)
    material_eq = call @gltf_test_bytes_eq(&buf, len_material, &EXPECT_MATERIAL_INVERTED, 20)
    material_ok = eq material_eq, 1
    br material_ok -> L_DEFAULT, L_ERR_MATERIAL

L_DEFAULT:
    call @sa3d_gltf_asset_label_default_material(&label)
    len_default = call @sa3d_gltf_asset_label_to_bytes(&label, &buf, 96)
    default_eq = call @gltf_test_bytes_eq(&buf, len_default, &EXPECT_DEFAULT_MATERIAL, 15)
    default_ok = eq default_eq, 1
    br default_ok -> L_IBM, L_ERR_DEFAULT

L_IBM:
    call @sa3d_gltf_asset_label_inverse_bind_matrices(&label, 4)
    len_ibm = call @sa3d_gltf_asset_label_to_bytes(&label, &buf, 96)
    ibm_eq = call @gltf_test_bytes_eq(&buf, len_ibm, &EXPECT_IBM, 25)
    ibm_ok = eq ibm_eq, 1
    !label
    !buf
    br ibm_ok -> L_OK, L_ERR_IBM

L_OK:
    return 0
L_ERR_SCENE:
    !label
    !buf
    panic(3156)
L_ERR_PRIMITIVE:
    !label
    !buf
    panic(3157)
L_ERR_MATERIAL:
    !label
    !buf
    panic(3158)
L_ERR_DEFAULT:
    !label
    !buf
    panic(3159)
L_ERR_IBM:
    panic(3160)

@test "3d_gltf Bevy asset label from_asset path"():
L_ENTRY:
    label = alloc SA3D_GLTF_ASSET_LABEL_SIZE
