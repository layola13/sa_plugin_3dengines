@test "3d_gltf Bevy image source JSON table"():
L_ENTRY:
    image0 = alloc SA3D_GLTF_IMAGE_TABLE_SIZE
    image1 = alloc SA3D_GLTF_IMAGE_TABLE_SIZE
    image2 = alloc SA3D_GLTF_IMAGE_TABLE_SIZE

    status0 = call @sa3d_gltf_json_image_table_parse(&JSON_IMAGE_TABLE, 95, 0, &image0)
    status1 = call @sa3d_gltf_json_image_table_parse(&JSON_IMAGE_TABLE, 95, 1, &image1)
    status2 = call @sa3d_gltf_json_image_table_parse(&JSON_IMAGE_TABLE, 95, 2, &image2)

    kind0 = load image0+SA3D_GLTF_IMAGE_TABLE_source_kind as i32
    uri0 = load image0+SA3D_GLTF_IMAGE_TABLE_uri_ptr as ptr
    uri0_len = load image0+SA3D_GLTF_IMAGE_TABLE_uri_len as i64
    mime0 = load image0+SA3D_GLTF_IMAGE_TABLE_mime_ptr as ptr
    mime0_len = load image0+SA3D_GLTF_IMAGE_TABLE_mime_len as i64
    has_uri0 = load image0+SA3D_GLTF_IMAGE_TABLE_has_uri as i32
    has_view0 = load image0+SA3D_GLTF_IMAGE_TABLE_has_buffer_view as i32
    has_mime0 = load image0+SA3D_GLTF_IMAGE_TABLE_has_mime as i32
    table_status0 = load image0+SA3D_GLTF_IMAGE_TABLE_status as i32

    kind1 = load image1+SA3D_GLTF_IMAGE_TABLE_source_kind as i32
    view1 = load image1+SA3D_GLTF_IMAGE_TABLE_buffer_view as i64
    mime1 = load image1+SA3D_GLTF_IMAGE_TABLE_mime_ptr as ptr
    mime1_len = load image1+SA3D_GLTF_IMAGE_TABLE_mime_len as i64
    has_uri1 = load image1+SA3D_GLTF_IMAGE_TABLE_has_uri as i32
    has_view1 = load image1+SA3D_GLTF_IMAGE_TABLE_has_buffer_view as i32
    has_mime1 = load image1+SA3D_GLTF_IMAGE_TABLE_has_mime as i32
    table_status1 = load image1+SA3D_GLTF_IMAGE_TABLE_status as i32

    table_status2 = load image2+SA3D_GLTF_IMAGE_TABLE_status as i32
    has_uri2 = load image2+SA3D_GLTF_IMAGE_TABLE_has_uri as i32
    has_view2 = load image2+SA3D_GLTF_IMAGE_TABLE_has_buffer_view as i32

    uri0_eq = call @gltf_test_bytes_eq(&uri0, uri0_len, &EXPECT_A_PNG, 5)
    mime0_eq = call @gltf_test_bytes_eq(&mime0, mime0_len, &EXPECT_IMAGE_PNG, 9)
    mime1_eq = call @gltf_test_bytes_eq(&mime1, mime1_len, &EXPECT_IMAGE_JPEG, 10)

    status0_ok = eq status0, SA3D_GLTF_JSON_TABLE_STATUS_OK
    status1_ok = eq status1, SA3D_GLTF_JSON_TABLE_STATUS_OK
    status2_ok = eq status2, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED
    table0_ok = eq table_status0, SA3D_GLTF_JSON_TABLE_STATUS_OK
    kind0_ok = eq kind0, SA3D_GLTF_IMAGE_SOURCE_URI
    has_uri0_ok = eq has_uri0, 1
    has_view0_ok = eq has_view0, 0
    has_mime0_ok = eq has_mime0, 1
    uri0_ok = eq uri0_eq, 1
    mime0_ok = eq mime0_eq, 1

    table1_ok = eq table_status1, SA3D_GLTF_JSON_TABLE_STATUS_OK
    kind1_ok = eq kind1, SA3D_GLTF_IMAGE_SOURCE_VIEW
    view1_ok = eq view1, 1
    has_uri1_ok = eq has_uri1, 0
    has_view1_ok = eq has_view1, 1
    has_mime1_ok = eq has_mime1, 1
    mime1_ok = eq mime1_eq, 1

    table2_ok = eq table_status2, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED
    has_uri2_ok = eq has_uri2, 0
    has_view2_ok = eq has_view2, 0

    p0 = and status0_ok, status1_ok
    p1 = and status2_ok, table0_ok
    p2 = and kind0_ok, has_uri0_ok
    p3 = and has_view0_ok, has_mime0_ok
    p4 = and uri0_ok, mime0_ok
    p5 = and table1_ok, kind1_ok
    p6 = and view1_ok, has_uri1_ok
    p7 = and has_view1_ok, has_mime1_ok
    p8 = and mime1_ok, table2_ok
    p9 = and has_uri2_ok, has_view2_ok
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    r0 = and q0, q1
    r1 = and q2, q3
    s0 = and r0, r1
    ok = and s0, q4

    !image2
    !image1
    !image0
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3198)

@test "3d_gltf Bevy node JSON table with TRS children mesh skin extras"():
L_ENTRY:
    node0 = alloc SA3D_GLTF_NODE_TABLE_SIZE
