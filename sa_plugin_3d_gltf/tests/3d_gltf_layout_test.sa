    joint_u8x4_ok = eq joint_u8x4, 1
    joint_u8x4_bad_ok = eq joint_u8x4_bad, 0
    joint_u16x4_ok = eq joint_u16x4, 1
    joint_u32x4_bad_ok = eq joint_u32x4_bad, 0
    weight_u8x4_ok = eq weight_u8x4, 1
    weight_f32x4_ok = eq weight_f32x4, 1
    weight_u16x4_bad_ok = eq weight_u16x4_bad, 0

    p0 = and pos_ok2, pos_attr_ok
