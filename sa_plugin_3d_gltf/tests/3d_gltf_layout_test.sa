@test "3d_gltf Bevy cycle check starts from scene roots"():
L_ENTRY:
    visited = alloc 8

    tree_status = call @sa3d_gltf_json_check_for_cycles(&JSON_CYCLE_TREE, 61, &visited, 8)
    cycle_status = call @sa3d_gltf_json_check_for_cycles(&JSON_CYCLE_REACHABLE, 70, &visited, 8)
    shared_status = call @sa3d_gltf_json_check_for_cycles(&JSON_CYCLE_SHARED_CHILD, 75, &visited, 8)
    unreachable_status = call @sa3d_gltf_json_check_for_cycles(&JSON_CYCLE_UNREACHABLE, 75, &visited, 8)
    small_status = call @sa3d_gltf_json_check_for_cycles(&JSON_CYCLE_TREE, 61, &visited, 2)

    tree_ok = eq tree_status, SA3D_GLTF_CYCLE_STATUS_OK
    cycle_ok = eq cycle_status, SA3D_GLTF_CYCLE_STATUS_CYCLE
    shared_ok = eq shared_status, SA3D_GLTF_CYCLE_STATUS_OK
    unreachable_ok = eq unreachable_status, SA3D_GLTF_CYCLE_STATUS_OK
    small_ok = eq small_status, SA3D_GLTF_CYCLE_STATUS_OUTPUT_TOO_SMALL
    p0 = and tree_ok, cycle_ok
    p1 = and shared_ok, unreachable_ok
    p2 = and p0, p1
    ok = and p2, small_ok

    !visited
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3200)

@test "3d_gltf Bevy skin JSON table joints inverse bind extras"():
L_ENTRY:
    skin0 = alloc SA3D_GLTF_SKIN_TABLE_SIZE
    skin1 = alloc SA3D_GLTF_SKIN_TABLE_SIZE
    missing = alloc SA3D_GLTF_SKIN_TABLE_SIZE
    too_many = alloc SA3D_GLTF_SKIN_TABLE_SIZE
    name_buf = alloc 32

    status0 = call @sa3d_gltf_json_skin_parse(&JSON_SKIN_TABLE, 109, 0, &skin0)
    name_ptr0 = load skin0+SA3D_GLTF_SKIN_TABLE_name_ptr as ptr
    name_len0 = load skin0+SA3D_GLTF_SKIN_TABLE_name_len as i64
    index0 = load skin0+SA3D_GLTF_SKIN_TABLE_index as i64
    joint_count0 = load skin0+SA3D_GLTF_SKIN_TABLE_joint_count as i64
    first_joint0 = load skin0+SA3D_GLTF_SKIN_TABLE_first_joint as i64
    joint1 = call @sa3d_gltf_json_skin_joint_at(&JSON_SKIN_TABLE, 109, &skin0, 1)
    has_ibm0 = load skin0+SA3D_GLTF_SKIN_TABLE_has_inverse_bind_matrices as i32
    ibm0 = load skin0+SA3D_GLTF_SKIN_TABLE_inverse_bind_matrices as i64
    has_extras0 = load skin0+SA3D_GLTF_SKIN_TABLE_has_extras as i32
    extras_ptr0 = load skin0+SA3D_GLTF_SKIN_TABLE_extras_ptr as ptr
    extras_len0 = load skin0+SA3D_GLTF_SKIN_TABLE_extras_len as i64
    name_eq0 = call @gltf_test_bytes_eq(&name_ptr0, name_len0, &EXPECT_SKIN_ARMATURE, 8)
    extras_eq0 = call @gltf_test_bytes_eq(&extras_ptr0, extras_len0, &EXPECT_SKIN_EXTRAS, 15)

    status1 = call @sa3d_gltf_json_skin_parse(&JSON_SKIN_TABLE, 109, 1, &skin1)
    fallback_len = call @sa3d_gltf_skin_name_to_bytes(1, 0, 0, &name_buf, 32)
    fallback_eq = call @gltf_test_bytes_eq(&name_buf, fallback_len, &EXPECT_SKIN1_FALLBACK, 9)
    joint_count1 = load skin1+SA3D_GLTF_SKIN_TABLE_joint_count as i64
    first_joint1 = load skin1+SA3D_GLTF_SKIN_TABLE_first_joint as i64
    has_ibm1 = load skin1+SA3D_GLTF_SKIN_TABLE_has_inverse_bind_matrices as i32

    missing_status = call @sa3d_gltf_json_skin_parse(&JSON_SKIN_MISSING_JOINTS, 14, 0, &missing)
    too_many_status = call @sa3d_gltf_json_skin_parse(&JSON_SKIN_TOO_MANY_JOINTS, 942, 0, &too_many)
    too_many_count = load too_many+SA3D_GLTF_SKIN_TABLE_joint_count as i64
    too_many_flag = load too_many+SA3D_GLTF_SKIN_TABLE_exceeds_max_joints as i32

    q0 = eq status0, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q1 = eq index0, 0
    q2 = eq name_eq0, 1
    q3 = eq joint_count0, 2
    q4 = eq first_joint0, 1
    q5 = eq joint1, 2
    q6 = eq has_ibm0, 1
    q7 = eq ibm0, 3
    q8 = eq has_extras0, 1
    q9 = eq extras_eq0, 1
    q10 = eq status1, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q11 = eq fallback_eq, 1
    q12 = eq joint_count1, 0
    q13 = eq first_joint1, -1
    q14 = eq has_ibm1, 0
    q15 = eq missing_status, SA3D_GLTF_JSON_TABLE_STATUS_MISSING_REQUIRED
    q16 = eq too_many_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q17 = eq too_many_count, 257
    q18 = eq too_many_flag, 1

    a0 = and q0, q1
    a1 = and q2, q3
    a2 = and q4, q5
    a3 = and q6, q7
    a4 = and q8, q9
    a5 = and q10, q11
    a6 = and q12, q13
    a7 = and q14, q15
    a8 = and q16, q17
    b0 = and a0, a1
    b1 = and a2, a3
    b2 = and a4, a5
    b3 = and a6, a7
    b4 = and a8, q18
    c0 = and b0, b1
    c1 = and b2, b3
    c2 = and c0, c1
    ok = and c2, b4

    !name_buf
    !too_many
    !missing
    !skin1
    !skin0
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3201)

@test "3d_gltf Bevy skin inverse bind matrices materialize MAT4 and default identity"():
L_ENTRY:
    buf = alloc 128
    out = alloc 128
    identity_out = alloc 128
    out_len = alloc 8
    identity_len = alloc 8

    m0 = ptr_add buf, 0
    m1 = ptr_add buf, 64
    call @sa3d_mat4_identity(&m0)
    call @sa3d_mat4_identity(&m1)
    store m1+0, 1073741824 as i32
    store m1+20, 1077936128 as i32
    store m1+40, 1082130432 as i32
    store m1+48, 1084227584 as i32

    status = call @sa3d_gltf_json_skin_inverse_bind_matrices_materialize(&JSON_SKIN_IBM_MAT4, 222, 0, 0, &buf, 128, 1, &out, 128, &out_len)
    len0 = load out_len+0 as i64
    m0_x = load out+0 as i32
    m0_y = load out+20 as i32
    m0_z = load out+40 as i32
    m0_w = load out+60 as i32
    m1_x = load out+64 as i32
    m1_y = load out+84 as i32
    m1_z = load out+104 as i32
    m1_tx = load out+112 as i32
    m1_w = load out+124 as i32

    identity_status = call @sa3d_gltf_json_skin_inverse_bind_matrices_materialize(&JSON_SKIN_IBM_MAT4, 222, 1, 0, &buf, 128, 1, &identity_out, 128, &identity_len)
    len1 = load identity_len+0 as i64
    id0_x = load identity_out+0 as i32
    id0_y = load identity_out+20 as i32
    id0_z = load identity_out+40 as i32
    id0_w = load identity_out+60 as i32
    id1_x = load identity_out+64 as i32
    id1_y = load identity_out+84 as i32
    id1_z = load identity_out+104 as i32
    id1_w = load identity_out+124 as i32

    small_status = call @sa3d_gltf_json_skin_inverse_bind_matrices_materialize(&JSON_SKIN_IBM_MAT4, 222, 0, 0, &buf, 128, 0, &out, 64, &out_len)

    q0 = eq status, SA3D_GLTF_IBM_STATUS_OK
    q1 = eq len0, 128
    q2 = eq m0_x, SA3D_F32_NEG_ONE_BITS
    q3 = eq m0_y, SA3D_F32_ONE_BITS
    q4 = eq m0_z, SA3D_F32_NEG_ONE_BITS
    q5 = eq m0_w, SA3D_F32_ONE_BITS
    q6 = eq m1_x, -1073741824
    q7 = eq m1_y, 1077936128
    q8 = eq m1_z, -1065353216
    q9 = eq m1_tx, 1084227584
    q10 = eq m1_w, SA3D_F32_ONE_BITS
    q11 = eq identity_status, SA3D_GLTF_IBM_STATUS_OK
    q12 = eq len1, 128
    q13 = eq id0_x, SA3D_F32_ONE_BITS
    q14 = eq id0_y, SA3D_F32_ONE_BITS
    q15 = eq id0_z, SA3D_F32_ONE_BITS
    q16 = eq id0_w, SA3D_F32_ONE_BITS
    q17 = eq id1_x, SA3D_F32_ONE_BITS
    q18 = eq id1_y, SA3D_F32_ONE_BITS
    q19 = eq id1_z, SA3D_F32_ONE_BITS
    q20 = eq id1_w, SA3D_F32_ONE_BITS
    q21 = eq small_status, SA3D_GLTF_IBM_STATUS_OUTPUT_TOO_SMALL

    a0 = and q0, q1
    a1 = and q2, q3
    a2 = and q4, q5
    a3 = and q6, q7
    a4 = and q8, q9
    a5 = and q10, q11
    a6 = and q12, q13
    a7 = and q14, q15
    a8 = and q16, q17
    a9 = and q18, q19
    b0 = and a0, a1
    b1 = and a2, a3
    b2 = and a4, a5
    b3 = and a6, a7
    b4 = and a8, a9
    c0 = and b0, b1
    c1 = and b2, b3
    c2 = and b4, q20
    d0 = and c0, c1
    d1 = and c2, q21
    ok = and d0, d1

    !identity_len
    !out_len
    !identity_out
    !out
    !buf
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3202)

@test "3d_gltf Bevy sparse inverse bind matrices match accessor iterator"():
L_ENTRY:
    base_buf = alloc 196
    zero_buf = alloc 68
    out = alloc 128
    out_len = alloc 8

    base0 = ptr_add base_buf, 0
    base1 = ptr_add base_buf, 64
    patch = ptr_add base_buf, 132
    call @sa3d_mat4_identity(&base0)
    call @sa3d_mat4_identity(&base1)
    call @sa3d_mat4_identity(&patch)
    store base1+0, 1065353216 as i32
    store base1+20, 1065353216 as i32
    store base1+40, 1065353216 as i32
    store base1+48, 1065353216 as i32
    store base_buf+128, 1 as u8
    store patch+0, 1073741824 as i32
    store patch+20, 1077936128 as i32
    store patch+40, 1082130432 as i32
    store patch+48, 1084227584 as i32

    base_status = call @sa3d_gltf_json_skin_inverse_bind_matrices_materialize(&JSON_SKIN_IBM_SPARSE_BASE, 406, 0, 0, &base_buf, 196, 1, &out, 128, &out_len)
    base_len = load out_len+0 as i64
    b0_x = load out+0 as i32
    b0_y = load out+20 as i32
    b0_z = load out+40 as i32
    b0_w = load out+60 as i32
    b1_x = load out+64 as i32
    b1_y = load out+84 as i32
    b1_z = load out+104 as i32
    b1_tx = load out+112 as i32
    b1_w = load out+124 as i32

    zero_patch = ptr_add zero_buf, 4
    call @sa3d_mat4_identity(&zero_patch)
    store zero_buf+0, 1 as u8
    store zero_patch+0, 1073741824 as i32
    store zero_patch+20, 1077936128 as i32
    store zero_patch+40, 1082130432 as i32
    store zero_patch+48, 1084227584 as i32

    zero_status = call @sa3d_gltf_json_skin_inverse_bind_matrices_materialize(&JSON_SKIN_IBM_SPARSE_ZERO, 341, 0, 0, &zero_buf, 68, 1, &out, 128, &out_len)
    zero_len = load out_len+0 as i64
    z0_x = load out+0 as i32
    z0_y = load out+20 as i32
    z0_z = load out+40 as i32
    z0_w = load out+60 as i32
    z1_x = load out+64 as i32
    z1_y = load out+84 as i32
    z1_z = load out+104 as i32
    z1_tx = load out+112 as i32
    z1_w = load out+124 as i32

    q0 = eq base_status, SA3D_GLTF_IBM_STATUS_OK
    q1 = eq base_len, 128
    q2 = eq b0_x, SA3D_F32_NEG_ONE_BITS
    q3 = eq b0_y, SA3D_F32_ONE_BITS
    q4 = eq b0_z, SA3D_F32_NEG_ONE_BITS
    q5 = eq b0_w, SA3D_F32_ONE_BITS
    q6 = eq b1_x, -1073741824
    q7 = eq b1_y, 1077936128
    q8 = eq b1_z, -1065353216
    q9 = eq b1_tx, 1084227584
    q10 = eq b1_w, SA3D_F32_ONE_BITS
    q11 = eq zero_status, SA3D_GLTF_IBM_STATUS_OK
    q12 = eq zero_len, 128
    q13 = eq z0_x, 0
    q14 = eq z0_y, 0
    q15 = eq z0_z, 0
    q16 = eq z0_w, 0
    q17 = eq z1_x, -1073741824
    q18 = eq z1_y, 1077936128
    q19 = eq z1_z, -1065353216
    q20 = eq z1_tx, 1084227584
    q21 = eq z1_w, SA3D_F32_ONE_BITS

    a0 = and q0, q1
    a1 = and q2, q3
    a2 = and q4, q5
    a3 = and q6, q7
    a4 = and q8, q9
    a5 = and q10, q11
    a6 = and q12, q13
    a7 = and q14, q15
    a8 = and q16, q17
    a9 = and q18, q19
    b0_ok = and a0, a1
    b1_ok = and a2, a3
    b2_ok = and a4, a5
    b3_ok = and a6, a7
    b4_ok = and a8, a9
    c0 = and b0_ok, b1_ok
    c1 = and b2_ok, b3_ok
    c2 = and b4_ok, q20
    d0 = and c0, c1
    d1 = and c2, q21
    ok = and d0, d1

    !out_len
    !out
    !zero_buf
    !base_buf
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3203)

@test "3d_gltf Bevy animation JSON table samplers channels paths"():
L_ENTRY:
    animation = alloc SA3D_GLTF_ANIMATION_TABLE_SIZE
    sampler0 = alloc SA3D_GLTF_ANIMATION_SAMPLER_TABLE_SIZE
    sampler1 = alloc SA3D_GLTF_ANIMATION_SAMPLER_TABLE_SIZE
    sampler2 = alloc SA3D_GLTF_ANIMATION_SAMPLER_TABLE_SIZE
    channel0 = alloc SA3D_GLTF_ANIMATION_CHANNEL_TABLE_SIZE
    channel1 = alloc SA3D_GLTF_ANIMATION_CHANNEL_TABLE_SIZE
    channel2 = alloc SA3D_GLTF_ANIMATION_CHANNEL_TABLE_SIZE

    anim_status = call @sa3d_gltf_json_animation_parse(&JSON_ANIMATION_TABLE, 338, 0, &animation)
    name_ptr = load animation+SA3D_GLTF_ANIMATION_TABLE_name_ptr as ptr
    name_len = load animation+SA3D_GLTF_ANIMATION_TABLE_name_len as i64
    name_eq = call @gltf_test_bytes_eq(&name_ptr, name_len, &EXPECT_ANIMATION_WALK, 4)
    channel_count = load animation+SA3D_GLTF_ANIMATION_TABLE_channel_count as i64
    sampler_count = load animation+SA3D_GLTF_ANIMATION_TABLE_sampler_count as i64

    s0_status = call @sa3d_gltf_json_animation_sampler_parse(&JSON_ANIMATION_TABLE, 338, &animation, 0, &sampler0)
    s1_status = call @sa3d_gltf_json_animation_sampler_parse(&JSON_ANIMATION_TABLE, 338, &animation, 1, &sampler1)
    s2_status = call @sa3d_gltf_json_animation_sampler_parse(&JSON_ANIMATION_TABLE, 338, &animation, 2, &sampler2)
    s0_input = load sampler0+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_input as i64
    s0_output = load sampler0+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_output as i64
    s0_interp = load sampler0+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_interpolation as i32
    s0_missing_input = load sampler0+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_input as i32
    s0_missing_output = load sampler0+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_missing_output as i32
    s1_input = load sampler1+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_input as i64
    s1_output = load sampler1+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_output as i64
    s1_interp = load sampler1+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_interpolation as i32
    s2_input = load sampler2+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_input as i64
    s2_output = load sampler2+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_output as i64
    s2_interp = load sampler2+SA3D_GLTF_ANIMATION_SAMPLER_TABLE_interpolation as i32

    c0_status = call @sa3d_gltf_json_animation_channel_parse(&JSON_ANIMATION_TABLE, 338, &animation, 0, &channel0)
    c1_status = call @sa3d_gltf_json_animation_channel_parse(&JSON_ANIMATION_TABLE, 338, &animation, 1, &channel1)
    c2_status = call @sa3d_gltf_json_animation_channel_parse(&JSON_ANIMATION_TABLE, 338, &animation, 2, &channel2)
    c0_sampler = load channel0+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_sampler as i64
    c0_node = load channel0+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_node as i64
    c0_path = load channel0+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_path as i32
    c1_sampler = load channel1+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_sampler as i64
    c1_node = load channel1+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_node as i64
    c1_path = load channel1+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_path as i32
    c2_sampler = load channel2+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_sampler as i64
    c2_node = load channel2+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_node as i64
    c2_path = load channel2+SA3D_GLTF_ANIMATION_CHANNEL_TABLE_target_path as i32

    q0 = eq anim_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q1 = eq name_eq, 1
    q2 = eq channel_count, 3
    q3 = eq sampler_count, 3
    q4 = eq s0_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q5 = eq s1_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q6 = eq s2_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q7 = eq s0_input, 0
    q8 = eq s0_output, 1
    q9 = eq s0_interp, SA3D_GLTF_ANIMATION_INTERPOLATION_LINEAR
    q10 = eq s0_missing_input, 0
    q11 = eq s0_missing_output, 0
    q12 = eq s1_input, 2
    q13 = eq s1_output, 3
    q14 = eq s1_interp, SA3D_GLTF_ANIMATION_INTERPOLATION_STEP
    q15 = eq s2_input, 4
    q16 = eq s2_output, 5
    q17 = eq s2_interp, SA3D_GLTF_ANIMATION_INTERPOLATION_CUBIC_SPLINE
    q18 = eq c0_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q19 = eq c1_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q20 = eq c2_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q21 = eq c0_sampler, 0
    q22 = eq c0_node, 7
    q23 = eq c0_path, SA3D_GLTF_ANIMATION_PATH_TRANSLATION
    q24 = eq c1_sampler, 1
    q25 = eq c1_node, 8
    q26 = eq c1_path, SA3D_GLTF_ANIMATION_PATH_ROTATION
    q27 = eq c2_sampler, 2
    q28 = eq c2_node, 9
    q29 = eq c2_path, SA3D_GLTF_ANIMATION_PATH_WEIGHTS

    a0 = and q0, q1
    a1 = and q2, q3
    a2 = and q4, q5
    a3 = and q6, q7
    a4 = and q8, q9
    a5 = and q10, q11
    a6 = and q12, q13
    a7 = and q14, q15
    a8 = and q16, q17
    a9 = and q18, q19
    a10 = and q20, q21
    a11 = and q22, q23
    a12 = and q24, q25
    a13 = and q26, q27
    a14 = and q28, q29
    b0 = and a0, a1
    b1 = and a2, a3
    b2 = and a4, a5
    b3 = and a6, a7
    b4 = and a8, a9
    b5 = and a10, a11
    b6 = and a12, a13
    c0 = and b0, b1
    c1 = and b2, b3
    c2 = and b4, b5
    c3 = and b6, a14
    d0 = and c0, c1
    d1 = and c2, c3
    ok = and d0, d1

    !channel2
    !channel1
    !channel0
    !sampler2
    !sampler1
    !sampler0
    !animation
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3290)

@test "3d_gltf Bevy animation translation channel materialize f32 curve data"():
L_ENTRY:
    buf = alloc 32
    input_out = alloc 16
    output_out = alloc 48
    small_out = alloc 12
    data = alloc SA3D_GLTF_ANIMATION_CHANNEL_DATA_SIZE
    small_data = alloc SA3D_GLTF_ANIMATION_CHANNEL_DATA_SIZE

    store buf+0, 0.0 as f32
