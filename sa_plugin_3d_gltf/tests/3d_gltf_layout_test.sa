    p3 = and pos1x_ok, pos1y_ok
    p4 = and pos1z_ok, uv_layout_ok
    p5 = and uv_status_ok, uv_len_ok
    p6 = and uv0x_ok, uv0y_ok
    p7 = and uv1x_ok, uv1y_ok
    p8 = and tan_layout_ok, tan_status_ok
    p9 = and tan_len_ok, tan_x_ok
    p10 = and tan_y_ok, tan_z_ok
    p11 = and tan_w_ok, small_ok
    p12 = and unsupported_ok, p11
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    q5 = and p10, p12
    r0 = and q0, q1
    r1 = and q2, q3
    r2 = and q4, q5
    s0 = and r0, r1
    ok = and s0, r2

    !layout
    !out_len
    !out
    !buf
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3186)

