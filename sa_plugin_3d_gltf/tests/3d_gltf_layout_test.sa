    joint_u8x4 = call @sa3d_gltf_accessor_conversion_supported(SA3D_GLTF_CONVERSION_JOINT_INDEX, SA3D_GLTF_ACCESSOR_U8X4, 0)
    joint_u8x4_bad = call @sa3d_gltf_accessor_conversion_supported(SA3D_GLTF_CONVERSION_JOINT_INDEX, SA3D_GLTF_ACCESSOR_U8X4, 1)
    joint_u16x4 = call @sa3d_gltf_accessor_conversion_supported(SA3D_GLTF_CONVERSION_JOINT_INDEX, SA3D_GLTF_ACCESSOR_U16X4, 0)
    joint_u32x4_bad = call @sa3d_gltf_accessor_conversion_supported(SA3D_GLTF_CONVERSION_JOINT_INDEX, SA3D_GLTF_ACCESSOR_U32X4, 0)
    weight_u8x4 = call @sa3d_gltf_accessor_conversion_supported(SA3D_GLTF_CONVERSION_JOINT_WEIGHT, SA3D_GLTF_ACCESSOR_U8X4, 1)
    weight_f32x4 = call @sa3d_gltf_accessor_conversion_supported(SA3D_GLTF_CONVERSION_JOINT_WEIGHT, SA3D_GLTF_ACCESSOR_F32X4, 0)
    weight_u16x4_bad = call @sa3d_gltf_accessor_conversion_supported(SA3D_GLTF_CONVERSION_JOINT_WEIGHT, SA3D_GLTF_ACCESSOR_U16X4, 0)

    any_f32x3_ok = eq any_f32x3, 1
    any_f32x3_norm_ok = eq any_f32x3_norm, 0
    any_u16x2_norm_ok = eq any_u16x2_norm, 1
