    rgba_f32x4 = call @sa3d_gltf_accessor_conversion_supported(SA3D_GLTF_CONVERSION_RGBA, SA3D_GLTF_ACCESSOR_F32X4, 0)
    tex_u16x2 = call @sa3d_gltf_accessor_conversion_supported(SA3D_GLTF_CONVERSION_TEX_COORD, SA3D_GLTF_ACCESSOR_U16X2, 1)
