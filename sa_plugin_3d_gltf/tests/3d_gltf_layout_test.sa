@test "3d_gltf Bevy animation rotation and weights normalize outputs"():
L_ENTRY:
    buf = alloc 20
    input_out = alloc 16
    rotation_out = alloc 64
    weights_out = alloc 32
    rotation_data = alloc SA3D_GLTF_ANIMATION_CHANNEL_DATA_SIZE
    weights_data = alloc SA3D_GLTF_ANIMATION_CHANNEL_DATA_SIZE

    store buf+0, 0.0 as f32
    store buf+4, 1.0 as f32
    store buf+8, -128 as i8
    store buf+9, 0 as i8
    store buf+10, 127 as i8
    store buf+11, 64 as i8
    store buf+12, 0 as i8
    store buf+13, 127 as i8
    store buf+14, -127 as i8
    store buf+15, -128 as i8
    store buf+16, 0 as u8
    store buf+17, 128 as u8
    store buf+18, 255 as u8
    store buf+19, 64 as u8

    rot_status = call @sa3d_gltf_json_animation_channel_materialize(&JSON_ANIMATION_ROTATION_WEIGHTS, 596, 0, 0, 0, &buf, 20, &input_out, 16, &rotation_out, 64, &rotation_data)
    rot_field = load rotation_data+SA3D_GLTF_ANIMATION_CHANNEL_DATA_status as i32
    rot_components = load rotation_data+SA3D_GLTF_ANIMATION_CHANNEL_DATA_output_component_count as i64
    rot_curve = load rotation_data+SA3D_GLTF_ANIMATION_CHANNEL_DATA_curve_kind as i32
    r0 = load rotation_out+0 as f32
    r1 = load rotation_out+4 as f32
    r2 = load rotation_out+8 as f32
    r3 = load rotation_out+12 as f32
    r7 = load rotation_out+28 as f32

    weights_status = call @sa3d_gltf_json_animation_channel_materialize(&JSON_ANIMATION_ROTATION_WEIGHTS, 596, 0, 1, 0, &buf, 20, &input_out, 16, &weights_out, 32, &weights_data)
    weights_field = load weights_data+SA3D_GLTF_ANIMATION_CHANNEL_DATA_status as i32
    weights_components = load weights_data+SA3D_GLTF_ANIMATION_CHANNEL_DATA_output_component_count as i64
    weights_curve = load weights_data+SA3D_GLTF_ANIMATION_CHANNEL_DATA_curve_kind as i32
    w0 = load weights_out+0 as f32
    w1 = load weights_out+4 as f32
    w2 = load weights_out+8 as f32
    w3 = load weights_out+12 as f32

    r0_ok = call @gltf_test_f32_between(r0, -1.001, -0.999)
    r1_ok = call @gltf_test_f32_between(r1, -0.001, 0.001)
    r2_ok = call @gltf_test_f32_between(r2, 0.999, 1.001)
    r3_ok = call @gltf_test_f32_between(r3, 0.503, 0.505)
    r7_ok = call @gltf_test_f32_between(r7, -1.001, -0.999)
    w0_ok = call @gltf_test_f32_between(w0, -0.001, 0.001)
    w1_ok = call @gltf_test_f32_between(w1, 0.501, 0.503)
    w2_ok = call @gltf_test_f32_between(w2, 0.999, 1.001)
    w3_ok = call @gltf_test_f32_between(w3, 0.250, 0.252)

    q0 = eq rot_status, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    q1 = eq rot_field, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    q2 = eq rot_components, 4
    q3 = eq rot_curve, SA3D_GLTF_ANIMATION_CURVE_LINEAR
    q4 = eq weights_status, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    q5 = eq weights_field, SA3D_GLTF_ANIMATION_READ_STATUS_OK
    q6 = eq weights_components, 2
    q7 = eq weights_curve, SA3D_GLTF_ANIMATION_CURVE_STEP
    a0 = and q0, q1
    a1 = and q2, q3
    a2 = and q4, q5
    a3 = and q6, q7
    a4 = and r0_ok, r1_ok
    a5 = and r2_ok, r3_ok
    a6 = and r7_ok, w0_ok
    a7 = and w1_ok, w2_ok
    a8 = and w3_ok, a7
    b0 = and a0, a1
    b1 = and a2, a3
    b2 = and a4, a5
    b3 = and a6, a8
    c0 = and b0, b1
    c1 = and b2, b3
    ok = and c0, c1

    !weights_data
    !rotation_data
    !weights_out
    !rotation_out
    !input_out
    !buf
    br ok -> L_OK, L_ERR

L_OK:
    return 0
L_ERR:
    panic(3292)

