    has_mesh0 = load node0+SA3D_GLTF_NODE_TABLE_has_mesh as i32
    mesh0 = load node0+SA3D_GLTF_NODE_TABLE_mesh as i64
    has_skin0 = load node0+SA3D_GLTF_NODE_TABLE_has_skin as i32
    skin0 = load node0+SA3D_GLTF_NODE_TABLE_skin as i64
    transform0 = ptr_add node0, SA3D_GLTF_NODE_TABLE_transform
    translation0 = ptr_add transform0, SA3D_TRANSFORM3D_translation
    rotation0 = ptr_add transform0, SA3D_TRANSFORM3D_rotation
    scale0 = ptr_add transform0, SA3D_TRANSFORM3D_scale
    tx0 = load translation0+SA3D_VEC3_x as i32
    ty0 = load translation0+SA3D_VEC3_y as i32
    tz0 = load translation0+SA3D_VEC3_z as i32
    rz0 = load rotation0+SA3D_QUAT_z as i32
    rw0 = load rotation0+SA3D_QUAT_w as i32
    sx0 = load scale0+SA3D_VEC3_x as i32
    sy0 = load scale0+SA3D_VEC3_y as i32
    sz0 = load scale0+SA3D_VEC3_z as i32
    has_extras0 = load node0+SA3D_GLTF_NODE_TABLE_has_extras as i32
    extras_ptr0 = load node0+SA3D_GLTF_NODE_TABLE_extras_ptr as ptr
    extras_len0 = load node0+SA3D_GLTF_NODE_TABLE_extras_len as i64
