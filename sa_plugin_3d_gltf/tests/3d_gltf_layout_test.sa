    p10 = and uri_raw_status_ok, uri_raw_len_ok
    p11 = and uri_raw_0_ok, uri_raw_1_ok
    p12 = and uri_raw_2_ok, p11
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    q5 = and p10, p12
    r0 = and q0, q1
    r1 = and q2, q3
    r2 = and q4, q5
    s0 = and r0, r1
    ok = and s0, r2

    !view
