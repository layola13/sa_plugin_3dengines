    index0 = load scene0+SA3D_GLTF_SCENE_TABLE_index as i64
    root_count0 = load scene0+SA3D_GLTF_SCENE_TABLE_root_count as i64
    first_root0 = load scene0+SA3D_GLTF_SCENE_TABLE_first_root as i64
    root1 = call @sa3d_gltf_json_scene_root_at_table(&JSON_SCENE_TABLE, 71, &scene0, 1)
