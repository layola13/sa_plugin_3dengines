    q23 = eq t2x, SA3D_F32_ZERO_BITS
    q24 = eq r2w, SA3D_F32_ONE_BITS
    q25 = eq s2x, SA3D_F32_ONE_BITS
    q26 = eq matrix_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q27 = eq matrix_table_status, SA3D_GLTF_JSON_TABLE_STATUS_OK
