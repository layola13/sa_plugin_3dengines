    q3 = eq root_count0, 2
    q4 = eq first_root0, 0
    q5 = eq root1, 2
    q6 = eq has_extras0, 1
    q7 = eq extras_eq0, 1
    q8 = eq status1, SA3D_GLTF_JSON_TABLE_STATUS_OK
    q9 = eq fallback_eq, 1
    q10 = eq root_count1, 0
    q11 = eq first_root1, -1
    q12 = eq has_extras1, 0
    q13 = eq default_scene, 1
    q14 = eq missing_default_scene, -1
    q15 = eq oob_default_scene, -2
    q16 = eq bad_type_default_scene, -2
