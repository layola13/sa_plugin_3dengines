#def SA3D_COLOR_VERSION_MAJOR = 0
#def SA3D_COLOR_VERSION_MINOR = 1

#def SA3D_COLOR_SPACE_LINEAR_SRGB = 1
#def SA3D_COLOR_SPACE_SRGB = 2
#def SA3D_COLOR_SPACE_OKLAB = 3
#def SA3D_COLOR_SPACE_HDR_LINEAR = 4

#def SA3D_COLOR_RGBA_F32_r = +0
#def SA3D_COLOR_RGBA_F32_g = +4
#def SA3D_COLOR_RGBA_F32_b = +8
#def SA3D_COLOR_RGBA_F32_a = +12
#def SA3D_COLOR_RGBA_F32_SIZE = 16

#def SA3D_COLOR_HSVA_F32_h = +0
#def SA3D_COLOR_HSVA_F32_s = +4
#def SA3D_COLOR_HSVA_F32_v = +8
#def SA3D_COLOR_HSVA_F32_a = +12
#def SA3D_COLOR_HSVA_F32_SIZE = 16

#def SA3D_COLOR_RGBA_U8_r = +0
#def SA3D_COLOR_RGBA_U8_g = +1
#def SA3D_COLOR_RGBA_U8_b = +2
#def SA3D_COLOR_RGBA_U8_a = +3
#def SA3D_COLOR_RGBA_U8_SIZE = 4

#def SA3D_COLOR_RGBA_U16_r = +0
#def SA3D_COLOR_RGBA_U16_g = +2
#def SA3D_COLOR_RGBA_U16_b = +4
#def SA3D_COLOR_RGBA_U16_a = +6
#def SA3D_COLOR_RGBA_U16_SIZE = 8

#def SA3D_COLOR_GRADIENT_STOP_color = +0
#def SA3D_COLOR_GRADIENT_STOP_position = +16
#def SA3D_COLOR_GRADIENT_STOP_SIZE = 24

#def SA3D_COLOR_U8_MAX = 255
#def SA3D_COLOR_U16_MAX = 65535

@const SA3D_COLOR_SRGB_TO_LINEAR_U16_LUT_HEX = utf8:""

@sa3d_color_clamp_u8(value: i32) -> i32:
L_ENTRY:
    below = slt value, 0
    br below -> L_U8_LOW, L_U8_HIGH_CHECK

L_U8_LOW:
    !below
    !value
    return 0

L_U8_HIGH_CHECK:
    above = sgt value, SA3D_COLOR_U8_MAX
    br above -> L_U8_HIGH, L_U8_OK

L_U8_HIGH:
    !above
    !below
    !value
    return SA3D_COLOR_U8_MAX

L_U8_OK:
    !above
    !below
    return value

@sa3d_color_clamp_u16(value: i32) -> i32:
L_ENTRY:
    below = slt value, 0
    br below -> L_U16_LOW, L_U16_HIGH_CHECK

L_U16_LOW:
    !below
    !value
    return 0

L_U16_HIGH_CHECK:
    above = sgt value, SA3D_COLOR_U16_MAX
    br above -> L_U16_HIGH, L_U16_OK

L_U16_HIGH:
    !above
    !below
    !value
    return SA3D_COLOR_U16_MAX

L_U16_OK:
    !above
    !below
    return value

@sa3d_color_rgba_u8_set(&color: ptr, r: i32, g: i32, b: i32, a: i32) -> void:
L_ENTRY:
    cr = call @sa3d_color_clamp_u8(r)
    cg = call @sa3d_color_clamp_u8(g)
    cb = call @sa3d_color_clamp_u8(b)
    ca = call @sa3d_color_clamp_u8(a)
    tr = trunc cr as u8
    tg = trunc cg as u8
    tb = trunc cb as u8
    ta = trunc ca as u8
    store color+SA3D_COLOR_RGBA_U8_r, tr as u8
    store color+SA3D_COLOR_RGBA_U8_g, tg as u8
    store color+SA3D_COLOR_RGBA_U8_b, tb as u8
    store color+SA3D_COLOR_RGBA_U8_a, ta as u8
    !cr
    !cg
    !cb
    !ca
    !tr
    !tg
    !tb
    !ta
    !r
    !g
    !b
    !a
    !color
    return

@sa3d_color_rgba_u8_alpha(&color: ptr) -> i32:
L_ENTRY:
    a8 = load color+SA3D_COLOR_RGBA_U8_a as u8
    a32 = zext a8 as i32
    !a8
    !color
    return a32

@sa3d_color_rgba_u8_set_alpha(&color: ptr, alpha: i32) -> void:
L_ENTRY:
    ca = call @sa3d_color_clamp_u8(alpha)
    ta = trunc ca as u8
    store color+SA3D_COLOR_RGBA_U8_a, ta as u8
    !ca
    !ta
    !alpha
    !color
    return

@sa3d_color_rgba_u8_copy_with_alpha(&dst: ptr, &src: ptr, alpha: i32) -> void:
L_ENTRY:
    r = load src+SA3D_COLOR_RGBA_U8_r as u8
    g = load src+SA3D_COLOR_RGBA_U8_g as u8
    b = load src+SA3D_COLOR_RGBA_U8_b as u8
    ca = call @sa3d_color_clamp_u8(alpha)
    a = trunc ca as u8
    store dst+SA3D_COLOR_RGBA_U8_r, r as u8
    store dst+SA3D_COLOR_RGBA_U8_g, g as u8
    store dst+SA3D_COLOR_RGBA_U8_b, b as u8
    store dst+SA3D_COLOR_RGBA_U8_a, a as u8
    !r
    !g
    !b
    !ca
    !a
    !alpha
    !src
    !dst
    return

@sa3d_color_rgba_u8_pack(&color: ptr) -> i64:
L_ENTRY:
    r8 = load color+SA3D_COLOR_RGBA_U8_r as u8
    g8 = load color+SA3D_COLOR_RGBA_U8_g as u8
    b8 = load color+SA3D_COLOR_RGBA_U8_b as u8
    a8 = load color+SA3D_COLOR_RGBA_U8_a as u8
    r = zext r8 as i64
    g = zext g8 as i64
    b = zext b8 as i64
    a = zext a8 as i64
    rp = shl r, 24
    gp = shl g, 16
    bp = shl b, 8
    rg = or rp, gp
    rgb = or rg, bp
    rgba = or rgb, a
    !r8
    !g8
    !b8
    !a8
    !r
    !g
    !b
    !a
    !rp
    !gp
    !bp
    !rg
    !rgb
    !color
    return rgba

@sa3d_color_rgba_u8_unpack(&color: ptr, packed: i64) -> void:
L_ENTRY:
    r_shift = lshr packed, 24
    g_shift = lshr packed, 16
    b_shift = lshr packed, 8
    r_mask = and r_shift, 255
    g_mask = and g_shift, 255
    b_mask = and b_shift, 255
    a_mask = and packed, 255
    r = trunc r_mask as u8
    g = trunc g_mask as u8
    b = trunc b_mask as u8
    a = trunc a_mask as u8
    store color+SA3D_COLOR_RGBA_U8_r, r as u8
    store color+SA3D_COLOR_RGBA_U8_g, g as u8
    store color+SA3D_COLOR_RGBA_U8_b, b as u8
    store color+SA3D_COLOR_RGBA_U8_a, a as u8
    !r_shift
    !g_shift
    !b_shift
    !r_mask
    !g_mask
    !b_mask
    !a_mask
    !r
    !g
    !b
    !a
    !packed
    !color
    return

@sa3d_color_u8_to_u16_alpha(channel: i32) -> i32:
L_ENTRY:
    c = call @sa3d_color_clamp_u8(channel)
    wide = mul c, 257
    !c
    !channel
    return wide

@sa3d_color_u16_to_u8_round(channel: i32) -> i32:
L_ENTRY:
    c = call @sa3d_color_clamp_u16(channel)
    rounded = add c, 128
    out = sdiv rounded, 257
    !c
    !rounded
    !channel
    return out

@sa3d_color_hex_nibble(byte: i32) -> i32:
L_ENTRY:
    is_digit_low = sge byte, 48
    is_digit_high = sle byte, 57
    is_digit = and is_digit_low, is_digit_high
    br is_digit -> L_HEX_DIGIT, L_HEX_LOWER_CHECK

L_HEX_DIGIT:
    digit = sub byte, 48
    !is_digit_low
    !is_digit_high
    !is_digit
    !byte
    return digit

L_HEX_LOWER_CHECK:
    is_lower_low = sge byte, 97
    is_lower_high = sle byte, 102
    is_lower = and is_lower_low, is_lower_high
    br is_lower -> L_HEX_LOWER, L_HEX_UPPER_CHECK

L_HEX_LOWER:
    lower = sub byte, 87
    !is_lower_low
    !is_lower_high
    !is_lower
    !is_digit_low
    !is_digit_high
    !is_digit
    !byte
    return lower

L_HEX_UPPER_CHECK:
    is_upper_low = sge byte, 65
    is_upper_high = sle byte, 70
    is_upper = and is_upper_low, is_upper_high
    br is_upper -> L_HEX_UPPER, L_HEX_INVALID

L_HEX_UPPER:
    upper = sub byte, 55
    !is_upper_low
    !is_upper_high
    !is_upper
    !is_lower_low
    !is_lower_high
    !is_lower
    !is_digit_low
    !is_digit_high
    !is_digit
    !byte
    return upper

L_HEX_INVALID:
    !is_upper_low
    !is_upper_high
    !is_upper
    !is_lower_low
    !is_lower_high
    !is_lower
    !is_digit_low
    !is_digit_high
    !is_digit
    !byte
    return 0

@sa3d_color_srgb_lut_read(*table: ptr, index: i64) -> i32:
L_ENTRY:
    offset = mul index, 4
    p0 = ptr_add table, offset
    p1_offset = add offset, 1
    p2_offset = add offset, 2
    p3_offset = add offset, 3
    p1 = ptr_add table, p1_offset
    p2 = ptr_add table, p2_offset
    p3 = ptr_add table, p3_offset
    b0u = load p0+0 as u8
    b1u = load p1+0 as u8
    b2u = load p2+0 as u8
    b3u = load p3+0 as u8
    b0 = zext b0u as i32
    b1 = zext b1u as i32
    b2 = zext b2u as i32
    b3 = zext b3u as i32
    n0 = call @sa3d_color_hex_nibble(b0)
    n1 = call @sa3d_color_hex_nibble(b1)
    n2 = call @sa3d_color_hex_nibble(b2)
    n3 = call @sa3d_color_hex_nibble(b3)
    v0 = shl n0, 12
    v1 = shl n1, 8
    v2 = shl n2, 4
    hi = or v0, v1
    lo = or v2, n3
    item = or hi, lo
    !offset
    !p0
    !p1_offset
    !p2_offset
    !p3_offset
    !p1
    !p2
    !p3
    !b0u
    !b1u
    !b2u
    !b3u
    !b0
    !b1
    !b2
    !b3
    !n0
    !n1
    !n2
    !n3
    !v0
    !v1
    !v2
    !hi
    !lo
    !table
    !index
    return item

@sa3d_color_srgb_u8_to_linear_u16(channel: i32) -> i32:
L_ENTRY:
    c = call @sa3d_color_clamp_u8(channel)
    idx = zext c as i64
    linear = call @sa3d_color_srgb_lut_read(*SA3D_COLOR_SRGB_TO_LINEAR_U16_LUT_HEX, idx)
    !c
    !idx
    !channel
    return linear

@sa3d_color_linear_u16_to_srgb_u8(channel: i32) -> i32:
L_ENTRY:
    target = call @sa3d_color_clamp_u16(channel)
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_LINEAR_SEARCH_HEAD

L_LINEAR_SEARCH_HEAD:
    i = load i_slot+0 as i64
    more = sle i, 255
    br more -> L_LINEAR_SEARCH_BODY, L_LINEAR_SEARCH_FALLBACK

L_LINEAR_SEARCH_BODY:
    current = call @sa3d_color_srgb_lut_read(*SA3D_COLOR_SRGB_TO_LINEAR_U16_LUT_HEX, i)
    reached = sge current, target
    br reached -> L_LINEAR_SEARCH_CHOOSE, L_LINEAR_SEARCH_NEXT

L_LINEAR_SEARCH_CHOOSE:
    is_zero = eq i, 0
    br is_zero -> L_LINEAR_SEARCH_RETURN_ZERO, L_LINEAR_SEARCH_COMPARE_PREV

L_LINEAR_SEARCH_RETURN_ZERO:
    !is_zero
    !current
    !reached
    !i
    !more
    !target
    return 0

L_LINEAR_SEARCH_COMPARE_PREV:
    prev_i = sub i, 1
    prev = call @sa3d_color_srgb_lut_read(*SA3D_COLOR_SRGB_TO_LINEAR_U16_LUT_HEX, prev_i)
    diff_current = sub current, target
    diff_prev = sub target, prev
    use_current = sle diff_current, diff_prev
    br use_current -> L_LINEAR_SEARCH_RETURN_CURRENT, L_LINEAR_SEARCH_RETURN_PREV

L_LINEAR_SEARCH_RETURN_CURRENT:
    out_current = trunc i as i32
    !prev_i
    !prev
    !diff_current
    !diff_prev
    !use_current
    !is_zero
    !current
    !reached
    !more
    !target
    return out_current

L_LINEAR_SEARCH_RETURN_PREV:
    out_prev = trunc prev_i as i32
    !prev_i
    !prev
    !diff_current
    !diff_prev
    !use_current
    !is_zero
    !current
    !reached
    !i
    !more
    !target
    return out_prev

L_LINEAR_SEARCH_NEXT:
    next = add i, 1
    store i_slot+0, next as i64
    !next
    !current
    !reached
    !i
    !more
    jmp L_LINEAR_SEARCH_HEAD

L_LINEAR_SEARCH_FALLBACK:
    !i
    !more
    !target
    return 255

@sa3d_color_rgba_u8_to_linear_u16(&dst: ptr, &src: ptr) -> void:
L_ENTRY:
    r8 = load src+SA3D_COLOR_RGBA_U8_r as u8
    g8 = load src+SA3D_COLOR_RGBA_U8_g as u8
    b8 = load src+SA3D_COLOR_RGBA_U8_b as u8
    a8 = load src+SA3D_COLOR_RGBA_U8_a as u8
    r = zext r8 as i32
    g = zext g8 as i32
    b = zext b8 as i32
    a = zext a8 as i32
    lr = call @sa3d_color_srgb_u8_to_linear_u16(r)
    lg = call @sa3d_color_srgb_u8_to_linear_u16(g)
    lb = call @sa3d_color_srgb_u8_to_linear_u16(b)
    la = call @sa3d_color_u8_to_u16_alpha(a)
    tr = trunc lr as u16
    tg = trunc lg as u16
    tb = trunc lb as u16
    ta = trunc la as u16
    store dst+SA3D_COLOR_RGBA_U16_r, tr as u16
    store dst+SA3D_COLOR_RGBA_U16_g, tg as u16
    store dst+SA3D_COLOR_RGBA_U16_b, tb as u16
    store dst+SA3D_COLOR_RGBA_U16_a, ta as u16
    !r8
    !g8
    !b8
    !a8
    !r
    !g
    !b
    !a
    !lr
    !lg
    !lb
    !la
    !tr
    !tg
    !tb
    !ta
    !src
    !dst
    return

@sa3d_color_linear_u16_to_rgba_u8(&dst: ptr, &src: ptr) -> void:
L_ENTRY:
    lr16 = load src+SA3D_COLOR_RGBA_U16_r as u16
    lg16 = load src+SA3D_COLOR_RGBA_U16_g as u16
    lb16 = load src+SA3D_COLOR_RGBA_U16_b as u16
    la16 = load src+SA3D_COLOR_RGBA_U16_a as u16
    lr = zext lr16 as i32
    lg = zext lg16 as i32
    lb = zext lb16 as i32
    la = zext la16 as i32
    r = call @sa3d_color_linear_u16_to_srgb_u8(lr)
    g = call @sa3d_color_linear_u16_to_srgb_u8(lg)
    b = call @sa3d_color_linear_u16_to_srgb_u8(lb)
    a = call @sa3d_color_u16_to_u8_round(la)
    tr = trunc r as u8
    tg = trunc g as u8
    tb = trunc b as u8
    ta = trunc a as u8
    store dst+SA3D_COLOR_RGBA_U8_r, tr as u8
    store dst+SA3D_COLOR_RGBA_U8_g, tg as u8
    store dst+SA3D_COLOR_RGBA_U8_b, tb as u8
    store dst+SA3D_COLOR_RGBA_U8_a, ta as u8
    !lr16
    !lg16
    !lb16
    !la16
    !lr
    !lg
    !lb
    !la
    !r
    !g
    !b
    !a
    !tr
    !tg
    !tb
    !ta
    !src
    !dst
    return

@sa3d_color_lerp_u8_channel(a: i32, b: i32, t: i32) -> i32:
L_ENTRY:
    ca = call @sa3d_color_clamp_u8(a)
    cb = call @sa3d_color_clamp_u8(b)
    ct = call @sa3d_color_clamp_u8(t)
    inv_t = sub 255, ct
    left = mul ca, inv_t
    right = mul cb, ct
    sum = add left, right
    rounded = add sum, 127
    out = sdiv rounded, 255
    !rounded
    !sum
    !right
    !left
    !inv_t
    !ct
    !cb
    !ca
    !t
    !b
    !a
    return out

@sa3d_color_rgba_u8_lerp(&dst: ptr, &a: ptr, &b: ptr, t: i32) -> void:
L_ENTRY:
    ar8 = load a+SA3D_COLOR_RGBA_U8_r as u8
    ag8 = load a+SA3D_COLOR_RGBA_U8_g as u8
    ab8 = load a+SA3D_COLOR_RGBA_U8_b as u8
    aa8 = load a+SA3D_COLOR_RGBA_U8_a as u8
    br8 = load b+SA3D_COLOR_RGBA_U8_r as u8
    bg8 = load b+SA3D_COLOR_RGBA_U8_g as u8
    bb8 = load b+SA3D_COLOR_RGBA_U8_b as u8
    ba8 = load b+SA3D_COLOR_RGBA_U8_a as u8
    ar = zext ar8 as i32
    ag = zext ag8 as i32
    ab = zext ab8 as i32
    aa = zext aa8 as i32
    br = zext br8 as i32
    bg = zext bg8 as i32
    bb = zext bb8 as i32
    ba = zext ba8 as i32
    r = call @sa3d_color_lerp_u8_channel(ar, br, t)
    g = call @sa3d_color_lerp_u8_channel(ag, bg, t)
    bl = call @sa3d_color_lerp_u8_channel(ab, bb, t)
    al = call @sa3d_color_lerp_u8_channel(aa, ba, t)
    tr = trunc r as u8
    tg = trunc g as u8
    tb = trunc bl as u8
    ta = trunc al as u8
    store dst+SA3D_COLOR_RGBA_U8_r, tr as u8
    store dst+SA3D_COLOR_RGBA_U8_g, tg as u8
    store dst+SA3D_COLOR_RGBA_U8_b, tb as u8
    store dst+SA3D_COLOR_RGBA_U8_a, ta as u8
    !ar8
    !ag8
    !ab8
    !aa8
    !br8
    !bg8
    !bb8
    !ba8
    !ar
    !ag
    !ab
    !aa
    !br
    !bg
    !bb
    !ba
    !r
    !g
    !bl
    !al
    !tr
    !tg
    !tb
    !ta
    !t
    !b
    !a
    !dst
    return

@sa3d_color_premultiply_u8_channel(channel: i32, alpha: i32) -> i32:
L_ENTRY:
    c = call @sa3d_color_clamp_u8(channel)
    a = call @sa3d_color_clamp_u8(alpha)
    product = mul c, a
    rounded = add product, 127
    out = sdiv rounded, 255
    !rounded
    !product
    !a
    !c
    !alpha
    !channel
    return out

@sa3d_color_rgba_u8_premultiply(&dst: ptr, &src: ptr) -> void:
L_ENTRY:
    r8 = load src+SA3D_COLOR_RGBA_U8_r as u8
    g8 = load src+SA3D_COLOR_RGBA_U8_g as u8
    b8 = load src+SA3D_COLOR_RGBA_U8_b as u8
    a8 = load src+SA3D_COLOR_RGBA_U8_a as u8
    r = zext r8 as i32
    g = zext g8 as i32
    b = zext b8 as i32
    a = zext a8 as i32
    pr = call @sa3d_color_premultiply_u8_channel(r, a)
    pg = call @sa3d_color_premultiply_u8_channel(g, a)
    pb = call @sa3d_color_premultiply_u8_channel(b, a)
    tr = trunc pr as u8
    tg = trunc pg as u8
    tb = trunc pb as u8
    ta = trunc a as u8
    store dst+SA3D_COLOR_RGBA_U8_r, tr as u8
    store dst+SA3D_COLOR_RGBA_U8_g, tg as u8
    store dst+SA3D_COLOR_RGBA_U8_b, tb as u8
    store dst+SA3D_COLOR_RGBA_U8_a, ta as u8
    !r8
    !g8
    !b8
    !a8
    !r
    !g
    !b
    !a
    !pr
    !pg
    !pb
    !tr
    !tg
    !tb
    !ta
    !src
    !dst
    return

@sa3d_color_rgba_u8_luminance(&color: ptr) -> i32:
L_ENTRY:
    r8 = load color+SA3D_COLOR_RGBA_U8_r as u8
    g8 = load color+SA3D_COLOR_RGBA_U8_g as u8
    b8 = load color+SA3D_COLOR_RGBA_U8_b as u8
    r = zext r8 as i32
    g = zext g8 as i32
    b = zext b8 as i32
    rw = mul r, 299
    gw = mul g, 587
    bw = mul b, 114
    rg = add rw, gw
    sum = add rg, bw
    rounded = add sum, 500
    out = sdiv rounded, 1000
    !rounded
    !sum
    !rg
    !bw
    !gw
    !rw
    !b
    !g
    !r
    !b8
    !g8
    !r8
    !color
    return out

@sa3d_color_rgba_f32_set(&color: ptr, r: f32, g: f32, b: f32, a: f32) -> void:
L_ENTRY:
    store color+SA3D_COLOR_RGBA_F32_r, r as f32
    store color+SA3D_COLOR_RGBA_F32_g, g as f32
    store color+SA3D_COLOR_RGBA_F32_b, b as f32
    store color+SA3D_COLOR_RGBA_F32_a, a as f32
    !r
    !g
    !b
    !a
    !color
    return

@sa3d_color_rgba_f32_rgb(&color: ptr, r: f32, g: f32, b: f32) -> void:
L_ENTRY:
    store color+SA3D_COLOR_RGBA_F32_r, r as f32
    store color+SA3D_COLOR_RGBA_F32_g, g as f32
    store color+SA3D_COLOR_RGBA_F32_b, b as f32
    store color+SA3D_COLOR_RGBA_F32_a, 1.0 as f32
    !r
    !g
    !b
    !color
    return

@sa3d_color_rgba_f32_alpha(&color: ptr) -> f32:
L_ENTRY:
    alpha = load color+SA3D_COLOR_RGBA_F32_a as f32
    !color
    return alpha

@sa3d_color_rgba_f32_set_alpha(&color: ptr, alpha: f32) -> void:
L_ENTRY:
    store color+SA3D_COLOR_RGBA_F32_a, alpha as f32
    !alpha
    !color
    return

@sa3d_color_rgba_f32_copy_with_alpha(&dst: ptr, &src: ptr, alpha: f32) -> void:
L_ENTRY:
    r = load src+SA3D_COLOR_RGBA_F32_r as f32
    g = load src+SA3D_COLOR_RGBA_F32_g as f32
    b = load src+SA3D_COLOR_RGBA_F32_b as f32
    store dst+SA3D_COLOR_RGBA_F32_r, r as f32
    store dst+SA3D_COLOR_RGBA_F32_g, g as f32
    store dst+SA3D_COLOR_RGBA_F32_b, b as f32
    store dst+SA3D_COLOR_RGBA_F32_a, alpha as f32
    !r
    !g
    !b
    !alpha
    !src
    !dst
    return

@sa3d_color_rgba_f32_mix(&dst: ptr, &a: ptr, &b: ptr, factor: f32) -> void:
L_ENTRY:
    factor_slot = stack_alloc 4
    inv_slot = stack_alloc 4
    store factor_slot+0, factor as f32
    inv = fsub 1.0, factor
    store inv_slot+0, inv as f32
    ar = load a+SA3D_COLOR_RGBA_F32_r as f32
    br = load b+SA3D_COLOR_RGBA_F32_r as f32
    ir = load inv_slot+0 as f32
    fr = load factor_slot+0 as f32
    lr = fmul ar, ir
    rr = fmul br, fr
    out_r = fadd lr, rr
    ag = load a+SA3D_COLOR_RGBA_F32_g as f32
    bg = load b+SA3D_COLOR_RGBA_F32_g as f32
    ig = load inv_slot+0 as f32
    fg = load factor_slot+0 as f32
    lg = fmul ag, ig
    rg = fmul bg, fg
    out_g = fadd lg, rg
    ab = load a+SA3D_COLOR_RGBA_F32_b as f32
    bb = load b+SA3D_COLOR_RGBA_F32_b as f32
    ib = load inv_slot+0 as f32
    fb = load factor_slot+0 as f32
    lb = fmul ab, ib
    rb = fmul bb, fb
    out_b = fadd lb, rb
    aa = load a+SA3D_COLOR_RGBA_F32_a as f32
    ba = load b+SA3D_COLOR_RGBA_F32_a as f32
    ia = load inv_slot+0 as f32
    fa = load factor_slot+0 as f32
    la = fmul aa, ia
    ra = fmul ba, fa
    out_a = fadd la, ra
    store dst+SA3D_COLOR_RGBA_F32_r, out_r as f32
    store dst+SA3D_COLOR_RGBA_F32_g, out_g as f32
    store dst+SA3D_COLOR_RGBA_F32_b, out_b as f32
    store dst+SA3D_COLOR_RGBA_F32_a, out_a as f32
    !out_a
    !ra
    !la
    !fa
    !ia
    !ba
    !aa
    !out_b
    !rb
    !lb
    !fb
    !ib
    !bb
    !ab
    !out_g
    !rg
    !lg
    !fg
    !ig
    !bg
    !ag
    !out_r
    !rr
    !lr
    !fr
    !ir
    !br
    !ar
    !inv
    !b
    !a
    !dst
    return

@sa3d_color_linear_rgba_f32_luminance(&color: ptr) -> f32:
L_ENTRY:
    r = load color+SA3D_COLOR_RGBA_F32_r as f32
    g = load color+SA3D_COLOR_RGBA_F32_g as f32
    b = load color+SA3D_COLOR_RGBA_F32_b as f32
    rw = fmul r, 0.2126
    gw = fmul g, 0.7152
    bw = fmul b, 0.0722
    rg = fadd rw, gw
    out = fadd rg, bw
    !rg
    !bw
    !gw
    !rw
    !b
    !g
    !r
    !color
    return out

@sa3d_color_f32_rem_euclid_360(value: f32) -> f32:
L_ENTRY:
    slot = stack_alloc 4
    store slot+0, value as f32
    jmp L_LOW_CHECK

L_LOW_CHECK:
    current_low = load slot+0 as f32
    is_low = fcmp_lt current_low, 0.0
    br is_low -> L_ADD, L_HIGH_CHECK

L_ADD:
    plus = fadd current_low, 360.0
    store slot+0, plus as f32
    !plus
    !is_low
    !current_low
    jmp L_LOW_CHECK

L_HIGH_CHECK:
    current_high = load slot+0 as f32
    is_high = fcmp_ge current_high, 360.0
    br is_high -> L_SUB, L_DONE

L_SUB:
    minus = fsub current_high, 360.0
    store slot+0, minus as f32
    !minus
    !is_high
    !current_high
    jmp L_HIGH_CHECK

L_DONE:
    out = load slot+0 as f32
    !is_high
    !current_high
    !value
    return out

@sa3d_color_lerp_hue(a: f32, b: f32, t: f32) -> f32:
L_ENTRY:
    b_minus_a = fsub b, a
    shifted = fadd b_minus_a, 180.0
    wrapped = call @sa3d_color_f32_rem_euclid_360(shifted)
    diff = fsub wrapped, 180.0
    scaled = fmul diff, t
    raw = fadd a, scaled
    out = call @sa3d_color_f32_rem_euclid_360(raw)
    !raw
    !scaled
    !diff
    !wrapped
    !shifted
    !b_minus_a
    !t
    !b
    !a
    return out

@sa3d_color_hsva_set(&color: ptr, h: f32, s: f32, v: f32, a: f32) -> void:
L_ENTRY:
    hue = call @sa3d_color_f32_rem_euclid_360(h)
    store color+SA3D_COLOR_HSVA_F32_h, hue as f32
    store color+SA3D_COLOR_HSVA_F32_s, s as f32
    store color+SA3D_COLOR_HSVA_F32_v, v as f32
    store color+SA3D_COLOR_HSVA_F32_a, a as f32
    !hue
    !h
    !s
    !v
    !a
    !color
    return

@sa3d_color_hsva_hsv(&color: ptr, h: f32, s: f32, v: f32) -> void:
L_ENTRY:
    call @sa3d_color_hsva_set(&color, h, s, v, 1.0)
    !h
    !s
    !v
    !color
    return

@sa3d_color_hsva_alpha(&color: ptr) -> f32:
L_ENTRY:
    alpha = load color+SA3D_COLOR_HSVA_F32_a as f32
    !color
    return alpha

@sa3d_color_hsva_set_alpha(&color: ptr, alpha: f32) -> void:
L_ENTRY:
    store color+SA3D_COLOR_HSVA_F32_a, alpha as f32
    !alpha
    !color
    return

@sa3d_color_hsva_with_alpha(&dst: ptr, &src: ptr, alpha: f32) -> void:
L_ENTRY:
    h = load src+SA3D_COLOR_HSVA_F32_h as f32
    s = load src+SA3D_COLOR_HSVA_F32_s as f32
    v = load src+SA3D_COLOR_HSVA_F32_v as f32
    store dst+SA3D_COLOR_HSVA_F32_h, h as f32
    store dst+SA3D_COLOR_HSVA_F32_s, s as f32
    store dst+SA3D_COLOR_HSVA_F32_v, v as f32
    store dst+SA3D_COLOR_HSVA_F32_a, alpha as f32
    !h
    !s
    !v
    !alpha
    !src
    !dst
    return

@sa3d_color_hsva_hue(&color: ptr) -> f32:
L_ENTRY:
    hue = load color+SA3D_COLOR_HSVA_F32_h as f32
    !color
    return hue

@sa3d_color_hsva_set_hue(&color: ptr, hue: f32) -> void:
L_ENTRY:
    wrapped = call @sa3d_color_f32_rem_euclid_360(hue)
    store color+SA3D_COLOR_HSVA_F32_h, wrapped as f32
    !wrapped
    !hue
    !color
    return

@sa3d_color_hsva_rotate_hue(&dst: ptr, &src: ptr, degrees: f32) -> void:
L_ENTRY:
    h = load src+SA3D_COLOR_HSVA_F32_h as f32
    s = load src+SA3D_COLOR_HSVA_F32_s as f32
    v = load src+SA3D_COLOR_HSVA_F32_v as f32
    a = load src+SA3D_COLOR_HSVA_F32_a as f32
    raw = fadd h, degrees
    wrapped = call @sa3d_color_f32_rem_euclid_360(raw)
    store dst+SA3D_COLOR_HSVA_F32_h, wrapped as f32
    store dst+SA3D_COLOR_HSVA_F32_s, s as f32
    store dst+SA3D_COLOR_HSVA_F32_v, v as f32
    store dst+SA3D_COLOR_HSVA_F32_a, a as f32
    !wrapped
    !raw
    !h
    !s
    !v
    !a
    !degrees
    !src
    !dst
    return

@sa3d_color_hsva_mix(&dst: ptr, &a: ptr, &b: ptr, factor: f32) -> void:
L_ENTRY:
    n_factor = fsub 1.0, factor
    ah = load a+SA3D_COLOR_HSVA_F32_h as f32
    bh = load b+SA3D_COLOR_HSVA_F32_h as f32
    hue = call @sa3d_color_lerp_hue(ah, bh, factor)
    as = load a+SA3D_COLOR_HSVA_F32_s as f32
    bs = load b+SA3D_COLOR_HSVA_F32_s as f32
    as_l = fmul as, n_factor
    bs_r = fmul bs, factor
    saturation = fadd as_l, bs_r
    av = load a+SA3D_COLOR_HSVA_F32_v as f32
    bv = load b+SA3D_COLOR_HSVA_F32_v as f32
    av_l = fmul av, n_factor
    bv_r = fmul bv, factor
    value = fadd av_l, bv_r
    aa = load a+SA3D_COLOR_HSVA_F32_a as f32
    ba = load b+SA3D_COLOR_HSVA_F32_a as f32
    aa_l = fmul aa, n_factor
    ba_r = fmul ba, factor
    alpha = fadd aa_l, ba_r
    store dst+SA3D_COLOR_HSVA_F32_h, hue as f32
    store dst+SA3D_COLOR_HSVA_F32_s, saturation as f32
    store dst+SA3D_COLOR_HSVA_F32_v, value as f32
    store dst+SA3D_COLOR_HSVA_F32_a, alpha as f32
    !alpha
    !ba_r
    !aa_l
    !ba
    !aa
    !value
    !bv_r
    !av_l
    !bv
    !av
    !saturation
    !bs_r
    !as_l
    !bs
    !as
    !hue
    !bh
    !ah
    !n_factor
    !factor
    !b
    !a
    !dst
    return
