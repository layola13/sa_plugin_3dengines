@import "../3d_color.sal"

@test "3d_color rgba and gradient layouts"():
L_ENTRY:
    color = alloc SA3D_COLOR_RGBA_F32_SIZE
    stop = alloc SA3D_COLOR_GRADIENT_STOP_SIZE
    store color+SA3D_COLOR_RGBA_F32_r, 1065353216 as i32
    store color+SA3D_COLOR_RGBA_F32_g, 1056964608 as i32
    store color+SA3D_COLOR_RGBA_F32_b, 0 as i32
    store color+SA3D_COLOR_RGBA_F32_a, 1065353216 as i32
    store stop+SA3D_COLOR_GRADIENT_STOP_color, 1065353216 as i32
    store stop+SA3D_COLOR_GRADIENT_STOP_position, 1056964608 as i32
    r = load color+0 as i32
    g = load color+4 as i32
    a = load color+12 as i32
    stop_color = load stop+0 as i32
    stop_pos = load stop+16 as i32
    r_ok = eq r, 1065353216
    g_ok = eq g, 1056964608
    a_ok = eq a, 1065353216
    stop_color_ok = eq stop_color, 1065353216
    stop_pos_ok = eq stop_pos, 1056964608
    rgba_size_ok = eq SA3D_COLOR_RGBA_F32_SIZE, 16
    hsva_size_ok = eq SA3D_COLOR_HSVA_F32_SIZE, 16
    u8_size_ok = eq SA3D_COLOR_RGBA_U8_SIZE, 4
    u16_size_ok = eq SA3D_COLOR_RGBA_U16_SIZE, 8
    gradient_size_ok = eq SA3D_COLOR_GRADIENT_STOP_SIZE, 24
    space_ok = eq SA3D_COLOR_SPACE_SRGB, 2
    pair1 = and r_ok, g_ok
    pair2 = and a_ok, stop_color_ok
    pair3 = and stop_pos_ok, rgba_size_ok
    pair4 = and hsva_size_ok, u8_size_ok
    pair5 = and gradient_size_ok, space_ok
    pair6 = and u16_size_ok, pair5
    ok1 = and pair1, pair2
    ok2 = and pair3, pair4
    ok3 = and ok1, ok2
    ok = and ok3, pair6
    br ok -> L_OK, L_ERR

L_OK:
    !stop
    !color
    return

L_ERR:
    !stop
    !color
    panic(3110)

@test "3d_color rgba u8 pack alpha and clamp behavior"():
L_ENTRY:
    color = alloc SA3D_COLOR_RGBA_U8_SIZE
    copy = alloc SA3D_COLOR_RGBA_U8_SIZE
    unpacked = alloc SA3D_COLOR_RGBA_U8_SIZE
    call @sa3d_color_rgba_u8_set(&color, 300, -10, 128, 64)
    packed = call @sa3d_color_rgba_u8_pack(&color)
    alpha0 = call @sa3d_color_rgba_u8_alpha(&color)
    call @sa3d_color_rgba_u8_set_alpha(&color, 512)
    alpha1 = call @sa3d_color_rgba_u8_alpha(&color)
    call @sa3d_color_rgba_u8_copy_with_alpha(&copy, &color, 33)
    copy_alpha = call @sa3d_color_rgba_u8_alpha(&copy)
    call @sa3d_color_rgba_u8_unpack(&unpacked, 287454020)
    ur = load unpacked+SA3D_COLOR_RGBA_U8_r as u8
    ug = load unpacked+SA3D_COLOR_RGBA_U8_g as u8
    ub = load unpacked+SA3D_COLOR_RGBA_U8_b as u8
    ua = load unpacked+SA3D_COLOR_RGBA_U8_a as u8
    ur32 = zext ur as i32
    ug32 = zext ug as i32
    ub32 = zext ub as i32
    ua32 = zext ua as i32

    packed_ok = eq packed, 4278222912
    alpha0_ok = eq alpha0, 64
    alpha1_ok = eq alpha1, 255
    copy_alpha_ok = eq copy_alpha, 33
    ur_ok = eq ur32, 17
    ug_ok = eq ug32, 34
    ub_ok = eq ub32, 51
    ua_ok = eq ua32, 68
    p1 = and packed_ok, alpha0_ok
    p2 = and alpha1_ok, copy_alpha_ok
    p3 = and ur_ok, ug_ok
    p4 = and ub_ok, ua_ok
    q1 = and p1, p2
    q2 = and p3, p4
    ok = and q1, q2
    br ok -> L_RGBA_OK, L_RGBA_ERR

L_RGBA_OK:
    !unpacked
    !copy
    !color
    return

L_RGBA_ERR:
    !unpacked
    !copy
    !color
    panic(3111)

@test "3d_color srgb and linear fixed point conversions"():
L_ENTRY:
    srgb = alloc SA3D_COLOR_RGBA_U8_SIZE
    linear = alloc SA3D_COLOR_RGBA_U16_SIZE
    roundtrip = alloc SA3D_COLOR_RGBA_U8_SIZE
    call @sa3d_color_rgba_u8_set(&srgb, 0, 128, 255, 64)
    l0 = call @sa3d_color_srgb_u8_to_linear_u16(0)
    l128 = call @sa3d_color_srgb_u8_to_linear_u16(128)
    l255 = call @sa3d_color_srgb_u8_to_linear_u16(255)
    s0 = call @sa3d_color_linear_u16_to_srgb_u8(0)
    s128 = call @sa3d_color_linear_u16_to_srgb_u8(14146)
    s255 = call @sa3d_color_linear_u16_to_srgb_u8(65535)
    call @sa3d_color_rgba_u8_to_linear_u16(&linear, &srgb)
    lr = load linear+SA3D_COLOR_RGBA_U16_r as u16
    lg = load linear+SA3D_COLOR_RGBA_U16_g as u16
    lb = load linear+SA3D_COLOR_RGBA_U16_b as u16
    la = load linear+SA3D_COLOR_RGBA_U16_a as u16
    lr32 = zext lr as i32
    lg32 = zext lg as i32
    lb32 = zext lb as i32
    la32 = zext la as i32
    call @sa3d_color_linear_u16_to_rgba_u8(&roundtrip, &linear)
    rr = load roundtrip+SA3D_COLOR_RGBA_U8_r as u8
    rg = load roundtrip+SA3D_COLOR_RGBA_U8_g as u8
    rb = load roundtrip+SA3D_COLOR_RGBA_U8_b as u8
    ra = load roundtrip+SA3D_COLOR_RGBA_U8_a as u8
    rr32 = zext rr as i32
    rg32 = zext rg as i32
    rb32 = zext rb as i32
    ra32 = zext ra as i32

    l0_ok = eq l0, 0
    l128_ok = eq l128, 14146
    l255_ok = eq l255, 65535
    s0_ok = eq s0, 0
    s128_ok = eq s128, 128
    s255_ok = eq s255, 255
    lr_ok = eq lr32, 0
    lg_ok = eq lg32, 14146
    lb_ok = eq lb32, 65535
    la_ok = eq la32, 16448
    rr_ok = eq rr32, 0
    rg_ok = eq rg32, 128
    rb_ok = eq rb32, 255
    ra_ok = eq ra32, 64
    a1 = and l0_ok, l128_ok
    a2 = and l255_ok, s0_ok
    a3 = and s128_ok, s255_ok
    a4 = and lr_ok, lg_ok
    a5 = and lb_ok, la_ok
    a6 = and rr_ok, rg_ok
    a7 = and rb_ok, ra_ok
    b1 = and a1, a2
    b2 = and a3, a4
    b3 = and a5, a6
    b4 = and b1, b2
    b5 = and b3, a7
    ok = and b4, b5
    br ok -> L_CONVERT_OK, L_CONVERT_ERR

L_CONVERT_OK:
    !roundtrip
    !linear
    !srgb
    return

L_CONVERT_ERR:
    !roundtrip
    !linear
    !srgb
    panic(3112)

@test "3d_color u8 lerp premultiply and luminance"():
L_ENTRY:
    a = alloc SA3D_COLOR_RGBA_U8_SIZE
    b = alloc SA3D_COLOR_RGBA_U8_SIZE
    mid = alloc SA3D_COLOR_RGBA_U8_SIZE
    start = alloc SA3D_COLOR_RGBA_U8_SIZE
    end = alloc SA3D_COLOR_RGBA_U8_SIZE
    premul = alloc SA3D_COLOR_RGBA_U8_SIZE
    call @sa3d_color_rgba_u8_set(&a, 10, 20, 30, 40)
    call @sa3d_color_rgba_u8_set(&b, 110, 220, 250, 240)
    call @sa3d_color_rgba_u8_lerp(&start, &a, &b, 0)
    call @sa3d_color_rgba_u8_lerp(&end, &a, &b, 255)
    call @sa3d_color_rgba_u8_lerp(&mid, &a, &b, 128)
    call @sa3d_color_rgba_u8_premultiply(&premul, &b)
    mid_r8 = load mid+SA3D_COLOR_RGBA_U8_r as u8
    mid_g8 = load mid+SA3D_COLOR_RGBA_U8_g as u8
    mid_b8 = load mid+SA3D_COLOR_RGBA_U8_b as u8
    mid_a8 = load mid+SA3D_COLOR_RGBA_U8_a as u8
    start_r8 = load start+SA3D_COLOR_RGBA_U8_r as u8
    end_b8 = load end+SA3D_COLOR_RGBA_U8_b as u8
    pre_r8 = load premul+SA3D_COLOR_RGBA_U8_r as u8
    pre_g8 = load premul+SA3D_COLOR_RGBA_U8_g as u8
    pre_b8 = load premul+SA3D_COLOR_RGBA_U8_b as u8
    pre_a8 = load premul+SA3D_COLOR_RGBA_U8_a as u8
    mid_r = zext mid_r8 as i32
    mid_g = zext mid_g8 as i32
    mid_b = zext mid_b8 as i32
    mid_a = zext mid_a8 as i32
    start_r = zext start_r8 as i32
    end_b = zext end_b8 as i32
    pre_r = zext pre_r8 as i32
    pre_g = zext pre_g8 as i32
    pre_b = zext pre_b8 as i32
    pre_a = zext pre_a8 as i32
    lum_a = call @sa3d_color_rgba_u8_luminance(&a)
    lum_b = call @sa3d_color_rgba_u8_luminance(&b)
    channel_mid = call @sa3d_color_lerp_u8_channel(0, 255, 128)
    premul_channel = call @sa3d_color_premultiply_u8_channel(128, 128)
    mid_r_ok = eq mid_r, 60
    mid_g_ok = eq mid_g, 120
    mid_b_ok = eq mid_b, 140
    mid_a_ok = eq mid_a, 140
    start_r_ok = eq start_r, 10
    end_b_ok = eq end_b, 250
    pre_r_ok = eq pre_r, 104
    pre_g_ok = eq pre_g, 207
    pre_b_ok = eq pre_b, 235
    pre_a_ok = eq pre_a, 240
    lum_a_ok = eq lum_a, 18
    lum_b_ok = eq lum_b, 191
    channel_mid_ok = eq channel_mid, 128
    premul_channel_ok = eq premul_channel, 64
    p1 = and mid_r_ok, mid_g_ok
    p2 = and mid_b_ok, mid_a_ok
    p3 = and start_r_ok, end_b_ok
    p4 = and pre_r_ok, pre_g_ok
    p5 = and pre_b_ok, pre_a_ok
    p6 = and lum_a_ok, lum_b_ok
    p7 = and channel_mid_ok, premul_channel_ok
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    q4 = and q1, q2
    q5 = and q3, p7
    ok = and q4, q5
    br ok -> L_COLOR_OPS_OK, L_COLOR_OPS_ERR

L_COLOR_OPS_OK:
    !premul
    !end
    !start
    !mid
    !b
    !a
    return

L_COLOR_OPS_ERR:
    !premul
    !end
    !start
    !mid
    !b
    !a
    panic(3113)

@test "3d_color rgba f32 operations match Bevy LinearRgba basics"():
L_ENTRY:
    a = alloc SA3D_COLOR_RGBA_F32_SIZE
    b = alloc SA3D_COLOR_RGBA_F32_SIZE
    mixed = alloc SA3D_COLOR_RGBA_F32_SIZE
    alpha_copy = alloc SA3D_COLOR_RGBA_F32_SIZE
    bits = alloc 24
    call @sa3d_color_rgba_f32_set(&a, 0.0, 0.5, 1.0, 1.0)
    call @sa3d_color_rgba_f32_set(&b, 1.0, 0.0, 0.0, 0.5)
    call @sa3d_color_rgba_f32_mix(&mixed, &a, &b, 0.25)
    call @sa3d_color_rgba_f32_copy_with_alpha(&alpha_copy, &mixed, 0.875)
    alpha0 = call @sa3d_color_rgba_f32_alpha(&mixed)
    call @sa3d_color_rgba_f32_set_alpha(&mixed, 0.375)
    alpha1 = call @sa3d_color_rgba_f32_alpha(&mixed)
    luminance = call @sa3d_color_linear_rgba_f32_luminance(&a)
    r = load mixed+SA3D_COLOR_RGBA_F32_r as f32
    g = load mixed+SA3D_COLOR_RGBA_F32_g as f32
    bl = load mixed+SA3D_COLOR_RGBA_F32_b as f32
    copy_a = load alpha_copy+SA3D_COLOR_RGBA_F32_a as f32
    store bits+0, r as f32
    store bits+4, g as f32
    store bits+8, bl as f32
    store bits+12, alpha0 as f32
    store bits+16, alpha1 as f32
    store bits+20, copy_a as f32
    rb = load bits+0 as i32
    gb = load bits+4 as i32
    bb = load bits+8 as i32
    a0b = load bits+12 as i32
    a1b = load bits+16 as i32
    cab = load bits+20 as i32
    lum_ok = fcmp_lt luminance, 0.43
    lum_low_ok = fcmp_gt luminance, 0.42
    lum_pair_ok = and lum_ok, lum_low_ok
    r_ok = eq rb, 1048576000
    g_ok = eq gb, 1052770304
    b_ok = eq bb, 1061158912
    a0_ok = eq a0b, 1063256064
    a1_ok = eq a1b, 1052770304
    ca_ok = eq cab, 1063256064
    p1 = and r_ok, g_ok
    p2 = and b_ok, a0_ok
    p3 = and a1_ok, ca_ok
    q1 = and p1, p2
    q2 = and p3, lum_pair_ok
    ok = and q1, q2
    br ok -> L_OK, L_ERR

L_OK:
    !bits
    !alpha_copy
    !mixed
    !b
    !a
    return

L_ERR:
    !bits
    !alpha_copy
    !mixed
    !b
    !a
    panic(3114)

@test "3d_color hsva hue mix alpha matches Bevy color ops"():
L_ENTRY:
    a = alloc SA3D_COLOR_HSVA_F32_SIZE
    b = alloc SA3D_COLOR_HSVA_F32_SIZE
    mixed = alloc SA3D_COLOR_HSVA_F32_SIZE
    rotated = alloc SA3D_COLOR_HSVA_F32_SIZE
    alpha_copy = alloc SA3D_COLOR_HSVA_F32_SIZE
    call @sa3d_color_hsva_set(&a, 350.0, 0.25, 0.5, 0.2)
    call @sa3d_color_hsva_set(&b, 10.0, 0.75, 1.0, 0.8)
    hue_a = call @sa3d_color_hsva_hue(&a)
    alpha_a = call @sa3d_color_hsva_alpha(&a)
    hue_wrap = call @sa3d_color_lerp_hue(10.0, 350.0, 0.75)
    hue_cross = call @sa3d_color_lerp_hue(350.0, 10.0, 0.25)
    call @sa3d_color_hsva_mix(&mixed, &a, &b, 0.25)
    call @sa3d_color_hsva_rotate_hue(&rotated, &a, 30.0)
    call @sa3d_color_hsva_with_alpha(&alpha_copy, &mixed, 0.125)
    call @sa3d_color_hsva_set_alpha(&mixed, 0.5)
    mixed_h = load mixed+SA3D_COLOR_HSVA_F32_h as f32
    mixed_s = load mixed+SA3D_COLOR_HSVA_F32_s as f32
    mixed_v = load mixed+SA3D_COLOR_HSVA_F32_v as f32
    mixed_a = load mixed+SA3D_COLOR_HSVA_F32_a as f32
    rotated_h = load rotated+SA3D_COLOR_HSVA_F32_h as f32
    copy_a = load alpha_copy+SA3D_COLOR_HSVA_F32_a as f32
    c0 = fcmp_eq hue_a, 350.0
    c1_low = fcmp_gt alpha_a, 0.199
    c1_high = fcmp_lt alpha_a, 0.201
    c1 = and c1_low, c1_high
    c2 = fcmp_gt hue_wrap, 354.99
    c3 = fcmp_lt hue_wrap, 355.01
    c4 = fcmp_gt hue_cross, 354.99
    c5 = fcmp_lt hue_cross, 355.01
    c6 = fcmp_gt mixed_h, 354.99
    c7 = fcmp_lt mixed_h, 355.01
    c8 = fcmp_eq mixed_s, 0.375
    c9 = fcmp_eq mixed_v, 0.625
    c10 = fcmp_eq mixed_a, 0.5
    c11 = fcmp_gt rotated_h, 19.99
    c12 = fcmp_lt rotated_h, 20.01
    c13 = fcmp_eq copy_a, 0.125
    p0 = and c0, c1
    p1 = and c2, c3
    p2 = and c4, c5
    p3 = and c6, c7
    p4 = and c8, c9
    p5 = and c10, c11
    p6 = and c12, c13
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    r0 = and q0, q1
    r1 = and q2, p6
    ok = and r0, r1
    br ok -> L_OK, L_ERR

L_OK:
    !alpha_copy
    !rotated
    !mixed
    !b
    !a
    return

L_ERR:
    !alpha_copy
    !rotated
    !mixed
    !b
    !a
    br c0 -> L_D1, L_E0
L_E0:
    panic(3115)
L_D1:
    br c1 -> L_D2, L_E1
L_E1:
    panic(3116)
L_D2:
    br c2 -> L_D3, L_E2
L_E2:
    panic(3117)
L_D3:
    br c3 -> L_D4, L_E3
L_E3:
    panic(3118)
L_D4:
    br c4 -> L_D5, L_E4
L_E4:
    panic(3119)
L_D5:
    br c5 -> L_D6, L_E5
L_E5:
    panic(3120)
L_D6:
    br c6 -> L_D7, L_E6
L_E6:
    panic(3121)
L_D7:
    br c7 -> L_D8, L_E7
L_E7:
    panic(3122)
L_D8:
    br c8 -> L_D9, L_E8
L_E8:
    panic(3123)
L_D9:
    br c9 -> L_D10, L_E9
L_E9:
    panic(3124)
L_D10:
    br c10 -> L_D11, L_E10
L_E10:
    panic(3125)
L_D11:
    br c11 -> L_D12, L_E11
L_E11:
    panic(3126)
L_D12:
    br c12 -> L_D13, L_E12
L_E12:
    panic(3127)
L_D13:
    br c13 -> L_E_UNKNOWN, L_E13
L_E13:
    panic(3128)
L_E_UNKNOWN:
    panic(3129)
