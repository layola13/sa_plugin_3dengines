@sa3d_app_main_schedule_order_insert_startup_before(&order: ptr, before: i64, schedule: i64) -> i32:
L_ENTRY:
    labels = load order+SA3D_APP_MAIN_SCHEDULE_ORDER_startup_labels_ptr as i64
    len = load order+SA3D_APP_MAIN_SCHEDULE_ORDER_startup_labels_len as i64
    found = call @sa3d_app_labels_find_index(labels, len, before)
    valid = sge found, 0
    br valid -> L_INSERT, L_FAIL

L_INSERT:
    len_ptr = ptr_add order, SA3D_APP_MAIN_SCHEDULE_ORDER_startup_labels_len
    out = call @sa3d_app_labels_insert_at(labels, &len_ptr, 8, found, schedule)
    !len_ptr
    !valid
    !found
    !len
    !before
    !schedule
    !labels
    !order
    return out

L_FAIL:
    !valid
    !found
    !len
    !before
    !schedule
    !labels
    !order
    return 0

