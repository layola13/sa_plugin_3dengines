L_INSERT:
    len_ptr = ptr_add order, SA3D_APP_MAIN_SCHEDULE_ORDER_labels_len
    out = call @sa3d_app_labels_insert_at(labels, &len_ptr, 16, found, schedule)
    !len_ptr
    !valid
    !found
    !len
    !before
    !schedule
    !labels
    !order
    return out

L_FAIL:
    !valid
    !found
