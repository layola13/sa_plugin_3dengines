    !labels
    !order
    return 0

@sa3d_app_main_schedule_order_insert_startup_after(&order: ptr, after: i64, schedule: i64) -> i32:
L_ENTRY:
    labels = load order+SA3D_APP_MAIN_SCHEDULE_ORDER_startup_labels_ptr as i64
