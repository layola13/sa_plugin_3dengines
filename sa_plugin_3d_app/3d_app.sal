L_ENTRY:
    labels = load order+SA3D_APP_FIXED_MAIN_SCHEDULE_ORDER_labels_ptr as i64
    len = load order+SA3D_APP_FIXED_MAIN_SCHEDULE_ORDER_labels_len as i64
    found = call @sa3d_app_labels_find_index(labels, len, after)
    valid = sge found, 0
    br valid -> L_INSERT, L_FAIL

L_INSERT:
    index = add found, 1
    len_ptr = ptr_add order, SA3D_APP_FIXED_MAIN_SCHEDULE_ORDER_labels_len
    out = call @sa3d_app_labels_insert_at(labels, &len_ptr, 8, index, schedule)
    !len_ptr
    !index
    !valid
    !found
    !len
    !after
    !schedule
    !labels
    !order
    return out

L_FAIL:
    !valid
    !found
    !len
    !after
    !schedule
    !labels
    !order
    return 0

