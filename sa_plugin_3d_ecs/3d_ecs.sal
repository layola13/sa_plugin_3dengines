#def SA3D_ECS_VERSION_MAJOR = 0
#def SA3D_ECS_VERSION_MINOR = 1

#def SA3D_ECS_ENTITY_ID_index = +0
#def SA3D_ECS_ENTITY_ID_generation = +8
#def SA3D_ECS_ENTITY_ID_SIZE = 16

#def SA3D_ECS_COMPONENT_DESC_type_id = +0
#def SA3D_ECS_COMPONENT_DESC_size = +8
#def SA3D_ECS_COMPONENT_DESC_align = +16
#def SA3D_ECS_COMPONENT_DESC_name_ptr = +24
#def SA3D_ECS_COMPONENT_DESC_name_len = +32
#def SA3D_ECS_COMPONENT_DESC_SIZE = 40

#def SA3D_ECS_QUERY_TERM_component_type = +0
#def SA3D_ECS_QUERY_TERM_access = +8
#def SA3D_ECS_QUERY_TERM_flags = +12
#def SA3D_ECS_QUERY_TERM_SIZE = 16

#def SA3D_ECS_QUERY_ACCESS_READ = 1
#def SA3D_ECS_QUERY_ACCESS_WRITE = 2
#def SA3D_ECS_QUERY_ACCESS_WITH = 3
#def SA3D_ECS_QUERY_ACCESS_WITHOUT = 4
#def SA3D_ECS_QUERY_ACCESS_OPTIONAL_READ = 5
#def SA3D_ECS_QUERY_ACCESS_OPTIONAL_WRITE = 6
#def SA3D_ECS_QUERY_ACCESS_FILTER_SET = 7
#def SA3D_ECS_QUERY_ACCESS_READ_ALL = 8
#def SA3D_ECS_QUERY_ACCESS_WRITE_ALL = 9

#def SA3D_ECS_QUERY_DESC_terms_ptr = +0
#def SA3D_ECS_QUERY_DESC_terms_len = +8
#def SA3D_ECS_QUERY_DESC_result_stride = +16
#def SA3D_ECS_QUERY_DESC_SIZE = 24

#def SA3D_ECS_WORLD_DESC_components_ptr = +0
#def SA3D_ECS_WORLD_DESC_components_len = +8
#def SA3D_ECS_WORLD_DESC_entity_capacity = +16
#def SA3D_ECS_WORLD_DESC_FLAGS = +24
#def SA3D_ECS_WORLD_DESC_SIZE = 32

#def SA3D_ECS_ENTITY_META_generation = +0
#def SA3D_ECS_ENTITY_META_spawned = +8
#def SA3D_ECS_ENTITY_META_SIZE = 16

#def SA3D_ECS_WORLD_STATE_metas_ptr = +0
#def SA3D_ECS_WORLD_STATE_capacity = +8
#def SA3D_ECS_WORLD_STATE_next_index = +16
#def SA3D_ECS_WORLD_STATE_alive_count = +24
#def SA3D_ECS_WORLD_STATE_dead_count = +32
#def SA3D_ECS_WORLD_STATE_free_indices_ptr = +40
#def SA3D_ECS_WORLD_STATE_free_count = +48
#def SA3D_ECS_WORLD_STATE_SIZE = 56

@sa3d_ecs_entity_id_init(&entity: ptr, index: i64, generation: i64) -> void:
L_ENTRY:
    store entity+SA3D_ECS_ENTITY_ID_index, index as i64
    store entity+SA3D_ECS_ENTITY_ID_generation, generation as i64
    !generation
    !index
    !entity
    return

@sa3d_ecs_entity_id_get_index(&entity: ptr) -> i64:
L_ENTRY:
    idx = load entity+SA3D_ECS_ENTITY_ID_index as i64
    !entity
    return idx

@sa3d_ecs_entity_id_get_generation(&entity: ptr) -> i64:
L_ENTRY:
    gen = load entity+SA3D_ECS_ENTITY_ID_generation as i64
    !entity
    return gen

@sa3d_ecs_entity_id_equal(&a: ptr, &b: ptr) -> i32:
L_ENTRY:
    a_idx = load a+SA3D_ECS_ENTITY_ID_index as i64
    b_idx = load b+SA3D_ECS_ENTITY_ID_index as i64
    a_gen = load a+SA3D_ECS_ENTITY_ID_generation as i64
    b_gen = load b+SA3D_ECS_ENTITY_ID_generation as i64
    idx_eq = eq a_idx, b_idx
    gen_eq = eq a_gen, b_gen
    ok = and idx_eq, gen_eq
    !b_gen
    !a_gen
    !b_idx
    !a_idx
    !b
    !a
    br ok -> L_YES, L_NO
L_YES:
    !ok
    return 1
L_NO:
    !ok
    return 0

@sa3d_ecs_component_desc_init(&desc: ptr, type_id: i64, size: i64, align: i64) -> void:
L_ENTRY:
    store desc+SA3D_ECS_COMPONENT_DESC_type_id, type_id as i64
    store desc+SA3D_ECS_COMPONENT_DESC_size, size as i64
    store desc+SA3D_ECS_COMPONENT_DESC_align, align as i64
    store desc+SA3D_ECS_COMPONENT_DESC_name_ptr, 0 as i64
    store desc+SA3D_ECS_COMPONENT_DESC_name_len, 0 as i64
    !align
    !size
    !type_id
    !desc
    return

@sa3d_ecs_query_term_init(&term: ptr, component_type: i64, access: i32, flags: i32) -> void:
L_ENTRY:
    store term+SA3D_ECS_QUERY_TERM_component_type, component_type as i64
    store term+SA3D_ECS_QUERY_TERM_access, access as i32
    store term+SA3D_ECS_QUERY_TERM_flags, flags as i32
    !flags
    !access
    !component_type
    !term
    return

@sa3d_ecs_query_desc_init(&desc: ptr, terms: ptr, terms_len: i64, result_stride: i64) -> void:
L_ENTRY:
    store desc+SA3D_ECS_QUERY_DESC_terms_ptr, terms as ptr
    store desc+SA3D_ECS_QUERY_DESC_terms_len, terms_len as i64
    store desc+SA3D_ECS_QUERY_DESC_result_stride, result_stride as i64
    !result_stride
    !terms_len
    !terms
    !desc
    return

@sa3d_ecs_query_access_is_data(access: i32) -> i32:
L_ENTRY:
    is_read = eq access, SA3D_ECS_QUERY_ACCESS_READ
    is_write = eq access, SA3D_ECS_QUERY_ACCESS_WRITE
    is_opt_read = eq access, SA3D_ECS_QUERY_ACCESS_OPTIONAL_READ
    is_opt_write = eq access, SA3D_ECS_QUERY_ACCESS_OPTIONAL_WRITE
    is_read_all = eq access, SA3D_ECS_QUERY_ACCESS_READ_ALL
    is_write_all = eq access, SA3D_ECS_QUERY_ACCESS_WRITE_ALL
    data_required = or is_read, is_write
    data_optional = or is_opt_read, is_opt_write
    data_all = or is_read_all, is_write_all
    data_finite = or data_required, data_optional
    ok = or data_finite, data_all
    br ok -> L_YES, L_NO
L_YES:
    !ok
    !data_finite
    !data_all
    !data_optional
    !data_required
    !is_write_all
    !is_read_all
    !is_opt_write
    !is_opt_read
    !is_write
    !is_read
    !access
    return 1
L_NO:
    !ok
    !data_finite
    !data_all
    !data_optional
    !data_required
    !is_write_all
    !is_read_all
    !is_opt_write
    !is_opt_read
    !is_write
    !is_read
    !access
    return 0

@sa3d_ecs_query_access_is_required_data(access: i32) -> i32:
L_ENTRY:
    is_read = eq access, SA3D_ECS_QUERY_ACCESS_READ
    is_write = eq access, SA3D_ECS_QUERY_ACCESS_WRITE
    ok = or is_read, is_write
    br ok -> L_YES, L_NO
L_YES:
    !ok
    !is_write
    !is_read
    !access
    return 1
L_NO:
    !ok
    !is_write
    !is_read
    !access
    return 0

@sa3d_ecs_query_access_has_write(access: i32) -> i32:
L_ENTRY:
    is_write = eq access, SA3D_ECS_QUERY_ACCESS_WRITE
    is_opt_write = eq access, SA3D_ECS_QUERY_ACCESS_OPTIONAL_WRITE
    is_write_all = eq access, SA3D_ECS_QUERY_ACCESS_WRITE_ALL
    a = or is_write, is_opt_write
    ok = or a, is_write_all
    br ok -> L_YES, L_NO
L_YES:
    !ok
    !a
    !is_write_all
    !is_opt_write
    !is_write
    !access
    return 1
L_NO:
    !ok
    !a
    !is_write_all
    !is_opt_write
    !is_write
    !access
    return 0

@sa3d_ecs_query_access_reads_all(access: i32) -> i32:
L_ENTRY:
    is_read_all = eq access, SA3D_ECS_QUERY_ACCESS_READ_ALL
    is_write_all = eq access, SA3D_ECS_QUERY_ACCESS_WRITE_ALL
    ok = or is_read_all, is_write_all
    br ok -> L_YES, L_NO
L_YES:
    !ok
    !is_write_all
    !is_read_all
    !access
    return 1
L_NO:
    !ok
    !is_write_all
    !is_read_all
    !access
    return 0

@sa3d_ecs_query_access_writes_all(access: i32) -> i32:
L_ENTRY:
    is_write_all = eq access, SA3D_ECS_QUERY_ACCESS_WRITE_ALL
    br is_write_all -> L_YES, L_NO
L_YES:
    !is_write_all
    !access
    return 1
L_NO:
    !is_write_all
    !access
    return 0

@sa3d_ecs_query_access_is_filter(access: i32) -> i32:
L_ENTRY:
    is_with = eq access, SA3D_ECS_QUERY_ACCESS_WITH
    is_without = eq access, SA3D_ECS_QUERY_ACCESS_WITHOUT
    is_filter_set = eq access, SA3D_ECS_QUERY_ACCESS_FILTER_SET
    filters = or is_with, is_without
    ok = or filters, is_filter_set
    br ok -> L_YES, L_NO
L_YES:
    !ok
    !filters
    !is_filter_set
    !is_without
    !is_with
    !access
    return 1
L_NO:
    !ok
    !filters
    !is_filter_set
    !is_without
    !is_with
    !access
    return 0

@sa3d_ecs_query_access_is_valid(access: i32) -> i32:
L_ENTRY:
    is_data = call @sa3d_ecs_query_access_is_data(access)
    br is_data -> L_YES, L_CHECK_FILTER
L_CHECK_FILTER:
    is_filter = call @sa3d_ecs_query_access_is_filter(access)
    br is_filter -> L_YES_FILTER, L_NO
L_YES:
    !is_data
    !access
    return 1
L_YES_FILTER:
    !is_filter
    !is_data
    !access
    return 1
L_NO:
    !is_filter
    !is_data
    !access
    return 0

@sa3d_ecs_query_terms_conflict(&a: ptr, &b: ptr) -> i32:
L_ENTRY:
    a_access = load a+SA3D_ECS_QUERY_TERM_access as i32
    b_access = load b+SA3D_ECS_QUERY_TERM_access as i32
    a_data = call @sa3d_ecs_query_access_is_data(a_access)
    b_data = call @sa3d_ecs_query_access_is_data(b_access)
    both_data = and a_data, b_data
    br both_data -> L_CHECK_A_WRITES, L_NO_ACCESS

L_CHECK_A_WRITES:
    a_writes = call @sa3d_ecs_query_term_write_overlaps_read(&a, &b)
    br a_writes -> L_YES_A_WRITES, L_CHECK_B_WRITES

L_CHECK_B_WRITES:
    b_writes = call @sa3d_ecs_query_term_write_overlaps_read(&b, &a)
    br b_writes -> L_YES_B_WRITES, L_NO_WRITE

L_YES_A_WRITES:
    !a_writes
    !both_data
    !b_data
    !a_data
    !b_access
    !a_access
    !b
    !a
    return 1

L_YES_B_WRITES:
    !b_writes
    !a_writes
    !both_data
    !b_data
    !a_data
    !b_access
    !a_access
    !b
    !a
    return 1

L_NO_WRITE:
    !b_writes
    !a_writes
    !both_data
    !b_data
    !a_data
    !b_access
    !a_access
    !b
    !a
    return 0

L_NO_ACCESS:
    !both_data
    !b_data
    !a_data
    !b_access
    !a_access
    !b
    !a
    return 0

@sa3d_ecs_query_term_write_overlaps_read(&writer: ptr, &reader: ptr) -> i32:
L_ENTRY:
    writer_access = load writer+SA3D_ECS_QUERY_TERM_access as i32
    reader_access = load reader+SA3D_ECS_QUERY_TERM_access as i32
    writer_has_write = call @sa3d_ecs_query_access_has_write(writer_access)
    br writer_has_write -> L_READER_DATA, L_NO_WRITE

L_READER_DATA:
    reader_has_data = call @sa3d_ecs_query_access_is_data(reader_access)
    br reader_has_data -> L_ALL_CHECK, L_NO_READER_DATA

L_ALL_CHECK:
    writer_all = call @sa3d_ecs_query_access_writes_all(writer_access)
    br writer_all -> L_YES_WRITER_ALL, L_READER_ALL_CHECK

L_READER_ALL_CHECK:
    reader_all = call @sa3d_ecs_query_access_reads_all(reader_access)
    br reader_all -> L_YES_READER_ALL, L_COMPONENT_CHECK

L_COMPONENT_CHECK:
    writer_component = load writer+SA3D_ECS_QUERY_TERM_component_type as i64
    reader_component = load reader+SA3D_ECS_QUERY_TERM_component_type as i64
    same = eq writer_component, reader_component
    br same -> L_YES_COMPONENT, L_NO_COMPONENT

L_YES_WRITER_ALL:
    !writer_all
    !reader_has_data
    !writer_has_write
    !reader_access
    !writer_access
    !reader
    !writer
    return 1

L_YES_READER_ALL:
    !reader_all
    !writer_all
    !reader_has_data
    !writer_has_write
    !reader_access
    !writer_access
    !reader
    !writer
    return 1

L_YES_COMPONENT:
    !same
    !reader_component
    !writer_component
    !reader_all
    !writer_all
    !reader_has_data
    !writer_has_write
    !reader_access
    !writer_access
    !reader
    !writer
    return 1

L_NO_COMPONENT:
    !same
    !reader_component
    !writer_component
    !reader_all
    !writer_all
    !reader_has_data
    !writer_has_write
    !reader_access
    !writer_access
    !reader
    !writer
    return 0

L_NO_READER_DATA:
    !reader_has_data
    !writer_has_write
    !reader_access
    !writer_access
    !reader
    !writer
    return 0

L_NO_WRITE:
    !writer_has_write
    !reader_access
    !writer_access
    !reader
    !writer
    return 0

@sa3d_ecs_query_term_requires_with(&term: ptr) -> i32:
L_ENTRY:
    access = load term+SA3D_ECS_QUERY_TERM_access as i32
    is_data = call @sa3d_ecs_query_access_is_required_data(access)
    is_with = eq access, SA3D_ECS_QUERY_ACCESS_WITH
    required = or is_data, is_with
    br required -> L_YES, L_NO
L_YES:
    !required
    !is_with
    !is_data
    !access
    !term
    return 1
L_NO:
    !required
    !is_with
    !is_data
    !access
    !term
    return 0

@sa3d_ecs_query_term_is_without(&term: ptr) -> i32:
L_ENTRY:
    access = load term+SA3D_ECS_QUERY_TERM_access as i32
    is_without = eq access, SA3D_ECS_QUERY_ACCESS_WITHOUT
    br is_without -> L_YES, L_NO
L_YES:
    !is_without
    !access
    !term
    return 1
L_NO:
    !is_without
    !access
    !term
    return 0

@sa3d_ecs_query_desc_has_required_with(&desc: ptr, component_type: i64) -> i32:
L_ENTRY:
    terms = load desc+SA3D_ECS_QUERY_DESC_terms_ptr as ptr
    terms_len = load desc+SA3D_ECS_QUERY_DESC_terms_len as i64
    has_terms = sgt terms_len, 0
    br has_terms -> L_REQUIRE_PTR, L_NO_EMPTY

L_REQUIRE_PTR:
    has_ptr = ne terms, 0
    br has_ptr -> L_LOOP_SETUP, L_NO_PTR

L_LOOP_SETUP:
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    i = load i_slot+0 as i64
    more = slt i, terms_len
    br more -> L_LOOP_BODY, L_NO

L_LOOP_BODY:
    offset = mul i, SA3D_ECS_QUERY_TERM_SIZE
    term = ptr_add terms, offset
    term_component = load term+SA3D_ECS_QUERY_TERM_component_type as i64
    same = eq term_component, component_type
    br same -> L_CHECK_REQUIRED, L_NEXT

L_CHECK_REQUIRED:
    required = call @sa3d_ecs_query_term_requires_with(&term)
    br required -> L_YES, L_NEXT_REQUIRED

L_NEXT_REQUIRED:
    !required
    jmp L_NEXT

L_NEXT:
    next_i = add i, 1
    store i_slot+0, next_i as i64
    !next_i
    !same
    !term_component
    !term
    !offset
    !more
    !i
    jmp L_LOOP_HEAD

L_YES:
    !required
    !same
    !term_component
    !term
    !offset
    !more
    !i
    !has_ptr
    !has_terms
    !terms_len
    !terms
    !component_type
    !desc
    return 1

L_NO:
    !more
    !i
    !has_ptr
    !has_terms
    !terms_len
    !terms
    !component_type
    !desc
    return 0

L_NO_PTR:
    !has_ptr
    !has_terms
    !terms_len
    !terms
    !component_type
    !desc
    return 0

L_NO_EMPTY:
    !has_terms
    !terms_len
    !terms
    !component_type
    !desc
    return 0

@sa3d_ecs_query_desc_has_without(&desc: ptr, component_type: i64) -> i32:
L_ENTRY:
    terms = load desc+SA3D_ECS_QUERY_DESC_terms_ptr as ptr
    terms_len = load desc+SA3D_ECS_QUERY_DESC_terms_len as i64
    has_terms = sgt terms_len, 0
    br has_terms -> L_REQUIRE_PTR, L_NO_EMPTY

L_REQUIRE_PTR:
    has_ptr = ne terms, 0
    br has_ptr -> L_LOOP_SETUP, L_NO_PTR

L_LOOP_SETUP:
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    i = load i_slot+0 as i64
    more = slt i, terms_len
    br more -> L_LOOP_BODY, L_NO

L_LOOP_BODY:
    offset = mul i, SA3D_ECS_QUERY_TERM_SIZE
    term = ptr_add terms, offset
    term_component = load term+SA3D_ECS_QUERY_TERM_component_type as i64
    same = eq term_component, component_type
    br same -> L_CHECK_WITHOUT, L_NEXT

L_CHECK_WITHOUT:
    without = call @sa3d_ecs_query_term_is_without(&term)
    br without -> L_YES, L_NEXT_WITHOUT

L_NEXT_WITHOUT:
    !without
    jmp L_NEXT

L_NEXT:
    next_i = add i, 1
    store i_slot+0, next_i as i64
    !next_i
    !same
    !term_component
    !term
    !offset
    !more
    !i
    jmp L_LOOP_HEAD

L_YES:
    !without
    !same
    !term_component
    !term
    !offset
    !more
    !i
    !has_ptr
    !has_terms
    !terms_len
    !terms
    !component_type
    !desc
    return 1

L_NO:
    !more
    !i
    !has_ptr
    !has_terms
    !terms_len
    !terms
    !component_type
    !desc
    return 0

L_NO_PTR:
    !has_ptr
    !has_terms
    !terms_len
    !terms
    !component_type
    !desc
    return 0

L_NO_EMPTY:
    !has_terms
    !terms_len
    !terms
    !component_type
    !desc
    return 0

@sa3d_ecs_query_descs_have_data_conflict(&a: ptr, &b: ptr) -> i32:
L_ENTRY:
    a_terms = load a+SA3D_ECS_QUERY_DESC_terms_ptr as ptr
    a_len = load a+SA3D_ECS_QUERY_DESC_terms_len as i64
    b_terms = load b+SA3D_ECS_QUERY_DESC_terms_ptr as ptr
    b_len = load b+SA3D_ECS_QUERY_DESC_terms_len as i64
    i_slot = stack_alloc 8
    j_slot = stack_alloc 8
    a_term_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_OUTER_HEAD

L_OUTER_HEAD:
    i = load i_slot+0 as i64
    more_a = slt i, a_len
    br more_a -> L_OUTER_BODY, L_NO

L_OUTER_BODY:
    a_offset = mul i, SA3D_ECS_QUERY_TERM_SIZE
    a_term = ptr_add a_terms, a_offset
    store a_term_slot+0, a_term as ptr
    a_access = load a_term+SA3D_ECS_QUERY_TERM_access as i32
    a_data = call @sa3d_ecs_query_access_is_data(a_access)
    br a_data -> L_INNER_SETUP, L_NEXT_OUTER_DATA

L_INNER_SETUP:
    store j_slot+0, 0 as i64
    jmp L_INNER_HEAD

L_INNER_HEAD:
    j = load j_slot+0 as i64
    more_b = slt j, b_len
    br more_b -> L_INNER_BODY, L_NEXT_OUTER

L_INNER_BODY:
    b_offset = mul j, SA3D_ECS_QUERY_TERM_SIZE
    b_term = ptr_add b_terms, b_offset
    current_a_term = load a_term_slot+0 as ptr
    conflict = call @sa3d_ecs_query_terms_conflict(&current_a_term, &b_term)
    br conflict -> L_YES, L_NEXT_INNER

L_NEXT_INNER:
    j_next = add j, 1
    store j_slot+0, j_next as i64
    !j_next
    !conflict
    !current_a_term
    !b_term
    !b_offset
    !more_b
    !j
    jmp L_INNER_HEAD

L_NEXT_OUTER:
    !j
    !more_b
    jmp L_NEXT_OUTER_DATA

L_NEXT_OUTER_DATA:
    i_next = add i, 1
    store i_slot+0, i_next as i64
    !i_next
    !a_data
    !a_access
    !a_term
    !a_offset
    !more_a
    !i
    jmp L_OUTER_HEAD

L_YES:
    !conflict
    !current_a_term
    !b_term
    !b_offset
    !more_b
    !j
    !a_data
    !a_access
    !a_term
    !a_offset
    !more_a
    !i
    !b_len
    !b_terms
    !a_len
    !a_terms
    !b
    !a
    return 1

L_NO:
    !more_a
    !i
    !b_len
    !b_terms
    !a_len
    !a_terms
    !b
    !a
    return 0

@sa3d_ecs_query_descs_filters_disjoint(&a: ptr, &b: ptr) -> i32:
L_ENTRY:
    a_terms = load a+SA3D_ECS_QUERY_DESC_terms_ptr as ptr
    a_len = load a+SA3D_ECS_QUERY_DESC_terms_len as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    i = load i_slot+0 as i64
    more = slt i, a_len
    br more -> L_LOOP_BODY, L_NO

L_LOOP_BODY:
    offset = mul i, SA3D_ECS_QUERY_TERM_SIZE
    term = ptr_add a_terms, offset
    component = load term+SA3D_ECS_QUERY_TERM_component_type as i64
    required = call @sa3d_ecs_query_term_requires_with(&term)
    br required -> L_CHECK_B_WITHOUT, L_CHECK_A_WITHOUT

L_CHECK_B_WITHOUT:
    b_without = call @sa3d_ecs_query_desc_has_without(&b, component)
    br b_without -> L_YES_REQUIRED, L_CHECK_A_WITHOUT_FROM_REQUIRED

L_CHECK_A_WITHOUT_FROM_REQUIRED:
    !b_without
    jmp L_CHECK_A_WITHOUT

L_CHECK_A_WITHOUT:
    without = call @sa3d_ecs_query_term_is_without(&term)
    br without -> L_CHECK_B_REQUIRED, L_NEXT_WITHOUT

L_CHECK_B_REQUIRED:
    b_required = call @sa3d_ecs_query_desc_has_required_with(&b, component)
    br b_required -> L_YES_WITHOUT, L_NEXT_REQUIRED

L_NEXT_REQUIRED:
    !b_required
    jmp L_NEXT_WITHOUT

L_NEXT_WITHOUT:
    !without
    jmp L_NEXT

L_NEXT:
    next_i = add i, 1
    store i_slot+0, next_i as i64
    !next_i
    !required
    !component
    !term
    !offset
    !more
    !i
    jmp L_LOOP_HEAD

L_YES_REQUIRED:
    !b_without
    !required
    !component
    !term
    !offset
    !more
    !i
    !a_len
    !a_terms
    !b
    !a
    return 1

L_YES_WITHOUT:
    !b_required
    !without
    !required
    !component
    !term
    !offset
    !more
    !i
    !a_len
    !a_terms
    !b
    !a
    return 1

L_NO:
    !more
    !i
    !a_len
    !a_terms
    !b
    !a
    return 0

@sa3d_ecs_query_desc_has_filter_terms(&desc: ptr) -> i32:
L_ENTRY:
    terms = load desc+SA3D_ECS_QUERY_DESC_terms_ptr as ptr
    terms_len = load desc+SA3D_ECS_QUERY_DESC_terms_len as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    i = load i_slot+0 as i64
    more = slt i, terms_len
    br more -> L_BODY, L_NO

L_BODY:
    offset = mul i, SA3D_ECS_QUERY_TERM_SIZE
    term = ptr_add terms, offset
    access = load term+SA3D_ECS_QUERY_TERM_access as i32
    is_filter = call @sa3d_ecs_query_access_is_filter(access)
    br is_filter -> L_YES, L_NEXT

L_NEXT:
    next = add i, 1
    store i_slot+0, next as i64
    !next
    !is_filter
    !access
    !term
    !offset
    !more
    !i
    jmp L_HEAD

L_YES:
    !is_filter
    !access
    !term
    !offset
    !more
    !i
    !terms_len
    !terms
    !desc
    return 1

L_NO:
    !more
    !i
    !terms_len
    !terms
    !desc
    return 0

@sa3d_ecs_query_desc_set_has_with(&desc: ptr, set_id: i32, component_type: i64) -> i32:
L_ENTRY:
    terms = load desc+SA3D_ECS_QUERY_DESC_terms_ptr as ptr
    terms_len = load desc+SA3D_ECS_QUERY_DESC_terms_len as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    i = load i_slot+0 as i64
    more = slt i, terms_len
    br more -> L_BODY, L_NO

L_BODY:
    offset = mul i, SA3D_ECS_QUERY_TERM_SIZE
    term = ptr_add terms, offset
    component = load term+SA3D_ECS_QUERY_TERM_component_type as i64
    same_component = eq component, component_type
    br same_component -> L_CHECK_ACCESS, L_NEXT

L_CHECK_ACCESS:
    access = load term+SA3D_ECS_QUERY_TERM_access as i32
    is_data = call @sa3d_ecs_query_access_is_required_data(access)
    br is_data -> L_YES_DATA, L_CHECK_WITH

L_CHECK_WITH:
    is_with = eq access, SA3D_ECS_QUERY_ACCESS_WITH
    br is_with -> L_CHECK_SET, L_NEXT_ACCESS

L_CHECK_SET:
    flags = load term+SA3D_ECS_QUERY_TERM_flags as i32
    same_set = eq flags, set_id
    br same_set -> L_YES_SET, L_NEXT_SET

L_NEXT_SET:
    !same_set
    !flags
    jmp L_NEXT_ACCESS

L_NEXT_ACCESS:
    !is_with
    !is_data
    !access
    jmp L_NEXT

L_NEXT:
    next = add i, 1
    store i_slot+0, next as i64
    !next
    !same_component
    !component
    !term
    !offset
    !more
    !i
    jmp L_HEAD

L_YES_DATA:
    !is_data
    !access
    !same_component
    !component
    !term
    !offset
    !more
    !i
    !terms_len
    !terms
    !component_type
    !set_id
    !desc
    return 1

L_YES_SET:
    !same_set
    !flags
    !is_with
    !is_data
    !access
    !same_component
    !component
    !term
    !offset
    !more
    !i
    !terms_len
    !terms
    !component_type
    !set_id
    !desc
    return 1

L_NO:
    !more
    !i
    !terms_len
    !terms
    !component_type
    !set_id
    !desc
    return 0

@sa3d_ecs_query_desc_set_has_without(&desc: ptr, set_id: i32, component_type: i64) -> i32:
L_ENTRY:
    terms = load desc+SA3D_ECS_QUERY_DESC_terms_ptr as ptr
    terms_len = load desc+SA3D_ECS_QUERY_DESC_terms_len as i64
    i_slot = stack_alloc 8
