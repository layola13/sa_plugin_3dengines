#def SA3D_TRANSFORM_VERSION_MAJOR = 0
#def SA3D_TRANSFORM_VERSION_MINOR = 1

#def SA3D_TRANSFORM3D_translation = +0
#def SA3D_TRANSFORM3D_rotation = +16
#def SA3D_TRANSFORM3D_scale = +32
#def SA3D_TRANSFORM3D_SIZE = 48

#def SA3D_WORLD_TRANSFORM_matrix = +0
#def SA3D_WORLD_TRANSFORM_dirty = +64
#def SA3D_WORLD_TRANSFORM_SIZE = 72

#def SA3D_TRANSFORM_NODE_entity = +0
#def SA3D_TRANSFORM_NODE_parent = +8
#def SA3D_TRANSFORM_NODE_first_child = +16
#def SA3D_TRANSFORM_NODE_next_sibling = +24
#def SA3D_TRANSFORM_NODE_local = +32
#def SA3D_TRANSFORM_NODE_world = +80
#def SA3D_TRANSFORM_NODE_SIZE = 152

@import "../sa_plugin_3d_math/3d_math.sal"

@sa3d_transform3d_identity(&transform: ptr) -> void:
L_ENTRY:
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    rotation = ptr_add transform, SA3D_TRANSFORM3D_rotation
    scale = ptr_add transform, SA3D_TRANSFORM3D_scale
    store translation+SA3D_VEC3_x, SA3D_F32_ZERO_BITS as i32
    store translation+SA3D_VEC3_y, SA3D_F32_ZERO_BITS as i32
    store translation+SA3D_VEC3_z, SA3D_F32_ZERO_BITS as i32
    store translation+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    store rotation+SA3D_QUAT_x, SA3D_F32_ZERO_BITS as i32
    store rotation+SA3D_QUAT_y, SA3D_F32_ZERO_BITS as i32
    store rotation+SA3D_QUAT_z, SA3D_F32_ZERO_BITS as i32
    store rotation+SA3D_QUAT_w, SA3D_F32_ONE_BITS as i32
    store scale+SA3D_VEC3_x, SA3D_F32_ONE_BITS as i32
    store scale+SA3D_VEC3_y, SA3D_F32_ONE_BITS as i32
    store scale+SA3D_VEC3_z, SA3D_F32_ONE_BITS as i32
    store scale+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    !scale
    !rotation
    !translation
    !transform
    return

@sa3d_transform3d_set_translation(&transform: ptr, x: i32, y: i32, z: i32) -> void:
L_ENTRY:
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    store translation+SA3D_VEC3_x, x as i32
    store translation+SA3D_VEC3_y, y as i32
    store translation+SA3D_VEC3_z, z as i32
    !translation
    !z
    !y
    !x
    !transform
    return

@sa3d_transform3d_set_scale(&transform: ptr, x: i32, y: i32, z: i32) -> void:
L_ENTRY:
    scale = ptr_add transform, SA3D_TRANSFORM3D_scale
    store scale+SA3D_VEC3_x, x as i32
    store scale+SA3D_VEC3_y, y as i32
    store scale+SA3D_VEC3_z, z as i32
    !scale
    !z
    !y
    !x
    !transform
    return

@sa3d_transform3d_set_rotation(&transform: ptr, x: f32, y: f32, z: f32, w: f32) -> void:
L_ENTRY:
    rotation = ptr_add transform, SA3D_TRANSFORM3D_rotation
    store rotation+SA3D_QUAT_x, x as f32
    store rotation+SA3D_QUAT_y, y as f32
    store rotation+SA3D_QUAT_z, z as f32
    store rotation+SA3D_QUAT_w, w as f32
    !w
    !z
    !y
    !x
    !rotation
    !transform
    return

@sa3d_transform3d_to_matrix(&mat: ptr, &transform: ptr) -> void:
L_ENTRY:
    scale = ptr_add transform, SA3D_TRANSFORM3D_scale
    rotation = ptr_add transform, SA3D_TRANSFORM3D_rotation
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    call @sa3d_mat4_from_scale_rotation_translation(&mat, &scale, &rotation, &translation)
    !rotation
    !translation
    !scale
    !transform
    !mat
    return

@sa3d_transform3d_from_matrix(&transform: ptr, &mat: ptr) -> void:
L_ENTRY:
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    rotation = ptr_add transform, SA3D_TRANSFORM3D_rotation
    scale = ptr_add transform, SA3D_TRANSFORM3D_scale
    call @sa3d_mat4_to_scale_rotation_translation(&scale, &rotation, &translation, &mat)
    store translation+SA3D_VEC4_w, 0.0 as f32
    store scale+SA3D_VEC4_w, 0.0 as f32
    !scale
    !rotation
    !translation
    !mat
    !transform
    return

@sa3d_transform3d_from_xyz(&transform: ptr, x: f32, y: f32, z: f32) -> void:
L_ENTRY:
    call @sa3d_transform3d_identity(&transform)
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    store translation+SA3D_VEC3_x, x as f32
    store translation+SA3D_VEC3_y, y as f32
    store translation+SA3D_VEC3_z, z as f32
    !translation
    !z
    !y
    !x
    !transform
    return

@sa3d_transform3d_from_translation(&transform: ptr, &translation_src: ptr) -> void:
L_ENTRY:
    call @sa3d_transform3d_identity(&transform)
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    x = load translation_src+SA3D_VEC3_x as f32
    y = load translation_src+SA3D_VEC3_y as f32
    z = load translation_src+SA3D_VEC3_z as f32
    store translation+SA3D_VEC3_x, x as f32
    store translation+SA3D_VEC3_y, y as f32
    store translation+SA3D_VEC3_z, z as f32
    !z
    !y
    !x
    !translation
    !translation_src
    !transform
    return

@sa3d_transform3d_from_rotation(&transform: ptr, &rotation_src: ptr) -> void:
L_ENTRY:
    call @sa3d_transform3d_identity(&transform)
    rotation = ptr_add transform, SA3D_TRANSFORM3D_rotation
    x = load rotation_src+SA3D_QUAT_x as f32
    y = load rotation_src+SA3D_QUAT_y as f32
    z = load rotation_src+SA3D_QUAT_z as f32
    w = load rotation_src+SA3D_QUAT_w as f32
    store rotation+SA3D_QUAT_x, x as f32
    store rotation+SA3D_QUAT_y, y as f32
    store rotation+SA3D_QUAT_z, z as f32
    store rotation+SA3D_QUAT_w, w as f32
    !w
    !z
    !y
    !x
    !rotation
    !rotation_src
    !transform
    return

@sa3d_transform3d_from_scale(&transform: ptr, &scale_src: ptr) -> void:
L_ENTRY:
    call @sa3d_transform3d_identity(&transform)
    scale = ptr_add transform, SA3D_TRANSFORM3D_scale
    x = load scale_src+SA3D_VEC3_x as f32
    y = load scale_src+SA3D_VEC3_y as f32
    z = load scale_src+SA3D_VEC3_z as f32
    store scale+SA3D_VEC3_x, x as f32
    store scale+SA3D_VEC3_y, y as f32
    store scale+SA3D_VEC3_z, z as f32
    !z
    !y
    !x
    !scale
    !scale_src
    !transform
    return

@sa3d_transform3d_transform_point(&out: ptr, &transform: ptr, &point: ptr) -> void:
L_ENTRY:
    scale = ptr_add transform, SA3D_TRANSFORM3D_scale
    rotation = ptr_add transform, SA3D_TRANSFORM3D_rotation
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    scaled = alloc SA3D_VEC3_SIZE
    rotated = alloc SA3D_VEC3_SIZE
    sx = load scale+SA3D_VEC3_x as f32
    sy = load scale+SA3D_VEC3_y as f32
    sz = load scale+SA3D_VEC3_z as f32
    px = load point+SA3D_VEC3_x as f32
    py = load point+SA3D_VEC3_y as f32
    pz = load point+SA3D_VEC3_z as f32
    tx = load translation+SA3D_VEC3_x as f32
    ty = load translation+SA3D_VEC3_y as f32
    tz = load translation+SA3D_VEC3_z as f32
    spx = fmul sx, px
    spy = fmul sy, py
    spz = fmul sz, pz
    store scaled+SA3D_VEC3_x, spx as f32
    store scaled+SA3D_VEC3_y, spy as f32
    store scaled+SA3D_VEC3_z, spz as f32
    call @sa3d_quat_rotate_vec3_f(&rotated, &rotation, &scaled)
    rx = load rotated+SA3D_VEC3_x as f32
    ry = load rotated+SA3D_VEC3_y as f32
    rz = load rotated+SA3D_VEC3_z as f32
    ox = fadd rx, tx
    oy = fadd ry, ty
    oz = fadd rz, tz
    store out+SA3D_VEC3_x, ox as f32
    store out+SA3D_VEC3_y, oy as f32
    store out+SA3D_VEC3_z, oz as f32
    !oz
    !oy
    !ox
    !rz
    !ry
    !rx
    !spz
    !spy
    !spx
    !tz
    !ty
    !tx
    !pz
    !py
    !px
    !sz
    !sy
    !sx
    !rotated
    !scaled
    !translation
    !rotation
    !scale
    !point
    !transform
    !out
    return

@sa3d_transform3d_mul_transform(&out: ptr, &parent: ptr, &child: ptr) -> void:
L_ENTRY:
    parent_rotation = ptr_add parent, SA3D_TRANSFORM3D_rotation
    parent_scale = ptr_add parent, SA3D_TRANSFORM3D_scale
    child_translation = ptr_add child, SA3D_TRANSFORM3D_translation
    child_rotation = ptr_add child, SA3D_TRANSFORM3D_rotation
    child_scale = ptr_add child, SA3D_TRANSFORM3D_scale
    out_translation = ptr_add out, SA3D_TRANSFORM3D_translation
    out_rotation = ptr_add out, SA3D_TRANSFORM3D_rotation
    out_scale = ptr_add out, SA3D_TRANSFORM3D_scale
    call @sa3d_transform3d_transform_point(&out_translation, &parent, &child_translation)
    call @sa3d_quat_mul(&out_rotation, &parent_rotation, &child_rotation)
    psx = load parent_scale+SA3D_VEC3_x as f32
    psy = load parent_scale+SA3D_VEC3_y as f32
    psz = load parent_scale+SA3D_VEC3_z as f32
    csx = load child_scale+SA3D_VEC3_x as f32
    csy = load child_scale+SA3D_VEC3_y as f32
    csz = load child_scale+SA3D_VEC3_z as f32
    osx = fmul psx, csx
    osy = fmul psy, csy
    osz = fmul psz, csz
    store out_scale+SA3D_VEC3_x, osx as f32
    store out_scale+SA3D_VEC3_y, osy as f32
    store out_scale+SA3D_VEC3_z, osz as f32
    store out_translation+SA3D_VEC4_w, 0.0 as f32
    store out_scale+SA3D_VEC4_w, 0.0 as f32
    !osz
    !osy
    !osx
    !csz
    !csy
    !csx
    !psz
    !psy
    !psx
    !out_scale
    !out_rotation
    !out_translation
    !child_scale
    !child_rotation
    !child_translation
    !parent_scale
    !parent_rotation
    !child
    !parent
    !out
    return

@sa3d_transform3d_rotate(&transform: ptr, &rotation: ptr) -> void:
L_ENTRY:
    current = ptr_add transform, SA3D_TRANSFORM3D_rotation
    tmp = alloc SA3D_QUAT_SIZE
    call @sa3d_quat_mul(&tmp, &rotation, &current)
    x = load tmp+SA3D_QUAT_x as f32
    y = load tmp+SA3D_QUAT_y as f32
    z = load tmp+SA3D_QUAT_z as f32
    w = load tmp+SA3D_QUAT_w as f32
    store current+SA3D_QUAT_x, x as f32
    store current+SA3D_QUAT_y, y as f32
    store current+SA3D_QUAT_z, z as f32
    store current+SA3D_QUAT_w, w as f32
    !w
    !z
    !y
    !x
    !tmp
    !current
    !rotation
    !transform
    return

@sa3d_transform3d_rotate_local(&transform: ptr, &rotation: ptr) -> void:
L_ENTRY:
    current = ptr_add transform, SA3D_TRANSFORM3D_rotation
    tmp = alloc SA3D_QUAT_SIZE
    call @sa3d_quat_mul(&tmp, &current, &rotation)
    x = load tmp+SA3D_QUAT_x as f32
    y = load tmp+SA3D_QUAT_y as f32
    z = load tmp+SA3D_QUAT_z as f32
    w = load tmp+SA3D_QUAT_w as f32
    store current+SA3D_QUAT_x, x as f32
    store current+SA3D_QUAT_y, y as f32
    store current+SA3D_QUAT_z, z as f32
    store current+SA3D_QUAT_w, w as f32
    !w
    !z
    !y
    !x
    !tmp
    !current
    !rotation
    !transform
    return

@sa3d_transform3d_translate_around(&transform: ptr, &point: ptr, &rotation: ptr) -> void:
L_ENTRY:
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    delta = alloc SA3D_VEC3_SIZE
    rotated = alloc SA3D_VEC3_SIZE
    tx = load translation+SA3D_VEC3_x as f32
    ty = load translation+SA3D_VEC3_y as f32
    tz = load translation+SA3D_VEC3_z as f32
    px = load point+SA3D_VEC3_x as f32
    py = load point+SA3D_VEC3_y as f32
    pz = load point+SA3D_VEC3_z as f32
    dx = fsub tx, px
    dy = fsub ty, py
    dz = fsub tz, pz
    store delta+SA3D_VEC3_x, dx as f32
    store delta+SA3D_VEC3_y, dy as f32
    store delta+SA3D_VEC3_z, dz as f32
    call @sa3d_quat_rotate_vec3_f(&rotated, &rotation, &delta)
    rx = load rotated+SA3D_VEC3_x as f32
    ry = load rotated+SA3D_VEC3_y as f32
    rz = load rotated+SA3D_VEC3_z as f32
    ox = fadd px, rx
    oy = fadd py, ry
    oz = fadd pz, rz
    store translation+SA3D_VEC3_x, ox as f32
    store translation+SA3D_VEC3_y, oy as f32
    store translation+SA3D_VEC3_z, oz as f32
    !oz
    !oy
    !ox
    !rz
    !ry
    !rx
    !dz
    !dy
    !dx
    !pz
    !py
    !px
    !tz
    !ty
    !tx
    !rotated
    !delta
    !translation
    !rotation
    !point
    !transform
    return

@sa3d_transform3d_rotate_around(&transform: ptr, &point: ptr, &rotation: ptr) -> void:
L_ENTRY:
    call @sa3d_transform3d_translate_around(&transform, &point, &rotation)
    call @sa3d_transform3d_rotate(&transform, &rotation)
    !rotation
    !point
    !transform
    return

@sa3d_transform3d_local_axis(&out: ptr, &transform: ptr, axis_x: f32, axis_y: f32, axis_z: f32) -> void:
L_ENTRY:
    rotation = ptr_add transform, SA3D_TRANSFORM3D_rotation
    axis = alloc SA3D_VEC3_SIZE
    store axis+SA3D_VEC3_x, axis_x as f32
    store axis+SA3D_VEC3_y, axis_y as f32
    store axis+SA3D_VEC3_z, axis_z as f32
    call @sa3d_quat_rotate_vec3_f(&out, &rotation, &axis)
    !axis
    !rotation
    !axis_z
    !axis_y
    !axis_x
    !transform
    !out
    return

@sa3d_transform3d_local_x(&out: ptr, &transform: ptr) -> void:
L_ENTRY:
    call @sa3d_transform3d_local_axis(&out, &transform, 1.0, 0.0, 0.0)
    !transform
    !out
    return

@sa3d_transform3d_local_y(&out: ptr, &transform: ptr) -> void:
L_ENTRY:
    call @sa3d_transform3d_local_axis(&out, &transform, 0.0, 1.0, 0.0)
    !transform
    !out
    return

@sa3d_transform3d_local_z(&out: ptr, &transform: ptr) -> void:
L_ENTRY:
    call @sa3d_transform3d_local_axis(&out, &transform, 0.0, 0.0, 1.0)
    !transform
    !out
    return

@sa3d_transform3d_forward(&out: ptr, &transform: ptr) -> void:
L_ENTRY:
    call @sa3d_transform3d_local_z(&out, &transform)
    z = load out+SA3D_VEC3_z as f32
    x = load out+SA3D_VEC3_x as f32
    y = load out+SA3D_VEC3_y as f32
    nx = fneg x
    ny = fneg y
    nz = fneg z
    store out+SA3D_VEC3_x, nx as f32
    store out+SA3D_VEC3_y, ny as f32
    store out+SA3D_VEC3_z, nz as f32
    !nz
    !ny
    !nx
    !y
    !x
    !z
    !transform
    !out
    return

@sa3d_transform3d_back(&out: ptr, &transform: ptr) -> void:
L_ENTRY:
    call @sa3d_transform3d_local_z(&out, &transform)
    !transform
    !out
    return

@sa3d_transform3d_is_finite(&transform: ptr) -> i32:
L_ENTRY:
    translation = ptr_add transform, SA3D_TRANSFORM3D_translation
    rotation = ptr_add transform, SA3D_TRANSFORM3D_rotation
    scale = ptr_add transform, SA3D_TRANSFORM3D_scale
    tx = load translation+SA3D_VEC3_x as f32
    ty = load translation+SA3D_VEC3_y as f32
    tz = load translation+SA3D_VEC3_z as f32
    rx = load rotation+SA3D_QUAT_x as f32
    ry = load rotation+SA3D_QUAT_y as f32
    rz = load rotation+SA3D_QUAT_z as f32
    rw = load rotation+SA3D_QUAT_w as f32
    sx = load scale+SA3D_VEC3_x as f32
    sy = load scale+SA3D_VEC3_y as f32
    sz = load scale+SA3D_VEC3_z as f32
    tx_ok = call @sa3d_f32_is_finite(tx)
    ty_ok = call @sa3d_f32_is_finite(ty)
    tz_ok = call @sa3d_f32_is_finite(tz)
    rx_ok = call @sa3d_f32_is_finite(rx)
    ry_ok = call @sa3d_f32_is_finite(ry)
    rz_ok = call @sa3d_f32_is_finite(rz)
    rw_ok = call @sa3d_f32_is_finite(rw)
    sx_ok = call @sa3d_f32_is_finite(sx)
    sy_ok = call @sa3d_f32_is_finite(sy)
    sz_ok = call @sa3d_f32_is_finite(sz)
    p1 = and tx_ok, ty_ok
    p2 = and tz_ok, rx_ok
    p3 = and ry_ok, rz_ok
    p4 = and rw_ok, sx_ok
    p5 = and sy_ok, sz_ok
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and q1, q2
    ok = and q3, p5
    !q3
    !q2
    !q1
    !p5
    !p4
    !p3
    !p2
    !p1
    !sz_ok
    !sy_ok
    !sx_ok
    !rw_ok
    !rz_ok
    !ry_ok
    !rx_ok
    !tz_ok
    !ty_ok
    !tx_ok
    !sz
    !sy
    !sx
    !rw
    !rz
    !ry
    !rx
    !tz
    !ty
    !tx
    !scale
    !rotation
    !translation
    !transform
    return ok

@sa3d_world_transform_identity(&world: ptr) -> void:
L_ENTRY:
    matrix = ptr_add world, SA3D_WORLD_TRANSFORM_matrix
    store matrix+0, SA3D_F32_ONE_BITS as i32
    store matrix+4, SA3D_F32_ZERO_BITS as i32
    store matrix+8, SA3D_F32_ZERO_BITS as i32
    store matrix+12, SA3D_F32_ZERO_BITS as i32
    store matrix+16, SA3D_F32_ZERO_BITS as i32
    store matrix+20, SA3D_F32_ONE_BITS as i32
    store matrix+24, SA3D_F32_ZERO_BITS as i32
    store matrix+28, SA3D_F32_ZERO_BITS as i32
    store matrix+32, SA3D_F32_ZERO_BITS as i32
    store matrix+36, SA3D_F32_ZERO_BITS as i32
    store matrix+40, SA3D_F32_ONE_BITS as i32
    store matrix+44, SA3D_F32_ZERO_BITS as i32
    store matrix+48, SA3D_F32_ZERO_BITS as i32
    store matrix+52, SA3D_F32_ZERO_BITS as i32
    store matrix+56, SA3D_F32_ZERO_BITS as i32
    store matrix+60, SA3D_F32_ONE_BITS as i32
    store world+SA3D_WORLD_TRANSFORM_dirty, 0 as i64
    !matrix
    !world
    return

@sa3d_world_transform_mark_dirty(&world: ptr) -> void:
L_ENTRY:
    store world+SA3D_WORLD_TRANSFORM_dirty, 1 as i64
    !world
    return

@sa3d_world_transform_copy_matrix(&world: ptr, &mat: ptr) -> void:
L_ENTRY:
    matrix = ptr_add world, SA3D_WORLD_TRANSFORM_matrix
    call @sa3d_mat4_copy(&matrix, &mat)
    store world+SA3D_WORLD_TRANSFORM_dirty, 0 as i64
    !matrix
    !mat
    !world
    return

@sa3d_world_transform_is_dirty(&world: ptr) -> i32:
L_ENTRY:
    dirty = load world+SA3D_WORLD_TRANSFORM_dirty as i64
    is_dirty = ne dirty, 0
    !dirty
    !world
    br is_dirty -> L_TRUE, L_FALSE

L_TRUE:
    !is_dirty
    return 1

L_FALSE:
    !is_dirty
    return 0

@sa3d_transform_node_init(&node: ptr, entity: i64, parent: i64) -> void:
L_ENTRY:
    store node+SA3D_TRANSFORM_NODE_entity, entity as i64
    store node+SA3D_TRANSFORM_NODE_parent, parent as i64
    store node+SA3D_TRANSFORM_NODE_first_child, 0 as i64
    store node+SA3D_TRANSFORM_NODE_next_sibling, 0 as i64
    local = ptr_add node, SA3D_TRANSFORM_NODE_local
    world = ptr_add node, SA3D_TRANSFORM_NODE_world
    local_translation = ptr_add local, SA3D_TRANSFORM3D_translation
    local_rotation = ptr_add local, SA3D_TRANSFORM3D_rotation
    local_scale = ptr_add local, SA3D_TRANSFORM3D_scale
    world_matrix = ptr_add world, SA3D_WORLD_TRANSFORM_matrix
    store local_translation+SA3D_VEC3_x, SA3D_F32_ZERO_BITS as i32
    store local_translation+SA3D_VEC3_y, SA3D_F32_ZERO_BITS as i32
    store local_translation+SA3D_VEC3_z, SA3D_F32_ZERO_BITS as i32
    store local_translation+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    store local_rotation+SA3D_QUAT_x, SA3D_F32_ZERO_BITS as i32
    store local_rotation+SA3D_QUAT_y, SA3D_F32_ZERO_BITS as i32
    store local_rotation+SA3D_QUAT_z, SA3D_F32_ZERO_BITS as i32
    store local_rotation+SA3D_QUAT_w, SA3D_F32_ONE_BITS as i32
    store local_scale+SA3D_VEC3_x, SA3D_F32_ONE_BITS as i32
    store local_scale+SA3D_VEC3_y, SA3D_F32_ONE_BITS as i32
    store local_scale+SA3D_VEC3_z, SA3D_F32_ONE_BITS as i32
    store local_scale+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    store world_matrix+0, SA3D_F32_ONE_BITS as i32
    store world_matrix+4, SA3D_F32_ZERO_BITS as i32
    store world_matrix+8, SA3D_F32_ZERO_BITS as i32
    store world_matrix+12, SA3D_F32_ZERO_BITS as i32
    store world_matrix+16, SA3D_F32_ZERO_BITS as i32
    store world_matrix+20, SA3D_F32_ONE_BITS as i32
    store world_matrix+24, SA3D_F32_ZERO_BITS as i32
    store world_matrix+28, SA3D_F32_ZERO_BITS as i32
    store world_matrix+32, SA3D_F32_ZERO_BITS as i32
    store world_matrix+36, SA3D_F32_ZERO_BITS as i32
    store world_matrix+40, SA3D_F32_ONE_BITS as i32
    store world_matrix+44, SA3D_F32_ZERO_BITS as i32
    store world_matrix+48, SA3D_F32_ZERO_BITS as i32
    store world_matrix+52, SA3D_F32_ZERO_BITS as i32
    store world_matrix+56, SA3D_F32_ZERO_BITS as i32
    store world_matrix+60, SA3D_F32_ONE_BITS as i32
    store world+SA3D_WORLD_TRANSFORM_dirty, 1 as i64
    !world_matrix
    !local_scale
    !local_rotation
    !local_translation
    !world
    !local
    !parent
    !entity
    !node
    return

@sa3d_transform_node_update_local_world(&node: ptr) -> void:
L_ENTRY:
    local = ptr_add node, SA3D_TRANSFORM_NODE_local
    world = ptr_add node, SA3D_TRANSFORM_NODE_world
    matrix = ptr_add world, SA3D_WORLD_TRANSFORM_matrix
    call @sa3d_transform3d_to_matrix(&matrix, &local)
    store world+SA3D_WORLD_TRANSFORM_dirty, 0 as i64
    !matrix
    !world
    !local
    !node
    return

@sa3d_transform_node_set_parent(&node: ptr, parent: i64) -> void:
L_ENTRY:
    store node+SA3D_TRANSFORM_NODE_parent, parent as i64
    world = ptr_add node, SA3D_TRANSFORM_NODE_world
    store world+SA3D_WORLD_TRANSFORM_dirty, 1 as i64
    !world
    !parent
    !node
    return

@sa3d_transform_node_link_child(&parent_node: ptr, &child_node: ptr) -> void:
L_ENTRY:
    parent_entity = load parent_node+SA3D_TRANSFORM_NODE_entity as i64
    child_entity = load child_node+SA3D_TRANSFORM_NODE_entity as i64
    old_first = load parent_node+SA3D_TRANSFORM_NODE_first_child as i64
    store child_node+SA3D_TRANSFORM_NODE_parent, parent_entity as i64
    store child_node+SA3D_TRANSFORM_NODE_next_sibling, old_first as i64
    store parent_node+SA3D_TRANSFORM_NODE_first_child, child_entity as i64
    parent_world = ptr_add parent_node, SA3D_TRANSFORM_NODE_world
    child_world = ptr_add child_node, SA3D_TRANSFORM_NODE_world
    store parent_world+SA3D_WORLD_TRANSFORM_dirty, 1 as i64
    store child_world+SA3D_WORLD_TRANSFORM_dirty, 1 as i64
    !child_world
    !parent_world
    !old_first
    !child_entity
    !parent_entity
    !child_node
    !parent_node
    return

@sa3d_transform_node_update_world_from_parent(&node: ptr, &parent_node: ptr) -> void:
L_ENTRY:
    local = ptr_add node, SA3D_TRANSFORM_NODE_local
    world = ptr_add node, SA3D_TRANSFORM_NODE_world
    matrix = ptr_add world, SA3D_WORLD_TRANSFORM_matrix
    parent_world = ptr_add parent_node, SA3D_TRANSFORM_NODE_world
    parent_matrix = ptr_add parent_world, SA3D_WORLD_TRANSFORM_matrix
    local_matrix = alloc SA3D_MAT4_SIZE
    call @sa3d_transform3d_to_matrix(&local_matrix, &local)
    call @sa3d_mat4_mul(&matrix, &parent_matrix, &local_matrix)
    store world+SA3D_WORLD_TRANSFORM_dirty, 0 as i64
    !local_matrix
    !parent_matrix
    !parent_world
    !matrix
    !world
    !local
    !parent_node
    !node
    return
