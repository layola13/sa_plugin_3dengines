@import "../sa3d.sai"
@import "../sa3d.sal"

@test "sa3d sidecar cube constants"():
L_ENTRY:
    usage_ok = eq SA3D_CUBE_VERTEX_USAGE, 40
    index_ok = eq SA3D_CUBE_INDEX_COUNT, 36
    frames_ok = eq SA3D_CUBE_FRAME_COUNT, 240
    selector_ok = eq SA3D_CUBE_CANVAS_SELECTOR_LEN, 12
    pair1 = and usage_ok, index_ok
    pair2 = and frames_ok, selector_ok
    ok = and pair1, pair2
    br ok -> L_OK, L_ERR

L_OK:
    return

L_ERR:
    panic(3100)

@test "sa3d sidecar generic wgpu layout constants"():
L_ENTRY:
    scene = alloc SA3D_WGPU_RENDER_SCENE_SIZE
    item = alloc SA3D_WGPU_DRAW_ITEM_SIZE
    mesh_desc = alloc SA3D_WGPU_MESH_DESC_SIZE
    material_desc = alloc SA3D_WGPU_MATERIAL_DESC_SIZE
    store scene+SA3D_WGPU_RENDER_SCENE_draw_items_ptr, 1000 as i64
    store scene+SA3D_WGPU_RENDER_SCENE_draw_items_len, 2 as i64
    store scene+SA3D_WGPU_RENDER_SCENE_camera_uniform, 2000 as i64
    store item+SA3D_WGPU_DRAW_ITEM_mesh, 10 as i64
    store item+SA3D_WGPU_DRAW_ITEM_material, 20 as i64
    store item+SA3D_WGPU_DRAW_ITEM_transform, 30 as i64
    store item+SA3D_WGPU_DRAW_ITEM_transform_frame_stride, SA3D_UNIT_CUBE_MODEL_FRAME_BYTES as i64
    store item+SA3D_WGPU_DRAW_ITEM_transform_frame_count, SA3D_UNIT_CUBE_FRAME_COUNT as i64
    store mesh_desc+SA3D_WGPU_MESH_DESC_vertex_len, SA3D_UNIT_CUBE_P3N3UV2_VERTEX_BYTES as i64
    store mesh_desc+SA3D_WGPU_MESH_DESC_vertex_stride, SA3D_WGPU_VERTEX_P3N3UV2_SIZE as i64
    store mesh_desc+SA3D_WGPU_MESH_DESC_index_len, SA3D_UNIT_CUBE_INDEX_BYTES as i64
    store mesh_desc+SA3D_WGPU_MESH_DESC_index_format, SA3D_WGPU_INDEX_U16 as i32
    store mesh_desc+SA3D_WGPU_MESH_DESC_primitive, SA3D_WGPU_PRIMITIVE_TRIANGLE_LIST as i32
    store material_desc+SA3D_WGPU_MATERIAL_DESC_model, SA3D_WGPU_MATERIAL_MODEL_UNLIT as i32
    store material_desc+SA3D_WGPU_MATERIAL_DESC_base_color, 1065353216 as i32
    draw_ptr = load scene+0 as i64
    draw_len = load scene+8 as i64
    camera = load scene+16 as i64
    mesh_h = load item+0 as i64
    material_h = load item+16 as i64
    transform = load item+24 as i64
    frame_stride = load item+40 as i64
    frame_count = load item+48 as i64
    vertex_len = load mesh_desc+8 as i64
    vertex_stride = load mesh_desc+16 as i64
    index_len = load mesh_desc+32 as i64
    index_format = load mesh_desc+40 as i32
    primitive = load mesh_desc+44 as i32
    material_model = load material_desc+0 as i32
    material_r = load material_desc+8 as i32
    scene_size_ok = eq SA3D_WGPU_RENDER_SCENE_SIZE, 56
    frame_size_ok = eq SA3D_WGPU_RENDER_FRAME_SIZE, 40
    target_size_ok = eq SA3D_WGPU_RENDER_TARGET_SIZE, 24
    item_size_ok = eq SA3D_WGPU_DRAW_ITEM_SIZE, 56
    mesh_size_ok = eq SA3D_WGPU_MESH_DESC_SIZE, 80
    material_size_ok = eq SA3D_WGPU_MATERIAL_DESC_SIZE, 88
    status_ok = eq SA3D_WGPU_STATUS_NOT_READY, 2
    resource_ok = eq SA3D_UNIT_CUBE_MODEL_FRAMES_BYTES, 15360
    camera_uniform_ok = eq SA3D_UNIT_CUBE_CAMERA_UNIFORM_BYTES, 208
    draw_ptr_ok = eq draw_ptr, 1000
    draw_len_ok = eq draw_len, 2
    camera_ok = eq camera, 2000
    mesh_ok = eq mesh_h, 10
    material_ok = eq material_h, 20
    transform_ok = eq transform, 30
    frame_stride_ok = eq frame_stride, 64
    frame_count_ok = eq frame_count, 240
    vertex_len_ok = eq vertex_len, 768
    vertex_stride_ok = eq vertex_stride, 32
    index_len_ok = eq index_len, 72
    index_format_ok = eq index_format, 1
    primitive_ok = eq primitive, 0
    material_model_ok = eq material_model, 0
    material_r_ok = eq material_r, 1065353216
    pair1 = and scene_size_ok, frame_size_ok
    pair2 = and target_size_ok, item_size_ok
    pair3 = and mesh_size_ok, material_size_ok
    pair4 = and status_ok, resource_ok
    pair5 = and camera_uniform_ok, draw_ptr_ok
    pair6 = and draw_len_ok, camera_ok
    pair7 = and mesh_ok, material_ok
    pair8 = and transform_ok, frame_stride_ok
    pair9 = and frame_count_ok, vertex_len_ok
    pair10 = and vertex_stride_ok, index_len_ok
    pair11 = and index_format_ok, primitive_ok
    pair12 = and material_model_ok, material_r_ok
    ok1 = and pair1, pair2
    ok2 = and pair3, pair4
    ok3 = and pair5, pair6
    ok4 = and pair7, pair8
    ok5 = and pair9, pair10
    ok6 = and pair11, pair12
    ok7 = and ok1, ok2
    ok8 = and ok3, ok4
    ok9 = and ok5, ok6
    ok10 = and ok7, ok8
    ok = and ok10, ok9
    br ok -> L_OK, L_ERR

L_OK:
    !material_desc
    !mesh_desc
    !item
    !scene
    return

L_ERR:
    !material_desc
    !mesh_desc
    !item
    !scene
    panic(3101)
