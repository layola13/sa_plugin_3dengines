@test "3d_render_wgpu scene clear color"():
L_ENTRY:
    d = alloc SA3D_RENDER_SCENE_DESC_SIZE
    call @sa3d_render_scene_desc_init(&d)
    a0 = load d+52 as i32
    a0_ok = eq a0, 1065353216
    br a0_ok -> L_SET, L_ERR0
L_SET:
    call @sa3d_render_scene_desc_set_clear_color(&d, 0.25, 0.5, 0.75, 1.0)
    r_bits = load d+SA3D_RENDER_SCENE_DESC_clear_color as i32
    g_bits = load d+44 as i32
    b_bits = load d+48 as i32
    a_bits = load d+52 as i32
    r_ok = eq r_bits, 1048576000
    g_ok = eq g_bits, 1056964608
    b_ok = eq b_bits, 1061158912
    a_ok = eq a_bits, 1065353216
    p1 = and r_ok, g_ok
    p2 = and b_ok, a_ok
    ok = and p1, p2
    !d
    br ok -> L_OK, L_ERR1
L_OK:
    return 0
L_ERR0:
    !d
    panic(3154)
L_ERR1:
    panic(3155)

@test "3d_render_wgpu pass desc validation"():
L_ENTRY:
    p = alloc SA3D_RENDER_PASS_DESC_SIZE
    call @sa3d_render_pass_desc_init(&p)
    v0 = call @sa3d_render_pass_desc_is_valid(&p)
    v0_ok = eq v0, 0
    br v0_ok -> L_TARGET, L_ERR0
L_TARGET:
    call @sa3d_render_pass_desc_set_target(&p, 44)
    v1 = call @sa3d_render_pass_desc_is_valid(&p)
    load_ok = call @sa3d_render_pass_load_op_is_valid(SA3D_RENDER_LOAD_OP_CLEAR)
    store_ok = call @sa3d_render_pass_store_op_is_valid(SA3D_RENDER_STORE_OP_STORE)
    invalid_load = call @sa3d_render_pass_load_op_is_valid(9)
    invalid_store = call @sa3d_render_pass_store_op_is_valid(9)
    v1_ok = eq v1, 1
    invalid_load_ok = eq invalid_load, 0
    invalid_store_ok = eq invalid_store, 0
    a = and v1_ok, load_ok
    b = and store_ok, invalid_load_ok
    c = and a, b
    ok = and c, invalid_store_ok
    !p
    br ok -> L_OK, L_ERR1
L_OK:
    return 0
L_ERR0:
    !p
    panic(3150)
L_ERR1:
    panic(3151)

