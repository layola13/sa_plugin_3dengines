@test "3d_render_wgpu material desc validation and textures"():
L_ENTRY:
    d = alloc SA3D_RENDER_MATERIAL_DESC_SIZE
    call @sa3d_render_material_desc_init(&d)
    valid0 = call @sa3d_render_material_desc_is_valid(&d)
    tex0 = call @sa3d_render_material_desc_has_any_texture(&d)
    valid0_ok = eq valid0, 1
    tex0_ok = eq tex0, 0
    ok0 = and valid0_ok, tex0_ok
    br ok0 -> L_TEX, L_ERR0
L_TEX:
    call @sa3d_render_material_desc_set_model(&d, SA3D_RENDER_MATERIAL_MODEL_PBR)
    call @sa3d_render_material_desc_set_textures(&d, 50, 0, 51, 0)
    valid1 = call @sa3d_render_material_desc_is_valid(&d)
    tex1 = call @sa3d_render_material_desc_has_any_texture(&d)
    valid1_ok = eq valid1, 1
    tex1_ok = eq tex1, 1
    ok1 = and valid1_ok, tex1_ok
    br ok1 -> L_BAD, L_ERR1
L_BAD:
    call @sa3d_render_material_desc_set_model(&d, 99)
    valid2 = call @sa3d_render_material_desc_is_valid(&d)
    ok = eq valid2, 0
    !d
    br ok -> L_OK, L_ERR2
L_OK:
    return 0
L_ERR0:
    !d
    panic(3143)
L_ERR1:
    !d
    panic(3144)
L_ERR2:
    panic(3145)

