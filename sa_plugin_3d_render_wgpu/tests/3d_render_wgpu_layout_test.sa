@test "3d_render_wgpu maps p3n3uv2 pipeline to shared wgpu desc"():
L_ENTRY:
    attrs = alloc 72
    desc = alloc WGPU_RENDER_PIPELINE_DESC_SIZE
    attr1 = ptr_add attrs, WGPU_VERTEX_ATTR_SIZE
    attr2 = ptr_add attrs, 48
    call @sa3d_render_wgpu_pipeline_desc_p3n3uv2(&desc, 55, *WGPU_CUBE_VS_ENTRY, WGPU_CUBE_VS_ENTRY_LEN, *WGPU_CUBE_FS_ENTRY, WGPU_CUBE_FS_ENTRY_LEN, SA3D_RENDER_PRIMITIVE_TRIANGLE_LIST, &attrs)
    valid = call @sa_wgpu_render_pipeline_desc_is_valid(&desc)
    stride = load desc+WGPU_RENDER_PIPELINE_DESC_vertex_stride as i64
    attrs_len = load desc+WGPU_RENDER_PIPELINE_DESC_attrs_len as i64
    primitive = load desc+WGPU_RENDER_PIPELINE_DESC_primitive as i32
    loc0 = load attrs+WGPU_VERTEX_ATTR_shader_location as i32
    off1 = load attr1+WGPU_VERTEX_ATTR_offset as i64
    fmt2 = load attr2+WGPU_VERTEX_ATTR_format as i32
    valid_ok = eq valid, 1
    stride_ok = eq stride, SA3D_RENDER_VERTEX_P3N3UV2_SIZE
    attrs_ok = eq attrs_len, 3
    prim_ok = eq primitive, WGPU_PRIMITIVE_TRIANGLE_LIST
    loc_ok = eq loc0, 0
    off_ok = eq off1, SA3D_RENDER_VERTEX_P3N3UV2_normal
    fmt_ok = eq fmt2, WGPU_VERTEX_FORMAT_FLOAT32X2
    a = and valid_ok, stride_ok
    b = and attrs_ok, prim_ok
    c = and loc_ok, off_ok
    d = and a, b
    e = and c, fmt_ok
    ok = and d, e
    !desc
    !attr2
    !attr1
    !attrs
    br ok -> L_OK, L_ERR
L_OK:
    return 0
L_ERR:
    panic(3152)

@test "3d_render_wgpu maps mesh and pass to shared wgpu draw desc"():
L_ENTRY:
    mesh = alloc SA3D_RENDER_MESH_DESC_SIZE
    pass = alloc SA3D_RENDER_PASS_DESC_SIZE
    draw = alloc WGPU_DRAW_DESC_SIZE
    call @sa3d_render_pass_desc_init(&pass)
    call @sa3d_render_pass_desc_set_target(&pass, 44)
    store mesh+SA3D_RENDER_MESH_DESC_vertex_len, 24 as i64
    store mesh+SA3D_RENDER_MESH_DESC_index_len, 36 as i64
    store mesh+SA3D_RENDER_MESH_DESC_index_format, SA3D_RENDER_INDEX_U16 as i32
    call @sa3d_render_wgpu_draw_desc_from_mesh_pass(&draw, 10, 11, 12, 13, &mesh, &pass)
    valid = call @sa_wgpu_draw_desc_is_valid(&draw)
    format = load draw+WGPU_DRAW_DESC_index_format as i32
    index_count = load draw+WGPU_DRAW_DESC_index_count as i64
    load_op = load draw+WGPU_DRAW_DESC_load_op as i32
    store_op = load draw+WGPU_DRAW_DESC_store_op as i32
    valid_ok = eq valid, 1
    format_ok = eq format, WGPU_INDEX_U16
    count_ok = eq index_count, 36
    load_ok = eq load_op, WGPU_LOAD_OP_CLEAR
    store_ok = eq store_op, WGPU_STORE_OP_STORE
    a = and valid_ok, format_ok
    b = and count_ok, load_ok
    c = and a, b
    ok = and c, store_ok
    !draw
    !pass
    !mesh
    br ok -> L_OK, L_ERR
L_OK:
    return 0
L_ERR:
    panic(3153)
