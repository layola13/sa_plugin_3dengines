@import "../3d_render_wgpu.sal"

@test "3d_render_wgpu pipeline desc from shader pair"():
L_ENTRY:
    pair = alloc SA3D_SHADER_ENTRY_PAIR_SIZE
    attrs = alloc 72
    desc = alloc WGPU_RENDER_PIPELINE_DESC_SIZE
    vs_name = alloc 8
    fs_name = alloc 8
    call @sa3d_shader_entry_pair_init(&pair, &vs_name, WGPU_CUBE_VS_ENTRY_LEN, &fs_name, WGPU_CUBE_FS_ENTRY_LEN)
    ok0 = call @sa3d_render_wgpu_pipeline_desc_from_shader_pair_p3n3uv2(&desc, &pair, SA3D_RENDER_PRIMITIVE_TRIANGLE_LIST, &attrs)
    call @sa3d_shader_entry_pair_set_ref_handle(&pair, 123)
    ok1 = call @sa3d_render_wgpu_pipeline_desc_from_shader_pair_p3n3uv2(&desc, &pair, SA3D_RENDER_PRIMITIVE_TRIANGLE_LIST, &attrs)
    valid = call @sa_wgpu_render_pipeline_desc_is_valid(&desc)
    shader = load desc+WGPU_RENDER_PIPELINE_DESC_shader as i64
    stride = load desc+WGPU_RENDER_PIPELINE_DESC_vertex_stride as i64
    attrs_len = load desc+WGPU_RENDER_PIPELINE_DESC_attrs_len as i64
    ok0_ok = eq ok0, 0
    ok1_ok = eq ok1, 1
    valid_ok = eq valid, 1
    shader_ok = eq shader, 123
    stride_ok = eq stride, SA3D_RENDER_VERTEX_P3N3UV2_SIZE
    attrs_ok = eq attrs_len, 3
    p1 = and ok0_ok, ok1_ok
    p2 = and valid_ok, shader_ok
    p3 = and stride_ok, attrs_ok
    q = and p1, p2
    ok = and q, p3
    !fs_name
    !vs_name
    !desc
    !attrs
    !pair
    br ok -> L_OK, L_ERR
L_OK:
    return 0
L_ERR:
    panic(3129)

@test "3d_render_wgpu target init"():
L_ENTRY:
    t = alloc SA3D_RENDER_TARGET_SIZE
    call @sa3d_render_target_init(&t)
    w0 = call @sa3d_render_target_get_width(&t)
    h0 = call @sa3d_render_target_get_height(&t)
    w0_ok = eq w0, 0
    h0_ok = eq h0, 0
    ok0 = and w0_ok, h0_ok
    br ok0 -> L_STEP2, L_ERR
L_STEP2:
    call @sa3d_render_target_set_size(&t, 1024, 768)
    w1 = call @sa3d_render_target_get_width(&t)
    h1 = call @sa3d_render_target_get_height(&t)
    w1_ok = eq w1, 1024
    h1_ok = eq h1, 768
    ok = and w1_ok, h1_ok
    !t
    br ok -> L_OK, L_ERR2
L_OK:
    return 0
L_ERR:
    !t
    panic(3130)
L_ERR2:
    panic(3131)

@test "3d_render_wgpu target metrics and validation"():
L_ENTRY:
    t = alloc SA3D_RENDER_TARGET_SIZE
    call @sa3d_render_target_init(&t)
    v0 = call @sa3d_render_target_is_valid(&t)
    v0_ok = eq v0, 0
    br v0_ok -> L_SIZE, L_ERR0
L_SIZE:
    call @sa3d_render_target_set_canvas(&t, 77)
    call @sa3d_render_target_set_size(&t, 1920, 1080)
    call @sa3d_render_target_set_sample_count(&t, 4)
    call @sa3d_render_target_set_formats(&t, 3, 100)
    canvas = call @sa3d_render_target_get_canvas(&t)
    samples = call @sa3d_render_target_get_sample_count(&t)
    pixels = call @sa3d_render_target_pixel_count(&t)
    aspect = call @sa3d_render_target_aspect_per_mille(&t)
    valid = call @sa3d_render_target_is_valid(&t)
    canvas_ok = eq canvas, 77
    samples_ok = eq samples, 4
    pixels_ok = eq pixels, 2073600
    aspect_ok = eq aspect, 1777
    valid_ok = eq valid, 1
    a = and canvas_ok, samples_ok
    b = and pixels_ok, aspect_ok
    c = and a, b
    ok = and c, valid_ok
    br ok -> L_DONE, L_ERR1
L_DONE:
    call @sa3d_render_target_set_sample_count(&t, 3)
    bad = call @sa3d_render_target_is_valid(&t)
    bad_ok = eq bad, 0
    !t
    br bad_ok -> L_OK, L_ERR2
L_OK:
    return 0
L_ERR0:
    !t
    panic(3138)
L_ERR1:
    !t
    panic(3139)
L_ERR2:
    panic(3140)

