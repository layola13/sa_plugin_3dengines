@test "3d_render_wgpu frame readiness and indexing"():
L_ENTRY:
    f = alloc SA3D_RENDER_FRAME_SIZE
    call @sa3d_render_frame_init(&f)
    r0 = call @sa3d_render_frame_is_ready(&f)
    r0_ok = eq r0, 0
    br r0_ok -> L_SET, L_ERR0
L_SET:
    call @sa3d_render_frame_set_handles(&f, 1, 2, 3)
    r1 = call @sa3d_render_frame_is_ready(&f)
    idx1 = call @sa3d_render_frame_next(&f, 16)
    idx2 = call @sa3d_render_frame_next(&f, 17)
    idx_read = call @sa3d_render_frame_get_index(&f)
    delta = call @sa3d_render_frame_get_delta(&f)
    r1_ok = eq r1, 1
    idx1_ok = eq idx1, 1
    idx2_ok = eq idx2, 2
    idx_read_ok = eq idx_read, 2
    delta_ok = eq delta, 17
    a = and r1_ok, idx1_ok
    b = and idx2_ok, idx_read_ok
    c = and a, b
    ok = and c, delta_ok
    !f
    br ok -> L_OK, L_ERR1
L_OK:
    return 0
L_ERR0:
    !f
    panic(3146)
L_ERR1:
    panic(3147)

