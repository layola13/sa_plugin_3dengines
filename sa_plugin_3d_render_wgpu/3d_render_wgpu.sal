@sa3d_render_scene_desc_is_renderable(&desc: ptr) -> i32:
L_ENTRY:
    items_ptr = load desc+SA3D_RENDER_SCENE_DESC_draw_items_ptr as i64
    items_len = load desc+SA3D_RENDER_SCENE_DESC_draw_items_len as i64
    camera_uniform = load desc+SA3D_RENDER_SCENE_DESC_camera_uniform as i64
    ptr_ok = ne items_ptr, 0
    len_ok = sgt items_len, 0
    camera_ok = ne camera_uniform, 0
    items_ok = and ptr_ok, len_ok
    ok = and items_ok, camera_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !items_ok
    !camera_ok
    !len_ok
    !ptr_ok
    !camera_uniform
    !items_len
    !items_ptr
    !desc
    return 1

L_FALSE:
    !ok
    !items_ok
    !camera_ok
    !len_ok
    !ptr_ok
    !camera_uniform
    !items_len
    !items_ptr
    !desc
    return 0

@sa3d_render_scene_desc_estimated_draw_calls(&desc: ptr) -> i64:
L_ENTRY:
    renderable = call @sa3d_render_scene_desc_is_renderable(&desc)
    br renderable -> L_COUNT, L_ZERO

L_COUNT:
    len = load desc+SA3D_RENDER_SCENE_DESC_draw_items_len as i64
    !renderable
    !desc
    return len

L_ZERO:
    !renderable
    !desc
    return 0

