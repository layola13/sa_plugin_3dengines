@sa3d_render_material_desc_set_textures(&desc: ptr, base_color: i64, normal: i64, metallic_roughness: i64, emissive: i64) -> void:
L_ENTRY:
    store desc+SA3D_RENDER_MATERIAL_DESC_base_color_texture, base_color as i64
    store desc+SA3D_RENDER_MATERIAL_DESC_normal_texture, normal as i64
    store desc+SA3D_RENDER_MATERIAL_DESC_metallic_roughness_texture, metallic_roughness as i64
    store desc+SA3D_RENDER_MATERIAL_DESC_emissive_texture, emissive as i64
    !emissive
    !metallic_roughness
    !normal
    !base_color
    !desc
    return

@sa3d_render_material_model_is_valid(model: i32) -> i32:
L_ENTRY:
    unlit = eq model, SA3D_RENDER_MATERIAL_MODEL_UNLIT
    pbr = eq model, SA3D_RENDER_MATERIAL_MODEL_PBR
    ok = or unlit, pbr
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !pbr
    !unlit
    !model
    return 1

L_FALSE:
    !ok
    !pbr
    !unlit
    !model
    return 0

@sa3d_render_material_desc_has_any_texture(&desc: ptr) -> i32:
L_ENTRY:
    base = load desc+SA3D_RENDER_MATERIAL_DESC_base_color_texture as i64
    normal = load desc+SA3D_RENDER_MATERIAL_DESC_normal_texture as i64
    mr = load desc+SA3D_RENDER_MATERIAL_DESC_metallic_roughness_texture as i64
    emissive = load desc+SA3D_RENDER_MATERIAL_DESC_emissive_texture as i64
    base_ok = ne base, 0
    normal_ok = ne normal, 0
    mr_ok = ne mr, 0
    emissive_ok = ne emissive, 0
    p1 = or base_ok, normal_ok
    p2 = or mr_ok, emissive_ok
    ok = or p1, p2
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !p2
    !p1
    !emissive_ok
    !mr_ok
    !normal_ok
    !base_ok
    !emissive
    !mr
    !normal
    !base
    !desc
    return 1

L_FALSE:
    !ok
    !p2
    !p1
    !emissive_ok
    !mr_ok
    !normal_ok
    !base_ok
    !emissive
    !mr
    !normal
    !base
    !desc
    return 0

@sa3d_render_material_desc_is_valid(&desc: ptr) -> i32:
L_ENTRY:
    model = load desc+SA3D_RENDER_MATERIAL_DESC_model as i32
    ok = call @sa3d_render_material_model_is_valid(model)
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !model
    !desc
    return 1

L_FALSE:
    !ok
    !model
    !desc
    return 0

