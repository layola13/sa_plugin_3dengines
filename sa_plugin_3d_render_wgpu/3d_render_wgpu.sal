@sa3d_render_pass_load_op_is_valid(load_op: i32) -> i32:
L_ENTRY:
    load = eq load_op, SA3D_RENDER_LOAD_OP_LOAD
    clear = eq load_op, SA3D_RENDER_LOAD_OP_CLEAR
    ok = or load, clear
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !clear
    !load
    !load_op
    return 1

L_FALSE:
    !ok
    !clear
    !load
    !load_op
    return 0

@sa3d_render_pass_store_op_is_valid(store_op: i32) -> i32:
L_ENTRY:
    discard = eq store_op, SA3D_RENDER_STORE_OP_DISCARD
    store = eq store_op, SA3D_RENDER_STORE_OP_STORE
    ok = or discard, store
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !store
    !discard
    !store_op
    return 1

L_FALSE:
    !ok
    !store
    !discard
    !store_op
    return 0

@sa3d_render_pass_desc_is_valid(&pass: ptr) -> i32:
L_ENTRY:
    target = load pass+SA3D_RENDER_PASS_DESC_target as i64
    load_op = load pass+SA3D_RENDER_PASS_DESC_load_op as i32
    store_op = load pass+SA3D_RENDER_PASS_DESC_store_op as i32
    depth_load = load pass+SA3D_RENDER_PASS_DESC_depth_load_op as i32
    depth_store = load pass+SA3D_RENDER_PASS_DESC_depth_store_op as i32
    target_ok = ne target, 0
    load_ok = call @sa3d_render_pass_load_op_is_valid(load_op)
    store_ok = call @sa3d_render_pass_store_op_is_valid(store_op)
    depth_load_ok = call @sa3d_render_pass_load_op_is_valid(depth_load)
    depth_store_ok = call @sa3d_render_pass_store_op_is_valid(depth_store)
    ops_ok = and load_ok, store_ok
    depth_ok = and depth_load_ok, depth_store_ok
    all_ops_ok = and ops_ok, depth_ok
    ok = and target_ok, all_ops_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !all_ops_ok
    !depth_ok
    !ops_ok
    !depth_store_ok
    !depth_load_ok
    !store_ok
    !load_ok
    !target_ok
    !depth_store
    !depth_load
    !store_op
    !load_op
    !target
    !pass
    return 1

L_FALSE:
    !ok
    !all_ops_ok
    !depth_ok
    !ops_ok
    !depth_store_ok
    !depth_load_ok
    !store_ok
    !load_ok
    !target_ok
    !depth_store
    !depth_load
    !store_op
    !load_op
    !target
    !pass
    return 0
