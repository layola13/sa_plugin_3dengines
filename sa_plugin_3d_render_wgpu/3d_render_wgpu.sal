#def SA3D_RENDER_WGPU_VERSION_MAJOR = 0
#def SA3D_RENDER_WGPU_VERSION_MINOR = 1

@import "../../sa_plugin_wgpu/wgpu.sal"
@import "../sa_plugin_3d_shader/3d_shader.sal"

#def SA3D_RENDER_BACKEND_WEBGPU = 1
#def SA3D_RENDER_STATUS_OK = 0
#def SA3D_RENDER_STATUS_ERROR = 1
#def SA3D_RENDER_STATUS_NOT_READY = 2

#def SA3D_RENDER_LOAD_OP_LOAD = 0
#def SA3D_RENDER_LOAD_OP_CLEAR = 1
#def SA3D_RENDER_STORE_OP_DISCARD = 0
#def SA3D_RENDER_STORE_OP_STORE = 1

#def SA3D_RENDER_PRIMITIVE_TRIANGLE_LIST = 0
#def SA3D_RENDER_PRIMITIVE_TRIANGLE_STRIP = 1
#def SA3D_RENDER_PRIMITIVE_LINE_LIST = 2
#def SA3D_RENDER_PRIMITIVE_POINT_LIST = 3

#def SA3D_RENDER_INDEX_NONE = 0
#def SA3D_RENDER_INDEX_U16 = 1
#def SA3D_RENDER_INDEX_U32 = 2

#def SA3D_RENDER_VERTEX_P3N3UV2_position = +0
#def SA3D_RENDER_VERTEX_P3N3UV2_normal = +12
#def SA3D_RENDER_VERTEX_P3N3UV2_uv = +24
#def SA3D_RENDER_VERTEX_P3N3UV2_SIZE = 32

#def SA3D_RENDER_MESH_DESC_vertex_ptr = +0
#def SA3D_RENDER_MESH_DESC_vertex_len = +8
#def SA3D_RENDER_MESH_DESC_vertex_stride = +16
#def SA3D_RENDER_MESH_DESC_index_ptr = +24
#def SA3D_RENDER_MESH_DESC_index_len = +32
#def SA3D_RENDER_MESH_DESC_index_format = +40
#def SA3D_RENDER_MESH_DESC_primitive = +44
#def SA3D_RENDER_MESH_DESC_bounds = +48
#def SA3D_RENDER_MESH_DESC_SIZE = 80

#def SA3D_RENDER_MATERIAL_MODEL_UNLIT = 0
#def SA3D_RENDER_MATERIAL_MODEL_PBR = 1

#def SA3D_RENDER_MATERIAL_DESC_model = +0
#def SA3D_RENDER_MATERIAL_DESC_flags = +4
#def SA3D_RENDER_MATERIAL_DESC_base_color = +8
#def SA3D_RENDER_MATERIAL_DESC_emissive = +24
#def SA3D_RENDER_MATERIAL_DESC_metallic = +40
#def SA3D_RENDER_MATERIAL_DESC_roughness = +44
#def SA3D_RENDER_MATERIAL_DESC_alpha_cutoff = +48
#def SA3D_RENDER_MATERIAL_DESC_base_color_texture = +56
#def SA3D_RENDER_MATERIAL_DESC_normal_texture = +64
#def SA3D_RENDER_MATERIAL_DESC_metallic_roughness_texture = +72
#def SA3D_RENDER_MATERIAL_DESC_emissive_texture = +80
#def SA3D_RENDER_MATERIAL_DESC_SIZE = 88

#def SA3D_RENDER_TARGET_canvas = +0
#def SA3D_RENDER_TARGET_width = +8
#def SA3D_RENDER_TARGET_height = +12
#def SA3D_RENDER_TARGET_sample_count = +16
#def SA3D_RENDER_TARGET_format = +20
#def SA3D_RENDER_TARGET_depth_format = +24
#def SA3D_RENDER_TARGET_SIZE = 32

#def SA3D_RENDER_FRAME_renderer = +0
#def SA3D_RENDER_FRAME_scene = +8
#def SA3D_RENDER_FRAME_camera = +16
#def SA3D_RENDER_FRAME_delta_ms = +24
#def SA3D_RENDER_FRAME_frame_index = +32
#def SA3D_RENDER_FRAME_SIZE = 40

#def SA3D_RENDER_SCENE_DESC_draw_items_ptr = +0
#def SA3D_RENDER_SCENE_DESC_draw_items_len = +8
#def SA3D_RENDER_SCENE_DESC_camera_uniform = +16
#def SA3D_RENDER_SCENE_DESC_lights_ptr = +24
#def SA3D_RENDER_SCENE_DESC_lights_len = +32
#def SA3D_RENDER_SCENE_DESC_clear_color = +40
#def SA3D_RENDER_SCENE_DESC_SIZE = 56

#def SA3D_DRAW_ITEM_mesh = +0
#def SA3D_DRAW_ITEM_submesh = +8
#def SA3D_DRAW_ITEM_material = +16
#def SA3D_DRAW_ITEM_transform = +24
#def SA3D_DRAW_ITEM_sort_key = +32
#def SA3D_DRAW_ITEM_SORT_KEY = +32
#def SA3D_DRAW_ITEM_transform_frame_stride = +40
#def SA3D_DRAW_ITEM_transform_frame_count = +48
#def SA3D_DRAW_ITEM_SIZE = 56

#def SA3D_RENDER_PASS_DESC_target = +0
#def SA3D_RENDER_PASS_DESC_load_op = +8
#def SA3D_RENDER_PASS_DESC_store_op = +12
#def SA3D_RENDER_PASS_DESC_clear_color = +16
#def SA3D_RENDER_PASS_DESC_depth_load_op = +32
#def SA3D_RENDER_PASS_DESC_depth_store_op = +36
#def SA3D_RENDER_PASS_DESC_SIZE = 40

@sa3d_render_wgpu_primitive_to_wgpu(primitive: i32) -> i32:
L_ENTRY:
    tri = eq primitive, SA3D_RENDER_PRIMITIVE_TRIANGLE_LIST
    strip = eq primitive, SA3D_RENDER_PRIMITIVE_TRIANGLE_STRIP
    line = eq primitive, SA3D_RENDER_PRIMITIVE_LINE_LIST
    point = eq primitive, SA3D_RENDER_PRIMITIVE_POINT_LIST
    br tri -> L_TRI, L_STRIP_CHECK
L_TRI:
    !point
    !line
    !strip
    !tri
    !primitive
    return WGPU_PRIMITIVE_TRIANGLE_LIST
L_STRIP_CHECK:
    br strip -> L_STRIP, L_LINE_CHECK
L_STRIP:
    !point
    !line
    !strip
    !tri
    !primitive
    return WGPU_PRIMITIVE_TRIANGLE_STRIP
L_LINE_CHECK:
    br line -> L_LINE, L_POINT_CHECK
L_LINE:
    !point
    !line
    !strip
    !tri
    !primitive
    return WGPU_PRIMITIVE_LINE_LIST
L_POINT_CHECK:
    br point -> L_POINT, L_DEFAULT
L_POINT:
    !point
    !line
    !strip
    !tri
    !primitive
    return WGPU_PRIMITIVE_POINT_LIST
L_DEFAULT:
    !point
    !line
    !strip
    !tri
    !primitive
    return WGPU_PRIMITIVE_TRIANGLE_LIST

@sa3d_render_wgpu_index_format_to_wgpu(format: i32) -> i32:
L_ENTRY:
    none = eq format, SA3D_RENDER_INDEX_NONE
    u16 = eq format, SA3D_RENDER_INDEX_U16
    u32 = eq format, SA3D_RENDER_INDEX_U32
    br none -> L_NONE, L_U16_CHECK
L_NONE:
    !u32
    !u16
    !none
    !format
    return WGPU_INDEX_NONE
L_U16_CHECK:
    br u16 -> L_U16, L_U32_CHECK
L_U16:
    !u32
    !u16
    !none
    !format
    return WGPU_INDEX_U16
L_U32_CHECK:
    br u32 -> L_U32, L_DEFAULT
L_U32:
    !u32
    !u16
    !none
    !format
    return WGPU_INDEX_U32
L_DEFAULT:
    !u32
    !u16
    !none
    !format
    return WGPU_INDEX_NONE

@sa3d_render_wgpu_load_op_to_wgpu(op: i32) -> i32:
L_ENTRY:
    load = eq op, SA3D_RENDER_LOAD_OP_LOAD
    br load -> L_LOAD, L_CLEAR
L_LOAD:
    !load
    !op
    return WGPU_LOAD_OP_LOAD
L_CLEAR:
    !load
    !op
    return WGPU_LOAD_OP_CLEAR

@sa3d_render_wgpu_store_op_to_wgpu(op: i32) -> i32:
L_ENTRY:
    discard = eq op, SA3D_RENDER_STORE_OP_DISCARD
    br discard -> L_DISCARD, L_STORE
L_DISCARD:
    !discard
    !op
    return WGPU_STORE_OP_DISCARD
L_STORE:
    !discard
    !op
    return WGPU_STORE_OP_STORE

@sa3d_render_wgpu_vertex_attrs_p3n3uv2(&attrs: ptr) -> void:
L_ENTRY:
    attr1 = ptr_add attrs, WGPU_VERTEX_ATTR_SIZE
    attr2 = ptr_add attrs, 48
    call @sa_wgpu_vertex_attr_init(&attrs, 0, SA3D_RENDER_VERTEX_P3N3UV2_position, WGPU_VERTEX_FORMAT_FLOAT32X3)
    call @sa_wgpu_vertex_attr_init(&attr1, 1, SA3D_RENDER_VERTEX_P3N3UV2_normal, WGPU_VERTEX_FORMAT_FLOAT32X3)
    call @sa_wgpu_vertex_attr_init(&attr2, 2, SA3D_RENDER_VERTEX_P3N3UV2_uv, WGPU_VERTEX_FORMAT_FLOAT32X2)
    !attr2
    !attr1
    !attrs
    return

@sa3d_render_wgpu_pipeline_desc_p3n3uv2(&desc: ptr, shader: i64, vs_entry: ptr, vs_len: i64, fs_entry: ptr, fs_len: i64, primitive: i32, &attrs: ptr) -> void:
L_ENTRY:
    wgpu_primitive = call @sa3d_render_wgpu_primitive_to_wgpu(primitive)
    call @sa_wgpu_render_pipeline_desc_init(&desc)
    call @sa3d_render_wgpu_vertex_attrs_p3n3uv2(&attrs)
    call @sa_wgpu_render_pipeline_desc_set_shader(&desc, shader, vs_entry, vs_len, fs_entry, fs_len)
    call @sa_wgpu_render_pipeline_desc_set_vertex_layout(&desc, SA3D_RENDER_VERTEX_P3N3UV2_SIZE, &attrs, 3)
    store desc+WGPU_RENDER_PIPELINE_DESC_primitive, wgpu_primitive as i32
    !wgpu_primitive
    !attrs
    !primitive
    !fs_len
    !fs_entry
    !vs_len
    !vs_entry
    !shader
    !desc
    return

@sa3d_render_wgpu_pipeline_desc_from_shader_pair_p3n3uv2(&desc: ptr, &pair: ptr, primitive: i32, &attrs: ptr) -> i32:
L_ENTRY:
    pair_ok = call @sa3d_shader_entry_pair_validate_render(&pair)
    br pair_ok -> L_BUILD, L_ERR

L_BUILD:
    fragment = ptr_add pair, SA3D_SHADER_ENTRY_PAIR_fragment
    shader = call @sa3d_shader_entry_get_handle(&pair)
    fragment_shader = call @sa3d_shader_entry_get_handle(&fragment)
    same_shader = eq shader, fragment_shader
    handle_ok = sgt shader, 0
    usable = and same_shader, handle_ok
    br usable -> L_BUILD_DESC, L_ERR_BUILD

L_BUILD_DESC:
    vs_ptr = load pair+SA3D_SHADER_ENTRY_name_ptr as ptr
    vs_len = load pair+SA3D_SHADER_ENTRY_name_len as i64
    fs_ptr = load fragment+SA3D_SHADER_ENTRY_name_ptr as ptr
    fs_len = load fragment+SA3D_SHADER_ENTRY_name_len as i64
    call @sa3d_render_wgpu_pipeline_desc_p3n3uv2(&desc, shader, vs_ptr, vs_len, fs_ptr, fs_len, primitive, &attrs)
    !fs_ptr
    !vs_ptr
    !fs_len
    !vs_len
    !usable
    !handle_ok
    !same_shader
    !fragment_shader
    !shader
    !fragment
    !pair_ok
    !attrs
    !primitive
    !pair
    !desc
    return 1

L_ERR_BUILD:
    !usable
    !handle_ok
    !same_shader
    !fragment_shader
    !shader
    !fragment
    !pair_ok
    !attrs
    !primitive
    !pair
    !desc
    return 0

L_ERR:
    !pair_ok
    !attrs
    !primitive
    !pair
    !desc
    return 0

@sa3d_render_wgpu_draw_desc_from_mesh_pass(&draw: ptr, pipeline: i64, vertex: i64, index: i64, uniform: i64, &mesh: ptr, &pass: ptr) -> void:
L_ENTRY:
    index_format = load mesh+SA3D_RENDER_MESH_DESC_index_format as i32
    index_len = load mesh+SA3D_RENDER_MESH_DESC_index_len as i64
    vertex_len = load mesh+SA3D_RENDER_MESH_DESC_vertex_len as i64
    wgpu_index = call @sa3d_render_wgpu_index_format_to_wgpu(index_format)
    load_op = load pass+SA3D_RENDER_PASS_DESC_load_op as i32
    store_op = load pass+SA3D_RENDER_PASS_DESC_store_op as i32
    depth_load = load pass+SA3D_RENDER_PASS_DESC_depth_load_op as i32
    depth_store = load pass+SA3D_RENDER_PASS_DESC_depth_store_op as i32
    wgpu_load = call @sa3d_render_wgpu_load_op_to_wgpu(load_op)
    wgpu_store = call @sa3d_render_wgpu_store_op_to_wgpu(store_op)
    wgpu_depth_load = call @sa3d_render_wgpu_load_op_to_wgpu(depth_load)
    wgpu_depth_store = call @sa3d_render_wgpu_store_op_to_wgpu(depth_store)
    call @sa_wgpu_draw_desc_init(&draw)
    call @sa_wgpu_draw_desc_set_resources(&draw, pipeline, vertex, index, uniform)
    call @sa_wgpu_draw_desc_set_counts(&draw, wgpu_index, index_len, vertex_len)
    store draw+WGPU_DRAW_DESC_load_op, wgpu_load as i32
    store draw+WGPU_DRAW_DESC_store_op, wgpu_store as i32
    store draw+WGPU_DRAW_DESC_depth_load_op, wgpu_depth_load as i32
    store draw+WGPU_DRAW_DESC_depth_store_op, wgpu_depth_store as i32
    !wgpu_depth_store
    !wgpu_depth_load
    !wgpu_store
    !wgpu_load
    !depth_store
    !depth_load
    !store_op
    !load_op
    !wgpu_index
    !vertex_len
    !index_len
    !index_format
    !pass
    !mesh
    !uniform
    !index
    !vertex
    !pipeline
    !draw
    return

@sa3d_render_target_init(&target: ptr) -> void:
L_ENTRY:
    store target+SA3D_RENDER_TARGET_canvas, 0 as i64
    store target+SA3D_RENDER_TARGET_width, 0 as i32
    store target+SA3D_RENDER_TARGET_height, 0 as i32
    store target+SA3D_RENDER_TARGET_sample_count, 1 as i32
    store target+SA3D_RENDER_TARGET_format, 0 as i32
    store target+SA3D_RENDER_TARGET_depth_format, 0 as i32
    !target
    return

@sa3d_render_target_set_canvas(&target: ptr, canvas: i64) -> void:
L_ENTRY:
    store target+SA3D_RENDER_TARGET_canvas, canvas as i64
    !canvas
    !target
    return

@sa3d_render_target_get_canvas(&target: ptr) -> i64:
L_ENTRY:
    canvas = load target+SA3D_RENDER_TARGET_canvas as i64
    !target
    return canvas

@sa3d_render_target_set_size(&target: ptr, width: i32, height: i32) -> void:
L_ENTRY:
    store target+SA3D_RENDER_TARGET_width, width as i32
    store target+SA3D_RENDER_TARGET_height, height as i32
    !height
    !width
    !target
    return

@sa3d_render_target_set_sample_count(&target: ptr, sample_count: i32) -> void:
L_ENTRY:
    store target+SA3D_RENDER_TARGET_sample_count, sample_count as i32
    !sample_count
    !target
    return

@sa3d_render_target_get_sample_count(&target: ptr) -> i32:
L_ENTRY:
    sample_count = load target+SA3D_RENDER_TARGET_sample_count as i32
    !target
    return sample_count

@sa3d_render_target_set_formats(&target: ptr, format: i32, depth_format: i32) -> void:
L_ENTRY:
    store target+SA3D_RENDER_TARGET_format, format as i32
    store target+SA3D_RENDER_TARGET_depth_format, depth_format as i32
    !depth_format
    !format
    !target
    return

@sa3d_render_target_pixel_count(&target: ptr) -> i64:
L_ENTRY:
    width32 = load target+SA3D_RENDER_TARGET_width as i32
    height32 = load target+SA3D_RENDER_TARGET_height as i32
    width = sext width32 as i64
    height = sext height32 as i64
    pixels = mul width, height
    !height
    !width
    !height32
    !width32
    !target
    return pixels

@sa3d_render_target_aspect_per_mille(&target: ptr) -> i32:
L_ENTRY:
    width = load target+SA3D_RENDER_TARGET_width as i32
    height = load target+SA3D_RENDER_TARGET_height as i32
    height_ok = sgt height, 0
    br height_ok -> L_COMPUTE, L_ZERO

L_COMPUTE:
    scaled = mul width, 1000
    aspect = sdiv scaled, height
    !scaled
    !height_ok
    !height
    !width
    !target
    return aspect

L_ZERO:
    !height_ok
    !height
    !width
    !target
    return 0

@sa3d_render_sample_count_is_valid(sample_count: i32) -> i32:
L_ENTRY:
    one = eq sample_count, 1
    two = eq sample_count, 2
    four = eq sample_count, 4
    eight = eq sample_count, 8
    p1 = or one, two
    p2 = or four, eight
    ok = or p1, p2
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !p2
    !p1
    !eight
    !four
    !two
    !one
    !sample_count
    return 1

L_FALSE:
    !ok
    !p2
    !p1
    !eight
    !four
    !two
    !one
    !sample_count
    return 0

@sa3d_render_target_is_valid(&target: ptr) -> i32:
L_ENTRY:
    width = load target+SA3D_RENDER_TARGET_width as i32
    height = load target+SA3D_RENDER_TARGET_height as i32
    sample_count = load target+SA3D_RENDER_TARGET_sample_count as i32
    width_ok = sgt width, 0
    height_ok = sgt height, 0
    samples_ok = call @sa3d_render_sample_count_is_valid(sample_count)
    size_ok = and width_ok, height_ok
    ok = and size_ok, samples_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !size_ok
    !samples_ok
    !height_ok
    !width_ok
    !sample_count
    !height
    !width
    !target
    return 1

L_FALSE:
    !ok
    !size_ok
    !samples_ok
    !height_ok
    !width_ok
    !sample_count
    !height
    !width
    !target
    return 0

@sa3d_render_target_get_width(&target: ptr) -> i32:
L_ENTRY:
    w = load target+SA3D_RENDER_TARGET_width as i32
    !target
    return w

@sa3d_render_target_get_height(&target: ptr) -> i32:
L_ENTRY:
    h = load target+SA3D_RENDER_TARGET_height as i32
    !target
    return h

@sa3d_render_frame_init(&frame: ptr) -> void:
L_ENTRY:
    store frame+SA3D_RENDER_FRAME_renderer, 0 as i64
    store frame+SA3D_RENDER_FRAME_scene, 0 as i64
    store frame+SA3D_RENDER_FRAME_camera, 0 as i64
    store frame+SA3D_RENDER_FRAME_delta_ms, 0 as i32
    store frame+SA3D_RENDER_FRAME_frame_index, 0 as i64
    !frame
    return

@sa3d_render_frame_set_delta(&frame: ptr, delta: i32) -> void:
L_ENTRY:
    store frame+SA3D_RENDER_FRAME_delta_ms, delta as i32
    !delta
    !frame
    return

@sa3d_render_frame_set_handles(&frame: ptr, renderer: i64, scene: i64, camera: i64) -> void:
L_ENTRY:
    store frame+SA3D_RENDER_FRAME_renderer, renderer as i64
    store frame+SA3D_RENDER_FRAME_scene, scene as i64
    store frame+SA3D_RENDER_FRAME_camera, camera as i64
    !camera
    !scene
    !renderer
    !frame
    return

@sa3d_render_frame_next(&frame: ptr, delta: i32) -> i64:
L_ENTRY:
    current = load frame+SA3D_RENDER_FRAME_frame_index as i64
    next = add current, 1
    store frame+SA3D_RENDER_FRAME_frame_index, next as i64
    store frame+SA3D_RENDER_FRAME_delta_ms, delta as i32
    !current
    !delta
    !frame
    return next

@sa3d_render_frame_get_index(&frame: ptr) -> i64:
L_ENTRY:
    idx = load frame+SA3D_RENDER_FRAME_frame_index as i64
    !frame
    return idx

@sa3d_render_frame_is_ready(&frame: ptr) -> i32:
L_ENTRY:
    renderer = load frame+SA3D_RENDER_FRAME_renderer as i64
    scene = load frame+SA3D_RENDER_FRAME_scene as i64
    camera = load frame+SA3D_RENDER_FRAME_camera as i64
    renderer_ok = ne renderer, 0
    scene_ok = ne scene, 0
    camera_ok = ne camera, 0
    rs_ok = and renderer_ok, scene_ok
    ok = and rs_ok, camera_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !rs_ok
    !camera_ok
    !scene_ok
    !renderer_ok
    !camera
    !scene
    !renderer
    !frame
    return 1

L_FALSE:
    !ok
    !rs_ok
    !camera_ok
    !scene_ok
    !renderer_ok
    !camera
    !scene
    !renderer
    !frame
    return 0

@sa3d_render_frame_get_delta(&frame: ptr) -> i32:
L_ENTRY:
    d = load frame+SA3D_RENDER_FRAME_delta_ms as i32
    !frame
    return d

@sa3d_draw_item_init(&item: ptr) -> void:
L_ENTRY:
    store item+SA3D_DRAW_ITEM_mesh, 0 as i64
    store item+SA3D_DRAW_ITEM_submesh, 0 as i64
    store item+SA3D_DRAW_ITEM_material, 0 as i64
    store item+SA3D_DRAW_ITEM_transform, 0 as i64
    store item+SA3D_DRAW_ITEM_sort_key, 0 as i64
    store item+SA3D_DRAW_ITEM_transform_frame_stride, 0 as i32
    store item+SA3D_DRAW_ITEM_transform_frame_count, 0 as i32
    !item
    return

@sa3d_draw_item_set_resources(&item: ptr, mesh: i64, submesh: i64, material: i64, transform: i64) -> void:
L_ENTRY:
    store item+SA3D_DRAW_ITEM_mesh, mesh as i64
    store item+SA3D_DRAW_ITEM_submesh, submesh as i64
    store item+SA3D_DRAW_ITEM_material, material as i64
    store item+SA3D_DRAW_ITEM_transform, transform as i64
    !transform
    !material
    !submesh
    !mesh
    !item
    return

@sa3d_draw_item_set_transform_frames(&item: ptr, stride: i32, count: i32) -> void:
L_ENTRY:
    store item+SA3D_DRAW_ITEM_transform_frame_stride, stride as i32
    store item+SA3D_DRAW_ITEM_transform_frame_count, count as i32
    !count
    !stride
    !item
    return

@sa3d_draw_item_set_sort_key(&item: ptr, key: i64) -> void:
L_ENTRY:
    store item+SA3D_DRAW_ITEM_sort_key, key as i64
    !key
    !item
    return

@sa3d_draw_item_get_sort_key(&item: ptr) -> i64:
L_ENTRY:
    k = load item+SA3D_DRAW_ITEM_sort_key as i64
    !item
    return k

@sa3d_draw_item_has_transform_frames(&item: ptr) -> i32:
L_ENTRY:
    stride = load item+SA3D_DRAW_ITEM_transform_frame_stride as i32
    count = load item+SA3D_DRAW_ITEM_transform_frame_count as i32
    stride_ok = sgt stride, 0
    count_ok = sgt count, 0
    ok = and stride_ok, count_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !count_ok
    !stride_ok
    !count
    !stride
    !item
    return 1

L_FALSE:
    !ok
    !count_ok
    !stride_ok
    !count
    !stride
    !item
