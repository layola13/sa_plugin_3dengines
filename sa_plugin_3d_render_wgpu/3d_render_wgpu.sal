    transform = load item+SA3D_DRAW_ITEM_transform as i64
    mesh_ok = ne mesh, 0
    material_ok = ne material, 0
    transform_ok = ne transform, 0
    mm_ok = and mesh_ok, material_ok
    ok = and mm_ok, transform_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !mm_ok
    !transform_ok
    !material_ok
    !mesh_ok
    !transform
    !material
    !mesh
    !item
    return 1

L_FALSE:
    !ok
    !mm_ok
    !transform_ok
    !material_ok
    !mesh_ok
    !transform
    !material
    !mesh
    !item
    return 0

@sa3d_render_material_desc_init(&desc: ptr) -> void:
L_ENTRY:
    store desc+SA3D_RENDER_MATERIAL_DESC_model, SA3D_RENDER_MATERIAL_MODEL_UNLIT as i32
    store desc+SA3D_RENDER_MATERIAL_DESC_flags, 0 as i32
    store desc+SA3D_RENDER_MATERIAL_DESC_base_color, 1065353216 as i32
    store desc+12, 1065353216 as i32
    store desc+16, 1065353216 as i32
    store desc+20, 1065353216 as i32
    store desc+SA3D_RENDER_MATERIAL_DESC_emissive, 0 as i32
    store desc+28, 0 as i32
    store desc+32, 0 as i32
    store desc+SA3D_RENDER_MATERIAL_DESC_metallic, 0 as i32
    store desc+SA3D_RENDER_MATERIAL_DESC_roughness, 1065353216 as i32
    store desc+SA3D_RENDER_MATERIAL_DESC_alpha_cutoff, 0 as i32
    store desc+SA3D_RENDER_MATERIAL_DESC_base_color_texture, 0 as i64
    store desc+SA3D_RENDER_MATERIAL_DESC_normal_texture, 0 as i64
    store desc+SA3D_RENDER_MATERIAL_DESC_metallic_roughness_texture, 0 as i64
    store desc+SA3D_RENDER_MATERIAL_DESC_emissive_texture, 0 as i64
    !desc
    return

@sa3d_render_material_desc_get_model(&desc: ptr) -> i32:
L_ENTRY:
    m = load desc+SA3D_RENDER_MATERIAL_DESC_model as i32
    !desc
