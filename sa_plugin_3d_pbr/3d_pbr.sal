@sa3d_pbr_material_set_normal_occlusion(&desc: ptr, normal_scale: i32, occlusion_strength: i32) -> void:
L_ENTRY:
    store desc+SA3D_PBR_MATERIAL_DESC_normal_scale, normal_scale as i32
    store desc+SA3D_PBR_MATERIAL_DESC_occlusion_strength, occlusion_strength as i32
    !occlusion_strength
    !normal_scale
    !desc
    return

@sa3d_pbr_material_texture_offset(slot: i32) -> i64:
L_ENTRY:
    is_base = eq slot, SA3D_PBR_TEXTURE_SLOT_BASE_COLOR
    br is_base -> L_BASE, L_NORMAL_CHECK

L_BASE:
    !is_base
    !slot
    return SA3D_PBR_MATERIAL_DESC_base_color_texture

L_NORMAL_CHECK:
    is_normal = eq slot, SA3D_PBR_TEXTURE_SLOT_NORMAL
    br is_normal -> L_NORMAL, L_MR_CHECK

L_NORMAL:
    !is_normal
    !is_base
    !slot
    return SA3D_PBR_MATERIAL_DESC_normal_texture

L_MR_CHECK:
    is_mr = eq slot, SA3D_PBR_TEXTURE_SLOT_METALLIC_ROUGHNESS
    br is_mr -> L_MR, L_EMISSIVE_CHECK

L_MR:
    !is_mr
    !is_normal
    !is_base
    !slot
    return SA3D_PBR_MATERIAL_DESC_metallic_roughness_texture

L_EMISSIVE_CHECK:
    is_emissive = eq slot, SA3D_PBR_TEXTURE_SLOT_EMISSIVE
    br is_emissive -> L_EMISSIVE, L_OCCLUSION_CHECK

L_EMISSIVE:
    !is_emissive
    !is_mr
    !is_normal
    !is_base
    !slot
    return SA3D_PBR_MATERIAL_DESC_emissive_texture

L_OCCLUSION_CHECK:
    is_occlusion = eq slot, SA3D_PBR_TEXTURE_SLOT_OCCLUSION
    br is_occlusion -> L_OCCLUSION, L_NONE

L_OCCLUSION:
    !is_occlusion
    !is_emissive
    !is_mr
    !is_normal
    !is_base
    !slot
    return SA3D_PBR_MATERIAL_DESC_occlusion_texture

L_NONE:
    !is_occlusion
    !is_emissive
    !is_mr
    !is_normal
    !is_base
    !slot
    return 0

@sa3d_pbr_material_set_texture(&desc: ptr, slot: i32, handle: i64) -> i32:
L_ENTRY:
    offset = call @sa3d_pbr_material_texture_offset(slot)
    valid = ne offset, 0
    br valid -> L_SET, L_INVALID

L_SET:
    target = ptr_add desc, offset
    store target+0, handle as i64
    !target
    !valid
    !offset
    !handle
    !slot
    !desc
    return 1

L_INVALID:
    !valid
    !offset
    !handle
    !slot
    !desc
    return 0

@sa3d_pbr_material_get_texture(&desc: ptr, slot: i32) -> i64:
L_ENTRY:
    offset = call @sa3d_pbr_material_texture_offset(slot)
    valid = ne offset, 0
    br valid -> L_GET, L_ZERO

L_GET:
    target = ptr_add desc, offset
    handle = load target+0 as i64
    !target
    !valid
    !offset
    !slot
    !desc
    return handle

L_ZERO:
    !valid
    !offset
    !slot
    !desc
    return 0

@sa3d_pbr_material_validate(&desc: ptr) -> i32:
L_ENTRY:
    mode = load desc+SA3D_PBR_MATERIAL_DESC_alpha_mode as i32
    metallic = load desc+SA3D_PBR_MATERIAL_DESC_metallic as i32
    roughness = load desc+SA3D_PBR_MATERIAL_DESC_roughness as i32
    mode_ok = call @sa3d_pbr_material_alpha_mode_is_valid(mode)
    metallic_ok = sge metallic, 0
    roughness_ok = sge roughness, 0
    p = and mode_ok, metallic_ok
    ok = and p, roughness_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !p
    !roughness_ok
    !metallic_ok
    !mode_ok
    !roughness
    !metallic
    !mode
    !desc
    return 1

L_FALSE:
    !ok
    !p
    !roughness_ok
    !metallic_ok
    !mode_ok
    !roughness
    !metallic
    !mode
    !desc
    return 0

@sa3d_pbr_environment_init(&env: ptr) -> void:
L_ENTRY:
    store env+SA3D_PBR_ENVIRONMENT_DESC_diffuse_cubemap, 0 as i64
    store env+SA3D_PBR_ENVIRONMENT_DESC_specular_cubemap, 0 as i64
    store env+SA3D_PBR_ENVIRONMENT_DESC_brdf_lut, 0 as i64
    store env+SA3D_PBR_ENVIRONMENT_DESC_intensity, 1065353216 as i32
    store env+SA3D_PBR_ENVIRONMENT_DESC_rotation, 0 as i32
    !env
    return

@sa3d_pbr_environment_get_intensity(&env: ptr) -> i32:
L_ENTRY:
    i = load env+SA3D_PBR_ENVIRONMENT_DESC_intensity as i32
    !env
    return i

@sa3d_pbr_environment_set_maps(&env: ptr, diffuse: i64, specular: i64, brdf_lut: i64) -> void:
L_ENTRY:
    store env+SA3D_PBR_ENVIRONMENT_DESC_diffuse_cubemap, diffuse as i64
    store env+SA3D_PBR_ENVIRONMENT_DESC_specular_cubemap, specular as i64
    store env+SA3D_PBR_ENVIRONMENT_DESC_brdf_lut, brdf_lut as i64
    !brdf_lut
    !specular
    !diffuse
    !env
    return

@sa3d_pbr_environment_set_intensity(&env: ptr, intensity: i32) -> void:
L_ENTRY:
    store env+SA3D_PBR_ENVIRONMENT_DESC_intensity, intensity as i32
    !intensity
    !env
    return

@sa3d_pbr_environment_has_complete_maps(&env: ptr) -> i32:
L_ENTRY:
    diffuse = load env+SA3D_PBR_ENVIRONMENT_DESC_diffuse_cubemap as i64
    specular = load env+SA3D_PBR_ENVIRONMENT_DESC_specular_cubemap as i64
    brdf = load env+SA3D_PBR_ENVIRONMENT_DESC_brdf_lut as i64
    diffuse_ok = ne diffuse, 0
    specular_ok = ne specular, 0
    brdf_ok = ne brdf, 0
    p = and diffuse_ok, specular_ok
    ok = and p, brdf_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !p
    !brdf_ok
    !specular_ok
    !diffuse_ok
    !brdf
    !specular
    !diffuse
    !env
    return 1

L_FALSE:
    !ok
    !p
    !brdf_ok
    !specular_ok
    !diffuse_ok
    !brdf
    !specular
    !diffuse
    !env
    return 0
