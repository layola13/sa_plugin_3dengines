    !fixed_vertices
    !mesh
    !indices
    !vertices
    panic(3049)

@test "3d_geometry capsule matches bevy capsule builder"():
L_ENTRY:
    status = call @sa3d_geometry_capsule_selftest()
    ok = eq status, 0
    br ok -> L_OK, L_ERR

L_OK:
    !status
    !ok
    return

L_ERR:
    !status
    !ok
    panic(3030)

