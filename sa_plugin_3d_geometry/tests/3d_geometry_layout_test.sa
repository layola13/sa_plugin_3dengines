    max_y = load max_vec+SA3D_VEC3_y as i32
    max_z = load max_vec+SA3D_VEC3_z as i32
    v0 = ptr_add vertices, 0
    v2 = ptr_add vertices, 64
    v0_pos = ptr_add v0, SA3D_VERTEX_P3N3UV2_position
    v0_normal = ptr_add v0, SA3D_VERTEX_P3N3UV2_normal
