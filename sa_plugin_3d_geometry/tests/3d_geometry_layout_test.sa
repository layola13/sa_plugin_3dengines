    d0u = load d0_uv+SA3D_VEC2_x as i32
    d0v = load d0_uv+SA3D_VEC2_y as i32
    d1u = load d1_uv+SA3D_VEC2_x as i32
    d2v = load d2_uv+SA3D_VEC2_y as i32
    wrote_ok = eq wrote, 1
    valid_ok = eq valid, 1
    range_ok = eq in_range, 1
    tri_ok = eq triangles, 1
