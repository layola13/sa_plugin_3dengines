    c15 = eq v0_py, 0
    c16 = eq v0_pz, 1073741824
    c17 = eq v0_nx, 0
    c18 = eq v2_px, 1082130432
    c19 = eq v2_py, -1073741824
    c20 = eq v2_pz, -1063256064
    c21 = eq v2_u, 0
    c22 = eq i0, 0
    c23 = eq i1, 1
    c24 = eq i2, 1
    c25 = eq i3, 2
    c26 = eq i4, 2
    c27 = eq i5, 3
