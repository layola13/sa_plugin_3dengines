    v2 = ptr_add vertices, 64
    v0_normal = ptr_add v0, SA3D_VERTEX_P3N3UV2_normal
    v0_uv = ptr_add v0, SA3D_VERTEX_P3N3UV2_uv
    v1_uv = ptr_add v1, SA3D_VERTEX_P3N3UV2_uv
    v2_uv = ptr_add v2, SA3D_VERTEX_P3N3UV2_uv
    nz = load v0_normal+SA3D_VEC3_z as f32
    au = load v0_uv+SA3D_VEC2_x as f32
    av = load v0_uv+SA3D_VEC2_y as i32
    bu = load v1_uv+SA3D_VEC2_x as i32
    bv = load v1_uv+SA3D_VEC2_y as i32
    cu = load v2_uv+SA3D_VEC2_x as i32
    cv = load v2_uv+SA3D_VEC2_y as i32
