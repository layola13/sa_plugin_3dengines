    store positions+24, 4.0 as f32
    store positions+28, -2.0 as f32
    store positions+32, -5.0 as f32
    store positions+36, 8.0 as f32
    store positions+40, 0.5 as f32
    store positions+44, 1.0 as f32
    wrote = call @sa3d_geometry_polyline_mesh_desc(&mesh, &vertices, &indices, &positions, 4)
    valid = call @sa3d_geometry_mesh_validate(&mesh)
