    v2_py = load v2_pos+SA3D_VEC3_y as i32
    v2_pz = load v2_pos+SA3D_VEC3_z as i32
    v2_u = load v2_uv+SA3D_VEC2_x as i32
    i0 = load indices+0 as u32
    i1 = load indices+4 as u32
    i2 = load indices+8 as u32
    i3 = load indices+12 as u32
    i4 = load indices+16 as u32
    i5 = load indices+20 as u32
    bad_short = call @sa3d_geometry_polyline_write(&vertices, &indices, &positions, 1)
    c0 = eq wrote, 1
    c1 = eq valid, 1
    c2 = eq in_range, 1
    c3 = eq draw, 6
    c4 = eq triangles, 0
    c5 = eq primitive, SA3D_PRIMITIVE_LINE_LIST
