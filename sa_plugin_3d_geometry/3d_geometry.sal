    call @sa3d_geometry_ico_write_vertex_from_point(&vertices, 1, radius, 0.89442719, 0.44721360, 0.0)
    call @sa3d_geometry_ico_write_vertex_from_point(&vertices, 2, radius, 0.27639320, 0.44721360, 0.85065081)
    call @sa3d_geometry_ico_write_vertex_from_point(&vertices, 3, radius, -0.72360680, 0.44721360, 0.52573111)
