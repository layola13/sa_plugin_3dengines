@sa3d_geometry_ico_write_slerp_point(&vertices: ptr, vertex_index: i64, radius: f32, ax: f32, ay: f32, az: f32, bx: f32, by: f32, bz: f32, percent: f32) -> void:
L_ENTRY:
    axbx = fmul ax, bx
    ayby = fmul ay, by
    azbz = fmul az, bz
    dot0 = fadd axbx, ayby
    dot = fadd dot0, azbz
    angle = call @sa3d_f32_acos(dot)
    sin_angle = call @sa3d_f32_sin(angle)
    inv = fdiv 1.0, sin_angle
    one_minus = fsub 1.0, percent
    a_angle = fmul one_minus, angle
    b_angle = fmul percent, angle
    a_sin = call @sa3d_f32_sin(a_angle)
    b_sin = call @sa3d_f32_sin(b_angle)
    wa = fmul a_sin, inv
    wb = fmul b_sin, inv
    axw = fmul ax, wa
    bxw = fmul bx, wb
    x = fadd axw, bxw
    ayw = fmul ay, wa
    byw = fmul by, wb
    y = fadd ayw, byw
    azw = fmul az, wa
    bzw = fmul bz, wb
    z = fadd azw, bzw
    call @sa3d_geometry_ico_write_vertex_from_point(&vertices, vertex_index, radius, x, y, z)
    !z
    !bzw
    !azw
    !y
    !byw
    !ayw
    !x
    !bxw
    !axw
    !wb
    !wa
    !b_sin
    !a_sin
    !b_angle
    !a_angle
    !one_minus
    !inv
    !sin_angle
    !angle
    !dot
    !dot0
    !azbz
    !ayby
    !axbx
    !percent
    !bz
    !by
    !bx
    !az
    !ay
    !ax
    !radius
    !vertex_index
    !vertices
    return

@sa3d_geometry_ico_write_edge_subdiv2(&vertices: ptr, edge_index: i64, radius: f32, ax: f32, ay: f32, az: f32, bx: f32, by: f32, bz: f32) -> void:
L_ENTRY:
    edge2 = mul edge_index, 2
    v0 = add edge2, 12
    v1 = add v0, 1
    call @sa3d_geometry_ico_write_slerp_point(&vertices, v0, radius, ax, ay, az, bx, by, bz, 0.33333334)
    call @sa3d_geometry_ico_write_slerp_point(&vertices, v1, radius, ax, ay, az, bx, by, bz, 0.66666667)
