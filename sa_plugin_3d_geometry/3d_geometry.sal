    call @sa3d_geometry_ico_write_vertex_from_point(&vertices, 10, radius, -0.27639320, -0.44721360, -0.85065081)
    call @sa3d_geometry_ico_write_vertex_from_point(&vertices, 11, radius, 0.0, -1.0, 0.0)
    store indices+0, 0 as u32
    store indices+4, 2 as u32
    store indices+8, 1 as u32
    store indices+12, 0 as u32
    store indices+16, 3 as u32
    store indices+20, 2 as u32
    store indices+24, 0 as u32
    store indices+28, 4 as u32
    store indices+32, 3 as u32
    store indices+36, 0 as u32
    store indices+40, 5 as u32
    store indices+44, 4 as u32
    store indices+48, 0 as u32
    store indices+52, 1 as u32
    store indices+56, 5 as u32
    store indices+60, 5 as u32
    store indices+64, 1 as u32
    store indices+68, 6 as u32
    store indices+72, 1 as u32
    store indices+76, 2 as u32
    store indices+80, 7 as u32
    store indices+84, 2 as u32
    store indices+88, 3 as u32
    store indices+92, 8 as u32
    store indices+96, 3 as u32
    store indices+100, 4 as u32
    store indices+104, 9 as u32
    store indices+108, 4 as u32
    store indices+112, 5 as u32
    store indices+116, 10 as u32
    store indices+120, 5 as u32
    store indices+124, 6 as u32
    store indices+128, 10 as u32
    store indices+132, 1 as u32
    store indices+136, 7 as u32
    store indices+140, 6 as u32
    store indices+144, 2 as u32
    store indices+148, 8 as u32
    store indices+152, 7 as u32
    store indices+156, 3 as u32
    store indices+160, 9 as u32
    store indices+164, 8 as u32
    store indices+168, 4 as u32
    store indices+172, 10 as u32
    store indices+176, 9 as u32
    store indices+180, 10 as u32
    store indices+184, 6 as u32
    store indices+188, 11 as u32
    store indices+192, 6 as u32
    store indices+196, 7 as u32
    store indices+200, 11 as u32
    store indices+204, 7 as u32
    store indices+208, 8 as u32
    store indices+212, 11 as u32
    store indices+216, 8 as u32
    store indices+220, 9 as u32
    store indices+224, 11 as u32
    store indices+228, 9 as u32
    store indices+232, 10 as u32
    store indices+236, 11 as u32
    !ok
    !finite
    !radius
    !indices
    !vertices
    return 1

L_FALSE:
