@sa3d_geometry_checked_cylinder_vertex_count(resolution: i64, segments: i64, caps: i32) -> i64:
L_ENTRY:
    valid_resolution = sgt resolution, 2
    valid_segments = sgt segments, 0
    valid = and valid_resolution, valid_segments
    br valid -> L_COUNT, L_ZERO

L_COUNT:
    rings = add segments, 1
    ring_vertices = add resolution, 1
    barrel = mul rings, ring_vertices
    has_caps = ne caps, 0
    br has_caps -> L_CAPS, L_NO_CAPS

L_CAPS:
    cap_vertices = mul resolution, 2
    out = add barrel, cap_vertices
    !cap_vertices
    !has_caps
    !barrel
    !ring_vertices
    !rings
    !valid
    !valid_segments
    !valid_resolution
    !caps
    !segments
    !resolution
    return out

L_NO_CAPS:
    !has_caps
    !ring_vertices
    !rings
    !valid
    !valid_segments
    !valid_resolution
    !caps
    !segments
    !resolution
    return barrel

L_ZERO:
    !valid
    !valid_segments
    !valid_resolution
    !caps
    !segments
    !resolution
    return 0

@sa3d_geometry_checked_cylinder_index_count(resolution: i64, segments: i64, caps: i32) -> i64:
L_ENTRY:
    valid_resolution = sgt resolution, 2
    valid_segments = sgt segments, 0
    valid = and valid_resolution, valid_segments
    br valid -> L_COUNT, L_ZERO

L_COUNT:
    barrel_faces = mul segments, resolution
    barrel = mul barrel_faces, 6
    has_caps = ne caps, 0
    br has_caps -> L_CAPS, L_NO_CAPS

L_CAPS:
    cap_base = sub resolution, 2
    cap_indices = mul cap_base, 6
    out = add barrel, cap_indices
    !cap_indices
    !cap_base
    !has_caps
    !barrel_faces
    !barrel
    !valid
    !valid_segments
    !valid_resolution
    !caps
    !segments
    !resolution
    return out

L_NO_CAPS:
    !has_caps
    !barrel_faces
    !valid
    !valid_segments
    !valid_resolution
    !caps
    !segments
    !resolution
    return barrel

L_ZERO:
    !valid
    !valid_segments
    !valid_resolution
    !caps
    !segments
    !resolution
    return 0

@sa3d_geometry_cylinder_write(&vertices: ptr, &indices: ptr, radius: f32, height: f32, resolution: i64, segments: i64, caps: i32, anchor: i32) -> i32:
L_ENTRY:
    radius_finite = call @sa3d_f32_is_finite(radius)
    height_finite = call @sa3d_f32_is_finite(height)
    finite_ok = and radius_finite, height_finite
    valid_resolution = sgt resolution, 2
    valid_segments = sgt segments, 0
    count_ok = and valid_resolution, valid_segments
    anchor_min_ok = sge anchor, SA3D_CYLINDER_ANCHOR_MIDPOINT
    anchor_max_ok = sle anchor, SA3D_CYLINDER_ANCHOR_BOTTOM
    anchor_ok = and anchor_min_ok, anchor_max_ok
    ok0 = and finite_ok, count_ok
    ok = and ok0, anchor_ok
    br ok -> L_INIT, L_FALSE

L_INIT:
    half_height = fdiv height, 2.0
    neg_half_height = fneg half_height
    resolution_f = sitofp resolution
    segments_f = sitofp segments
    step_theta = fdiv 6.28318531, resolution_f
    double_half = fadd half_height, half_height
    step_y = fdiv double_half, segments_f
    rings = add segments, 1
    ring_vertices = add resolution, 1
    barrel_vertex_count = mul rings, ring_vertices
    barrel_quad_count = mul segments, resolution
    barrel_index_count = mul barrel_quad_count, 6
    total_vertex_count = call @sa3d_geometry_cylinder_vertex_count(resolution, segments, caps)
    i_slot = stack_alloc 8
    index_slot = stack_alloc 8
    radius_slot = stack_alloc 4
    half_height_slot = stack_alloc 4
    neg_half_height_slot = stack_alloc 4
    resolution_slot = stack_alloc 8
    segments_slot = stack_alloc 8
    caps_slot = stack_alloc 4
    anchor_value_slot = stack_alloc 4
    anchor_offset_slot = stack_alloc 4
    resolution_f_slot = stack_alloc 4
    segments_f_slot = stack_alloc 4
    step_theta_slot = stack_alloc 4
    step_y_slot = stack_alloc 4
    ring_vertices_slot = stack_alloc 8
    barrel_vertex_count_slot = stack_alloc 8
    barrel_quad_count_slot = stack_alloc 8
    total_vertex_count_slot = stack_alloc 8
    store radius_slot+0, radius as f32
    store half_height_slot+0, half_height as f32
    store neg_half_height_slot+0, neg_half_height as f32
    store resolution_slot+0, resolution as i64
    store segments_slot+0, segments as i64
    store caps_slot+0, caps as i32
    store anchor_value_slot+0, anchor as i32
    store resolution_f_slot+0, resolution_f as f32
    store segments_f_slot+0, segments_f as f32
    store step_theta_slot+0, step_theta as f32
    store step_y_slot+0, step_y as f32
    store ring_vertices_slot+0, ring_vertices as i64
    store barrel_vertex_count_slot+0, barrel_vertex_count as i64
    store barrel_quad_count_slot+0, barrel_quad_count as i64
    store total_vertex_count_slot+0, total_vertex_count as i64
    store i_slot+0, 0 as i64
    store index_slot+0, barrel_index_count as i64
    !ok
    !ok0
    !anchor_ok
    !anchor_max_ok
    !anchor_min_ok
    !count_ok
    !valid_segments
    !valid_resolution
    !finite_ok
    !height_finite
    !radius_finite
    jmp L_RING_VERTEX_HEAD

L_RING_VERTEX_HEAD:
    i = load i_slot+0 as i64
    barrel_vertex_limit = load barrel_vertex_count_slot+0 as i64
    more = slt i, barrel_vertex_limit
    br more -> L_RING_VERTEX_BODY, L_BARREL_INDEX_INIT

L_RING_VERTEX_BODY:
    ring_vertices_loop = load ring_vertices_slot+0 as i64
    ring = sdiv i, ring_vertices_loop
    segment = srem i, ring_vertices_loop
    ring_f = sitofp ring
    segment_f = sitofp segment
    step_y_loop = load step_y_slot+0 as f32
    neg_half_loop = load neg_half_height_slot+0 as f32
    step_theta_loop = load step_theta_slot+0 as f32
    radius_loop = load radius_slot+0 as f32
    resolution_f_loop = load resolution_f_slot+0 as f32
    segments_f_loop = load segments_f_slot+0 as f32
    y_offset = fmul ring_f, step_y_loop
    y = fadd neg_half_loop, y_offset
    theta = fmul segment_f, step_theta_loop
    sin = call @sa3d_f32_sin(theta)
    cos = call @sa3d_f32_cos(theta)
    px = fmul radius_loop, cos
    pz = fmul radius_loop, sin
    u = fdiv segment_f, resolution_f_loop
    v = fdiv ring_f, segments_f_loop
    vertex_offset = mul i, SA3D_VERTEX_P3N3UV2_SIZE
    vertex = ptr_add vertices, vertex_offset
    call @sa3d_vertex_p3n3uv2_set_f(&vertex, px, y, pz, cos, 0.0, sin, u, v)
    next_i = add i, 1
    store i_slot+0, next_i as i64
    !next_i
    !vertex
    !vertex_offset
    !v
    !u
    !pz
    !px
    !cos
    !sin
    !theta
    !y
    !y_offset
    !segments_f_loop
    !resolution_f_loop
    !radius_loop
    !step_theta_loop
    !neg_half_loop
    !step_y_loop
    !segment_f
    !ring_f
    !segment
    !ring
    !ring_vertices_loop
    !barrel_vertex_limit
    !more
    !i
    jmp L_RING_VERTEX_HEAD

L_BARREL_INDEX_INIT:
    store i_slot+0, 0 as i64
    !barrel_vertex_limit
    !more
    !i
    jmp L_BARREL_INDEX_HEAD

L_BARREL_INDEX_HEAD:
    q = load i_slot+0 as i64
    barrel_quad_limit = load barrel_quad_count_slot+0 as i64
    q_more = slt q, barrel_quad_limit
    br q_more -> L_BARREL_INDEX_BODY, L_CAPS_CHECK

L_BARREL_INDEX_BODY:
    resolution_index = load resolution_slot+0 as i64
    ring_vertices_index = load ring_vertices_slot+0 as i64
    ring_i = sdiv q, resolution_index
    j = srem q, resolution_index
    ring_base = mul ring_i, ring_vertices_index
    next_ring_i = add ring_i, 1
    next_ring = mul next_ring_i, ring_vertices_index
    i0 = add ring_base, j
    i1 = add next_ring, j
    i2 = add i0, 1
    i4 = add i1, 1
    write_base0 = mul q, 6
    write_base = mul write_base0, 4
    index_ptr = ptr_add indices, write_base
    store index_ptr+0, i0 as u32
    store index_ptr+4, i1 as u32
    store index_ptr+8, i2 as u32
    store index_ptr+12, i1 as u32
    store index_ptr+16, i4 as u32
    store index_ptr+20, i2 as u32
    next_q = add q, 1
    store i_slot+0, next_q as i64
    !next_q
    !index_ptr
    !write_base
    !write_base0
    !i4
    !i2
    !i1
    !i0
    !next_ring
    !next_ring_i
    !ring_base
    !j
    !ring_i
    !ring_vertices_index
    !resolution_index
    !barrel_quad_limit
    !q_more
    !q
    jmp L_BARREL_INDEX_HEAD

L_CAPS_CHECK:
    caps_value = load caps_slot+0 as i32
    has_caps = ne caps_value, 0
    br has_caps -> L_TOP_VERTEX_INIT, L_NO_CAPS_TO_ANCHOR

L_NO_CAPS_TO_ANCHOR:
    !caps_value
    !has_caps
    !barrel_quad_limit
    !q_more
    !q
    jmp L_ANCHOR_CHECK

L_TOP_VERTEX_INIT:
    store i_slot+0, 0 as i64
    !caps_value
    !has_caps
    !barrel_quad_limit
    !q_more
    !q
    jmp L_TOP_VERTEX_HEAD

L_TOP_VERTEX_HEAD:
    cap_i = load i_slot+0 as i64
    resolution_top_limit = load resolution_slot+0 as i64
    cap_more = slt cap_i, resolution_top_limit
    br cap_more -> L_TOP_VERTEX_BODY, L_TOP_INDEX_INIT

L_TOP_VERTEX_BODY:
    cap_i_f = sitofp cap_i
    step_theta_top = load step_theta_slot+0 as f32
    theta_top = fmul cap_i_f, step_theta_top
    sin_top = call @sa3d_f32_sin(theta_top)
    cos_top = call @sa3d_f32_cos(theta_top)
    barrel_vertex_count_top = load barrel_vertex_count_slot+0 as i64
    radius_top = load radius_slot+0 as f32
    half_height_top = load half_height_slot+0 as f32
    top_index = add barrel_vertex_count_top, cap_i
    vertex_offset_top = mul top_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_top = ptr_add vertices, vertex_offset_top
    px_top = fmul cos_top, radius_top
    pz_top = fmul sin_top, radius_top
    cos_plus = fadd cos_top, 1.0
    sin_plus = fadd sin_top, 1.0
    u_top = fmul 0.5, cos_plus
    half_sin = fmul 0.5, sin_plus
    v_top = fsub 1.0, half_sin
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_top, px_top, half_height_top, pz_top, 0.0, 1.0, 0.0, u_top, v_top)
    next_cap_i = add cap_i, 1
    store i_slot+0, next_cap_i as i64
    !next_cap_i
    !v_top
    !half_sin
    !u_top
    !sin_plus
    !cos_plus
    !pz_top
    !px_top
    !vertex_top
    !vertex_offset_top
    !top_index
    !half_height_top
    !radius_top
    !barrel_vertex_count_top
    !cos_top
    !sin_top
    !theta_top
    !step_theta_top
    !cap_i_f
    !resolution_top_limit
    !cap_more
    !cap_i
    jmp L_TOP_VERTEX_HEAD

L_TOP_INDEX_INIT:
    store i_slot+0, 1 as i64
    !resolution_top_limit
    !cap_more
    !cap_i
    jmp L_TOP_INDEX_HEAD

L_TOP_INDEX_HEAD:
    top_i = load i_slot+0 as i64
    resolution_top_index = load resolution_slot+0 as i64
    top_limit = sub resolution_top_index, 1
    top_more = slt top_i, top_limit
    br top_more -> L_TOP_INDEX_BODY, L_BOTTOM_VERTEX_INIT

L_TOP_INDEX_BODY:
    index_i = load index_slot+0 as i64
    i_a = load barrel_vertex_count_slot+0 as i64
    barrel_vertex_count_top_b = load barrel_vertex_count_slot+0 as i64
    top_i_b = load i_slot+0 as i64
    top_b_base = add barrel_vertex_count_top_b, top_i_b
    i_b = add top_b_base, 1
    barrel_vertex_count_top_c = load barrel_vertex_count_slot+0 as i64
    top_i_c = load i_slot+0 as i64
    i_c = add barrel_vertex_count_top_c, top_i_c
    write_top = mul index_i, 4
    top_ptr = ptr_add indices, write_top
    store top_ptr+0, i_a as u32
    store top_ptr+4, i_b as u32
    store top_ptr+8, i_c as u32
    next_index_i = add index_i, 3
    next_top_i = add top_i, 1
    store index_slot+0, next_index_i as i64
    store i_slot+0, next_top_i as i64
    !next_top_i
    !next_index_i
    !top_ptr
    !write_top
    !i_c
    !i_b
    !top_b_base
    !barrel_vertex_count_top_c
    !top_i_c
    !barrel_vertex_count_top_b
    !top_i_b
    !i_a
    !index_i
    !resolution_top_index
    !top_more
    !top_limit
    !top_i
    jmp L_TOP_INDEX_HEAD

L_BOTTOM_VERTEX_INIT:
    store i_slot+0, 0 as i64
    !resolution_top_index
    !top_more
    !top_limit
    !top_i
    jmp L_BOTTOM_VERTEX_HEAD

L_BOTTOM_VERTEX_HEAD:
    bottom_i = load i_slot+0 as i64
    resolution_bottom_limit = load resolution_slot+0 as i64
    bottom_more = slt bottom_i, resolution_bottom_limit
    br bottom_more -> L_BOTTOM_VERTEX_BODY, L_BOTTOM_INDEX_INIT

L_BOTTOM_VERTEX_BODY:
    bottom_i_f = sitofp bottom_i
    step_theta_bottom = load step_theta_slot+0 as f32
    theta_bottom = fmul bottom_i_f, step_theta_bottom
    sin_bottom = call @sa3d_f32_sin(theta_bottom)
    cos_bottom = call @sa3d_f32_cos(theta_bottom)
    barrel_vertex_count_bottom = load barrel_vertex_count_slot+0 as i64
    resolution_bottom = load resolution_slot+0 as i64
    radius_bottom = load radius_slot+0 as f32
    neg_half_bottom = load neg_half_height_slot+0 as f32
    bottom_offset = add barrel_vertex_count_bottom, resolution_bottom
    bottom_index = add bottom_offset, bottom_i
    vertex_offset_bottom = mul bottom_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_bottom = ptr_add vertices, vertex_offset_bottom
    px_bottom = fmul cos_bottom, radius_bottom
    pz_bottom = fmul sin_bottom, radius_bottom
    cos_plus_bottom = fadd cos_bottom, 1.0
    sin_plus_bottom = fadd sin_bottom, 1.0
    u_bottom = fmul 0.5, cos_plus_bottom
    half_sin_bottom = fmul 0.5, sin_plus_bottom
    v_bottom = fsub 1.0, half_sin_bottom
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_bottom, px_bottom, neg_half_bottom, pz_bottom, 0.0, -1.0, 0.0, u_bottom, v_bottom)
    next_bottom_i = add bottom_i, 1
    store i_slot+0, next_bottom_i as i64
    !next_bottom_i
    !v_bottom
    !half_sin_bottom
    !u_bottom
    !sin_plus_bottom
    !cos_plus_bottom
    !pz_bottom
    !px_bottom
    !vertex_bottom
    !vertex_offset_bottom
    !bottom_index
    !bottom_offset
    !neg_half_bottom
    !radius_bottom
    !resolution_bottom
    !barrel_vertex_count_bottom
    !cos_bottom
    !sin_bottom
    !theta_bottom
    !step_theta_bottom
    !bottom_i_f
    !resolution_bottom_limit
    !bottom_more
    !bottom_i
    jmp L_BOTTOM_VERTEX_HEAD

L_BOTTOM_INDEX_INIT:
    store i_slot+0, 1 as i64
    !resolution_bottom_limit
    !bottom_more
    !bottom_i
    jmp L_BOTTOM_INDEX_HEAD

L_BOTTOM_INDEX_HEAD:
    bi = load i_slot+0 as i64
    resolution_bottom_index = load resolution_slot+0 as i64
    bottom_limit = sub resolution_bottom_index, 1
    bi_more = slt bi, bottom_limit
    br bi_more -> L_BOTTOM_INDEX_BODY, L_BOTTOM_DONE_TO_ANCHOR

L_BOTTOM_DONE_TO_ANCHOR:
    !resolution_bottom_index
    !bi_more
    !bottom_limit
    !bi
    jmp L_ANCHOR_CHECK

L_BOTTOM_INDEX_BODY:
    barrel_vertex_count_bottom_a = load barrel_vertex_count_slot+0 as i64
    resolution_bottom_a = load resolution_slot+0 as i64
    bottom_offset_a = add barrel_vertex_count_bottom_a, resolution_bottom_a
    index_i2 = load index_slot+0 as i64
    barrel_vertex_count_bottom_b = load barrel_vertex_count_slot+0 as i64
    resolution_bottom_b = load resolution_slot+0 as i64
    bottom_offset_b = add barrel_vertex_count_bottom_b, resolution_bottom_b
    bi_b = load i_slot+0 as i64
    b_b = add bottom_offset_b, bi_b
    barrel_vertex_count_bottom_c = load barrel_vertex_count_slot+0 as i64
    resolution_bottom_c = load resolution_slot+0 as i64
    bottom_offset_c = add barrel_vertex_count_bottom_c, resolution_bottom_c
    bi_c = load i_slot+0 as i64
    b_c_base = add bottom_offset_c, bi_c
    b_c = add b_c_base, 1
    write_bottom = mul index_i2, 4
    bottom_ptr = ptr_add indices, write_bottom
    store bottom_ptr+0, bottom_offset_a as u32
    store bottom_ptr+4, b_b as u32
    store bottom_ptr+8, b_c as u32
    next_index_i2 = add index_i2, 3
    next_bi = add bi, 1
    store index_slot+0, next_index_i2 as i64
    store i_slot+0, next_bi as i64
    !next_bi
    !next_index_i2
    !bottom_ptr
    !write_bottom
    !b_c
    !b_c_base
    !bi_c
    !bottom_offset_c
    !resolution_bottom_c
    !barrel_vertex_count_bottom_c
    !b_b
    !bi_b
    !bottom_offset_b
    !resolution_bottom_b
    !barrel_vertex_count_bottom_b
    !index_i2
    !bottom_offset_a
    !resolution_bottom_a
    !barrel_vertex_count_bottom_a
    !resolution_bottom_index
    !bi_more
    !bottom_limit
    !bi
    jmp L_BOTTOM_INDEX_HEAD

L_ANCHOR_CHECK:
    anchor_value = load anchor_value_slot+0 as i32
    is_top = eq anchor_value, SA3D_CYLINDER_ANCHOR_TOP
    br is_top -> L_ANCHOR_TOP, L_ANCHOR_BOTTOM_CHECK

L_ANCHOR_TOP:
    half_height_anchor_top = load half_height_slot+0 as f32
    offset_top = fneg half_height_anchor_top
    store anchor_offset_slot+0, offset_top as f32
    store i_slot+0, 0 as i64
    !offset_top
    !half_height_anchor_top
    !anchor_value
    !is_top
    jmp L_ANCHOR_VERTEX_HEAD

L_ANCHOR_BOTTOM_CHECK:
    anchor_value_bottom_check = load anchor_value_slot+0 as i32
    is_bottom = eq anchor_value_bottom_check, SA3D_CYLINDER_ANCHOR_BOTTOM
    br is_bottom -> L_ANCHOR_BOTTOM, L_NO_ANCHOR_DONE

L_NO_ANCHOR_DONE:
    !is_bottom
    !anchor_value_bottom_check
    !is_top
    !anchor_value
    jmp L_DONE

L_ANCHOR_BOTTOM:
    half_height_anchor_bottom = load half_height_slot+0 as f32
    store anchor_offset_slot+0, half_height_anchor_bottom as f32
    store i_slot+0, 0 as i64
    !half_height_anchor_bottom
    !anchor_value_bottom_check
    !is_bottom
    !anchor_value
    !is_top
    jmp L_ANCHOR_VERTEX_HEAD

L_ANCHOR_VERTEX_HEAD:
    av = load i_slot+0 as i64
    total_vertex_limit = load total_vertex_count_slot+0 as i64
    av_more = slt av, total_vertex_limit
    br av_more -> L_ANCHOR_VERTEX_BODY, L_ANCHOR_DONE

L_ANCHOR_VERTEX_BODY:
    anchor_offset = load anchor_offset_slot+0 as f32
    vertex_offset_anchor = mul av, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_anchor = ptr_add vertices, vertex_offset_anchor
    pos_anchor = ptr_add vertex_anchor, SA3D_VERTEX_P3N3UV2_position
    old_y = load pos_anchor+SA3D_VEC3_y as f32
    new_y = fadd old_y, anchor_offset
    store pos_anchor+SA3D_VEC3_y, new_y as f32
    next_av = add av, 1
    store i_slot+0, next_av as i64
    !next_av
    !new_y
    !old_y
    !pos_anchor
    !vertex_anchor
    !vertex_offset_anchor
    !anchor_offset
    !total_vertex_limit
    !av_more
    !av
    jmp L_ANCHOR_VERTEX_HEAD

L_ANCHOR_DONE:
    !total_vertex_limit
    !av_more
    !av
    jmp L_DONE

L_DONE:
    !total_vertex_count
    !barrel_index_count
    !barrel_quad_count
    !barrel_vertex_count
    !ring_vertices
    !rings
    !step_y
    !double_half
    !step_theta
    !segments_f
    !resolution_f
    !neg_half_height
    !half_height
    !anchor
    !caps
    !segments
    !resolution
    !height
    !radius
    !indices
    !vertices
    return 1

L_FALSE:
    !ok
    !ok0
    !anchor_ok
    !anchor_max_ok
    !anchor_min_ok
    !count_ok
    !valid_segments
    !valid_resolution
    !finite_ok
    !height_finite
    !radius_finite
    !anchor
    !caps
    !segments
    !resolution
    !height
    !radius
    !indices
    !vertices
    return 0

@sa3d_geometry_cylinder_mesh_desc(&mesh: ptr, &vertices: ptr, &indices: ptr, radius: f32, height: f32, resolution: i64, segments: i64, caps: i32, anchor: i32) -> i32:
L_ENTRY:
    vertex_count = call @sa3d_geometry_checked_cylinder_vertex_count(resolution, segments, caps)
    index_count = call @sa3d_geometry_checked_cylinder_index_count(resolution, segments, caps)
    has_vertices = sgt vertex_count, 0
    has_indices = sgt index_count, 0
    ok_counts = and has_vertices, has_indices
    br ok_counts -> L_WRITE, L_FALSE

L_WRITE:
    wrote = call @sa3d_geometry_cylinder_write(&vertices, &indices, radius, height, resolution, segments, caps, anchor)
    ok = ne wrote, 0
    br ok -> L_DESC, L_FALSE_WITH_WRITE

L_DESC:
    call @sa3d_mesh_desc_init(&mesh, &vertices, vertex_count, &indices, index_count, SA3D_INDEX_U32, SA3D_PRIMITIVE_TRIANGLE_LIST)
    !ok
    !wrote
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !anchor
    !caps
    !segments
    !resolution
    !height
    !radius
    !indices
    !vertices
    !mesh
    return 1

L_FALSE_WITH_WRITE:
    !ok
    !wrote
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !anchor
    !caps
    !segments
    !resolution
    !height
    !radius
    !indices
    !vertices
    !mesh
    return 0

L_FALSE:
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !anchor
    !caps
    !segments
    !resolution
    !height
    !radius
    !indices
    !vertices
    !mesh
    return 0

@sa3d_geometry_checked_cone_vertex_count(resolution: i64) -> i64:
L_ENTRY:
    valid = sgt resolution, 2
    br valid -> L_COUNT, L_ZERO

L_COUNT:
    doubled = mul resolution, 2
    out = add doubled, 1
    !doubled
    !valid
    !resolution
    return out

L_ZERO:
    !valid
    !resolution
    return 0

@sa3d_geometry_checked_cone_index_count(resolution: i64) -> i64:
L_ENTRY:
    valid = sgt resolution, 2
    br valid -> L_COUNT, L_ZERO

L_COUNT:
    doubled = mul resolution, 6
    out = sub doubled, 6
    !doubled
    !valid
    !resolution
    return out

L_ZERO:
    !valid
    !resolution
    return 0

@sa3d_geometry_cone_write(&vertices: ptr, &indices: ptr, radius: f32, height: f32, resolution: i64, anchor: i32) -> i32:
L_ENTRY:
    radius_finite = call @sa3d_f32_is_finite(radius)
    height_finite = call @sa3d_f32_is_finite(height)
    finite_ok = and radius_finite, height_finite
    valid_resolution = sgt resolution, 2
    anchor_min_ok = sge anchor, SA3D_CONE_ANCHOR_MIDPOINT
    anchor_max_ok = sle anchor, SA3D_CONE_ANCHOR_BASE
    anchor_ok = and anchor_min_ok, anchor_max_ok
    ok0 = and finite_ok, valid_resolution
    ok = and ok0, anchor_ok
    br ok -> L_INIT, L_FALSE

L_INIT:
    half_height = fdiv height, 2.0
    neg_half_height = fneg half_height
    resolution_f = sitofp resolution
    step_theta = fdiv 6.28318531, resolution_f
    normal_slope = fdiv radius, height
    normal_slope_sq = fmul normal_slope, normal_slope
    normal_len_sq = fadd 1.0, normal_slope_sq
    normal_len = call @sa3d_f32_sqrt(normal_len_sq)
    norm_factor = fdiv 1.0, normal_len
    vertex_count = call @sa3d_geometry_cone_vertex_count(resolution)
    i_slot = stack_alloc 8
    index_slot = stack_alloc 8
    radius_slot = stack_alloc 4
    half_height_slot = stack_alloc 4
    neg_half_height_slot = stack_alloc 4
    resolution_slot = stack_alloc 8
    anchor_slot = stack_alloc 4
    anchor_offset_slot = stack_alloc 4
    step_theta_slot = stack_alloc 4
    normal_slope_slot = stack_alloc 4
    norm_factor_slot = stack_alloc 4
    vertex_count_slot = stack_alloc 8
    store radius_slot+0, radius as f32
    store half_height_slot+0, half_height as f32
    store neg_half_height_slot+0, neg_half_height as f32
    store resolution_slot+0, resolution as i64
    store anchor_slot+0, anchor as i32
    store step_theta_slot+0, step_theta as f32
    store normal_slope_slot+0, normal_slope as f32
    store norm_factor_slot+0, norm_factor as f32
    store vertex_count_slot+0, vertex_count as i64
    tip = ptr_add vertices, 0
    call @sa3d_vertex_p3n3uv2_set_f(&tip, 0.0, half_height, 0.0, 0.0, 0.0, 0.0, 0.5, 0.5)
    store i_slot+0, 0 as i64
    !tip
    !vertex_count
    !norm_factor
    !normal_len
    !normal_len_sq
    !normal_slope_sq
    !ok
    !ok0
    !anchor_ok
    !anchor_max_ok
    !anchor_min_ok
    !valid_resolution
    !finite_ok
    !height_finite
    !radius_finite
    jmp L_SIDE_VERTEX_HEAD

L_SIDE_VERTEX_HEAD:
    i = load i_slot+0 as i64
    resolution_limit = load resolution_slot+0 as i64
    more = slt i, resolution_limit
    br more -> L_SIDE_VERTEX_BODY, L_SIDE_INDEX_INIT

L_SIDE_VERTEX_BODY:
    i_f = sitofp i
    step_theta_loop = load step_theta_slot+0 as f32
    radius_loop = load radius_slot+0 as f32
    neg_half_loop = load neg_half_height_slot+0 as f32
    normal_slope_loop = load normal_slope_slot+0 as f32
    norm_factor_loop = load norm_factor_slot+0 as f32
    theta = fmul i_f, step_theta_loop
    sin = call @sa3d_f32_sin(theta)
    cos = call @sa3d_f32_cos(theta)
    vertex_index = add i, 1
    vertex_offset = mul vertex_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex = ptr_add vertices, vertex_offset
    px = fmul radius_loop, cos
    pz = fmul radius_loop, sin
    nx = fmul cos, norm_factor_loop
    ny = fmul normal_slope_loop, norm_factor_loop
    nz = fmul sin, norm_factor_loop
    u_part = fmul cos, 0.5
    v_part = fmul sin, 0.5
    u = fadd 0.5, u_part
    v = fadd 0.5, v_part
    call @sa3d_vertex_p3n3uv2_set_f(&vertex, px, neg_half_loop, pz, nx, ny, nz, u, v)
    next_i = add i, 1
    store i_slot+0, next_i as i64
    !next_i
    !v
    !u
    !v_part
    !u_part
    !nz
    !ny
    !nx
    !pz
    !px
    !vertex
    !vertex_offset
    !vertex_index
    !cos
    !sin
    !theta
    !norm_factor_loop
    !normal_slope_loop
    !neg_half_loop
    !radius_loop
    !step_theta_loop
    !i_f
    !resolution_limit
    !more
    !i
    jmp L_SIDE_VERTEX_HEAD

L_SIDE_INDEX_INIT:
    store i_slot+0, 1 as i64
    store index_slot+0, 0 as i64
    !resolution_limit
    !more
    !i
    jmp L_SIDE_INDEX_HEAD

L_SIDE_INDEX_HEAD:
    j = load i_slot+0 as i64
    resolution_side_index = load resolution_slot+0 as i64
    side_more = slt j, resolution_side_index
    br side_more -> L_SIDE_INDEX_BODY, L_SIDE_CLOSE

L_SIDE_INDEX_BODY:
    index_i = load index_slot+0 as i64
    j_next = add j, 1
    write_side = mul index_i, 4
    side_ptr = ptr_add indices, write_side
    store side_ptr+0, 0 as u32
    store side_ptr+4, j_next as u32
    store side_ptr+8, j as u32
    next_index_i = add index_i, 3
    next_j = add j, 1
    store index_slot+0, next_index_i as i64
    store i_slot+0, next_j as i64
    !next_j
    !next_index_i
    !side_ptr
    !write_side
    !j_next
    !index_i
    !resolution_side_index
    !side_more
    !j
    jmp L_SIDE_INDEX_HEAD

L_SIDE_CLOSE:
    resolution_close = load resolution_slot+0 as i64
    index_i_close = load index_slot+0 as i64
    write_close = mul index_i_close, 4
    close_ptr = ptr_add indices, write_close
    store close_ptr+0, 0 as u32
    store close_ptr+4, 1 as u32
    store close_ptr+8, resolution_close as u32
    next_index_close = add index_i_close, 3
    store index_slot+0, next_index_close as i64
    store i_slot+0, 0 as i64
    !next_index_close
    !close_ptr
    !write_close
    !index_i_close
    !resolution_close
    !resolution_side_index
    !side_more
    !j
    jmp L_BASE_VERTEX_HEAD

L_BASE_VERTEX_HEAD:
    base_i = load i_slot+0 as i64
    resolution_base_limit = load resolution_slot+0 as i64
    base_more = slt base_i, resolution_base_limit
    br base_more -> L_BASE_VERTEX_BODY, L_BASE_INDEX_INIT

L_BASE_VERTEX_BODY:
    base_i_f = sitofp base_i
    step_theta_base = load step_theta_slot+0 as f32
    radius_base = load radius_slot+0 as f32
    neg_half_base = load neg_half_height_slot+0 as f32
    resolution_base = load resolution_slot+0 as i64
    theta_base = fmul base_i_f, step_theta_base
    sin_base = call @sa3d_f32_sin(theta_base)
    cos_base = call @sa3d_f32_cos(theta_base)
    base_offset = add resolution_base, 1
    vertex_index_base = add base_offset, base_i
    vertex_offset_base = mul vertex_index_base, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_base = ptr_add vertices, vertex_offset_base
    px_base = fmul cos_base, radius_base
    pz_base = fmul sin_base, radius_base
    cos_plus_base = fadd cos_base, 1.0
    sin_plus_base = fadd sin_base, 1.0
    u_base = fmul 0.5, cos_plus_base
    half_sin_base = fmul 0.5, sin_plus_base
    v_base = fsub 1.0, half_sin_base
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_base, px_base, neg_half_base, pz_base, 0.0, -1.0, 0.0, u_base, v_base)
    next_base_i = add base_i, 1
    store i_slot+0, next_base_i as i64
    !next_base_i
    !v_base
    !half_sin_base
    !u_base
    !sin_plus_base
    !cos_plus_base
    !pz_base
    !px_base
    !vertex_base
    !vertex_offset_base
    !vertex_index_base
    !base_offset
    !cos_base
    !sin_base
    !theta_base
    !resolution_base
    !neg_half_base
    !radius_base
    !step_theta_base
    !base_i_f
    !resolution_base_limit
    !base_more
    !base_i
    jmp L_BASE_VERTEX_HEAD

L_BASE_INDEX_INIT:
    store i_slot+0, 1 as i64
    !resolution_base_limit
    !base_more
    !base_i
    jmp L_BASE_INDEX_HEAD

L_BASE_INDEX_HEAD:
    base_index_i = load i_slot+0 as i64
    resolution_base_index = load resolution_slot+0 as i64
    base_index_limit = sub resolution_base_index, 1
    base_index_more = slt base_index_i, base_index_limit
    br base_index_more -> L_BASE_INDEX_BODY, L_ANCHOR_CHECK

L_BASE_INDEX_BODY:
    index_i_base = load index_slot+0 as i64
    resolution_base_a = load resolution_slot+0 as i64
    base_offset_a = add resolution_base_a, 1
    resolution_base_b = load resolution_slot+0 as i64
    base_offset_b = add resolution_base_b, 1
    base_index_b = load i_slot+0 as i64
    b1 = add base_offset_b, base_index_b
    resolution_base_c = load resolution_slot+0 as i64
    base_offset_c = add resolution_base_c, 1
    base_index_c = load i_slot+0 as i64
    b2_base = add base_offset_c, base_index_c
    b2 = add b2_base, 1
    write_base_index = mul index_i_base, 4
    base_index_ptr = ptr_add indices, write_base_index
    store base_index_ptr+0, base_offset_a as u32
    store base_index_ptr+4, b1 as u32
    store base_index_ptr+8, b2 as u32
    next_index_i_base = add index_i_base, 3
    next_base_index_i = add base_index_i, 1
    store index_slot+0, next_index_i_base as i64
    store i_slot+0, next_base_index_i as i64
    !next_base_index_i
    !next_index_i_base
    !base_index_ptr
    !write_base_index
    !b2
    !b2_base
    !base_index_c
    !base_offset_c
    !resolution_base_c
    !b1
    !base_index_b
    !base_offset_b
    !resolution_base_b
    !base_offset_a
    !resolution_base_a
    !index_i_base
    !resolution_base_index
    !base_index_more
    !base_index_limit
    !base_index_i
    jmp L_BASE_INDEX_HEAD

L_ANCHOR_CHECK:
    anchor_value = load anchor_slot+0 as i32
    is_tip = eq anchor_value, SA3D_CONE_ANCHOR_TIP
    br is_tip -> L_ANCHOR_TIP, L_ANCHOR_BASE_CHECK

L_ANCHOR_TIP:
    half_height_anchor_tip = load half_height_slot+0 as f32
    offset_tip = fneg half_height_anchor_tip
    store anchor_offset_slot+0, offset_tip as f32
    store i_slot+0, 0 as i64
    !offset_tip
    !half_height_anchor_tip
    !anchor_value
    !is_tip
    !resolution_base_index
    !base_index_more
    !base_index_limit
    !base_index_i
    jmp L_ANCHOR_VERTEX_HEAD

L_ANCHOR_BASE_CHECK:
    anchor_value_base_check = load anchor_slot+0 as i32
    is_base = eq anchor_value_base_check, SA3D_CONE_ANCHOR_BASE
    br is_base -> L_ANCHOR_BASE, L_NO_ANCHOR_DONE

L_NO_ANCHOR_DONE:
    !is_base
    !anchor_value_base_check
    !is_tip
    !anchor_value
    !resolution_base_index
    !base_index_more
    !base_index_limit
    !base_index_i
    jmp L_DONE

L_ANCHOR_BASE:
    half_height_anchor_base = load half_height_slot+0 as f32
    store anchor_offset_slot+0, half_height_anchor_base as f32
    store i_slot+0, 0 as i64
    !half_height_anchor_base
    !anchor_value_base_check
    !is_base
    !anchor_value
    !is_tip
    !resolution_base_index
    !base_index_more
    !base_index_limit
    !base_index_i
    jmp L_ANCHOR_VERTEX_HEAD

L_ANCHOR_VERTEX_HEAD:
    av = load i_slot+0 as i64
    vertex_limit = load vertex_count_slot+0 as i64
    av_more = slt av, vertex_limit
    br av_more -> L_ANCHOR_VERTEX_BODY, L_ANCHOR_DONE

L_ANCHOR_VERTEX_BODY:
    anchor_offset = load anchor_offset_slot+0 as f32
    vertex_offset_anchor = mul av, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_anchor = ptr_add vertices, vertex_offset_anchor
    pos_anchor = ptr_add vertex_anchor, SA3D_VERTEX_P3N3UV2_position
    old_y = load pos_anchor+SA3D_VEC3_y as f32
    new_y = fadd old_y, anchor_offset
    store pos_anchor+SA3D_VEC3_y, new_y as f32
    next_av = add av, 1
    store i_slot+0, next_av as i64
    !next_av
    !new_y
    !old_y
    !pos_anchor
    !vertex_anchor
    !vertex_offset_anchor
    !anchor_offset
    !vertex_limit
    !av_more
    !av
    jmp L_ANCHOR_VERTEX_HEAD

L_ANCHOR_DONE:
    !vertex_limit
    !av_more
    !av
    jmp L_DONE

L_DONE:
    !normal_slope
    !step_theta
    !resolution_f
    !neg_half_height
    !half_height
    !anchor
    !resolution
    !height
    !radius
    !indices
    !vertices
    return 1

L_FALSE:
    !ok
    !ok0
    !anchor_ok
    !anchor_max_ok
    !anchor_min_ok
    !valid_resolution
    !finite_ok
    !height_finite
    !radius_finite
    !anchor
    !resolution
    !height
    !radius
    !indices
    !vertices
    return 0

@sa3d_geometry_cone_mesh_desc(&mesh: ptr, &vertices: ptr, &indices: ptr, radius: f32, height: f32, resolution: i64, anchor: i32) -> i32:
L_ENTRY:
    vertex_count = call @sa3d_geometry_checked_cone_vertex_count(resolution)
    index_count = call @sa3d_geometry_checked_cone_index_count(resolution)
    has_vertices = sgt vertex_count, 0
    has_indices = sgt index_count, 0
    ok_counts = and has_vertices, has_indices
    br ok_counts -> L_WRITE, L_FALSE

L_WRITE:
    wrote = call @sa3d_geometry_cone_write(&vertices, &indices, radius, height, resolution, anchor)
    ok = ne wrote, 0
    br ok -> L_DESC, L_FALSE_WITH_WRITE

L_DESC:
    call @sa3d_mesh_desc_init(&mesh, &vertices, vertex_count, &indices, index_count, SA3D_INDEX_U32, SA3D_PRIMITIVE_TRIANGLE_LIST)
    !ok
    !wrote
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !anchor
    !resolution
    !height
    !radius
    !indices
    !vertices
    !mesh
    return 1

L_FALSE_WITH_WRITE:
    !ok
    !wrote
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !anchor
    !resolution
    !height
    !radius
    !indices
    !vertices
    !mesh
    return 0

L_FALSE:
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !anchor
    !resolution
    !height
    !radius
    !indices
    !vertices
    !mesh
    return 0

@sa3d_geometry_capsule_vt_ratio(&offsets: ptr, radius: f32, half_length: f32, latitudes: i64, uv_profile: i32) -> f32:
L_ENTRY:
    is_aspect = eq uv_profile, SA3D_CAPSULE_UV_PROFILE_ASPECT
    br is_aspect -> L_ASPECT, L_CHECK_UNIFORM

L_ASPECT:
    double_half = fadd half_length, half_length
    radius_a = fadd double_half, radius
    denom = fadd radius_a, radius
    ratio = fdiv radius, denom
    !denom
    !radius_a
    !double_half
    !is_aspect
    !uv_profile
    !latitudes
    !half_length
    !radius
    !offsets
    return ratio

L_CHECK_UNIFORM:
    is_uniform = eq uv_profile, SA3D_CAPSULE_UV_PROFILE_UNIFORM
    br is_uniform -> L_UNIFORM, L_FIXED

L_UNIFORM:
    half_lats = load offsets+SA3D_CAPSULE_OFF_half_lats as i64
    ringsp1 = load offsets+SA3D_CAPSULE_OFF_ringsp1 as i64
    denom_i = add ringsp1, latitudes
    half_lats_f = sitofp half_lats
    denom_f = sitofp denom_i
    ratio = fdiv half_lats_f, denom_f
    !denom_f
    !half_lats_f
    !denom_i
    !ringsp1
    !half_lats
    !is_uniform
    !is_aspect
    !uv_profile
    !latitudes
    !half_length
    !radius
    !offsets
    return ratio

L_FIXED:
    ratio = fdiv 1.0, 3.0
    !is_uniform
    !is_aspect
    !uv_profile
    !latitudes
    !half_length
    !radius
    !offsets
    return ratio

@sa3d_geometry_capsule_write_polar_vertices(&vertices: ptr, &offsets: ptr, radius: f32, half_length: f32, longitudes: i64, to_tex_horizontal: f32) -> void:
L_ENTRY:
    j_slot = stack_alloc 8
    summit = fadd half_length, radius
    neg_summit = fneg summit
    store j_slot+0, 0 as i64
    !neg_summit
    jmp L_HEAD

L_HEAD:
    j = load j_slot+0 as i64
    more = slt j, longitudes
    br more -> L_BODY, L_DONE

L_BODY:
    jf = sitofp j
    jf_half = fadd jf, 0.5
    s_mul = fmul jf_half, to_tex_horizontal
    s_texture = fsub 1.0, s_mul
    vertex_n_offset = mul j, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_n = ptr_add vertices, vertex_n_offset
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_n, 0.0, summit, 0.0, 0.0, 1.0, 0.0, s_texture, 1.0)
    south_cap = load offsets+SA3D_CAPSULE_OFF_south_cap as i64
    south_index = add south_cap, j
    vertex_s_offset = mul south_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_s = ptr_add vertices, vertex_s_offset
    neg_summit_body = fneg summit
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_s, 0.0, neg_summit_body, 0.0, 0.0, -1.0, 0.0, s_texture, 0.0)
    next_j = add j, 1
    store j_slot+0, next_j as i64
    !next_j
    !neg_summit_body
    !vertex_s
    !vertex_s_offset
    !south_index
    !south_cap
    !vertex_n
    !vertex_n_offset
    !s_texture
    !s_mul
    !jf_half
    !jf
    !more
    !j
    jmp L_HEAD

L_DONE:
    !more
    !j
    !summit
    !to_tex_horizontal
    !longitudes
    !half_length
    !radius
    !offsets
    !vertices
    return

@sa3d_geometry_capsule_write_equator_vertices(&vertices: ptr, &offsets: ptr, radius: f32, half_length: f32, longitudes: i64, to_theta: f32, to_tex_horizontal: f32, vt_north: f32, vt_south: f32) -> void:
L_ENTRY:
    j_slot = stack_alloc 8
    lonsp1 = load offsets+SA3D_CAPSULE_OFF_lonsp1 as i64
    north_equator = load offsets+SA3D_CAPSULE_OFF_north_equator as i64
    south_equator = load offsets+SA3D_CAPSULE_OFF_south_equator as i64
    neg_half_length = fneg half_length
    store j_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    j = load j_slot+0 as i64
    more = slt j, lonsp1
    br more -> L_BODY, L_DONE

L_BODY:
    jf = sitofp j
    s_mul = fmul jf, to_tex_horizontal
    s_texture = fsub 1.0, s_mul
    j_mod = srem j, longitudes
    jm_f = sitofp j_mod
    theta = fmul jm_f, to_theta
    tc_x = call @sa3d_f32_cos(theta)
    tc_y = call @sa3d_f32_sin(theta)
    rtc_x = fmul radius, tc_x
    rtc_y = fmul radius, tc_y
    neg_rtc_y = fneg rtc_y
    neg_tc_y = fneg tc_y
    north_index = add north_equator, j
    north_byte = mul north_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_n = ptr_add vertices, north_byte
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_n, rtc_x, half_length, neg_rtc_y, tc_x, 0.0, neg_tc_y, s_texture, vt_north)
    south_index = add south_equator, j
    south_byte = mul south_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_s = ptr_add vertices, south_byte
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_s, rtc_x, neg_half_length, neg_rtc_y, tc_x, 0.0, neg_tc_y, s_texture, vt_south)
    next_j = add j, 1
    store j_slot+0, next_j as i64
    !next_j
    !vertex_s
    !south_byte
    !south_index
    !vertex_n
    !north_byte
    !north_index
    !neg_tc_y
    !neg_rtc_y
    !rtc_y
    !rtc_x
    !tc_y
    !tc_x
    !theta
    !jm_f
    !j_mod
    !s_texture
    !s_mul
    !jf
    !more
    !j
    jmp L_HEAD

L_DONE:
    !more
    !j
    !neg_half_length
    !south_equator
    !north_equator
    !lonsp1
    !vt_south
    !vt_north
    !to_tex_horizontal
    !to_theta
    !longitudes
    !half_length
    !radius
    !offsets
    !vertices
    return

@sa3d_geometry_capsule_write_hemi_vertices(&vertices: ptr, &offsets: ptr, radius: f32, half_length: f32, longitudes: i64, latitudes: i64, to_theta: f32, to_tex_horizontal: f32, vt_north: f32, vt_south: f32) -> void:
L_ENTRY:
    n_slot = stack_alloc 8
    half_lats = load offsets+SA3D_CAPSULE_OFF_half_lats as i64
    half_latsn1 = load offsets+SA3D_CAPSULE_OFF_half_latsn1 as i64
    lonsp1 = load offsets+SA3D_CAPSULE_OFF_lonsp1 as i64
    north_hemi = load offsets+SA3D_CAPSULE_OFF_north_hemi as i64
    south_hemi = load offsets+SA3D_CAPSULE_OFF_south_hemi as i64
    total = mul half_latsn1, lonsp1
    pi = call @sa3d_f32_pi()
    lat_f = sitofp latitudes
    to_phi = fdiv pi, lat_f
    half_lats_f = sitofp half_lats
    to_tex_vertical = fdiv 1.0, half_lats_f
    neg_half_length = fneg half_length
    store n_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    n = load n_slot+0 as i64
    more = slt n, total
    br more -> L_BODY, L_DONE

L_BODY:
    i = sdiv n, lonsp1
    j = srem n, lonsp1
    ip1 = add i, 1
    ip1f = sitofp ip1
    phi = fmul ip1f, to_phi
    sin_phi_south = call @sa3d_f32_sin(phi)
    cos_phi_south = call @sa3d_f32_cos(phi)
    cos_phi_north = fadd sin_phi_south, 0.0
    sin_phi_north = fneg cos_phi_south
    rho_cos_phi_north = fmul radius, cos_phi_north
    rho_sin_phi_north = fmul radius, sin_phi_north
    z_offset_north = fsub half_length, rho_sin_phi_north
    rho_cos_phi_south = fmul radius, cos_phi_south
    rho_sin_phi_south = fmul radius, sin_phi_south
    z_offset_south = fsub neg_half_length, rho_sin_phi_south
    t_tex_fac = fmul ip1f, to_tex_vertical
    cmpl_tex_fac = fsub 1.0, t_tex_fac
    vt_north_mul = fmul vt_north, t_tex_fac
    t_tex_north = fadd cmpl_tex_fac, vt_north_mul
    t_tex_south = fmul cmpl_tex_fac, vt_south
    jf = sitofp j
    s_mul = fmul jf, to_tex_horizontal
    s_texture = fsub 1.0, s_mul
    j_mod = srem j, longitudes
    jm_f = sitofp j_mod
    theta = fmul jm_f, to_theta
    tc_x = call @sa3d_f32_cos(theta)
    tc_y = call @sa3d_f32_sin(theta)
    px_n = fmul rho_cos_phi_north, tc_x
    pz_n_base = fmul rho_cos_phi_north, tc_y
    pz_n = fneg pz_n_base
    nx_n = fmul cos_phi_north, tc_x
    ny_n = fneg sin_phi_north
    nz_n_base = fmul cos_phi_north, tc_y
    nz_n = fneg nz_n_base
    north_index = add north_hemi, n
    north_byte = mul north_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_n = ptr_add vertices, north_byte
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_n, px_n, z_offset_north, pz_n, nx_n, ny_n, nz_n, s_texture, t_tex_north)
    px_s = fmul rho_cos_phi_south, tc_x
    pz_s_base = fmul rho_cos_phi_south, tc_y
    pz_s = fneg pz_s_base
    nx_s = fmul cos_phi_south, tc_x
    ny_s = fneg sin_phi_south
    nz_s_base = fmul cos_phi_south, tc_y
    nz_s = fneg nz_s_base
    south_index = add south_hemi, n
    south_byte = mul south_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_s = ptr_add vertices, south_byte
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_s, px_s, z_offset_south, pz_s, nx_s, ny_s, nz_s, s_texture, t_tex_south)
    next_n = add n, 1
    store n_slot+0, next_n as i64
    !next_n
    !vertex_s
    !south_byte
    !south_index
    !nz_s
    !nz_s_base
    !ny_s
    !nx_s
    !pz_s
    !pz_s_base
    !px_s
    !vertex_n
    !north_byte
    !north_index
    !nz_n
    !nz_n_base
    !ny_n
    !nx_n
    !pz_n
    !pz_n_base
    !px_n
    !tc_y
    !tc_x
    !theta
    !jm_f
    !j_mod
    !s_texture
    !s_mul
    !jf
    !t_tex_south
    !t_tex_north
    !vt_north_mul
    !cmpl_tex_fac
    !t_tex_fac
    !z_offset_south
    !rho_sin_phi_south
    !rho_cos_phi_south
    !z_offset_north
    !rho_sin_phi_north
    !rho_cos_phi_north
    !sin_phi_north
    !cos_phi_north
    !cos_phi_south
    !sin_phi_south
    !phi
    !ip1f
    !ip1
    !j
    !i
    !more
    !n
    jmp L_HEAD

L_DONE:
    !more
    !n
    !neg_half_length
    !to_tex_vertical
    !half_lats_f
    !to_phi
    !lat_f
    !pi
    !total
    !south_hemi
    !north_hemi
    !lonsp1
    !half_latsn1
    !half_lats
    !vt_south
    !vt_north
    !to_tex_horizontal
    !to_theta
    !latitudes
    !longitudes
    !half_length
    !radius
    !offsets
    !vertices
    return

@sa3d_geometry_capsule_write_cylinder_vertices(&vertices: ptr, &offsets: ptr, radius: f32, half_length: f32, longitudes: i64, to_theta: f32, to_tex_horizontal: f32, vt_north: f32, vt_south: f32) -> void:
L_ENTRY:
    n_slot = stack_alloc 8
    ringsp1 = load offsets+SA3D_CAPSULE_OFF_ringsp1 as i64
    lonsp1 = load offsets+SA3D_CAPSULE_OFF_lonsp1 as i64
    cylinder = load offsets+SA3D_CAPSULE_OFF_cylinder as i64
    rows = sub ringsp1, 1
    total = mul rows, lonsp1
    ringsp1_f = sitofp ringsp1
    to_fac = fdiv 1.0, ringsp1_f
    double_half = fadd half_length, half_length
    store n_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    n = load n_slot+0 as i64
    more = slt n, total
    br more -> L_BODY, L_DONE

L_BODY:
    row = sdiv n, lonsp1
    j = srem n, lonsp1
    h = add row, 1
    h_f = sitofp h
    fac = fmul h_f, to_fac
    cmpl_fac = fsub 1.0, fac
    north_part = fmul cmpl_fac, vt_north
    south_part = fmul fac, vt_south
    t_texture = fadd north_part, south_part
    y_drop = fmul double_half, fac
    y = fsub half_length, y_drop
    jf = sitofp j
    s_mul = fmul jf, to_tex_horizontal
    s_texture = fsub 1.0, s_mul
    j_mod = srem j, longitudes
    jm_f = sitofp j_mod
    theta = fmul jm_f, to_theta
    tc_x = call @sa3d_f32_cos(theta)
    tc_y = call @sa3d_f32_sin(theta)
    px = fmul radius, tc_x
    pz_base = fmul radius, tc_y
    pz = fneg pz_base
    nz = fneg tc_y
    vertex_index = add cylinder, n
    vertex_byte = mul vertex_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex = ptr_add vertices, vertex_byte
    call @sa3d_vertex_p3n3uv2_set_f(&vertex, px, y, pz, tc_x, 0.0, nz, s_texture, t_texture)
    next_n = add n, 1
    store n_slot+0, next_n as i64
    !next_n
    !vertex
    !vertex_byte
    !vertex_index
    !nz
    !pz
    !pz_base
    !px
    !tc_y
    !tc_x
    !theta
    !jm_f
    !j_mod
    !s_texture
    !s_mul
    !jf
    !y
    !y_drop
    !t_texture
    !south_part
    !north_part
    !cmpl_fac
    !fac
    !h_f
    !h
    !j
    !row
    !more
    !n
    jmp L_HEAD

L_DONE:
    !more
    !n
    !double_half
    !to_fac
    !ringsp1_f
    !total
    !rows
    !cylinder
    !lonsp1
    !ringsp1
    !vt_south
    !vt_north
    !to_tex_horizontal
    !to_theta
    !longitudes
    !half_length
    !radius
    !offsets
    !vertices
    return

@sa3d_geometry_capsule_write_polar_indices(&indices: ptr, &offsets: ptr, longitudes: i64) -> void:
L_ENTRY:
    i_slot = stack_alloc 8
    north_hemi = load offsets+SA3D_CAPSULE_OFF_north_hemi as i64
    south_polar = load offsets+SA3D_CAPSULE_OFF_south_polar as i64
    south_cap = load offsets+SA3D_CAPSULE_OFF_south_cap as i64
    tri_south_cap = load offsets+SA3D_CAPSULE_OFF_tri_south_cap as i64
    store i_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    i = load i_slot+0 as i64
    more = slt i, longitudes
    br more -> L_BODY, L_DONE

L_BODY:
    k = mul i, 3
    north0 = add i, 0
    north1 = add north_hemi, i
    north2 = add north1, 1
    k_byte = mul k, 4
    north_ptr = ptr_add indices, k_byte
    store north_ptr+0, north0 as u32
    store north_ptr+4, north1 as u32
    store north_ptr+8, north2 as u32
    m = add tri_south_cap, k
    south0 = add south_cap, i
    south1_base = add south_polar, i
    south1 = add south1_base, 1
    south2 = add south_polar, i
    m_byte = mul m, 4
    south_ptr = ptr_add indices, m_byte
    store south_ptr+0, south0 as u32
    store south_ptr+4, south1 as u32
    store south_ptr+8, south2 as u32
    next_i = add i, 1
    store i_slot+0, next_i as i64
    !next_i
    !south_ptr
    !m_byte
    !south2
    !south1
    !south1_base
    !south0
    !m
    !north_ptr
    !k_byte
    !north2
    !north1
    !north0
    !k
    !more
    !i
    jmp L_HEAD

L_DONE:
    !more
    !i
    !tri_south_cap
    !south_cap
    !south_polar
    !north_hemi
    !longitudes
    !offsets
    !indices
    return

@sa3d_geometry_capsule_write_hemi_indices(&indices: ptr, &offsets: ptr, longitudes: i64) -> void:
L_ENTRY:
    n_slot = stack_alloc 8
    half_latsn1 = load offsets+SA3D_CAPSULE_OFF_half_latsn1 as i64
    lonsp1 = load offsets+SA3D_CAPSULE_OFF_lonsp1 as i64
    north_hemi = load offsets+SA3D_CAPSULE_OFF_north_hemi as i64
    south_equator = load offsets+SA3D_CAPSULE_OFF_south_equator as i64
    tri_north_hemi = load offsets+SA3D_CAPSULE_OFF_tri_north_hemi as i64
    tri_south_hemi = load offsets+SA3D_CAPSULE_OFF_tri_south_hemi as i64
    total = mul half_latsn1, longitudes
    store n_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    n = load n_slot+0 as i64
    more = slt n, total
    br more -> L_BODY, L_DONE

L_BODY:
    i = sdiv n, longitudes
    j = srem n, longitudes
    i_lonsp1 = mul i, lonsp1
    vert_curr_lat_north = add north_hemi, i_lonsp1
    vert_next_lat_north = add vert_curr_lat_north, lonsp1
    vert_curr_lat_south = add south_equator, i_lonsp1
    vert_next_lat_south = add vert_curr_lat_south, lonsp1
    north00 = add vert_curr_lat_north, j
    north01 = add vert_next_lat_north, j
    north11_base = add vert_next_lat_north, j
    north11 = add north11_base, 1
    north10_base = add vert_curr_lat_north, j
    north10 = add north10_base, 1
    south00 = add vert_curr_lat_south, j
    south01 = add vert_next_lat_south, j
    south11_base = add vert_next_lat_south, j
    south11 = add south11_base, 1
    south10_base = add vert_curr_lat_south, j
    south10 = add south10_base, 1
    n6 = mul n, 6
    k = add tri_north_hemi, n6
    m = add tri_south_hemi, n6
    k_byte = mul k, 4
    north_ptr = ptr_add indices, k_byte
    store north_ptr+0, north00 as u32
    store north_ptr+4, north11 as u32
    store north_ptr+8, north10 as u32
    store north_ptr+12, north00 as u32
    store north_ptr+16, north01 as u32
    store north_ptr+20, north11 as u32
    m_byte = mul m, 4
    south_ptr = ptr_add indices, m_byte
    store south_ptr+0, south00 as u32
    store south_ptr+4, south11 as u32
    store south_ptr+8, south10 as u32
    store south_ptr+12, south00 as u32
    store south_ptr+16, south01 as u32
    store south_ptr+20, south11 as u32
    next_n = add n, 1
    store n_slot+0, next_n as i64
    !next_n
    !south_ptr
    !m_byte
    !north_ptr
    !k_byte
    !m
    !k
    !n6
    !south10
    !south10_base
    !south11
    !south11_base
    !south01
    !south00
    !north10
    !north10_base
    !north11
    !north11_base
    !north01
    !north00
    !vert_next_lat_south
    !vert_curr_lat_south
    !vert_next_lat_north
    !vert_curr_lat_north
    !i_lonsp1
    !j
    !i
    !more
    !n
    jmp L_HEAD

L_DONE:
    !more
    !n
    !total
    !tri_south_hemi
    !tri_north_hemi
    !south_equator
    !north_hemi
    !lonsp1
    !half_latsn1
    !longitudes
    !offsets
    !indices
    return

@sa3d_geometry_capsule_write_cylinder_indices(&indices: ptr, &offsets: ptr, longitudes: i64) -> void:
L_ENTRY:
    n_slot = stack_alloc 8
    ringsp1 = load offsets+SA3D_CAPSULE_OFF_ringsp1 as i64
    lonsp1 = load offsets+SA3D_CAPSULE_OFF_lonsp1 as i64
    north_equator = load offsets+SA3D_CAPSULE_OFF_north_equator as i64
    tri_cylinder = load offsets+SA3D_CAPSULE_OFF_tri_cylinder as i64
    total = mul ringsp1, longitudes
    store n_slot+0, 0 as i64
    jmp L_HEAD

L_HEAD:
    n = load n_slot+0 as i64
    more = slt n, total
    br more -> L_BODY, L_DONE

L_BODY:
    i = sdiv n, longitudes
    j = srem n, longitudes
    i_lonsp1 = mul i, lonsp1
    vert_curr_lat = add north_equator, i_lonsp1
    vert_next_lat = add vert_curr_lat, lonsp1
    cy00 = add vert_curr_lat, j
    cy01 = add vert_next_lat, j
    cy11_base = add vert_next_lat, j
    cy11 = add cy11_base, 1
    cy10_base = add vert_curr_lat, j
    cy10 = add cy10_base, 1
    n6 = mul n, 6
    k = add tri_cylinder, n6
    k_byte = mul k, 4
    index_ptr = ptr_add indices, k_byte
    store index_ptr+0, cy00 as u32
    store index_ptr+4, cy11 as u32
    store index_ptr+8, cy10 as u32
    store index_ptr+12, cy00 as u32
    store index_ptr+16, cy01 as u32
    store index_ptr+20, cy11 as u32
    next_n = add n, 1
    store n_slot+0, next_n as i64
    !next_n
    !index_ptr
    !k_byte
    !k
    !n6
    !cy10
    !cy10_base
    !cy11
    !cy11_base
    !cy01
    !cy00
    !vert_next_lat
    !vert_curr_lat
    !i_lonsp1
    !j
    !i
    !more
    !n
    jmp L_HEAD

L_DONE:
    !more
    !n
    !total
    !tri_cylinder
    !north_equator
    !lonsp1
    !ringsp1
    !longitudes
    !offsets
    !indices
    return

@sa3d_geometry_capsule_write(&vertices: ptr, &indices: ptr, radius: f32, length: f32, longitudes: i64, latitudes: i64, rings: i64, uv_profile: i32) -> i32:
L_ENTRY:
    offsets = alloc SA3D_CAPSULE_OFF_SIZE
    radius_finite = call @sa3d_f32_is_finite(radius)
    length_finite = call @sa3d_f32_is_finite(length)
    finite_ok = and radius_finite, length_finite
    uv_min_ok = sge uv_profile, SA3D_CAPSULE_UV_PROFILE_ASPECT
    uv_max_ok = sle uv_profile, SA3D_CAPSULE_UV_PROFILE_FIXED
    uv_ok = and uv_min_ok, uv_max_ok
    ok0 = and finite_ok, uv_ok
    br ok0 -> L_OFFSETS, L_FALSE

L_OFFSETS:
    offset_ok = call @sa3d_geometry_capsule_offsets_init(&offsets, longitudes, latitudes, rings)
    has_offsets = ne offset_ok, 0
    br has_offsets -> L_FIT, L_FALSE_WITH_OFFSETS

L_FIT:
    vertex_count = load offsets+SA3D_CAPSULE_OFF_vertex_count as i64
    index_count = load offsets+SA3D_CAPSULE_OFF_index_count as i64
    vertex_fit = sle vertex_count, 4294967295
    index_fit = sle index_count, 4294967295
    fit_ok = and vertex_fit, index_fit
    br fit_ok -> L_WRITE, L_FALSE_WITH_COUNTS

L_WRITE:
    half_length = fdiv length, 2.0
    tau = call @sa3d_f32_tau()
    pi = call @sa3d_f32_pi()
    lon_f = sitofp longitudes
    lat_f = sitofp latitudes
    to_theta = fdiv tau, lon_f
    to_phi_unused = fdiv pi, lat_f
    to_tex_horizontal = fdiv 1.0, lon_f
    vt_ratio = call @sa3d_geometry_capsule_vt_ratio(&offsets, radius, half_length, latitudes, uv_profile)
    vt_north = fsub 1.0, vt_ratio
    vt_south = fadd vt_ratio, 0.0
    call @sa3d_geometry_capsule_write_polar_vertices(&vertices, &offsets, radius, half_length, longitudes, to_tex_horizontal)
    call @sa3d_geometry_capsule_write_equator_vertices(&vertices, &offsets, radius, half_length, longitudes, to_theta, to_tex_horizontal, vt_north, vt_south)
    call @sa3d_geometry_capsule_write_hemi_vertices(&vertices, &offsets, radius, half_length, longitudes, latitudes, to_theta, to_tex_horizontal, vt_north, vt_south)
    call @sa3d_geometry_capsule_write_cylinder_vertices(&vertices, &offsets, radius, half_length, longitudes, to_theta, to_tex_horizontal, vt_north, vt_south)
    call @sa3d_geometry_capsule_write_polar_indices(&indices, &offsets, longitudes)
    call @sa3d_geometry_capsule_write_hemi_indices(&indices, &offsets, longitudes)
    call @sa3d_geometry_capsule_write_cylinder_indices(&indices, &offsets, longitudes)
    !vt_south
    !vt_north
    !vt_ratio
    !to_tex_horizontal
    !to_phi_unused
    !to_theta
    !lat_f
    !lon_f
    !pi
    !tau
    !half_length
    !fit_ok
    !index_fit
    !vertex_fit
    !index_count
    !vertex_count
    !has_offsets
    !offset_ok
    !ok0
    !uv_ok
    !uv_max_ok
    !uv_min_ok
    !finite_ok
    !length_finite
    !radius_finite
    !offsets
    !uv_profile
    !rings
    !latitudes
    !longitudes
    !length
    !radius
    !indices
    !vertices
    return 1

L_FALSE_WITH_COUNTS:
    !fit_ok
    !index_fit
    !vertex_fit
    !index_count
    !vertex_count
    !has_offsets
    !offset_ok
    !ok0
    !uv_ok
    !uv_max_ok
    !uv_min_ok
    !finite_ok
    !length_finite
    !radius_finite
    !offsets
    !uv_profile
    !rings
    !latitudes
    !longitudes
    !length
    !radius
    !indices
    !vertices
    return 0

L_FALSE_WITH_OFFSETS:
    !has_offsets
    !offset_ok
    !ok0
    !uv_ok
    !uv_max_ok
    !uv_min_ok
    !finite_ok
    !length_finite
    !radius_finite
    !offsets
    !uv_profile
    !rings
    !latitudes
    !longitudes
    !length
    !radius
    !indices
    !vertices
    return 0

L_FALSE:
    !ok0
    !uv_ok
    !uv_max_ok
    !uv_min_ok
    !finite_ok
    !length_finite
    !radius_finite
    !offsets
    !uv_profile
    !rings
    !latitudes
    !longitudes
    !length
    !radius
    !indices
    !vertices
    return 0

@sa3d_geometry_capsule_mesh_desc(&mesh: ptr, &vertices: ptr, &indices: ptr, radius: f32, length: f32, longitudes: i64, latitudes: i64, rings: i64, uv_profile: i32) -> i32:
L_ENTRY:
    vertex_count = call @sa3d_geometry_capsule_vertex_count(longitudes, latitudes, rings)
    index_count = call @sa3d_geometry_capsule_index_count(longitudes, latitudes, rings)
    has_vertices = sgt vertex_count, 0
    has_indices = sgt index_count, 0
    counts_ok = and has_vertices, has_indices
    br counts_ok -> L_WRITE, L_FALSE

L_WRITE:
    wrote = call @sa3d_geometry_capsule_write(&vertices, &indices, radius, length, longitudes, latitudes, rings, uv_profile)
    ok = ne wrote, 0
    br ok -> L_DESC, L_FALSE_WITH_WRITE

L_DESC:
    call @sa3d_mesh_desc_init(&mesh, &vertices, vertex_count, &indices, index_count, SA3D_INDEX_U32, SA3D_PRIMITIVE_TRIANGLE_LIST)
    !ok
    !wrote
    !counts_ok
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !uv_profile
    !rings
    !latitudes
    !longitudes
    !length
    !radius
    !indices
    !vertices
    !mesh
    return 1

L_FALSE_WITH_WRITE:
    !ok
    !wrote
    !counts_ok
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !uv_profile
    !rings
    !latitudes
    !longitudes
    !length
    !radius
    !indices
    !vertices
    !mesh
    return 0

L_FALSE:
    !counts_ok
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !uv_profile
    !rings
    !latitudes
    !longitudes
    !length
    !radius
    !indices
    !vertices
    !mesh
    return 0

@sa3d_geometry_checked_torus_vertex_count(major_resolution: i64, minor_resolution: i64) -> i64:
L_ENTRY:
    valid_major = sgt major_resolution, 0
    valid_minor = sgt minor_resolution, 0
    valid = and valid_major, valid_minor
    br valid -> L_COUNT, L_ZERO

L_COUNT:
    majors = add major_resolution, 1
    minors = add minor_resolution, 1
    out = mul majors, minors
    !minors
    !majors
    !valid
    !valid_minor
    !valid_major
    !minor_resolution
    !major_resolution
    return out

L_ZERO:
    !valid
    !valid_minor
    !valid_major
    !minor_resolution
    !major_resolution
    return 0

@sa3d_geometry_checked_torus_index_count(major_resolution: i64, minor_resolution: i64) -> i64:
L_ENTRY:
    valid_major = sgt major_resolution, 0
    valid_minor = sgt minor_resolution, 0
    valid = and valid_major, valid_minor
    br valid -> L_COUNT, L_ZERO

L_COUNT:
    faces = mul major_resolution, minor_resolution
    out = mul faces, 6
    !faces
    !valid
    !valid_minor
    !valid_major
    !minor_resolution
    !major_resolution
    return out

L_ZERO:
    !valid
    !valid_minor
    !valid_major
    !minor_resolution
    !major_resolution
    return 0

@sa3d_geometry_torus_write(&vertices: ptr, &indices: ptr, inner_radius: f32, outer_radius: f32, major_resolution: i64, minor_resolution: i64, start_angle: f32, end_angle: f32) -> i32:
L_ENTRY:
    inner_finite = call @sa3d_f32_is_finite(inner_radius)
    outer_finite = call @sa3d_f32_is_finite(outer_radius)
    start_finite = call @sa3d_f32_is_finite(start_angle)
    end_finite = call @sa3d_f32_is_finite(end_angle)
    finite_a = and inner_finite, outer_finite
    finite_b = and start_finite, end_finite
    finite_ok = and finite_a, finite_b
    valid_major = sgt major_resolution, 0
    valid_minor = sgt minor_resolution, 0
    valid = and valid_major, valid_minor
    ok = and finite_ok, valid
    br ok -> L_INIT, L_FALSE

L_INIT:
    radius_diff = fsub outer_radius, inner_radius
    minor_radius = fdiv radius_diff, 2.0
    major_radius = fsub outer_radius, minor_radius
    angle_range = fsub end_angle, start_angle
    major_f = sitofp major_resolution
    minor_f = sitofp minor_resolution
    segment_stride = fdiv angle_range, major_f
    side_stride = fdiv 6.28318531, minor_f
    row_vertices = add minor_resolution, 1
    major_rows = add major_resolution, 1
    vertex_count = mul major_rows, row_vertices
    cell_count = mul major_resolution, minor_resolution
    i_slot = stack_alloc 8
    major_resolution_slot = stack_alloc 8
    minor_resolution_slot = stack_alloc 8
    row_vertices_slot = stack_alloc 8
    vertex_count_slot = stack_alloc 8
    cell_count_slot = stack_alloc 8
    major_f_slot = stack_alloc 4
    minor_f_slot = stack_alloc 4
    major_radius_slot = stack_alloc 4
    minor_radius_slot = stack_alloc 4
    start_angle_slot = stack_alloc 4
    segment_stride_slot = stack_alloc 4
    side_stride_slot = stack_alloc 4
    store major_resolution_slot+0, major_resolution as i64
    store minor_resolution_slot+0, minor_resolution as i64
    store row_vertices_slot+0, row_vertices as i64
    store vertex_count_slot+0, vertex_count as i64
    store cell_count_slot+0, cell_count as i64
    store major_f_slot+0, major_f as f32
    store minor_f_slot+0, minor_f as f32
    store major_radius_slot+0, major_radius as f32
    store minor_radius_slot+0, minor_radius as f32
    store start_angle_slot+0, start_angle as f32
    store segment_stride_slot+0, segment_stride as f32
    store side_stride_slot+0, side_stride as f32
    store i_slot+0, 0 as i64
    !cell_count
    !vertex_count
    !major_rows
    !row_vertices
    !side_stride
    !segment_stride
    !minor_f
    !major_f
    !angle_range
    !major_radius
    !minor_radius
    !radius_diff
    !ok
    !valid
    !valid_minor
    !valid_major
    !finite_ok
    !finite_b
    !finite_a
    !end_finite
    !start_finite
    !outer_finite
    !inner_finite
    jmp L_VERTEX_HEAD

L_VERTEX_HEAD:
    i = load i_slot+0 as i64
    vertex_limit = load vertex_count_slot+0 as i64
    more = slt i, vertex_limit
    br more -> L_VERTEX_BODY, L_INDEX_INIT

L_VERTEX_BODY:
    row_vertices_loop = load row_vertices_slot+0 as i64
    segment = sdiv i, row_vertices_loop
    side = srem i, row_vertices_loop
    segment_f = sitofp segment
    side_f = sitofp side
    start_loop = load start_angle_slot+0 as f32
    segment_stride_loop = load segment_stride_slot+0 as f32
    side_stride_loop = load side_stride_slot+0 as f32
    major_radius_loop = load major_radius_slot+0 as f32
    minor_radius_loop = load minor_radius_slot+0 as f32
    major_f_loop = load major_f_slot+0 as f32
    minor_f_loop = load minor_f_slot+0 as f32
    theta_mul = fmul segment_stride_loop, segment_f
    theta = fadd start_loop, theta_mul
    sin_theta = call @sa3d_f32_sin(theta)
    cos_theta = call @sa3d_f32_cos(theta)
    phi = fmul side_stride_loop, side_f
    sin_phi = call @sa3d_f32_sin(phi)
    cos_phi = call @sa3d_f32_cos(phi)
    minor_cos = fmul minor_radius_loop, cos_phi
    radius = fadd major_radius_loop, minor_cos
    px = fmul cos_theta, radius
    py = fmul minor_radius_loop, sin_phi
    pz = fmul sin_theta, radius
    cx = fmul major_radius_loop, cos_theta
    cz = fmul major_radius_loop, sin_theta
    nx_raw = fsub px, cx
    nz_raw = fsub pz, cz
    nx_sq = fmul nx_raw, nx_raw
    ny_sq = fmul py, py
    nz_sq = fmul nz_raw, nz_raw
    nxy = fadd nx_sq, ny_sq
    len_sq = fadd nxy, nz_sq
    len = call @sa3d_f32_sqrt(len_sq)
    inv_len = fdiv 1.0, len
    nx = fmul nx_raw, inv_len
    ny = fmul py, inv_len
    nz = fmul nz_raw, inv_len
    u = fdiv segment_f, major_f_loop
    v = fdiv side_f, minor_f_loop
    vertex_offset = mul i, SA3D_VERTEX_P3N3UV2_SIZE
    vertex = ptr_add vertices, vertex_offset
    call @sa3d_vertex_p3n3uv2_set_f(&vertex, px, py, pz, nx, ny, nz, u, v)
    next_i = add i, 1
    store i_slot+0, next_i as i64
    !next_i
    !vertex
    !vertex_offset
    !v
    !u
    !nz
    !ny
    !nx
    !inv_len
    !len
    !len_sq
    !nxy
    !nz_sq
    !ny_sq
    !nx_sq
    !nz_raw
    !nx_raw
    !cz
    !cx
    !pz
    !py
    !px
    !radius
    !minor_cos
    !cos_phi
    !sin_phi
    !phi
    !cos_theta
    !sin_theta
    !theta
    !theta_mul
    !minor_f_loop
    !major_f_loop
    !minor_radius_loop
    !major_radius_loop
    !side_stride_loop
    !segment_stride_loop
    !start_loop
    !side_f
    !segment_f
    !side
    !segment
    !row_vertices_loop
    !vertex_limit
    !more
    !i
    jmp L_VERTEX_HEAD

L_INDEX_INIT:
    store i_slot+0, 0 as i64
    !vertex_limit
    !more
    !i
    jmp L_INDEX_HEAD

L_INDEX_HEAD:
    q = load i_slot+0 as i64
    cell_limit = load cell_count_slot+0 as i64
    q_more = slt q, cell_limit
    br q_more -> L_INDEX_BODY, L_DONE

L_INDEX_BODY:
    minor_resolution_loop = load minor_resolution_slot+0 as i64
    row_vertices_index = load row_vertices_slot+0 as i64
    segment_i = sdiv q, minor_resolution_loop
    side_i = srem q, minor_resolution_loop
    segment_base = mul segment_i, row_vertices_index
    lt = add side_i, segment_base
    rt = add lt, 1
    next_segment = add segment_i, 1
    next_segment_base = mul next_segment, row_vertices_index
    lb = add side_i, next_segment_base
    rb = add lb, 1
    write_base0 = mul q, 6
    write_base = mul write_base0, 4
    index_ptr = ptr_add indices, write_base
    store index_ptr+0, lt as u32
    store index_ptr+4, rt as u32
    store index_ptr+8, lb as u32
    store index_ptr+12, rt as u32
    store index_ptr+16, rb as u32
    store index_ptr+20, lb as u32
    next_q = add q, 1
    store i_slot+0, next_q as i64
    !next_q
    !index_ptr
    !write_base
    !write_base0
    !rb
    !lb
    !next_segment_base
    !next_segment
    !rt
    !lt
    !segment_base
    !side_i
    !segment_i
    !row_vertices_index
    !minor_resolution_loop
    !cell_limit
    !q_more
    !q
    jmp L_INDEX_HEAD

L_DONE:
    !cell_limit
    !q_more
    !q
    !end_angle
    !start_angle
    !minor_resolution
    !major_resolution
    !outer_radius
    !inner_radius
    !indices
    !vertices
    return 1

L_FALSE:
    !ok
    !valid
    !valid_minor
    !valid_major
    !finite_ok
    !finite_b
    !finite_a
    !end_finite
    !start_finite
    !outer_finite
    !inner_finite
    !end_angle
    !start_angle
    !minor_resolution
    !major_resolution
    !outer_radius
    !inner_radius
    !indices
    !vertices
    return 0

@sa3d_geometry_torus_mesh_desc(&mesh: ptr, &vertices: ptr, &indices: ptr, inner_radius: f32, outer_radius: f32, major_resolution: i64, minor_resolution: i64, start_angle: f32, end_angle: f32) -> i32:
L_ENTRY:
    vertex_count = call @sa3d_geometry_checked_torus_vertex_count(major_resolution, minor_resolution)
    index_count = call @sa3d_geometry_checked_torus_index_count(major_resolution, minor_resolution)
    has_vertices = sgt vertex_count, 0
    has_indices = sgt index_count, 0
    ok_counts = and has_vertices, has_indices
    br ok_counts -> L_WRITE, L_FALSE

L_WRITE:
    wrote = call @sa3d_geometry_torus_write(&vertices, &indices, inner_radius, outer_radius, major_resolution, minor_resolution, start_angle, end_angle)
    ok = ne wrote, 0
    br ok -> L_DESC, L_FALSE_WITH_WRITE

L_DESC:
    call @sa3d_mesh_desc_init(&mesh, &vertices, vertex_count, &indices, index_count, SA3D_INDEX_U32, SA3D_PRIMITIVE_TRIANGLE_LIST)
    !ok
    !wrote
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !end_angle
    !start_angle
    !minor_resolution
    !major_resolution
    !outer_radius
    !inner_radius
    !indices
    !vertices
    !mesh
    return 1

L_FALSE_WITH_WRITE:
    !ok
    !wrote
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !end_angle
    !start_angle
    !minor_resolution
    !major_resolution
    !outer_radius
    !inner_radius
    !indices
    !vertices
    !mesh
    return 0

L_FALSE:
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !end_angle
    !start_angle
    !minor_resolution
    !major_resolution
    !outer_radius
    !inner_radius
    !indices
    !vertices
    !mesh
    return 0

@sa3d_geometry_checked_conical_frustum_vertex_count(resolution: i64, segments: i64) -> i64:
L_ENTRY:
    valid_resolution = sgt resolution, 2
    valid_segments = sgt segments, 0
    valid = and valid_resolution, valid_segments
    br valid -> L_COUNT, L_ZERO

L_COUNT:
    rings = add segments, 1
    resolution_p1 = add resolution, 1
    ring_vertices = mul rings, resolution_p1
    cap_vertices = mul resolution, 2
    out = add cap_vertices, ring_vertices
    !resolution_p1
    !ring_vertices
    !rings
    !cap_vertices
    !valid
    !valid_segments
    !valid_resolution
    !segments
    !resolution
    return out

L_ZERO:
    !valid
    !valid_segments
    !valid_resolution
    !segments
    !resolution
    return 0

@sa3d_geometry_checked_conical_frustum_index_count(resolution: i64, segments: i64) -> i64:
L_ENTRY:
    valid_resolution = sgt resolution, 2
    valid_segments = sgt segments, 0
    valid = and valid_resolution, valid_segments
    br valid -> L_COUNT, L_ZERO

L_COUNT:
    rings = add segments, 1
    rings_minus_2 = sub rings, 2
    num_faces = mul resolution, rings_minus_2
    lateral_faces = mul num_faces, 2
    res_minus_1 = sub resolution, 1
    cap_twice = mul res_minus_1, 4
    faces = add lateral_faces, cap_twice
    out = mul faces, 3
    !faces
    !cap_twice
    !res_minus_1
    !lateral_faces
    !num_faces
    !rings_minus_2
    !rings
    !valid
    !valid_segments
    !valid_resolution
    !segments
    !resolution
    return out

L_ZERO:
    !valid
    !valid_segments
    !valid_resolution
    !segments
    !resolution
    return 0

@sa3d_geometry_conical_frustum_write(&vertices: ptr, &indices: ptr, radius_top: f32, radius_bottom: f32, height: f32, resolution: i64, segments: i64) -> i32:
L_ENTRY:
    top_finite = call @sa3d_f32_is_finite(radius_top)
    bottom_finite = call @sa3d_f32_is_finite(radius_bottom)
    height_finite = call @sa3d_f32_is_finite(height)
    finite_pair = and top_finite, bottom_finite
    finite_ok = and finite_pair, height_finite
    valid_resolution = sgt resolution, 2
    valid_segments = sgt segments, 0
    valid = and valid_resolution, valid_segments
    ok = and finite_ok, valid
    br ok -> L_INIT, L_FALSE

L_INIT:
    half_height = fdiv height, 2.0
    neg_half_height = fneg half_height
    resolution_f = sitofp resolution
    segments_f = sitofp segments
    step_theta = fdiv 6.28318531, resolution_f
    step_y = fdiv height, segments_f
    radius_delta = fsub radius_top, radius_bottom
    step_radius = fdiv radius_delta, segments_f
    normal_y_raw = fsub radius_bottom, radius_top
    normal_y = fdiv normal_y_raw, height
    rings = add segments, 1
    ring_vertices = add resolution, 1
    barrel_vertex_count = mul rings, ring_vertices
    barrel_quad_count = mul segments, resolution
    barrel_index_count = mul barrel_quad_count, 6
    i_slot = stack_alloc 8
    index_slot = stack_alloc 8
    radius_top_slot = stack_alloc 4
    radius_bottom_slot = stack_alloc 4
    half_height_slot = stack_alloc 4
    neg_half_height_slot = stack_alloc 4
    resolution_slot = stack_alloc 8
    segments_slot = stack_alloc 8
    resolution_f_slot = stack_alloc 4
    segments_f_slot = stack_alloc 4
    step_theta_slot = stack_alloc 4
    step_y_slot = stack_alloc 4
    step_radius_slot = stack_alloc 4
    normal_y_slot = stack_alloc 4
    ring_vertices_slot = stack_alloc 8
    barrel_vertex_count_slot = stack_alloc 8
    barrel_quad_count_slot = stack_alloc 8
    store radius_top_slot+0, radius_top as f32
    store radius_bottom_slot+0, radius_bottom as f32
    store half_height_slot+0, half_height as f32
    store neg_half_height_slot+0, neg_half_height as f32
    store resolution_slot+0, resolution as i64
    store segments_slot+0, segments as i64
    store resolution_f_slot+0, resolution_f as f32
    store segments_f_slot+0, segments_f as f32
    store step_theta_slot+0, step_theta as f32
    store step_y_slot+0, step_y as f32
    store step_radius_slot+0, step_radius as f32
    store normal_y_slot+0, normal_y as f32
    store ring_vertices_slot+0, ring_vertices as i64
    store barrel_vertex_count_slot+0, barrel_vertex_count as i64
    store barrel_quad_count_slot+0, barrel_quad_count as i64
    store i_slot+0, 0 as i64
    store index_slot+0, barrel_index_count as i64
    !normal_y
    !normal_y_raw
    !radius_delta
    !ok
    !valid
    !valid_segments
    !valid_resolution
    !finite_ok
    !finite_pair
    !height_finite
    !bottom_finite
    !top_finite
    jmp L_RING_VERTEX_HEAD

L_RING_VERTEX_HEAD:
    i = load i_slot+0 as i64
    barrel_vertex_limit = load barrel_vertex_count_slot+0 as i64
    more = slt i, barrel_vertex_limit
    br more -> L_RING_VERTEX_BODY, L_BARREL_INDEX_INIT

L_RING_VERTEX_BODY:
    ring_vertices_loop = load ring_vertices_slot+0 as i64
    ring = sdiv i, ring_vertices_loop
    segment = srem i, ring_vertices_loop
    ring_f = sitofp ring
    segment_f = sitofp segment
    step_y_loop = load step_y_slot+0 as f32
    step_radius_loop = load step_radius_slot+0 as f32
    neg_half_loop = load neg_half_height_slot+0 as f32
    radius_bottom_loop = load radius_bottom_slot+0 as f32
    step_theta_loop = load step_theta_slot+0 as f32
    normal_y_loop = load normal_y_slot+0 as f32
    resolution_f_loop = load resolution_f_slot+0 as f32
    segments_f_loop = load segments_f_slot+0 as f32
    y_offset = fmul ring_f, step_y_loop
    y = fadd neg_half_loop, y_offset
    radius_offset = fmul ring_f, step_radius_loop
    ring_radius = fadd radius_bottom_loop, radius_offset
    theta = fmul segment_f, step_theta_loop
    sin = call @sa3d_f32_sin(theta)
    cos = call @sa3d_f32_cos(theta)
    cos_sq = fmul cos, cos
    sin_sq = fmul sin, sin
    ny_sq = fmul normal_y_loop, normal_y_loop
    nxy = fadd cos_sq, ny_sq
    len_sq = fadd nxy, sin_sq
    len = call @sa3d_f32_sqrt(len_sq)
    inv_len = fdiv 1.0, len
    nx = fmul cos, inv_len
    ny = fmul normal_y_loop, inv_len
    nz = fmul sin, inv_len
    px = fmul ring_radius, cos
    pz = fmul ring_radius, sin
    u = fdiv segment_f, resolution_f_loop
    v = fdiv ring_f, segments_f_loop
    vertex_offset = mul i, SA3D_VERTEX_P3N3UV2_SIZE
    vertex = ptr_add vertices, vertex_offset
    call @sa3d_vertex_p3n3uv2_set_f(&vertex, px, y, pz, nx, ny, nz, u, v)
    next_i = add i, 1
    store i_slot+0, next_i as i64
    !next_i
    !vertex
    !vertex_offset
    !v
    !u
    !pz
    !px
    !nz
    !ny
    !nx
    !inv_len
    !len
    !len_sq
    !nxy
    !ny_sq
    !sin_sq
    !cos_sq
    !cos
    !sin
    !theta
    !ring_radius
    !radius_offset
    !y
    !y_offset
    !segments_f_loop
    !resolution_f_loop
    !normal_y_loop
    !step_theta_loop
    !radius_bottom_loop
    !neg_half_loop
    !step_radius_loop
    !step_y_loop
    !segment_f
    !ring_f
    !segment
    !ring
    !ring_vertices_loop
    !barrel_vertex_limit
    !more
    !i
    jmp L_RING_VERTEX_HEAD

L_BARREL_INDEX_INIT:
    store i_slot+0, 0 as i64
    !barrel_vertex_limit
    !more
    !i
    jmp L_BARREL_INDEX_HEAD

L_BARREL_INDEX_HEAD:
    q = load i_slot+0 as i64
    barrel_quad_limit = load barrel_quad_count_slot+0 as i64
    q_more = slt q, barrel_quad_limit
    br q_more -> L_BARREL_INDEX_BODY, L_TOP_VERTEX_INIT

L_BARREL_INDEX_BODY:
    resolution_index = load resolution_slot+0 as i64
    ring_vertices_index = load ring_vertices_slot+0 as i64
    ring_i = sdiv q, resolution_index
    j = srem q, resolution_index
    ring_base = mul ring_i, ring_vertices_index
    next_ring_i = add ring_i, 1
    next_ring = mul next_ring_i, ring_vertices_index
    i0 = add ring_base, j
    i1 = add next_ring, j
    i2 = add i0, 1
    i4 = add i1, 1
    write_base0 = mul q, 6
    write_base = mul write_base0, 4
    index_ptr = ptr_add indices, write_base
    store index_ptr+0, i0 as u32
    store index_ptr+4, i1 as u32
    store index_ptr+8, i2 as u32
    store index_ptr+12, i1 as u32
    store index_ptr+16, i4 as u32
    store index_ptr+20, i2 as u32
    next_q = add q, 1
    store i_slot+0, next_q as i64
    !next_q
    !index_ptr
    !write_base
    !write_base0
    !i4
    !i2
    !i1
    !i0
    !next_ring
    !next_ring_i
    !ring_base
    !j
    !ring_i
    !ring_vertices_index
    !resolution_index
    !barrel_quad_limit
    !q_more
    !q
    jmp L_BARREL_INDEX_HEAD

L_TOP_VERTEX_INIT:
    store i_slot+0, 0 as i64
    !barrel_quad_limit
    !q_more
    !q
    jmp L_TOP_VERTEX_HEAD

L_TOP_VERTEX_HEAD:
    cap_i = load i_slot+0 as i64
    resolution_top_limit = load resolution_slot+0 as i64
    cap_more = slt cap_i, resolution_top_limit
    br cap_more -> L_TOP_VERTEX_BODY, L_TOP_INDEX_INIT

L_TOP_VERTEX_BODY:
    cap_i_f = sitofp cap_i
    step_theta_top = load step_theta_slot+0 as f32
    radius_top_loop = load radius_top_slot+0 as f32
    half_height_top = load half_height_slot+0 as f32
    barrel_vertex_count_top = load barrel_vertex_count_slot+0 as i64
    theta_top = fmul cap_i_f, step_theta_top
    sin_top = call @sa3d_f32_sin(theta_top)
    cos_top = call @sa3d_f32_cos(theta_top)
    top_index = add barrel_vertex_count_top, cap_i
    vertex_offset_top = mul top_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_top = ptr_add vertices, vertex_offset_top
    px_top = fmul cos_top, radius_top_loop
    pz_top = fmul sin_top, radius_top_loop
    cos_plus = fadd cos_top, 1.0
    sin_plus = fadd sin_top, 1.0
    u_top = fmul 0.5, cos_plus
    half_sin = fmul 0.5, sin_plus
    v_top = fsub 1.0, half_sin
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_top, px_top, half_height_top, pz_top, 0.0, 1.0, 0.0, u_top, v_top)
    next_cap_i = add cap_i, 1
    store i_slot+0, next_cap_i as i64
    !next_cap_i
    !v_top
    !half_sin
    !u_top
    !sin_plus
    !cos_plus
    !pz_top
    !px_top
    !vertex_top
    !vertex_offset_top
    !top_index
    !cos_top
    !sin_top
    !theta_top
    !barrel_vertex_count_top
    !half_height_top
    !radius_top_loop
    !step_theta_top
    !cap_i_f
    !resolution_top_limit
    !cap_more
    !cap_i
    jmp L_TOP_VERTEX_HEAD

L_TOP_INDEX_INIT:
    store i_slot+0, 1 as i64
    !resolution_top_limit
    !cap_more
    !cap_i
    jmp L_TOP_INDEX_HEAD

L_TOP_INDEX_HEAD:
    top_i = load i_slot+0 as i64
    resolution_top_index = load resolution_slot+0 as i64
    top_limit = sub resolution_top_index, 1
    top_more = slt top_i, top_limit
    br top_more -> L_TOP_INDEX_BODY, L_BOTTOM_VERTEX_INIT

L_TOP_INDEX_BODY:
    index_i = load index_slot+0 as i64
    i_a = load barrel_vertex_count_slot+0 as i64
    top_b_base0 = load barrel_vertex_count_slot+0 as i64
    top_i_b = load i_slot+0 as i64
    top_b_base = add top_b_base0, top_i_b
    i_b = add top_b_base, 1
    top_c_base0 = load barrel_vertex_count_slot+0 as i64
    top_i_c = load i_slot+0 as i64
    i_c = add top_c_base0, top_i_c
    write_top = mul index_i, 4
    top_ptr = ptr_add indices, write_top
    store top_ptr+0, i_a as u32
    store top_ptr+4, i_b as u32
    store top_ptr+8, i_c as u32
    next_index_i = add index_i, 3
    next_top_i = add top_i, 1
    store index_slot+0, next_index_i as i64
    store i_slot+0, next_top_i as i64
    !next_top_i
    !next_index_i
    !top_ptr
    !write_top
    !i_c
    !top_i_c
    !top_c_base0
    !i_b
    !top_b_base
    !top_i_b
    !top_b_base0
    !i_a
    !index_i
    !resolution_top_index
    !top_more
    !top_limit
    !top_i
    jmp L_TOP_INDEX_HEAD

L_BOTTOM_VERTEX_INIT:
    store i_slot+0, 0 as i64
    !resolution_top_index
    !top_more
    !top_limit
    !top_i
    jmp L_BOTTOM_VERTEX_HEAD

L_BOTTOM_VERTEX_HEAD:
    bottom_i = load i_slot+0 as i64
    resolution_bottom_limit = load resolution_slot+0 as i64
    bottom_more = slt bottom_i, resolution_bottom_limit
    br bottom_more -> L_BOTTOM_VERTEX_BODY, L_BOTTOM_INDEX_INIT

L_BOTTOM_VERTEX_BODY:
    bottom_i_f = sitofp bottom_i
    step_theta_bottom = load step_theta_slot+0 as f32
    radius_bottom_loop = load radius_bottom_slot+0 as f32
    neg_half_bottom = load neg_half_height_slot+0 as f32
    barrel_vertex_count_bottom = load barrel_vertex_count_slot+0 as i64
    resolution_bottom = load resolution_slot+0 as i64
    theta_bottom = fmul bottom_i_f, step_theta_bottom
    sin_bottom = call @sa3d_f32_sin(theta_bottom)
    cos_bottom = call @sa3d_f32_cos(theta_bottom)
    bottom_offset = add barrel_vertex_count_bottom, resolution_bottom
    bottom_index = add bottom_offset, bottom_i
    vertex_offset_bottom = mul bottom_index, SA3D_VERTEX_P3N3UV2_SIZE
    vertex_bottom = ptr_add vertices, vertex_offset_bottom
    px_bottom = fmul cos_bottom, radius_bottom_loop
    pz_bottom = fmul sin_bottom, radius_bottom_loop
    cos_plus_bottom = fadd cos_bottom, 1.0
    sin_plus_bottom = fadd sin_bottom, 1.0
    u_bottom = fmul 0.5, cos_plus_bottom
    half_sin_bottom = fmul 0.5, sin_plus_bottom
    v_bottom = fsub 1.0, half_sin_bottom
    call @sa3d_vertex_p3n3uv2_set_f(&vertex_bottom, px_bottom, neg_half_bottom, pz_bottom, 0.0, -1.0, 0.0, u_bottom, v_bottom)
    next_bottom_i = add bottom_i, 1
    store i_slot+0, next_bottom_i as i64
    !next_bottom_i
    !v_bottom
    !half_sin_bottom
    !u_bottom
    !sin_plus_bottom
    !cos_plus_bottom
    !pz_bottom
    !px_bottom
    !vertex_bottom
    !vertex_offset_bottom
    !bottom_index
    !bottom_offset
    !cos_bottom
    !sin_bottom
    !theta_bottom
    !resolution_bottom
    !barrel_vertex_count_bottom
    !neg_half_bottom
    !radius_bottom_loop
    !step_theta_bottom
    !bottom_i_f
    !resolution_bottom_limit
    !bottom_more
    !bottom_i
    jmp L_BOTTOM_VERTEX_HEAD

L_BOTTOM_INDEX_INIT:
    store i_slot+0, 1 as i64
    !resolution_bottom_limit
    !bottom_more
    !bottom_i
    jmp L_BOTTOM_INDEX_HEAD

L_BOTTOM_INDEX_HEAD:
    bi = load i_slot+0 as i64
    resolution_bottom_index = load resolution_slot+0 as i64
    bottom_limit = sub resolution_bottom_index, 1
    bi_more = slt bi, bottom_limit
    br bi_more -> L_BOTTOM_INDEX_BODY, L_DONE

L_BOTTOM_INDEX_BODY:
    index_i2 = load index_slot+0 as i64
    bottom_a0 = load barrel_vertex_count_slot+0 as i64
    bottom_a1 = load resolution_slot+0 as i64
    bottom_offset_a = add bottom_a0, bottom_a1
    bottom_b0 = load barrel_vertex_count_slot+0 as i64
    bottom_b1 = load resolution_slot+0 as i64
    bottom_offset_b = add bottom_b0, bottom_b1
    bi_b = load i_slot+0 as i64
    b_b = add bottom_offset_b, bi_b
    bottom_c0 = load barrel_vertex_count_slot+0 as i64
    bottom_c1 = load resolution_slot+0 as i64
    bottom_offset_c = add bottom_c0, bottom_c1
    bi_c = load i_slot+0 as i64
    b_c_base = add bottom_offset_c, bi_c
    b_c = add b_c_base, 1
    write_bottom = mul index_i2, 4
    bottom_ptr = ptr_add indices, write_bottom
    store bottom_ptr+0, bottom_offset_a as u32
    store bottom_ptr+4, b_b as u32
    store bottom_ptr+8, b_c as u32
    next_index_i2 = add index_i2, 3
    next_bi = add bi, 1
    store index_slot+0, next_index_i2 as i64
    store i_slot+0, next_bi as i64
    !next_bi
    !next_index_i2
    !bottom_ptr
    !write_bottom
    !b_c
    !b_c_base
    !bi_c
    !bottom_offset_c
    !bottom_c1
    !bottom_c0
    !b_b
    !bi_b
    !bottom_offset_b
    !bottom_b1
    !bottom_b0
    !bottom_offset_a
    !bottom_a1
    !bottom_a0
    !index_i2
    !resolution_bottom_index
    !bi_more
    !bottom_limit
    !bi
    jmp L_BOTTOM_INDEX_HEAD

L_DONE:
    !resolution_bottom_index
    !bi_more
    !bottom_limit
    !bi
    !barrel_index_count
    !barrel_quad_count
    !barrel_vertex_count
    !ring_vertices
    !rings
    !step_radius
    !step_y
    !step_theta
    !segments_f
    !resolution_f
    !neg_half_height
    !half_height
    !segments
    !resolution
    !height
    !radius_bottom
    !radius_top
    !indices
    !vertices
    return 1

L_FALSE:
    !ok
    !valid
    !valid_segments
    !valid_resolution
    !finite_ok
    !finite_pair
    !height_finite
    !bottom_finite
    !top_finite
    !segments
    !resolution
    !height
    !radius_bottom
    !radius_top
    !indices
    !vertices
    return 0

@sa3d_geometry_conical_frustum_mesh_desc(&mesh: ptr, &vertices: ptr, &indices: ptr, radius_top: f32, radius_bottom: f32, height: f32, resolution: i64, segments: i64) -> i32:
L_ENTRY:
    vertex_count = call @sa3d_geometry_checked_conical_frustum_vertex_count(resolution, segments)
    index_count = call @sa3d_geometry_checked_conical_frustum_index_count(resolution, segments)
    has_vertices = sgt vertex_count, 0
    has_indices = sgt index_count, 0
    ok_counts = and has_vertices, has_indices
    br ok_counts -> L_WRITE, L_FALSE

L_WRITE:
    wrote = call @sa3d_geometry_conical_frustum_write(&vertices, &indices, radius_top, radius_bottom, height, resolution, segments)
    ok = ne wrote, 0
    br ok -> L_DESC, L_FALSE_WITH_WRITE

L_DESC:
    call @sa3d_mesh_desc_init(&mesh, &vertices, vertex_count, &indices, index_count, SA3D_INDEX_U32, SA3D_PRIMITIVE_TRIANGLE_LIST)
    !ok
    !wrote
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !segments
    !resolution
    !height
    !radius_bottom
    !radius_top
    !indices
    !vertices
    !mesh
    return 1

L_FALSE_WITH_WRITE:
    !ok
    !wrote
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !segments
    !resolution
    !height
    !radius_bottom
    !radius_top
    !indices
    !vertices
    !mesh
    return 0

L_FALSE:
    !ok_counts
    !has_indices
    !has_vertices
    !index_count
    !vertex_count
    !segments
    !resolution
    !height
    !radius_bottom
    !radius_top
    !indices
    !vertices
    !mesh
    return 0

@sa3d_geometry_checked_polyline_index_count(vertex_len: i64) -> i64:
L_ENTRY:
    enough = sge vertex_len, 2
    br enough -> L_COUNT, L_ZERO

L_COUNT:
    segments = sub vertex_len, 1
    out = mul segments, 2
    !segments
    !enough
    !vertex_len
    return out

L_ZERO:
    !enough
    !vertex_len
    return 0
