@sa3d_geometry_ico_write_inner_midpoint(&vertices: ptr, vertex_index: i64, radius: f32, src_a: i64, src_b: i64) -> void:
L_ENTRY:
    a_offset = mul src_a, SA3D_VERTEX_P3N3UV2_SIZE
    b_offset = mul src_b, SA3D_VERTEX_P3N3UV2_SIZE
    a_vertex = ptr_add vertices, a_offset
    b_vertex = ptr_add vertices, b_offset
    a_normal = ptr_add a_vertex, SA3D_VERTEX_P3N3UV2_normal
    b_normal = ptr_add b_vertex, SA3D_VERTEX_P3N3UV2_normal
    ax = load a_normal+SA3D_VEC3_x as f32
    ay = load a_normal+SA3D_VEC3_y as f32
    az = load a_normal+SA3D_VEC3_z as f32
    bx = load b_normal+SA3D_VEC3_x as f32
    by = load b_normal+SA3D_VEC3_y as f32
    bz = load b_normal+SA3D_VEC3_z as f32
    sx = fadd ax, bx
    sy = fadd ay, by
    sz = fadd az, bz
    sx2 = fmul sx, sx
    sy2 = fmul sy, sy
    sz2 = fmul sz, sz
    sum0 = fadd sx2, sy2
    len2 = fadd sum0, sz2
    len = call @sa3d_f32_sqrt(len2)
    nx = fdiv sx, len
    ny = fdiv sy, len
    nz = fdiv sz, len
    call @sa3d_geometry_ico_write_vertex_from_point(&vertices, vertex_index, radius, nx, ny, nz)
    !nz
    !ny
    !nx
    !len
    !len2
    !sum0
    !sz2
    !sy2
    !sx2
    !sz
    !sy
    !sx
    !bz
    !by
    !bx
    !az
    !ay
    !ax
    !b_normal
    !a_normal
    !b_vertex
    !a_vertex
    !b_offset
    !a_offset
    !src_b
    !src_a
    !radius
    !vertex_index
    !vertices
    return

@sa3d_geometry_ico_write_subdiv2_triangle(&indices: ptr, tri_index: i64, a: i64, b: i64, c: i64, ab0: i64, ab1: i64, bc0: i64, bc1: i64, ca0: i64, ca1: i64, content: i64) -> void:
L_ENTRY:
    tri_base = mul tri_index, 27
    byte_base = mul tri_base, 4
    ptr = ptr_add indices, byte_base
    store ptr+0, a as u32
    store ptr+4, ab0 as u32
    store ptr+8, ca1 as u32
    store ptr+12, b as u32
    store ptr+16, bc0 as u32
    store ptr+20, ab1 as u32
    store ptr+24, c as u32
    store ptr+28, ca0 as u32
    store ptr+32, bc1 as u32
    store ptr+36, ab1 as u32
    store ptr+40, content as u32
    store ptr+44, ab0 as u32
    store ptr+48, bc1 as u32
    store ptr+52, content as u32
    store ptr+56, bc0 as u32
    store ptr+60, ca1 as u32
    store ptr+64, content as u32
    store ptr+68, ca0 as u32
    store ptr+72, ab0 as u32
    store ptr+76, content as u32
    store ptr+80, ca1 as u32
    store ptr+84, bc0 as u32
    store ptr+88, content as u32
    store ptr+92, ab1 as u32
    store ptr+96, ca0 as u32
    store ptr+100, content as u32
    store ptr+104, bc1 as u32
    !ptr
    !byte_base
    !tri_base
    !content
    !ca1
    !ca0
    !bc1
    !bc0
    !ab1
    !ab0
    !c
    !b
    !a
    !tri_index
    !indices
    return

