@sa3d_geometry_ico_write_edge_midpoint(&vertices: ptr, edge_index: i64, radius: f32, ax: f32, ay: f32, az: f32, bx: f32, by: f32, bz: f32) -> void:
L_ENTRY:
    sx = fadd ax, bx
    sy = fadd ay, by
    sz = fadd az, bz
    sx2 = fmul sx, sx
    sy2 = fmul sy, sy
    sz2 = fmul sz, sz
    sum0 = fadd sx2, sy2
    len2 = fadd sum0, sz2
    len = call @sa3d_f32_sqrt(len2)
    nx = fdiv sx, len
    ny = fdiv sy, len
    nz = fdiv sz, len
    vertex_index = add edge_index, 12
    call @sa3d_geometry_ico_write_vertex_from_point(&vertices, vertex_index, radius, nx, ny, nz)
    !vertex_index
    !nz
    !ny
    !nx
    !len
    !len2
    !sum0
    !sz2
    !sy2
    !sx2
    !sz
    !sy
    !sx
    !bz
    !by
    !bx
    !az
    !ay
    !ax
    !radius
    !edge_index
    !vertices
    return

@sa3d_geometry_ico_write_subdiv1_triangle(&indices: ptr, tri_index: i64, a: i64, b: i64, c: i64, ab_edge: i64, bc_edge: i64, ca_edge: i64) -> void:
L_ENTRY:
    tri_base = mul tri_index, 12
    ab = add ab_edge, 12
    bc = add bc_edge, 12
    ca = add ca_edge, 12
    byte_base = mul tri_base, 4
    ptr = ptr_add indices, byte_base
    store ptr+0, a as u32
    store ptr+4, ab as u32
    store ptr+8, ca as u32
    store ptr+12, b as u32
    store ptr+16, bc as u32
    store ptr+20, ab as u32
    store ptr+24, c as u32
    store ptr+28, ca as u32
    store ptr+32, bc as u32
    store ptr+36, ab as u32
    store ptr+40, bc as u32
    store ptr+44, ca as u32
    !ptr
    !byte_base
    !ca
    !bc
    !ab
    !tri_base
    !ca_edge
    !bc_edge
    !ab_edge
    !c
    !b
    !a
    !tri_index
    !indices
    return

