@sa3d_geometry_ico_sphere_write(&vertices: ptr, &indices: ptr, radius: f32, subdivisions: i64) -> i32:
L_ENTRY:
    is_zero = eq subdivisions, 0
    br is_zero -> L_ZERO, L_CHECK_ONE

L_ZERO:
    out = call @sa3d_geometry_ico_sphere_write_base(&vertices, &indices, radius)
    !is_zero
    !subdivisions
    !radius
    !indices
    !vertices
    return out

L_CHECK_ONE:
    is_one = eq subdivisions, 1
    br is_one -> L_ONE, L_CHECK_TWO

L_ONE:
    out = call @sa3d_geometry_ico_sphere_write_subdiv1(&vertices, &indices, radius)
    !is_one
    !is_zero
    !subdivisions
    !radius
    !indices
    !vertices
    return out

L_CHECK_TWO:
    is_two = eq subdivisions, 2
    br is_two -> L_TWO, L_CHECK_THREE

L_TWO:
    out = call @sa3d_geometry_ico_sphere_write_subdiv2(&vertices, &indices, radius)
    !is_two
    !is_one
    !is_zero
    !subdivisions
    !radius
    !indices
    !vertices
    return out

L_CHECK_THREE:
    is_three = eq subdivisions, 3
    br is_three -> L_THREE, L_NATIVE

L_THREE:
    out = call @sa3d_geometry_ico_sphere_write_subdiv3(&vertices, &indices, radius)
    !is_three
    !is_two
    !is_one
    !is_zero
    !subdivisions
    !radius
    !indices
    !vertices
    return out

L_NATIVE:
    out = call @sa3d_geometry_native_ico_sphere_write(vertices, indices, radius, subdivisions)
    !is_three
    !is_two
    !is_one
    !is_zero
    !subdivisions
    !radius
    !indices
    !vertices
    return out

