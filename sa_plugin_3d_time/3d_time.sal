#def SA3D_TIME_VERSION_MAJOR = 0
#def SA3D_TIME_VERSION_MINOR = 1

#def SA3D_TIME_CLOCK_REAL = 1
#def SA3D_TIME_CLOCK_MONOTONIC = 2
#def SA3D_TIME_CLOCK_FIXED = 3

#def SA3D_TIME_STEP_VARIABLE = 0
#def SA3D_TIME_STEP_FIXED = 1

#def SA3D_TIME_FRAME_now_ms = +0
#def SA3D_TIME_FRAME_delta_ms = +8
#def SA3D_TIME_FRAME_elapsed_ms = +16
#def SA3D_TIME_FRAME_frame_index = +24
#def SA3D_TIME_FRAME_step_mode = +32
#def SA3D_TIME_FRAME_alpha = +36
#def SA3D_TIME_FRAME_SIZE = 40

#def SA3D_TIMER_ONCE = 0
#def SA3D_TIMER_REPEATING = 1
#def SA3D_TIMER_once = 0
#def SA3D_TIMER_repeating = 1

#def SA3D_TIMER_STATE_duration_ms = +0
#def SA3D_TIMER_STATE_elapsed_ms = +8
#def SA3D_TIMER_STATE_mode = +16
#def SA3D_TIMER_STATE_finished = +20
#def SA3D_TIMER_STATE_times_finished_this_tick = +24
#def SA3D_TIMER_STATE_paused = +32
#def SA3D_TIMER_STATE_SIZE = 40

#def SA3D_FIXED_TIME_STATE_timestep_ms = +0
#def SA3D_FIXED_TIME_STATE_overstep_ms = +8
#def SA3D_FIXED_TIME_STATE_elapsed_ms = +16
#def SA3D_FIXED_TIME_STATE_step_index = +24
#def SA3D_FIXED_TIME_STATE_steps_last_frame = +32
#def SA3D_FIXED_TIME_STATE_alpha = +36
#def SA3D_FIXED_TIME_STATE_SIZE = 40

#def SA3D_TIME_NS_PER_SEC = 1000000000
#def SA3D_TIME_DEFAULT_WRAP_PERIOD_NS = 3600000000000
#def SA3D_FIXED_DEFAULT_TIMESTEP_NS = 15625000

#def SA3D_TIME_CLOCK_wrap_period_ns = +0
#def SA3D_TIME_CLOCK_delta_ns = +8
#def SA3D_TIME_CLOCK_elapsed_ns = +16
#def SA3D_TIME_CLOCK_elapsed_wrapped_ns = +24
#def SA3D_TIME_CLOCK_SIZE = 32

#def SA3D_TIMER_NATIVE_duration_ns = +0
#def SA3D_TIMER_NATIVE_elapsed_ns = +8
#def SA3D_TIMER_NATIVE_mode = +16
#def SA3D_TIMER_NATIVE_finished = +20
#def SA3D_TIMER_NATIVE_times_finished_this_tick = +24
#def SA3D_TIMER_NATIVE_paused = +28
#def SA3D_TIMER_NATIVE_SIZE = 32

#def SA3D_FIXED_TIME_NATIVE_timestep_ns = +0
#def SA3D_FIXED_TIME_NATIVE_overstep_ns = +8
#def SA3D_FIXED_TIME_NATIVE_delta_ns = +16
#def SA3D_FIXED_TIME_NATIVE_elapsed_ns = +24
#def SA3D_FIXED_TIME_NATIVE_step_index = +32
#def SA3D_FIXED_TIME_NATIVE_SIZE = 40

@sa3d_time_frame_reset(&frame: ptr) -> void:
L_ENTRY:
    store frame+SA3D_TIME_FRAME_now_ms, 0 as i64
    store frame+SA3D_TIME_FRAME_delta_ms, 0 as i64
    store frame+SA3D_TIME_FRAME_elapsed_ms, 0 as i64
    store frame+SA3D_TIME_FRAME_frame_index, 0 as i64
    store frame+SA3D_TIME_FRAME_step_mode, SA3D_TIME_STEP_VARIABLE as i32
    store frame+SA3D_TIME_FRAME_alpha, 0 as i32
    !frame
    return

@sa3d_time_frame_advance(&frame: ptr, delta_ms: i64, step_mode: i32) -> void:
L_ENTRY:
    now = load frame+SA3D_TIME_FRAME_now_ms as i64
    elapsed = load frame+SA3D_TIME_FRAME_elapsed_ms as i64
    frame_index = load frame+SA3D_TIME_FRAME_frame_index as i64
    next_now = add now, delta_ms
    next_elapsed = add elapsed, delta_ms
    next_frame = add frame_index, 1
    store frame+SA3D_TIME_FRAME_now_ms, next_now as i64
    store frame+SA3D_TIME_FRAME_delta_ms, delta_ms as i64
    store frame+SA3D_TIME_FRAME_elapsed_ms, next_elapsed as i64
    store frame+SA3D_TIME_FRAME_frame_index, next_frame as i64
    store frame+SA3D_TIME_FRAME_step_mode, step_mode as i32
    store frame+SA3D_TIME_FRAME_alpha, 0 as i32
    !now
    !elapsed
    !frame_index
    !next_now
    !next_elapsed
    !next_frame
    !delta_ms
    !step_mode
    !frame
    return

@sa3d_timer_init(&timer: ptr, duration_ms: i64, mode: i32) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_STATE_duration_ms, duration_ms as i64
    store timer+SA3D_TIMER_STATE_elapsed_ms, 0 as i64
    store timer+SA3D_TIMER_STATE_mode, mode as i32
    store timer+SA3D_TIMER_STATE_finished, 0 as i32
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, 0 as i64
    store timer+SA3D_TIMER_STATE_paused, 0 as i32
    !duration_ms
    !mode
    !timer
    return

@sa3d_timer_reset(&timer: ptr) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_STATE_elapsed_ms, 0 as i64
    store timer+SA3D_TIMER_STATE_finished, 0 as i32
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, 0 as i64
    !timer
    return

@sa3d_timer_pause(&timer: ptr) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_STATE_paused, 1 as i32
    !timer
    return

@sa3d_timer_unpause(&timer: ptr) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_STATE_paused, 0 as i32
    !timer
    return

@sa3d_timer_is_finished(&timer: ptr) -> i32:
L_ENTRY:
    finished = load timer+SA3D_TIMER_STATE_finished as i32
    !timer
    return finished

@sa3d_timer_just_finished(&timer: ptr) -> i32:
L_ENTRY:
    times = load timer+SA3D_TIMER_STATE_times_finished_this_tick as i64
    just = sgt times, 0
    !times
    !timer
    br just -> L_TRUE, L_FALSE

L_TRUE:
    !just
    return 1

L_FALSE:
    !just
    return 0

@sa3d_timer_tick(&timer: ptr, delta_ms: i64) -> i64:
L_ENTRY:
    paused = load timer+SA3D_TIMER_STATE_paused as i32
    is_paused = ne paused, 0
    br is_paused -> L_PAUSED, L_MODE

L_PAUSED:
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, 0 as i64
    mode_paused = load timer+SA3D_TIMER_STATE_mode as i32
    paused_repeating = eq mode_paused, SA3D_TIMER_REPEATING
    !paused
    !is_paused
    !mode_paused
    br paused_repeating -> L_PAUSED_REPEAT, L_PAUSED_DONE

L_PAUSED_REPEAT:
    store timer+SA3D_TIMER_STATE_finished, 0 as i32
    !paused_repeating
    !delta_ms
    !timer
    return 0

L_PAUSED_DONE:
    !paused_repeating
    !delta_ms
    !timer
    return 0

L_MODE:
    mode = load timer+SA3D_TIMER_STATE_mode as i32
    is_repeating = eq mode, SA3D_TIMER_REPEATING
    !paused
    !is_paused
    br is_repeating -> L_REPEAT_BEGIN, L_ONCE_CHECK

L_ONCE_CHECK:
    finished = load timer+SA3D_TIMER_STATE_finished as i32
    already_finished = ne finished, 0
    !mode
    !is_repeating
    br already_finished -> L_ONCE_DONE, L_ONCE_BEGIN

L_ONCE_DONE:
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, 0 as i64
    !finished
    !already_finished
    !delta_ms
    !timer
    return 0

L_ONCE_BEGIN:
    !finished
    !already_finished
    duration_once = load timer+SA3D_TIMER_STATE_duration_ms as i64
    duration_once_zero = sle duration_once, 0
    br duration_once_zero -> L_ONCE_ZERO, L_ONCE_TICK

L_ONCE_ZERO:
    store timer+SA3D_TIMER_STATE_elapsed_ms, 0 as i64
    store timer+SA3D_TIMER_STATE_finished, 1 as i32
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, 1 as i64
    !duration_once
    !duration_once_zero
    !delta_ms
    !timer
    return 1

L_ONCE_TICK:
    elapsed_once = load timer+SA3D_TIMER_STATE_elapsed_ms as i64
    next_once = add elapsed_once, delta_ms
    once_reached = sge next_once, duration_once
    !duration_once_zero
    br once_reached -> L_ONCE_FINISH, L_ONCE_PROGRESS

L_ONCE_FINISH:
    store timer+SA3D_TIMER_STATE_elapsed_ms, duration_once as i64
    store timer+SA3D_TIMER_STATE_finished, 1 as i32
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, 1 as i64
    !elapsed_once
    !next_once
    !once_reached
    !duration_once
    !delta_ms
    !timer
    return 1

L_ONCE_PROGRESS:
    store timer+SA3D_TIMER_STATE_elapsed_ms, next_once as i64
    store timer+SA3D_TIMER_STATE_finished, 0 as i32
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, 0 as i64
    !elapsed_once
    !next_once
    !once_reached
    !duration_once
    !delta_ms
    !timer
    return 0

L_REPEAT_BEGIN:
    !mode
    !is_repeating
    duration_repeat = load timer+SA3D_TIMER_STATE_duration_ms as i64
    duration_repeat_zero = sle duration_repeat, 0
    br duration_repeat_zero -> L_REPEAT_ZERO, L_REPEAT_TICK

L_REPEAT_ZERO:
    store timer+SA3D_TIMER_STATE_elapsed_ms, 0 as i64
    store timer+SA3D_TIMER_STATE_finished, 1 as i32
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, 1 as i64
    !duration_repeat
    !duration_repeat_zero
    !delta_ms
    !timer
    return 1

L_REPEAT_TICK:
    elapsed_repeat = load timer+SA3D_TIMER_STATE_elapsed_ms as i64
    next_repeat = add elapsed_repeat, delta_ms
    repeat_reached = sge next_repeat, duration_repeat
    !duration_repeat_zero
    br repeat_reached -> L_REPEAT_FINISH, L_REPEAT_PROGRESS

L_REPEAT_FINISH:
    repeat_times = sdiv next_repeat, duration_repeat
    repeat_remaining = srem next_repeat, duration_repeat
    store timer+SA3D_TIMER_STATE_elapsed_ms, repeat_remaining as i64
    store timer+SA3D_TIMER_STATE_finished, 1 as i32
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, repeat_times as i64
    !elapsed_repeat
    !next_repeat
    !repeat_reached
    !repeat_remaining
    !duration_repeat
    !delta_ms
    !timer
    return repeat_times

L_REPEAT_PROGRESS:
    store timer+SA3D_TIMER_STATE_elapsed_ms, next_repeat as i64
    store timer+SA3D_TIMER_STATE_finished, 0 as i32
    store timer+SA3D_TIMER_STATE_times_finished_this_tick, 0 as i64
    !elapsed_repeat
    !next_repeat
    !repeat_reached
    !duration_repeat
    !delta_ms
    !timer
    return 0

@sa3d_fixed_time_init(&fixed: ptr, timestep_ms: i64) -> void:
L_ENTRY:
    invalid = sle timestep_ms, 0
    br invalid -> L_DEFAULT, L_USE_INPUT

L_DEFAULT:
    store fixed+SA3D_FIXED_TIME_STATE_timestep_ms, 16 as i64
    store fixed+SA3D_FIXED_TIME_STATE_overstep_ms, 0 as i64
    store fixed+SA3D_FIXED_TIME_STATE_elapsed_ms, 0 as i64
    store fixed+SA3D_FIXED_TIME_STATE_step_index, 0 as i64
    store fixed+SA3D_FIXED_TIME_STATE_steps_last_frame, 0 as i32
    store fixed+SA3D_FIXED_TIME_STATE_alpha, 0 as i32
    !invalid
    !timestep_ms
    !fixed
    return

L_USE_INPUT:
    store fixed+SA3D_FIXED_TIME_STATE_timestep_ms, timestep_ms as i64
    store fixed+SA3D_FIXED_TIME_STATE_overstep_ms, 0 as i64
    store fixed+SA3D_FIXED_TIME_STATE_elapsed_ms, 0 as i64
    store fixed+SA3D_FIXED_TIME_STATE_step_index, 0 as i64
    store fixed+SA3D_FIXED_TIME_STATE_steps_last_frame, 0 as i32
    store fixed+SA3D_FIXED_TIME_STATE_alpha, 0 as i32
    !invalid
    !timestep_ms
    !fixed
    return

@sa3d_fixed_time_set_timestep(&fixed: ptr, timestep_ms: i64) -> void:
L_ENTRY:
    invalid = sle timestep_ms, 0
    br invalid -> L_KEEP, L_SET

L_KEEP:
    !invalid
    !timestep_ms
    !fixed
    return

L_SET:
    store fixed+SA3D_FIXED_TIME_STATE_timestep_ms, timestep_ms as i64
    !invalid
    !timestep_ms
    !fixed
    return

@sa3d_fixed_time_alpha_per_mille(&fixed: ptr) -> i32:
L_ENTRY:
    overstep = load fixed+SA3D_FIXED_TIME_STATE_overstep_ms as i64
    timestep = load fixed+SA3D_FIXED_TIME_STATE_timestep_ms as i64
    invalid = sle timestep, 0
    br invalid -> L_ZERO, L_CALC

L_ZERO:
    !invalid
    !timestep
    !overstep
    !fixed
    return 0

L_CALC:
    scaled = mul overstep, 1000
    alpha64 = sdiv scaled, timestep
    alpha = trunc alpha64 as i32
    !alpha64
    !scaled
    !invalid
    !timestep
    !overstep
    !fixed
    return alpha

@sa3d_fixed_time_accumulate(&fixed: ptr, delta_ms: i64) -> i32:
L_ENTRY:
    overstep = load fixed+SA3D_FIXED_TIME_STATE_overstep_ms as i64
    timestep = load fixed+SA3D_FIXED_TIME_STATE_timestep_ms as i64
    next_overstep = add overstep, delta_ms
    invalid = sle timestep, 0
    br invalid -> L_NO_STEPS, L_STEPS

L_NO_STEPS:
    store fixed+SA3D_FIXED_TIME_STATE_overstep_ms, next_overstep as i64
    store fixed+SA3D_FIXED_TIME_STATE_steps_last_frame, 0 as i32
    store fixed+SA3D_FIXED_TIME_STATE_alpha, 0 as i32
    !invalid
    !next_overstep
    !timestep
    !overstep
    !delta_ms
    !fixed
    return 0

L_STEPS:
    steps64 = sdiv next_overstep, timestep
    remaining = srem next_overstep, timestep
    steps = trunc steps64 as i32
    store fixed+SA3D_FIXED_TIME_STATE_overstep_ms, remaining as i64
    store fixed+SA3D_FIXED_TIME_STATE_steps_last_frame, steps as i32
    steps_return = load fixed+SA3D_FIXED_TIME_STATE_steps_last_frame as i32
    alpha = call @sa3d_fixed_time_alpha_per_mille(&fixed)
    store fixed+SA3D_FIXED_TIME_STATE_alpha, alpha as i32
    !alpha
    !steps
    !remaining
    !steps64
    !invalid
    !next_overstep
    !timestep
    !overstep
    !delta_ms
    !fixed
    return steps_return

@sa3d_fixed_time_consume_step(&fixed: ptr) -> i32:
L_ENTRY:
    steps = load fixed+SA3D_FIXED_TIME_STATE_steps_last_frame as i32
    has_step = sgt steps, 0
    br has_step -> L_CONSUME, L_EMPTY

L_CONSUME:
    timestep = load fixed+SA3D_FIXED_TIME_STATE_timestep_ms as i64
    elapsed = load fixed+SA3D_FIXED_TIME_STATE_elapsed_ms as i64
    step_index = load fixed+SA3D_FIXED_TIME_STATE_step_index as i64
    next_elapsed = add elapsed, timestep
    next_index = add step_index, 1
    next_steps = sub steps, 1
    store fixed+SA3D_FIXED_TIME_STATE_elapsed_ms, next_elapsed as i64
    store fixed+SA3D_FIXED_TIME_STATE_step_index, next_index as i64
    store fixed+SA3D_FIXED_TIME_STATE_steps_last_frame, next_steps as i32
    !next_steps
    !next_index
    !next_elapsed
    !step_index
    !elapsed
    !timestep
    !has_step
    !steps
    !fixed
    return 1

L_EMPTY:
    !has_step
    !steps
    !fixed
    return 0

@sa3d_time_clock_init_sa(&clock: ptr) -> void:
L_ENTRY:
    store clock+SA3D_TIME_CLOCK_wrap_period_ns, SA3D_TIME_DEFAULT_WRAP_PERIOD_NS as i64
    store clock+SA3D_TIME_CLOCK_delta_ns, 0 as i64
    store clock+SA3D_TIME_CLOCK_elapsed_ns, 0 as i64
    store clock+SA3D_TIME_CLOCK_elapsed_wrapped_ns, 0 as i64
    !clock
    return

@sa3d_time_clock_set_wrap_period_sa(&clock: ptr, wrap_period_ns: i64) -> i32:
L_ENTRY:
    invalid = sle wrap_period_ns, 0
    br invalid -> L_ERR, L_SET

L_ERR:
    !invalid
    !wrap_period_ns
    !clock
    return 1

L_SET:
    store clock+SA3D_TIME_CLOCK_wrap_period_ns, wrap_period_ns as i64
    !invalid
    !wrap_period_ns
    !clock
    return 0

@sa3d_time_clock_advance_by_sa(&clock: ptr, delta_ns: i64) -> void:
L_ENTRY:
    elapsed = load clock+SA3D_TIME_CLOCK_elapsed_ns as i64
    wrap = load clock+SA3D_TIME_CLOCK_wrap_period_ns as i64
    next = add elapsed, delta_ns
    wrapped = srem next, wrap
    store clock+SA3D_TIME_CLOCK_delta_ns, delta_ns as i64
    store clock+SA3D_TIME_CLOCK_elapsed_ns, next as i64
    store clock+SA3D_TIME_CLOCK_elapsed_wrapped_ns, wrapped as i64
    !wrapped
    !next
    !wrap
    !elapsed
    !delta_ns
    !clock
    return

@sa3d_time_clock_advance_to_sa(&clock: ptr, elapsed_ns: i64) -> i32:
L_ENTRY:
    current = load clock+SA3D_TIME_CLOCK_elapsed_ns as i64
    backwards = slt elapsed_ns, current
    br backwards -> L_ERR, L_ADVANCE

L_ERR:
    !backwards
    !current
    !elapsed_ns
    !clock
    return 1

L_ADVANCE:
    delta = sub elapsed_ns, current
    call @sa3d_time_clock_advance_by_sa(&clock, delta)
    !delta
    !backwards
    !current
    !elapsed_ns
    !clock
    return 0

@sa3d_timer_native_init_sa(&timer: ptr, duration_ns: i64, mode: i32) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_NATIVE_duration_ns, duration_ns as i64
    store timer+SA3D_TIMER_NATIVE_elapsed_ns, 0 as i64
    store timer+SA3D_TIMER_NATIVE_mode, mode as i32
    store timer+SA3D_TIMER_NATIVE_finished, 0 as i32
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, 0 as i32
    store timer+SA3D_TIMER_NATIVE_paused, 0 as i32
    !duration_ns
    !mode
    !timer
    return

@sa3d_timer_native_pause_sa(&timer: ptr) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_NATIVE_paused, 1 as i32
    !timer
    return

@sa3d_timer_native_unpause_sa(&timer: ptr) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_NATIVE_paused, 0 as i32
    !timer
    return

@sa3d_timer_native_reset_sa(&timer: ptr) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_NATIVE_elapsed_ns, 0 as i64
    store timer+SA3D_TIMER_NATIVE_finished, 0 as i32
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, 0 as i32
    !timer
    return

@sa3d_timer_native_duration_sa(&timer: ptr) -> i64:
L_ENTRY:
    duration = load timer+SA3D_TIMER_NATIVE_duration_ns as i64
    !timer
    return duration

@sa3d_timer_native_set_duration_sa(&timer: ptr, duration_ns: i64) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_NATIVE_duration_ns, duration_ns as i64
    !duration_ns
    !timer
    return

@sa3d_timer_native_elapsed_sa(&timer: ptr) -> i64:
L_ENTRY:
    elapsed = load timer+SA3D_TIMER_NATIVE_elapsed_ns as i64
    !timer
    return elapsed

@sa3d_timer_native_set_elapsed_sa(&timer: ptr, elapsed_ns: i64) -> void:
L_ENTRY:
    store timer+SA3D_TIMER_NATIVE_elapsed_ns, elapsed_ns as i64
    !elapsed_ns
    !timer
    return

@sa3d_timer_native_remaining_sa(&timer: ptr) -> i64:
L_ENTRY:
    duration = load timer+SA3D_TIMER_NATIVE_duration_ns as i64
    elapsed = load timer+SA3D_TIMER_NATIVE_elapsed_ns as i64
    remaining = sub duration, elapsed
    !elapsed
    !duration
    !timer
    return remaining

@sa3d_timer_native_fraction_sa(&timer: ptr) -> f32:
L_ENTRY:
    duration = load timer+SA3D_TIMER_NATIVE_duration_ns as i64
    zero = eq duration, 0
    br zero -> L_ONE, L_DIV

L_ONE:
    !zero
    !duration
    !timer
    return 1.0

L_DIV:
    elapsed = load timer+SA3D_TIMER_NATIVE_elapsed_ns as i64
    elapsed_slot = stack_alloc 8
    duration_slot = stack_alloc 8
    store elapsed_slot+0, elapsed as i64
    store duration_slot+0, duration as i64
    jmp L_SCALE_CHECK

L_SCALE_CHECK:
    d_cur = load duration_slot+0 as i64
    too_large = sgt d_cur, 1000000000
    br too_large -> L_SCALE, L_TO_FLOAT

L_SCALE:
    e_cur = load elapsed_slot+0 as i64
    e_scaled = sdiv e_cur, 1000
    d_scaled = sdiv d_cur, 1000
    store elapsed_slot+0, e_scaled as i64
    store duration_slot+0, d_scaled as i64
    !d_scaled
    !e_scaled
    !e_cur
    !too_large
    !d_cur
    jmp L_SCALE_CHECK

L_TO_FLOAT:
    elapsed_small = load elapsed_slot+0 as i64
    duration_small = load duration_slot+0 as i64
    elapsed_f = sitofp elapsed_small
    duration_f = sitofp duration_small
    out = fdiv elapsed_f, duration_f
    !duration_f
    !elapsed_f
    !duration_small
    !elapsed_small
    !too_large
    !d_cur
    !elapsed
    !zero
    !duration
    !timer
    return out

@sa3d_timer_native_fraction_remaining_sa(&timer: ptr) -> f32:
L_ENTRY:
    fraction = call @sa3d_timer_native_fraction_sa(&timer)
    out = fsub 1.0, fraction
    !fraction
    !timer
    return out

@sa3d_timer_native_finish_sa(&timer: ptr) -> void:
L_ENTRY:
    remaining = call @sa3d_timer_native_remaining_sa(&timer)
    call @sa3d_timer_native_tick_sa(&timer, remaining)
    !remaining
    !timer
    return

@sa3d_timer_native_almost_finish_sa(&timer: ptr) -> void:
L_ENTRY:
    remaining = call @sa3d_timer_native_remaining_sa(&timer)
    delta = sub remaining, 1
    call @sa3d_timer_native_tick_sa(&timer, delta)
    !delta
    !remaining
    !timer
    return

@sa3d_timer_native_tick_sa(&timer: ptr, delta_ns: i64) -> i32:
L_ENTRY:
    paused = load timer+SA3D_TIMER_NATIVE_paused as i32
    is_paused = ne paused, 0
    br is_paused -> L_PAUSED, L_MODE

L_PAUSED:
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, 0 as i32
    mode_paused = load timer+SA3D_TIMER_NATIVE_mode as i32
    paused_repeating = eq mode_paused, SA3D_TIMER_REPEATING
    !paused
    !is_paused
    !mode_paused
    br paused_repeating -> L_PAUSED_REPEAT, L_PAUSED_DONE

L_PAUSED_REPEAT:
    store timer+SA3D_TIMER_NATIVE_finished, 0 as i32
    !paused_repeating
    !delta_ns
    !timer
    return 0

L_PAUSED_DONE:
    !paused_repeating
    !delta_ns
    !timer
    return 0

L_MODE:
    mode = load timer+SA3D_TIMER_NATIVE_mode as i32
    repeating = eq mode, SA3D_TIMER_REPEATING
    !mode
    !paused
    !is_paused
    br repeating -> L_REPEAT_TICK, L_ONCE_ALREADY

L_REPEAT_TICK:
    elapsed_r = load timer+SA3D_TIMER_NATIVE_elapsed_ns as i64
    duration_r = load timer+SA3D_TIMER_NATIVE_duration_ns as i64
    next_r = add elapsed_r, delta_ns
    reached_r = sge next_r, duration_r
    !repeating
    br reached_r -> L_REPEAT_REACHED, L_REPEAT_PROGRESS

L_REPEAT_PROGRESS:
    store timer+SA3D_TIMER_NATIVE_elapsed_ns, next_r as i64
    store timer+SA3D_TIMER_NATIVE_finished, 0 as i32
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, 0 as i32
    !reached_r
    !next_r
    !duration_r
    !elapsed_r
    !delta_ns
    !timer
    return 0

L_REPEAT_REACHED:
    zero_r = eq duration_r, 0
    br zero_r -> L_REPEAT_ZERO, L_REPEAT_DIV

L_ONCE_ALREADY:
    finished_once = load timer+SA3D_TIMER_NATIVE_finished as i32
    already = ne finished_once, 0
    !repeating
    br already -> L_ONCE_DONE, L_ONCE_TICK

L_ONCE_DONE:
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, 0 as i32
    !finished_once
    !already
    !delta_ns
    !timer
    return 0

L_ONCE_TICK:
    !finished_once
    !already
    duration_o = load timer+SA3D_TIMER_NATIVE_duration_ns as i64
    elapsed_o = load timer+SA3D_TIMER_NATIVE_elapsed_ns as i64
    next_o = add elapsed_o, delta_ns
    reached_o = sge next_o, duration_o
    br reached_o -> L_ONCE_FINISHED, L_ONCE_PROGRESS

L_ONCE_PROGRESS:
    store timer+SA3D_TIMER_NATIVE_elapsed_ns, next_o as i64
    store timer+SA3D_TIMER_NATIVE_finished, 0 as i32
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, 0 as i32
    !reached_o
    !next_o
    !elapsed_o
    !duration_o
    !delta_ns
    !timer
    return 0

L_ONCE_FINISHED:
    store timer+SA3D_TIMER_NATIVE_elapsed_ns, duration_o as i64
    store timer+SA3D_TIMER_NATIVE_finished, 1 as i32
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, 1 as i32
    !reached_o
    !next_o
    !elapsed_o
    !duration_o
    !delta_ns
    !timer
    return 1

L_REPEAT_ZERO:
    store timer+SA3D_TIMER_NATIVE_elapsed_ns, 0 as i64
    store timer+SA3D_TIMER_NATIVE_finished, 1 as i32
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, -1 as i32
    !zero_r
    !reached_r
    !next_r
    !duration_r
    !elapsed_r
    !delta_ns
    !timer
    return -1

L_REPEAT_DIV:
    times64 = sdiv next_r, duration_r
    remaining = srem next_r, duration_r
    too_many = sgt times64, 4294967295
    br too_many -> L_REPEAT_SAT, L_REPEAT_STORE

L_REPEAT_SAT:
    store timer+SA3D_TIMER_NATIVE_elapsed_ns, remaining as i64
    store timer+SA3D_TIMER_NATIVE_finished, 1 as i32
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, -1 as i32
    !too_many
    !remaining
    !times64
    !zero_r
    !reached_r
    !next_r
    !duration_r
    !elapsed_r
    !delta_ns
    !timer
    return -1

L_REPEAT_STORE:
    times32 = trunc times64 as i32
    store timer+SA3D_TIMER_NATIVE_elapsed_ns, remaining as i64
    store timer+SA3D_TIMER_NATIVE_finished, 1 as i32
    store timer+SA3D_TIMER_NATIVE_times_finished_this_tick, times32 as i32
    out_times = load timer+SA3D_TIMER_NATIVE_times_finished_this_tick as i32
    !times32
    !too_many
    !remaining
    !times64
    !zero_r
    !reached_r
    !next_r
    !duration_r
    !elapsed_r
    !delta_ns
    !timer
    return out_times

@sa3d_fixed_time_native_init_sa(&fixed: ptr, timestep_ns: i64) -> void:
L_ENTRY:
    invalid = sle timestep_ns, 0
    br invalid -> L_DEFAULT, L_SET

L_DEFAULT:
    store fixed+SA3D_FIXED_TIME_NATIVE_timestep_ns, SA3D_FIXED_DEFAULT_TIMESTEP_NS as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_overstep_ns, 0 as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_delta_ns, 0 as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_elapsed_ns, 0 as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_step_index, 0 as i64
    !invalid
    !timestep_ns
    !fixed
    return

L_SET:
    store fixed+SA3D_FIXED_TIME_NATIVE_timestep_ns, timestep_ns as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_overstep_ns, 0 as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_delta_ns, 0 as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_elapsed_ns, 0 as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_step_index, 0 as i64
    !invalid
    !timestep_ns
    !fixed
    return

@sa3d_fixed_time_native_set_timestep_sa(&fixed: ptr, timestep_ns: i64) -> i32:
L_ENTRY:
    invalid = sle timestep_ns, 0
    br invalid -> L_ERR, L_SET

L_ERR:
    !invalid
    !timestep_ns
    !fixed
    return 1

L_SET:
    store fixed+SA3D_FIXED_TIME_NATIVE_timestep_ns, timestep_ns as i64
    !invalid
    !timestep_ns
    !fixed
    return 0

@sa3d_fixed_time_native_accumulate_sa(&fixed: ptr, delta_ns: i64) -> void:
L_ENTRY:
    overstep = load fixed+SA3D_FIXED_TIME_NATIVE_overstep_ns as i64
    next = add overstep, delta_ns
    store fixed+SA3D_FIXED_TIME_NATIVE_overstep_ns, next as i64
    !next
    !overstep
    !delta_ns
    !fixed
    return

@sa3d_fixed_time_native_expend_sa(&fixed: ptr) -> i32:
L_ENTRY:
    overstep = load fixed+SA3D_FIXED_TIME_NATIVE_overstep_ns as i64
    timestep = load fixed+SA3D_FIXED_TIME_NATIVE_timestep_ns as i64
    enough = sge overstep, timestep
    br enough -> L_EXPEND, L_EMPTY

L_EMPTY:
    !enough
    !timestep
    !overstep
    !fixed
    return 0

L_EXPEND:
    elapsed = load fixed+SA3D_FIXED_TIME_NATIVE_elapsed_ns as i64
    index = load fixed+SA3D_FIXED_TIME_NATIVE_step_index as i64
    remaining = sub overstep, timestep
    next_elapsed = add elapsed, timestep
    next_index = add index, 1
    store fixed+SA3D_FIXED_TIME_NATIVE_overstep_ns, remaining as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_delta_ns, timestep as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_elapsed_ns, next_elapsed as i64
    store fixed+SA3D_FIXED_TIME_NATIVE_step_index, next_index as i64
    !next_index
    !next_elapsed
    !remaining
    !index
    !elapsed
    !enough
    !timestep
    !overstep
    !fixed
    return 1
