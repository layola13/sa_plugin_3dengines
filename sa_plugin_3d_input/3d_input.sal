#def SA3D_INPUT_VERSION_MAJOR = 0
#def SA3D_INPUT_VERSION_MINOR = 1

#def SA3D_INPUT_EVENT_KEY = 1
#def SA3D_INPUT_EVENT_POINTER = 2
#def SA3D_INPUT_EVENT_WHEEL = 3
#def SA3D_INPUT_EVENT_GAMEPAD = 4

#def SA3D_INPUT_STATE_UP = 0
#def SA3D_INPUT_STATE_DOWN = 1
#def SA3D_INPUT_STATE_HELD = 2
#def SA3D_INPUT_STATE_RELEASED = 3

#def SA3D_INPUT_AXIS_X = 1
#def SA3D_INPUT_AXIS_Y = 2
#def SA3D_INPUT_AXIS_Z = 3

#def SA3D_INPUT_EVENT_type = +0
#def SA3D_INPUT_EVENT_device = +4
#def SA3D_INPUT_EVENT_code = +8
#def SA3D_INPUT_EVENT_state = +12
#def SA3D_INPUT_EVENT_value_x = +16
#def SA3D_INPUT_EVENT_value_y = +20
#def SA3D_INPUT_EVENT_timestamp_ms = +24
#def SA3D_INPUT_EVENT_target = +32
#def SA3D_INPUT_EVENT_SIZE = 40

#def SA3D_INPUT_ACTION_BINDING_action = +0
#def SA3D_INPUT_ACTION_BINDING_event_type = +4
#def SA3D_INPUT_ACTION_BINDING_code = +8
#def SA3D_INPUT_ACTION_BINDING_scale = +12
#def SA3D_INPUT_ACTION_BINDING_axis = +16
#def SA3D_INPUT_ACTION_BINDING_flags = +20
#def SA3D_INPUT_ACTION_BINDING_next = +24
#def SA3D_INPUT_ACTION_BINDING_SIZE = 32

#def SA3D_INPUT_ACTION_BINDING_FLAG_REQUIRE_DOWN = 1
#def SA3D_INPUT_ACTION_BINDING_FLAG_REQUIRE_RELEASE = 2

#def SA3D_INPUT_BUTTON_FLAG_PRESSED = 1
#def SA3D_INPUT_BUTTON_FLAG_JUST_PRESSED = 2
#def SA3D_INPUT_BUTTON_FLAG_JUST_RELEASED = 4

#def SA3D_INPUT_BUTTONS_CAPACITY = 64
#def SA3D_INPUT_BUTTONS_capacity = +0
#def SA3D_INPUT_BUTTONS_count = +8
#def SA3D_INPUT_BUTTONS_pressed_count = +16
#def SA3D_INPUT_BUTTONS_just_pressed_count = +24
#def SA3D_INPUT_BUTTONS_just_released_count = +32
#def SA3D_INPUT_BUTTONS_overflow_count = +40
#def SA3D_INPUT_BUTTONS_frame_index = +48
#def SA3D_INPUT_BUTTONS_last_event_type = +56
#def SA3D_INPUT_BUTTONS_last_event_code = +60
#def SA3D_INPUT_BUTTONS_entries = +64
#def SA3D_INPUT_BUTTON_ENTRY_event_type = +0
#def SA3D_INPUT_BUTTON_ENTRY_device = +4
#def SA3D_INPUT_BUTTON_ENTRY_code = +8
#def SA3D_INPUT_BUTTON_ENTRY_flags = +12
#def SA3D_INPUT_BUTTON_ENTRY_SIZE = 16
#def SA3D_INPUT_BUTTONS_SIZE = 1096

#def SA3D_INPUT_AXES_CAPACITY = 64
#def SA3D_INPUT_AXES_capacity = +0
#def SA3D_INPUT_AXES_count = +8
#def SA3D_INPUT_AXES_overflow_count = +16
#def SA3D_INPUT_AXES_entries = +24
#def SA3D_INPUT_AXIS_ENTRY_event_type = +0
#def SA3D_INPUT_AXIS_ENTRY_device = +4
#def SA3D_INPUT_AXIS_ENTRY_code = +8
#def SA3D_INPUT_AXIS_ENTRY_value = +12
#def SA3D_INPUT_AXIS_ENTRY_SIZE = 16
#def SA3D_INPUT_AXES_SIZE = 1048

@sa3d_input_event_init(&event: ptr, event_type: i32, device: i32, code: i32, state: i32, value_x: i32, value_y: i32, timestamp_ms: i64, target: i64) -> void:
L_ENTRY:
    store event+SA3D_INPUT_EVENT_type, event_type as i32
    store event+SA3D_INPUT_EVENT_device, device as i32
    store event+SA3D_INPUT_EVENT_code, code as i32
    store event+SA3D_INPUT_EVENT_state, state as i32
    store event+SA3D_INPUT_EVENT_value_x, value_x as i32
    store event+SA3D_INPUT_EVENT_value_y, value_y as i32
    store event+SA3D_INPUT_EVENT_timestamp_ms, timestamp_ms as i64
    store event+SA3D_INPUT_EVENT_target, target as i64
    !target
    !timestamp_ms
    !value_y
    !value_x
    !state
    !code
    !device
    !event_type
    !event
    return

@sa3d_input_event_type_is_valid(event_type: i32) -> i32:
L_ENTRY:
    is_key = eq event_type, SA3D_INPUT_EVENT_KEY
    is_pointer = eq event_type, SA3D_INPUT_EVENT_POINTER
    is_wheel = eq event_type, SA3D_INPUT_EVENT_WHEEL
    is_gamepad = eq event_type, SA3D_INPUT_EVENT_GAMEPAD
    p1 = or is_key, is_pointer
    p2 = or is_wheel, is_gamepad
    ok = or p1, p2
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !p2
    !p1
    !is_gamepad
    !is_wheel
    !is_pointer
    !is_key
    !event_type
    return 1

L_FALSE:
    !ok
    !p2
    !p1
    !is_gamepad
    !is_wheel
    !is_pointer
    !is_key
    !event_type
    return 0

@sa3d_input_state_is_valid(state: i32) -> i32:
L_ENTRY:
    is_up = eq state, SA3D_INPUT_STATE_UP
    is_down = eq state, SA3D_INPUT_STATE_DOWN
    is_held = eq state, SA3D_INPUT_STATE_HELD
    is_released = eq state, SA3D_INPUT_STATE_RELEASED
    p1 = or is_up, is_down
    p2 = or is_held, is_released
    ok = or p1, p2
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !p2
    !p1
    !is_released
    !is_held
    !is_down
    !is_up
    !state
    return 1

L_FALSE:
    !ok
    !p2
    !p1
    !is_released
    !is_held
    !is_down
    !is_up
    !state
    return 0

@sa3d_input_axis_is_valid(axis: i32) -> i32:
L_ENTRY:
    is_x = eq axis, SA3D_INPUT_AXIS_X
    is_y = eq axis, SA3D_INPUT_AXIS_Y
    is_z = eq axis, SA3D_INPUT_AXIS_Z
    xy = or is_x, is_y
    ok = or xy, is_z
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !xy
    !is_z
    !is_y
    !is_x
    !axis
    return 1

L_FALSE:
    !ok
    !xy
    !is_z
    !is_y
    !is_x
    !axis
    return 0

@sa3d_input_event_is_valid(&event: ptr) -> i32:
L_ENTRY:
    event_type = load event+SA3D_INPUT_EVENT_type as i32
    state = load event+SA3D_INPUT_EVENT_state as i32
    type_ok = call @sa3d_input_event_type_is_valid(event_type)
    state_ok = call @sa3d_input_state_is_valid(state)
    ok = and type_ok, state_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !state_ok
    !type_ok
    !state
    !event_type
    !event
    return 1

L_FALSE:
    !ok
    !state_ok
    !type_ok
    !state
    !event_type
    !event
    return 0

@sa3d_input_action_binding_init(&binding: ptr, action: i32, event_type: i32, code: i32, scale: i32, axis: i32, flags: i32, next: i64) -> void:
L_ENTRY:
    store binding+SA3D_INPUT_ACTION_BINDING_action, action as i32
    store binding+SA3D_INPUT_ACTION_BINDING_event_type, event_type as i32
    store binding+SA3D_INPUT_ACTION_BINDING_code, code as i32
    store binding+SA3D_INPUT_ACTION_BINDING_scale, scale as i32
    store binding+SA3D_INPUT_ACTION_BINDING_axis, axis as i32
    store binding+SA3D_INPUT_ACTION_BINDING_flags, flags as i32
    store binding+SA3D_INPUT_ACTION_BINDING_next, next as i64
    !next
    !flags
    !axis
    !scale
    !code
    !event_type
    !action
    !binding
    return

@sa3d_input_action_binding_is_valid(&binding: ptr) -> i32:
L_ENTRY:
    event_type = load binding+SA3D_INPUT_ACTION_BINDING_event_type as i32
    axis = load binding+SA3D_INPUT_ACTION_BINDING_axis as i32
    type_ok = call @sa3d_input_event_type_is_valid(event_type)
    axis_ok = call @sa3d_input_axis_is_valid(axis)
    ok = and type_ok, axis_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !axis_ok
    !type_ok
    !axis
    !event_type
    !binding
    return 1

L_FALSE:
    !ok
    !axis_ok
    !type_ok
    !axis
    !event_type
    !binding
    return 0

@sa3d_input_action_binding_matches_event(&binding: ptr, &event: ptr) -> i32:
L_ENTRY:
    binding_type = load binding+SA3D_INPUT_ACTION_BINDING_event_type as i32
    binding_code = load binding+SA3D_INPUT_ACTION_BINDING_code as i32
    event_type = load event+SA3D_INPUT_EVENT_type as i32
    event_code = load event+SA3D_INPUT_EVENT_code as i32
    type_ok = eq binding_type, event_type
    code_ok = eq binding_code, event_code
    ok = and type_ok, code_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !code_ok
    !type_ok
    !event_code
    !event_type
    !binding_code
    !binding_type
    !event
    !binding
    return 1

L_FALSE:
    !ok
    !code_ok
    !type_ok
    !event_code
    !event_type
    !binding_code
    !binding_type
    !event
    !binding
    return 0

@sa3d_input_event_axis_value(&event: ptr, axis: i32) -> i32:
L_ENTRY:
    is_x = eq axis, SA3D_INPUT_AXIS_X
    br is_x -> L_X, L_CHECK_Y

L_X:
    x = load event+SA3D_INPUT_EVENT_value_x as i32
    !is_x
    !axis
    !event
    return x

L_CHECK_Y:
    is_y = eq axis, SA3D_INPUT_AXIS_Y
    br is_y -> L_Y, L_ZERO

L_Y:
    y = load event+SA3D_INPUT_EVENT_value_y as i32
    !is_y
    !is_x
    !axis
    !event
    return y

L_ZERO:
    !is_y
    !is_x
    !axis
    !event
    return 0

@sa3d_input_action_binding_scaled_value(&binding: ptr, &event: ptr) -> i32:
L_ENTRY:
    axis = load binding+SA3D_INPUT_ACTION_BINDING_axis as i32
    scale = load binding+SA3D_INPUT_ACTION_BINDING_scale as i32
    value = call @sa3d_input_event_axis_value(&event, axis)
    scaled = mul value, scale
    !value
    !scale
    !axis
    !event
    !binding
    return scaled

@sa3d_input_apply_event(&buttons: ptr, &event: ptr) -> i32:
L_ENTRY:
    valid = call @sa3d_input_event_is_valid(&event)
    ok = ne valid, 0
    br ok -> L_VALID, L_INVALID

L_VALID:
    event_type = load event+SA3D_INPUT_EVENT_type as i32
    device = load event+SA3D_INPUT_EVENT_device as i32
    code = load event+SA3D_INPUT_EVENT_code as i32
    state = load event+SA3D_INPUT_EVENT_state as i32
    store buttons+SA3D_INPUT_BUTTONS_last_event_type, event_type as i32
    store buttons+SA3D_INPUT_BUTTONS_last_event_code, code as i32
    is_down = eq state, SA3D_INPUT_STATE_DOWN
    br is_down -> L_PRESS, L_CHECK_HELD

L_PRESS:
    press_result = call @sa3d_input_press(&buttons, event_type, device, code)
    !is_down
    !state
    !code
    !device
    !event_type
    !ok
    !valid
    !event
    !buttons
    return press_result

L_CHECK_HELD:
    is_held = eq state, SA3D_INPUT_STATE_HELD
    br is_held -> L_PRESS_HELD, L_CHECK_RELEASED

L_PRESS_HELD:
    held_result = call @sa3d_input_press(&buttons, event_type, device, code)
    !is_held
    !is_down
    !state
    !code
    !device
    !event_type
    !ok
    !valid
    !event
    !buttons
    return held_result

L_CHECK_RELEASED:
    is_released = eq state, SA3D_INPUT_STATE_RELEASED
    br is_released -> L_RELEASE, L_CHECK_UP

L_RELEASE:
    release_result = call @sa3d_input_release(&buttons, event_type, device, code)
    !is_released
    !is_held
    !is_down
    !state
    !code
    !device
    !event_type
    !ok
    !valid
    !event
    !buttons
    return release_result

L_CHECK_UP:
    is_up = eq state, SA3D_INPUT_STATE_UP
    br is_up -> L_RELEASE_UP, L_NOOP

L_RELEASE_UP:
    up_result = call @sa3d_input_release(&buttons, event_type, device, code)
    !is_up
    !is_released
    !is_held
    !is_down
    !state
    !code
    !device
    !event_type
    !ok
    !valid
    !event
    !buttons
    return up_result

L_NOOP:
    !is_up
    !is_released
    !is_held
    !is_down
    !state
    !code
    !device
    !event_type
    !ok
    !valid
    !event
    !buttons
    return 0

L_INVALID:
    !ok
    !valid
    !event
    !buttons
    return -1

@sa3d_input_button_entry_ptr(&buttons: ptr, index: i64) -> ptr:
L_ENTRY:
    scaled = mul index, SA3D_INPUT_BUTTON_ENTRY_SIZE
    offset = add scaled, 64
    entry = ptr_add buttons, offset
    !scaled
    !offset
    !index
    return entry

@sa3d_input_buttons_reset(&buttons: ptr) -> void:
L_ENTRY:
    store buttons+SA3D_INPUT_BUTTONS_capacity, SA3D_INPUT_BUTTONS_CAPACITY as i64
    store buttons+SA3D_INPUT_BUTTONS_count, 0 as i64
    store buttons+SA3D_INPUT_BUTTONS_pressed_count, 0 as i64
    store buttons+SA3D_INPUT_BUTTONS_just_pressed_count, 0 as i64
    store buttons+SA3D_INPUT_BUTTONS_just_released_count, 0 as i64
    store buttons+SA3D_INPUT_BUTTONS_overflow_count, 0 as i64
    store buttons+SA3D_INPUT_BUTTONS_frame_index, 0 as i64
    store buttons+SA3D_INPUT_BUTTONS_last_event_type, 0 as i32
    store buttons+SA3D_INPUT_BUTTONS_last_event_code, 0 as i32
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_RESET_HEAD

L_RESET_HEAD:
    i = load i_slot+0 as i64
    more = slt i, SA3D_INPUT_BUTTONS_CAPACITY
    br more -> L_RESET_BODY, L_RESET_END

L_RESET_BODY:
    entry = call @sa3d_input_button_entry_ptr(&buttons, i)
    store entry+SA3D_INPUT_BUTTON_ENTRY_event_type, 0 as i32
    store entry+SA3D_INPUT_BUTTON_ENTRY_device, 0 as i32
    store entry+SA3D_INPUT_BUTTON_ENTRY_code, 0 as i32
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, 0 as i32
    next = add i, 1
    store i_slot+0, next as i64
    !entry
    !next
    !i
    !more
    jmp L_RESET_HEAD

L_RESET_END:
    !i
    !more
    !buttons
    return

@sa3d_input_buttons_find(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i64:
L_ENTRY:
    count = load buttons+SA3D_INPUT_BUTTONS_count as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_FIND_HEAD

L_FIND_HEAD:
    i = load i_slot+0 as i64
    more = slt i, count
    br more -> L_FIND_BODY, L_FIND_MISS

L_FIND_BODY:
    entry = call @sa3d_input_button_entry_ptr(&buttons, i)
    slot_event_type = load entry+SA3D_INPUT_BUTTON_ENTRY_event_type as i32
    slot_device = load entry+SA3D_INPUT_BUTTON_ENTRY_device as i32
    slot_code = load entry+SA3D_INPUT_BUTTON_ENTRY_code as i32
    event_ok = eq slot_event_type, event_type
    device_ok = eq slot_device, device
    code_ok = eq slot_code, code
    first_ok = and event_ok, device_ok
    same = and first_ok, code_ok
    br same -> L_FIND_HIT, L_FIND_NEXT

L_FIND_HIT:
    !entry
    !slot_event_type
    !slot_device
    !slot_code
    !event_ok
    !device_ok
    !code_ok
    !first_ok
    !same
    !count
    !buttons
    !event_type
    !device
    !code
    return i

L_FIND_NEXT:
    next = add i, 1
    store i_slot+0, next as i64
    !entry
    !slot_event_type
    !slot_device
    !slot_code
    !event_ok
    !device_ok
    !code_ok
    !first_ok
    !same
    !next
    !i
    !more
    jmp L_FIND_HEAD

L_FIND_MISS:
    !i
    !more
    !count
    !buttons
    !event_type
    !device
    !code
    return -1

@sa3d_input_buttons_find_inactive(&buttons: ptr) -> i64:
L_ENTRY:
    count = load buttons+SA3D_INPUT_BUTTONS_count as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_INACTIVE_HEAD

L_INACTIVE_HEAD:
    i = load i_slot+0 as i64
    more = slt i, count
    br more -> L_INACTIVE_BODY, L_INACTIVE_MISS

L_INACTIVE_BODY:
    entry = call @sa3d_input_button_entry_ptr(&buttons, i)
    flags = load entry+SA3D_INPUT_BUTTON_ENTRY_flags as i32
    empty = eq flags, 0
    br empty -> L_INACTIVE_HIT, L_INACTIVE_NEXT

L_INACTIVE_HIT:
    !entry
    !flags
    !empty
    !count
    !buttons
    return i

L_INACTIVE_NEXT:
    next = add i, 1
    store i_slot+0, next as i64
    !entry
    !flags
    !empty
    !next
    !i
    !more
    jmp L_INACTIVE_HEAD

L_INACTIVE_MISS:
    !i
    !more
    !count
    !buttons
    return -1

@sa3d_input_button_flags(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i32:
L_ENTRY:
    index = call @sa3d_input_buttons_find(&buttons, event_type, device, code)
    missing = slt index, 0
    br missing -> L_FLAGS_MISS, L_FLAGS_HIT

L_FLAGS_HIT:
    entry = call @sa3d_input_button_entry_ptr(&buttons, index)
    flags = load entry+SA3D_INPUT_BUTTON_ENTRY_flags as i32
    !entry
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return flags

L_FLAGS_MISS:
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 0

@sa3d_input_buttons_get_last_event_type(&buttons: ptr) -> i32:
L_ENTRY:
    out = load buttons+SA3D_INPUT_BUTTONS_last_event_type as i32
    !buttons
    return out

@sa3d_input_buttons_get_last_event_code(&buttons: ptr) -> i32:
L_ENTRY:
    out = load buttons+SA3D_INPUT_BUTTONS_last_event_code as i32
    !buttons
    return out

@sa3d_input_pressed(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i32:
L_ENTRY:
    flags = call @sa3d_input_button_flags(&buttons, event_type, device, code)
    bit = and flags, SA3D_INPUT_BUTTON_FLAG_PRESSED
    pressed = ne bit, 0
    br pressed -> L_PRESSED_TRUE, L_PRESSED_FALSE

L_PRESSED_TRUE:
    !flags
    !bit
    !pressed
    !buttons
    !event_type
    !device
    !code
    return 1

L_PRESSED_FALSE:
    !flags
    !bit
    !pressed
    !buttons
    !event_type
    !device
    !code
    return 0

@sa3d_input_just_pressed(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i32:
L_ENTRY:
    flags = call @sa3d_input_button_flags(&buttons, event_type, device, code)
    bit = and flags, SA3D_INPUT_BUTTON_FLAG_JUST_PRESSED
    just = ne bit, 0
    br just -> L_JUST_PRESSED_TRUE, L_JUST_PRESSED_FALSE

L_JUST_PRESSED_TRUE:
    !flags
    !bit
    !just
    !buttons
    !event_type
    !device
    !code
    return 1

L_JUST_PRESSED_FALSE:
    !flags
    !bit
    !just
    !buttons
    !event_type
    !device
    !code
    return 0

@sa3d_input_just_released(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i32:
L_ENTRY:
    flags = call @sa3d_input_button_flags(&buttons, event_type, device, code)
    bit = and flags, SA3D_INPUT_BUTTON_FLAG_JUST_RELEASED
    just = ne bit, 0
    br just -> L_JUST_RELEASED_TRUE, L_JUST_RELEASED_FALSE

L_JUST_RELEASED_TRUE:
    !flags
    !bit
    !just
    !buttons
    !event_type
    !device
    !code
    return 1

L_JUST_RELEASED_FALSE:
    !flags
    !bit
    !just
    !buttons
    !event_type
    !device
    !code
    return 0

@sa3d_input_press_existing(&buttons: ptr, index: i64) -> i32:
L_ENTRY:
    entry = call @sa3d_input_button_entry_ptr(&buttons, index)
    flags = load entry+SA3D_INPUT_BUTTON_ENTRY_flags as i32
    pressed_bit = and flags, SA3D_INPUT_BUTTON_FLAG_PRESSED
    already_pressed = ne pressed_bit, 0
    br already_pressed -> L_PRESS_EXISTING_HELD, L_PRESS_EXISTING_NEW

L_PRESS_EXISTING_HELD:
    !entry
    !flags
    !pressed_bit
    !already_pressed
    !buttons
    !index
    return 0

L_PRESS_EXISTING_NEW:
    without_release = and flags, -5
    with_pressed = or without_release, SA3D_INPUT_BUTTON_FLAG_PRESSED
    pressed_count = load buttons+SA3D_INPUT_BUTTONS_pressed_count as i64
    next_pressed_count = add pressed_count, 1
    store buttons+SA3D_INPUT_BUTTONS_pressed_count, next_pressed_count as i64
    with_just = or with_pressed, SA3D_INPUT_BUTTON_FLAG_JUST_PRESSED
    just_pressed_count = load buttons+SA3D_INPUT_BUTTONS_just_pressed_count as i64
    next_just_pressed_count = add just_pressed_count, 1
    store buttons+SA3D_INPUT_BUTTONS_just_pressed_count, next_just_pressed_count as i64
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, with_just as i32
    !with_just
    !just_pressed_count
    !next_just_pressed_count
    !without_release
    !with_pressed
    !pressed_count
    !next_pressed_count
    !entry
    !flags
    !pressed_bit
    !already_pressed
    !buttons
    !index
    return 1

@sa3d_input_press(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i32:
L_ENTRY:
    found = call @sa3d_input_buttons_find(&buttons, event_type, device, code)
    has_found = sge found, 0
    br has_found -> L_PRESS_FOUND, L_PRESS_FIND_INACTIVE

L_PRESS_FOUND:
    result = call @sa3d_input_press_existing(&buttons, found)
    !found
    !has_found
    !buttons
    !event_type
    !device
    !code
    return result

L_PRESS_FIND_INACTIVE:
    inactive = call @sa3d_input_buttons_find_inactive(&buttons)
    has_inactive = sge inactive, 0
    br has_inactive -> L_PRESS_USE_INACTIVE, L_PRESS_APPEND

L_PRESS_USE_INACTIVE:
    entry_inactive = call @sa3d_input_button_entry_ptr(&buttons, inactive)
    store entry_inactive+SA3D_INPUT_BUTTON_ENTRY_event_type, event_type as i32
    store entry_inactive+SA3D_INPUT_BUTTON_ENTRY_device, device as i32
    store entry_inactive+SA3D_INPUT_BUTTON_ENTRY_code, code as i32
    store entry_inactive+SA3D_INPUT_BUTTON_ENTRY_flags, 0 as i32
    result_inactive = call @sa3d_input_press_existing(&buttons, inactive)
    !entry_inactive
    !inactive
    !has_inactive
    !found
    !has_found
    !buttons
    !event_type
    !device
    !code
    return result_inactive

L_PRESS_APPEND:
    count = load buttons+SA3D_INPUT_BUTTONS_count as i64
    room = slt count, SA3D_INPUT_BUTTONS_CAPACITY
    br room -> L_PRESS_APPEND_STORE, L_PRESS_OVERFLOW

L_PRESS_APPEND_STORE:
    entry_new = call @sa3d_input_button_entry_ptr(&buttons, count)
    store entry_new+SA3D_INPUT_BUTTON_ENTRY_event_type, event_type as i32
    store entry_new+SA3D_INPUT_BUTTON_ENTRY_device, device as i32
    store entry_new+SA3D_INPUT_BUTTON_ENTRY_code, code as i32
    store entry_new+SA3D_INPUT_BUTTON_ENTRY_flags, 0 as i32
    next_count = add count, 1
    store buttons+SA3D_INPUT_BUTTONS_count, next_count as i64
    result_new = call @sa3d_input_press_existing(&buttons, count)
    !entry_new
    !next_count
    !count
    !room
    !inactive
    !has_inactive
    !found
    !has_found
    !buttons
    !event_type
    !device
    !code
    return result_new

L_PRESS_OVERFLOW:
    overflow_count = load buttons+SA3D_INPUT_BUTTONS_overflow_count as i64
    next_overflow = add overflow_count, 1
    store buttons+SA3D_INPUT_BUTTONS_overflow_count, next_overflow as i64
    !overflow_count
    !next_overflow
    !count
    !room
    !inactive
    !has_inactive
    !found
    !has_found
    !buttons
    !event_type
    !device
    !code
    return -1

@sa3d_input_release(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i32:
L_ENTRY:
    index = call @sa3d_input_buttons_find(&buttons, event_type, device, code)
    missing = slt index, 0
    br missing -> L_RELEASE_NOOP, L_RELEASE_FOUND

L_RELEASE_FOUND:
    entry = call @sa3d_input_button_entry_ptr(&buttons, index)
    flags = load entry+SA3D_INPUT_BUTTON_ENTRY_flags as i32
    pressed_bit = and flags, SA3D_INPUT_BUTTON_FLAG_PRESSED
    was_pressed = ne pressed_bit, 0
    br was_pressed -> L_RELEASE_ACTIVE, L_RELEASE_NOT_PRESSED

L_RELEASE_ACTIVE:
    without_pressed = and flags, -2
    released_bit = and flags, SA3D_INPUT_BUTTON_FLAG_JUST_RELEASED
    already_released = ne released_bit, 0
    pressed_count = load buttons+SA3D_INPUT_BUTTONS_pressed_count as i64
    next_pressed_count = sub pressed_count, 1
    store buttons+SA3D_INPUT_BUTTONS_pressed_count, next_pressed_count as i64
    br already_released -> L_RELEASE_STORE, L_RELEASE_STORE_JUST

L_RELEASE_STORE:
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, without_pressed as i32
    !without_pressed
    !released_bit
    !already_released
    !pressed_count
    !next_pressed_count
    !entry
    !flags
    !pressed_bit
    !was_pressed
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 1

L_RELEASE_STORE_JUST:
    with_release = or without_pressed, SA3D_INPUT_BUTTON_FLAG_JUST_RELEASED
    just_released_count = load buttons+SA3D_INPUT_BUTTONS_just_released_count as i64
    next_just_released_count = add just_released_count, 1
    store buttons+SA3D_INPUT_BUTTONS_just_released_count, next_just_released_count as i64
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, with_release as i32
    !with_release
    !just_released_count
    !next_just_released_count
    !without_pressed
    !released_bit
    !already_released
    !pressed_count
    !next_pressed_count
    !entry
    !flags
    !pressed_bit
    !was_pressed
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 1

L_RELEASE_NOT_PRESSED:
    !entry
    !flags
    !pressed_bit
    !was_pressed
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 0

L_RELEASE_NOOP:
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 0

@sa3d_input_clear(&buttons: ptr) -> void:
L_ENTRY:
    count = load buttons+SA3D_INPUT_BUTTONS_count as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_CLEAR_HEAD

L_CLEAR_HEAD:
    i = load i_slot+0 as i64
    more = slt i, count
    br more -> L_CLEAR_BODY, L_CLEAR_END

L_CLEAR_BODY:
    entry = call @sa3d_input_button_entry_ptr(&buttons, i)
    flags = load entry+SA3D_INPUT_BUTTON_ENTRY_flags as i32
    pressed_bit = and flags, SA3D_INPUT_BUTTON_FLAG_PRESSED
    is_pressed = ne pressed_bit, 0
    br is_pressed -> L_CLEAR_KEEP_PRESSED, L_CLEAR_EMPTY

L_CLEAR_KEEP_PRESSED:
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, SA3D_INPUT_BUTTON_FLAG_PRESSED as i32
    next_keep = add i, 1
    store i_slot+0, next_keep as i64
    !entry
    !flags
    !pressed_bit
    !is_pressed
    !next_keep
    !i
    !more
    jmp L_CLEAR_HEAD

L_CLEAR_EMPTY:
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, 0 as i32
    next_empty = add i, 1
    store i_slot+0, next_empty as i64
    !entry
    !flags
    !pressed_bit
    !is_pressed
    !next_empty
    !i
    !more
    jmp L_CLEAR_HEAD

L_CLEAR_END:
    frame_index = load buttons+SA3D_INPUT_BUTTONS_frame_index as i64
    next_frame_index = add frame_index, 1
    store buttons+SA3D_INPUT_BUTTONS_frame_index, next_frame_index as i64
    store buttons+SA3D_INPUT_BUTTONS_just_pressed_count, 0 as i64
    store buttons+SA3D_INPUT_BUTTONS_just_released_count, 0 as i64
    !frame_index
    !next_frame_index
    !i
    !more
    !count
    !buttons
    return

@sa3d_input_clear_just_pressed(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i32:
L_ENTRY:
    index = call @sa3d_input_buttons_find(&buttons, event_type, device, code)
    missing = slt index, 0
    br missing -> L_CJP_NOOP, L_CJP_FOUND

L_CJP_FOUND:
    entry = call @sa3d_input_button_entry_ptr(&buttons, index)
    flags = load entry+SA3D_INPUT_BUTTON_ENTRY_flags as i32
    bit = and flags, SA3D_INPUT_BUTTON_FLAG_JUST_PRESSED
    has_bit = ne bit, 0
    br has_bit -> L_CJP_CLEAR, L_CJP_NO_BIT

L_CJP_CLEAR:
    cleared = and flags, -3
    just_pressed_count = load buttons+SA3D_INPUT_BUTTONS_just_pressed_count as i64
    next_just_pressed_count = sub just_pressed_count, 1
    store buttons+SA3D_INPUT_BUTTONS_just_pressed_count, next_just_pressed_count as i64
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, cleared as i32
    !cleared
    !just_pressed_count
    !next_just_pressed_count
    !entry
    !flags
    !bit
    !has_bit
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 1

L_CJP_NO_BIT:
    !entry
    !flags
    !bit
    !has_bit
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 0

L_CJP_NOOP:
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 0

@sa3d_input_clear_just_released(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i32:
L_ENTRY:
    index = call @sa3d_input_buttons_find(&buttons, event_type, device, code)
    missing = slt index, 0
    br missing -> L_CJR_NOOP, L_CJR_FOUND

L_CJR_FOUND:
    entry = call @sa3d_input_button_entry_ptr(&buttons, index)
    flags = load entry+SA3D_INPUT_BUTTON_ENTRY_flags as i32
    bit = and flags, SA3D_INPUT_BUTTON_FLAG_JUST_RELEASED
    has_bit = ne bit, 0
    br has_bit -> L_CJR_CLEAR, L_CJR_NO_BIT

L_CJR_CLEAR:
    cleared = and flags, -5
    just_released_count = load buttons+SA3D_INPUT_BUTTONS_just_released_count as i64
    next_just_released_count = sub just_released_count, 1
    store buttons+SA3D_INPUT_BUTTONS_just_released_count, next_just_released_count as i64
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, cleared as i32
    !cleared
    !just_released_count
    !next_just_released_count
    !entry
    !flags
    !bit
    !has_bit
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 1

L_CJR_NO_BIT:
    !entry
    !flags
    !bit
    !has_bit
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 0

L_CJR_NOOP:
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 0

@sa3d_input_reset(&buttons: ptr, event_type: i32, device: i32, code: i32) -> i32:
L_ENTRY:
    index = call @sa3d_input_buttons_find(&buttons, event_type, device, code)
    missing = slt index, 0
    br missing -> L_RESET_ONE_NOOP, L_RESET_ONE_FOUND

L_RESET_ONE_FOUND:
    entry = call @sa3d_input_button_entry_ptr(&buttons, index)
    flags = load entry+SA3D_INPUT_BUTTON_ENTRY_flags as i32
    any = ne flags, 0
    br any -> L_RESET_ONE_ACTIVE, L_RESET_ONE_EMPTY

L_RESET_ONE_ACTIVE:
    pressed_bit = and flags, SA3D_INPUT_BUTTON_FLAG_PRESSED
    just_pressed_bit = and flags, SA3D_INPUT_BUTTON_FLAG_JUST_PRESSED
    just_released_bit = and flags, SA3D_INPUT_BUTTON_FLAG_JUST_RELEASED
    was_pressed = ne pressed_bit, 0
    was_just_pressed = ne just_pressed_bit, 0
    was_just_released = ne just_released_bit, 0
    br was_pressed -> L_RESET_ONE_DEC_PRESSED, L_RESET_ONE_DEC_JUST_PRESSED

L_RESET_ONE_DEC_PRESSED:
    pressed_count = load buttons+SA3D_INPUT_BUTTONS_pressed_count as i64
    next_pressed_count = sub pressed_count, 1
    store buttons+SA3D_INPUT_BUTTONS_pressed_count, next_pressed_count as i64
    !pressed_count
    !next_pressed_count
    jmp L_RESET_ONE_DEC_JUST_PRESSED

L_RESET_ONE_DEC_JUST_PRESSED:
    br was_just_pressed -> L_RESET_ONE_DEC_JP, L_RESET_ONE_DEC_JR

L_RESET_ONE_DEC_JP:
    just_pressed_count = load buttons+SA3D_INPUT_BUTTONS_just_pressed_count as i64
    next_just_pressed_count = sub just_pressed_count, 1
    store buttons+SA3D_INPUT_BUTTONS_just_pressed_count, next_just_pressed_count as i64
    !just_pressed_count
    !next_just_pressed_count
    jmp L_RESET_ONE_DEC_JR

L_RESET_ONE_DEC_JR:
    br was_just_released -> L_RESET_ONE_DEC_JR_BODY, L_RESET_ONE_STORE

L_RESET_ONE_DEC_JR_BODY:
    just_released_count = load buttons+SA3D_INPUT_BUTTONS_just_released_count as i64
    next_just_released_count = sub just_released_count, 1
    store buttons+SA3D_INPUT_BUTTONS_just_released_count, next_just_released_count as i64
    !just_released_count
    !next_just_released_count
    jmp L_RESET_ONE_STORE

L_RESET_ONE_STORE:
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, 0 as i32
    !pressed_bit
    !just_pressed_bit
    !just_released_bit
    !was_pressed
    !was_just_pressed
    !was_just_released
    !entry
    !flags
    !any
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 1

L_RESET_ONE_EMPTY:
    !entry
    !flags
    !any
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 0

L_RESET_ONE_NOOP:
    !index
    !missing
    !buttons
    !event_type
    !device
    !code
    return 0

@sa3d_input_reset_all(&buttons: ptr) -> void:
L_ENTRY:
    count = load buttons+SA3D_INPUT_BUTTONS_count as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_RESET_ALL_HEAD

L_RESET_ALL_HEAD:
    i = load i_slot+0 as i64
    more = slt i, count
    br more -> L_RESET_ALL_BODY, L_RESET_ALL_END

L_RESET_ALL_BODY:
    entry = call @sa3d_input_button_entry_ptr(&buttons, i)
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, 0 as i32
    next = add i, 1
    store i_slot+0, next as i64
    !entry
    !next
    !i
    !more
    jmp L_RESET_ALL_HEAD

L_RESET_ALL_END:
    store buttons+SA3D_INPUT_BUTTONS_pressed_count, 0 as i64
    store buttons+SA3D_INPUT_BUTTONS_just_pressed_count, 0 as i64
    store buttons+SA3D_INPUT_BUTTONS_just_released_count, 0 as i64
    !i
    !more
    !count
    !buttons
    return

@sa3d_input_release_all(&buttons: ptr) -> i64:
L_ENTRY:
    count = load buttons+SA3D_INPUT_BUTTONS_count as i64
    released_slot = stack_alloc 8
    store released_slot+0, 0 as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_RELEASE_ALL_HEAD

L_RELEASE_ALL_HEAD:
    i = load i_slot+0 as i64
    more = slt i, count
    br more -> L_RELEASE_ALL_BODY, L_RELEASE_ALL_END

L_RELEASE_ALL_BODY:
    entry = call @sa3d_input_button_entry_ptr(&buttons, i)
    flags = load entry+SA3D_INPUT_BUTTON_ENTRY_flags as i32
    pressed_bit = and flags, SA3D_INPUT_BUTTON_FLAG_PRESSED
    is_pressed = ne pressed_bit, 0
    br is_pressed -> L_RELEASE_ALL_ACTIVE, L_RELEASE_ALL_NEXT

L_RELEASE_ALL_ACTIVE:
    without_pressed = and flags, -2
    released_bit = and flags, SA3D_INPUT_BUTTON_FLAG_JUST_RELEASED
    already_released = ne released_bit, 0
    released_count = load released_slot+0 as i64
    next_released_count = add released_count, 1
    store released_slot+0, next_released_count as i64
    br already_released -> L_RELEASE_ALL_STORE, L_RELEASE_ALL_STORE_JUST

L_RELEASE_ALL_STORE:
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, without_pressed as i32
    next_store = add i, 1
    store i_slot+0, next_store as i64
    !without_pressed
    !released_bit
    !already_released
    !released_count
    !next_released_count
    !next_store
    !entry
    !flags
    !pressed_bit
    !is_pressed
    !i
    !more
    jmp L_RELEASE_ALL_HEAD

L_RELEASE_ALL_STORE_JUST:
    with_release = or without_pressed, SA3D_INPUT_BUTTON_FLAG_JUST_RELEASED
    just_released_count = load buttons+SA3D_INPUT_BUTTONS_just_released_count as i64
    next_just_released_count = add just_released_count, 1
    store buttons+SA3D_INPUT_BUTTONS_just_released_count, next_just_released_count as i64
    store entry+SA3D_INPUT_BUTTON_ENTRY_flags, with_release as i32
    next_store_just = add i, 1
    store i_slot+0, next_store_just as i64
    !with_release
    !just_released_count
    !next_just_released_count
    !without_pressed
    !released_bit
    !already_released
    !released_count
    !next_released_count
    !next_store_just
    !entry
    !flags
    !pressed_bit
    !is_pressed
    !i
    !more
    jmp L_RELEASE_ALL_HEAD

L_RELEASE_ALL_NEXT:
    next = add i, 1
    store i_slot+0, next as i64
    !entry
    !flags
    !pressed_bit
    !is_pressed
    !next
    !i
    !more
    jmp L_RELEASE_ALL_HEAD

L_RELEASE_ALL_END:
    released = load released_slot+0 as i64
    store buttons+SA3D_INPUT_BUTTONS_pressed_count, 0 as i64
    !i
    !more
    !count
    !buttons
    return released

@sa3d_input_axis_entry_ptr(&axes: ptr, index: i64) -> ptr:
L_ENTRY:
    scaled = mul index, SA3D_INPUT_AXIS_ENTRY_SIZE
    offset = add scaled, SA3D_INPUT_AXES_entries
    entry = ptr_add axes, offset
    !scaled
    !offset
    !index
    return entry

@sa3d_input_axes_reset(&axes: ptr) -> void:
L_ENTRY:
    store axes+SA3D_INPUT_AXES_capacity, SA3D_INPUT_AXES_CAPACITY as i64
    store axes+SA3D_INPUT_AXES_count, 0 as i64
    store axes+SA3D_INPUT_AXES_overflow_count, 0 as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_RESET_HEAD

L_RESET_HEAD:
    i = load i_slot+0 as i64
    more = slt i, SA3D_INPUT_AXES_CAPACITY
    br more -> L_RESET_BODY, L_RESET_END

L_RESET_BODY:
    entry = call @sa3d_input_axis_entry_ptr(&axes, i)
    store entry+SA3D_INPUT_AXIS_ENTRY_event_type, 0 as i32
    store entry+SA3D_INPUT_AXIS_ENTRY_device, 0 as i32
    store entry+SA3D_INPUT_AXIS_ENTRY_code, 0 as i32
    store entry+SA3D_INPUT_AXIS_ENTRY_value, 0.0 as f32
    next = add i, 1
    store i_slot+0, next as i64
    !entry
    !next
    !i
    !more
    jmp L_RESET_HEAD

L_RESET_END:
    !i
    !more
    !axes
    return

@sa3d_input_axes_find(&axes: ptr, event_type: i32, device: i32, code: i32) -> i64:
L_ENTRY:
    count = load axes+SA3D_INPUT_AXES_count as i64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as i64
    jmp L_FIND_HEAD

L_FIND_HEAD:
    i = load i_slot+0 as i64
    more = slt i, count
    br more -> L_FIND_BODY, L_FIND_MISS

L_FIND_BODY:
    entry = call @sa3d_input_axis_entry_ptr(&axes, i)
    slot_event_type = load entry+SA3D_INPUT_AXIS_ENTRY_event_type as i32
    slot_device = load entry+SA3D_INPUT_AXIS_ENTRY_device as i32
    slot_code = load entry+SA3D_INPUT_AXIS_ENTRY_code as i32
    event_ok = eq slot_event_type, event_type
    device_ok = eq slot_device, device
    code_ok = eq slot_code, code
    first_ok = and event_ok, device_ok
    same = and first_ok, code_ok
    br same -> L_FIND_HIT, L_FIND_NEXT

L_FIND_HIT:
    !entry
    !slot_event_type
    !slot_device
    !slot_code
    !event_ok
    !device_ok
    !code_ok
    !first_ok
    !same
    !count
    !axes
    !event_type
    !device
    !code
    return i

L_FIND_NEXT:
    next = add i, 1
    store i_slot+0, next as i64
    !entry
    !slot_event_type
    !slot_device
    !slot_code
    !event_ok
    !device_ok
    !code_ok
    !first_ok
    !same
    !next
    !i
    !more
    jmp L_FIND_HEAD

L_FIND_MISS:
    !i
    !more
    !count
    !axes
    !event_type
    !device
    !code
    return -1

@sa3d_input_axis_set(&axes: ptr, event_type: i32, device: i32, code: i32, value: f32) -> i32:
L_ENTRY:
    found = call @sa3d_input_axes_find(&axes, event_type, device, code)
    has_found = sge found, 0
    br has_found -> L_SET_FOUND, L_SET_APPEND

L_SET_FOUND:
    entry_found = call @sa3d_input_axis_entry_ptr(&axes, found)
    store entry_found+SA3D_INPUT_AXIS_ENTRY_value, value as f32
    !entry_found
    !found
    !has_found
    !value
    !axes
    !event_type
    !device
    !code
    return 1

L_SET_APPEND:
    count = load axes+SA3D_INPUT_AXES_count as i64
    room = slt count, SA3D_INPUT_AXES_CAPACITY
    br room -> L_SET_APPEND_STORE, L_SET_OVERFLOW

L_SET_APPEND_STORE:
    entry_new = call @sa3d_input_axis_entry_ptr(&axes, count)
    store entry_new+SA3D_INPUT_AXIS_ENTRY_event_type, event_type as i32
    store entry_new+SA3D_INPUT_AXIS_ENTRY_device, device as i32
    store entry_new+SA3D_INPUT_AXIS_ENTRY_code, code as i32
    store entry_new+SA3D_INPUT_AXIS_ENTRY_value, value as f32
    next_count = add count, 1
    store axes+SA3D_INPUT_AXES_count, next_count as i64
    !entry_new
    !next_count
    !count
    !room
    !found
    !has_found
    !value
    !axes
    !event_type
    !device
    !code
    return 1

L_SET_OVERFLOW:
    overflow_count = load axes+SA3D_INPUT_AXES_overflow_count as i64
    next_overflow = add overflow_count, 1
    store axes+SA3D_INPUT_AXES_overflow_count, next_overflow as i64
    !next_overflow
    !overflow_count
    !count
    !room
    !found
    !has_found
    !value
    !axes
    !event_type
    !device
    !code
    return 0

@sa3d_input_axis_get_unclamped(&axes: ptr, event_type: i32, device: i32, code: i32) -> f32:
L_ENTRY:
    found = call @sa3d_input_axes_find(&axes, event_type, device, code)
    missing = slt found, 0
    br missing -> L_MISS, L_HIT

L_HIT:
    entry = call @sa3d_input_axis_entry_ptr(&axes, found)
    value = load entry+SA3D_INPUT_AXIS_ENTRY_value as f32
    !entry
    !found
    !missing
    !axes
    !event_type
    !device
    !code
    return value

L_MISS:
    !found
    !missing
    !axes
    !event_type
    !device
    !code
    return 0.0

@sa3d_input_axis_get(&axes: ptr, event_type: i32, device: i32, code: i32) -> f32:
L_ENTRY:
    value = call @sa3d_input_axis_get_unclamped(&axes, event_type, device, code)
    too_low = fcmp_lt value, -1.0
    br too_low -> L_LOW, L_CHECK_HIGH

L_LOW:
    !too_low
    !value
    !axes
    !event_type
    !device
    !code
    return -1.0

L_CHECK_HIGH:
    too_high = fcmp_gt value, 1.0
    br too_high -> L_HIGH, L_KEEP

L_HIGH:
    !too_high
    !too_low
    !value
    !axes
    !event_type
    !device
    !code
    return 1.0

L_KEEP:
    !too_high
    !too_low
    !axes
    !event_type
    !device
    !code
    return value

@sa3d_input_axis_remove(&axes: ptr, event_type: i32, device: i32, code: i32) -> f32:
L_ENTRY:
    found = call @sa3d_input_axes_find(&axes, event_type, device, code)
    missing = slt found, 0
    br missing -> L_REMOVE_MISS, L_REMOVE_HIT

L_REMOVE_HIT:
    entry = call @sa3d_input_axis_entry_ptr(&axes, found)
    value = load entry+SA3D_INPUT_AXIS_ENTRY_value as f32
    store entry+SA3D_INPUT_AXIS_ENTRY_event_type, 0 as i32
    store entry+SA3D_INPUT_AXIS_ENTRY_device, 0 as i32
    store entry+SA3D_INPUT_AXIS_ENTRY_code, 0 as i32
    store entry+SA3D_INPUT_AXIS_ENTRY_value, 0.0 as f32
    !entry
    !found
    !missing
    !axes
    !event_type
    !device
    !code
    return value

L_REMOVE_MISS:
    !found
    !missing
    !axes
    !event_type
    !device
    !code
    return 0.0
