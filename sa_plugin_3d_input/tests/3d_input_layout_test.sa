@import "../3d_input.sal"

@test "3d_input event and action binding layouts"():
L_ENTRY:
    event = alloc SA3D_INPUT_EVENT_SIZE
    binding = alloc SA3D_INPUT_ACTION_BINDING_SIZE
    store event+SA3D_INPUT_EVENT_type, SA3D_INPUT_EVENT_POINTER as i32
    store event+SA3D_INPUT_EVENT_code, 1 as i32
    store event+SA3D_INPUT_EVENT_state, SA3D_INPUT_STATE_DOWN as i32
    store event+SA3D_INPUT_EVENT_value_x, 1065353216 as i32
    store event+SA3D_INPUT_EVENT_timestamp_ms, 1234 as i64
    store event+SA3D_INPUT_EVENT_target, 99 as i64
    store binding+SA3D_INPUT_ACTION_BINDING_action, 7 as i32
    store binding+SA3D_INPUT_ACTION_BINDING_event_type, SA3D_INPUT_EVENT_KEY as i32
    store binding+SA3D_INPUT_ACTION_BINDING_scale, 1065353216 as i32
    store binding+SA3D_INPUT_ACTION_BINDING_axis, SA3D_INPUT_AXIS_X as i32
    kind = load event+0 as i32
    state = load event+12 as i32
    x = load event+16 as i32
    timestamp = load event+24 as i64
    target = load event+32 as i64
    action = load binding+0 as i32
    event_type = load binding+4 as i32
    scale = load binding+12 as i32
    axis = load binding+16 as i32
    kind_ok = eq kind, 2
    state_ok = eq state, 1
    x_ok = eq x, 1065353216
    timestamp_ok = eq timestamp, 1234
    target_ok = eq target, 99
    action_ok = eq action, 7
    event_type_ok = eq event_type, 1
    scale_ok = eq scale, 1065353216
    axis_ok = eq axis, 1
    event_size_ok = eq SA3D_INPUT_EVENT_SIZE, 40
    binding_size_ok = eq SA3D_INPUT_ACTION_BINDING_SIZE, 32
    buttons_capacity_ok = eq SA3D_INPUT_BUTTONS_CAPACITY, 64
    buttons_size_ok = eq SA3D_INPUT_BUTTONS_SIZE, 1096
    button_entry_size_ok = eq SA3D_INPUT_BUTTON_ENTRY_SIZE, 16
    pair1 = and kind_ok, state_ok
    pair2 = and x_ok, timestamp_ok
    pair3 = and target_ok, action_ok
    pair4 = and event_type_ok, scale_ok
    pair5 = and axis_ok, event_size_ok
    pair6 = and binding_size_ok, pair5
    pair7 = and buttons_capacity_ok, buttons_size_ok
    pair8 = and pair7, button_entry_size_ok
    ok1 = and pair1, pair2
    ok2 = and pair3, pair4
    ok3 = and ok1, ok2
    ok4 = and ok3, pair6
    ok = and ok4, pair8
    br ok -> L_OK, L_ERR

L_OK:
    !binding
    !event
    return

L_ERR:
    !binding
    !event
    panic(3140)

@test "3d_input buttons follow Bevy ButtonInput transitions"():
L_ENTRY:
    buttons = alloc SA3D_INPUT_BUTTONS_SIZE
    call @sa3d_input_buttons_reset(&buttons)
    press0 = call @sa3d_input_press(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    pressed0 = call @sa3d_input_pressed(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    just_pressed0 = call @sa3d_input_just_pressed(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    release0 = call @sa3d_input_release(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    just_released0 = call @sa3d_input_just_released(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    clear_jp = call @sa3d_input_clear_just_pressed(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    clear_jr = call @sa3d_input_clear_just_released(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    press_again = call @sa3d_input_press(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    pressed_again = call @sa3d_input_pressed(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    just_pressed_again = call @sa3d_input_just_pressed(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    just_released_again = call @sa3d_input_just_released(&buttons, SA3D_INPUT_EVENT_KEY, 0, 65)
    press0_ok = eq press0, 1
    pressed0_ok = eq pressed0, 1
    just_pressed0_ok = eq just_pressed0, 1
    release0_ok = eq release0, 1
    just_released0_ok = eq just_released0, 1
    clear_jp_ok = eq clear_jp, 1
    clear_jr_ok = eq clear_jr, 1
    press_again_ok = eq press_again, 1
    pressed_again_ok = eq pressed_again, 1
    just_pressed_again_ok = eq just_pressed_again, 1
    just_released_again_ok = eq just_released_again, 1
    a = and press0_ok, pressed0_ok
    b = and just_pressed0_ok, release0_ok
    c = and just_released0_ok, clear_jp_ok
    d = and clear_jr_ok, press_again_ok
    e = and pressed_again_ok, just_pressed_again_ok
    ok = and a, b
    ok2 = and c, d
    ok3 = and ok, ok2
    ok4 = and ok3, e
    br ok4 -> L_BUTTONS_OK, L_BUTTONS_ERR

L_BUTTONS_OK:
    !just_released_again_ok
    !just_pressed_again_ok
    !pressed_again_ok
    !press_again_ok
    !clear_jr_ok
    !clear_jp_ok
    !just_released0_ok
    !release0_ok
    !just_pressed0_ok
    !pressed0_ok
    !press0_ok
    !just_released_again
    !just_pressed_again
    !pressed_again
    !press_again
    !clear_jr
    !clear_jp
    !just_released0
    !release0
    !just_pressed0
    !pressed0
    !press0
    !buttons
    return

L_BUTTONS_ERR:
    !just_released_again_ok
    !just_pressed_again_ok
    !pressed_again_ok
    !press_again_ok
    !clear_jr_ok
    !clear_jp_ok
    !just_released0_ok
    !release0_ok
    !just_pressed0_ok
    !pressed0_ok
    !press0_ok
    !just_released_again
    !just_pressed_again
    !pressed_again
    !press_again
    !clear_jr
    !clear_jp
    !just_released0
    !release0
    !just_pressed0
    !pressed0
    !press0
    !buttons
    panic(3141)

@test "3d_input release_all and reset_all maintain counts"():
L_ENTRY:
    buttons = alloc SA3D_INPUT_BUTTONS_SIZE
    call @sa3d_input_buttons_reset(&buttons)
    press_a = call @sa3d_input_press(&buttons, SA3D_INPUT_EVENT_KEY, 0, 66)
    press_b = call @sa3d_input_press(&buttons, SA3D_INPUT_EVENT_POINTER, 1, 1)
    released = call @sa3d_input_release_all(&buttons)
    pressed_a = call @sa3d_input_pressed(&buttons, SA3D_INPUT_EVENT_KEY, 0, 66)
    pressed_b = call @sa3d_input_pressed(&buttons, SA3D_INPUT_EVENT_POINTER, 1, 1)
    just_released_a = call @sa3d_input_just_released(&buttons, SA3D_INPUT_EVENT_KEY, 0, 66)
    just_released_b = call @sa3d_input_just_released(&buttons, SA3D_INPUT_EVENT_POINTER, 1, 1)
    pressed_count = load buttons+SA3D_INPUT_BUTTONS_pressed_count as i64
    just_released_count = load buttons+SA3D_INPUT_BUTTONS_just_released_count as i64
    call @sa3d_input_reset_all(&buttons)
    pressed_after_reset_all = load buttons+SA3D_INPUT_BUTTONS_pressed_count as i64
    just_pressed_after_reset_all = load buttons+SA3D_INPUT_BUTTONS_just_pressed_count as i64
    just_released_after_reset_all = load buttons+SA3D_INPUT_BUTTONS_just_released_count as i64

    press_a_ok = eq press_a, 1
    press_b_ok = eq press_b, 1
    released_ok = eq released, 2
    pressed_a_ok = eq pressed_a, 0
    pressed_b_ok = eq pressed_b, 0
    just_released_a_ok = eq just_released_a, 1
    just_released_b_ok = eq just_released_b, 1
    pressed_count_ok = eq pressed_count, 0
    just_released_count_ok = eq just_released_count, 2
    pressed_after_reset_all_ok = eq pressed_after_reset_all, 0
    just_pressed_after_reset_all_ok = eq just_pressed_after_reset_all, 0
    just_released_after_reset_all_ok = eq just_released_after_reset_all, 0

    p1 = and press_a_ok, press_b_ok
    p2 = and released_ok, pressed_a_ok
    p3 = and pressed_b_ok, just_released_a_ok
    p4 = and just_released_b_ok, pressed_count_ok
    p5 = and just_released_count_ok, pressed_after_reset_all_ok
    p6 = and just_pressed_after_reset_all_ok, just_released_after_reset_all_ok
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    q4 = and q1, q2
    ok = and q4, q3
    br ok -> L_RELEASE_ALL_OK, L_RELEASE_ALL_ERR

L_RELEASE_ALL_OK:
    !buttons
    return

L_RELEASE_ALL_ERR:
    !buttons
    panic(3142)

@test "3d_input events validate and apply to buttons"():
L_ENTRY:
    buttons = alloc SA3D_INPUT_BUTTONS_SIZE
    event = alloc SA3D_INPUT_EVENT_SIZE
    call @sa3d_input_buttons_reset(&buttons)
    call @sa3d_input_event_init(&event, SA3D_INPUT_EVENT_KEY, 2, 67, SA3D_INPUT_STATE_DOWN, 0, 0, 1000, 90)
    valid = call @sa3d_input_event_is_valid(&event)
    applied = call @sa3d_input_apply_event(&buttons, &event)
    pressed = call @sa3d_input_pressed(&buttons, SA3D_INPUT_EVENT_KEY, 2, 67)
    just_pressed = call @sa3d_input_just_pressed(&buttons, SA3D_INPUT_EVENT_KEY, 2, 67)
    call @sa3d_input_event_init(&event, SA3D_INPUT_EVENT_KEY, 2, 67, SA3D_INPUT_STATE_RELEASED, 0, 0, 1010, 90)
    released = call @sa3d_input_apply_event(&buttons, &event)
    pressed_after = call @sa3d_input_pressed(&buttons, SA3D_INPUT_EVENT_KEY, 2, 67)
    just_released = call @sa3d_input_just_released(&buttons, SA3D_INPUT_EVENT_KEY, 2, 67)
    call @sa3d_input_event_init(&event, 99, 2, 67, SA3D_INPUT_STATE_DOWN, 0, 0, 1020, 90)
    invalid = call @sa3d_input_apply_event(&buttons, &event)
    valid_ok = eq valid, 1
    applied_ok = eq applied, 1
    pressed_ok = eq pressed, 1
    just_pressed_ok = eq just_pressed, 1
    released_ok = eq released, 1
    pressed_after_ok = eq pressed_after, 0
    just_released_ok = eq just_released, 1
    invalid_ok = eq invalid, -1
    p1 = and valid_ok, applied_ok
    p2 = and pressed_ok, just_pressed_ok
    p3 = and released_ok, pressed_after_ok
    p4 = and just_released_ok, invalid_ok
    q1 = and p1, p2
    q2 = and p3, p4
    ok = and q1, q2
    br ok -> L_OK, L_ERR

L_OK:
    !event
    !buttons
    return

L_ERR:
    !event
    !buttons
    panic(3143)

@test "3d_input action bindings match and scale events"():
L_ENTRY:
    event = alloc SA3D_INPUT_EVENT_SIZE
    binding = alloc SA3D_INPUT_ACTION_BINDING_SIZE
    call @sa3d_input_event_init(&event, SA3D_INPUT_EVENT_POINTER, 4, 1, SA3D_INPUT_STATE_HELD, 12, -5, 2000, 99)
    call @sa3d_input_action_binding_init(&binding, 7, SA3D_INPUT_EVENT_POINTER, 1, 3, SA3D_INPUT_AXIS_X, SA3D_INPUT_ACTION_BINDING_FLAG_REQUIRE_DOWN, 0)
    binding_valid = call @sa3d_input_action_binding_is_valid(&binding)
    matches = call @sa3d_input_action_binding_matches_event(&binding, &event)
    x = call @sa3d_input_event_axis_value(&event, SA3D_INPUT_AXIS_X)
    y = call @sa3d_input_event_axis_value(&event, SA3D_INPUT_AXIS_Y)
    z = call @sa3d_input_event_axis_value(&event, SA3D_INPUT_AXIS_Z)
    scaled = call @sa3d_input_action_binding_scaled_value(&binding, &event)
    call @sa3d_input_action_binding_init(&binding, 7, SA3D_INPUT_EVENT_POINTER, 2, 3, SA3D_INPUT_AXIS_X, 0, 0)
    mismatch = call @sa3d_input_action_binding_matches_event(&binding, &event)
    call @sa3d_input_action_binding_init(&binding, 7, SA3D_INPUT_EVENT_POINTER, 1, 3, 9, 0, 0)
    invalid_binding = call @sa3d_input_action_binding_is_valid(&binding)
    event_type_ok = call @sa3d_input_event_type_is_valid(SA3D_INPUT_EVENT_GAMEPAD)
    event_type_bad = call @sa3d_input_event_type_is_valid(9)
    state_ok = call @sa3d_input_state_is_valid(SA3D_INPUT_STATE_UP)
    state_bad = call @sa3d_input_state_is_valid(9)
    axis_ok = call @sa3d_input_axis_is_valid(SA3D_INPUT_AXIS_Y)
    axis_bad = call @sa3d_input_axis_is_valid(9)
    b0 = eq binding_valid, 1
    b1 = eq matches, 1
    b2 = eq x, 12
    b3 = eq y, -5
    b4 = eq z, 0
    b5 = eq scaled, 36
    b6 = eq mismatch, 0
    b7 = eq invalid_binding, 0
    b8 = eq event_type_ok, 1
    b9 = eq event_type_bad, 0
    b10 = eq state_ok, 1
    b11 = eq state_bad, 0
    b12 = eq axis_ok, 1
    b13 = eq axis_bad, 0
    p1 = and b0, b1
    p2 = and b2, b3
    p3 = and b4, b5
    p4 = and b6, b7
    p5 = and b8, b9
    p6 = and b10, b11
    p7 = and b12, b13
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    q4 = and q1, q2
    q5 = and q3, p7
    ok = and q4, q5
    br ok -> L_OK, L_ERR

L_OK:
    !binding
    !event
    return

L_ERR:
    !binding
    !event
    panic(3144)

@test "3d_input axes follow Bevy Axis clamp and remove semantics"():
L_ENTRY:
    axes = alloc SA3D_INPUT_AXES_SIZE
    call @sa3d_input_axes_reset(&axes)
    set0 = call @sa3d_input_axis_set(&axes, SA3D_INPUT_EVENT_GAMEPAD, 0, 10, 2.5)
    unclamped0 = call @sa3d_input_axis_get_unclamped(&axes, SA3D_INPUT_EVENT_GAMEPAD, 0, 10)
    clamped0 = call @sa3d_input_axis_get(&axes, SA3D_INPUT_EVENT_GAMEPAD, 0, 10)
    set1 = call @sa3d_input_axis_set(&axes, SA3D_INPUT_EVENT_GAMEPAD, 0, 10, -2.0)
    unclamped1 = call @sa3d_input_axis_get_unclamped(&axes, SA3D_INPUT_EVENT_GAMEPAD, 0, 10)
    clamped1 = call @sa3d_input_axis_get(&axes, SA3D_INPUT_EVENT_GAMEPAD, 0, 10)
    removed = call @sa3d_input_axis_remove(&axes, SA3D_INPUT_EVENT_GAMEPAD, 0, 10)
    after_remove = call @sa3d_input_axis_get_unclamped(&axes, SA3D_INPUT_EVENT_GAMEPAD, 0, 10)
    count = load axes+SA3D_INPUT_AXES_count as i64
    capacity_ok = eq SA3D_INPUT_AXES_CAPACITY, 64
    size_ok = eq SA3D_INPUT_AXES_SIZE, 1048
    set0_ok = eq set0, 1
    unclamped0_ok = fcmp_gt unclamped0, 2.49
    unclamped0_ok2 = fcmp_lt unclamped0, 2.51
    clamped0_ok = fcmp_eq clamped0, 1.0
    set1_ok = eq set1, 1
    unclamped1_ok = fcmp_gt unclamped1, -2.01
    unclamped1_ok2 = fcmp_lt unclamped1, -1.99
    clamped1_ok = fcmp_eq clamped1, -1.0
    removed_ok = fcmp_gt removed, -2.01
    removed_ok2 = fcmp_lt removed, -1.99
    after_remove_ok = fcmp_eq after_remove, 0.0
    count_ok = eq count, 1
    p1 = and capacity_ok, size_ok
    p2 = and set0_ok, unclamped0_ok
    p3 = and unclamped0_ok2, clamped0_ok
    p4 = and set1_ok, unclamped1_ok
    p5 = and unclamped1_ok2, clamped1_ok
    p6 = and removed_ok, removed_ok2
    p7 = and after_remove_ok, count_ok
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    r1 = and q1, q2
    r2 = and q3, p7
    ok = and r1, r2
    br ok -> L_OK, L_ERR

L_OK:
    !axes
    return

L_ERR:
    !axes
    panic(3145)
