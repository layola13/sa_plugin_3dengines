@import "../3d_math.sal"

@extern sa3d_math_selftest() -> i32
@extern sa3d_math_bounding_selftest() -> i32
@extern sa3d_math_transform_selftest() -> i32
@extern sa3d_math_vector_selftest() -> i32

@test "3d_math f32 min max use numeric ordering"():
L_ENTRY:
    min_v = call @sa3d_f32_min(-1.0, -4.0)
    max_v = call @sa3d_f32_max(-0.5, -2.0)
    bits = alloc 8
    store bits+0, min_v as f32
    store bits+4, max_v as f32
    min_bits = load bits+0 as i32
    max_bits = load bits+4 as i32
    min_ok = eq min_bits, -1065353216
    max_ok = eq max_bits, -1090519040
    ok = and min_ok, max_ok
    br ok -> L_OK, L_ERR

L_OK:
    !max_bits
    !min_bits
    !bits
    !max_v
    !min_v
    return

L_ERR:
    !max_bits
    !min_bits
    !bits
    !max_v
    !min_v
    panic(3041)

@test "3d_math f32 finite and trig live in SA"():
L_ENTRY:
    bits = alloc 8
    store bits+0, 2139095040 as i32
    inf = load bits+0 as f32
    finite_one = call @sa3d_f32_is_finite(1.0)
    finite_inf = call @sa3d_f32_is_finite(inf)
    sin_zero = call @sa3d_f32_sin(0.0)
    sin_half_pi = call @sa3d_f32_sin(1.57079633)
    sin_pi = call @sa3d_f32_sin(3.14159265)
    sin_three_half_pi = call @sa3d_f32_sin(4.71238898)
    cos_zero = call @sa3d_f32_cos(0.0)
    cos_pi = call @sa3d_f32_cos(3.14159265)
    cos_tau = call @sa3d_f32_cos(6.28318531)
    finite_one_ok = eq finite_one, 1
    finite_inf_ok = eq finite_inf, 0
    sin_zero_low = fcmp_gt sin_zero, -0.001
    sin_zero_high = fcmp_lt sin_zero, 0.001
    sin_half_low = fcmp_gt sin_half_pi, 0.999
    sin_half_high = fcmp_lt sin_half_pi, 1.001
    sin_pi_low = fcmp_gt sin_pi, -0.001
    sin_pi_high = fcmp_lt sin_pi, 0.001
    sin_three_low = fcmp_gt sin_three_half_pi, -1.001
    sin_three_high = fcmp_lt sin_three_half_pi, -0.999
    cos_zero_low = fcmp_gt cos_zero, 0.999
    cos_zero_high = fcmp_lt cos_zero, 1.001
    cos_pi_low = fcmp_gt cos_pi, -1.001
    cos_pi_high = fcmp_lt cos_pi, -0.999
    cos_tau_low = fcmp_gt cos_tau, 0.999
    cos_tau_high = fcmp_lt cos_tau, 1.001
    p1 = and finite_one_ok, finite_inf_ok
    p2 = and sin_zero_low, sin_zero_high
    p3 = and sin_half_low, sin_half_high
    p4 = and sin_pi_low, sin_pi_high
    p5 = and sin_three_low, sin_three_high
    p6 = and cos_zero_low, cos_zero_high
    p7 = and cos_pi_low, cos_pi_high
    p8 = and cos_tau_low, cos_tau_high
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    q4 = and p7, p8
    r1 = and q1, q2
    r2 = and q3, q4
    ok = and r1, r2
    br ok -> L_OK, L_ERR

L_OK:
    !bits
    return

L_ERR:
    !bits
    panic(3042)

@test "3d_math f32 inverse trig live in SA"():
L_ENTRY:
    abs_neg = call @sa3d_f32_abs(-3.0)
    atan_one = call @sa3d_f32_atan(1.0)
    atan_two = call @sa3d_f32_atan(2.0)
    atan_neg_two = call @sa3d_f32_atan(-2.0)
    atan2_q1 = call @sa3d_f32_atan2(1.0, 1.0)
    atan2_q2 = call @sa3d_f32_atan2(1.0, -1.0)
    atan2_up = call @sa3d_f32_atan2(1.0, 0.0)
    acos_zero = call @sa3d_f32_acos(0.0)
    acos_one = call @sa3d_f32_acos(1.0)
    acos_neg_one = call @sa3d_f32_acos(-1.0)
    acos_ico = call @sa3d_f32_acos(0.44721359)
    c0_low = fcmp_gt abs_neg, 2.999
    c0_high = fcmp_lt abs_neg, 3.001
    c1_low = fcmp_gt atan_one, 0.77
    c1_high = fcmp_lt atan_one, 0.79
    c2_low = fcmp_gt atan_two, 1.09
    c2_high = fcmp_lt atan_two, 1.12
    c3_low = fcmp_gt atan_neg_two, -1.12
    c3_high = fcmp_lt atan_neg_two, -1.09
    c4_low = fcmp_gt atan2_q1, 0.77
    c4_high = fcmp_lt atan2_q1, 0.79
    c5_low = fcmp_gt atan2_q2, 2.34
    c5_high = fcmp_lt atan2_q2, 2.37
    c6_low = fcmp_gt atan2_up, 1.56
    c6_high = fcmp_lt atan2_up, 1.58
    c7_low = fcmp_gt acos_zero, 1.56
    c7_high = fcmp_lt acos_zero, 1.58
    c8_low = fcmp_gt acos_one, -0.001
    c8_high = fcmp_lt acos_one, 0.001
    c9_low = fcmp_gt acos_neg_one, 3.13
    c9_high = fcmp_lt acos_neg_one, 3.15
    c10_low = fcmp_gt acos_ico, 1.09
    c10_high = fcmp_lt acos_ico, 1.12
    p0 = and c0_low, c0_high
    p1 = and c1_low, c1_high
    p2 = and c2_low, c2_high
    p3 = and c3_low, c3_high
    p4 = and c4_low, c4_high
    p5 = and c5_low, c5_high
    p6 = and c6_low, c6_high
    p7 = and c7_low, c7_high
    p8 = and c8_low, c8_high
    p9 = and c9_low, c9_high
    p10 = and c10_low, c10_high
    q0 = and p0, p1
    q1 = and p2, p3
    q2 = and p4, p5
    q3 = and p6, p7
    q4 = and p8, p9
    r0 = and q0, q1
    r1 = and q2, q3
    r2 = and q4, p10
    s0 = and r0, r1
    ok = and s0, r2
    br ok -> L_OK, L_ERR

L_OK:
    return

L_ERR:
    panic(3052)

@test "3d_math f32 sqrt and vec3 normalize in SA"():
L_ENTRY:
    v = alloc SA3D_VEC3_SIZE
    zero = alloc SA3D_VEC3_SIZE
    out = alloc SA3D_VEC3_SIZE
    zero_out = alloc SA3D_VEC3_SIZE
    store v+SA3D_VEC3_x, 3.0 as f32
    store v+SA3D_VEC3_y, 4.0 as f32
    store v+SA3D_VEC3_z, 0.0 as f32
    store zero+SA3D_VEC3_x, 0.0 as f32
    store zero+SA3D_VEC3_y, 0.0 as f32
    store zero+SA3D_VEC3_z, 0.0 as f32
    sqrt4 = call @sa3d_f32_sqrt(4.0)
    sqrt9 = call @sa3d_f32_sqrt(9.0)
    len = call @sa3d_vec3_length_f(&v)
    normalized = call @sa3d_vec3_normalize_f(&out, &v)
    zero_normalized = call @sa3d_vec3_normalize_f(&zero_out, &zero)
    ox = load out+SA3D_VEC3_x as f32
    oy = load out+SA3D_VEC3_y as f32
    oz = load out+SA3D_VEC3_z as i32
    zx = load zero_out+SA3D_VEC3_x as i32
    sqrt4_low = fcmp_gt sqrt4, 1.999
    sqrt4_high = fcmp_lt sqrt4, 2.001
    sqrt9_low = fcmp_gt sqrt9, 2.999
    sqrt9_high = fcmp_lt sqrt9, 3.001
    len_low = fcmp_gt len, 4.999
    len_high = fcmp_lt len, 5.001
    ox_low = fcmp_gt ox, 0.599
    ox_high = fcmp_lt ox, 0.601
    oy_low = fcmp_gt oy, 0.799
    oy_high = fcmp_lt oy, 0.801
    ok_norm = eq normalized, 1
    ok_zero_norm = eq zero_normalized, 0
    ok_oz = eq oz, 0
    ok_zx = eq zx, 0
    p1 = and sqrt4_low, sqrt4_high
    p2 = and sqrt9_low, sqrt9_high
    p3 = and len_low, len_high
    p4 = and ox_low, ox_high
    p5 = and oy_low, oy_high
    p6 = and ok_norm, ok_zero_norm
    p7 = and ok_oz, ok_zx
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    r1 = and q1, q2
    r2 = and q3, p7
    ok = and r1, r2
    br ok -> L_OK, L_ERR

L_OK:
    !zero_out
    !out
    !zero
    !v
    return

L_ERR:
    !zero_out
    !out
    !zero
    !v
    panic(3046)

@test "3d_math quaternion rotation arc y to normal in SA"():
L_ENTRY:
    normal_z = alloc SA3D_VEC3_SIZE
    normal_neg_y = alloc SA3D_VEC3_SIZE
    y_vec = alloc SA3D_VEC3_SIZE
    local = alloc SA3D_VEC3_SIZE
    q = alloc SA3D_QUAT_SIZE
    q_opposite = alloc SA3D_QUAT_SIZE
    out_y = alloc SA3D_VEC3_SIZE
    out_local = alloc SA3D_VEC3_SIZE
    out_opposite = alloc SA3D_VEC3_SIZE
    store normal_z+SA3D_VEC3_x, 0.0 as f32
    store normal_z+SA3D_VEC3_y, 0.0 as f32
    store normal_z+SA3D_VEC3_z, 1.0 as f32
    store normal_neg_y+SA3D_VEC3_x, 0.0 as f32
    store normal_neg_y+SA3D_VEC3_y, -1.0 as f32
    store normal_neg_y+SA3D_VEC3_z, 0.0 as f32
    store y_vec+SA3D_VEC3_x, 0.0 as f32
    store y_vec+SA3D_VEC3_y, 1.0 as f32
    store y_vec+SA3D_VEC3_z, 0.0 as f32
    store local+SA3D_VEC3_x, -1.0 as f32
    store local+SA3D_VEC3_y, 0.0 as f32
    store local+SA3D_VEC3_z, -1.0 as f32
    call @sa3d_quat_from_rotation_arc_y_to(&q, &normal_z)
    call @sa3d_quat_rotate_vec3_f(&out_y, &q, &y_vec)
    call @sa3d_quat_rotate_vec3_f(&out_local, &q, &local)
    call @sa3d_quat_from_rotation_arc_y_to(&q_opposite, &normal_neg_y)
    call @sa3d_quat_rotate_vec3_f(&out_opposite, &q_opposite, &y_vec)
    oy_x = load out_y+SA3D_VEC3_x as f32
    oy_y = load out_y+SA3D_VEC3_y as f32
    oy_z = load out_y+SA3D_VEC3_z as f32
    ol_x = load out_local+SA3D_VEC3_x as f32
    ol_y = load out_local+SA3D_VEC3_y as f32
    ol_z = load out_local+SA3D_VEC3_z as f32
    oo_y = load out_opposite+SA3D_VEC3_y as f32
    oy_x_low = fcmp_gt oy_x, -0.001
    oy_x_high = fcmp_lt oy_x, 0.001
    oy_y_low = fcmp_gt oy_y, -0.001
    oy_y_high = fcmp_lt oy_y, 0.001
    oy_z_low = fcmp_gt oy_z, 0.999
    oy_z_high = fcmp_lt oy_z, 1.001
    ol_x_low = fcmp_gt ol_x, -1.001
    ol_x_high = fcmp_lt ol_x, -0.999
    ol_y_low = fcmp_gt ol_y, 0.999
    ol_y_high = fcmp_lt ol_y, 1.001
    ol_z_low = fcmp_gt ol_z, -0.001
    ol_z_high = fcmp_lt ol_z, 0.001
    oo_y_low = fcmp_gt oo_y, -1.001
    oo_y_high = fcmp_lt oo_y, -0.999
    p1 = and oy_x_low, oy_x_high
    p2 = and oy_y_low, oy_y_high
    p3 = and oy_z_low, oy_z_high
    p4 = and ol_x_low, ol_x_high
    p5 = and ol_y_low, ol_y_high
    p6 = and ol_z_low, ol_z_high
    p7 = and oo_y_low, oo_y_high
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    r1 = and q1, q2
    r2 = and q3, p7
    ok = and r1, r2
    br ok -> L_OK, L_ERR

L_OK:
    !out_opposite
    !out_local
    !out_y
    !q_opposite
    !q
    !local
    !y_vec
    !normal_neg_y
    !normal_z
    return

L_ERR:
    !out_opposite
    !out_local
    !out_y
    !q_opposite
    !q
    !local
    !y_vec
    !normal_neg_y
    !normal_z
    panic(3048)

@test "3d_math vec and matrix layouts"():
L_ENTRY:
    vec = alloc SA3D_VEC4_SIZE
    store vec+SA3D_VEC4_x, 1065353216 as i32
    store vec+SA3D_VEC4_y, 1073741824 as i32
    store vec+SA3D_VEC4_z, 1077936128 as i32
    store vec+SA3D_VEC4_w, 1082130432 as i32
    w_bits = load vec+SA3D_VEC4_w as i32
    w_ok = eq w_bits, 1082130432
    br w_ok -> L_CHECK_MATRIX, L_ERR

L_CHECK_MATRIX:
    mat = alloc SA3D_MAT4_SIZE
    store mat+SA3D_MAT4_col3, 1091567616 as i32
    col3_bits = load mat+48 as i32
    col3_ok = eq col3_bits, 1091567616
    br col3_ok -> L_CHECK_SIZE, L_ERR

L_CHECK_SIZE:
    size_ok = eq SA3D_MAT4_SIZE, 64
    br size_ok -> L_OK, L_ERR

L_OK:
    !size_ok
    !col3_bits
    !col3_ok
    !mat
    !w_ok
    !w_bits
    !vec
    return

L_ERR:
    panic(3001)

@test "3d_math constructors and matrix helpers"():
L_ENTRY:
    vec = alloc SA3D_VEC3_SIZE
    quat = alloc SA3D_QUAT_SIZE
    mat = alloc SA3D_MAT4_SIZE
    scale = alloc SA3D_VEC3_SIZE
    call @sa3d_vec3_set(&vec, 1065353216, 1073741824, 1077936128)
    call @sa3d_quat_identity(&quat)
    call @sa3d_mat4_from_translation(&mat, &vec)
    vx = load vec+SA3D_VEC3_x as i32
    vy = load vec+SA3D_VEC3_y as i32
    vz = load vec+SA3D_VEC3_z as i32
    qw = load quat+SA3D_QUAT_w as i32
    m00 = load mat+0 as i32
    m30 = load mat+48 as i32
    m31 = load mat+52 as i32
    m32 = load mat+56 as i32
    call @sa3d_vec3_set(&scale, 1073741824, 1077936128, 1082130432)
    call @sa3d_mat4_from_scale_translation(&mat, &scale, &vec)
    sm00 = load mat+0 as i32
    sm11 = load mat+20 as i32
    sm22 = load mat+40 as i32
    sm33 = load mat+60 as i32
    sm30 = load mat+48 as i32
    vx_ok = eq vx, 1065353216
    vy_ok = eq vy, 1073741824
    vz_ok = eq vz, 1077936128
    quat_ok = eq qw, SA3D_F32_ONE_BITS
    ident_ok = eq m00, SA3D_F32_ONE_BITS
    tx_ok = eq m30, 1065353216
    ty_ok = eq m31, 1073741824
    tz_ok = eq m32, 1077936128
    sx_ok = eq sm00, 1073741824
    sy_ok = eq sm11, 1077936128
    sz_ok = eq sm22, 1082130432
    sw_ok = eq sm33, SA3D_F32_ONE_BITS
    stx_ok = eq sm30, 1065353216
    p1 = and vx_ok, vy_ok
    p2 = and vz_ok, quat_ok
    p3 = and ident_ok, tx_ok
    p4 = and ty_ok, tz_ok
    p5 = and sx_ok, sy_ok
    p6 = and sz_ok, sw_ok
    p7 = and stx_ok, p6
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p7
    r1 = and q1, q2
    ok = and r1, q3
    br ok -> L_MATH_OK, L_MATH_ERR

L_MATH_OK:
    !scale
    !mat
    !quat
    !vec
    return

L_MATH_ERR:
    !scale
    !mat
    !quat
    !vec
    panic(3002)

@test "3d_math aabb set and union"():
L_ENTRY:
    min0 = alloc SA3D_VEC3_SIZE
    max0 = alloc SA3D_VEC3_SIZE
    min1 = alloc SA3D_VEC3_SIZE
    max1 = alloc SA3D_VEC3_SIZE
    a = alloc SA3D_AABB_SIZE
    b = alloc SA3D_AABB_SIZE
    out = alloc SA3D_AABB_SIZE
    call @sa3d_vec3_set(&min0, -1082130432, 0, 1065353216)
    call @sa3d_vec3_set(&max0, 1073741824, 1077936128, 1082130432)
    call @sa3d_vec3_set(&min1, -1073741824, 1065353216, 0)
    call @sa3d_vec3_set(&max1, 1084227584, 1073741824, 1086324736)
    call @sa3d_aabb_set(&a, &min0, &max0)
    call @sa3d_aabb_set(&b, &min1, &max1)
    call @sa3d_aabb_union(&out, &a, &b)
    out_min = ptr_add out, SA3D_AABB_min
    out_max = ptr_add out, SA3D_AABB_max
    out_min_x = load out_min+SA3D_VEC3_x as i32
    out_min_y = load out_min+SA3D_VEC3_y as i32
    out_min_z = load out_min+SA3D_VEC3_z as i32
    out_max_x = load out_max+SA3D_VEC3_x as i32
    out_max_y = load out_max+SA3D_VEC3_y as i32
    out_max_z = load out_max+SA3D_VEC3_z as i32
    min_x_ok = eq out_min_x, -1082130432
    min_y_ok = eq out_min_y, 0
    min_z_ok = eq out_min_z, 0
    max_x_ok = eq out_max_x, 1084227584
    max_y_ok = eq out_max_y, 1077936128
    max_z_ok = eq out_max_z, 1086324736
    p1 = and min_x_ok, min_y_ok
    p2 = and min_z_ok, max_x_ok
    p3 = and max_y_ok, max_z_ok
    q1 = and p1, p2
    ok = and q1, p3
    br ok -> L_AABB_OK, L_AABB_ERR

L_AABB_OK:
    !out_max
    !out_min
    !out
    !b
    !a
    !max1
    !min1
    !max0
    !min0
    return

L_AABB_ERR:
    !out_max
    !out_min
    !out
    !b
    !a
    !max1
    !min1
    !max0
    !min0
    panic(3003)

@test "3d_math vec3 arithmetic dot and cross"():
L_ENTRY:
    a = alloc SA3D_VEC3_SIZE
    b = alloc SA3D_VEC3_SIZE
    out = alloc SA3D_VEC3_SIZE
    cross = alloc SA3D_VEC3_SIZE
    call @sa3d_vec3_set(&a, 1, 2, 3)
    call @sa3d_vec3_set(&b, 4, 5, 6)
    call @sa3d_vec3_add(&out, &a, &b)
    add_x = load out+SA3D_VEC3_x as i32
    add_y = load out+SA3D_VEC3_y as i32
    add_z = load out+SA3D_VEC3_z as i32
    call @sa3d_vec3_sub(&out, &b, &a)
    sub_x = load out+SA3D_VEC3_x as i32
    sub_y = load out+SA3D_VEC3_y as i32
    sub_z = load out+SA3D_VEC3_z as i32
    dot = call @sa3d_vec3_dot(&a, &b)
    len_sq = call @sa3d_vec3_length_squared(&a)
    call @sa3d_vec3_cross(&cross, &a, &b)
    cx = load cross+SA3D_VEC3_x as i32
    cy = load cross+SA3D_VEC3_y as i32
    cz = load cross+SA3D_VEC3_z as i32
    add_x_ok = eq add_x, 5
    add_y_ok = eq add_y, 7
    add_z_ok = eq add_z, 9
    sub_x_ok = eq sub_x, 3
    sub_y_ok = eq sub_y, 3
    sub_z_ok = eq sub_z, 3
    dot_ok = eq dot, 32
    len_ok = eq len_sq, 14
    cx_ok = eq cx, -3
    cy_ok = eq cy, 6
    cz_ok = eq cz, -3
    p1 = and add_x_ok, add_y_ok
    p2 = and add_z_ok, sub_x_ok
    p3 = and sub_y_ok, sub_z_ok
    p4 = and dot_ok, len_ok
    p5 = and cx_ok, cy_ok
    p6 = and cz_ok, p5
    q1 = and p1, p2
    q2 = and p3, p4
    r1 = and q1, q2
    ok = and r1, p6
    br ok -> L_VEC_OK, L_VEC_ERR

L_VEC_OK:
    !cross
    !out
    !b
    !a
    return

L_VEC_ERR:
    !cross
    !out
    !b
    !a
    panic(3004)

@test "3d_math mat4 transform point3"():
L_ENTRY:
    point = alloc SA3D_VEC3_SIZE
    mat = alloc SA3D_MAT4_SIZE
    out = alloc SA3D_VEC3_SIZE
    call @sa3d_mat4_zero(&mat)
    store mat+0, 2 as i32
    store mat+20, 3 as i32
    store mat+40, 4 as i32
    store mat+48, 5 as i32
    store mat+52, 6 as i32
    store mat+56, 7 as i32
    store mat+60, 1 as i32
    call @sa3d_vec3_set(&point, 1, 2, 3)
    call @sa3d_mat4_transform_point3(&out, &mat, &point)
    x = load out+SA3D_VEC3_x as i32
    y = load out+SA3D_VEC3_y as i32
    z = load out+SA3D_VEC3_z as i32
    x_ok = eq x, 7
    y_ok = eq y, 12
    z_ok = eq z, 19
    p1 = and x_ok, y_ok
    ok = and p1, z_ok
    br ok -> L_MAT_OK, L_MAT_ERR

L_MAT_OK:
    !out
    !mat
    !point
    return

L_MAT_ERR:
    !out
    !mat
    !point
    panic(3005)

@test "3d_math vec2 and vec4 arithmetic"():
L_ENTRY:
    a2 = alloc SA3D_VEC2_SIZE
    b2 = alloc SA3D_VEC2_SIZE
    out2 = alloc SA3D_VEC2_SIZE
    a4 = alloc SA3D_VEC4_SIZE
    b4 = alloc SA3D_VEC4_SIZE
    out4 = alloc SA3D_VEC4_SIZE
    call @sa3d_vec2_set(&a2, 3, 4)
    call @sa3d_vec2_set(&b2, -1, 2)
    call @sa3d_vec2_add(&out2, &a2, &b2)
    add2_x = load out2+SA3D_VEC2_x as i32
    add2_y = load out2+SA3D_VEC2_y as i32
    call @sa3d_vec2_sub(&out2, &a2, &b2)
    sub2_x = load out2+SA3D_VEC2_x as i32
    sub2_y = load out2+SA3D_VEC2_y as i32
    dot2 = call @sa3d_vec2_dot(&a2, &b2)
    len2 = call @sa3d_vec2_length_squared(&a2)
    call @sa3d_vec4_set(&a4, 1, 2, 3, 4)
    call @sa3d_vec4_set(&b4, 5, 6, 7, 8)
    call @sa3d_vec4_add(&out4, &a4, &b4)
    add4_x = load out4+SA3D_VEC4_x as i32
    add4_w = load out4+SA3D_VEC4_w as i32
    call @sa3d_vec4_sub(&out4, &b4, &a4)
    sub4_y = load out4+SA3D_VEC4_y as i32
    sub4_z = load out4+SA3D_VEC4_z as i32
    dot4 = call @sa3d_vec4_dot(&a4, &b4)
    len4 = call @sa3d_vec4_length_squared(&a4)
    add2_x_ok = eq add2_x, 2
    add2_y_ok = eq add2_y, 6
    sub2_x_ok = eq sub2_x, 4
    sub2_y_ok = eq sub2_y, 2
    dot2_ok = eq dot2, 5
    len2_ok = eq len2, 25
    add4_x_ok = eq add4_x, 6
    add4_w_ok = eq add4_w, 12
    sub4_y_ok = eq sub4_y, 4
    sub4_z_ok = eq sub4_z, 4
    dot4_ok = eq dot4, 70
    len4_ok = eq len4, 30
    p1 = and add2_x_ok, add2_y_ok
    p2 = and sub2_x_ok, sub2_y_ok
    p3 = and dot2_ok, len2_ok
    p4 = and add4_x_ok, add4_w_ok
    p5 = and sub4_y_ok, sub4_z_ok
    p6 = and dot4_ok, len4_ok
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    r1 = and q1, q2
    ok = and r1, q3
    br ok -> L_VEC24_OK, L_VEC24_ERR

L_VEC24_OK:
    !out4
    !b4
    !a4
    !out2
    !b2
    !a2
    return

L_VEC24_ERR:
    !out4
    !b4
    !a4
    !out2
    !b2
    !a2
    panic(3006)

@test "3d_math mat4 copy and multiply"():
L_ENTRY:
    lhs = alloc SA3D_MAT4_SIZE
    rhs = alloc SA3D_MAT4_SIZE
    out = alloc SA3D_MAT4_SIZE
    copy = alloc SA3D_MAT4_SIZE
    call @sa3d_mat4_zero(&lhs)
    call @sa3d_mat4_zero(&rhs)
    store lhs+0, 1073741824 as i32
    store lhs+20, 1077936128 as i32
    store lhs+40, 1082130432 as i32
    store lhs+60, 1065353216 as i32
    store rhs+0, 1065353216 as i32
    store rhs+20, 1065353216 as i32
    store rhs+40, 1065353216 as i32
    store rhs+48, 1084227584 as i32
    store rhs+52, 1086324736 as i32
    store rhs+56, 1088421888 as i32
    store rhs+60, 1065353216 as i32
    call @sa3d_mat4_mul(&out, &lhs, &rhs)
    call @sa3d_mat4_copy(&copy, &out)
    m00 = load copy+0 as i32
    m11 = load copy+20 as i32
    m22 = load copy+40 as i32
    tx = load copy+48 as i32
    ty = load copy+52 as i32
    tz = load copy+56 as i32
    m33 = load copy+60 as i32
    m00_ok = eq m00, 1073741824
    m11_ok = eq m11, 1077936128
    m22_ok = eq m22, 1082130432
    tx_ok = eq tx, 1092616192
    ty_ok = eq ty, 1099956224
    tz_ok = eq tz, 1105199104
    m33_ok = eq m33, 1065353216
    p1 = and m00_ok, m11_ok
    p2 = and m22_ok, tx_ok
    p3 = and ty_ok, tz_ok
    p4 = and p3, m33_ok
    q1 = and p1, p2
    ok = and q1, p4
    br ok -> L_MUL_OK, L_MUL_ERR

L_MUL_OK:
    !copy
    !out
    !rhs
    !lhs
    return

L_MUL_ERR:
    !copy
    !out
    !rhs
    !lhs
    panic(3007)

@test "3d_math aabb queries and ray3 layout"():
L_ENTRY:
    min0 = alloc SA3D_VEC3_SIZE
    max0 = alloc SA3D_VEC3_SIZE
    min1 = alloc SA3D_VEC3_SIZE
    max1 = alloc SA3D_VEC3_SIZE
    min2 = alloc SA3D_VEC3_SIZE
    max2 = alloc SA3D_VEC3_SIZE
    point_inside = alloc SA3D_VEC3_SIZE
    point_outside = alloc SA3D_VEC3_SIZE
    center = alloc SA3D_VEC3_SIZE
    extents = alloc SA3D_VEC3_SIZE
    ray = alloc SA3D_RAY3_SIZE
    a = alloc SA3D_AABB_SIZE
    b = alloc SA3D_AABB_SIZE
    c = alloc SA3D_AABB_SIZE
    call @sa3d_vec3_set(&min0, -2, -4, -6)
    call @sa3d_vec3_set(&max0, 8, 10, 12)
    call @sa3d_vec3_set(&min1, 7, 9, 11)
    call @sa3d_vec3_set(&max1, 20, 21, 22)
    call @sa3d_vec3_set(&min2, 30, 30, 30)
    call @sa3d_vec3_set(&max2, 40, 40, 40)
    call @sa3d_aabb_set(&a, &min0, &max0)
    call @sa3d_aabb_set(&b, &min1, &max1)
    call @sa3d_aabb_set(&c, &min2, &max2)
    call @sa3d_vec3_set(&point_inside, 0, 0, 0)
    call @sa3d_vec3_set(&point_outside, 9, 0, 0)
    contains_inside = call @sa3d_aabb_contains_point3(&a, &point_inside)
    contains_outside = call @sa3d_aabb_contains_point3(&a, &point_outside)
    intersects_b = call @sa3d_aabb_intersects(&a, &b)
    intersects_c = call @sa3d_aabb_intersects(&a, &c)
    call @sa3d_aabb_center(&center, &a)
    call @sa3d_aabb_extents(&extents, &a)
    call @sa3d_ray3_set(&ray, &point_inside, &point_outside)
    cx = load center+SA3D_VEC3_x as i32
    cy = load center+SA3D_VEC3_y as i32
    cz = load center+SA3D_VEC3_z as i32
    ex = load extents+SA3D_VEC3_x as i32
    ey = load extents+SA3D_VEC3_y as i32
    ez = load extents+SA3D_VEC3_z as i32
    ray_origin = ptr_add ray, SA3D_RAY3_origin
    ray_direction = ptr_add ray, SA3D_RAY3_direction
    rox = load ray_origin+SA3D_VEC3_x as i32
    rdx = load ray_direction+SA3D_VEC3_x as i32
    contains_inside_ok = eq contains_inside, 1
    contains_outside_ok = eq contains_outside, 0
    intersects_b_ok = eq intersects_b, 1
    intersects_c_ok = eq intersects_c, 0
    cx_ok = eq cx, 3
    cy_ok = eq cy, 3
    cz_ok = eq cz, 3
    ex_ok = eq ex, 10
    ey_ok = eq ey, 14
    ez_ok = eq ez, 18
    rox_ok = eq rox, 0
    rdx_ok = eq rdx, 9
    p1 = and contains_inside_ok, contains_outside_ok
    p2 = and intersects_b_ok, intersects_c_ok
    p3 = and cx_ok, cy_ok
    p4 = and cz_ok, ex_ok
    p5 = and ey_ok, ez_ok
    p6 = and rox_ok, rdx_ok
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    r1 = and q1, q2
    ok = and r1, q3
    br ok -> L_AABB_QUERY_OK, L_AABB_QUERY_ERR

L_AABB_QUERY_OK:
    !ray_direction
    !ray_origin
    !c
    !b
    !a
    !ray
    !extents
    !center
    !point_outside
    !point_inside
    !max2
    !min2
    !max1
    !min1
    !max0
    !min0
    return

L_AABB_QUERY_ERR:
    !ray_direction
    !ray_origin
    !c
    !b
    !a
    !ray
    !extents
    !center
    !point_outside
    !point_inside
    !max2
    !min2
    !max1
    !min1
    !max0
    !min0
    panic(3008)

@test "3d_math pure sa float algorithms"():
L_ENTRY:
    a = alloc SA3D_VEC3_SIZE
    b = alloc SA3D_VEC3_SIZE
    cross = alloc SA3D_VEC3_SIZE
    q_identity = alloc SA3D_QUAT_SIZE
    q = alloc SA3D_QUAT_SIZE
    q_out = alloc SA3D_QUAT_SIZE
    scale = alloc SA3D_VEC3_SIZE
    translation = alloc SA3D_VEC3_SIZE
    mat = alloc SA3D_MAT4_SIZE
    call @sa3d_vec3_set(&a, 1065353216, 1073741824, 1077936128)
    call @sa3d_vec3_set(&b, 1082130432, 1084227584, 1086324736)
    dot = call @sa3d_vec3_dot_f(&a, &b)
    len2 = call @sa3d_vec3_length_squared_f(&a)
    call @sa3d_vec3_cross_f(&cross, &a, &b)
    dot_bits_box = alloc 4
    len_bits_box = alloc 4
    store dot_bits_box+0, dot as f32
    store len_bits_box+0, len2 as f32
    dot_bits = load dot_bits_box+0 as i32
    len_bits = load len_bits_box+0 as i32
    cx = load cross+SA3D_VEC3_x as i32
    cy = load cross+SA3D_VEC3_y as i32
    cz = load cross+SA3D_VEC3_z as i32
    call @sa3d_quat_identity(&q_identity)
    call @sa3d_quat_set(&q, 0.0, 0.0, 0.0, 1.0)
    call @sa3d_quat_mul(&q_out, &q_identity, &q)
    q_len2 = call @sa3d_quat_length_squared(&q_out)
    q_len_box = alloc 4
    store q_len_box+0, q_len2 as f32
    q_len_bits = load q_len_box+0 as i32
    qx = load q_out+SA3D_QUAT_x as i32
    qy = load q_out+SA3D_QUAT_y as i32
    qz = load q_out+SA3D_QUAT_z as i32
    qw = load q_out+SA3D_QUAT_w as i32
    call @sa3d_vec3_set(&scale, 1073741824, 1077936128, 1082130432)
    call @sa3d_vec3_set(&translation, 1084227584, 1086324736, 1088421888)
    call @sa3d_mat4_from_scale_rotation_translation(&mat, &scale, &q_identity, &translation)
    m00 = load mat+0 as i32
    m11 = load mat+20 as i32
    m22 = load mat+40 as i32
    m30 = load mat+48 as i32
    m31 = load mat+52 as i32
    m32 = load mat+56 as i32
    m33 = load mat+60 as i32
    dot_ok = eq dot_bits, 1107296256
    len_ok = eq len_bits, 1096810496
    cx_ok = eq cx, -1069547520
    cy_ok = eq cy, 1086324736
    cz_ok = eq cz, -1069547520
    qx_ok = eq qx, 0
    qy_ok = eq qy, 0
    qz_ok = eq qz, 0
    qw_ok = eq qw, SA3D_F32_ONE_BITS
    q_len_ok = eq q_len_bits, SA3D_F32_ONE_BITS
    m00_ok = eq m00, 1073741824
    m11_ok = eq m11, 1077936128
    m22_ok = eq m22, 1082130432
    m30_ok = eq m30, 1084227584
    m31_ok = eq m31, 1086324736
    m32_ok = eq m32, 1088421888
    m33_ok = eq m33, SA3D_F32_ONE_BITS
    p1 = and dot_ok, len_ok
    p2 = and cx_ok, cy_ok
    p3 = and cz_ok, qx_ok
    p4 = and qy_ok, qz_ok
    p5 = and qw_ok, q_len_ok
    p6 = and m00_ok, m11_ok
    p7 = and m22_ok, m30_ok
    p8 = and m31_ok, m32_ok
    p9 = and m33_ok, p8
    q1 = and p1, p2
    q2 = and p3, p4
    q3 = and p5, p6
    q4 = and p7, p9
    r1 = and q1, q2
    r2 = and q3, q4
    ok = and r1, r2
    br ok -> L_FLOAT_OK, L_FLOAT_ERR

L_FLOAT_OK:
    !q_len_box
    !len_bits_box
    !dot_bits_box
    !mat
    !translation
    !scale
    !q_out
    !q
    !q_identity
    !cross
    !b
    !a
    return

L_FLOAT_ERR:
    !q_len_box
    !len_bits_box
    !dot_bits_box
    !mat
    !translation
    !scale
    !q_out
    !q
    !q_identity
    !cross
    !b
    !a
    panic(3013)

@test "3d_math bevy backed native selftest"():
L_ENTRY:
    status = call @sa3d_math_selftest()
    ok = eq status, 0
