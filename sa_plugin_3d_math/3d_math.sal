    store dst+32, o20 as f32
    store dst+36, o21 as f32
    store dst+40, o22 as f32
    store dst+44, o23 as f32
    store dst+48, o30 as f32
    store dst+52, o31 as f32
    store dst+56, o32 as f32
    store dst+60, o33 as f32
    !o33
    !o32
    !o31
    !o30
    !o23
    !o22
    !o21
