@sa3d_aabb_set(&aabb: ptr, &min_vec: ptr, &max_vec: ptr) -> void:
L_ENTRY:
    dst_min = ptr_add aabb, SA3D_AABB_min
    dst_max = ptr_add aabb, SA3D_AABB_max
    min_x = load min_vec+SA3D_VEC3_x as i32
    min_y = load min_vec+SA3D_VEC3_y as i32
    min_z = load min_vec+SA3D_VEC3_z as i32
    max_x = load max_vec+SA3D_VEC3_x as i32
    max_y = load max_vec+SA3D_VEC3_y as i32
    max_z = load max_vec+SA3D_VEC3_z as i32
    store dst_min+SA3D_VEC3_x, min_x as i32
    store dst_min+SA3D_VEC3_y, min_y as i32
    store dst_min+SA3D_VEC3_z, min_z as i32
    store dst_min+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    store dst_max+SA3D_VEC3_x, max_x as i32
    store dst_max+SA3D_VEC3_y, max_y as i32
    store dst_max+SA3D_VEC3_z, max_z as i32
    store dst_max+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    !min_x
    !min_y
    !min_z
    !max_x
    !max_y
    !max_z
    !max_vec
    !min_vec
    !dst_max
    !dst_min
    !aabb
    return

@sa3d_i32_min(a: i32, b: i32) -> i32:
L_ENTRY:
    take_a = slt a, b
    br take_a -> L_A, L_B

L_A:
    !take_a
    !b
    return a

L_B:
    !take_a
    !a
    return b

@sa3d_i32_max(a: i32, b: i32) -> i32:
L_ENTRY:
    take_a = sgt a, b
    br take_a -> L_A, L_B

L_A:
    !take_a
    !b
    return a

L_B:
    !take_a
    !a
    return b

@sa3d_f32_min(a: f32, b: f32) -> f32:
L_ENTRY:
    take_a = fcmp_lt a, b
    br take_a -> L_A, L_B

L_A:
    !take_a
    !b
    return a

L_B:
    !take_a
    !a
    return b

@sa3d_f32_max(a: f32, b: f32) -> f32:
L_ENTRY:
    take_a = fcmp_gt a, b
    br take_a -> L_A, L_B

L_A:
    !take_a
    !b
    return a

L_B:
    !take_a
    !a
    return b

@sa3d_f32_pi() -> f32:
L_ENTRY:
    return 3.14159265

@sa3d_f32_tau() -> f32:
L_ENTRY:
    return 6.28318531

@sa3d_f32_is_finite(value: f32) -> i32:
L_ENTRY:
    bits_slot = stack_alloc 4
    store bits_slot+0, value as f32
    bits = load bits_slot+0 as i32
    abs_bits = and bits, 2147483647
    finite = slt abs_bits, 2139095040
    !abs_bits
    !bits
    !value
    return finite

@sa3d_f32_wrap_pi(value: f32) -> f32:
L_ENTRY:
    x_slot = stack_alloc 4
    store x_slot+0, value as f32
    !value
    jmp L_HIGH_HEAD

L_HIGH_HEAD:
    x = load x_slot+0 as f32
    high = fcmp_gt x, 3.14159265
    br high -> L_HIGH_BODY, L_HIGH_DONE

L_HIGH_BODY:
    x_body = load x_slot+0 as f32
    next = fsub x_body, 6.28318531
    store x_slot+0, next as f32
    !next
    !x_body
    !high
    !x
    jmp L_HIGH_HEAD

L_HIGH_DONE:
    !high
    !x
    jmp L_LOW_HEAD

L_LOW_HEAD:
    x_low = load x_slot+0 as f32
    low = fcmp_lt x_low, -3.14159265
    br low -> L_LOW_BODY, L_DONE

L_LOW_BODY:
    x_body2 = load x_slot+0 as f32
    next2 = fadd x_body2, 6.28318531
    store x_slot+0, next2 as f32
    !next2
    !x_body2
    !low
    !x_low
    jmp L_LOW_HEAD

L_DONE:
    out = load x_slot+0 as f32
    !low
    !x_low
    return out

@sa3d_f32_sin(value: f32) -> f32:
L_ENTRY:
    x_slot = stack_alloc 4
    wrapped = call @sa3d_f32_wrap_pi(value)
    store x_slot+0, wrapped as f32
    !wrapped
    !value
    jmp L_HIGH_CHECK

L_HIGH_CHECK:
    x_high = load x_slot+0 as f32
    high = fcmp_gt x_high, 1.57079633
    br high -> L_HIGH_FOLD, L_HIGH_DONE

L_HIGH_FOLD:
    x_body = load x_slot+0 as f32
    folded = fsub 3.14159265, x_body
    store x_slot+0, folded as f32
    !folded
    !x_body
    !high
    !x_high
    jmp L_LOW_CHECK

L_HIGH_DONE:
    !high
    !x_high
    jmp L_LOW_CHECK

L_LOW_CHECK:
    x_low = load x_slot+0 as f32
    low = fcmp_lt x_low, -1.57079633
    br low -> L_LOW_FOLD, L_LOW_DONE

L_LOW_FOLD:
    x_body2 = load x_slot+0 as f32
    folded2 = fsub -3.14159265, x_body2
    store x_slot+0, folded2 as f32
    !folded2
    !x_body2
    !low
    !x_low
    jmp L_COMPUTE

L_LOW_DONE:
    !low
    !x_low
    jmp L_COMPUTE

L_COMPUTE:
    x = load x_slot+0 as f32
    x2 = fmul x, x
    x3 = fmul x2, x
    t3 = fmul x3, 0.16666667
    x5 = fmul x3, x2
    t5 = fmul x5, 0.0083333333
    x7 = fmul x5, x2
    t7 = fmul x7, 0.0001984127
    x9 = fmul x7, x2
    t9 = fmul x9, 0.0000027557319
    a = fsub x, t3
    b = fadd a, t5
    c = fsub b, t7
    out = fadd c, t9
    !c
    !b
    !a
    !t9
    !x9
    !t7
    !x7
    !t5
    !x5
    !t3
    !x3
    !x2
    !x
    return out

@sa3d_f32_cos(value: f32) -> f32:
L_ENTRY:
    shifted = fadd value, 1.57079633
    out = call @sa3d_f32_sin(shifted)
    !shifted
    !value
    return out

@sa3d_f32_abs(value: f32) -> f32:
L_ENTRY:
    neg = fcmp_lt value, 0.0
    br neg -> L_NEG, L_POS

L_NEG:
    out = fneg value
    !neg
    return out

L_POS:
    !neg
    return value

@sa3d_f32_atan_poly(value: f32) -> f32:
L_ENTRY:
    x2 = fmul value, value
    den_part = fmul x2, 0.28
    denom = fadd 1.0, den_part
    out = fdiv value, denom
    !denom
    !den_part
    !x2
    !value
    return out

@sa3d_f32_atan(value: f32) -> f32:
L_ENTRY:
    gt_one = fcmp_gt value, 1.0
    br gt_one -> L_GT_ONE, L_CHECK_LT

L_GT_ONE:
    inv = fdiv 1.0, value
    inner = call @sa3d_f32_atan_poly(inv)
    out = fsub 1.57079633, inner
    !inner
    !inv
    !gt_one
    !value
    return out

L_CHECK_LT:
    lt_neg_one = fcmp_lt value, -1.0
    br lt_neg_one -> L_LT_NEG_ONE, L_POLY

L_LT_NEG_ONE:
    inv = fdiv 1.0, value
    inner = call @sa3d_f32_atan_poly(inv)
    out = fsub -1.57079633, inner
    !inner
    !inv
    !lt_neg_one
    !gt_one
    !value
    return out

L_POLY:
    out = call @sa3d_f32_atan_poly(value)
    !lt_neg_one
    !gt_one
    !value
    return out

@sa3d_f32_atan2(y: f32, x: f32) -> f32:
L_ENTRY:
    x_pos = fcmp_gt x, 0.0
    br x_pos -> L_X_POS, L_CHECK_X_NEG

L_X_POS:
    ratio = fdiv y, x
    out = call @sa3d_f32_atan(ratio)
    !ratio
    !x_pos
    !x
    !y
    return out

L_CHECK_X_NEG:
    x_neg = fcmp_lt x, 0.0
    br x_neg -> L_X_NEG, L_X_ZERO

L_X_NEG:
    ratio = fdiv y, x
    base = call @sa3d_f32_atan(ratio)
    y_neg = fcmp_lt y, 0.0
    br y_neg -> L_X_NEG_Y_NEG, L_X_NEG_Y_NONNEG

L_X_NEG_Y_NEG:
    out = fsub base, 3.14159265
    !y_neg
    !base
    !ratio
    !x_neg
    !x_pos
    !x
    !y
    return out

L_X_NEG_Y_NONNEG:
    out = fadd base, 3.14159265
    !y_neg
    !base
    !ratio
    !x_neg
    !x_pos
    !x
    !y
    return out

L_X_ZERO:
    y_pos = fcmp_gt y, 0.0
    br y_pos -> L_Y_POS, L_CHECK_Y_NEG

L_Y_POS:
    !y_pos
    !x_neg
    !x_pos
    !x
    !y
    return 1.57079633

L_CHECK_Y_NEG:
    y_neg = fcmp_lt y, 0.0
    br y_neg -> L_Y_NEG, L_ZERO

L_Y_NEG:
    !y_neg
    !y_pos
    !x_neg
    !x_pos
    !x
    !y
    return -1.57079633

L_ZERO:
    !y_neg
    !y_pos
    !x_neg
    !x_pos
    !x
    !y
    return 0.0

@sa3d_f32_acos(value: f32) -> f32:
L_ENTRY:
    ge_one = fcmp_gt value, 0.99999994
    br ge_one -> L_ZERO, L_CHECK_NEG_ONE

L_ZERO:
    !ge_one
    !value
    return 0.0

L_CHECK_NEG_ONE:
    le_neg_one = fcmp_lt value, -0.99999994
    br le_neg_one -> L_PI, L_COMPUTE

L_PI:
    !le_neg_one
    !ge_one
    !value
    return 3.14159265

L_COMPUTE:
    x2 = fmul value, value
    rem = fsub 1.0, x2
    y = call @sa3d_f32_sqrt(rem)
    out = call @sa3d_f32_atan2(y, value)
    !y
    !rem
    !x2
    !le_neg_one
    !ge_one
    !value
    return out

@sa3d_f32_sqrt(value: f32) -> f32:
L_ENTRY:
    positive = fcmp_gt value, 0.0
    br positive -> L_INIT, L_ZERO

L_INIT:
    value_slot = stack_alloc 4
    guess_slot = stack_alloc 4
    i_slot = stack_alloc 8
    store value_slot+0, value as f32
    over_one = fcmp_gt value, 1.0
    !value
    !positive
    br over_one -> L_GUESS_VALUE, L_GUESS_ONE

L_GUESS_VALUE:
    initial = load value_slot+0 as f32
    store guess_slot+0, initial as f32
    store i_slot+0, 0 as i64
    !initial
    !over_one
    jmp L_LOOP_HEAD

L_GUESS_ONE:
    store guess_slot+0, 1.0 as f32
    store i_slot+0, 0 as i64
    !over_one
    jmp L_LOOP_HEAD

L_LOOP_HEAD:
    i = load i_slot+0 as i64
    more = slt i, 8
    br more -> L_LOOP_BODY, L_DONE

L_LOOP_BODY:
    n = load value_slot+0 as f32
    guess = load guess_slot+0 as f32
    div = fdiv n, guess
    sum = fadd guess, div
    next = fmul sum, 0.5
    store guess_slot+0, next as f32
    next_i = add i, 1
    store i_slot+0, next_i as i64
    !next_i
    !next
    !sum
    !div
    !guess
    !n
    !i
    !more
    jmp L_LOOP_HEAD

L_DONE:
    out = load guess_slot+0 as f32
    !more
    !i
    return out

L_ZERO:
    !positive
    !value
    return 0.0

@sa3d_aabb_union(&dst: ptr, &lhs: ptr, &rhs: ptr) -> void:
L_ENTRY:
    lhs_min = ptr_add lhs, SA3D_AABB_min
    lhs_max = ptr_add lhs, SA3D_AABB_max
    rhs_min = ptr_add rhs, SA3D_AABB_min
    rhs_max = ptr_add rhs, SA3D_AABB_max
    dst_min = ptr_add dst, SA3D_AABB_min
    dst_max = ptr_add dst, SA3D_AABB_max
    lmin_x = load lhs_min+SA3D_VEC3_x as i32
    lmin_y = load lhs_min+SA3D_VEC3_y as i32
    lmin_z = load lhs_min+SA3D_VEC3_z as i32
    lmax_x = load lhs_max+SA3D_VEC3_x as i32
    lmax_y = load lhs_max+SA3D_VEC3_y as i32
    lmax_z = load lhs_max+SA3D_VEC3_z as i32
    rmin_x = load rhs_min+SA3D_VEC3_x as i32
    rmin_y = load rhs_min+SA3D_VEC3_y as i32
    rmin_z = load rhs_min+SA3D_VEC3_z as i32
    rmax_x = load rhs_max+SA3D_VEC3_x as i32
    rmax_y = load rhs_max+SA3D_VEC3_y as i32
    rmax_z = load rhs_max+SA3D_VEC3_z as i32
    out_min_x = call @sa3d_i32_min(lmin_x, rmin_x)
    out_min_y = call @sa3d_i32_min(lmin_y, rmin_y)
    out_min_z = call @sa3d_i32_min(lmin_z, rmin_z)
    out_max_x = call @sa3d_i32_max(lmax_x, rmax_x)
    out_max_y = call @sa3d_i32_max(lmax_y, rmax_y)
    out_max_z = call @sa3d_i32_max(lmax_z, rmax_z)
    store dst_min+SA3D_VEC3_x, out_min_x as i32
    store dst_min+SA3D_VEC3_y, out_min_y as i32
    store dst_min+SA3D_VEC3_z, out_min_z as i32
    store dst_min+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    store dst_max+SA3D_VEC3_x, out_max_x as i32
    store dst_max+SA3D_VEC3_y, out_max_y as i32
    store dst_max+SA3D_VEC3_z, out_max_z as i32
    store dst_max+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    !lmin_x
    !lmin_y
    !lmin_z
    !lmax_x
    !lmax_y
    !lmax_z
    !rmin_x
    !rmin_y
    !rmin_z
    !rmax_x
    !rmax_y
    !rmax_z
    !out_min_x
    !out_min_y
    !out_min_z
    !out_max_x
    !out_max_y
    !out_max_z
    !rhs
    !lhs
    !dst
    return

@sa3d_aabb_contains_point3(&aabb: ptr, &point: ptr) -> i32:
L_ENTRY:
    min_vec = ptr_add aabb, SA3D_AABB_min
    max_vec = ptr_add aabb, SA3D_AABB_max
    px = load point+SA3D_VEC3_x as i32
    py = load point+SA3D_VEC3_y as i32
    pz = load point+SA3D_VEC3_z as i32
    min_x = load min_vec+SA3D_VEC3_x as i32
    min_y = load min_vec+SA3D_VEC3_y as i32
    min_z = load min_vec+SA3D_VEC3_z as i32
    max_x = load max_vec+SA3D_VEC3_x as i32
    max_y = load max_vec+SA3D_VEC3_y as i32
    max_z = load max_vec+SA3D_VEC3_z as i32
    x_low = sge px, min_x
    x_high = sle px, max_x
    y_low = sge py, min_y
    y_high = sle py, max_y
    z_low = sge pz, min_z
    z_high = sle pz, max_z
    x_ok = and x_low, x_high
    y_ok = and y_low, y_high
    z_ok = and z_low, z_high
    xy_ok = and x_ok, y_ok
    ok = and xy_ok, z_ok
    br ok -> L_TRUE, L_FALSE

L_TRUE:
    !ok
    !xy_ok
    !z_ok
    !y_ok
    !x_ok
    !z_high
    !z_low
    !y_high
    !y_low
    !x_high
    !x_low
    !max_z
    !max_y
    !max_x
    !min_z
    !min_y
    !min_x
    !pz
    !py
    !px
    !max_vec
    !min_vec
    !point
    !aabb
    return 1

L_FALSE:
    !ok
    !xy_ok
    !z_ok
    !y_ok
    !x_ok
    !z_high
    !z_low
    !y_high
    !y_low
    !x_high
    !x_low
    !max_z
    !max_y
    !max_x
    !min_z
    !min_y
    !min_x
    !pz
    !py
    !px
    !max_vec
    !min_vec
    !point
    !aabb
    return 0

@sa3d_aabb_intersects(&lhs: ptr, &rhs: ptr) -> i32:
L_ENTRY:
    lhs_min = ptr_add lhs, SA3D_AABB_min
    lhs_max = ptr_add lhs, SA3D_AABB_max
    rhs_min = ptr_add rhs, SA3D_AABB_min
    rhs_max = ptr_add rhs, SA3D_AABB_max
    lmin_x = load lhs_min+SA3D_VEC3_x as i32
    lmin_y = load lhs_min+SA3D_VEC3_y as i32
    lmin_z = load lhs_min+SA3D_VEC3_z as i32
    lmax_x = load lhs_max+SA3D_VEC3_x as i32
    lmax_y = load lhs_max+SA3D_VEC3_y as i32
    lmax_z = load lhs_max+SA3D_VEC3_z as i32
    rmin_x = load rhs_min+SA3D_VEC3_x as i32
    rmin_y = load rhs_min+SA3D_VEC3_y as i32
    rmin_z = load rhs_min+SA3D_VEC3_z as i32
    rmax_x = load rhs_max+SA3D_VEC3_x as i32
    rmax_y = load rhs_max+SA3D_VEC3_y as i32
    rmax_z = load rhs_max+SA3D_VEC3_z as i32
    x0 = sle lmin_x, rmax_x
    x1 = sge lmax_x, rmin_x
    y0 = sle lmin_y, rmax_y
    y1 = sge lmax_y, rmin_y
    z0 = sle lmin_z, rmax_z
    z1 = sge lmax_z, rmin_z
    x_ok = and x0, x1
    y_ok = and y0, y1
    z_ok = and z0, z1
    xy_ok = and x_ok, y_ok
    ok = and xy_ok, z_ok
    br ok -> L_HIT, L_MISS

L_HIT:
    !ok
    !xy_ok
    !z_ok
    !y_ok
    !x_ok
    !z1
    !z0
    !y1
    !y0
    !x1
    !x0
    !rmax_z
    !rmax_y
    !rmax_x
    !rmin_z
    !rmin_y
    !rmin_x
    !lmax_z
    !lmax_y
    !lmax_x
    !lmin_z
    !lmin_y
    !lmin_x
    !rhs_max
    !rhs_min
    !lhs_max
    !lhs_min
    !rhs
    !lhs
    return 1

L_MISS:
    !ok
    !xy_ok
    !z_ok
    !y_ok
    !x_ok
    !z1
    !z0
    !y1
    !y0
    !x1
    !x0
    !rmax_z
    !rmax_y
    !rmax_x
    !rmin_z
    !rmin_y
    !rmin_x
    !lmax_z
    !lmax_y
    !lmax_x
    !lmin_z
    !lmin_y
    !lmin_x
    !rhs_max
    !rhs_min
    !lhs_max
    !lhs_min
    !rhs
    !lhs
    return 0

@sa3d_aabb_center(&dst: ptr, &aabb: ptr) -> void:
L_ENTRY:
    min_vec = ptr_add aabb, SA3D_AABB_min
    max_vec = ptr_add aabb, SA3D_AABB_max
    min_x = load min_vec+SA3D_VEC3_x as i32
    min_y = load min_vec+SA3D_VEC3_y as i32
    min_z = load min_vec+SA3D_VEC3_z as i32
    max_x = load max_vec+SA3D_VEC3_x as i32
    max_y = load max_vec+SA3D_VEC3_y as i32
    max_z = load max_vec+SA3D_VEC3_z as i32
    sum_x = add min_x, max_x
    sum_y = add min_y, max_y
    sum_z = add min_z, max_z
    cx = sdiv sum_x, 2
    cy = sdiv sum_y, 2
    cz = sdiv sum_z, 2
    store dst+SA3D_VEC3_x, cx as i32
    store dst+SA3D_VEC3_y, cy as i32
    store dst+SA3D_VEC3_z, cz as i32
    !cz
    !cy
    !cx
    !sum_z
    !sum_y
    !sum_x
    !max_z
    !max_y
    !max_x
    !min_z
    !min_y
    !min_x
    !max_vec
    !min_vec
    !aabb
    !dst
    return

@sa3d_aabb_extents(&dst: ptr, &aabb: ptr) -> void:
L_ENTRY:
    min_vec = ptr_add aabb, SA3D_AABB_min
    max_vec = ptr_add aabb, SA3D_AABB_max
    min_x = load min_vec+SA3D_VEC3_x as i32
    min_y = load min_vec+SA3D_VEC3_y as i32
    min_z = load min_vec+SA3D_VEC3_z as i32
    max_x = load max_vec+SA3D_VEC3_x as i32
    max_y = load max_vec+SA3D_VEC3_y as i32
    max_z = load max_vec+SA3D_VEC3_z as i32
    x = sub max_x, min_x
    y = sub max_y, min_y
    z = sub max_z, min_z
    store dst+SA3D_VEC3_x, x as i32
    store dst+SA3D_VEC3_y, y as i32
    store dst+SA3D_VEC3_z, z as i32
    !z
    !y
    !x
    !max_z
    !max_y
    !max_x
    !min_z
    !min_y
    !min_x
    !max_vec
    !min_vec
    !aabb
    !dst
    return

@sa3d_ray3_set(&ray: ptr, &origin: ptr, &direction: ptr) -> void:
L_ENTRY:
    dst_origin = ptr_add ray, SA3D_RAY3_origin
    dst_direction = ptr_add ray, SA3D_RAY3_direction
    ox = load origin+SA3D_VEC3_x as i32
    oy = load origin+SA3D_VEC3_y as i32
    oz = load origin+SA3D_VEC3_z as i32
    dx = load direction+SA3D_VEC3_x as i32
    dy = load direction+SA3D_VEC3_y as i32
    dz = load direction+SA3D_VEC3_z as i32
    store dst_origin+SA3D_VEC3_x, ox as i32
    store dst_origin+SA3D_VEC3_y, oy as i32
    store dst_origin+SA3D_VEC3_z, oz as i32
    store dst_origin+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    store dst_direction+SA3D_VEC3_x, dx as i32
    store dst_direction+SA3D_VEC3_y, dy as i32
    store dst_direction+SA3D_VEC3_z, dz as i32
    store dst_direction+SA3D_VEC4_w, SA3D_F32_ZERO_BITS as i32
    !dz
    !dy
    !dx
    !oz
    !oy
    !ox
    !dst_direction
    !dst_origin
    !direction
    !origin
    !ray
    return

@sa3d_quat_set(&q: ptr, x: f32, y: f32, z: f32, w: f32) -> void:
L_ENTRY:
    store q+SA3D_QUAT_x, x as f32
    store q+SA3D_QUAT_y, y as f32
    store q+SA3D_QUAT_z, z as f32
    store q+SA3D_QUAT_w, w as f32
    !w
    !z
    !y
    !x
    !q
    return

@sa3d_quat_get_x(&q: ptr) -> f32:
L_ENTRY:
    x = load q+SA3D_QUAT_x as f32
    !q
    return x

@sa3d_quat_get_y(&q: ptr) -> f32:
L_ENTRY:
    y = load q+SA3D_QUAT_y as f32
    !q
    return y

@sa3d_quat_get_z(&q: ptr) -> f32:
L_ENTRY:
    z = load q+SA3D_QUAT_z as f32
    !q
    return z

@sa3d_quat_get_w(&q: ptr) -> f32:
L_ENTRY:
    w = load q+SA3D_QUAT_w as f32
    !q
    return w

@sa3d_quat_conjugate(&out: ptr, &q: ptr) -> void:
L_ENTRY:
    qx = load q+SA3D_QUAT_x as i32
    qy = load q+SA3D_QUAT_y as i32
    qz = load q+SA3D_QUAT_z as i32
    qw = load q+SA3D_QUAT_w as i32
    nx = xor qx, -2147483648
    ny = xor qy, -2147483648
    nz = xor qz, -2147483648
    store out+SA3D_QUAT_x, nx as i32
    store out+SA3D_QUAT_y, ny as i32
    store out+SA3D_QUAT_z, nz as i32
    store out+SA3D_QUAT_w, qw as i32
    !nz
    !ny
    !nx
    !qw
    !qz
    !qy
    !qx
    !q
    !out
    return

@sa3d_quat_length_squared(&q: ptr) -> f32:
L_ENTRY:
    x = load q+SA3D_QUAT_x as f32
    y = load q+SA3D_QUAT_y as f32
    z = load q+SA3D_QUAT_z as f32
    w = load q+SA3D_QUAT_w as f32
    xx = fmul x, x
    yy = fmul y, y
    zz = fmul z, z
    ww = fmul w, w
    xy = fadd xx, yy
    zw = fadd zz, ww
    len2 = fadd xy, zw
    !zw
    !xy
    !ww
    !zz
    !yy
    !xx
    !w
    !z
    !y
    !x
    !q
    return len2

@sa3d_quat_mul(&out: ptr, &lhs: ptr, &rhs: ptr) -> void:
L_ENTRY:
    lx = load lhs+SA3D_QUAT_x as f32
    ly = load lhs+SA3D_QUAT_y as f32
    lz = load lhs+SA3D_QUAT_z as f32
    lw = load lhs+SA3D_QUAT_w as f32
    rx = load rhs+SA3D_QUAT_x as f32
    ry = load rhs+SA3D_QUAT_y as f32
    rz = load rhs+SA3D_QUAT_z as f32
    rw = load rhs+SA3D_QUAT_w as f32
    x0 = fmul lw, rx
    x1 = fmul lx, rw
    x2 = fmul ly, rz
    x3 = fmul lz, ry
    xs0 = fadd x0, x1
    xs1 = fadd xs0, x2
    x = fsub xs1, x3
    y0 = fmul lw, ry
    y1 = fmul lx, rz
    y2 = fmul ly, rw
    y3 = fmul lz, rx
    ys0 = fsub y0, y1
    ys1 = fadd ys0, y2
    y = fadd ys1, y3
    z0 = fmul lw, rz
    z1 = fmul lx, ry
    z2 = fmul ly, rx
    z3 = fmul lz, rw
    zs0 = fadd z0, z1
    zs1 = fsub zs0, z2
    z = fadd zs1, z3
    w0 = fmul lw, rw
    w1 = fmul lx, rx
    w2 = fmul ly, ry
    w3 = fmul lz, rz
    ws0 = fsub w0, w1
    ws1 = fsub ws0, w2
    w = fsub ws1, w3
    store out+SA3D_QUAT_x, x as f32
    store out+SA3D_QUAT_y, y as f32
    store out+SA3D_QUAT_z, z as f32
    store out+SA3D_QUAT_w, w as f32
    !w
    !ws1
    !ws0
    !w3
    !w2
    !w1
    !w0
    !z
    !zs1
    !zs0
    !z3
    !z2
    !z1
    !z0
    !y
    !ys1
    !ys0
    !y3
    !y2
    !y1
    !y0
    !x
    !xs1
    !xs0
    !x3
    !x2
    !x1
    !x0
    !rw
    !rz
    !ry
    !rx
    !lw
    !lz
    !ly
    !lx
    !rhs
    !lhs
    !out
    return

@sa3d_quat_normalize_f(&out: ptr, &q: ptr) -> i32:
L_ENTRY:
    len2 = call @sa3d_quat_length_squared(&q)
    len = call @sa3d_f32_sqrt(len2)
    valid = fcmp_gt len, 0.000001
    br valid -> L_NORMALIZE, L_ZERO

L_NORMALIZE:
    qx = load q+SA3D_QUAT_x as f32
    qy = load q+SA3D_QUAT_y as f32
    qz = load q+SA3D_QUAT_z as f32
    qw = load q+SA3D_QUAT_w as f32
    inv = fdiv 1.0, len
    x = fmul qx, inv
    y = fmul qy, inv
    z = fmul qz, inv
    w = fmul qw, inv
    store out+SA3D_QUAT_x, x as f32
    store out+SA3D_QUAT_y, y as f32
    store out+SA3D_QUAT_z, z as f32
    store out+SA3D_QUAT_w, w as f32
    !w
    !z
    !y
    !x
    !inv
    !qw
    !qz
    !qy
    !qx
    !valid
    !len
    !len2
    !q
    !out
    return 1

L_ZERO:
    store out+SA3D_QUAT_x, 0.0 as f32
    store out+SA3D_QUAT_y, 0.0 as f32
    store out+SA3D_QUAT_z, 0.0 as f32
    store out+SA3D_QUAT_w, 1.0 as f32
    !valid
    !len
    !len2
    !q
    !out
    return 0

@sa3d_quat_from_rotation_arc_y_to(&out: ptr, &to: ptr) -> void:
L_ENTRY:
    tx = load to+SA3D_VEC3_x as f32
    ty = load to+SA3D_VEC3_y as f32
    tz = load to+SA3D_VEC3_z as f32
    near_same = fcmp_gt ty, 0.99999976
    br near_same -> L_IDENTITY, L_CHECK_OPPOSITE

L_IDENTITY:
    store out+SA3D_QUAT_x, 0.0 as f32
    store out+SA3D_QUAT_y, 0.0 as f32
    store out+SA3D_QUAT_z, 0.0 as f32
    store out+SA3D_QUAT_w, 1.0 as f32
    !near_same
    !tz
    !ty
    !tx
    !to
    !out
    return

L_CHECK_OPPOSITE:
    near_opposite = fcmp_lt ty, -0.99999976
    br near_opposite -> L_OPPOSITE, L_ARC

L_OPPOSITE:
    store out+SA3D_QUAT_x, 0.0 as f32
    store out+SA3D_QUAT_y, 0.0 as f32
    store out+SA3D_QUAT_z, -1.0 as f32
    store out+SA3D_QUAT_w, 0.0 as f32
    !near_opposite
    !near_same
    !tz
    !ty
    !tx
    !to
    !out
    return

L_ARC:
    q = alloc SA3D_QUAT_SIZE
    z = fneg tx
    w = fadd 1.0, ty
    store q+SA3D_QUAT_x, tz as f32
    store q+SA3D_QUAT_y, 0.0 as f32
    store q+SA3D_QUAT_z, z as f32
    store q+SA3D_QUAT_w, w as f32
    call @sa3d_quat_normalize_f(&out, &q)
    !w
    !z
    !q
    !near_opposite
    !near_same
    !tz
    !ty
    !tx
    !to
    !out
    return

@sa3d_quat_rotate_vec3_f(&out: ptr, &q: ptr, &v: ptr) -> void:
L_ENTRY:
    qx = load q+SA3D_QUAT_x as f32
    qy = load q+SA3D_QUAT_y as f32
    qz = load q+SA3D_QUAT_z as f32
    qw = load q+SA3D_QUAT_w as f32
    vx = load v+SA3D_VEC3_x as f32
    vy = load v+SA3D_VEC3_y as f32
    vz = load v+SA3D_VEC3_z as f32
    tx0 = fmul qy, vz
    tx1 = fmul qz, vy
    tx2 = fsub tx0, tx1
    tx = fmul tx2, 2.0
    ty0 = fmul qz, vx
    ty1 = fmul qx, vz
    ty2 = fsub ty0, ty1
    ty = fmul ty2, 2.0
    tz0 = fmul qx, vy
    tz1 = fmul qy, vx
    tz2 = fsub tz0, tz1
    tz = fmul tz2, 2.0
    qwt_x = fmul qw, tx
    qwt_y = fmul qw, ty
    qwt_z = fmul qw, tz
    cx0 = fmul qy, tz
    cx1 = fmul qz, ty
    cx = fsub cx0, cx1
    cy0 = fmul qz, tx
    cy1 = fmul qx, tz
    cy = fsub cy0, cy1
    cz0 = fmul qx, ty
    cz1 = fmul qy, tx
    cz = fsub cz0, cz1
    ox0 = fadd vx, qwt_x
    oy0 = fadd vy, qwt_y
    oz0 = fadd vz, qwt_z
    ox = fadd ox0, cx
    oy = fadd oy0, cy
    oz = fadd oz0, cz
    store out+SA3D_VEC3_x, ox as f32
    store out+SA3D_VEC3_y, oy as f32
    store out+SA3D_VEC3_z, oz as f32
    !oz
    !oy
    !ox
    !oz0
    !oy0
    !ox0
    !cz
    !cy
    !cx
    !cz1
    !cz0
    !cy1
    !cy0
    !cx1
    !cx0
    !qwt_z
    !qwt_y
    !qwt_x
    !tz
    !tz2
    !tz1
    !tz0
    !ty
    !ty2
    !ty1
    !ty0
    !tx
    !tx2
    !tx1
    !tx0
    !vz
    !vy
    !vx
    !qw
    !qz
    !qy
    !qx
    !v
    !q
    !out
    return

@sa3d_mat4_from_quat(&mat: ptr, &q: ptr) -> void:
L_ENTRY:
    scale = alloc SA3D_VEC3_SIZE
    translation = alloc SA3D_VEC3_SIZE
    store scale+SA3D_VEC3_x, SA3D_F32_ONE_BITS as i32
    store scale+SA3D_VEC3_y, SA3D_F32_ONE_BITS as i32
    store scale+SA3D_VEC3_z, SA3D_F32_ONE_BITS as i32
    store translation+SA3D_VEC3_x, SA3D_F32_ZERO_BITS as i32
    store translation+SA3D_VEC3_y, SA3D_F32_ZERO_BITS as i32
    store translation+SA3D_VEC3_z, SA3D_F32_ZERO_BITS as i32
    call @sa3d_mat4_from_scale_rotation_translation(&mat, &scale, &q, &translation)
    !translation
    !scale
    !q
    !mat
    return

@sa3d_mat4_from_scale_rotation_translation(&mat: ptr, &scale: ptr, &rotation: ptr, &translation: ptr) -> void:
L_ENTRY:
    sx = load scale+SA3D_VEC3_x as f32
    sy = load scale+SA3D_VEC3_y as f32
    sz = load scale+SA3D_VEC3_z as f32
    qx = load rotation+SA3D_QUAT_x as f32
    qy = load rotation+SA3D_QUAT_y as f32
    qz = load rotation+SA3D_QUAT_z as f32
    qw = load rotation+SA3D_QUAT_w as f32
    tx = load translation+SA3D_VEC3_x as f32
    ty = load translation+SA3D_VEC3_y as f32
    tz = load translation+SA3D_VEC3_z as f32
    x2 = fadd qx, qx
    y2 = fadd qy, qy
    z2 = fadd qz, qz
    xx = fmul qx, x2
    xy = fmul qx, y2
    xz = fmul qx, z2
    yy = fmul qy, y2
    yz = fmul qy, z2
    zz = fmul qz, z2
    wx = fmul qw, x2
    wy = fmul qw, y2
    wz = fmul qw, z2
    yyzz = fadd yy, zz
    xxzz = fadd xx, zz
    xxyy = fadd xx, yy
    c0x0 = fsub 1.0, yyzz
    c0y0 = fadd xy, wz
    c0z0 = fsub xz, wy
    c1x0 = fsub xy, wz
    c1y0 = fsub 1.0, xxzz
    c1z0 = fadd yz, wx
    c2x0 = fadd xz, wy
    c2y0 = fsub yz, wx
    c2z0 = fsub 1.0, xxyy
    c0x = fmul c0x0, sx
    c0y = fmul c0y0, sx
    c0z = fmul c0z0, sx
    c1x = fmul c1x0, sy
    c1y = fmul c1y0, sy
    c1z = fmul c1z0, sy
    c2x = fmul c2x0, sz
    c2y = fmul c2y0, sz
    c2z = fmul c2z0, sz
    store mat+0, c0x as f32
    store mat+4, c0y as f32
    store mat+8, c0z as f32
    store mat+12, 0.0 as f32
    store mat+16, c1x as f32
    store mat+20, c1y as f32
    store mat+24, c1z as f32
    store mat+28, 0.0 as f32
    store mat+32, c2x as f32
    store mat+36, c2y as f32
    store mat+40, c2z as f32
    store mat+44, 0.0 as f32
    store mat+48, tx as f32
    store mat+52, ty as f32
    store mat+56, tz as f32
    store mat+60, 1.0 as f32
    !c2z
    !c2y
    !c2x
    !c1z
    !c1y
    !c1x
    !c0z
    !c0y
    !c0x
    !c2z0
    !c2y0
    !c2x0
    !c1z0
    !c1y0
    !c1x0
    !c0z0
    !c0y0
    !c0x0
    !xxyy
    !xxzz
    !yyzz
    !wz
    !wy
    !wx
    !zz
    !yz
    !yy
    !xz
    !xy
    !xx
    !z2
    !y2
    !x2
    !tz
    !ty
    !tx
    !qw
    !qz
    !qy
    !qx
    !sz
    !sy
    !sx
    !translation
    !rotation
    !scale
    !mat
    return

@sa3d_vec3_length_squared_f(&vec: ptr) -> f32:
L_ENTRY:
    len2 = call @sa3d_vec3_dot_f(&vec, &vec)
    !vec
    return len2

@sa3d_vec3_length_f(&vec: ptr) -> f32:
L_ENTRY:
    len2 = call @sa3d_vec3_length_squared_f(&vec)
    len = call @sa3d_f32_sqrt(len2)
    !len2
    !vec
    return len

@sa3d_vec3_normalize_f(&out: ptr, &vec: ptr) -> i32:
L_ENTRY:
    len = call @sa3d_vec3_length_f(&vec)
    valid = fcmp_gt len, 0.000001
    br valid -> L_NORMALIZE, L_ZERO

L_NORMALIZE:
    x = load vec+SA3D_VEC3_x as f32
    y = load vec+SA3D_VEC3_y as f32
    z = load vec+SA3D_VEC3_z as f32
    inv = fdiv 1.0, len
    nx = fmul x, inv
    ny = fmul y, inv
    nz = fmul z, inv
    store out+SA3D_VEC3_x, nx as f32
    store out+SA3D_VEC3_y, ny as f32
    store out+SA3D_VEC3_z, nz as f32
    !nz
    !ny
    !nx
    !inv
    !z
    !y
    !x
    !valid
    !len
    !vec
    !out
    return 1

L_ZERO:
    store out+SA3D_VEC3_x, 0.0 as f32
    store out+SA3D_VEC3_y, 0.0 as f32
    store out+SA3D_VEC3_z, 0.0 as f32
    !valid
    !len
    !vec
    !out
    return 0

@sa3d_vec3_dot_f(&a: ptr, &b: ptr) -> f32:
L_ENTRY:
    ax = load a+SA3D_VEC3_x as f32
    ay = load a+SA3D_VEC3_y as f32
    az = load a+SA3D_VEC3_z as f32
    bx = load b+SA3D_VEC3_x as f32
    by = load b+SA3D_VEC3_y as f32
    bz = load b+SA3D_VEC3_z as f32
    xx = fmul ax, bx
    yy = fmul ay, by
    zz = fmul az, bz
    xy = fadd xx, yy
    dot = fadd xy, zz
    !xy
    !zz
    !yy
    !xx
    !bz
    !by
    !bx
    !az
    !ay
    !ax
    !b
    !a
    return dot

@sa3d_vec3_cross_f(&out: ptr, &a: ptr, &b: ptr) -> void:
L_ENTRY:
    ax = load a+SA3D_VEC3_x as f32
    ay = load a+SA3D_VEC3_y as f32
    az = load a+SA3D_VEC3_z as f32
    bx = load b+SA3D_VEC3_x as f32
    by = load b+SA3D_VEC3_y as f32
    bz = load b+SA3D_VEC3_z as f32
    x0 = fmul ay, bz
    x1 = fmul az, by
    x = fsub x0, x1
    y0 = fmul az, bx
    y1 = fmul ax, bz
    y = fsub y0, y1
    z0 = fmul ax, by
    z1 = fmul ay, bx
    z = fsub z0, z1
    store out+SA3D_VEC3_x, x as f32
    store out+SA3D_VEC3_y, y as f32
    store out+SA3D_VEC3_z, z as f32
    !z
    !z1
    !z0
    !y
    !y1
    !y0
    !x
    !x1
    !x0
    !bz
    !by
    !bx
    !az
    !ay
    !ax
    !b
    !a
    !out
    return
