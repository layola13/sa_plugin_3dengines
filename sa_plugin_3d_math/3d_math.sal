#def SA3D_MATH_VERSION_MAJOR = 0
#def SA3D_MATH_VERSION_MINOR = 1
#def SA3D_F32_SIZE = 4
#def SA3D_I32_SIZE = 4
#def SA3D_U32_SIZE = 4
#def SA3D_I64_SIZE = 8

#def SA3D_VEC2_x = +0
#def SA3D_VEC2_y = +4
#def SA3D_VEC2_SIZE = 8

#def SA3D_VEC3_x = +0
#def SA3D_VEC3_y = +4
#def SA3D_VEC3_z = +8
#def SA3D_VEC3_SIZE = 12

#def SA3D_VEC4_x = +0
#def SA3D_VEC4_y = +4
#def SA3D_VEC4_z = +8
#def SA3D_VEC4_w = +12
#def SA3D_VEC4_SIZE = 16

#def SA3D_QUAT_x = +0
#def SA3D_QUAT_y = +4
#def SA3D_QUAT_z = +8
#def SA3D_QUAT_w = +12
#def SA3D_QUAT_SIZE = 16

#def SA3D_COLOR_r = +0
#def SA3D_COLOR_g = +4
#def SA3D_COLOR_b = +8
#def SA3D_COLOR_a = +12
#def SA3D_COLOR_SIZE = 16

#def SA3D_MAT4_col0 = +0
#def SA3D_MAT4_col1 = +16
#def SA3D_MAT4_col2 = +32
#def SA3D_MAT4_col3 = +48
#def SA3D_MAT4_SIZE = 64

#def SA3D_AABB_min = +0
#def SA3D_AABB_max = +16
#def SA3D_AABB_SIZE = 32

#def SA3D_RAY3_origin = +0
#def SA3D_RAY3_direction = +16
#def SA3D_RAY3_SIZE = 32

#def SA3D_F32_ZERO_BITS = 0
#def SA3D_F32_ONE_BITS = 1065353216
#def SA3D_F32_NEG_ONE_BITS = -1082130432

@sa3d_vec2_set(&vec: ptr, x: i32, y: i32) -> void:
L_ENTRY:
    store vec+SA3D_VEC2_x, x as i32
    store vec+SA3D_VEC2_y, y as i32
    !y
    !x
    !vec
    return

@sa3d_vec2_add(&dst: ptr, &a: ptr, &b: ptr) -> void:
L_ENTRY:
    ax = load a+SA3D_VEC2_x as i32
    ay = load a+SA3D_VEC2_y as i32
    bx = load b+SA3D_VEC2_x as i32
    by = load b+SA3D_VEC2_y as i32
    x = add ax, bx
    y = add ay, by
    store dst+SA3D_VEC2_x, x as i32
    store dst+SA3D_VEC2_y, y as i32
    !y
    !x
    !by
    !bx
    !ay
    !ax
    !b
    !a
    !dst
    return

@sa3d_vec2_sub(&dst: ptr, &a: ptr, &b: ptr) -> void:
L_ENTRY:
    ax = load a+SA3D_VEC2_x as i32
    ay = load a+SA3D_VEC2_y as i32
    bx = load b+SA3D_VEC2_x as i32
    by = load b+SA3D_VEC2_y as i32
    x = sub ax, bx
    y = sub ay, by
    store dst+SA3D_VEC2_x, x as i32
    store dst+SA3D_VEC2_y, y as i32
    !y
    !x
    !by
    !bx
    !ay
    !ax
    !b
    !a
    !dst
    return

@sa3d_vec2_dot(&a: ptr, &b: ptr) -> i32:
L_ENTRY:
    ax = load a+SA3D_VEC2_x as i32
    ay = load a+SA3D_VEC2_y as i32
    bx = load b+SA3D_VEC2_x as i32
    by = load b+SA3D_VEC2_y as i32
    xx = mul ax, bx
    yy = mul ay, by
    out = add xx, yy
    !yy
    !xx
    !by
    !bx
    !ay
    !ax
    !b
    !a
    return out

@sa3d_vec2_length_squared(&vec: ptr) -> i32:
L_ENTRY:
    out = call @sa3d_vec2_dot(&vec, &vec)
    !vec
    return out

@sa3d_vec3_set(&vec: ptr, x: i32, y: i32, z: i32) -> void:
L_ENTRY:
    store vec+SA3D_VEC3_x, x as i32
    store vec+SA3D_VEC3_y, y as i32
    store vec+SA3D_VEC3_z, z as i32
    !z
    !y
    !x
    !vec
    return

@sa3d_vec4_add(&dst: ptr, &a: ptr, &b: ptr) -> void:
L_ENTRY:
    ax = load a+SA3D_VEC4_x as i32
    ay = load a+SA3D_VEC4_y as i32
    az = load a+SA3D_VEC4_z as i32
    aw = load a+SA3D_VEC4_w as i32
    bx = load b+SA3D_VEC4_x as i32
    by = load b+SA3D_VEC4_y as i32
    bz = load b+SA3D_VEC4_z as i32
    bw = load b+SA3D_VEC4_w as i32
    x = add ax, bx
    y = add ay, by
    z = add az, bz
    w = add aw, bw
    store dst+SA3D_VEC4_x, x as i32
    store dst+SA3D_VEC4_y, y as i32
    store dst+SA3D_VEC4_z, z as i32
    store dst+SA3D_VEC4_w, w as i32
    !w
    !z
    !y
    !x
    !bw
    !bz
    !by
    !bx
    !aw
    !az
    !ay
    !ax
    !b
    !a
    !dst
    return

@sa3d_vec4_sub(&dst: ptr, &a: ptr, &b: ptr) -> void:
L_ENTRY:
    ax = load a+SA3D_VEC4_x as i32
    ay = load a+SA3D_VEC4_y as i32
    az = load a+SA3D_VEC4_z as i32
    aw = load a+SA3D_VEC4_w as i32
    bx = load b+SA3D_VEC4_x as i32
    by = load b+SA3D_VEC4_y as i32
    bz = load b+SA3D_VEC4_z as i32
    bw = load b+SA3D_VEC4_w as i32
    x = sub ax, bx
    y = sub ay, by
    z = sub az, bz
    w = sub aw, bw
    store dst+SA3D_VEC4_x, x as i32
    store dst+SA3D_VEC4_y, y as i32
    store dst+SA3D_VEC4_z, z as i32
    store dst+SA3D_VEC4_w, w as i32
    !w
    !z
    !y
    !x
    !bw
    !bz
    !by
    !bx
    !aw
    !az
    !ay
    !ax
    !b
    !a
    !dst
    return

@sa3d_vec4_dot(&a: ptr, &b: ptr) -> i32:
L_ENTRY:
    ax = load a+SA3D_VEC4_x as i32
    ay = load a+SA3D_VEC4_y as i32
    az = load a+SA3D_VEC4_z as i32
    aw = load a+SA3D_VEC4_w as i32
    bx = load b+SA3D_VEC4_x as i32
    by = load b+SA3D_VEC4_y as i32
    bz = load b+SA3D_VEC4_z as i32
    bw = load b+SA3D_VEC4_w as i32
    xx = mul ax, bx
    yy = mul ay, by
    zz = mul az, bz
    ww = mul aw, bw
    xy = add xx, yy
    zw = add zz, ww
    out = add xy, zw
    !zw
    !xy
    !ww
    !zz
    !yy
    !xx
    !bw
    !bz
    !by
    !bx
    !aw
    !az
    !ay
    !ax
    !b
    !a
    return out

@sa3d_vec4_length_squared(&vec: ptr) -> i32:
L_ENTRY:
    out = call @sa3d_vec4_dot(&vec, &vec)
    !vec
    return out

@sa3d_vec4_set(&vec: ptr, x: i32, y: i32, z: i32, w: i32) -> void:
L_ENTRY:
    store vec+SA3D_VEC4_x, x as i32
    store vec+SA3D_VEC4_y, y as i32
    store vec+SA3D_VEC4_z, z as i32
    store vec+SA3D_VEC4_w, w as i32
    !w
    !z
    !y
    !x
    !vec
    return

@sa3d_vec3_add(&dst: ptr, &a: ptr, &b: ptr) -> void:
L_ENTRY:
    ax = load a+SA3D_VEC3_x as i32
    ay = load a+SA3D_VEC3_y as i32
    az = load a+SA3D_VEC3_z as i32
    bx = load b+SA3D_VEC3_x as i32
    by = load b+SA3D_VEC3_y as i32
    bz = load b+SA3D_VEC3_z as i32
    x = add ax, bx
    y = add ay, by
    z = add az, bz
    store dst+SA3D_VEC3_x, x as i32
    store dst+SA3D_VEC3_y, y as i32
    store dst+SA3D_VEC3_z, z as i32
    !z
    !y
    !x
    !bz
    !by
    !bx
    !az
    !ay
    !ax
    !b
    !a
    !dst
    return

@sa3d_vec3_sub(&dst: ptr, &a: ptr, &b: ptr) -> void:
L_ENTRY:
    ax = load a+SA3D_VEC3_x as i32
    ay = load a+SA3D_VEC3_y as i32
    az = load a+SA3D_VEC3_z as i32
    bx = load b+SA3D_VEC3_x as i32
    by = load b+SA3D_VEC3_y as i32
    bz = load b+SA3D_VEC3_z as i32
    x = sub ax, bx
    y = sub ay, by
    z = sub az, bz
    store dst+SA3D_VEC3_x, x as i32
    store dst+SA3D_VEC3_y, y as i32
    store dst+SA3D_VEC3_z, z as i32
    !z
    !y
    !x
    !bz
    !by
    !bx
    !az
    !ay
    !ax
    !b
    !a
    !dst
    return

@sa3d_vec3_dot(&a: ptr, &b: ptr) -> i32:
L_ENTRY:
    ax = load a+SA3D_VEC3_x as i32
    ay = load a+SA3D_VEC3_y as i32
    az = load a+SA3D_VEC3_z as i32
    bx = load b+SA3D_VEC3_x as i32
    by = load b+SA3D_VEC3_y as i32
    bz = load b+SA3D_VEC3_z as i32
    xx = mul ax, bx
    yy = mul ay, by
    zz = mul az, bz
    xy = add xx, yy
    out = add xy, zz
    !xy
    !zz
    !yy
    !xx
    !bz
    !by
    !bx
    !az
    !ay
    !ax
    !b
    !a
    return out

@sa3d_vec3_length_squared(&vec: ptr) -> i32:
L_ENTRY:
    out = call @sa3d_vec3_dot(&vec, &vec)
    !vec
    return out

@sa3d_vec3_cross(&dst: ptr, &a: ptr, &b: ptr) -> void:
L_ENTRY:
    ax = load a+SA3D_VEC3_x as i32
    ay = load a+SA3D_VEC3_y as i32
    az = load a+SA3D_VEC3_z as i32
    bx = load b+SA3D_VEC3_x as i32
    by = load b+SA3D_VEC3_y as i32
    bz = load b+SA3D_VEC3_z as i32
    ay_bz = mul ay, bz
    az_by = mul az, by
    az_bx = mul az, bx
    ax_bz = mul ax, bz
    ax_by = mul ax, by
    ay_bx = mul ay, bx
    x = sub ay_bz, az_by
    y = sub az_bx, ax_bz
    z = sub ax_by, ay_bx
    store dst+SA3D_VEC3_x, x as i32
    store dst+SA3D_VEC3_y, y as i32
    store dst+SA3D_VEC3_z, z as i32
    !z
    !y
    !x
    !ay_bx
    !ax_by
    !ax_bz
    !az_bx
    !az_by
    !ay_bz
    !bz
    !by
    !bx
    !az
    !ay
    !ax
    !b
    !a
    !dst
    return

@sa3d_quat_identity(&quat: ptr) -> void:
L_ENTRY:
    store quat+SA3D_QUAT_x, SA3D_F32_ZERO_BITS as i32
    store quat+SA3D_QUAT_y, SA3D_F32_ZERO_BITS as i32
    store quat+SA3D_QUAT_z, SA3D_F32_ZERO_BITS as i32
    store quat+SA3D_QUAT_w, SA3D_F32_ONE_BITS as i32
    !quat
    return

@sa3d_mat4_zero(&mat: ptr) -> void:
L_ENTRY:
    store mat+0, SA3D_F32_ZERO_BITS as i32
    store mat+4, SA3D_F32_ZERO_BITS as i32
    store mat+8, SA3D_F32_ZERO_BITS as i32
    store mat+12, SA3D_F32_ZERO_BITS as i32
    store mat+16, SA3D_F32_ZERO_BITS as i32
    store mat+20, SA3D_F32_ZERO_BITS as i32
    store mat+24, SA3D_F32_ZERO_BITS as i32
    store mat+28, SA3D_F32_ZERO_BITS as i32
    store mat+32, SA3D_F32_ZERO_BITS as i32
    store mat+36, SA3D_F32_ZERO_BITS as i32
    store mat+40, SA3D_F32_ZERO_BITS as i32
    store mat+44, SA3D_F32_ZERO_BITS as i32
    store mat+48, SA3D_F32_ZERO_BITS as i32
    store mat+52, SA3D_F32_ZERO_BITS as i32
    store mat+56, SA3D_F32_ZERO_BITS as i32
    store mat+60, SA3D_F32_ZERO_BITS as i32
    !mat
    return

@sa3d_mat4_identity(&mat: ptr) -> void:
L_ENTRY:
    call @sa3d_mat4_zero(&mat)
    store mat+0, SA3D_F32_ONE_BITS as i32
    store mat+20, SA3D_F32_ONE_BITS as i32
    store mat+40, SA3D_F32_ONE_BITS as i32
    store mat+60, SA3D_F32_ONE_BITS as i32
    !mat
    return

@sa3d_mat4_copy(&dst: ptr, &src: ptr) -> void:
L_ENTRY:
    v0 = load src+0 as i32
    v1 = load src+4 as i32
    v2 = load src+8 as i32
    v3 = load src+12 as i32
    v4 = load src+16 as i32
    v5 = load src+20 as i32
    v6 = load src+24 as i32
    v7 = load src+28 as i32
    v8 = load src+32 as i32
    v9 = load src+36 as i32
    v10 = load src+40 as i32
    v11 = load src+44 as i32
    v12 = load src+48 as i32
    v13 = load src+52 as i32
    v14 = load src+56 as i32
    v15 = load src+60 as i32
    store dst+0, v0 as i32
    store dst+4, v1 as i32
    store dst+8, v2 as i32
    store dst+12, v3 as i32
    store dst+16, v4 as i32
    store dst+20, v5 as i32
    store dst+24, v6 as i32
    store dst+28, v7 as i32
    store dst+32, v8 as i32
    store dst+36, v9 as i32
    store dst+40, v10 as i32
    store dst+44, v11 as i32
    store dst+48, v12 as i32
    store dst+52, v13 as i32
    store dst+56, v14 as i32
    store dst+60, v15 as i32
    !v15
    !v14
    !v13
    !v12
    !v11
    !v10
    !v9
    !v8
    !v7
    !v6
    !v5
    !v4
    !v3
    !v2
    !v1
    !v0
    !src
    !dst
    return

@sa3d_mat4_from_translation(&mat: ptr, &translation: ptr) -> void:
L_ENTRY:
    call @sa3d_mat4_identity(&mat)
    x = load translation+SA3D_VEC3_x as i32
    y = load translation+SA3D_VEC3_y as i32
    z = load translation+SA3D_VEC3_z as i32
    store mat+48, x as i32
    store mat+52, y as i32
    store mat+56, z as i32
    !x
    !y
    !z
    !translation
    !mat
    return

@sa3d_mat4_from_scale_translation(&mat: ptr, &scale: ptr, &translation: ptr) -> void:
L_ENTRY:
    call @sa3d_mat4_zero(&mat)
    sx = load scale+SA3D_VEC3_x as i32
    sy = load scale+SA3D_VEC3_y as i32
    sz = load scale+SA3D_VEC3_z as i32
    tx = load translation+SA3D_VEC3_x as i32
    ty = load translation+SA3D_VEC3_y as i32
    tz = load translation+SA3D_VEC3_z as i32
    store mat+0, sx as i32
    store mat+20, sy as i32
    store mat+40, sz as i32
    store mat+48, tx as i32
    store mat+52, ty as i32
    store mat+56, tz as i32
    store mat+60, SA3D_F32_ONE_BITS as i32
    !sx
    !sy
    !sz
    !tx
    !ty
    !tz
    !translation
    !scale
    !mat
    return

@sa3d_mat4_transform_point3(&dst: ptr, &mat: ptr, &point: ptr) -> void:
L_ENTRY:
    px = load point+SA3D_VEC3_x as i32
    py = load point+SA3D_VEC3_y as i32
    pz = load point+SA3D_VEC3_z as i32
    m00 = load mat+0 as i32
    m01 = load mat+4 as i32
    m02 = load mat+8 as i32
    m10 = load mat+16 as i32
    m11 = load mat+20 as i32
    m12 = load mat+24 as i32
    m20 = load mat+32 as i32
    m21 = load mat+36 as i32
    m22 = load mat+40 as i32
    m30 = load mat+48 as i32
    m31 = load mat+52 as i32
    m32 = load mat+56 as i32
    x0 = mul m00, px
    x1 = mul m10, py
    x2 = mul m20, pz
    xs0 = add x0, x1
    xs1 = add xs0, x2
    x = add xs1, m30
    y0 = mul m01, px
    y1 = mul m11, py
    y2 = mul m21, pz
    ys0 = add y0, y1
    ys1 = add ys0, y2
    y = add ys1, m31
    z0 = mul m02, px
    z1 = mul m12, py
    z2 = mul m22, pz
    zs0 = add z0, z1
    zs1 = add zs0, z2
    z = add zs1, m32
    store dst+SA3D_VEC3_x, x as i32
    store dst+SA3D_VEC3_y, y as i32
    store dst+SA3D_VEC3_z, z as i32
    !z
    !zs1
    !zs0
    !z2
    !z1
    !z0
    !y
    !ys1
    !ys0
    !y2
    !y1
    !y0
    !x
    !xs1
    !xs0
    !x2
    !x1
    !x0
    !m32
    !m31
    !m30
    !m22
    !m21
    !m20
    !m12
    !m11
    !m10
    !m02
    !m01
    !m00
    !pz
    !py
    !px
    !point
    !mat
    !dst
    return

@sa3d_mat4_mul(&dst: ptr, &lhs: ptr, &rhs: ptr) -> void:
L_ENTRY:
    l00 = load lhs+0 as f32
    l01 = load lhs+4 as f32
    l02 = load lhs+8 as f32
    l03 = load lhs+12 as f32
    l10 = load lhs+16 as f32
    l11 = load lhs+20 as f32
    l12 = load lhs+24 as f32
    l13 = load lhs+28 as f32
    l20 = load lhs+32 as f32
    l21 = load lhs+36 as f32
    l22 = load lhs+40 as f32
    l23 = load lhs+44 as f32
    l30 = load lhs+48 as f32
    l31 = load lhs+52 as f32
    l32 = load lhs+56 as f32
    l33 = load lhs+60 as f32
    r00 = load rhs+0 as f32
    r01 = load rhs+4 as f32
    r02 = load rhs+8 as f32
    r03 = load rhs+12 as f32
    r10 = load rhs+16 as f32
    r11 = load rhs+20 as f32
    r12 = load rhs+24 as f32
    r13 = load rhs+28 as f32
    r20 = load rhs+32 as f32
    r21 = load rhs+36 as f32
    r22 = load rhs+40 as f32
    r23 = load rhs+44 as f32
    r30 = load rhs+48 as f32
    r31 = load rhs+52 as f32
    r32 = load rhs+56 as f32
    r33 = load rhs+60 as f32
    a0 = fmul l00, r00
    a1 = fmul l10, r01
    a2 = fmul l20, r02
    a3 = fmul l30, r03
    a4 = fadd a0, a1
    a5 = fadd a4, a2
    o00 = fadd a5, a3
    b0 = fmul l01, r00
    b1 = fmul l11, r01
    b2 = fmul l21, r02
    b3 = fmul l31, r03
    b4 = fadd b0, b1
    b5 = fadd b4, b2
    o01 = fadd b5, b3
    c0 = fmul l02, r00
    c1 = fmul l12, r01
    c2 = fmul l22, r02
    c3 = fmul l32, r03
    c4 = fadd c0, c1
    c5 = fadd c4, c2
    o02 = fadd c5, c3
    d0 = fmul l03, r00
    d1 = fmul l13, r01
    d2 = fmul l23, r02
    d3 = fmul l33, r03
    d4 = fadd d0, d1
    d5 = fadd d4, d2
    o03 = fadd d5, d3
    e0 = fmul l00, r10
    e1 = fmul l10, r11
    e2 = fmul l20, r12
    e3 = fmul l30, r13
    e4 = fadd e0, e1
    e5 = fadd e4, e2
    o10 = fadd e5, e3
    f0 = fmul l01, r10
    f1 = fmul l11, r11
    f2 = fmul l21, r12
    f3 = fmul l31, r13
    f4 = fadd f0, f1
    f5 = fadd f4, f2
    o11 = fadd f5, f3
    g0 = fmul l02, r10
    g1 = fmul l12, r11
    g2 = fmul l22, r12
    g3 = fmul l32, r13
    g4 = fadd g0, g1
    g5 = fadd g4, g2
    o12 = fadd g5, g3
    h0 = fmul l03, r10
    h1 = fmul l13, r11
    h2 = fmul l23, r12
    h3 = fmul l33, r13
    h4 = fadd h0, h1
    h5 = fadd h4, h2
    o13 = fadd h5, h3
    i0 = fmul l00, r20
    i1 = fmul l10, r21
    i2 = fmul l20, r22
    i3 = fmul l30, r23
    i4 = fadd i0, i1
    i5 = fadd i4, i2
    o20 = fadd i5, i3
    j0 = fmul l01, r20
    j1 = fmul l11, r21
    j2 = fmul l21, r22
    j3 = fmul l31, r23
    j4 = fadd j0, j1
    j5 = fadd j4, j2
    o21 = fadd j5, j3
    k0 = fmul l02, r20
    k1 = fmul l12, r21
    k2 = fmul l22, r22
    k3 = fmul l32, r23
    k4 = fadd k0, k1
    k5 = fadd k4, k2
    o22 = fadd k5, k3
    m0 = fmul l03, r20
    m1 = fmul l13, r21
    m2 = fmul l23, r22
    m3 = fmul l33, r23
    m4 = fadd m0, m1
    m5 = fadd m4, m2
    o23 = fadd m5, m3
    n0 = fmul l00, r30
    n1 = fmul l10, r31
    n2 = fmul l20, r32
    n3 = fmul l30, r33
    n4 = fadd n0, n1
    n5 = fadd n4, n2
    o30 = fadd n5, n3
    p0 = fmul l01, r30
    p1 = fmul l11, r31
    p2 = fmul l21, r32
    p3 = fmul l31, r33
    p4 = fadd p0, p1
    p5 = fadd p4, p2
    o31 = fadd p5, p3
    q0 = fmul l02, r30
    q1 = fmul l12, r31
    q2 = fmul l22, r32
    q3 = fmul l32, r33
    q4 = fadd q0, q1
    q5 = fadd q4, q2
    o32 = fadd q5, q3
    s0 = fmul l03, r30
    s1 = fmul l13, r31
    s2 = fmul l23, r32
    s3 = fmul l33, r33
    s4 = fadd s0, s1
    s5 = fadd s4, s2
    o33 = fadd s5, s3
    store dst+0, o00 as f32
    store dst+4, o01 as f32
    store dst+8, o02 as f32
    store dst+12, o03 as f32
    store dst+16, o10 as f32
    store dst+20, o11 as f32
