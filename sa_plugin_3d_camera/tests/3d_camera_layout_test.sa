@import "../3d_camera.sal"

@extern sa3d_camera_selftest() -> i32

@test "3d_camera layout sizes"():
L_ENTRY:
    desc_size_ok = eq SA3D_CAMERA_DESC_SIZE, 24
    uniform_size_ok = eq SA3D_CAMERA_UNIFORM_SIZE, 208
    ok = and desc_size_ok, uniform_size_ok
    br ok -> L_SIZES_OK, L_SIZES_ERR
L_SIZES_OK:
    return
L_SIZES_ERR:
    panic(3030)

@test "3d_camera perspective desc init"():
L_ENTRY:
    desc = alloc SA3D_CAMERA_DESC_SIZE
    call @sa3d_camera_desc_init_perspective(&desc, 1078530011, 1069547520, 1036831949, 1120403456)
    proj = call @sa3d_camera_desc_get_projection(&desc)
    fovy = call @sa3d_camera_desc_get_fovy(&desc)
    aspect = call @sa3d_camera_desc_get_aspect(&desc)
    near_val = call @sa3d_camera_desc_get_near(&desc)
    far_val = call @sa3d_camera_desc_get_far(&desc)
    ortho = call @sa3d_camera_desc_get_ortho_height(&desc)
    proj_ok = eq proj, 0
    fovy_ok = eq fovy, 1078530011
    aspect_ok = eq aspect, 1069547520
    near_ok = eq near_val, 1036831949
    far_ok = eq far_val, 1120403456
    ortho_ok = eq ortho, 0
    p1 = and proj_ok, fovy_ok
    p2 = and aspect_ok, near_ok
    p3 = and far_ok, ortho_ok
    q = and p1, p2
    ok = and q, p3
    !desc
    br ok -> L_PERSP_OK, L_PERSP_ERR
L_PERSP_OK:
    return
L_PERSP_ERR:
    panic(3031)

@test "3d_camera orthographic desc init"():
L_ENTRY:
    desc = alloc SA3D_CAMERA_DESC_SIZE
    call @sa3d_camera_desc_init_orthographic(&desc, 1082130432, 1069547520, 0, 1120403456)
    proj = call @sa3d_camera_desc_get_projection(&desc)
    ortho = call @sa3d_camera_desc_get_ortho_height(&desc)
    near_val = call @sa3d_camera_desc_get_near(&desc)
    far_val = call @sa3d_camera_desc_get_far(&desc)
    proj_ok = eq proj, 1
    ortho_ok = eq ortho, 1082130432
    near_ok = eq near_val, 0
    far_ok = eq far_val, 1120403456
    p1 = and proj_ok, ortho_ok
    p2 = and near_ok, far_ok
    ok = and p1, p2
    !desc
    br ok -> L_ORTHO_OK, L_ORTHO_ERR
L_ORTHO_OK:
    return
L_ORTHO_ERR:
    panic(3032)

@test "3d_camera uniform position set get"():
L_ENTRY:
    u = alloc SA3D_CAMERA_UNIFORM_SIZE
    call @sa3d_camera_uniform_init(&u)
    call @sa3d_camera_uniform_set_position(&u, 1065353216, 1073741824, 1077936128)
    x1 = call @sa3d_camera_uniform_get_position_x(&u)
    y1 = call @sa3d_camera_uniform_get_position_y(&u)
    z1 = call @sa3d_camera_uniform_get_position_z(&u)
    x1_ok = eq x1, 1065353216
    y1_ok = eq y1, 1073741824
    z1_ok = eq z1, 1077936128
    pa = and x1_ok, y1_ok
    ok = and pa, z1_ok
    !u
    br ok -> L_POS_OK, L_POS_ERR
L_POS_OK:
    return
L_POS_ERR:
    panic(3033)

@test "3d_camera uniform copy view"():
L_ENTRY:
    u = alloc SA3D_CAMERA_UNIFORM_SIZE
    s = stack_alloc 64
    store s+0, 1065353216 as i32
    store s+20, 1073741824 as i32
    store s+40, 1077936128 as i32
    store s+60, 1082130432 as i32
    call @sa3d_camera_uniform_copy_view(&u, &s)
    v0 = load u+0 as i32
    v20 = load u+20 as i32
    v40 = load u+40 as i32
    v60 = load u+60 as i32
    v0_ok = eq v0, 1065353216
    v20_ok = eq v20, 1073741824
    v40_ok = eq v40, 1077936128
    v60_ok = eq v60, 1082130432
    pa = and v0_ok, v20_ok
    pb = and v40_ok, v60_ok
    ok = and pa, pb
    !u
    br ok -> L_VIEW_OK, L_VIEW_ERR
L_VIEW_OK:
    return
L_VIEW_ERR:
    panic(3034)

